{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "HTTPS_PROXY": "http://127.0.0.1:8093",
    "NODE_EXTRA_CA_CERTS": "$HOME/.local/state/wb-geheimnis-filter/ca.pem",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus[1m]",
  "hooks": {
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/configchange-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/Knowledge/_meta/tools/hooks/read-tracking.sh\" 2>/dev/null"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/posttooluse-agent-reach-skin.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/precompact-handoff-gate.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.claude/hooks/bash-guard.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/bash-guard-live-config.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "WebFetch|mcp__claude_ai_Adobe_for_creativity__.*|mcp__claude_ai_Canva__.*|mcp__claude_ai_Gamma__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.claude/hooks/media-cloud-guard.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/Knowledge/_meta/tools/hooks/tripwire.sh\" 2>/dev/null",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionend-orphan-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Knowledge/_meta/tools/session-context.sh\" 2>/dev/null"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-baseline.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-testsuite-status.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-hygiene-status.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-limit-budget.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-belegung-ueberfaellig.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-kontingente.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-autoresearch.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "'$HOME/.local/bin/jcode' setup-hotkey --notify-cli-launch claude",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sessionstart-claude-session.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/workbench/chat-zuordnung.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/Knowledge/_meta/tools/hooks/auto-recall.sh\" 2>/dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/companion.app/Contents/MacOS/companion-hook\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/companion.app/Contents/MacOS/companion-hook\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Applications/companion.app/Contents/MacOS/companion-hook\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "project-kit@project-kit": true,
    "werkbank@werkbank": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "project-kit": {
      "source": {
        "source": "github",
        "repo": "Skryx-L-A/project-kit"
      }
    },
    "werkbank": {
      "source": {
        "source": "directory",
        "path": "$HOME/.claude/werkbank-marktplatz"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "teammateMode": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
