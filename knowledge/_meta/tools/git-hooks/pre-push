#!/bin/bash
set -euo pipefail

remote="$1"
url="$2"

# Exit immediately on pipe failure
trap 'exit 1' PIPE

# Color codes for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

HOOK_FAILED=0

# Get the range of commits being pushed
# For a real push, git provides refs on stdin; simulate or parse from arguments
# Standard approach: compare against remote tracking branch
if git rev-parse --verify "$remote/main" >/dev/null 2>&1; then
  RANGE="$remote/main..HEAD"
else
  # First push scenario
  RANGE="4b825dc642cb6eb9a060e54bf8d69288fbee4904..HEAD"
fi

# Temp files for error messages
SECRETS_FILE=$(mktemp)
LARGE_FILE=$(mktemp)
SECRETS_PATTERNS_FILE=$(mktemp)
trap "rm -f $SECRETS_FILE $LARGE_FILE $SECRETS_PATTERNS_FILE" EXIT

# Check 1: No files from 90-secrets/ directory
printf "Checking for 90-secrets/ files...\n" >&2
if git diff-tree --no-commit-id --name-only -r "$RANGE" 2>/dev/null | grep -q '^90-secrets/' || \
   git diff --name-only "$RANGE" 2>/dev/null | grep -q '^90-secrets/'; then
  SECRETS=$(git diff-tree --no-commit-id --name-only -r "$RANGE" 2>/dev/null | grep '^90-secrets/' || git diff --name-only "$RANGE" 2>/dev/null | grep '^90-secrets/')
  printf "%b\n" "${RED}ERROR: Attempting to push files from 90-secrets/ directory:${NC}" > "$SECRETS_FILE"
  printf "%b\n" "$SECRETS" >> "$SECRETS_FILE"
  HOOK_FAILED=1
fi

# Check 2: No blobs > 50MB that aren't LFS pointers
printf "Checking for large non-LFS files...\n" >&2
# Find all objects in the range
while IFS= read -r hash; do
  size=$(git cat-file -s "$hash" 2>/dev/null || echo "0")
  # 50 MB = 52428800 bytes
  if [ "$((size))" -gt 52428800 ]; then
    # Check if this is an LFS pointer
    content=$(git cat-file -p "$hash" 2>/dev/null | head -1)
    if ! echo "$content" | grep -q 'version https://git-lfs.github.com'; then
      object=$(git rev-list --objects "$RANGE" 2>/dev/null | grep "^$hash" | head -1 || echo "$hash")
      size_human=$(printf '%d' "$size" | awk '{if ($1>=1099511627776) printf "%.2f TB", $1/1099511627776; else if ($1>=1073741824) printf "%.2f GB", $1/1073741824; else if ($1>=1048576) printf "%.2f MB", $1/1048576; else printf "%.2f KB", $1/1024}')
      printf "%b\n" "${RED}ERROR: Large non-LFS blob ($size_human): $object${NC}" >> "$LARGE_FILE"
      HOOK_FAILED=1
    fi
  fi
done < <(git rev-list --objects "$RANGE" 2>/dev/null | awk '{print $1}' | sort -u)

# Check 3: Scan for secret patterns in diffs
printf "Checking for secret patterns...\n" >&2
# Patterns to detect: OpenAI keys, GitHub tokens, AWS keys, private keys, Slack tokens
SECRETS_FOUND=0

# Pattern 1: OpenAI keys (sk-*)
if git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'sk-[A-Za-z0-9]{20,}' > /dev/null; then
  printf "%b\n" "${RED}ERROR: Detected potential secret matching pattern: sk-[A-Za-z0-9]{20,}${NC}" >> "$SECRETS_PATTERNS_FILE"
  git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'sk-[A-Za-z0-9]{20,}' | head -3 >> "$SECRETS_PATTERNS_FILE" || true
  SECRETS_FOUND=1
  HOOK_FAILED=1
fi

# Pattern 2: GitHub tokens (ghp_*)
if git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'ghp_[A-Za-z0-9]{30,}' > /dev/null; then
  printf "%b\n" "${RED}ERROR: Detected potential secret matching pattern: ghp_[A-Za-z0-9]{30,}${NC}" >> "$SECRETS_PATTERNS_FILE"
  git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'ghp_[A-Za-z0-9]{30,}' | head -3 >> "$SECRETS_PATTERNS_FILE" || true
  SECRETS_FOUND=1
  HOOK_FAILED=1
fi

# Pattern 3: AWS keys (AKIA*)
if git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'AKIA[A-Z0-9]{16}' > /dev/null; then
  printf "%b\n" "${RED}ERROR: Detected potential secret matching pattern: AKIA[A-Z0-9]{16}${NC}" >> "$SECRETS_PATTERNS_FILE"
  git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'AKIA[A-Z0-9]{16}' | head -3 >> "$SECRETS_PATTERNS_FILE" || true
  SECRETS_FOUND=1
  HOOK_FAILED=1
fi

# Pattern 4: Private keys
if git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'BEGIN.*PRIVATE KEY' > /dev/null; then
  printf "%b\n" "${RED}ERROR: Detected potential secret matching pattern: BEGIN.*PRIVATE KEY${NC}" >> "$SECRETS_PATTERNS_FILE"
  git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'BEGIN.*PRIVATE KEY' | head -3 >> "$SECRETS_PATTERNS_FILE" || true
  SECRETS_FOUND=1
  HOOK_FAILED=1
fi

# Pattern 5: Slack tokens
if git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'xoxb-[A-Za-z0-9]+' > /dev/null; then
  printf "%b\n" "${RED}ERROR: Detected potential secret matching pattern: xoxb-[A-Za-z0-9]+${NC}" >> "$SECRETS_PATTERNS_FILE"
  git diff "$RANGE" -- . ":(exclude)_meta/tools/git-hooks" ":(exclude)tools/git-hooks" 2>/dev/null | grep -E 'xoxb-[A-Za-z0-9]+' | head -3 >> "$SECRETS_PATTERNS_FILE" || true
  SECRETS_FOUND=1
  HOOK_FAILED=1
fi

# Print all errors
if [ -s "$SECRETS_FILE" ]; then
  cat "$SECRETS_FILE" >&2
fi
if [ -s "$LARGE_FILE" ]; then
  cat "$LARGE_FILE" >&2
fi
if [ "$SECRETS_FOUND" -eq 1 ] && [ -s "$SECRETS_PATTERNS_FILE" ]; then
  cat "$SECRETS_PATTERNS_FILE" >&2
fi

if [ "$HOOK_FAILED" -eq 1 ]; then
  printf "%b\n" "${RED}Push blocked by security checks. Fix the issues above and try again.${NC}" >&2
  exit 1
fi

# If all checks pass, run the LFS hook
printf "Running git-lfs pre-push checks...\n" >&2
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
exec git lfs pre-push "$@"
