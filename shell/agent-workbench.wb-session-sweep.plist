<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NICHT INSTALLIERT: Ansage des Nutzers vom 22.08.2026 -- "Mac keine automatischen
  Laeufe, die sich wiederholen". Alle zehn LaunchAgents mit Zeitplan sind an dem
  Tag abgeschaltet und aus ~/Library/LaunchAgents entfernt worden; das Aufraeumen alter Sitzungen faellt beim Arbeiten an, nicht nach Kalender.
  Die Datei bleibt hier als Vorlage fuer den Rueckweg stehen. Die abgeschaltete
  Fassung liegt unter ~/.local/state/wb-launchagents-deaktiviert/ -- solange sie
  dort liegt, weigert sich wb-ausrollen, diese plist zu installieren (Schalter
  --trotz-deaktivierung hebt das fuer einen Lauf auf).
-->
<!--
  Installation (der Nutzer selbst, nicht automatisch eingerichtet): diese Datei
  nach ~/Library/LaunchAgents/agent-workbench.wb-session-sweep.plist kopieren,
  dann `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/agent-workbench.wb-session-sweep.plist`
  (oder `launchctl load ...` je nach macOS-Version). Voraussetzung ist, dass
  shell/wb-session-sweep und shell/wb-session-close vorher nach
  ~/.local/bin/ installiert sind, denn ProgramArguments zeigt auf den
  installierten Pfad, nicht auf das Repo.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>agent-workbench.wb-session-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>$HOME/.local/bin/wb-session-sweep</string>
    <string>--quiet</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>$HOME/.local/state/wb-session-sweep.launchd.log</string>
  <key>StandardErrorPath</key><string>$HOME/.local/state/wb-session-sweep.launchd.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
