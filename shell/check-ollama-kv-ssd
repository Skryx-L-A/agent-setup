#!/bin/bash
# Monthly check: has Ollama gained native KV-cache/context offload to SSD?
# On a hit: notify der Nutzer + drop an action note into the Knowledge inbox,
# so the next Claude session implements it (see vault note
# 10-global/local-ai-orchestrator-architecture.md).
export PATH=/opt/homebrew/bin:$PATH
MARKER="$HOME/Knowledge/00-sources/ollama-kv-ssd-available.md"
[ -f "$MARKER" ] && exit 0

hit=$( { ollama serve --help; ollama --help; } 2>&1 | grep -iE 'kv[-_ ]?cache.*(disk|ssd|offload|swap|spill)|offload.*kv|context.*(disk|ssd)' | head -3 )
[ -z "$hit" ] && exit 0

cat > "$MARKER" <<EOF
---
title: "ACTION: Ollama supports KV/context offload to SSD now"
type: note
branch: 00-inbox
tags: [action, local-ai]
created: $(date +%F)
---

Automated monthly check found new Ollama flags:

\`\`\`
$hit
\`\`\`

TODO for the next Claude session: evaluate + enable it in
/opt/homebrew/opt/ollama/homebrew.mxcl.ollama.plist if it benefits the 48 GB setup
(bigger context without RAM pressure), then update
10-global/local-ai-orchestrator-architecture.md and delete this note.
EOF
osascript -e 'display notification "Ollama kann jetzt Kontext auf die SSD auslagern - Auftrag liegt im Knowledge-Inbox." with title "Agent-Setup"'
