#!/bin/bash
# grug-server — duenner Vorspann fuer grug-27b auf wb-mlx-server (mlx_lm.server,
# Port 8081 ueber den Server, 8080 ueber wb-modell-proxy davor).
#
# UMGEBAUT 2026-08-19 (Auftrag A, Entscheidung des Nutzers: grug und qwen3.8
# teilen sich EINEN umschaltbaren MLX-Server, weil nur eines der beiden in den
# Speicher passt). Was VORHER hier direkt implementiert war -- Belegungsbuch,
# Speicherwaechter (Boden 20480 MiB), Nebenlaeufigkeit (decode/prompt-
# concurrency, samt der Verklemmungsgeschichte von mlx-lm 0.31.3), das
# generische Ensure/Stop/Status mit Probeanfrage -- lebt jetzt in
# shell/wb-mlx-server, UNVERAENDERT scharf, nur nicht mehr grug-spezifisch
# hartkodiert (Gewichte/Kontext kommen dort aus der Registry). Diese Datei
# tut nur noch zwei Dinge: (1) den Pfad zu grug-27b GENAUSO aufloesen wie
# bisher (siehe MODEL_PATH unten -- das bleibt unveraendert, weil
# gardener/grug_client.py GRUG_MODEL_PATH UNABHAENGIG liest und Server,
# Client und Belegung sonst auseinanderlaufen koennten, siehe die Begruendung
# dort), und (2) das Ergebnis unveraendert (als absoluter PFAD, nicht als
# Alias "grug") an `wb-mlx-server ensure|stop|status` weiterreichen. pi-worker
# (Zeile ~307), der Modell-Proxy und lauf-fenster.sh rufen weiterhin
# `grug-server ensure|stop|status` auf und merken vom Umbau nichts; jeder
# bisherige Schalter (--frist, GRUG_SERVER_DECODE_PARALLEL,
# GRUG_SERVER_PROMPT_PARALLEL, GRUG_SERVER_OHNE_BELEGUNG) wirkt unveraendert,
# nur uebersetzt auf die Namen, die wb-mlx-server versteht.
#
# Modellwahl (2026-08-11, Messung des Nutzers, siehe regeln/lokale-modelle.md
# Abschnitt "Das Kleinere darf gewinnen"): MLX 4bit schlug Ollama und
# llama.cpp auf beiden Achsen -- Einzeldurchsatz (17,7 Tok/s) UND
# Nebenlaeufigkeit (14,8/21,1/28,1/28,1/23,9 Tok/s bei 1/2/4/8/16 Anfragen,
# Trefferquote 49/50). Ollama serialisiert fuer diese Architektur komplett,
# llama.cpp liegt unter MLX und trifft nur 45/50. grug ist seit 2026-08-19
# nicht mehr die Vorgabe fuer lokale Arbeit (das ist jetzt qwen3.8, dieselbe
# Bauform, eigene Messung steht aus) -- grug bleibt vollstaendig erhalten und
# waehlbar, diese Messung bleibt seine Grundlage.
#
# Usage (unveraendert):
#   grug-server ensure    startet grug falls noetig, wartet mit Frist auf
#                         Antwortbereitschaft, meldet Erfolg erst nach einer
#                         echten Probeanfrage. Laeuft es schon, tut es nichts
#                         (Frist wird nachgezogen). Laeuft STATTDESSEN ein
#                         anderes MLX-Modell (z.B. qwen3.8), wird es zuerst
#                         sauber beendet -- das ist jetzt Aufgabe von
#                         wb-mlx-server, siehe dort.
#   grug-server stop      beendet den Server, aber NUR wenn es grug ist, das
#                         gerade laeuft (sonst Fehler statt eines falschen
#                         Beendens -- siehe wb-mlx-server stop [<modell>]).
#   grug-server status    sagt, ob (irgendein MLX-Modell ueber diesen Server)
#                         laeuft, seit wann, mit wie viel Speicher.
#
#   --frist <minuten>      wie lange die Belegung bei `wb-belegung` gelten soll
#                          (Vorgabe 180, auch ueber GRUG_SERVER_FRIST_MIN).
#   --parallel <n>         NACHGEZOGEN 2026-08-20 (offener Punkt aus dem
#                          Handoff dieses Worktrees): reines Durchreichen an
#                          `wb-mlx-server ensure --parallel <n>` (siehe dort
#                          fuer die volle Bedeutung -- Nebenlaeufigkeit als
#                          Aufrufer-Entscheidung, Vorgabe 1). Bisher ging das
#                          nur ueber die zwei getrennten Umgebungsvariablen
#                          GRUG_SERVER_DECODE_PARALLEL/_PROMPT_PARALLEL; die
#                          bleiben unveraendert bestehen (tieferliegende
#                          Vorgabe), ein gesetztes --parallel hat aber
#                          Vorrang, weil es die ausdrueckliche Zahl DIESES
#                          Aufrufs ist.
#
# BEWUSST KEIN LaunchAgent (2026-08-11, Anweisung des Nutzers): 15 GB dauerhaft
# im Speicher zu halten wuerde Bild- und Videoerzeugung blockieren, die auf
# dieser Maschine denselben Speicher braucht. Gilt unveraendert fuer
# wb-mlx-server darunter.
#
# GRUG_SERVER_OHNE_BELEGUNG=1 ist die einzige Umgehung der Cross-Sitzungs-
# Sperre, und sie ist bewusst laut (siehe wb-mlx-server fuer die volle
# Begruendung). Ein klares NEIN von `wb-belegung` selbst wird davon NICHT
# uebersteuert.
set -uo pipefail

# Ueber die Umgebung setzbar, damit ein Modellwechsel EINE Stelle ist. Server,
# Client (`gardener/grug_client.py`, GRUG_MODEL_PATH) und Belegung muessen
# dasselbe Modell meinen - sonst laedt der Server das eine und der Lauf fragt
# nach dem anderen, und niemand merkt es, weil beide Namen plausibel aussehen.
# Die Vorgabe kommt aus DERSELBEN Quelle wie beim Client: der Konfiguration
# des Traums. Zwei hartkodierte Pfade waeren zwei Wahrheiten, und
# `mlx_lm.server` 0.31.3 laedt bei Abweichung still das Modell des Clients
# nach - die Divergenz faellt dann nicht auf, sie kostet nur je Anfrage 15 GB
# Umladen (Befund B3, 16.08.2026). DIESE KETTE BLEIBT UNVERAENDERT (siehe
# Kopfkommentar) -- wb-mlx-server bekommt unten den FERTIGEN Pfad, nicht den
# Alias "grug".
_konfig_modell() {
  uv run --project "$HOME/Knowledge/_meta/tools/gardener" python -c \
    'from gardener.dream import config as c; print(c.DREAM_LOCAL_MODEL_PATH)' \
    2>/dev/null
}
MODEL_PATH="${GRUG_MODEL_PATH:-$(_konfig_modell)}"
MODEL_PATH="${MODEL_PATH:-$HOME/AI/mlx-models/grug-27b-mlx-q4}"

# GRUG_SERVER_*-Namen bleiben fuer Aufrufer bestehen (lauf-fenster.sh,
# pi-worker), werden hier auf die generischen WB_MLX_SERVER_*-Namen
# uebersetzt, die wb-mlx-server liest. Reines Durchreichen -- kein neuer
# Vorgabewert, keine neue Bedeutung.
[ -n "${GRUG_SERVER_DECODE_PARALLEL:-}" ] && export WB_MLX_SERVER_DECODE_PARALLEL="$GRUG_SERVER_DECODE_PARALLEL"
[ -n "${GRUG_SERVER_PROMPT_PARALLEL:-}" ] && export WB_MLX_SERVER_PROMPT_PARALLEL="$GRUG_SERVER_PROMPT_PARALLEL"
[ -n "${GRUG_SERVER_OHNE_BELEGUNG:-}" ] && export WB_MLX_SERVER_OHNE_BELEGUNG="$GRUG_SERVER_OHNE_BELEGUNG"

BELEGUNG_FRIST_MIN=${GRUG_SERVER_FRIST_MIN:-180}
PARALLEL=""

err() { printf 'grug-server: %s\n' "$*" >&2; }

unterbefehl="${1:-}"
shift 2>/dev/null || true
while [ $# -gt 0 ]; do
  case "$1" in
    --frist)
      case "${2:-}" in
        ''|*[!0-9]*) echo "grug-server: --frist braucht Minuten als Zahl" >&2; exit 2 ;;
      esac
      BELEGUNG_FRIST_MIN="$2"; shift 2 ;;
    --parallel)
      case "${2:-}" in
        ''|*[!0-9]*|0) echo "grug-server: --parallel braucht eine Zahl ab 1" >&2; exit 2 ;;
      esac
      PARALLEL="$2"; shift 2 ;;
    *) echo "grug-server: unbekannte Option '$1'" >&2; exit 2 ;;
  esac
done

case "$unterbefehl" in
  ensure)
    set -- ensure "$MODEL_PATH" --frist "$BELEGUNG_FRIST_MIN"
    [ -n "$PARALLEL" ] && set -- "$@" --parallel "$PARALLEL"
    exec "$HOME/.local/bin/wb-mlx-server" "$@" ;;
  stop)   exec "$HOME/.local/bin/wb-mlx-server" stop "$MODEL_PATH" ;;
  status) exec "$HOME/.local/bin/wb-mlx-server" status ;;
  *) echo "Usage: grug-server ensure|stop|status [--frist <minuten>] [--parallel <n>]" >&2; exit 2 ;;
esac
