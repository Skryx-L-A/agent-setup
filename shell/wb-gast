#!/usr/bin/env python3
# wb-gast — Gegenstueck zu wb-gast-tor auf dem Rechner des Gastes.
#
#   wb-gast [--quelle <name>] liste [--json]
#   wb-gast [--quelle <name>] anhaengen <sitzung> [<pane>]     (Ctrl-] trennt)
#   wb-gast [--quelle <name>] schreiben <sitzung|pane> <text...>
#   wb-gast [--quelle <name>] neu [<projekt>] [--harness H] [--model M] [--effort E] [--name N]
#   wb-gast [--quelle <name>] schliessen <sitzung>
#   wb-gast quellen
#
# Die entfernten Sitzungsquellen stehen im Werkbank-Profil unter `remoteSessionSources`
# (~/.claude/workbench/ein mitnutzer-profile.json, sonst WB_GAST_PROFIL), je Eintrag
#   {"name": "peer", "ssh": "peer", "art": "wb-gast-tor", "projekte": ["a machine-bound project"]}
# `ssh` ist ein Alias aus ~/.ssh/config. Ohne --quelle gilt der erste Eintrag.
# Das Tor drueben entscheidet, was erlaubt ist; dieses Werkzeug baut nur den Aufruf.
import json
import os
import shlex
import subprocess
import sys

PROFIL = os.environ.get('WB_GAST_PROFIL', os.path.expanduser('~/.claude/workbench/ein mitnutzer-profile.json'))
HILFE = '''wb-gast [--quelle <name>] liste [--json] | anhaengen <sitzung> [<pane>] | schreiben <ziel> <text>
        | neu [<projekt>] [--harness H] [--model M] [--effort E] [--name N] | schliessen <sitzung>
wb-gast quellen'''
BEFEHLE = {'liste', 'anhaengen', 'schreiben', 'neu', 'schliessen', 'hilfe'}


def quellen():
    try:
        with open(PROFIL, encoding='utf-8') as f:
            daten = json.load(f)
    except (OSError, ValueError) as e:
        sys.exit(f'wb-gast: Profil {PROFIL} nicht lesbar ({e}).')
    liste = [q for q in daten.get('remoteSessionSources', []) if q.get('art') == 'wb-gast-tor' and q.get('ssh')]
    if not liste:
        sys.exit(f'wb-gast: keine Quelle mit "art": "wb-gast-tor" in {PROFIL}.')
    return liste


def main(argv):
    name = None
    if argv[:1] == ['--quelle']:
        if len(argv) < 2:
            sys.exit('wb-gast: --quelle braucht einen Namen.')
        name, argv = argv[1], argv[2:]
    if not argv or argv[0] in ('-h', '--help'):
        print(HILFE)
        return 0
    if argv[0] == 'quellen':
        for q in quellen():
            print(f"{q['name']}\tssh {q['ssh']}\t{', '.join(q.get('projekte', []))}")
        return 0
    if argv[0] not in BEFEHLE:
        sys.exit(f'wb-gast: unbekannter Befehl "{argv[0]}".')
    alle = quellen()
    quelle = next((q for q in alle if q['name'] == name), None) if name else alle[0]
    if not quelle:
        sys.exit(f'wb-gast: Quelle "{name}" steht nicht im Profil.')
    befehl = argv
    if argv[0] == 'schreiben' and len(argv) > 2:
        befehl = argv[:2] + [' '.join(argv[2:])]
    fern = shlex.join(befehl)
    if argv[0] == 'anhaengen':
        os.execvp('ssh', ['ssh', '-t', quelle['ssh'], fern])
    return subprocess.run(['ssh', quelle['ssh'], fern], stdin=subprocess.DEVNULL).returncode


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
