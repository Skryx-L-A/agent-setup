def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def state_file() -> Path:
    override = os.environ.get("WB_HARNESS_UPDATE_STATE_FILE")
    return Path(override).expanduser() if override else user_home() / ".local" / "state" / "wb-harness-update.json"


def log_file() -> Path:
    override = os.environ.get("WB_HARNESS_UPDATE_LOG_FILE")
    return Path(override).expanduser() if override else user_home() / ".local" / "state" / "wb-harness-update.log"


def blocks_file() -> Path:
    # Separate updater state: routine checks replace state_file(), while rejections
    # and override history must survive. Host names prevent a copied file from
    # rejecting a release on a machine on which it has never been measured.
    path = state_file()
    return path.with_name(path.stem + "-sperren.json")


def machine() -> str:
    # Keep the same identity source and platform mapping as wb-tafel.lokale_maschine.
    # wb-tafel has no shared importable helper, so read the same live config (or its
    # adjacent default) and apply its `maschinen_je_os` mapping here.
    override = os.environ.get("WB_TAFEL_MASCHINE", "")
    if override:
        return override
    home = user_home()
    config = home / ".claude" / "workbench" / "tafel-plaetze.json"
    if not config.is_file():
        config = Path(__file__).resolve().with_name("tafel-plaetze.default.json")
    try:
        data = json.loads(config.read_text())
        name = (data.get("maschinen_je_os") or {}).get(platform.system())
    except (OSError, ValueError, AttributeError):
        name = None
    if isinstance(name, str) and name.strip():
        return name.strip()
    raise ValueError("Werkbank-Maschinenname fehlt in " + str(config))


def legacy_machine(name: str) -> str | None:
    """Map only recognizable historical computer names to stable Werkbank names."""
    value = name.strip().lower().removesuffix(".local")
    if re.fullmatch(r"macbook-pro-von-[a-z0-9]+(?:-[a-z0-9]+)*?(?:-\d+)?", value):
        return "mac"
    if re.fullmatch(r"peer(?:-\w+)?", value):
        return "peer"
    return None


def migrate_blocks(data: dict[str, Any]) -> dict[str, Any]:
    """Normalize known legacy nodenames and collapse duplicate policy rows."""
    current_name = os.uname().nodename
    current_stable = machine()
    for key in ("rejectedVersions", "overrides"):
        rows = data[key]
        normalized = []
        for row in rows:
            mapped = current_stable if row["machine"] == current_name else legacy_machine(row["machine"])
            normalized.append({**row, "machine": mapped} if mapped else row)
        merged: dict[tuple[str, str, str], dict[str, Any]] = {}
        for row in normalized:
            identity = (row["machine"], row["engine"], row["version"])
            old = merged.get(identity)
            if old is None or row.get("date", "") >= old.get("date", ""):
                merged[identity] = row
        data[key] = list(merged.values())
    return data


def read_blocks() -> dict[str, Any]:
    try:
        data = json.loads(blocks_file().read_text())
    except FileNotFoundError:
        return {"rejectedVersions": [], "overrides": []}
    # A damaged policy must never silently turn into permission to update.
    if not isinstance(data, dict):
        raise ValueError("Engine-Sperrliste ist kein Objekt")
    for key in ("rejectedVersions", "overrides"):
        if not isinstance(data.get(key), list) or any(
            not isinstance(row, dict) or any(not isinstance(row.get(field), str) or not row[field].strip()
                                             for field in ("machine", "engine", "version", "reason", "date", "source"))
            for row in data[key]
        ):
            raise ValueError("Engine-Sperrliste ist ungueltig: " + key)
    return migrate_blocks(data)


def blocked_version(h: Harness, version: str) -> dict[str, Any] | None:
    if not h.engine:
        return None
    return next((row for row in read_blocks()["rejectedVersions"]
                 if row["machine"] == machine() and row["engine"] == h.id
                 and row["version"] == version.lstrip("v")), None)


def record_engine_decision(h: Harness, version: str, reason: str, source: str,
                           override: bool = False) -> dict[str, Any]:
    if not h.engine or not VERSION_RE.fullmatch(version) or not reason.strip() or not source.strip():
        raise ValueError("Engine, Version, Grund und Quelle sind Pflicht")
    data = read_blocks()
    row = {"machine": machine(), "engine": h.id, "version": version.lstrip("v"),
           "reason": reason.strip(), "date": now(), "source": source.strip()}
    key = "overrides" if override else "rejectedVersions"
    if not override:
        data[key] = [old for old in data[key] if (old["machine"], old["engine"], old["version"]) !=
                     (row["machine"], row["engine"], row["version"])]
    data[key].append(row)
    write_json_atomic(blocks_file(), data)
    append_log(("Engine-Sperre uebergangen: " if override else "Engine-Version gesperrt: ")
               + json.dumps(row, ensure_ascii=False, sort_keys=True))
    return row


