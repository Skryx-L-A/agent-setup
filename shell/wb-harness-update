    way: str
    catalog: str
    package: str
    update: tuple[str, ...]
    safe_while_running: bool = False
    # Model engines (Ollama, Splash) share the updater but are no Werkbank harness:
    # no harness discover/config after an update, only on the listed platforms, and
    # a disk-space check first (space_dir counted space_factor times + SPACE_RESERVE).
