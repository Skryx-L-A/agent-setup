#!/bin/bash
# pi-worker — prompt a PERMANENT local pi chat agent (always-visible pane).
#
#   pi-worker [--mensch] [--kontext <stufe|auto>] <name> <qwen|qwen38|ornith|ornith9|grug|model-id> <workdir> <task...>
#
# WB_MCP_VOLL=1 gibt einem Claude-Worker die volle MCP-Ausstattung. Ohne die
# Variable bekommt er die knappe (nur basic-memory ueber HTTP) -- gemessen
# 264 MiB weniger je Sitzung, weil der Browser-MCP wegfaellt, den ein Worker
# fast nie benutzt.
#
# `--mensch` hebt den Effort-Deckel fuer DIESEN Start auf (2026-08-06). Es gilt
# nur, wenn der Aufruf wirklich von einem Menschen kommt — geprueft von
# `wb-mensch` an der Herkunft des Prozesses, nicht an dem, was der Aufruf
# behauptet. Ein Agent aus einem Pane heraus wird abgewiesen.
#
# The agent's pane runs the interactive pi chat continuously — no mode
# switches, ever. Tasks are injected as chat messages (bracketed paste);
# every task carries an embedded protocol: the agent writes its result to
#   ~/.pi-workers/results/<name>/<timestamp>.md   (symlink: latest.md)
# and replies DONE. The orchestrator waits on that file WITH A DEADLINE
# (never unbounded) and reads it. Same name = same pane = same context.
#
# Helpers: pi-worker <name> --interrupt   sends Escape to a stuck agent.
#
#   pi-worker --on <mac|peer> <name> <model> <workdir> <task...>
# spawns the worker on the OTHER machine (name there and here: SSH-<name>) and
# mirrors it into the local grid — see wb-ssh-worker. Without --on nothing changes.
set -u

# Mindesthoehe eines Worker-Fensters/-Panes (Betriebsbefund 19.08.2026 abends,
# der Nutzer, gemessen: alle vier Worker-Panes der Sitzung wb-AI standen auf
# 184x1). Dieselbe Zahl wie shell/wb-workers-window:MIN_ZEILEN und
# app/src/main/config.ts:184 (minPaneRows, Default 12) -- eine Entscheidung,
# an drei Stellen wiederverwendet, nicht dreimal neu erfunden. Genug fuer
# Status- und Eingabezeile plus ein paar Zeilen sichtbaren Verlauf, das
# Mindeste, das die Absendepruefung braucht, um den Panebildschirm ueberhaupt
# lesen zu koennen. Wird an ZWEI Stellen in dieser Datei gebraucht: vor dem
# Split in ein bestehendes 'workers'-Fenster (das sonst mit "no space for a
# new pane" scheitert, siehe dort) und unmittelbar vor dem Tippen eines
# Auftrags (Riegel gegen eine falsche Fehlschlag-Meldung der
# Absendepruefung).
PI_WORKER_MIN_ZEILEN=12

if [ "${1:-}" = "--on" ]; then
  ONMACHINE="${2:?Maschine (mac|peer)}"; shift 2
  case "$(uname -s)" in Darwin) SELF=mac ;; *) SELF=peer ;; esac
  [ "$ONMACHINE" = "$SELF" ] && { echo "pi-worker: --on gilt nur fuer eine ANDERE Maschine — '$ONMACHINE' ist diese hier. Ohne --on starten." >&2; exit 1; }
  exec $HOME/.local/bin/wb-ssh-worker "$ONMACHINE" pi "$@"
fi

# Optionales Fertig-Kriterium VOR dem Namen (SPEC: wb-dod). Nur die Uebernahme
# steht hier -- geschrieben wird es unten am Punkt der Task-Injektion.
DOD=""
if [ "${1:-}" = "--dod" ]; then
  DOD="${2:?--dod erwartet ein Fertig-Kriterium}"; shift 2
fi

# Kontextfenster fuer ein LOKALES Modell (wb-kontext, Auftrag B 2026-08-19,
# 'auto' vereinheitlicht im Nachtrag 2 vom selben Tag). Sowohl OHNE Angabe als
# auch mit 'auto' waehlt der Orchestrator automatisch, gemessen am freien
# Speicher -- derselbe Wortsinn wie in wb-code, nur ohne dessen zusaetzlichen
# Settings-Schritt (siehe unten am Punkt der Wahl selbst).
KONTEXT_ARG=""
if [ "${1:-}" = "--kontext" ]; then
  KONTEXT_ARG="${2:?--kontext erwartet eine Stufe oder 'auto'}"; shift 2
fi

# ── Wer ruft hier? (2026-08-06) ───────────────────────────────────────────────
# Der Effort-Deckel bindet den ORCHESTRATOR, nicht den Menschen. Startet ein
# AGENT einen Worker, gilt der Deckel des Modells -- das ist die Selbstbindung
# gegen zu teure Laeufe, und sie bleibt. Startet ein MENSCH, ueber die
# Oberflaeche oder von Hand im Terminal, gilt sie nicht: er bekommt jede Stufe,
# die der HARNESS annimmt.
#
# `--mensch` ist eine BEHAUPTUNG des Aufrufers und wird nie geglaubt. wb-mensch
# misst die Herkunft am Prozess (Agenten-Umgebung, Harness in der Ahnenreihe,
# Pane-Rolle, steuerndes Terminal, Oberflaeche als geprueften Ahnen) -- dasselbe
# Prinzip, mit dem das Einstellungsfenster `isTrusted` benutzt: die Echtheit
# haengt nicht am Absender, sondern an der Schicht, die sie aufpraegt. Ein Agent,
# der das Merkmal im Code liest und mitschickt, kommt damit nicht durch.
#
# OHNE das Merkmal bleibt alles wie vorher: Deckel greift, `max` abgelehnt. Der
# Rueckfall ist die sichere Seite -- ein Fehler an dieser Stelle darf nie in
# Richtung "mehr erlaubt" ausfallen.
MENSCH=""
if [ "${1:-}" = "--mensch" ]; then
  shift
  if "$HOME/.local/bin/wb-mensch" pruefen; then
    MENSCH=1
  else
    BELEG=$("$HOME/.local/bin/wb-mensch" beleg 2>/dev/null | cut -f2-)
    {
      echo "FEHLER: '--mensch' abgelehnt — dieser Aufruf kommt nicht von einem Menschen."
      echo "  Erkannt wurde: ${BELEG:-kein Beleg}"
      echo "  Der Effort-Deckel ist die Selbstbindung des Orchestrators. Ein Agent hebt sie"
      echo "  nicht dadurch auf, dass er das Merkmal mitschickt."
      echo "  Ohne '--mensch' laeuft derselbe Aufruf normal — dann greift der Deckel."
      echo "  Diagnose: wb-mensch beleg ; wb-mensch ahnen"
    } >&2
    exit 1
  fi
fi

NAME="${1:?worker name}"; shift

# Der Name wird zu einem PFAD (Ergebnis- und Session-Verzeichnis) und zu einer
# tmux-Option. Deshalb wird er geprueft, BEVOR irgendetwas davon entsteht: '../evil'
# hat sein Ergebnisverzeichnis sonst nach ~/.pi-workers/evil gelegt, also aus
# results/ heraus (Stress-Befund B05) — und wb-result haette es dort nie gefunden.
case "$NAME" in
  ''|-*|*[!A-Za-z0-9_-]*)
    echo "FEHLER: unzulaessiger Worker-Name '$NAME'." >&2
    echo "  Erlaubt sind Buchstaben, Ziffern, '-' und '_' (kein '/', kein '..', kein fuehrendes '-')." >&2
    echo "  Grund: aus dem Namen werden Pfade unter ~/.pi-workers/ gebaut." >&2
    exit 1 ;;
esac

LOGROOT="$HOME/.pi-workers"; RESDIR="$LOGROOT/results/$NAME"
SESSDIR="$LOGROOT/sessions/$NAME"
mkdir -p "$RESDIR" "$SESSDIR"

# A bare NAME used to be searched across EVERY wb-* session on the machine
# (2026-08-16, bugjagd shell/mittel, pi-worker:92-99): an unrelated OLD session
# with a same-named worker pane silently wins -- `tmux list-sessions` order
# decides, not intent. Reproduced: two independent wb-* sessions each with a
# pane tagged @wb_worker=dup, the caller's own spawn lands in the OTHER
# session's pane. Matches the vault incident "Worker-Namen kollidieren ueber
# Session-Grenzen" (worker 'w-lauf' resumed yesterday's context in a session
# nobody was watching). own_wb_session() (uses base_session_name, defined
# below -- fine, it only has to exist by CALL time) scopes find_pane to the
# caller's own session base, which still covers the SAME workbench's grouped
# '<sess>-view' sibling (the intentional "one name = one pane across window
# switches" case) without reaching into a different orchestrator's session.
own_wb_session() {
  local sess="$1" rep
  rep=$(tmux list-panes -t "=$sess" -F '#{pane_id}' 2>/dev/null | head -1)
  [ -n "$rep" ] && base_session_name "$rep"
}
find_pane() {
  local own=""
  if [ -n "${WB_SESSION:-}" ]; then
    own="$(own_wb_session "$WB_SESSION" 2>/dev/null || true)"
  elif [ -n "${TMUX_PANE:-}" ]; then
    own="$(base_session_name "$TMUX_PANE" 2>/dev/null || true)"
  fi
  for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^wb-'); do
    # '=' anchors the session name: wb-foo-1a2b3c is a PREFIX of wb-foo-1a2b3c-9f2a1c,
    # and an unanchored target may match the wrong session.
    if [ -n "$own" ]; then
      [ "$(own_wb_session "$s" 2>/dev/null || true)" = "$own" ] || continue
    fi
    tmux list-panes -s -t "=$s" -F '#{pane_id} #{@wb_worker} #{pane_dead}' 2>/dev/null \
      | awk -v n="$NAME" '$2==n{print $1" "$3; exit}'
  done | head -1
}

# Warns when NOTHING on this tmux server displays the worker's window. Called on
# every path that spawns, respawns or re-prompts a pane — not just on a fresh
# spawn: the client situation changes over a session (layout switch, a closed
# worker tab), and on 2026-07-25 four running workers were invisible to the user
# for exactly that reason. Window IDs are compared across ALL clients, because
# the extension's worker tab attaches through a GROUPED session ('<sess>-view')
# whose client would not show up under `list-clients -t "=<sess>"`.
visibility_guard() {
  local p="$1" wid widx sess wname
  [ -n "$p" ] || return 0
  wid=$(tmux display -p -t "$p" '#{window_id}' 2>/dev/null || true)
  [ -n "$wid" ] || return 0
  tmux list-clients -F '#{window_id}' 2>/dev/null | grep -qx "$wid" && return 0
  widx=$(tmux display -p -t "$p" '#{window_index}' 2>/dev/null || true)
  sess=$(tmux display -p -t "$p" '#{session_name}' 2>/dev/null || true)
  wname=$(tmux display -p -t "$p" '#{window_name}' 2>/dev/null || true)
  {
    echo "WARNUNG: Worker '$NAME' laeuft in Fenster '${wname:-?}' (Index ${widx:-?}) der Session ${sess:-?},"
    echo "         aber KEIN Client zeigt dieses Fenster gerade an — er arbeitet unsichtbar."
    echo "         So wird er sichtbar:"
    echo "           1) im Terminal: tmux-Prefix + Fensterwechsel (Prefix ${widx:-2}, oder Prefix n)"
    echo "           2) den Worker-Tab der Extension oeffnen ('Claude Workbench — Worker')"
    echo "         Oder Layout zurueckstellen: wb-state settings set workerLayout split"
  } >&2
}

# Jeder Tastendruck dieses Werkzeugs geht durch wb-pane-write (2026-08-06) -- die eine
# Stelle, die entscheidet, wer in einen Pane schreiben darf. Fuer pi-worker aendert das
# nichts am Betrieb: er tippt ausschliesslich in WORKER-Panes, und die nehmen weiter
# alles an. Er geht trotzdem denselben Weg, damit es nicht zwei Fassungen der Regel gibt
# und damit ein Fehlgriff -- ein Pane-Fund, der versehentlich den Orchestrator trifft --
# abgelehnt statt ausgefuehrt wird. Ein Rueckfall auf `tmux send-keys` gibt es bewusst
# nicht: er waere ein Loch, das offensteht, sobald jemand halb installiert.
PANE_WRITE="$HOME/.local/bin/wb-pane-write"
pane_fehlt() { echo "FEHLER: $PANE_WRITE fehlt — es wird NICHTS in einen Pane getippt." >&2; return 1; }
pane_taste()     { [ -x "$PANE_WRITE" ] || pane_fehlt || return 1; "$PANE_WRITE" taste "$1" "$2"; }
pane_einfuegen() { [ -x "$PANE_WRITE" ] || pane_fehlt || return 1; "$PANE_WRITE" einfuegen "$1"; }

# Basis-Sessionname eines Panes, fuer alles, das ihn als STABILEN SCHLUESSEL
# braucht (hier: die Registrierung im Zustandsdokument). `#{session_name}` ist
# INSTABIL, sobald das Fenster in einer Sessiongruppe haengt ('<sess>' und
# '<sess>-view' teilen sich dieselben Fenster): ein und derselbe Pane meldet je
# nach Aufrufzeitpunkt mal die Basis, mal die '-view'-Schwester zurueck (gemessen
# 2026-08-06 auf einem eigenen tmux-Socket -- `display -p -t <pane> '#{session_name}'`
# fuer einen Pane der Basis 'wb-AI' antwortete 'wb-AI-view', obwohl der Pane ueber
# `list-panes -t wb-AI` gefunden wurde). `#{session_group}` ist dagegen STABIL: fuer
# BEIDE Mitglieder einer Gruppe ist es der Name der Basis (mitgemessen im selben
# Lauf), und leer, solange die Session nie gruppiert wurde -- dann ist sie trivial
# ihre eigene Basis. Uebernommen aus context-guard's identisch begruendetem
# base_session_name() statt neu erfunden.
base_session_name() {
  local p="$1" sess grp
  sess=$(tmux display -p -t "$p" '#{session_name}' 2>/dev/null || true)
  grp=$(tmux display -p -t "$p" '#{session_group}' 2>/dev/null || true)
  printf '%s' "${grp:-$sess}"
}

if [ "${1:-}" = "--interrupt" ]; then
  info=$(find_pane); pane=${info%% *}
  # A missing worker used to print nothing and exit 0 — the caller then believed
  # Escape had been sent to a stuck agent that does not even exist.
  if [ -z "$pane" ]; then
    echo "FEHLER: kein Pane fuer Worker '$NAME' gefunden — kein Escape gesendet." >&2
    exit 1
  fi
  pane_taste "$pane" Escape \
    || { echo "FEHLER: Escape an Pane $pane ('$NAME') fehlgeschlagen." >&2; exit 1; }
  echo "Escape an '$NAME' gesendet."
  exit 0
fi

MODEL="${1:?model}"; WORKDIR="${2:?workdir}"; shift 2
# Worktree-Isolierung (freigegeben 2026-08-04, gebaut in wb-worktree). Der Aufruf
# steht auch hier und nicht nur in claude-worker, weil "jeder Worker seinen eigenen
# Arbeitsbaum" sonst am lokalen Modell vorbeiginge: ein pi-Worker wird direkt hier
# gespawnt und schreibt genauso Dateien. Doppelt ruft es niemand aus Versehen —
# `ensure` gibt ein Verzeichnis, das schon der Worktree DIESES Workers ist,
# unveraendert und still zurueck (der Weg ueber claude-worker). Faellt der
# Worktree-Weg aus (kein git, kein Repo, Schalter aus), bleibt $WORKDIR stehen.
ORIG_WORKDIR="$WORKDIR"
if [ -x "$HOME/.local/bin/wb-worktree" ]; then
  WT_DIR="$("$HOME/.local/bin/wb-worktree" ensure "$NAME" "$WORKDIR")" || WT_DIR=""
  [ -n "$WT_DIR" ] && [ -d "$WT_DIR" ] && WORKDIR="$WT_DIR"
fi
# Vorspann fuer den injizierten Auftrag, wenn WIRKLICH ein eigener Worktree
# darunterliegt (2026-08-11, Anlass: ein Worker bekam den Projektordner im
# Auftragstext genannt, sass aber im Worktree, und hat seine Dateien gegen den
# im Text genannten Hauptbaum aufgeloest — 'git merge' brach danach ab).
#
# Erkennung ueber den PFAD, nicht ueber "WT_DIR ist ein Verzeichnis": `ensure`
# gibt im Abschaltfall (kein git, kein Repo, workerWorktrees=false) $WORKDIR
# UNVERAENDERT zurueck, und das ist ebenfalls ein gueltiges Verzeichnis — das
# waere sonst faelschlich als aktiver Worktree gezaehlt worden. Nur ein
# Ergebnis unter $ROOT/$NAME (wb-worktree's eigene wtpath-Konstruktion) ist ein
# echter Worktree. Der Zweigname ist dort per Konvention immer "wb/$NAME"
# (siehe cmd_ensure in wb-worktree) — kein zweiter Aufruf noetig, um ihn zu lesen.
VORSPANN=""
case "${WT_DIR:-}" in
  "$HOME/.pi-workers/worktrees/$NAME"|"$HOME/.pi-workers/worktrees/$NAME"/*)
    WORKTREE_HAUPTBAUM="$(git -C "$ORIG_WORKDIR" worktree list --porcelain 2>/dev/null \
      | awk '/^worktree /{sub(/^worktree /,""); print; exit}')"
    if [ -n "$WORKTREE_HAUPTBAUM" ]; then
      VORSPANN="[Arbeitsverzeichnis] Dieser Auftrag laeuft in einem eigenen Worktree: $WORKDIR (Zweig wb/$NAME). Jeder Pfad, den Du liest oder schreibst, liegt darunter. Der Hauptbaum $WORKTREE_HAUPTBAUM ist tabu — fasse ihn nicht an, auch wenn der Auftragstext ihn nennt.

"
    fi
    ;;
esac
# `default` (and `-`) resolves the worker default from the settings menu
# (SPEC-V2 D). Those two keys were written by the menu and read by NOBODY before.
# The positional argument stays mandatory, so no existing call changes.
if [ "$MODEL" = default ] || [ "$MODEL" = - ] || [ "$MODEL" = claude-default ]; then
  dm=$("$HOME/.local/bin/wb-state" settings get workerModel 2>/dev/null || true)
  de=$("$HOME/.local/bin/wb-state" settings get workerEffort 2>/dev/null || true)
  if [ -z "$dm" ]; then
    echo "FEHLER: Modell 'default' verlangt 'workerModel' in den Settings — dort steht nichts." >&2
    echo "  Setzen: wb-state settings set workerModel sonnet5   (dazu workerEffort high)" >&2
    exit 1
  fi
  case "$dm" in
    haiku45|sonnet5|opus5|opus48|fable5|haiku|sonnet|opus|fable) dm="claude-$dm" ;;
  esac
  MODEL="$dm"; [ -n "$de" ] && MODEL="$dm:$de"
  echo "pi-worker: Modell aus den Settings: $MODEL" >&2
fi
TASK="$*"
ENGINE=pi; TITLE="pi:$NAME"
# Provider fuer den schnellen pi-Pfad (case-Block unten). Ollama ist der
# Normalfall; grug laeuft ueber den zweiten Anbieter aus ~/.pi/agent/models.json
# (mlx_lm.server, siehe grug-server) und ueberschreibt diese Variable im
# eigenen Zweig.
PIPROVIDER=ollama
# The rendered-pane pattern the ready-wait below looks for. The two built-in
# harnesses share it (measured in production since V1); a REGISTRY harness brings
# its own, which is why an adapter without a measured one cannot start at all
# (SPEC-V3 A.2/H).
READY_RE='❯|░|●'
# ... and the pattern of the INPUT LINE, used to verify that the pasted task really
# left the input box. Two different questions, two different patterns: aider is ready
# at '>' and shows its unsent text after the same '>', Claude uses '❯'. Hard-coding
# '❯' here made the check silently pass for every other harness — it found no input
# line at all, concluded "empty, so it was sent" and printed "Submission verifiziert"
# without having verified anything (Reviewer-Befund H1, 2026-07-28). An empty pattern
# now means the spawn SAYS it could not verify.
PROMPT_RE='^❯'
# Platzhalter-Text, der in einer LEEREN Eingabezeile stehen darf (je Harness).
# Der SCHNELLE Pfad (eingebaute claude-/pi-Aliase) fragt die Registry nicht, brauchte
# den Wert aber genauso: ein BESCHAEFTIGTER Claude-Pane zeigt in der leeren Eingabe
# "Press up to edit queued messages", und die Zustellpruefung las das als haengenden
# Prompt — Nachricht war zugestellt, der Spawn meldete trotzdem FEHLER (gemessen
# 2026-07-29, Pane %28). Derselbe Text steht als promptIgnore am Harness `claude`.
PROMPT_IGNORE='^❯ Press up to edit queued messages'
# Zweiter Absende-Weg je Harness (2026-08-09, SPEC-V3 A.2 altSubmit). Leer fuer die
# eingebauten Pfade (claude, pi) und fuer jeden Registry-Harness ohne den Eintrag —
# fuer die aendert sich am Absenden kein Zeichen. Nur der Registry-Zweig unten fuellt
# beide Variablen, aus 'wb-state models resolve'. Befund, der den Eintrag noetig
# machte: OpenHands schaltet bei einem MEHRZEILIGEN Einfuegevorgang (Auftrag, Leerzeile,
# das [Protokoll]-Kommando, das JEDER Auftrag traegt) selbst in einen 'Multi-line'-
# Eingabemodus um, kenntlich an einem Wechsel der Fusszeile — und darin fuegt Enter nur
# eine neue Zeile ein, statt abzusenden. Ein zweiter, harness-EIGENER Absende-Schluessel
# ersetzt Enter nur dann, wenn dessen ANKUENDIGUNG auf dem Bildschirm wirklich steht —
# nie blind hinterhergeschickt: ein Harness, der laengst abgeschickt hat, saehe sonst
# eine zweite Taste in seiner naechsten, leeren Eingabe landen (derselbe Fehler wie
# "blind Enter druecken" im Vertrauensdialog, an dem agy gescheitert ist).
ALTSUBMIT_TRIGGER=""
ALTSUBMIT_KEY=""
# claude models accept an optional effort suffix: claude-haiku:low, claude-fable:medium …
EFFORT="${MODEL#*:}"; [ "$EFFORT" = "$MODEL" ] && EFFORT=""
MODEL="${MODEL%%:*}"
# EFFORT_ID haelt die REGISTRY-Identitaet des Modells fest (Nachtrag 3,
# 2026-08-19), fuer den Denkstufen-Deckel weiter unten -- getrennt von $MODEL,
# weil $MODEL in diesem case gleich auf die rohe Ollama-ID/den MLX-Pfad
# umgeschrieben wird und spaeter durch `wb-kontext ensure` noch einmal (auf die
# gebrannte Variante). 'ornith-35b' etwa ist niemals gleich dem $MODEL-Wert
# 'ornith:35b', den die Registry unter genau dieser ID fuehrt.
EFFORT_ID=""
case "$MODEL" in
  qwen)    EFFORT_ID="qwen3.6:35b-a3b-coding-nvfp4"; MODEL="qwen3.6:35b-a3b-coding-nvfp4" ;;
  ornith)  EFFORT_ID="ornith-35b"; MODEL="ornith:35b" ;;
  ornith9) EFFORT_ID="ornith-9b"; MODEL="ornith:9b" ;;
  grug)
    # Token-freier Default-Coder seit 2026-08-11 (Messung: MLX 4bit schlaegt
    # Ollama und llama.cpp auf beiden Achsen, siehe regeln/lokale-modelle.md).
    # Der Server wird bei Bedarf gestartet, nie dauerhaft gehalten (kein
    # LaunchAgent) — ein Worker gegen einen toten Server ist schlimmer als
    # einer, der gar nicht startet.
    #
    # `grug-server ensure` steht NICHT mehr hier (Korrektur, Pruefer-Befund B7,
    # 19.08.2026): mitten in der Modell-Fallunterscheidung gerufen, lange bevor
    # der Kontextblock weiter unten die Stufe waehlt, bucht grug-server sein
    # eigenes, davon unabhaengiges Kontextmass -- pi bekommt danach eine ANDERE
    # Stufe gesagt, als tatsaechlich gebucht wurde. Der Aufruf wandert in den
    # gemeinsamen Kontext-Block, genau wie beim qwen38-Zweig, ueber
    # GRUG_VIA_SERVER (dasselbe Muster wie MLX_VIA_SERVER dort).
    PIPROVIDER=mlx-lokal
    GRUG_VIA_SERVER=1
    EFFORT_ID="grug-27b"
    MODEL="$HOME/AI/mlx-models/grug-27b-mlx-q4"
    ;;
  qwen38)
    # Neuer Standard-Worker fuer lokale Arbeit seit 2026-08-19 (des Nutzers
    # Entscheidung, GEMEINSAME-FAKTEN Nachtrag Punkt 6) — grug bleibt vollstaendig
    # erhalten und waehlbar, verliert nur den Vorgabe-Rang. qwen3.8 teilt sich mit
    # grug EINEN umschaltbaren MLX-Server (GEMEINSAME-FAKTEN Punkt 2); den
    # verwaltet `wb-mlx-server` (wird in Auftrag A gebaut, nicht in diesem
    # Arbeitsauftrag). Ein fehlendes Werkzeug ist ein klarer Fehler — nie ein
    # stiller Rueckfall auf grug-server, das waere das FALSCHE Modell.
    #
    # Der eigentliche `ensure`-Aufruf steht NICHT hier, sondern erst im
    # gemeinsamen Kontext-Block weiter unten, NACHDEM die Stufe feststeht:
    # `wb-mlx-server ensure` OHNE --kontext nimmt das Modell-Maximum, und das
    # lehnt wb-belegung fast immer ab (262144 Token x 4 parallel = 112 GiB
    # Spitze) — Hinweis aus der MLX-Spur, 2026-08-19.
    if [ ! -x "$HOME/.local/bin/wb-mlx-server" ]; then
      echo "FEHLER: wb-mlx-server fehlt — qwen3.8 laeuft ueber den umschaltbaren MLX-Server, den dieses Werkzeug verwaltet (Auftrag A). Kein Rueckfall auf grug-server (falsches Modell)." >&2
      exit 1
    fi
    PIPROVIDER=mlx-lokal
    MLX_VIA_SERVER=1
    EFFORT_ID="qwen38-27b"
    MODEL="$HOME/AI/mlx-models/qwen38-27b-mlx-4bit"
    ;;
  claude|claude-sonnet|claude-sonnet5) ENGINE=claude; CMODEL="claude-sonnet-5" ;;
  claude-haiku|claude-haiku45)         ENGINE=claude; CMODEL="claude-haiku-4-5" ;;
  claude-fable|claude-fable5)          ENGINE=claude; CMODEL="claude-fable-5" ;;
  claude-opus5)                        ENGINE=claude; CMODEL="claude-opus-5" ;;
  claude-opus48)                       ENGINE=claude; CMODEL="claude-opus-4-8" ;;
  claude-opus)                         ENGINE=claude; CMODEL="claude-opus-4-8" ;;
  # No `*)` branch used to exist: a typo like `sonnet5x` became `claude-sonnet5x`,
  # fell through every pattern, stayed ENGINE=pi and started pi against an Ollama
  # model that does not exist — a worker that boots and fails later, silently.
  claude*|Claude*)
    # V3 (SPEC-V3 C): the built-in aliases above stay the fast path; an unknown id
    # asks the REGISTRY before it becomes an error. Only when that is empty too does
    # the old message stand.
    if [ -n "$($HOME/.local/bin/wb-state models get "$MODEL" --field id 2>/dev/null || true)" ]; then
      ENGINE=registry
    else
      # A20, Entscheidung des Nutzers vom 2026-08-06: Die Registry ist ein Katalog und
      # kein Tuersteher. Ein Name, der sich als Claude-Modell ausgibt, startet auch
      # dann, wenn wir ihn nicht kennen — ob es ihn gibt, sagt die CLI. Bis heute
      # endete dieser Zweig mit einem Fehler, und ein Modell, das der Anbieter
      # gestern ausgeliefert hat, war damit bis zur naechsten Registry-Pflege
      # unbenutzbar. Was ein unbekanntes Modell NICHT bekommt, ist eine Empfehlung:
      # keine Eignung, kein Kostenhinweis, keine Zeile in der Routing-Tabelle.
      #
      # GEMESSEN am selben Tag, und der Grund fuer den Hinweis unten: die CLI weist
      # einen unbekannten Namen NICHT beim Start zurueck. Sie startet ihre
      # Oberflaeche, zeigt ihn in der Statuszeile und wartet auf Eingaben; erst die
      # erste Anfrage scheitert. Ein Tippfehler sieht also aus wie ein arbeitender
      # Worker, bis das Ergebnis ausbleibt. Deshalb steht der Hinweis hier und nicht
      # nur in der Dokumentation.
      #
      # Nur dieser Zweig ist offen. Ein Name OHNE 'claude'-Praefix landet weiterhin
      # im Zweig darunter und wird abgelehnt, wenn ihn weder Registry noch Ollama
      # kennen — sonst wuerde aus dem Tippfehler 'ornith9x' ein Claude-Start.
      ENGINE=claude; CMODEL="$MODEL"; UNGEMESSEN=1
      echo "HINWEIS: '$MODEL' steht nicht in der Registry — Start ohne Empfehlung und ohne" >&2
      echo "  Eignungsangabe. Kennt die CLI den Namen nicht, scheitert erst die erste" >&2
      echo "  Anfrage IM Pane, nicht der Start: dann bleibt das Ergebnis aus." >&2
      echo "  Registrieren: wb-state models add … (dann gibt es auch Deckel und Eignung)." >&2
    fi ;;
  *)
    # Registry first, THEN the raw-Ollama-id passthrough: a model somebody took the
    # trouble to register must win over the same string happening to be installed in
    # Ollama — otherwise its harness, effort caps and role filter would be skipped.
    #
    # EXCEPT harness=pi (Betriebsbefund 19.08.2026 abends, der Nutzer): ein
    # LOKALES Modell unter seiner REGISTRY-KENNUNG statt seines Kurzalias
    # ('qwen38-27b' statt 'qwen38' -- genau das, was die Oberflaeche in ihrer
    # Modellliste zeigt und weiterreicht) landete bisher trotzdem bei
    # ENGINE=registry -> wb-harness-run -> 'wb-state models resolve', und DAS
    # kennt wb-kontext/wb-mlx-server nicht -- gemessen: die Zeile kam mit
    # '--provider ollama --model <MLX-Verzeichnispfad>' heraus, derselbe
    # Fehlerausgang wie in wb-code (400 "invalid model name"), nur ueber einen
    # anderen Weg. Ein registriertes Modell MIT harness=pi gehoert stattdessen
    # in denselben schnellen Pfad wie die Kurzaliase oben (ENGINE bleibt
    # "pi") -- der kennt beides bereits richtig.
    RHARNESS_PI="$($HOME/.local/bin/wb-state models get "$MODEL" --field harness 2>/dev/null || true)"
    if [ "$RHARNESS_PI" = pi ]; then
      RPROVIDER_PI="$($HOME/.local/bin/wb-state models get "$MODEL" --field provider 2>/dev/null || true)"
      RMODELREF_PI="$($HOME/.local/bin/wb-state models get "$MODEL" --field modelRef 2>/dev/null || true)"
      if [ -z "$RPROVIDER_PI" ] || [ -z "$RMODELREF_PI" ]; then
        echo "FEHLER: Registry-Eintrag '$MODEL' hat harness=pi, aber kein provider/modelRef — kein Spawn." >&2
        exit 1
      fi
      EFFORT_ID="$MODEL"
      PIPROVIDER="$RPROVIDER_PI"
      MODEL="$RMODELREF_PI"
      # mlx-lokal laeuft ueber den umschaltbaren MLX-Server, wie der 'qwen38'-
      # Kurzalias oben (grugs eigener grug-server-Weg ist eine benannte
      # Ausnahme fuer GENAU dieses Modell, keine Vorgabe fuer jedes weitere
      # mlx-lokal-Modell aus der Registry).
      [ "$RPROVIDER_PI" = mlx-lokal ] && MLX_VIA_SERVER=1
    elif [ -n "$($HOME/.local/bin/wb-state models get "$MODEL" --field id 2>/dev/null || true)" ]; then
      ENGINE=registry
    # A raw Ollama model id stays allowed (documented above), but only if it really
    # exists here — otherwise it is a typo and must not start anything.
    elif command -v ollama >/dev/null 2>&1 \
       && ollama list 2>/dev/null | awk 'NR>1{print $1; sub(/:.*/,"",$1); print $1}' | grep -qx "$MODEL"; then
      EFFORT_ID="$MODEL"   # roh, unregistriert -- der Harness-Deckel greift trotzdem (siehe unten)
    else
      echo "FEHLER: unbekanntes Modell '$MODEL'." >&2
      echo "  Lokal: qwen qwen38 ornith ornith9 grug — oder eine installierte Ollama-ID ('ollama list')." >&2
      echo "  Claude: haiku45 sonnet5 opus5 opus48 fable5 (ueber claude-worker)." >&2
      echo "  Registriert: $($HOME/.local/bin/wb-state models list 2>/dev/null | tr '\n' ' ')" >&2
      exit 1
    fi ;;
esac

# ── Denkstufe fuer den SCHNELLEN pi-Pfad (Nachtrag 3, 2026-08-19) ─────────────
# Bug, gemeldet vom Orchestrator: dieser Pfad gab bisher UEBERHAUPT kein
# --thinking mit. $EFFORT wurde oben aus 'modell:stufe' geparst, aber danach
# fallengelassen -- jeder lokale Worker lief mit dem, was Modell/pi von sich
# aus waehlen. Bei qwen3.8 ist das die teure Falle: seine Chat-Vorlage setzt
# reasoning_effort selbst auf xhigh, gemessen ueber 28 Minuten statt 62
# Sekunden je Einheit (Faktor 27).
#
# Herkunft der Stufe: das ':stufe'-Suffix am Aufruf ($EFFORT, falls gesetzt),
# sonst das defaultEffort des Modells aus der Registry. Entschieden wird das an
# DERSELBEN Stelle wie fuer claude (`wb-state models effort` -- der Kommentar
# "Welche Stufe wirklich gestartet wird, entscheidet EINE Stelle" im
# claude-Zweig weiter unten erklaert, warum es nur diese eine Stelle gibt):
# keine zweite Kopie der Deckel-Regel hier in bash. `${EFFORT_ID:-$MODEL}`
# faellt auf den rohen Modellnamen zurueck, wenn keine Registry-Identitaet
# bekannt ist (roher Ollama-Passthrough) -- `models effort` behandelt ein
# unregistriertes Modell mit `--harness` bereits richtig (Harness-Stufenliste
# minus 'max' als Deckel, siehe cmd_effort in wb-state).
#
# pis eigene Stufenleiter (`pi --help`): off, minimal, low, medium, high,
# xhigh, max. Die Werkbank-Stufenleiter (BUILTIN_HARNESSES['pi']['effort'] in
# wb-state) bildet genau die FUENF gemeinsamen Worte per Identitaet ab
# (low->low, medium->medium, high->high, xhigh->xhigh, max->max) und laesst
# 'off'/'minimal' bewusst aus -- "die Werkbank kennt keine Stufe unter low".
# $THINKING kommt aus `models effort` deshalb schon im pi-Wortschatz zurueck,
# keine weitere Umschreibung noetig.

# ── Nebenlaeufigkeit gegen den GETEILTEN MLX-Server (Nachtrag 3, 2026-08-19,
# Rechnung korrigiert vom Nutzer am selben Tag) ─────────────────────────────
# grug und qwen38 laufen ueber EINEN gemeinsamen MLX-Server. decode-concurrency
# 4 ist eine KAPAZITAET des Servers, keine automatische Buchung -- ein
# einzelner Worker bucht seine eigene Sequenz, mehrere Worker addieren sich zu
# der Zahl, die wirklich gleichzeitig laeuft. mlx_worker_anzahl() steht deshalb
# HIER, vor der Kontextwahl: die automatische Stufenwahl unten zaehlt die
# BEREITS laufenden lokalen Worker mit, statt so zu tun, als waere sie die
# einzige (derselbe Zaehler traegt weiter unten auch die reine
# Geschwindigkeits-Warnung ab decode-concurrency). Panes werden beim Spawn mit
# @wb_lokal_provider markiert (siehe weiter unten) und hier MASCHINENWEIT
# gezaehlt -- ueber alle wb-*-Sessions, nicht nur die eigene, weil der Server
# sich nicht um Session-Grenzen schert.
MLX_NEBENLAEUFIGKEIT_SUESSPUNKT=4
mlx_worker_anzahl() {
  tmux list-panes -a -F '#{@wb_lokal_provider} #{pane_dead}' 2>/dev/null \
    | awk '$1=="mlx-lokal" && $2=="0"' | wc -l | tr -d ' '
}
# Prefix, nicht Gleichheit (Betriebsbefund 19.08.2026 abends): wb-kontext
# ensure_mlx (Auftrag B) traegt einen MLX-Provider NIE als blankes "mlx-lokal"
# in ~/.pi/agent/models.json ein, sondern IMMER mit Kontextstufen-Suffix
# ("mlx-lokal-64k", "mlx-lokal-256k", ...) -- ein '=' gegen "mlx-lokal" trifft
# das nie, sobald $PIPROVIDER (weiter unten, nach 'wb-kontext ensure') den
# gebrannten Wert traegt. Vor 'wb-kontext ensure' ist der Wert dagegen noch
# das blanke "mlx-lokal" (siehe die case-Aeste oben). Beide Formen muessen als
# "das hier ist ein MLX-Modell" zaehlen -- der getaggte Pane-Wert selbst
# bleibt bewusst das blanke "mlx-lokal" (mlx_worker_anzahl() zaehlt danach),
# nur die Frage "ist es eins" wird hier auf den Praefix geprueft.
ist_mlx_lokal() { case "$1" in mlx-lokal*) return 0 ;; *) return 1 ;; esac; }

if [ "$ENGINE" = pi ]; then
  # ── Denken-immer-an-Riegel fuer WORKER (Anweisung des Nutzers, 2026-08-19,
  # woertlich: "fuer worker muss denken immer an sein, also mindestens auf
  # low") ─────────────────────────────────────────────────────────────────
  # Gemessen: der Arm OHNE Denken war der schnellste von allen, fiel bei der
  # Zitat-Ablehnungsquote aber sofort auf das Niveau des schwaecheren Modells
  # zurueck -- Denken ist bei diesen Modellen der WIRKSTOFF, nicht der
  # Aufschlag. Ein WORKER (alles, was ueber pi-worker startet) bekommt deshalb
  # nie 'off' oder 'minimal' -- die einzig realistische Quelle dafuer ist das
  # ':stufe'-Suffix am Aufruf, denn die Registry-Vorgabe kennt beide Worte gar
  # nicht (siehe die Denkstufen-Abbildung direkt oberhalb dieses Blocks). `wb-state models
  # effort` LEHNT 'off'/'minimal' ohnehin als Eingabe ab ("unbekannter effort"
  # -- gemessen), deshalb muss die Anhebung VOR diesem Aufruf stehen, nicht
  # danach. Der Riegel steht bewusst HIER, an der Stelle, die einen WORKER
  # startet -- nicht in wb-kontext und nicht in einer allgemeinen
  # Abbildungstabelle: Messstrecken, Rauchtests und Probelaeufe laufen nicht
  # ueber pi-worker und duerfen weiterhin ohne Denken fahren.
  case "$EFFORT" in
    off|minimal)
      echo "pi-worker: Denkstufe '$EFFORT' auf 'low' angehoben — ein Worker startet nie ohne Denken (Denken ist bei diesen Modellen der Wirkstoff, nicht der Aufschlag)." >&2
      EFFORT=low
      ;;
  esac
  EFF_OUT="$($HOME/.local/bin/wb-state models effort "${EFFORT_ID:-$MODEL}" --harness pi \
              ${EFFORT:+--effort "$EFFORT"} ${MENSCH:+--mensch} 2>&1)" || {
    printf '%s\n' "$EFF_OUT" >&2
    exit 1
  }
  THINKING="$(printf '%s\n' "$EFF_OUT" | tail -1)"
  VOR="$(printf '%s\n' "$EFF_OUT" | sed '$d')"
  [ -n "$VOR" ] && printf '%s\n' "$VOR" >&2
  # Gegenprobe (billig, deckt jeden kuenftigen Weg ab, der doch einmal
  # off/minimal zurueckgibt): derselbe Riegel, diesmal auf das ERGEBNIS.
  case "$THINKING" in
    off|minimal)
      echo "pi-worker: Denkstufe '$THINKING' auf 'low' angehoben — ein Worker startet nie ohne Denken." >&2
      THINKING=low
      ;;
  esac

  # ── Multi-Token-Vorhersage (2026-08-20, Vorgaben des Nutzers) ────────────────
  # Getrennter Schalter fuer WORKER ('workerVorhersage', nicht
  # 'orchestratorVorhersage' -- siehe shell/wb-code fuer den Orchestrator-
  # Zweig derselben Sache). WELCHES Modell dabei benutzt wird, steht in der
  # Registry und ist hier nicht waehlbar. EFFORT_ID traegt an dieser Stelle
  # schon die Registry-Kennung (oben im case-Block gesetzt, derselbe Wert,
  # den die Denkstufen-Deckelung weiter oben schon benutzt) -- kein zweiter
  # Alias-Uebersetzer noetig.
  VORH_BAUART=""; VORH_MODELL=""; VORH_GEWICHTE_GB=""
  VORH_AN="$($HOME/.local/bin/wb-state settings get workerVorhersage 2>/dev/null || true)"
  if [ "$VORH_AN" = "true" ] && ist_mlx_lokal "$PIPROVIDER"; then
    VORH_JSON="$($HOME/.local/bin/wb-state models get "${EFFORT_ID:-$MODEL}" --field vorhersage 2>/dev/null || true)"
    if [ -n "$VORH_JSON" ]; then
      VORH_BAUART="$(printf '%s' "$VORH_JSON" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("bauart") or "")
except Exception:
    print("")' 2>/dev/null)"
      VORH_MODELL="$(printf '%s' "$VORH_JSON" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("modell") or "")
except Exception:
    print("")' 2>/dev/null)"
      VORH_GEWICHTE_GB="$(printf '%s' "$VORH_JSON" | python3 -c 'import json,sys
try:
    v = json.load(sys.stdin).get("gewichteGb")
    print(v if v is not None else "")
except Exception:
    print("")' 2>/dev/null)"
    fi
    if [ -n "$VORH_BAUART" ]; then
      echo "pi-worker: Multi-Token-Vorhersage an ($VORH_BAUART: $VORH_MODELL)." >&2
    else
      echo "pi-worker: Multi-Token-Vorhersage an, aber fuer '${EFFORT_ID:-$MODEL}' nichts in der Registry hinterlegt." >&2
    fi
  fi
  ENTWERFER_ARGS=()
  if [ "$VORH_BAUART" = entwerfer ] && [ -n "$VORH_GEWICHTE_GB" ]; then
    ENTWERFER_ARGS=(--entwerfer-gewichte-gb "$VORH_GEWICHTE_GB")
  fi

  # ── Kontextfenster (wb-kontext, Auftrag B 2026-08-19) ─────────────────────────
  # Gilt nur fuer ein LOKALES Modell (ENGINE bleibt hier "pi" -- claude und ein
  # registrierter Adapter haben kein waehlbares Kontextfenster in diesem Sinn).
  # EIN Aufruf von `wb-kontext stufen --json` liefert Empfehlung UND deren
  # Passt-Status zusammen -- keine zweite Messung noetig. `--denken "$THINKING"`
  # (Nachtrag 3): eine hoehere Denkstufe braucht bei GLEICHER Aufgabe spuerbar
  # mehr Ausgabe-Token, und die belegen KV genauso wie Prompt-Token -- Herleitung
  # steht als Kommentar in wb-kontext bei DENK_FAKTOR.
  # 'parallel' zaehlt hier die bereits laufenden MLX-Worker mit + diesen einen
  # (Korrektur, 19.08.2026): "ich will N Worker gleichzeitig -- wie gross darf
  # das Fenster je Worker sein" ist die Frage, die wb-kontext beantwortet, und
  # pi-worker ist der sachkundige Aufrufer, der N wirklich kennt. Fuer Ollama
  # bleibt es bei 1 -- kein geteilter Server, jeder Ollama-Worker ist fuer sich.
  KPARALLEL=1
  ist_mlx_lokal "$PIPROVIDER" && KPARALLEL=$(( $(mlx_worker_anzahl) + 1 ))
  KWARN="$(mktemp "${TMPDIR:-/tmp}/pi-worker-kontext.XXXXXX")"
  # "${ENTWERFER_ARGS[@]+"${ENTWERFER_ARGS[@]}"}", nicht "${ENTWERFER_ARGS[@]}":
  # auf macOS' Bash 3.2 wirft ein LEERES Array unter 'set -u' sonst "unbound
  # variable" (gemessen, 20.08.2026) -- das Array selbst IST deklariert, nur
  # ohne Elemente. Der naheliegende Ausweg "${ARR[@]:-}" ist selbst falsch:
  # er ersetzt ein leeres Array durch EIN leeres Wort statt durch NULL
  # Woerter, und wb-kontexts argparse lehnt das dann als "unrecognized
  # arguments" ab (ebenfalls gemessen) -- dieser Weg mit '+' liefert bei
  # einem leeren Array wirklich null Woerter.
  # --vorhersage-einstellung workerVorhersage (Nachtrag 21.08.2026, Befund vom
  # echten Doppelstart in wb-code): 'eingebaut' liest die Registry SELBST
  # (wb-kontext resolve()), anders als 'entwerfer' oben also NICHT ueber
  # VORH_BAUART/ENTWERFER_ARGS gegen $VORH_AN abgesichert. Ohne diese Zeile
  # rechnete wb-kontext den MTPLX-Koerper, selbst wenn $VORH_AN hier oben
  # "false" war und der schlichte Koerper startet -- wb-kontext liest
  # dieselbe Einstellung selbst nach, denselben Weg wie oben ("wb-state
  # settings get workerVorhersage").
  KJSON="$("$HOME/.local/bin/wb-kontext" stufen "$MODEL" --parallel "$KPARALLEL" --denken "$THINKING" --vorhersage-einstellung workerVorhersage "${ENTWERFER_ARGS[@]+"${ENTWERFER_ARGS[@]}"}" --json 2>"$KWARN")"
  KRC=$?
  KHINWEIS="$(cat "$KWARN" 2>/dev/null)"; rm -f "$KWARN"
  if [ "$KRC" -ne 0 ] || [ -z "$KJSON" ]; then
    [ -n "$KHINWEIS" ] && echo "$KHINWEIS" >&2
    echo "FEHLER: Kontextstufen fuer '$MODEL' nicht zu ermitteln — kein Spawn." >&2
    exit 1
  fi
  case "$KONTEXT_ARG" in
    ""|auto)
      # 'auto' heisst ueberall dasselbe wie kein Schalter (Vereinheitlichung,
      # Nachtrag 2 vom 2026-08-19 -- zuvor bedeutete 'auto' hier faelschlich die
      # Registry-Vorgabe/das Modell-Maximum, in wb-code aber schon die Automatik;
      # ein Wort mit zwei Bedeutungen in zwei Werkzeugen war ein Fehler, kein
      # Geschmack). Anders als in wb-code gibt es hier KEINEN Settings-Schritt:
      # ueber das Fenster eines WORKERS entscheidet der Orchestrator, nicht die
      # Einstellungsdatei eines Menschen, die es fuer einen Worker gar nicht gibt.
      STUFE="$(printf '%s' "$KJSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["empfehlung"])')"
      PASST="$(printf '%s' "$KJSON" | python3 -c '
import json, sys
d = json.load(sys.stdin)
s = next((x for x in d["stufen"] if x["tokens"] == d["empfehlung"]), None)
sys.stdout.write("ja" if (s and s["passt"]) else "nein")')"
      if [ "$PASST" != ja ]; then
        # Reicht es fuer KEINE Stufe mehr, bricht der Spawn ab, statt die
        # Maschine an den Rand zu fahren (Kernel-Panik-Historie 11.08.2026).
        echo "FEHLER: fuer '$MODEL' passt nach dem freien Speicher nicht einmal die kleinste Kontextstufe — kein Spawn." >&2
        [ -n "$KHINWEIS" ] && echo "  $KHINWEIS" >&2
        echo "  Speicherstand: wb-kontext stufen $MODEL" >&2
        exit 1
      fi
      echo "pi-worker: Kontext automatisch gewaehlt (freier Speicher) — $STUFE Token." >&2
      ;;
    *)
      STUFE="$KONTEXT_ARG"
      ;;
  esac
  # Der wirklich laufende KOERPER, fuer den KV-Schluessel weiter unten (Auftrag
  # 2026-08-21 abends, Befund "Namensverwechslung"): $MODEL wird gleich durch
  # 'wb-kontext ensure' auf den Namen umgeschrieben, den PI ALS MODELL BEKOMMT
  # (siehe unten, --bedient-als) -- das kann seit heute Abend der BEDIENTE
  # Servername sein ("mtplx-qwen38-27b-optimized-speed"), nicht mehr zwingend
  # ein Pfad. Der KV-Schluessel braucht etwas anderes: den Verzeichnisnamen
  # des Koerpers, der WIRKLICH geladen ist. Bei bauart "eingebaut" ersetzt
  # vorhersage.modell (VORH_MODELL, oben schon gelesen) den Registry-Koerper --
  # dieselbe Ersetzung wie in wb-kontexts eigenem berechne() (siehe dort,
  # Nachtrag 2026-08-21): EINE Quelle, nicht zwei. Vor 'wb-kontext ensure'
  # erfasst, weil der Aufruf $MODEL gleich ueberschreibt.
  KOERPER_PFAD="$MODEL"
  if [ "$VORH_BAUART" = eingebaut ] && [ -n "$VORH_MODELL" ]; then
    KOERPER_PFAD="$VORH_MODELL"
  fi
  # qwen38 laeuft ueber den umschaltbaren MLX-Server, NIE ohne --kontext (sonst
  # nimmt es das Modell-Maximum, und das lehnt wb-belegung fast immer ab: 262144
  # Token x 4 parallel = 112 GiB Spitze). wb-mlx-server gibt dafuer aber KEINE
  # provider-Zeile aus -- ~/.pi/agent/models.json bleibt ausschliesslich Sache
  # von wb-kontext (Nachtrag 2026-08-19), dessen ensure deshalb IMMER laeuft,
  # zusaetzlich zu wb-mlx-server bei qwen38.
  MLXBEDIENT=""
  if [ -n "${MLX_VIA_SERVER:-}" ]; then
    # Durchreichung an den Server (Auftrag 2026-08-20, Punkt 3): shell/wb-mlx-
    # server ist nicht meine Datei und kennt heute noch kein eigenes CLI-Flag
    # dafuer -- Uebergabe ueber Umgebungsvariablen, nach demselben Muster wie
    # WB_MLX_SERVER_DECODE_PARALLEL/_VORGABE/_OHNE_BELEGUNG (siehe wb-code fuer
    # denselben Vorschlag auf der Orchestrator-Seite). Nur per Praefix
    # gesetzt, kein Leck in den pi-Prozess.
    #
    # DIE AUSGABE WIRD JETZT GELESEN, NICHT WEGGEWORFEN (Auftrag 2026-08-21
    # abends): 'wb-mlx-server ensure' gibt seit heute Abend auf stdout eine
    # Zeile 'modell=<name>' aus -- den Namen, unter dem der Server WIRKLICH
    # antwortet. wb-code (Orchestrator-Seite) liest sie schon so, seit
    # demselben Nachtrag; hier fehlte die Gegenstelle, und genau das war die
    # Ursache: der mtplx-Server prueft den Modellnamen und weist jeden
    # anderen ab, waehrend pi-worker weiterhin den Registry-Pfad schickte --
    # ein fehlerfrei gestarteter Server, den sein Aufrufer nicht ansprechen
    # konnte. Stderr des Werkzeugs bleibt unveraendert sichtbar, nur stdout
    # wird eingefangen.
    MLXAUS="$(WB_MLX_SERVER_VORHERSAGE_BAUART="$VORH_BAUART" \
      WB_MLX_SERVER_VORHERSAGE_MODELL="$VORH_MODELL" \
      WB_MLX_SERVER_VORHERSAGE_GEWICHTE_GB="$VORH_GEWICHTE_GB" \
      "$HOME/.local/bin/wb-mlx-server" ensure "$MODEL" --kontext "$STUFE")" || {
      echo "FEHLER: 'wb-mlx-server ensure' fuer Kontext $STUFE fehlgeschlagen — kein Spawn." >&2
      exit 1
    }
    MLXBEDIENT="$(printf '%s\n' "$MLXAUS" | sed -n 's/^modell=//p' | head -1)"
    if [ -n "$MLXBEDIENT" ] && [ "$MLXBEDIENT" != "$MODEL" ]; then
      echo "pi-worker: der Server bedient '$MLXBEDIENT' (nicht '$MODEL') — pi bekommt diesen Namen." >&2
    fi
  fi
  # grug-server ensure steht ERST hier, NACH der Kontextwahl (Pruefer-Befund
  # B7): `grug-server` kennt keinen --kontext-Schalter (nicht mein Bereich,
  # nicht anfassen), aber der Aufruf steht jetzt wenigstens an derselben
  # Stelle wie beim qwen38-Zweig -- er bucht, NACHDEM feststeht, welche Stufe
  # pi tatsaechlich gleich gesagt bekommt, nicht lange vorher mitten in der
  # Modell-Fallunterscheidung.
  if [ -n "${GRUG_VIA_SERVER:-}" ]; then
    "$HOME/.local/bin/grug-server" ensure || {
      echo "FEHLER: grug-server nicht bereit — pi-worker bricht ab, statt gegen einen toten Server zu starten." >&2
      exit 1
    }
  fi
  # --bedient-als (Auftrag 2026-08-21 abends): schreibt den bedienten Namen als
  # `id` in pis Modell-Eintrag und gibt ihn als erste Zeile zurueck -- $MODEL
  # wird gleich darauf das, was pi als --model bekommt (siehe wb-code fuer
  # denselben Weg auf der Orchestrator-Seite). Leer (Ollama, grug, oder ein
  # MLX-Motor ohne eigenen Servernamen) heisst wie bisher: der Pfad ist der
  # Name.
  BEDIENT_ARGS=()
  [ -n "${MLXBEDIENT:-}" ] && BEDIENT_ARGS=(--bedient-als "$MLXBEDIENT")
  ENSURED="$("$HOME/.local/bin/wb-kontext" ensure "$MODEL" "$STUFE" "${BEDIENT_ARGS[@]+"${BEDIENT_ARGS[@]}"}")" || {
    echo "FEHLER: Kontextstufe $STUFE fuer '$MODEL' nicht lieferbar — kein Spawn." >&2
    exit 1
  }
  MODEL="$(printf '%s\n' "$ENSURED" | head -1)"
  KPROV="$(printf '%s\n' "$ENSURED" | sed -n 's/^provider=//p')"
  [ -n "$KPROV" ] && PIPROVIDER="$KPROV"
  KONTEXT_STUFE="$STUFE"

  # ── Eigene Sequenz buchen (Korrektur, 19.08.2026) ──────────────────────────
  # "Der Server bucht Gewichte plus EINE Sequenz. JEDER weitere lokale Worker
  # bucht VOR seinem Start seine EIGENE Sequenz dazu (1 x seine Kontextstufe x
  # KV je Token) und gibt sie beim Schliessen zurueck." -- KEINE Gewichte hier
  # (0,001 GiB statt 0 GiB, weil wb-belegung --gewichte-gb > 0 verlangt; die
  # Gewichte sind schon geladen und werden vom SERVERSTART gebucht, nicht von
  # jedem einzelnen Worker erneut). Nur bei einem ECHTEN Neuspawn -- ein
  # wiederverwendeter Pane fuegt keine neue gleichzeitige Sequenz hinzu, dafuer
  # der fruehe find_pane-Blick hier (ein zweites Mal, billig, reine
  # tmux-Abfrage -- die eigentliche Spawn/Reuse-Entscheidung faellt unveraendert
  # weiter unten). Wird die Buchung abgelehnt, startet der Worker NICHT -- das
  # ist der Schutz gegen die Kernel-Panik-Historie, genauer als eine pauschale
  # Vier, weil er misst, was wirklich frei ist.
  BELEGUNG_KENNUNG=""
  if ist_mlx_lokal "$PIPROVIDER"; then
    VORAB_INFO=$(find_pane); VORAB_PANE=${VORAB_INFO%% *}
    if [ -z "$VORAB_PANE" ]; then
      # Der Dateiname des KOERPERS (KOERPER_PFAD, oben gesetzt -- VOR der
      # 'wb-kontext ensure'-Zeile, die $MODEL ueberschreibt), NICHT $MODEL
      # selbst und nicht der volle Pfad (Korrektur 2026-08-21 abends,
      # Namensverwechslung, Ergebnis 20260821-050834.md): $MODEL traegt ab der
      # ensure-Zeile den Namen, den PI ALS MODELL BEKOMMT -- seit
      # --bedient-als kann das der bediente Servername sein
      # ("mtplx-qwen38-27b-optimized-speed"), eine ganz andere Aufgabe als der
      # KV-Schluessel. wb-belegungs eigener KV-Schluessel ist der
      # Verzeichnisname des Modellkoerpers ("qwen38-27b-mlx-4bit" bzw., bei
      # bauart "eingebaut", der Ersatzkoerper aus vorhersage.modell --
      # "Qwen3.8-27B-MTPLX-Optimized-Speed"), derselbe wie in wb-kontexts
      # eigenem kv_mib_pro_token(). Weder der bediente Name noch der volle
      # Pfad trifft dort einen Eintrag; beides faellt auf wb-belegungs
      # eigenen, deutlich groesseren "unbekannt"-Ersatzwert zurueck -- kein
      # Fehler in wb-belegung, nur die falsche Schluesselform von hier aus
      # (gemessen: rund das Vierzehnfache bei 32768 Token). Absichtlich OHNE
      # die beiden Zahlen selbst: sie haengen an wb-belegungs eigenem
      # Sicherheitsfaktor, den eine andere Spur pflegt und der sich seitdem
      # schon einmal geaendert hat (Pruefer-Befund N6, 19.08.2026 abends, traf
      # genau diese Zeile mit einer laengst veralteten Zahl) -- wer die
      # aktuelle Differenz sehen will: `wb-belegung darf --modell
      # <voller-pfad>` gegen `wb-belegung darf --modell <basename>`.
      BMODELL="$(basename "$KOERPER_PFAD")"
      # --ohne-sockel (Auftrag "der feste Sockel wird je Worker erneut
      # gebucht", 2026-08-20): der Fixkosten-Sockel ist Server-Fixkosten,
      # vom SERVERSTART schon einmal gebucht (siehe wb-mlx-server) -- ein
      # Worker, der sich hier an den laufenden Server haengt, bucht nur
      # seinen eigenen Anteil an der Pro-Sequenz-Rate, sonst zaehlt der
      # Sockel bei jedem Worker erneut mit.
      BJSON="$("$HOME/.local/bin/wb-belegung" nimm --gewichte-gb 0.001 --modell "$BMODELL" \
                --parallel 1 --kontext "$STUFE" --zweck "pi-worker:$NAME" --frist 240 \
                --ohne-sockel --json 2>&1)"
      BRC=$?
      BJA="$(printf '%s' "$BJSON" | python3 -c 'import json,sys
try:
    print("ja" if json.load(sys.stdin).get("ja") else "nein")
except Exception:
    print("nein")' 2>/dev/null)"
      if [ "$BRC" -ne 0 ] || [ "$BJA" != ja ]; then
        echo "FEHLER: eigene Speicherbuchung fuer '$NAME' abgelehnt — kein Spawn." >&2
        printf '%s\n' "$BJSON" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin); print("  Grund:", d.get("grund") or d)
except Exception as e:
    print("  (Antwort nicht lesbar:", e, ")")' >&2 2>/dev/null || printf '%s\n' "$BJSON" >&2
        exit 1
      fi
      BELEGUNG_KENNUNG="$(printf '%s' "$BJSON" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("kennung") or "")' 2>/dev/null)"
      echo "pi-worker: eigene Sequenz gebucht ($STUFE Token, Kennung ${BELEGUNG_KENNUNG:-?})." >&2
    fi
  fi
fi

if [ "$ENGINE" = claude ]; then
  TITLE="claude:$NAME"
  # Welche Stufe wirklich gestartet wird, entscheidet EINE Stelle: wb-state. Bis
  # zum 2026-08-06 stand die Pruefung hier ein zweites Mal in bash -- eine feste
  # Vierer-Liste, eine unbedingte Ablehnung von `max` und ein eigener
  # Rangvergleich gegen `maxEffort`. Drei Kopien einer Entscheidung, die woanders
  # schon getroffen wird, und sie waren bereits auseinandergelaufen (der
  # entfernte Kommentar nannte fable jahrelang mit einem Deckel, den die Registry
  # nicht mehr trug). `models effort` beantwortet jetzt beides in einem Aufruf:
  # nimmt der Harness die Stufe an, und laesst der Deckel sie zu.
  #
  # --mensch wird DURCHGEREICHT, nicht neu entschieden: geprueft wurde ganz oben,
  # am Aufruf, wo die Herkunft noch messbar ist.
  # `--harness claude` sagt, WOMIT dieses Modell laeuft, auch wenn es (noch) in
  # keiner Registry steht: dieser Zweig ist der eingebaute schnelle Pfad, und ohne
  # models.json gibt es zwar die eingebauten Adapter, aber keine eingebauten
  # Modelleintraege. Ohne die Angabe scheiterte hier jeder claude-Worker einer
  # Werkbank ohne Registry-Datei.
  EFF_OUT="$($HOME/.local/bin/wb-state models effort "$CMODEL" --harness claude \
              ${EFFORT:+--effort "$EFFORT"} ${MENSCH:+--mensch} 2>&1)" || {
    printf '%s\n' "$EFF_OUT" >&2
    exit 1
  }
  # Die Antwort ist die LETZTE Zeile: davor koennen Hinweise stehen (etwa das
  # Absenken einer Vorgabe auf den Deckel), und die gehoeren nach stderr des
  # Aufrufers, nicht in die Variable.
  EFFORT="$(printf '%s\n' "$EFF_OUT" | tail -1)"
  VOR="$(printf '%s\n' "$EFF_OUT" | sed '$d')"
  [ -n "$VOR" ] && printf '%s\n' "$VOR" >&2
  if [ -n "$MENSCH" ]; then
    echo "pi-worker: als MENSCH gestartet — der Effort-Deckel gilt fuer diesen Start nicht (effort $EFFORT)." >&2
  fi
  # --dangerously-skip-permissions: workers run fully autonomous. settings.json
  # defaultMode is NOT reliably inherited by these sessions, so it is set
  # explicitly -- but since 2026-08-06 only when `workerSkipPermissions` says so.
  # The key defaults to true, and an unreadable settings file also yields true:
  # the fail-safe direction here is "keeps working as before", because switching
  # it off means every worker stops at its own permission prompt and a night run
  # stands until morning. Guards and the ask stage are untouched by this -- they
  # hang off the hook, not off the CLI.
  #
  # Remote Control MUSS hier aktiv abgeschaltet werden (Korrektur 2026-08-19 --
  # die Annahme unten war FALSCH und ist mit A/B auf einem eigenen tmux-Socket
  # widerlegt: 'claude --dangerously-skip-permissions' allein zeigt in der
  # Fusszeile ein /rc mit Sitzungs-Link, obwohl kein '--remote-control' auf der
  # Befehlszeile steht -- Auto-Verbinden greift ausserhalb der Einstellungsdateien
  # (App-/IDE-Schalter), 'kein Flag = aus' galt nicht mehr. Damit tauchten
  # WORKER-Sitzungen auf Handy des Nutzers in der Remote-Control-Liste auf. Der
  # einzige Weg, der es zuverlaessig abschaltet: '--settings' mit
  # 'remoteControlAtStartup: false' explizit auf der Befehlszeile. Zweite Stelle
  # derselben Regel: wb-state's `models resolve` fuer den Registry-Pfad (Rolle
  # worker) -- keine dritte Kopie.
  SKIPFLAG=" --dangerously-skip-permissions"
  if [ "$("$HOME/.local/bin/wb-state" settings get workerSkipPermissions 2>/dev/null)" = "false" ]; then
    SKIPFLAG=""
    echo "pi-worker: workerSkipPermissions=false — dieser Worker haelt bei jedem Schreibzugriff an." >&2
  fi
  # printf %q hier, NICHT nur beim finalen Zusammenbau der CHAT-Zeile: der JSON-
  # Text traegt ein Leerzeichen und Anfuehrungszeichen und muss als EIN Argument
  # durch printf %q (fuer die spaetere bash -lc-Huelle) UND die eigene
  # Wort-Trennung von bash -lc hindurch ankommen -- gemessen (siehe Ergebnis-
  # Beleg), nicht angenommen.
  #
  # crossSessionInbound (2026-08-20): ohne diesen Wert wird ein Auftrag, der ueber
  # die Socket-Inbox statt ueber die Eingabezeile kommt, ANGEHALTEN -- der Worker
  # zeigt einen Auswahldialog und arbeitet nicht, bis jemand ihn beantwortet.
  # Gemessen auf eigenem tmux-Socket, dreimal: ohne die Einstellung angehalten,
  # mit ihr zugestellt und ausgefuehrt. Der Grund, den Claude Code selbst nennt:
  # ein Absender, der eine Shell ist, kann seine Berechtigungsstufe nicht
  # bezeugen, waehrend der Worker mit uebersprungenen Rueckfragen laeuft. Der
  # Wert steht deshalb HIER, auf der Befehlszeile genau dieses Workers, und nicht
  # in einer Einstellungsdatei: er gilt fuer die Sitzungen, die die Werkbank
  # selbst startet, und fuer keine andere. Wer die Inbox nicht will, stellt
  # `workerZustellung` auf `paste` -- dann wird sie nie benutzt, und der Wert
  # aendert nichts.
  RC_SETTINGS=" --settings $(printf %q '{"remoteControlAtStartup": false, "crossSessionInbound": "accept"}')"

  # KNAPPE MCP-AUSSTATTUNG FUER WORKER (2026-08-20, Messung des Workers
  # "speicher"). Eine frische Sitzung kostet 516 MiB, mit
  # `--strict-mcp-config --mcp-config <datei>` und nur basic-memory darin
  # 252 MiB -- 264 MiB je Sitzung, 51 Prozent. Der ganze Unterschied ist der
  # Playwright-MCP: 163 MiB fuer den npm-exec-Wrapper und 97 MiB fuer den
  # Server. Ein Worker benutzt ihn fast nie, der ORCHESTRATOR schon (Web-Design
  # braucht den Browser) -- und der laeuft hier nicht durch, dieser Zweig
  # startet ausschliesslich Worker.
  #
  # basic-memory bleibt erreichbar, weil es ueber HTTP an einen geteilten
  # Daemon geht und je Sitzung keinen eigenen Prozess braucht; der Vault-Zugriff
  # eines Workers aendert sich also nicht.
  #
  # WARUM HIER UND NICHT IN DER REGISTRY: dieser Zweig ist der schnelle Pfad fuer
  # die Aliase haiku45|sonnet5|opus5|opus48|fable5 und baut seine Startzeile
  # selbst -- `harnesses[claude].args` kommt hier nie an.
  #
  # Die Datei wird angelegt, wenn sie fehlt, statt auf einen Ausrollschritt zu
  # warten: ein Worker, der wegen einer fehlenden Konfigurationsdatei ohne
  # Werkzeuge startet, waere teurer als die 264 MiB.
  MCPFLAGS=""
  if [ -z "${WB_MCP_VOLL:-}" ]; then
    MCP_WORKER="$HOME/.claude/workbench/mcp-worker.json"
    if [ ! -s "$MCP_WORKER" ]; then
      mkdir -p "$(dirname "$MCP_WORKER")" 2>/dev/null
      printf '%s\n' '{"mcpServers":{"basic-memory":{"type":"http","url":"http://127.0.0.1:8766/mcp"}}}' \
        > "$MCP_WORKER" 2>/dev/null || true
    fi
    if [ -s "$MCP_WORKER" ]; then
      MCPFLAGS=" --strict-mcp-config --mcp-config $(printf %q "$MCP_WORKER")"
    else
      echo "pi-worker: $MCP_WORKER liess sich nicht anlegen — Worker startet mit voller MCP-Ausstattung." >&2
    fi
  else
    echo "pi-worker: WB_MCP_VOLL gesetzt — dieser Worker bekommt die volle MCP-Ausstattung (Browser-MCP kostet gemessen 264 MiB)." >&2
  fi

  CFLAGS="--model $CMODEL --effort ${EFFORT:-medium}$SKIPFLAG$RC_SETTINGS$MCPFLAGS"
  # Die Chat-Zuordnung (SPEC-V4 6.3 Punkt 4) installiert sich sonst NIE fuer
  # diesen Zweig: er baut seine Startzeile selbst und laeuft nie durch
  # wb-harness-run, dem einzigen anderen Ort, der den Hook eintraegt. 'claude'
  # ist zudem der einzige Harness mit session.zuordnung=hook (models.default.json) --
  # ohne diesen Aufruf bekaeme die Chat-Ansicht fuer KEINE einzige Claude-Sitzung
  # eine Sitzungskennung am Pane. Gemeinsame Stelle mit dem Registry-Zweig unten:
  # shell/wb-chat-hook-install, nicht hier ein zweites Mal nachgebaut (siehe dort
  # fuer die Begruendung). Repo-Fassung zuerst, gleiche Bauart wie wb-rolle.
  CHATHOOK_INSTALL=""
  for kandidat in "$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/wb-chat-hook-install" \
                  "$HOME/.local/bin/wb-chat-hook-install"; do
    [ -x "$kandidat" ] && { CHATHOOK_INSTALL="$kandidat"; break; }
  done
  if [ -n "$CHATHOOK_INSTALL" ]; then
    "$CHATHOOK_INSTALL" claude
  else
    echo "pi-worker: wb-chat-hook-install nicht gefunden — keine Chat-Zuordnung eingetragen." >&2
  fi
  CHAT="cd $(printf %q "$WORKDIR") && exec $HOME/.local/bin/claude $CFLAGS --append-system-prompt \"\$(cat $HOME/.claude/roles/agent.md)\""
elif [ "$ENGINE" = registry ]; then
  # V3 (SPEC-V3 B/C): a registered model. `wb-state models resolve` is the ONLY
  # place a start command is built — it also enforces the effort caps, the role
  # filter, the machine list and refuses an adapter whose readyPattern was never
  # measured. Everything below this branch (ready-wait, paste+enter verification,
  # result protocol, visibility guard, maxWorkers, state entry) stays IDENTICAL for
  # every harness; that is the contract the rest of the workbench hangs on.
  RESOLVED="$($HOME/.local/bin/wb-state models resolve "$MODEL" --role worker \
                ${EFFORT:+--effort "$EFFORT"} ${MENSCH:+--mensch} \
                --dir "$WORKDIR" --name "$NAME")" || exit 1
  rfield() { printf '%s\n' "$RESOLVED" | awk -F'\t' -v k="$1" '$1==k{print $2; exit}'; }
  RHARNESS="$(rfield harness)"; READY_RE="$(rfield ready)"; REFFORT="$(rfield effort)"
  PROMPT_RE="$(rfield prompt)"
  PROMPT_IGNORE="$(rfield promptignore)"
  ALTSUBMIT_TRIGGER="$(rfield altsubmittrigger)"
  ALTSUBMIT_KEY="$(rfield altsubmitkey)"
  [ -n "$RHARNESS" ] && [ -n "$READY_RE" ] || {
    echo "FEHLER: resolve lieferte kein Harness/Ready-Muster fuer '$MODEL' — kein Spawn." >&2; exit 1; }
  TITLE="$RHARNESS:$NAME"
  # The pane runs the shim, not the resolved line itself: the API key must never
  # pass through argv or a tmux option, and @wb_cmd stays re-executable (SPEC-V3 A.1).
  CHAT="exec $HOME/.local/bin/wb-harness-run --model $(printf %q "$MODEL") --role worker --effort $(printf %q "$REFFORT") --dir $(printf %q "$WORKDIR") --name $(printf %q "$NAME")"
else
  # OLLAMA_HOST is pinned explicitly so the pane never depends on an inherited
  # environment. NB (measured on peer 2026-07-25): pi does NOT read OLLAMA_HOST —
  # it takes the endpoint from ~/.pi/agent/models.json (baseUrl). On peer that
  # baseUrl points at 127.0.0.1:11434, which is an SSH tunnel to the Mac
  # (mac-ollama-tunnel.service), so a "local" pi worker here runs on Mac hardware.
  #
  # 2026-08-11: die Adresse kommt jetzt aus den Einstellungen (ollamaEndpoint),
  # nicht mehr fest aus dem Quelltext. Gelesen wird sie wie ueberall ueber
  # `wb-state settings get` -- eine leere oder unsinnige Form (AUFLAGE des
  # Auftrags: nie still alle lokalen Modelle abschalten) faellt auf denselben
  # Wert zurueck, der bisher hier stand.
  OLLAMA_ENDPOINT="$("$HOME/.local/bin/wb-state" settings get ollamaEndpoint 2>/dev/null)"
  case "$OLLAMA_ENDPOINT" in
    http://*|https://*) ;;
    *) OLLAMA_ENDPOINT="http://127.0.0.1:11434" ;;
  esac
  CHAT="cd $(printf %q "$WORKDIR") && export PATH=\$HOME/.local/bin:/opt/homebrew/bin:\$PATH && export OLLAMA_HOST=$(printf %q "$OLLAMA_ENDPOINT") && exec pi --provider $(printf %q "$PIPROVIDER") --model $(printf %q "$MODEL") --thinking $(printf %q "$THINKING") --session-dir $(printf %q "$SESSDIR") \$( ls $(printf %q "$SESSDIR")/*.json* >/dev/null 2>&1 && echo --continue ) --append-system-prompt \$HOME/.pi/agent/WORKER.md"
fi

# What the state file / sidebar records as this worker's kind: the harness that
# actually runs in the pane (V2 wrote 'claude' or 'pi'; a registry worker writes its
# own harness id, e.g. 'codex').
KIND="$ENGINE"; [ "$ENGINE" = registry ] && KIND="${RHARNESS:-registry}"
# Claude transcripts get recorded for the built-in claude engine AND for a REGISTRY
# model whose harness is claude — same files, same crash attribution, so a registry
# entry does not quietly lose it.
CTRACK=""; { [ "$ENGINE" = claude ] || [ "${RHARNESS:-}" = claude ]; } && CTRACK=1

# ── Kann diese Spur ueberhaupt liefern? (2026-08-10) ──────────────────────────
# Anlass: ein codex-Worker wurde in ein seit dem 07.08. erschoepftes Monatslimit
# gespawnt. Der Pane startete, nahm den Auftrag an und lief ins Leere -- ein
# ganzer Zug fuer nichts, und gemerkt hat es erst der Mensch. Dasselbe gilt fuer
# ein lokales Modell, das jemand aus Ollama geloescht hat.
#
# Die Frage steht hier und nicht weiter oben, weil erst hinter den ENGINE-Zweigen
# feststeht, WELCHER Harness mit WELCHEM Modell laeuft. Sie steht vor find_pane,
# damit sie auch den Weg deckt, der einen bestehenden Pane wiederverwendet: ein
# erschoepftes Konto verschluckt eine Nachricht in einen lebenden Pane genauso.
#
# ZWEI GRENZEN, die `wb-kontingent` selbst einhaelt und die hier sichtbar bleiben
# muessen: nur ein NACHWEIS sperrt (alles Unbekannte startet weiter), und
# gelesen wird eine Zustandsdatei, keine frische Messung -- aufgefrischt wird
# nur, was aelter als eine Stunde ist. Faellt das Werkzeug ganz aus (nicht
# installiert, kaputt, kein python3), startet der Worker wie vorher: eine
# Vorsichtspruefung, die selbst zum Ausfall wird, waere schlimmer als keine.
if [ -z "${WB_KONTINGENT_SKIP:-}" ] && [ -x "$HOME/.local/bin/wb-kontingent" ]; then
  KMODELL="$MODEL"; [ "$ENGINE" = claude ] && KMODELL="$CMODEL"
  if ! "$HOME/.local/bin/wb-kontingent" pruefen "$KIND" "$KMODELL"; then
    echo "FEHLER: Worker '$NAME' NICHT gestartet — die Begruendung steht in der Zeile darueber." >&2
    echo "  Stand ansehen: wb-kontingent zeigen $KIND" >&2
    exit 1
  fi
fi

info=$(find_pane); pane=${info%% *}; dead=${info##* }

# Transcript recording for CLAUDE workers (SPEC-V2 B), same mechanism wb-code uses for
# the orchestrator's own conversation: not a shared function (wb-code carries this
# session's crash-recovery logic and stays untouched per instruction), but the same
# formulation and the same precautions, deliberately.
transcript_dir() {   # Claude Code's project dir for a working directory
  printf '%s/.claude/projects/%s' "$HOME" "$(printf '%s' "$1" | tr -c 'a-zA-Z0-9' '-')"
}

# Snapshotted BEFORE any spawn/respawn decision below, so it is in place no matter
# which branch actually starts a new claude process. Only meaningful for the claude
# engine — pi never writes here.
CS_BEFORE=""

# Aufraeumen bei jedem fruehen Abbruch (2026-08-16, bugjagd shell/niedrig, "kein
# trap"): EIN gemeinsamer Handler fuer CS_BEFORE hier UND MAXW_LOCK weiter unten --
# reproduziert am simulierten TUI-Timeout-Abbruch (Zeile "Agent-TUI ... nicht
# bereit"): die mktemp-Datei blieb bisher liegen, weil zwischen ihrer Entstehung
# und ihrer geplanten Uebergabe an record_worker_conversation() viele `exit 1`
# liegen (Ziel nicht bestimmbar, maxWorkers erreicht, Pane-Anlage schlaegt fehl,
# TUI wird nie bereit, ...). EIN gemeinsamer Handler statt je einem eigenen `trap
# ... EXIT`: bash kennt nur EINEN Handler je Signal, ein zweiter wuerde den ersten
# stillschweigend ersetzen. Beide Variablen werden bei erfolgreicher Uebergabe
# explizit auf "" gesetzt, danach tut dieser Handler nichts mehr -- entscheidend
# bei CS_BEFORE: sobald record_worker_conversation() die Datei an einen
# abgekoppelten Hintergrundprozess uebergeben hat, wuerde ein bedingungsloses
# `rm -f` hier dessen bis zu 40s laufende Poll-Schleife sofort mit einer
# fehlenden Datei abreissen lassen.
pi_worker_cleanup() {
  [ -n "${CS_BEFORE:-}" ] && rm -f "$CS_BEFORE"
  [ -n "${MAXW_LOCK:-}" ] && rmdir "$MAXW_LOCK" 2>/dev/null
  return 0
}
trap pi_worker_cleanup EXIT

if [ -n "$CTRACK" ]; then
  CS_BEFORE="$(mktemp "${TMPDIR:-/tmp}/pi-worker-transcripts.XXXXXX")"
  ls "$(transcript_dir "$WORKDIR")" 2>/dev/null | grep '\.jsonl$' | sort > "$CS_BEFORE" || true
fi

# Backgrounded: Claude needs a moment to write the file, the caller must not wait.
#
# Matched by CONTENT, not by counting candidates (Reviewer-Befund 2, round 5 — the user's
# call over the reviewer's proposed pane_pid check: `lsof` on the transcript does not
# help, Claude does not hold the file open, measured while building wb-code's identical
# mechanism). Two claude workers spawned into the SAME WORKDIR seconds apart used to be
# misattributed: the round-4 "exactly one new file" rule only caught two transcripts
# appearing within the SAME poll second, not "worker B's first poll sees exactly worker
# A's brand-new file because A's message hasn't landed yet" -- the wrong id got recorded,
# worse than no id, since it silently pointed the BLIND message at a stranger's chat.
# Every spawn's first message embeds a marker no other spawn could produce: the exact
# path of ITS OWN result file (already unique — timestamped, namespaced by worker name —
# and already sent to every worker for its own protocol, not added for this). The
# watcher greps every NEW candidate's raw content for that marker; only a transcript that
# actually contains it gets recorded. None of the current candidates contain it yet
# (message not delivered to the transcript on disk yet) -> keep polling, not give up —
# the deadline is the only thing that gives up, and it records nothing.
record_worker_conversation() {
  local tdir before marker log
  tdir="$(transcript_dir "$WORKDIR")"
  before="$1"
  marker="$2"
  log="$HOME/.local/state/wb-code.log"   # same log wb-code's own watcher writes to
  mkdir -p "$(dirname "$log")"
  nohup bash -c '
    tdir="$1"; before="$2"; name="$3"; engine="$4"; model="$5"; dir="$6"; sess="$7"; marker="$8"
    stamp() { date "+%F %T"; }
    for i in $(seq 1 40); do
      sleep 1
      new="$(ls "$tdir" 2>/dev/null | grep "\.jsonl$" | sort | comm -13 "$before" -)"
      [ -z "$new" ] && continue
      found=""
      while IFS= read -r fname; do
        [ -n "$fname" ] || continue
        if grep -qF -- "$marker" "$tdir/$fname" 2>/dev/null; then
          found="$fname"
          break
        fi
      done <<EOFCANDIDATES
$new
EOFCANDIDATES
      [ -z "$found" ] && continue
      id="${found%.jsonl}"
      "$HOME/.local/bin/wb-state" add-worker "$name" "$engine" "$model" "$dir" "$sess" --claude-session "$id"
      echo "$(stamp) pi-worker: Unterhaltung $id gemerkt (Worker $name, per Marker positiv zugeordnet)."
      break
    done
    rm -f "$before"
  ' _ "$tdir" "$before" "$NAME" "$KIND" "$WBMODEL" "$WORKDIR" "$WBSESS" "$marker" >>"$log" 2>&1 &
}

# Symlink-Falle (2026-08-16): latest.md zeigte bisher SOFORT auf $RES -- die
# Datei, die der Worker erst am ENDE schreibt. Bis dahin ist der Symlink ein
# haengender Verweis: `cat`/`test -s latest.md` liefern nichts, ununterscheidbar
# von "nie gespawnt" (repro: frischer Symlink auf eine noch nicht existierende
# Datei -- `test -s` FALSE, `cat` "No such file or directory", genau wie bei
# einem komplett fehlenden latest.md). Eine zweite Orchestrator-Session hat
# deshalb zwei laengst fertige Ergebnisse fuer "nie gespawnt" gehalten.
#
# Jetzt zeigt latest.md waehrend der Laufzeit auf eine ECHTE, lesbare
# Platzhalterdatei (Name/Modell/Startzeit/Zielpfad drinnen); diese Funktion
# biegt ihn um, SOBALD $RES wirklich etwas enthaelt. $RES selbst wird davon nie
# beruehrt -- die dokumentierte Deadline-Warteschleife `until [ -s "$RES" ];
# do sleep 5; done` (siehe die Zeile, die sie am Ende dieses Skripts ausgibt)
# haengt ausschliesslich an dieser einen Datei und aendert sich nicht.
#
# Abgekoppelt, mit einer GROSSZUEGIGEN, aber ENDLICHEN Frist (6 h im 15-s-Takt):
# ein Worker darf lange laufen, aber ein fuer immer laufender Beobachter waere
# selbst ein Prozess-Hygiene-Fehler. Gibt der Watcher auf, bleibt latest.md
# schlicht beim Platzhalter stehen -- `wb-result` und die Deadline-Schleife
# funktionieren trotzdem weiter (siehe wb-result, das den Platzhalter am Namen
# erkennt und ihn nicht als "fertig" meldet).
finalize_latest_when_done() {
  local resdir res log
  resdir="$1"; res="$2"
  log="$HOME/.local/state/wb-code.log"
  mkdir -p "$(dirname "$log")"
  nohup bash -c '
    resdir="$1"; res="$2"
    stamp() { date "+%F %T"; }
    for i in $(seq 1 1440); do
      sleep 15
      # Der Beobachter stirbt mit seinem Ziel (2026-08-20, Messung des Workers
      # "speicher": 632 von 635 abgeraeumten Waisenprozessen waren solche
      # Schleifen, der aelteste lief 5 Stunden 48 Minuten, zusammen 878 MiB).
      # Verschwindet das Ergebnisverzeichnis -- ein Testlauf raeumt sein
      # Wegwerf-HOME ab, ein Worker wird geloescht --, kann hier nie mehr etwas
      # entstehen, worauf zu warten waere. Die Pruefung steht VOR der auf $res,
      # damit ein geloeschtes Verzeichnis nicht noch sechs Stunden lang alle 15
      # Sekunden abgefragt wird.
      [ -d "$resdir" ] || exit 0
      if [ -s "$res" ]; then
        ln -sf "$res" "$resdir/latest.md"
        # Nicht nur den Symlink umbiegen, auch den Platzhalter SELBST entfernen
        # (2026-08-20, Nachtrag zum Zustellungs-Auftrag: testschnell fand
        # .laufend.md noch liegen, obwohl das Ergebnis laengst fertig war -- ein
        # fertiger Worker sah damit weiterhin wie ein laufender aus, fuer jeden,
        # der die blosse Anwesenheit der Datei statt dem Ziel von latest.md prueft).
        # Sein einziger Zweck war "noch kein Ergebnis"; sobald $res steht, ist
        # dieser Zweck erfuellt und die Datei ueberfluessig.
        rm -f "$resdir/.laufend.md"
        echo "$(stamp) pi-worker: latest.md auf das Ergebnis umgebogen ($res), Platzhalter entfernt."
        exit 0
      fi
    done
    echo "$(stamp) pi-worker: Platzhalter-Beobachter fuer $res nach 6h aufgegeben -- latest.md bleibt der Platzhalter."
  ' _ "$resdir" "$res" >>"$log" 2>&1 &
}

# DIE WORKBENCHES, IN DIE VON AUSSEN GESPAWNT WERDEN DARF.
#
# Seit dem 12.08. gibt es eine zweite Sorte `wb-*`-Session: die WERKSTATT einer
# Chat-Sitzung der Workbench-Oberflaeche (app/src/main/chatwerkstatt.ts). Sie
# traegt das Praefix, weil `find_pane` oben und `wb-close` darauf filtern -- und
# genau dadurch wirkte sie auf die Ziel-Suche unten zurueck:
#
#   Stufe 4 verlangt GENAU EINE `wb-*`-Session. Sobald eine Chat-Sitzung offen
#   war, waren es zwei, und ein `claude-worker` aus einem gewoehnlichen Terminal
#   endete mit „Ziel-Workbench nicht eindeutig bestimmbar".
#   Stufe 3 trifft schaerfer: hatte der Mensch gerade zu einem Chat-Worker
#   gewechselt, war die WERKSTATT die angehaengte Session -- und ein danach von
#   aussen gestarteter Worker landete in ihr statt in der Haupt-Workbench.
#
# Eine Werkstatt ist deshalb NUR ueber `WB_SESSION` erreichbar (Stufe 0), also
# genau ueber den Weg, den die Chat-Sitzung selbst benutzt. Ihr eigener Pane
# (Stufe 1) und die Ahnenreihe (Stufe 2) bleiben unberuehrt: wer wirklich DORT
# sitzt, meint auch sie.
#
# ERKANNT WIRD SIE AN DER SESSION-OPTION `@wb_chat`, nicht am Namen. Der Name
# faengt zwar mit `wb-chat-` an, aber `wb-code` baut fuer einen Ordner namens
# `chat-foo` denselben Anfang -- eine echte Terminal-Sitzung waere damit
# unsichtbar geworden. Die Option setzt nur, wer die Werkstatt anlegt.
wb_kandidaten() {   # <nur angehaengte: 1|0>
  # Trennzeichen '|' statt Tab (gemessen 2026-08-18): tmux ersetzt einen
  # literalen Tab im -F-Format durch '_', sobald keine UTF-8-Locale gesetzt
  # ist (LANG/LC_ALL leer -- so laeuft z.B. der woechentliche launchd-Job).
  # Damit verschmelzen alle drei Felder zu einem, und die Suche findet nie
  # ein Ziel. '|' ist ASCII-druckbar und bleibt unter jeder Locale erhalten;
  # kein Sitzungsname und kein @wb_chat-Wert enthaelt es.
  tmux list-sessions -F '#{session_attached}|#{session_name}|#{@wb_chat}' 2>/dev/null \
    | awk -F'|' -v nur="$1" '$2 ~ /^wb-/ && $3 != "1" && (nur == 0 || $1 >= 1) { print $2 }'
}

# Die uebergangenen Werkstaetten -- nur fuer die Fehlermeldung.
chat_werkstaetten() {
  tmux list-sessions -F '#{session_name}|#{@wb_chat}' 2>/dev/null \
    | awk -F'|' '$2 == "1" { print $1 }'
}

find_caller_session() {
  # walk our process ancestry: the caller (orchestrator) lives inside a tmux
  # pane whose pane_pid is one of our ancestors — that pane's session wins.
  local map pid ppid
  map=$(tmux list-panes -a -F '#{pane_pid} #{session_name}' 2>/dev/null)
  pid=$$
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    echo "$map" | awk -v p="$pid" '$1==p{print $2; exit}' | grep '^wb-' && return 0
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || return 1
    [ -z "$ppid" ] && return 1
    pid=$ppid
  done
  return 1
}

# Die Rolle setzt seit 2026-08-07 `wb-rolle`: es schreibt die Pane-Option UND den
# Registereintrag, den die Guards als zweite, unabhaengige Quelle lesen. Der
# Unterschied zum Angriff ist gemessen, nicht behauptet -- hier wird ein FREMDER,
# gerade erst angelegter Pane markiert, fuer den es noch keinen Eintrag gibt; wer
# seinen EIGENEN Pane hochstufen will, wird von wb-rolle abgelehnt.
# Fehlt das Werkzeug (Maschine noch nicht abgeglichen), bleibt es beim alten Weg:
# ein Spawn darf daran nicht scheitern, und die Pane-Option allein ist genau der
# Stand von vorher, nie ein schwaecherer.
markiere_rolle() {   # <pane> <rolle>
  if [ -x "$HOME/.local/bin/wb-rolle" ]; then
    "$HOME/.local/bin/wb-rolle" setzen "$1" "$2" \
      || echo "pi-worker: wb-rolle konnte $1 nicht als $2 registrieren — Rolle steht nur in der Pane-Option." >&2
  else
    tmux set -p -t "$1" @wb_role "$2"
  fi
}

if [ -z "$pane" ] && ist_mlx_lokal "${PIPROVIDER:-}"; then
  MLXN=$(mlx_worker_anzahl)
  if [ "${MLXN:-0}" -ge "$MLX_NEBENLAEUFIGKEIT_SUESSPUNKT" ]; then
    echo "WARNUNG: bereits $MLXN MLX-Worker aktiv (Suesspunkt decode-concurrency $MLX_NEBENLAEUFIGKEIT_SUESSPUNKT) — dieser hier wartet hinter den anderen, statt schneller zu werden." >&2
    echo "  Vorschlag: mit einem bestehenden lokalen Worker weiterarbeiten, auf ein Ollama-Modell ausweichen (eigener Server, keine gemeinsame Warteschlange), oder abwarten, bis einer schliesst." >&2
  fi
fi

if [ -z "$pane" ]; then
  # spawn a fresh permanent chat pane in the RIGHT workbench:
  # 0) $WB_SESSION if set   1) our own pane if inside tmux
  # 2) the calling orchestrator's session
  # 3) the attached wb-* session    4) the only wb-* session (else error)
  # Stufen 3 und 4 uebergehen die Werkstaetten der Chat-Sitzungen; siehe
  # `wb_kandidaten` oben.
  # WB_SESSION is the explicit form for callers that have no tmux context at all
  # (an ssh spawn has no TMUX_PANE, and a machine with several wb-* sessions cannot
  # be guessed). '=' anchors it, since wb-foo-1a2b3c is a prefix of wb-foo-1a2b3c-9f2a1c.
  TARGET=""
  [ -n "${WB_SESSION:-}" ] && TARGET="=$WB_SESSION"
  [ -z "$TARGET" ] && TARGET="${TMUX_PANE:-}"
  [ -z "$TARGET" ] && TARGET=$(find_caller_session || true)
  [ -z "$TARGET" ] && TARGET=$(wb_kandidaten 1 | head -1)
  if [ -z "$TARGET" ]; then
    n=$(wb_kandidaten 0 | grep -c . || true)
    [ "$n" = "1" ] && TARGET=$(wb_kandidaten 0)
  fi
  if [ -z "$TARGET" ]; then
    echo "FEHLER: Ziel-Workbench nicht eindeutig bestimmbar (keine/mehrere wb-* Sessions)."
    # Sagen, WAS uebergangen wurde. Ohne diese Zeile sucht jemand nach einer
    # zweiten Workbench, die es gar nicht gibt -- eine Chat-Werkstatt sieht in
    # `tmux ls` aus wie eine.
    wcount=$(chat_werkstaetten | grep -c . || true)
    [ "${wcount:-0}" -gt 0 ] && \
      echo "       ($wcount Chat-Werkstatt/-Werkstaetten uebergangen: $(chat_werkstaetten | tr '\n' ' ')— sie sind nur ueber WB_SESSION erreichbar.)" >&2
    exit 1
  fi
  # `split-window -t` needs a PANE target, and a session name is not one: with '='
  # it fails outright ("can't find pane: =wb-foo"), and `display -p -t "=<session>"`
  # silently returns EMPTY (both measured on peer, tmux 3.5a, 2026-07-25). That hit
  # the WB_SESSION path in "split" layout — the split failed, $pane stayed empty and
  # the `tmux set -p -t ""` calls below then relabelled a FOREIGN pane (a second
  # session's ORCHESTRATOR) as this worker. `list-panes -t` does resolve a session
  # target, so normalise to a real pane id once, here, for both layouts.
  case "$TARGET" in
    %*) ;;
    *)  resolved=$(tmux list-panes -t "$TARGET" -F '#{pane_id} #{pane_active}' 2>/dev/null | awk '$2==1{print $1; exit}')
        [ -n "$resolved" ] || { echo "FEHLER: Ziel '$TARGET' hat keinen Pane — kein Spawn." >&2; exit 1; }
        TARGET="$resolved" ;;
  esac
  # maxWorkers (SPEC-V2 A): this branch is reached ONLY for a genuine new spawn — a
  # reused pane returns via `elif [ "$dead" = "1" ]` / the plain `else` below and
  # never gets here, so reuse never counts against the cap. Counts `@wb_role=worker`
  # panes in the resolved TARGET session; the cap fails loudly and BEFORE anything
  # is created, never a silent no-op.
  SESS_T=$(tmux display -p -t "$TARGET" '#{session_name}' 2>/dev/null || true)
  # Count-then-create is a TOCTOU race without a lock (2026-08-16, bugjagd
  # shell/mittel, pi-worker:673-700): two spawns that both read WCOUNT before
  # either tags a new pane both see the same stale count and both pass.
  # Reproduced: cap=8, 3 workers already running, 10 concurrent spawns each
  # read '3/8' and all proceed — 11 tagged panes on the far side, cap blown by
  # 3. mkdir is the one lock primitive shell and (elsewhere) Node can both
  # take without a dependency (same reasoning as wb-grid's/wb-state's mkdir
  # locks); self-heals after 10s so a killed spawn cannot wedge every future
  # one. Scoped per SESS_T so spawns into different sessions never wait on
  # each other. Held from the count through the new pane's @wb_role tag below
  # -- released right after tagging, or by the EXIT trap on any early exit
  # (maxWorkers refusal, failed split/new-window).
  MAXW_LOCK=""
  if [ -n "$SESS_T" ]; then
    MAXW_LOCKDIR="$HOME/.local/state/wb-worker-maxw"
    mkdir -p "$MAXW_LOCKDIR" 2>/dev/null || true
    MAXW_LOCK="$MAXW_LOCKDIR/$(printf '%s' "$SESS_T" | tr -c 'a-zA-Z0-9' '-').lock"
    MAXW_WAITED=0
    while ! mkdir "$MAXW_LOCK" 2>/dev/null; do
      # Zwei getrennte Aufrufe statt eines '||': GNU 'stat -f' (Linux) ist NICHT das BSD
      # 'stat -f' (macOS) -- es bedeutet "Dateisystem-Status", nicht "eigenes Format", und
      # %m ist dort kein gueltiges Feld. Es scheitert zwar (Exit 1), schreibt dabei aber
      # trotzdem einen mehrzeiligen Bericht ("  File: ...") nach STDOUT -- der durch das
      # '||' NICHT verschluckt wird, weil `2>/dev/null` nur STDERR unterdrueckt. Verkettet in
      # einer einzigen $(( )), wertete die Arithmetik das Wort 'File' als Variablennamen und
      # brach unter 'set -u' mit 'File: unbound variable' ab (Befund 2026-08-21, nur unter
      # Last reproduzierbar: der Zweig laeuft ausschliesslich bei Sperr-Konkurrenz). Deshalb
      # hier: jeder stat-Aufruf in eine EIGENE Variable, erst dann auf reine Ziffern geprueft.
      MAXW_MTIME="$(stat -f %m "$MAXW_LOCK" 2>/dev/null)"
      case "$MAXW_MTIME" in ''|*[!0-9]*) MAXW_MTIME="$(stat -c %Y "$MAXW_LOCK" 2>/dev/null)" ;; esac
      case "$MAXW_MTIME" in ''|*[!0-9]*) MAXW_MTIME=0 ;; esac
      MAXW_AGE=$(( $(date +%s) - MAXW_MTIME ))
      if [ "$MAXW_AGE" -ge 10 ]; then rm -rf "$MAXW_LOCK"; continue; fi
      MAXW_WAITED=$((MAXW_WAITED + 1))
      if [ "$MAXW_WAITED" -ge 100 ]; then
        echo "FEHLER: maxWorkers-Sperre fuer Session $SESS_T haengt seit >10s — kein Spawn." >&2
        exit 1
      fi
      sleep 0.1
    done
    # Kein eigener trap hier mehr (2026-08-16): pi_worker_cleanup() ist schon seit
    # der CS_BEFORE-Einrichtung oben aktiv und deckt MAXW_LOCK mit ab -- ein zweiter
    # `trap ... EXIT` wuerde ihn nur ersetzen, nicht ergaenzen.
    MAXW=$($HOME/.local/bin/wb-state settings get maxWorkers 2>/dev/null || true)
    # Der Sanitizer faengt jetzt auch absurd lange Zahlen ab: '99999999999999999999'
    # besteht nur aus Ziffern, sprengt aber den Zahlenbereich der Shell, und '[ … -ge
    # 1 ]' warf die rohe Meldung '[: … integer expression expected' in das Terminal
    # des Orchestrators (Stress-Befund B16). Neun Stellen sind mehr als genug.
    case "$MAXW" in
      ''|*[!0-9]*) MAXW=8 ;;
      ?????????*)  echo "WARNUNG: maxWorkers='$MAXW' ist keine benutzbare Zahl — es gilt 8." >&2
                   MAXW=8 ;;
      *) [ "$MAXW" -ge 1 ] || MAXW=8 ;;
    esac
    # DEAD panes excluded (Reviewer-Befund 4): remain-on-exit keeps a crashed/exited
    # worker's pane standing with @wb_role=worker still set, so counting pane_dead=1
    # panes toward the cap blocks a fresh spawn against slots nothing is using.
    WCOUNT=$(tmux list-panes -s -t "=$SESS_T" -F '#{@wb_role}:#{pane_dead}' 2>/dev/null \
      | awk -F: '$1=="worker" && $2=="0"' | wc -l | tr -d ' ')
    if [ "$WCOUNT" -ge "$MAXW" ]; then
      echo "FEHLER: maxWorkers erreicht ($WCOUNT/$MAXW, Setting 'maxWorkers') in Session $SESS_T — kein Spawn. Vorhandenen Worker schliessen (wb-close) oder maxWorkers in den Settings erhoehen." >&2
      exit 1
    fi
  fi
  # Worker layout (SPEC-V2 section C): "split" = V1, a pane in the orchestrator's
  # window; "window" = all workers together in the session's window named
  # `workers`, which is created on the first worker.
  LAYOUT=$($HOME/.local/bin/wb-state settings get workerLayout 2>/dev/null || true)
  [ -n "$LAYOUT" ] || LAYOUT=split
  if [ "$LAYOUT" = window ]; then
    # Target session by NAME. With WB_SESSION we already have it — asking tmux would
    # even fail, because `display -p -t "=<session>"` is a PANE target and does not
    # resolve a bare session ("can't find pane"). An empty name here used to fall back
    # to tmux's "current session" and dropped the worker into a FOREIGN workbench, so
    # this now fails loudly instead of guessing.
    if [ -n "${WB_SESSION:-}" ]; then
      WBSESS_T="$WB_SESSION"
    else
      WBSESS_T=$(tmux display -p -t "$TARGET" '#{session_name}' 2>/dev/null || true)
    fi
    [ -n "$WBSESS_T" ] && : || { echo "FEHLER: Zielsession fuer das 'workers'-Fenster nicht bestimmbar (TARGET='$TARGET'). Kein Spawn." >&2; exit 1; }
    wwin=$(tmux list-windows -t "=$WBSESS_T" -F '#{window_id} #{window_name}' 2>/dev/null | awk '$2=="workers"{print $1; exit}')
    if [ -n "$wwin" ]; then
      wtgt=$(tmux list-panes -t "$wwin" -F '#{pane_id} #{pane_active}' 2>/dev/null | awk '$2==1{print $1; exit}')
      # Verschwindet das 'workers'-Fenster zwischen den beiden Abfragen, bleibt $wtgt
      # leer — und `split-window -t ""` schlaegt NICHT fehl, sondern trifft das aktive
      # Pane der aktuellen Session, also womoeglich eine fremde Workbench (gemessen
      # 2026-08-15 auf eigenem Socket: rc=0, ein Pane-Id wird zurueckgegeben, der Pane
      # landet in einer anderen Session). Derselbe Fehlertyp wie beim leeren $TARGET
      # weiter oben: lieber laut abbrechen als still am falschen Ort spawnen.
      [ -n "$wtgt" ] || { echo "FEHLER: 'workers'-Fenster von '$WBSESS_T' hat kein aktives Pane mehr (Fenster verschwunden?). Kein Spawn." >&2; exit 1; }
      # Mindesthoehe VOR dem Split (Betriebsbefund 19.08.2026 abends): ein auf
      # eine Zeile gedruecktes 'workers'-Fenster (siehe wb-workers-window fuer
      # die gemessene Ursache) hat schlicht keinen Platz fuer einen weiteren
      # Pane -- 'split-window' scheitert dann mit "size or position no space
      # for a new pane", BEVOR wb-grid (Zeile ~1206, danach) je die Chance
      # bekommt, die Groesse zu reparieren: das laeuft erst NACH einem
      # erfolgreichen Split. Dieselbe Pruefung wie in wb-workers-window
      # (MIN_ZEILEN dort), hier noch einmal, weil pi-worker diesen Zweig
      # (schon bestehendes 'workers'-Fenster) selbst aufloest, ohne
      # wb-workers-window dafuer aufzurufen.
      whoehe="$(tmux display -p -t "$wwin" '#{window_height}' 2>/dev/null || true)"
      case "$whoehe" in
        ''|*[!0-9]*) ;;
        *)
          if [ "$whoehe" -lt "$PI_WORKER_MIN_ZEILEN" ]; then
            tmux set-option -w -t "$wwin" window-size manual 2>/dev/null || true
            tmux resize-window -t "$wwin" -y "$PI_WORKER_MIN_ZEILEN" 2>/dev/null || true
          fi
          ;;
      esac
      pane=$(tmux split-window -d -t "$wtgt" -P -F '#{pane_id}' "bash -lc $(printf %q "$CHAT")")
    else
      pane=$(tmux new-window -d -t "=$WBSESS_T:" -n workers -P -F '#{pane_id}' "bash -lc $(printf %q "$CHAT")")
      # global automatic-rename is on; the window must keep the contract name.
      tmux set-option -w -t "$pane" automatic-rename off 2>/dev/null
    fi
  else
    pane=$(tmux split-window -d -t "$TARGET" -P -F '#{pane_id}' "bash -lc $(printf %q "$CHAT")")
  fi
  # An empty $pane means the split/new-window above failed. `tmux set -p -t ""`
  # does NOT error — it silently targets tmux's current pane, which is how a failed
  # spawn used to overwrite a foreign orchestrator's @wb_role/@wb_worker. Never let
  # an unknown pane be tagged; fail loudly instead.
  [ -n "$pane" ] || { echo "FEHLER: Worker-Pane konnte nicht angelegt werden (Ziel '$TARGET') — nichts markiert, kein Spawn." >&2; exit 1; }
  markiere_rolle "$pane" worker
  tmux set -p -t "$pane" @wb_worker "$NAME"
  # Markiert fuer die Nebenlaeufigkeits-Warnung oben ("mlx_worker_anzahl") --
  # nur bei einem ECHTEN Neuspawn, damit ein wiederverwendeter Pane nicht
  # doppelt zaehlt.
  ist_mlx_lokal "${PIPROVIDER:-}" && tmux set -p -t "$pane" @wb_lokal_provider mlx-lokal
  tmux set -p -t "$pane" remain-on-exit on
  tmux select-pane -t "$pane" -T "$TITLE"
  $HOME/.local/bin/wb-grid "$pane"
  # The new pane is tagged @wb_role=worker now, so the next spawn's count
  # already includes it -- release the maxWorkers lock here, not earlier. Clearing
  # the variable (not disarming the trap) leaves pi_worker_cleanup() in place for
  # CS_BEFORE and any later abort path -- see its definition above.
  if [ -n "$MAXW_LOCK" ]; then rmdir "$MAXW_LOCK" 2>/dev/null; MAXW_LOCK=""; fi
  SPAWNED=1
elif [ "$dead" = "1" ]; then
  tmux respawn-pane -k -t "$pane" "bash -lc $(printf %q "$CHAT")"
  # Nach einem respawn traegt der Pane eine neue pane_pid; der alte Registereintrag
  # passt nicht mehr dazu und wird von den Guards verworfen (siehe hooks/lib/rollen.py).
  # Deshalb hier neu eintragen, damit die zweite Rollenquelle nicht stillschweigend
  # ausfaellt und nur noch die Pane-Option traegt.
  markiere_rolle "$pane" worker
  SPAWNED=1
else
  SPAWNED=0
fi

# Die eigene Sequenz automatisch zurueckgeben, sobald der Pane verschwindet
# (Korrektur, 19.08.2026) -- unabhaengig davon, WIE er geschlossen wurde
# (wb-close, von Hand, Absturz mit spaeterem `wb-close`). Nur wenn oben
# wirklich gebucht wurde ($BELEGUNG_KENNUNG gesetzt -- das ist NUR beim echten
# Neuspawn-Zweig der Fall, ein wiederverwendeter Pane bucht nichts Neues und
# hat hier nichts zurueckzugeben). Abgekoppelt, endliche Frist (6 h im
# 15-s-Takt, dasselbe Muster wie finalize_latest_when_done oben).
if [ -n "${BELEGUNG_KENNUNG:-}" ]; then
  nohup bash -c '
    pane="$1"; kennung="$2"
    for i in $(seq 1 1440); do
      sleep 15
      # "tmux display -p -t <toter-pane>" meldet auf dieser Maschine RC=0 mit
      # leerer Ausgabe statt eines Fehlers, sobald der Pane weg ist (gemessen,
      # 2026-08-20 -- dieselbe Quirke, die wb-belegungs eigenes
      # panes_des_servers() deshalb NICHT so prueft). Diese Schleife lief mit
      # der zerbrechlicheren Pruefung deshalb NIE aus, auch lange nachdem
      # wb-close den Pane laengst gekillt hatte -- die Buchung blieb bis zur
      # Frist (240 min) im Buch stehen. Stattdessen dieselbe robuste Quelle
      # wie wb-belegung selbst: eine Momentaufnahme ALLER Panes, Mitglied-
      # schaft und pane_dead darin pruefen, nicht das Exit-Verhalten von
      # "display -t" auf eine moeglicherweise verschwundene Kennung.
      zeile="$(tmux list-panes -a -F "#{pane_id} #{pane_dead}" 2>/dev/null | grep "^$pane ")"
      { [ -z "$zeile" ] || [ "${zeile##* }" = "1" ]; } && break
    done
    # Erst der normale Weg (eigener Pane als Halter), dann --fremd als
    # Rueckfall -- derselbe zweistufige Nachweis wie in wb-mlx-servers
    # belegung_freigeben(), aus demselben Grund: der Pane, unter dem diese
    # Buchung eingetragen wurde (der AUFRUFER-Pane zum Zeitpunkt von "nimm",
    # siehe cmd_uebernehmen in wb-belegung), muss nicht derselbe sein wie der
    # hier ueberwachte Worker-Pane.
    "$HOME/.local/bin/wb-belegung" gib "$kennung" >/dev/null 2>&1 || \
      "$HOME/.local/bin/wb-belegung" gib "$kennung" --fremd >/dev/null 2>&1
  ' _ "$pane" "$BELEGUNG_KENNUNG" >>"$HOME/.local/state/wb-code.log" 2>&1 &
fi

# register the worker in the workbench state file (VSCode sidebar reads it).
# A failing wb-state must never kill the spawn, but it must not stay silent
# either — otherwise workers never show up in the sidebar and nobody notices.
# `claudeSessionId`/`machine` need no read-back before this call any more
# (Reviewer-Befund 3, round 5): add-worker itself now PRESERVES either field when its
# flag is omitted, falling back to whatever the existing entry already has. The
# read-back that used to live here was exactly the kind of duplicate-of-the-SPEC logic
# that drifts out of sync — removed, dead now that the real fix sits in wb-state.
WBSESS=$(base_session_name "$pane")
if [ "$ENGINE" = claude ]; then WBMODEL="$CMODEL:${EFFORT:-medium}"
elif [ "$ENGINE" = registry ]; then WBMODEL="$MODEL:${REFFORT:-medium}"
else WBMODEL="$MODEL"; fi
AWARGS=("$NAME" "$KIND" "$WBMODEL" "$WORKDIR" "$WBSESS")
[ -n "${KONTEXT_STUFE:-}" ] && AWARGS+=(--kontext "$KONTEXT_STUFE")
$HOME/.local/bin/wb-state add-worker "${AWARGS[@]}" \
  || echo "WARNUNG: wb-state add-worker fehlgeschlagen — '$NAME' fehlt in der Workbench-Sidebar." >&2

# No watcher trigger here any more (Reviewer-Befund 2, round 5): it needs the marker
# text below (this spawn's OWN result-file path), which is not known until $RES is
# computed further down. CS_BEFORE stays untouched for a genuine new spawn; a reuse
# never gets one (nothing new will ever appear to watch for), cleaned up right away.
if [ -z "$CTRACK" ] || [ "$SPAWNED" != "1" ]; then
  [ -n "$CS_BEFORE" ] && rm -f "$CS_BEFORE"
  CS_BEFORE=""
fi

# Sichtbarkeit auf JEDEM Weg pruefen: frischer Spawn, respawn eines toten Panes
# UND erneutes Prompten eines bestehenden Panes (SPAWNED=0). Vorher hing die
# Warnung nur am Neuspawn im 'window'-Layout.
visibility_guard "$pane"

# Kontext-Guard an den Worker-Lebenszyklus koppeln (Entscheidung des Nutzers 2026-08-03):
# beim Sessionstart laeuft absichtlich keiner (contextGuardAutostart bleibt false), aber ab
# dem ERSTEN Worker einer -- ein voller Worker scheitert nicht, er wird still schlechter.
# `--ensure` ist idempotent (es findet einen laufenden Guard dieser Session und startet dann
# keinen zweiten), deshalb steht der Aufruf hier auf JEDEM Weg: frischer Spawn, respawn eines
# toten Panes und erneutes Prompten eines bestehenden. Der so gestartete Guard beendet sich
# selbst, sobald der letzte Worker der Session weg ist. Nichts davon darf einen Spawn
# scheitern lassen -- Ausgabe nach stderr, Fehler werden geschluckt.
$HOME/.local/bin/context-guard --ensure "$pane" >&2 || true

# Sichtbarkeit ueber die Maschinengrenze (2026-08-13): ein Worker, der HIER entsteht,
# soll im Worker-Tab der ANDEREN Maschine auftauchen, ohne dass jemand etwas tippt.
# Der Aufruf steht bewusst an derselben Stelle wie `--ensure` — auf JEDEM Spawn-Weg,
# also auch fuer die Worker, die `orch-launch` auf peer startet und die nie durch
# `wb-ssh-worker` laufen (genau der Fall, der am 13.08. unsichtbar blieb). Er koppelt
# sich sofort ab und ist gedrosselt; ein Spawn darf daran nie haengenbleiben oder
# scheitern.
[ -x "$HOME/.local/bin/wb-remote-view" ] \
  && "$HOME/.local/bin/wb-remote-view" --announce >/dev/null 2>&1 || true

# A freshly spawned pane needs its TUI to be READY, not just started: pasting
# into a booting agent silently drops the task (seen twice). Wait until the
# rendered pane shows its input prompt ('❯'), context bar ('░') or status line
# ('●' — pi's bar in narrow panes), with a deadline. A reused, already-running
# pane needs no wait.
if [ "$SPAWNED" = "1" ]; then
  d=$(( $(date +%s) + 60 ))
  until tmux capture-pane -p -t "$pane" 2>/dev/null | grep -qE "$READY_RE"; do
    [ "$(date +%s)" -gt "$d" ] && { echo "FEHLER: Agent-TUI in Pane $pane nicht bereit (60s) — Task NICHT gesendet."; exit 1; }
    sleep 1
  done
  sleep 2
fi

if [ -z "$TASK" ]; then
  [ -n "$CS_BEFORE" ] && rm -f "$CS_BEFORE"   # no message will ever carry a marker
  KTXT=""; [ -n "${KONTEXT_STUFE:-}" ] && KTXT=", Kontext $KONTEXT_STUFE Token"
  echo "Chat-Agent '$NAME' ($MODEL$KTXT) bereit in Pane $pane — keine Task übergeben."
  exit 0
fi

TS="$(date +%Y%m%d-%H%M%S)"
# EINDEUTIG, auch zweimal in derselben Sekunde (2026-08-20, Stresstest der
# Zustellung, reproduziert mit angehaltener Uhr). Der Zeitstempel hat nur
# Sekundenaufloesung, und ZWEI Auftraege an denselben Worker innerhalb einer
# Sekunde sind kein Sonderfall: ein zweiter Auftrag in einen bestehenden Pane
# braucht ueber die Sitzungs-Inbox rund eine Sekunde, und in einem Lauf mit
# zwoelf Auftraegen hintereinander teilten sich gemessen je zwei denselben
# Zeitstempel.
#
# Was daran teuer ist, ist NICHT die Namensgleichheit, sondern der Beleg. $TS
# ist zugleich der MARKER, an dem die Inhaltspruefung unten die Ankunft
# nachweist ($MARKER_INHALT ist sein Dateiname). Traegt der zweite Auftrag
# denselben Marker wie der erste, findet die Pruefung den Marker des ERSTEN im
# Pane und meldet den zweiten als angekommen -- gemessen genau so: der zweite
# Auftrag wurde von der Sitzung verschluckt (im Pane nicht ein einziges Mal zu
# finden), pi-worker meldete trotzdem "zugestellt (Ankunft belegt: Pane)" und
# endete mit 0. Das ist der Fehlalarm in der gefaehrlichen Richtung. Dazu
# ueberschreibt der zweite Auftrag die Auftragsdatei des ersten, und beide
# zeigen auf dieselbe Ergebnisdatei.
#
# Der Ausweg ist ein Namenszusatz, kein feineres Zeitformat: das Format
# <zeitstempel>.md steht in Werkzeugen, Tests und Dokumentation, und
# aktivitaet.ts leitet die Begleitdatei daraus ab (.md -> .auftrag.txt). Der
# Zusatz haengt deshalb an $TS SELBST, damit Ergebnis-, Auftrags- und
# Fehlschlagdatei denselben Namen weitertragen. Sortiert wird nirgends nach
# dem Namen -- wb-ereignisse nimmt die mtime, alles andere latest.md.
TS_BASIS="$TS"
TS_LAUF=1
while [ -e "$RESDIR/$TS.md" ] || [ -e "$RESDIR/$TS.auftrag.txt" ] \
   || [ -e "$RESDIR/$TS.zustellung-fehlgeschlagen.md" ]; do
  TS_LAUF=$(( TS_LAUF + 1 ))
  TS="$TS_BASIS-$TS_LAUF"
done
RES="$RESDIR/$TS.md"
# latest.md zeigt WAEHREND der Laufzeit auf einen echten, lesbaren Platzhalter,
# nicht direkt auf $RES (siehe finalize_latest_when_done oben fuer die volle
# Begruendung) -- der Name ".laufend.md" ist absichtlich NICHT das
# Datumsmuster echter Ergebnisdateien, das ist das Unterscheidungsmerkmal, das
# wb-result benutzt.
PLATZHALTER="$RESDIR/.laufend.md"
{
  printf '# Worker "%s" laeuft\n\n' "$NAME"
  printf -- '- Modell: %s (%s)\n' "$MODEL" "$KIND"
  [ -n "${KONTEXT_STUFE:-}" ] && printf -- '- Kontext: %s Token\n' "$KONTEXT_STUFE"
  printf -- '- Gestartet: %s\n' "$(date '+%F %T')"
  printf -- '- Ziel-Ergebnisdatei (sobald fertig): %s\n\n' "$RES"
  printf 'Noch kein Ergebnis -- diese Datei ist ein Platzhalter. `wb-result %s` meldet\n' "$NAME"
  printf '"noch nicht fertig", solange dieser Platzhalter steht.\n'
} > "$PLATZHALTER" 2>/dev/null || true
ln -sf "$PLATZHALTER" "$RESDIR/latest.md"
finalize_latest_when_done "$RESDIR" "$RES"

# Ein FEHLGESCHLAGENER Zustellversuch darf keinen Platzhalter zuruecklassen, der
# spaeter wie ein arbeitender Worker aussieht (2026-08-20, Auftrag: die Zustellung
# selbst muss sich melden, wenn sie es nicht weiss). Bis hierher zeigen
# $PLATZHALTER/latest.md "laeuft" -- das widerruft niemand, wenn der Auftrag nie
# ankam: der Sechs-Stunden-Beobachter aus finalize_latest_when_done() wartet auf
# $RES, das dann NIE geschrieben wird, und eine Deadline-Warteschleife beim
# Aufrufer ("until [ -s $RES ]; do sleep 5; done", siehe die Zeile am Ende dieses
# Skripts) haengt bis zu IHRER eigenen Frist an einem Auftrag, der nie gestartet
# ist. Der Ausweg braucht kein neues Geruest: eine ECHTE, sofort sichtbare Datei
# statt eines Platzhalters, und latest.md sofort darauf umgebogen (nicht erst
# nach den bis zu 15s des Beobachters).
#
# WOHIN diese Datei geht, ist am 2026-08-20 KORRIGIERT worden. Sie lag zuerst
# unter $RES -- also genau dort, wo spaeter das ECHTE Ergebnis erwartet wird.
# Gemessen am selben Tag beim Worker 'dsharness': die Zustellpruefung schlug
# Alarm, obwohl der Auftrag angekommen war; pi-worker schrieb daraufhin
# "Zustellung fehlgeschlagen" nach $RES, und der Ereignisstrom meldete den gerade
# erst anfangenden Worker als FERTIG. Danach ist "Zustellung gescheitert" von
# "Arbeit fertig" nicht mehr zu unterscheiden -- und beim naechsten Fehlalarm
# waere es wieder so. Deshalb steht der Fehlschlag jetzt in einer eigenen Datei
# mit sprechendem Namen; $RES bleibt dem Ergebnis vorbehalten, und wenn der
# Worker doch arbeitet (Fehlalarm), biegt finalize_latest_when_done() latest.md
# von selbst auf das echte Ergebnis um, sobald es da ist. Der Ereignisstrom
# uebergeht die Datei ausdruecklich (siehe ergebnis_von() in wb-ereignisse).
zustellung_fehlgeschlagen() {
  local grund="$1" fehldatei
  fehldatei="$RESDIR/$TS.zustellung-fehlgeschlagen.md"
  echo "FEHLER: $grund" >&2
  {
    printf '# Zustellung an "%s" fehlgeschlagen\n\n' "$NAME"
    printf -- '- Modell: %s (%s)\n' "$MODEL" "$KIND"
    printf -- '- Pane: %s\n' "${pane:-?}"
    printf -- '- Zeitpunkt: %s\n' "$(date '+%F %T')"
    printf -- '- Erwartete Ergebnisdatei: %s (bewusst NICHT diese Datei hier)\n\n' "$RES"
    printf 'WHAT: kein Auftrag wurde uebergeben — die Zustellung ist gescheitert, BEVOR ein Worker angefangen hat zu arbeiten.\n\n'
    printf 'HOW-verified: %s\n\n' "$grund"
    printf 'OPEN: Auftrag manuell pruefen und, falls noetig, erneut senden: tmux capture-pane -p -t %s\n' "${pane:-?}"
    printf '\nSollte der Worker doch arbeiten (Fehlalarm der Zustellpruefung), erscheint sein\n'
    printf 'echtes Ergebnis unter dem Pfad oben, und latest.md zeigt dann wieder dorthin.\n'
  } > "$fehldatei" 2>/dev/null
  ln -sf "$fehldatei" "$RESDIR/latest.md" 2>/dev/null
  # Wie im Erfolgspfad (finalize_latest_when_done): den Platzhalter SELBST
  # entfernen, nicht nur den Symlink umbiegen -- sonst sieht ein gescheiterter
  # Zustellversuch fuer jeden, der die blosse Anwesenheit von .laufend.md statt
  # latest.md's Ziel prueft, weiterhin wie ein laufender Worker aus.
  rm -f "$PLATZHALTER" 2>/dev/null
  exit 1
}

# UNENTSCHIEDEN IST EIN EIGENES URTEIL, UND ES SIEHT NICHT WIE EIN FEHLSCHLAG AUS
# (2026-08-20, zweite Runde, nach zwei Fehlalarmen im Betrieb).
#
# Es gibt drei Antworten auf "ist der Auftrag angekommen", nicht zwei: ja, nein,
# und "das laesst sich hier nicht entscheiden". Die dritte fehlte, und ihr
# Fehlen hat den teureren Fehlalarm erzeugt: Zwei von fuenf Workern bekamen eine
# Fehlschlagdatei, BEIDE haben trotzdem gearbeitet. Der Schaden war nicht die
# Datei, sondern der Zeiger: latest.md zeigte danach auf den Fehlschlag statt auf
# das kommende Ergebnis, und wer latest.md liest -- Wachen, die Oberflaeche, der
# Orchestrator -- sah stundenlang "gescheitert", waehrend der Worker arbeitete.
#
# Unentschieden heisst deshalb: Rueckgabewert 0, Platzhalter BLEIBT stehen,
# latest.md zeigt weiter auf ihn, KEINE Fehlschlagdatei -- und die Meldung sagt
# in Worten, was nicht entschieden werden konnte und wo man nachsieht. Ein
# spaeter eintreffendes echtes Ergebnis holt den Zeiger von selbst ein, dafuer
# laeuft der Beobachter aus finalize_latest_when_done() ohnehin schon.
# Dasselbe Urteil gab es fuer den busy-Fall bereits; hier bekommt es seinen
# eigenen Namen und gilt fuer jeden Grund, aus dem kein Beleg moeglich war.
zustellung_unentschieden() {
  local grund="$1"
  echo "Task an Chat-Agent '$NAME' ($MODEL, Pane $pane) in die Sitzungs-Inbox gelegt —"
  echo "  UNENTSCHIEDEN: $grund"
  echo "  Weder Erfolg noch Fehlschlag behauptet. Der Platzhalter bleibt stehen, damit ein"
  echo "  Ergebnis, das noch kommt, den Zeiger von selbst einholt ($RESDIR/latest.md)."
  echo "  Selbst nachsehen: tmux capture-pane -p -t $pane   (gesucht: '$MARKER_INHALT')"
}

# DER AUFTRAGSTEXT (2026-08-05, Schritt 9/V18). Das Auftragsbuch unten haelt
# nur Zeitpunkt, Ergebnisdatei, Pane, Harness und Modell fest -- der Text
# selbst geht in den Pane und ist danach vergessen. Ohne ihn laesst sich beim
# Pruefen eines Ergebnisses nicht mehr sehen, WOFUER es die Antwort ist. Rein
# additiv, neben der Ergebnisdatei, unter demselben Zeitstempel -- keine
# bestehende Spalte des Auftragsbuchs aendert sich dadurch.
printf '%s' "$TASK" > "$RESDIR/$TS.auftrag.txt" 2>/dev/null || true

# Datei-Zeiger statt Inline-Text ab einer Schwelle (2026-08-20, Auftrag: Zustellung
# muss zuverlaessig ankommen). Die Laenge allein erklaert die drei Haenger heute
# Nacht NICHT -- gemessen: auch ein kurzer Zeigertext blieb beim ersten Versuch
# stehen, C-u vor dem Tippen (siehe unten) war der eigentliche Fix. Trotzdem bleibt
# ein LANGER Inline-Text ein zweites, unabhaengiges Risiko: er kommt als ein
# einziger, oft ueber mehrere OS-Leseaufrufe verteilter Bracketed-Paste-Block an,
# und je mehr Bytes darin stecken, desto mehr Gelegenheit fuer eine TUI, eine
# Klammer des Paste-Modus mitten im Datenstrom zu verpassen. Die 1200-Zeichen-
# Schwelle liegt bewusst UNTER den ~2000 Zeichen des heute gemessenen Ausfalls
# (Worker 'nebenlauf') und deutlich UEBER dem ueblichen kurzen Auftragssatz (ein bis
# zwei Zeilen, Vorspann+Protokoll allein sind schon ~540 Zeichen) -- ein normaler
# kurzer Auftrag bleibt inline, ein laengerer Fliesstext wandert in genau die Datei,
# die ohnehin schon fuer jeden Auftrag mitgeschrieben wird ($RESDIR/$TS.auftrag.txt,
# siehe die Zeile darueber), keine zweite Kopie noetig. Der Zeigertext selbst bleibt
# WORTGLEICH ankommender Auftragsinhalt: die Datei traegt $TASK unveraendert, der
# Pane bekommt nur einen kurzen, festen Satz, der auf sie zeigt.
AUFTRAG_SCHWELLE=1200
TASK_FUER_MSG="$TASK"
if [ "${#TASK}" -gt "$AUFTRAG_SCHWELLE" ]; then
  TASK_FUER_MSG="Lies $RESDIR/$TS.auftrag.txt und arbeite ihn ab."
  echo "pi-worker: Auftragstext ist ${#TASK} Zeichen lang (> $AUFTRAG_SCHWELLE) -- in eine Datei geschrieben, im Pane steht nur ein kurzer Zeiger darauf ($RESDIR/$TS.auftrag.txt)." >&2
fi

# DAS AUFTRAGSBUCH (2026-08-05). Ein neuer Ergebnispfad entsteht je AUFTRAG, nicht
# je Spawn -- diese Zeilen laufen auch, wenn ein bestehender Pane wiederverwendet
# wird. Bisher blieb davon nur der Symlink uebrig, und der sagt nur, WELCHE Datei
# gemeint ist, nicht seit wann.
#
# Warum das noetig wurde: "Fertig" ist eine Eigenschaft des AUFTRAGS, nicht der
# Datei. Ohne einen Zeitpunkt, ab dem der laufende Auftrag gilt, ist von aussen
# nicht zu unterscheiden, ob eine gefuellte Ergebnisdatei diesen Auftrag abschliesst
# oder vom vorigen stehengeblieben ist -- am 05.08. hat genau diese Verwechslung
# dazu aufgefordert, einen arbeitenden Worker zu schliessen. Wer eine Aufgabe in
# einen Pane schickt, haelt deshalb hier fest, WELCHER Auftrag das ist.
#
# Format: eine Zeile je Auftrag, tabgetrennt, nur angehaengt, nie umgeschrieben --
# ts, Ergebnisdatei, Pane, Harness, Modell, und ob dieser Auftrag den Pane neu
# angelegt hat. Der LETZTE Eintrag ist der laufende Auftrag.
AUFTRAEGE="$RESDIR/auftraege.tsv"
if [ ! -s "$AUFTRAEGE" ]; then
  printf '# ts\tresult\tpane\tharness\tmodel\tspawned\n' >>"$AUFTRAEGE" 2>/dev/null || true
fi
printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$RES" "$pane" "$KIND" "$MODEL" "${SPAWNED:-0}" \
  >>"$AUFTRAEGE" 2>/dev/null || true

# Fertig-Kriterium merken (pi-worker --dod), rein additiv: ohne das Flag passiert
# hier nichts. Liegt neben latest.md, damit `wb-dod <name>` es ohne erneute Angabe
# findet.
[ -n "$DOD" ] && printf '%s\n' "$DOD" > "$RESDIR/.dod"

# Kontextstufe merken (wb-kontext, Auftrag B 2026-08-19), neben .dod -- damit
# nachvollziehbar bleibt, womit dieser Worker lief, auch ohne die Sidebar.
[ -n "${KONTEXT_STUFE:-}" ] && printf '%s\n' "$KONTEXT_STUFE" > "$RESDIR/.kontext"

MSG="${VORSPANN}$TASK_FUER_MSG

[Protokoll — immer befolgen] Schreibe dein vollständiges Endergebnis als Markdown in die Datei $RES (WHAT/HOW-verified/OPEN). Antworte danach im Chat, letzte Zeile exakt: DONE"

# $RES is embedded in $MSG above (unique per spawn: timestamped, namespaced by worker
# name) -- it doubles as the marker record_worker_conversation greps new transcripts
# for. Triggered here, not earlier, because this is the first point both the marker
# AND the spawn/reuse decision are both known.
#
# Dieselbe Eindeutigkeit traegt auch die Zustellpruefung weiter unten (2026-08-17,
# nach einem Auftrag, der als "Submission verifiziert" galt, im Pane aber nur eine
# Terminal-Escape-Folge stand): nur der DATEINAME, nicht der ganze Pfad, weil eine
# lange Zeile im Pane umbrechen oder gekuerzt werden kann -- der volle Pfad steht
# mitten in einem langen Satz und ist dafuer untauglich, der kurze, garantiert
# eindeutige Zeitstempel-Dateiname (19 Zeichen) uebersteht das.
MARKER_INHALT="$(basename "$RES")"
if [ -n "$CTRACK" ] && [ "$SPAWNED" = "1" ] && [ -n "$CS_BEFORE" ]; then
  record_worker_conversation "$CS_BEFORE" "$RES"
  # Uebergeben an den abgekoppelten Hintergrundprozess (raeumt die Datei am Ende
  # seiner eigenen bis zu 40s laufenden Poll-Schleife selbst weg, siehe dort) --
  # pi_worker_cleanup() darf sie deshalb ab hier nicht mehr anfassen.
  CS_BEFORE=""
fi

# ---------------------------------------------------------------------------
# WELCHER WEG (2026-08-20). Bis heute gab es genau einen: den Auftrag in die
# Eingabezeile des Panes tippen. In der Nacht auf den 20.08. hat dieser Weg fuenf
# Panes eingefroren und Auftraege stumm verschluckt; die Verifikation dahinter ist
# viermal nachgeschaerft worden. Fuer Claude-Code-Worker gibt es einen zweiten Weg,
# der nicht durch die Eingabezeile geht: die Socket-Inbox der Sitzung (siehe
# wb-inbox fuer die Messungen). Er kann nichts ueberschreiben, an nichts anhaengen
# und keine Eingabezeile blockieren -- die drei Schadensbilder von heute Nacht sind
# dort per Bauart nicht moeglich.
#
# WAS SICH DADURCH NICHT AENDERT: der BELEG. Weder ein Paste noch ein Socket-Schreiben
# beweist, dass der Auftrag angekommen ist; beweisen tut das nur, dass der Marker
# ($MARKER_INHALT) hinterher im Pane wieder auftaucht. Diese Pruefung lief bisher
# nur fuer Harnesses mit gemessenem promptPattern -- ab jetzt fuer JEDEN Weg und
# JEDEN Harness (siehe INHALTSPRUEFUNG weiter unten). Das ist der Kern: ein Weg,
# dessen Erfolg man nicht messen kann, ist kein Weg.
#
# Der Schalter `workerZustellung` (auto|socket|paste, Vorgabe auto) haelt den
# Rueckweg offen: 'paste' benutzt die Inbox nie, 'socket' verlangt sie und faellt
# NICHT zurueck (fuer Tests), 'auto' nimmt sie, wo es sie gibt, und tippt sonst.
ZUSTELLWEG=paste
submitted=""
inhalt_beleg=""
# Vorbelegt, damit die Meldungen ganz unten auch auf einem Weg definiert sind, der
# nie tippt (`set -u`). Der Paste-Weg setzt beide unten selbst.
ABSENDE_TASTE=Enter
ABSENDE_FRIST=45
ZUSTELL_WAHL="$("$HOME/.local/bin/wb-state" settings get workerZustellung 2>/dev/null || true)"
ZUSTELL_QUELLE="der Einstellung workerZustellung"
if [ -n "${WB_ZUSTELLUNG:-}" ]; then
  ZUSTELL_WAHL="$WB_ZUSTELLUNG"
  ZUSTELL_QUELLE="der Umgebungsvariablen WB_ZUSTELLUNG"
fi
# EIN UNBEKANNTER WERT IST EIN FEHLER, KEIN 'auto' (2026-08-20, Stresstest der
# Zustellung, gemessen). Bis hierher fiel jeder nicht erkannte Wert still auf
# 'auto' -- und das kehrte die Wahl um, statt sie zu ignorieren: mit
# workerZustellung=paste in den Einstellungen und einem vertippten
# WB_ZUSTELLUNG=sockett lief die Zustellung ueber die Inbox, also genau ueber
# den Weg, den die Einstellung ausgeschlossen hatte. Umgekehrt genauso teuer:
# ein vertipptes 'socket' verliert die Zusage "faellt NICHT aufs Tippen
# zurueck", die der einzige Grund fuer diese Stellung ist -- und niemand
# erfaehrt es, weil 'auto' im Erfolgsfall gleich aussieht.
#
# Die gespeicherte Einstellung prueft `wb-state settings set` bereits beim
# Schreiben (ENUM dort). Diese Stelle deckt die zwei Wege ab, die daran
# vorbeigehen: die Umgebungsvariable fuer den Einzelfall, die niemand prueft,
# und eine von Hand veraenderte Einstellungsdatei. Leer bleibt leer und heisst
# weiterhin 'auto' -- eine nicht gesetzte Variable ist keine falsche Angabe.
case "$ZUSTELL_WAHL" in
  paste|socket|auto) : ;;
  "")                ZUSTELL_WAHL=auto ;;
  *) zustellung_fehlgeschlagen "Zustellweg '$ZUSTELL_WAHL' aus $ZUSTELL_QUELLE ist keiner der drei bekannten (auto|socket|paste). Es wurde NICHTS zugestellt -- ein unbekannter Wert wird nicht als 'auto' geraten, weil das die getroffene Wahl umkehren statt uebergehen wuerde." ;;
esac
WB_INBOX=""
if [ "$ZUSTELL_WAHL" != paste ] && [ "$KIND" = claude ]; then
  for kandidat in "$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/wb-inbox" \
                  "$HOME/.local/bin/wb-inbox"; do
    [ -x "$kandidat" ] && { WB_INBOX="$kandidat"; break; }
  done
  if [ -n "$WB_INBOX" ] && "$WB_INBOX" finde "$pane" >/dev/null 2>&1; then
    ZUSTELLWEG=socket
  elif [ "$ZUSTELL_WAHL" = socket ]; then
    zustellung_fehlgeschlagen "workerZustellung=socket verlangt die Sitzungs-Inbox, aber unter Pane $pane ist keine lebende Claude-Sitzung eingetragen (~/.claude/sessions). Es wurde NICHT ersatzweise getippt."
  fi
fi

if [ "$ZUSTELLWEG" = socket ]; then
  # Beschaeftigt oder untaetig? Das entscheidet, WIE LANGE ein fehlender Beleg
  # etwas bedeutet. Eine Inbox-Nachricht wird an der TURN-GRENZE zugestellt: eine
  # untaetige Sitzung nimmt sie sofort (gemessen: 1 s), eine mitten im Zug
  # arbeitende erst danach -- und "der Worker rechnet noch" ist kein Fehlschlag
  # der Zustellung. Der Zustand kommt aus dem Sitzungsregister, nicht aus dem
  # Pane-Text (regeln/worker-panes.md).
  INBOX_ZUSTAND="$("$WB_INBOX" status "$pane" 2>/dev/null | cut -f1)"
  # Der Auftrag kommt beim Worker als Nachricht EINER ANDEREN SITZUNG an, nicht
  # als etwas, das der Mensch getippt hat -- Claude Code stellt ihn auch genau so
  # dar. Gemessen am 2026-08-20: eine Sitzung OHNE Worker-Rolle hat einen so
  # zugestellten Auftrag ausdruecklich verweigert ("Anfrage von externem Agent
  # blockiert"). Deshalb sagen die ersten Zeilen, wer schreibt und warum das der
  # normale Weg ist. Der Auftragstext selbst bleibt Wort fuer Wort derselbe.
  INBOX_DATEI="$RESDIR/.$TS.inbox.txt"
  {
    printf 'Auftrag deines Orchestrators (Werkbank), zugestellt ueber die Sitzungs-Inbox\n'
    printf 'statt ueber die Eingabezeile deines Panes. Das ist der vorgesehene Weg und\n'
    printf 'keine fremde Anfrage: derselbe Absender, der diesen Worker gestartet hat.\n\n'
    printf '%s' "$MSG"
  } > "$INBOX_DATEI" 2>/dev/null
  if "$WB_INBOX" sende "$pane" "$INBOX_DATEI"; then
    submitted=inbox
    # Aufraeumen auch im ERFOLGSFALL (2026-08-20, Stresstest der Zustellung:
    # nach drei Auftraegen lagen drei versteckte '.<ts>.inbox.txt' im
    # Ergebnisordner). `wb-inbox sende` hat die Datei zu diesem Zeitpunkt
    # vollstaendig gelesen und weggeschrieben; sie wird nicht mehr gebraucht.
    # Der Auftragstext selbst geht dabei nicht verloren -- er steht wortgleich
    # in $RESDIR/$TS.auftrag.txt, die ohnehin fuer jeden Auftrag mitlaeuft.
    rm -f "$INBOX_DATEI" 2>/dev/null
  else
    rm -f "$INBOX_DATEI" 2>/dev/null
    if [ "$ZUSTELL_WAHL" = socket ]; then
      zustellung_fehlgeschlagen "Zustellung ueber die Sitzungs-Inbox von Pane $pane fehlgeschlagen, und workerZustellung=socket verbietet den Rueckfall auf das Tippen."
    fi
    echo "pi-worker: Zustellung ueber die Sitzungs-Inbox fehlgeschlagen — es wird getippt." >&2
    ZUSTELLWEG=paste
  fi
fi

if [ "$ZUSTELLWEG" = paste ]; then

# Zusaetzliche Sicherung, VOR dem Tippen (Betriebsbefund 19.08.2026 abends,
# der Nutzer, gemessen: alle vier Worker-Panes der Sitzung wb-AI standen auf
# 184x1). wb-workers-window haelt die Mindesthoehe des FENSTERS jetzt selbst
# durch (siehe dort, MIN_ZEILEN, dieselbe Zahl wie hier), aber dieser Pane
# hier kann trotzdem zu klein sein -- ein alter Pane von vor dem Fix, ein Weg
# ohne wb-grid/wb-workers-window dazwischen, oder ein Wettlauf mit einem
# Client, der GENAU JETZT klein anhaengt. Die Absendepruefung gleich unten
# LIEST den Pane-Inhalt (Eingabezeile, Fusszeile) -- bei einer Zeile Hoehe
# sieht sie nichts davon und meldet einen Fehlschlag, der keiner ist (genau
# der gemeldete Betriebsfehler). Deshalb: erst pruefen und noetigenfalls
# korrigieren, danach erst tippen -- nie umgekehrt. PI_WORKER_MIN_ZEILEN ist
# oben am Dateianfang definiert (dieselbe Zahl, die auch der Split-Schutz vor
# dem 'workers'-Fenster weiter oben benutzt).
#
# ZWEITER ANLASS (2026-08-20, drei Suiten wurden durch den Zusammenfuehren-Merge
# rot: test-worker-rueckfragen.sh Fall 5, test-pi-worker-worktreehinweis.sh Fall C,
# beide beim DRITTEN Worker in derselben Session): diese Absicherung prueft die
# Hoehe des EINEN Panes, korrigiert aber die Hoehe des GANZEN Fensters -- und ein
# Pane ist auch dann kurz, wenn er sich ein bereits ausreichend hohes Fenster nur
# mit mehreren ANDEREN Workern teilt (normaler Zustand im 'split'-Layout: jeder
# weitere Worker halbiert die Hoehe des naechsten Panes). Traf das zu, klemmte
# `resize-window -y 12` das Fenster auf 12 Zeilen -- und SCHRUMPFTE damit ein
# Fenster, das vorher genug Platz fuer weitere Panes hatte, dazu noch mit
# `window-size manual` GESPERRT. Der naechste Worker, der in dasselbe Fenster
# splitten wollte, fand keinen Platz mehr ("size or position no space for a new
# pane") und wurde gar nicht erst angelegt -- gemessen, reproduziert mit genau
# drei Workern in derselben Session, drittes Pane 9 Zeilen hoch, danach kein
# vierter Split mehr moeglich.
#
# Der Fix: gewachsen wird nur, wenn das FENSTER selbst (nicht nur dieser eine
# Pane) unter der Mindesthoehe liegt -- exakt der Fall aus dem ERSTEN Anlass
# (Fenster 184x1, nicht nur ein einzelner kurzer Pane darin). Ein Fenster, das
# schon hoch genug ist, wird nie angefasst, egal wie kurz einer seiner Panes
# durch Teilen mit anderen geworden ist -- lieber ein Pane, den die
# Absendepruefung im seltenen Fall knapp liest, als ein Fenster, das keinen
# weiteren Worker mehr aufnimmt.
PANE_HOEHE_VOR_TIPPEN="$(tmux display -p -t "$pane" '#{pane_height}' 2>/dev/null || true)"
case "$PANE_HOEHE_VOR_TIPPEN" in
  ''|*[!0-9]*) ;;   # Pane gerade nicht ansprechbar -- kein Rateversuch, weiter wie bisher
  *)
    if [ "$PANE_HOEHE_VOR_TIPPEN" -lt "$PI_WORKER_MIN_ZEILEN" ]; then
      PANE_FENSTER="$(tmux display -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
      if [ -n "$PANE_FENSTER" ]; then
        FENSTER_HOEHE_VOR_TIPPEN="$(tmux display -p -t "$PANE_FENSTER" '#{window_height}' 2>/dev/null || true)"
        case "$FENSTER_HOEHE_VOR_TIPPEN" in
          ''|*[!0-9]*) ;;
          *)
            if [ "$FENSTER_HOEHE_VOR_TIPPEN" -lt "$PI_WORKER_MIN_ZEILEN" ]; then
              echo "pi-worker: Pane $pane ist nur $PANE_HOEHE_VOR_TIPPEN Zeile(n) hoch, das ganze Fenster nur $FENSTER_HOEHE_VOR_TIPPEN — hebe auf $PI_WORKER_MIN_ZEILEN an, bevor getippt wird (sonst ist die Absendepruefung blind)." >&2
              tmux set-option -w -t "$PANE_FENSTER" window-size manual 2>/dev/null || true
              tmux resize-window -t "$PANE_FENSTER" -y "$PI_WORKER_MIN_ZEILEN" 2>/dev/null || true
            fi
            ;;
        esac
      fi
    fi
    ;;
esac

# Wie die Eingabezeile aussieht, BEVOR wir sie ueberhaupt anfassen (2026-08-06,
# erweitert 2026-08-20, KORRIGIERT 2026-08-20 nach test-rollen-generator.sh Fall G).
# Diese Aufnahme ist die Referenz fuer den Vergleich "ohne Wortlaut" weiter unten:
# sieht die Eingabezeile nach dem Absenden wieder so aus wie HIER, ist unser Text weg.
# Sie muss VOR dem eigenen C-u entstehen, nicht danach: C-u ist selbst ein
# Tastendruck, und ob er die Zeile wirklich LEERT statt nur ein Zeichen
# hineinzuschreiben, haengt vom Harness ab. Gemessen an der Attrappe 'projektcli'
# aus test-rollen-generator.sh Fall G (ein Harness, der C-u nicht als Zeile-loeschen
# bindet, sondern roh als Zeichen liest, wie ein rohes tty.setraw() es tut): die
# Referenz war bis heute die Aufnahme NACH C-u und trug damit das Steuerzeichen
# selbst als Verfaelschung in sich -- die spaetere Ruhelage (der echte Platzhalter
# nach dem Absenden) traf sie danach nie wieder, jeder Auftrag ueber diesen Harness
# galt als haengend, obwohl er angekommen war. Manche TUIs zeigen in der leeren
# Zeile ausserdem einen Vorschlag, und codex waehlt ihn beim Start aus einer Liste —
# gemessen sind fuenf verschiedene. Eine feste Zeichenkette (promptIgnore) kann das
# nicht fangen: sie trifft einen von fuenf, und in den uebrigen Faellen haelt die
# Pruefung unten den Vorschlag fuer haengenden Text, tippt zweimal Enter nach und
# meldet einen Fehlschlag, obwohl der Auftrag angekommen ist. Gemessen am selben Tag,
# dass der Vorschlag INNERHALB einer Sitzung stabil bleibt: getippt, geloescht,
# derselbe Vorschlag zurueck.
INBOX_VORHER=""
[ -n "$PROMPT_RE" ] && INBOX_VORHER=$(tmux capture-pane -p -t "$pane" 2>/dev/null | grep -E "$PROMPT_RE" | tail -1)

# Eingabezeile leeren, BEVOR ueberhaupt etwas eingefuegt wird (2026-08-20, Auftrag:
# Zustellung kommt heute Nacht dreimal nicht an). Gemessener Befund: ein Auftrag
# blieb ungesendet in der Box stehen, Enter wirkte nicht, nur Escape loeste ein
# Neuzeichnen aus -- und das traf auch einen KURZEN Zeigertext, die Laenge
# erklaert es also nicht. Was live half: C-u (Eingabezeile loeschen), DANACH
# tippen. Das deutet auf liegengebliebenen Text VOR dem eigentlichen Einfuegen,
# an den der neue Text angehaengt statt in eine leere Zeile getippt wurde --
# C-u geht deshalb jetzt UNBEDINGT vor jedem Absenden raus, nicht erst als
# Reparatur danach.
pane_taste "$pane" C-u || zustellung_fehlgeschlagen "C-u an Pane $pane fehlgeschlagen (wb-pane-write taste) -- Eingabezeile konnte nicht geleert werden."
sleep 1

# Ob die Zeile hinterher wirklich leer ist, wird GEMESSEN, nicht angenommen
# (dasselbe Prinzip wie ueberall in diesem Werkzeug): ohne PROMPT_RE kann das
# niemand pruefen (Registry-Harness ohne gemessenes Muster) -- C-u geht trotzdem
# unbedingt raus, das schadet einer leeren Zeile nicht. Mit PROMPT_RE wird
# nachgesehen: bleibt die Zeile auch NACH C-u belegt (und ist es nicht bloss der
# harmlose Platzhalter aus PROMPT_IGNORE, siehe oben), ist der Pane eingefroren
# oder wirklich beschaeftigt -- dann wird JETZT NICHT hineingetippt. Ein
# Fehlschlag hier ist ehrlicher als ein Paste in einen unbekannten Zustand.
# EIGENE, FRISCHE Aufnahme (INBOX_NACH_CU, nicht INBOX_VORHER): dieser Schnappschuss
# dient nur dieser einen Sofort-Pruefung und darf die Referenz von oben nicht
# ueberschreiben, selbst wenn C-u hier sichtbar etwas hinterlassen hat.
INBOX_NACH_CU=""
[ -n "$PROMPT_RE" ] && INBOX_NACH_CU=$(tmux capture-pane -p -t "$pane" 2>/dev/null | grep -E "$PROMPT_RE" | tail -1)
if [ -n "$PROMPT_RE" ] && printf '%s' "$INBOX_NACH_CU" | grep -qE "${PROMPT_RE}[[:space:]]+[^[:space:]]" \
   && ! { [ -n "$PROMPT_IGNORE" ] && printf '%s' "$INBOX_NACH_CU" | grep -qE "$PROMPT_IGNORE"; }; then
  zustellung_fehlgeschlagen "Eingabezeile in Pane $pane traegt nach C-u immer noch Text -- Pane vermutlich eingefroren oder beschaeftigt, kein Paste in einen unbekannten Zustand. Selbst ansehen: tmux capture-pane -p -t $pane"
fi

printf '%s' "$MSG" | pane_einfuegen "$pane" || zustellung_fehlgeschlagen "Einfuegen des Auftrags in Pane $pane fehlgeschlagen (wb-pane-write einfuegen)."
# Hat das Einfuegen die Eingabezeile ueberhaupt VERAENDERT? Diese Frage entscheidet, ob
# der Vergleich unten benutzt werden darf (2026-08-06, Befund aus test-registry.sh):
# Ein Pane, dessen Zeile sich NIE aendert -- eine eingefrorene TUI mit altem Text im
# Kasten --, saehe hinterher genauso aus wie vorher, und "wie vorher" hiesse dann
# faelschlich "abgeschickt". Nur wenn der eingefuegte Text sichtbar geworden ist, sagt
# seine Abwesenheit etwas aus.
sleep 1
INBOX_NACH_PASTE=""
[ -n "$PROMPT_RE" ] && INBOX_NACH_PASTE=$(tmux capture-pane -p -t "$pane" 2>/dev/null | grep -E "$PROMPT_RE" | tail -1)
# Text und Enter NIE im selben Atemzug: erst Paste rendern lassen, dann Enter,
# dann VERIFIZIEREN dass die Inputbox leer ist (sonst haengt der Prompt unsichtbar).
sleep 1
# Der Bildschirm, wie er VOR dem Enter aussah. Nicht sein Inhalt zaehlt, nur ob er
# sich danach noch bewegt (siehe die Schleife unten) -- dieselbe Pruefsumme, die
# wb-ereignisse als Rueckfall benutzt, wenn ein Worker kein Transcript hat.
CAP_VOR_ENTER="$(tmux capture-pane -p -t "$pane" 2>/dev/null)"
BILD_VOR_ENTER="$(printf '%s' "$CAP_VOR_ENTER" | cksum 2>/dev/null | awk '{print $1"-"$2}')"
# Absende-Taste: Enter, ausser der Bildschirm zeigt GERADE JETZT die eigene Ankuendigung
# des Harness fuer seinen zweiten Weg (ALTSUBMIT_TRIGGER) — dann dessen Taste. Ohne
# Ankuendigung bleibt es bei Enter, auch wenn der Harness einen altSubmit-Eintrag traegt:
# die Ankuendigung, nicht der blosse Eintrag, entscheidet je Sendung neu.
ABSENDE_TASTE=Enter
if [ -n "$ALTSUBMIT_TRIGGER" ] && [ -n "$ALTSUBMIT_KEY" ] \
   && printf '%s' "$CAP_VOR_ENTER" | grep -qE "$ALTSUBMIT_TRIGGER"; then
  ABSENDE_TASTE="$ALTSUBMIT_KEY"
  echo "pi-worker: Fusszeile zeigt den zweiten Absende-Weg dieses Harness an — sende '$ABSENDE_TASTE' statt Enter." >&2
fi
pane_taste "$pane" "$ABSENDE_TASTE" || zustellung_fehlgeschlagen "'$ABSENDE_TASTE' an Pane $pane fehlgeschlagen (wb-pane-write taste)."

# WIE LANGE GEWARTET WIRD, UND WORAN DAS HAENGT (2026-08-08).
# Bis heute prüfte diese Stelle dreimal im Abstand von zwei Sekunden und tippte bei
# JEDEM Fehlversuch erneut Enter. Sechs Sekunden reichen nicht: aider braucht laenger,
# und weil aider den abgeschickten Auftrag mit demselben Zeichen wiederholt, mit dem
# es seine Eingabezeile zeichnet ('>'), sah die letzte Treffer-Zeile waehrend der
# Antwort aus wie haengender Text. Gemessen 2026-08-08 (aider 0.86.2, ollama/qwen3:1.7b,
# eigener Socket, umgelenktes HOME): in Sekunde 1 und 2 haelt die alte Pruefung den
# WIEDERHOLTEN Auftrag fuer einen haengenden Prompt, ab Sekunde 3 ist er weggescrollt.
# Jeder Spawn endete so mit einer Fehlermeldung, obwohl der Auftrag angekommen war --
# und, schlimmer als die Meldung, mit zusaetzlichen Tastendruecken in eine Sitzung, die
# laengst arbeitete.
#
# Das Fenster haengt jetzt am Pane statt an drei festen Runden: bewegt sich der
# Bildschirm, hat der Harness den Auftrag angenommen und arbeitet -- dann wird gewartet
# und NICHT noch einmal Enter getippt. Erst ein EINGEFRORENER Pane, in dem der Text noch
# in der Eingabezeile steht, rechtfertigt ein zweites Enter. Bewegung wird als
# Pruefsumme des ganzen Pane gemessen, wie in wb-ereignisse: nicht der INHALT wird
# bewertet (der Zustand eines Workers wird nie am Pane-Text abgelesen), nur dass sich
# etwas geaendert hat.
#
# Die Zahlen, und warum sie so stehen:
#   ABSENDE_STILLE=5   Sekunden voelliger Stille, bevor ein zweites Enter erlaubt ist.
#                      Gemessen: das Neuzeichnen nach einem Paste ist in unter einer
#                      Sekunde durch (claude in Sekunde 1 leer, aider in Sekunde 1
#                      sichtbar bewegt). Fuenf Sekunden sind das Fuenffache davon.
#   ABSENDE_ENTER_MAX=2 zusaetzliche Enter -- genau so viele tippte die alte Schleife
#                      auch, bevor sie aufgab. Mehr Tastendruecke helfen einem Pane
#                      nicht, der die Eingabe nicht annimmt.
#   ABSENDE_FRIST=45   Sekunden Deckel fuer den Fall, dass der Pane sich zwar bewegt,
#                      die Eingabezeile aber nicht frei wird. Gemessener Bedarf: aider
#                      3 s, claude 1 s, der gemeldete Fehlschlag lag ueber 6 s -- 45 s
#                      ist das Siebenfache des schlimmsten gemessenen Falls und haelt
#                      einen Spawn trotzdem antwortbereit. Ein gemeinsamer Deckel und
#                      kein Registry-Feld je Harness: die Arbeit nach dem Enter ist
#                      Zeichnen, nicht Rechnen, und darin unterscheiden sich die
#                      Harnesses nicht so, dass fuenf Zahlen besser waeren als eine.
# Ein Schalter, der diese Pruefung abstellt, gibt es bewusst nicht.
ABSENDE_STILLE=5
ABSENDE_ENTER_MAX=2
ABSENDE_FRIST=45
submitted=""
eingefroren=""
if [ -n "$PROMPT_RE" ]; then
  absende_ende=$(( $(date +%s) + ABSENDE_FRIST ))
  letzte_summe="$BILD_VOR_ENTER"
  stille=0
  nachgetippt=0
  while :; do
    sleep 1
    # Nur die Eingabezeile pruefen (letzte Zeile, die mit dem Prompt-Zeichen beginnt).
    # Haengender Prompt: '❯ [Pasted text #1 ...]' oder '❯ <text>'. Leer = abgeschickt.
    bild=$(tmux capture-pane -p -t "$pane" 2>/dev/null)
    inbox=$(printf '%s\n' "$bild" | grep -E "$PROMPT_RE" | tail -1)
    # Manche TUIs zeigen in der LEEREN Eingabezeile einen Platzhalter-Vorschlag
    # (codex 0.145: "> Run /review on my current changes"). Der sieht wie hängender
    # Text aus, ist aber das Gegenteil: die Box ist leer. Ohne diese Ausnahme meldete
    # die Verifikation einen Fehlschlag, obwohl der Task angekommen war — gemessen
    # 2026-07-28. `promptIgnore` je Harness beschreibt genau diese Zeilen.
    if [ -n "$PROMPT_IGNORE" ] && printf '%s' "$inbox" | grep -qE "$PROMPT_IGNORE"; then
      submitted=yes; break
    fi
    # Die Zeile sieht aus wie vor dem Einfuegen: unser Text ist weg, also abgeschickt.
    # Das ist die Pruefung ohne Wortlaut (siehe INBOX_VORHER oben). Sie macht nichts
    # weich: eine Zeile, die unseren Text noch traegt, ist eine ANDERE als die vorherige
    # und faellt weiterhin in den Zweig darunter.
    if [ -n "$INBOX_VORHER" ] && [ "$inbox" = "$INBOX_VORHER" ] \
       && [ "$INBOX_NACH_PASTE" != "$INBOX_VORHER" ]; then
      submitted=yes; break
    fi
    if ! printf '%s' "$inbox" | grep -qE "${PROMPT_RE}[[:space:]]+[^[:space:]]"; then
      submitted=yes; break
    fi
    # Ab hier steht der Text noch in der Box. Die einzige Frage, die jetzt zaehlt:
    # arbeitet der Pane, oder ist er stehengeblieben?
    summe=$(printf '%s\n' "$bild" | cksum 2>/dev/null | awk '{print $1"-"$2}')
    if [ "$summe" != "$letzte_summe" ]; then
      stille=0; letzte_summe="$summe"
    else
      stille=$(( stille + 1 ))
    fi
    if [ "$stille" -ge "$ABSENDE_STILLE" ]; then
      if [ "$nachgetippt" -lt "$ABSENDE_ENTER_MAX" ]; then
        pane_taste "$pane" "$ABSENDE_TASTE"
        nachgetippt=$(( nachgetippt + 1 )); stille=0
      else
        # Eingefroren und die Nachhilfe ist aufgebraucht: hier wird nichts mehr besser.
        eingefroren=1; break
      fi
    fi
    [ "$(date +%s)" -ge "$absende_ende" ] && break
  done
  if [ -z "$submitted" ] && [ -n "$eingefroren" ]; then
    zustellung_fehlgeschlagen "Prompt haengt noch in der Inputbox von Pane $pane — der Bildschirm hat sich seit dem Absenden nicht mehr bewegt (${nachgetippt} zusaetzliche '${ABSENDE_TASTE}' ohne Wirkung). Manuell pruefen (tmux send-keys -t $pane $ABSENDE_TASTE)."
  fi
fi

fi   # Ende des Paste-Wegs

# INHALTSPRUEFUNG (2026-08-17, seit 2026-08-20 fuer JEDEN Weg und JEDEN Harness).
# Bis hierher hat die Schleife oben nur belegt, dass die EINGABEZEILE abgeschickt
# wurde -- nicht, dass der abgeschickte Text der Auftragstext war. Ein Paste, in
# den sich eine Terminalantwort mischt (gemessen: eine Device-Attributes-Antwort
# landete statt des Auftrags im Pane), leert die Eingabezeile genauso wie ein
# echtes Absenden und bestand die Pruefung oben unveraendert -- mit der Meldung
# "Submission verifiziert", auf die sich Orchestrator und Kontextwache verlassen.
# Der eigentliche Beleg ist deshalb dieser: taucht $MARKER_INHALT (derselbe
# Marker, den record_worker_conversation fuer die Transkript-Zuordnung benutzt)
# irgendwo im Pane wieder auf?
#
# ZWEI ERWEITERUNGEN am 2026-08-20:
#   * Sie laeuft jetzt auch OHNE gemessenes promptPattern. Diese Pruefung braucht
#     keines: sie liest den Bildschirm, nicht die Eingabezeile. Fuer kimi und
#     opencode -- die beiden Harnesses, bei denen Zustellung bisher grundsaetzlich
#     unbelegbar war -- ist damit wenigstens belegt, ob der Auftragstext ueberhaupt
#     im Terminal ANGEKOMMEN ist. Genau diese Luecke hat zweimal einen Auftrag
#     still verschluckt. Was sie dort NICHT belegt, bleibt beim Namen genannt: ob
#     er auch abgeschickt wurde.
#   * Sie belegt auch den Inbox-Weg. Gemessen am 2026-08-20: eine ueber die
#     Socket-Inbox zugestellte Nachricht steht nach einer Sekunde im Pane -- also
#     derselbe Beleg, dieselbe Stelle, kein zweiter Mechanismus.
INHALT_FRIST=10   # Sekunden Gnadenfrist. Eingabezeile und Verlauf zeichnen im
                  # selben Bildschirm-Neuzeichnen (siehe oben: "Neuzeichnen nach
                  # einem Paste ist in unter einer Sekunde durch") -- 10s ist das
                  # Zehnfache davon und bricht die Wartezeit ab, sobald der Beleg
                  # da ist, kostet also im Regelfall nichts.
# Der Inbox-Weg bekommt mehr Zeit: die Nachricht wird an der TURN-GRENZE
# zugestellt. Ein frisch gestarteter Worker ist untaetig und nimmt sie sofort
# (gemessen: 1 s), ein beschaeftigter erst nach seinem laufenden Zug -- und darauf
# zu warten ist richtig, nicht ein Fehler.
[ "$ZUSTELLWEG" = socket ] && INHALT_FRIST=60

# ZWEI QUELLEN STATT EINER (2026-08-20, nach einem Fehlalarm im Betrieb).
# Der Beleg hing bisher allein daran, dass die Oberflaeche den Auftrag auch
# ANZEIGT. Das ist eine Menge Voraussetzungen fuer eine Ja/Nein-Frage: Pane-
# Breite, Zeilenumbruch, Abkuerzung langer Pfade, Einklappen eingefuegter
# Bloecke, Scrollback-Tiefe. Beim Worker 'dsharness' schlug die Pruefung Alarm,
# obwohl der Auftrag angekommen war und der Worker schon arbeitete; nachstellen
# liess sich der Fall danach in keiner der gemessenen Lagen (Nachricht 645 bis
# 4884 Zeichen, Pane 50 bis 200 Spalten, Inline- und Dateizeiger-Weg, 60 s lang
# jede Sekunde nachgesehen -- der Marker war immer da und blieb es). Wo eine
# Ursache nicht feststeht, wird die Pruefung breiter statt schaerfer:
#
#   1. Der Pane, wie bisher, aber mit ZWEI Nadeln: dem Dateinamen und dem
#      blossen Zeitstempel. Der Zeitstempel ist kuerzer und uebersteht eine
#      Abkuerzung oder einen Umbruch, an dem der volle Name zerbricht; eindeutig
#      ist er trotzdem, denn gesucht wird nur in DIESEM Pane und der vorige
#      Auftrag desselben Panes trug einen anderen.
#   2. Die GESPRAECHSDATEI der Sitzung (nur Claude Code, ueber `wb-inbox
#      transcript`). Sie haengt an keiner Anzeige: dort steht der Auftragstext
#      so, wie die Sitzung ihn bekommen hat. Gemessen am 2026-08-20: der Marker
#      steht dort, kurz nachdem er im Pane erscheint.
#
# Beides zusammen belegt dieselbe Sache; ein Treffer genuegt. Die Datei wird nur
# gelesen, nie geschrieben.
# KANN DER PANE UEBERHAUPT ETWAS BELEGEN? (2026-08-20, zweite Runde, gemessen.)
# Diese Frage stand bisher nirgends, und ihre Antwort ist bei Claude Code NEIN.
# Der Harness laeuft im ALTERNATE SCREEN, und fuer den fuehrt tmux keinen
# Verlauf: gemessen auf eigenem Socket ergibt alternate_on=1 ein
# history_size=0, `capture-pane -S -2000` liefert dann nur das sichtbare Bild.
# Das `-S -2000` unten ist dort also wirkungslos, und sobald die Sitzung nach
# dem Empfang zu arbeiten anfaengt, ist der Marker aus den sichtbaren Zeilen
# heraus und nie wieder zu finden. Gegengeprueft am Betrieb: alle 13 Panes der
# drei laufenden Sessions standen auf alternate_on=1 und history_size=0.
#
# GEMESSEN, NICHT GEGLAUBT, mit der Registry als Rueckfall: gefragt wird zuerst
# der Pane selbst (`alternate_on`), denn das ist die Tatsache, um die es geht --
# fuehrt DIESER Pane einen Verlauf? Laesst sich das nicht ablesen (Pane
# verschwunden, fremdes tmux), entscheidet das Feld `altScreen` des Harness aus
# der Registry. Der Harness-NAME steht hier bewusst nirgends: die Eigenschaft
# gehoert dem Harness, und die Registry fuehrt sie fuer jeden.
PANE_FUEHRT_VERLAUF=1
PANE_ALT="$(tmux display -p -t "$pane" '#{alternate_on}' 2>/dev/null)"
case "$PANE_ALT" in
  1) PANE_FUEHRT_VERLAUF=0 ;;
  0) PANE_FUEHRT_VERLAUF=1 ;;
  *) # Nicht ablesbar (Pane weg, fremdes tmux) -- dann sagt die Registry, was
     # dieser Harness tut. `models harness-get` gibt den ganzen Eintrag aus,
     # das eine Feld wird hier herausgelesen.
     if "$HOME/.local/bin/wb-state" models harness-get "${RHARNESS:-$KIND}" 2>/dev/null \
        | /usr/bin/python3 -c 'import json,sys
try: sys.exit(0 if json.load(sys.stdin).get("altScreen") is True else 1)
except Exception: sys.exit(1)'; then
       PANE_FUEHRT_VERLAUF=0
     fi ;;
esac

# Die Gespraechsdatei wird IN der Schleife gesucht, nicht einmal davor
# (2026-08-20, zweite Runde: das war der zweite Teil des Fehlalarms). Ein
# frisch gestarteter Worker hat seine Datei noch nicht, wenn hier zum ersten
# Mal gefragt wird -- gemessen am eigenen Fall: Sitzung um 14:41:38 gestartet,
# Datei um 14:41:40 angelegt, gefragt wurde um 14:41:38/39. Einmal gefragt und
# nichts gefunden hiess bisher: diese Quelle bleibt fuer alle 60 Sekunden tot,
# obwohl der Marker ab Sekunde 1 darin stand. Deshalb wird jede Runde neu
# gefragt, solange noch kein Pfad steht.
TRANSCRIPT_BELEG=""
TRANSCRIPT_DA=""     # war die Gespraechsdatei je verfuegbar? Das entscheidet unten,
                     # ob ein fehlender Marker ueberhaupt etwas bedeutet.
inhalt_beleg=""
inhalt_quelle=""
inhalt_ende=$(( $(date +%s) + INHALT_FRIST ))
while :; do
  # -J: umgebrochene Zeilen werden vor der Suche wieder zusammengesetzt, sonst
  # zerreisst ein Terminal-Umbruch mitten im Marker die Zeichenkette in zwei
  # Fundstellen, die keine von beiden trifft. -S -2000: der Marker kann laengst
  # aus dem sichtbaren Fenster gescrollt sein, bis der Harness zu antworten
  # beginnt (Vorbild: derselbe Aufruf in wb-ssh-worker fuer dieselbe Frage).
  BILD_BELEG="$(tmux capture-pane -p -J -S -2000 -t "$pane" 2>/dev/null)"
  if printf '%s' "$BILD_BELEG" | grep -qF -- "$MARKER_INHALT"; then
    inhalt_beleg=1; inhalt_quelle="Pane"; break
  fi
  if printf '%s' "$BILD_BELEG" | grep -qF -- "$TS"; then
    inhalt_beleg=1; inhalt_quelle="Pane (Zeitstempel)"; break
  fi
  if [ "$KIND" = claude ] && [ -n "$WB_INBOX" ] && [ -z "$TRANSCRIPT_BELEG" ]; then
    TRANSCRIPT_BELEG="$("$WB_INBOX" transcript "$pane" 2>/dev/null)"
  fi
  if [ -n "$TRANSCRIPT_BELEG" ] && [ -f "$TRANSCRIPT_BELEG" ]; then
    TRANSCRIPT_DA=1
    if grep -qF -- "$MARKER_INHALT" "$TRANSCRIPT_BELEG" 2>/dev/null; then
      inhalt_beleg=1; inhalt_quelle="Gespraechsdatei"; break
    fi
  fi
  [ "$(date +%s)" -ge "$inhalt_ende" ] && break
  sleep 1
done
if [ -n "$submitted" ] && [ -z "$inhalt_beleg" ]; then
  submitted=""
  inhalt_fehlt=1
fi

# Ohne gemessenes promptPattern wird NICHT behauptet, was nicht geprueft wurde: der
# Task ist eingefuegt und Enter ist gesendet, aber ob die Inputbox leer ist, weiss
# hier niemand. Genau diese Luecke hat schon zweimal einen Task still verschluckt —
# mit einer Erfolgsmeldung darueber waere sie unauffindbar.
if [ "$submitted" = inbox ]; then
  echo "Task an Chat-Agent '$NAME' ($MODEL, Pane $pane) ueber die Sitzungs-Inbox zugestellt (Ankunft belegt: $inhalt_quelle) — nichts getippt."
elif [ -n "$submitted" ]; then
  echo "Task an Chat-Agent '$NAME' ($MODEL, Pane $pane) gesendet (Submission verifiziert)."
elif [ -n "${inhalt_fehlt:-}" ] && [ "$ZUSTELLWEG" = socket ] && [ "${INBOX_ZUSTAND:-}" = busy ]; then
  # Der eine Fall, in dem ein fehlender Beleg KEIN Fehlschlag ist: die Sitzung war
  # beim Absenden mitten in einem Zug, und die Inbox stellt erst an dessen Grenze
  # zu. Behauptet wird deshalb weder Erfolg noch Misserfolg -- und der Platzhalter
  # bleibt zu Recht stehen, denn dieser Worker ARBEITET nachweislich.
  echo "Task an Chat-Agent '$NAME' ($MODEL, Pane $pane) in die Sitzungs-Inbox gelegt —"
  echo "  Zustellung steht noch aus: die Sitzung war beschaeftigt, die Nachricht kommt"
  echo "  an der naechsten Turn-Grenze an. Beleg nach ${INHALT_FRIST}s noch nicht da."
  echo "  Nachsehen: tmux capture-pane -p -t $pane   (gesucht: '$MARKER_INHALT')"
elif [ -n "${inhalt_fehlt:-}" ] && [ "$PANE_FUEHRT_VERLAUF" = 0 ] && [ -z "$TRANSCRIPT_DA" ]; then
  # BEIDE Quellen waren blind, also sagt ihr Schweigen nichts (2026-08-20,
  # reproduziert): der Pane fuehrt keinen Verlauf (Alternate Screen), und eine
  # Gespraechsdatei gab es in der ganzen Frist nicht -- der Normalfall bei einem
  # frisch gestarteten Worker, dessen Datei erst zwei Sekunden nach dem Start
  # entsteht. Genau diese Lage hat heute zwei arbeitende Worker als gescheitert
  # gemeldet. Ein fehlender Beleg ist hier kein Gegenbeleg.
  zustellung_unentschieden "der Auftragstext ist nicht wiederzufinden (gesucht: '$MARKER_INHALT' und '$TS', ${INHALT_FRIST}s), aber beide Belegquellen waren blind — der Pane fuehrt keinen Verlauf (Alternate Screen, history_size 0) und eine Gespraechsdatei gab es in dieser Zeit noch nicht. Ob der Auftrag ankam, ist damit offen, NICHT widerlegt."
elif [ -n "${inhalt_fehlt:-}" ] && [ "$ZUSTELLWEG" = socket ]; then
  zustellung_fehlgeschlagen "In die Sitzungs-Inbox von Pane $pane wurde geschrieben, aber der Auftragstext ist weder im Pane noch in der Gespraechsdatei wiederzufinden (gesucht: '$MARKER_INHALT' und '$TS', ${INHALT_FRIST}s gewartet), obwohl die Sitzung beim Absenden untaetig war ('${INBOX_ZUSTAND:-unbekannt}'). Geschrieben heisst nicht angekommen. Selbst ansehen: tmux capture-pane -p -t $pane"
elif [ -n "${inhalt_fehlt:-}" ]; then
  zustellung_fehlgeschlagen "Eingabezeile in Pane $pane ist leer, aber der Auftragstext ist nicht wiederzufinden (gesucht: '$MARKER_INHALT' und '$TS', ${INHALT_FRIST}s gewartet, Pane und -- soweit vorhanden -- Gespraechsdatei). Die Zeile allein zu leeren belegt kein Absenden -- irgendein anderer Text kann sie ebenso geleert haben. Selbst ansehen und, falls noetig, den Auftrag erneut schicken: tmux capture-pane -p -t $pane"
elif [ -n "$PROMPT_RE" ]; then
  # Der dritte Ausgang, neu am 2026-08-08: die Frist ist um, die Eingabezeile traegt den
  # Text noch, aber der Pane BEWEGT sich. "Haengt" ist das nicht -- ein eingefrorener Pane
  # waere oben schon als Fehler ausgestiegen. Behauptet wird deshalb weder das eine noch
  # das andere. Kein zweites Enter ist hier getippt worden, und das ist der Punkt: in einen
  # Auftrag, der laeuft, wird nicht hineingetippt.
  echo "Task an Chat-Agent '$NAME' ($MODEL, Pane $pane) eingefuegt und '$ABSENDE_TASTE' gesendet —"
  echo "  Submission NICHT verifiziert: die Eingabezeile traegt den Text nach ${ABSENDE_FRIST}s"
  echo "  noch, der Pane arbeitet aber (Bildschirm bewegt sich). Keine weitere '$ABSENDE_TASTE' getippt."
  echo "  Selbst ansehen: tmux capture-pane -p -t $pane"
elif [ -n "$inhalt_beleg" ]; then
  # Kein gemessenes promptPattern -- die Eingabezeile ist hier nicht lesbar. Was
  # sich TROTZDEM messen laesst, ist seit 2026-08-20 gemessen: der Auftragstext
  # steht im Pane, er ist also wirklich dort angekommen. Genau der Fall, der
  # zweimal still verschluckt wurde, faellt damit ab jetzt auf. Was weiterhin
  # offen bleibt, steht daneben und wird nicht schoengeredet.
  echo "Task an Chat-Agent '$NAME' ($MODEL, Pane $pane) eingefuegt und '$ABSENDE_TASTE' gesendet —"
  echo "  ANGEKOMMEN ist er: der Auftragstext ('$MARKER_INHALT') ist wiederzufinden — Quelle: $inhalt_quelle."
  echo "  Ob er auch ABGESCHICKT wurde, ist bei Harness '${RHARNESS:-?}' nicht pruefbar"
  echo "  (kein gemessenes promptPattern). Messen: wb-harness-probe ${RHARNESS:-<harness>} ; danach"
  echo "  wb-state models set --kind harness ${RHARNESS:-<harness>} promptPattern '\"<muster>\"'"
else
  zustellung_fehlgeschlagen "Der Auftragstext ist in Pane $pane nicht wiederzufinden (gesucht: '$MARKER_INHALT' und '$TS', ${INHALT_FRIST}s gewartet), und Harness '${RHARNESS:-?}' hat kein gemessenes promptPattern, an dem sich das Absenden ablesen liesse. Es ist also weder belegt, dass der Auftrag angekommen ist, noch dass er abgeschickt wurde. Selbst ansehen: tmux capture-pane -p -t $pane"
fi
echo "Ergebnis-Datei: $RES (latest.md zeigt bis dahin auf einen Platzhalter, danach auf diese Datei: $RESDIR/latest.md)"
echo "Auftrag Nr. $(grep -cv '^#' "$AUFTRAEGE" 2>/dev/null || echo 1) fuer '$NAME' — Buch: $AUFTRAEGE"
echo "Warten (mit Deadline!): until [ -s '$RES' ]; do sleep 5; done  — bei Stillstand: pi-worker $NAME --interrupt"
