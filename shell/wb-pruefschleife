def befehl_vorlage(args, projekt: Path) -> int:
    ziel_datei = projekt / VERTRAG_DATEI_NAME
    if ziel_datei.exists():
        print(f"{ziel_datei} gibt es schon -- nichts geschrieben.")
        return 1
    projekt.mkdir(parents=True, exist_ok=True)
    bauauftrag_pfad = projekt / "bauauftrag.md"
    if not bauauftrag_pfad.exists():
        bauauftrag_pfad.write_text(
            "# Bauauftrag\n\nHier die ausfuehrliche Aufgabenbeschreibung eintragen -- was gebaut "
            "werden soll, mit Kontext, so wie man es einem Menschen sagen wuerde.\n",
            encoding="utf-8")
    vorlage = {
        "ziel": "EIN SATZ: was gebaut werden soll",
        "fertig_wenn": "Rundenobergrenze erreicht oder Stillstand -- dann sieht ein Mensch hin.",
