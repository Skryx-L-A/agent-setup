def bauen_zerleger() -> argparse.ArgumentParser:
    zerleger = argparse.ArgumentParser(
        prog="wb-pruefschleife",
        description="Die Pruefschleife -- mehrstufige Pruefung statt einer Messzahl.")
    zerleger.add_argument(
        "--projekt", type=Path, default=None,
        help="Projektverzeichnis. Reihenfolge ohne diesen Schalter: das Verzeichnis von "
             "--konfiguration; sonst das aktuelle Arbeitsverzeichnis, wenn dort eine "
             "pruefschleife.json liegt; sonst das Verzeichnis dieses Skripts. Vor oder nach "
             "dem Unterbefehl.")
    zerleger.add_argument("--konfiguration", type=Path, default=None,
                          help="Pfad zur Vertragsdatei (Vorgabe: pruefschleife.json im "
                               "Projektverzeichnis)")
    unter = zerleger.add_subparsers(dest="befehl", required=True)

    def mit_unterbefehl(name, **kw):
        """Sinngemaess uebernommen aus wb_autoresearch.py, mit_unterbefehl():
        default=SUPPRESS statt default=None, sonst wirft ein Unterbefehl ohne
        eigenes --projekt ein vor ihm gesetztes --projekt wieder auf None
        zurueck (Befund dort 01.09.2026, per echtem CLI-Aufruf belegt)."""
        p = unter.add_parser(name, **kw)
        p.add_argument("--projekt", type=Path, default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        return p

    vorlage = mit_unterbefehl("vorlage", help="eine ausfuellbare pruefschleife.json schreiben")
    vorlage.set_defaults(funktion=befehl_vorlage)

    lauf = mit_unterbefehl("lauf", help="eine Runde (neu oder fortgesetzt)")
    lauf.set_defaults(funktion=befehl_lauf)

    schleife = mit_unterbefehl("schleife", help="Runden bis Obergrenze oder Stillstand")
    schleife.set_defaults(funktion=befehl_schleife)

    stand = mit_unterbefehl("stand", help="was bisher lief")
    stand.set_defaults(funktion=befehl_stand)

    fortsetzen = mit_unterbefehl("fortsetzen", help="eine abgebrochene Runde fortsetzen")
    fortsetzen.set_defaults(funktion=befehl_fortsetzen)

    return zerleger


def unterbefehle() -> list[str]:
    """Die Namen aller Unterbefehle, aus dem Parser gelesen -- nicht aus einer
    Konstanten, die ein neuer Unterbefehl vergessen koennte."""
    for aktion in bauen_zerleger()._actions:
        if isinstance(aktion, argparse._SubParsersAction):
            return list(aktion.choices.keys())
    return []


def main() -> int:
    args = bauen_zerleger().parse_args()
    projekt = projekt_bestimmen(args.projekt, args.konfiguration)

    if args.befehl == "vorlage":
        return befehl_vorlage(args, projekt)

    vertrag_pfad = args.konfiguration if args.konfiguration else projekt / VERTRAG_DATEI_NAME
    if not vertrag_pfad.exists():
        print(f"Kein Vertrag in {projekt}. Erst: wb-pruefschleife --projekt {projekt} vorlage")
        return 1
    try:
        vertrag = vertrag_laden(projekt, args.konfiguration)
    except (ValueError, OSError, json.JSONDecodeError) as fehler:
        print(f"Vertrag laesst sich nicht laden: {fehler}")
        return 1

    return args.funktion(args, projekt, vertrag)


if __name__ == "__main__":
    sys.exit(main())
