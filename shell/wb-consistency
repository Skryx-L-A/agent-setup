def _ist_paketverwaltet(pfad, fremd_verzeichnisse):
    # Beide Seiten realpath()en, nicht nur pfad: macOS verlinkt /tmp und /var
    # selbst auf /private/... -- ohne das aufzuloesen vergleicht der Praefix-
    # Test einen aufgeloesten Pfad gegen einen unaufgeloesten und verfehlt jeden
    # Treffer, dessen Heimatverzeichnis (oder ein Testverzeichnis) hinter so
    # einem System-Symlink liegt.
    real = os.path.realpath(pfad)
    for d in fremd_verzeichnisse:
        d_real = os.path.realpath(d)
        if real == d_real or real.startswith(d_real.rstrip("/") + "/"):
            return True
    return False


def _ist_skript(pfad):
    try:
        with open(pfad, "rb") as f:
            kopf = f.read(4096)
    except OSError:
        return False
    return b"\x00" not in kopf and kopf[:2] == b"#!"


def _ist_venv_datei(pfad):
    """Der REALE Pfad der Datei selbst (nicht der ihrer Shebang-Zeile) liegt in
    bin/ einer Python-virtuellen-Umgebung -- pyvenv.cfg im Elternverzeichnis
    von bin/ ist der Standard-Marker von venv/virtualenv, unabhaengig vom
    Produktnamen. Trifft ein per Symlink aus ~/.local/bin herausgezeigtes
    Fremdprogramm aus einem eigenen Studio-/Installer-Venv (gemessen:
    `unsloth`, Symlink auf .../unsloth_studio/bin/unsloth, mit pyvenv.cfg
    daneben). Geprueft wird NUR die Datei selbst: ein von Hand geschriebenes
    Skript, das lediglich das Python eines fremden Venvs als Interpreter
    benutzt (etwa `rerank`s Shebang), liegt selbst nicht IN diesem Venv und
    faellt hier nicht hinein -- sonst waere jedes eigene Werkzeug mit einem
    projektgebundenen venv-Interpreter faelschlich fremd."""
    real = os.path.realpath(pfad)
    eltern = os.path.dirname(os.path.dirname(real))
    return os.path.isfile(os.path.join(eltern, "pyvenv.cfg"))


def _installationsnachweis(record_globs):
    """Menge realer Pfade, die im RECORD einer per pip installierten
    Distribution als deren eigene Datei aufgefuehrt sind. Ein RECORD-Eintrag
    ist relativ zum site-packages-Verzeichnis (dem Elternverzeichnis des
    *.dist-info-Ordners) zu lesen -- ein Skript in bin/ steht dort typisch als
    '../../../bin/<name>'. Absichtlich nur die Nutzer-Installationsorte
    (record_globs, aus der Konfiguration): Orte, die bereits ueber
    _ist_paketverwaltet erkannt werden (uv-/pipx-Venvs), muessen hier nicht
    noch einmal durchsucht werden -- das waeren auf dem Mac ueber tausend
    RECORD-Dateien fuer eine Frage, die (1) schon beantwortet."""
    pfade = set()
    for record in expand_globs(record_globs):
        site_packages = os.path.dirname(os.path.dirname(record))
        try:
            with open(record, "r", newline="", errors="replace") as f:
                for zeile in csv.reader(f):
                    if not zeile or not zeile[0]:
                        continue
                    pfade.add(os.path.realpath(os.path.join(site_packages, zeile[0])))
        except (OSError, csv.Error):
            continue
    return pfade


def _sorte_d(c7, findings, base):
    d = c7.get("fremd_pruefung")
    if not d:
        return
    ziel = d.get("ziel")
    if not ziel or not os.path.isdir(ziel):
        return
    fremd_verzeichnisse = d.get("paketmanager_verzeichnisse", [])
    nachweis = _installationsnachweis(d.get("installationsnachweis_globs", []))
    repo_praefixe = [p for p, z in ((e[0], e[1]) for e in c7["install_map"]) if z == ziel]
    repo_praefixe += d.get("bekannt_zusatz_praefixe", [])
    bekannt = set()
    for prefix in repo_praefixe:
        wurzel = os.path.join(c7["repo_dir"], prefix)
        if os.path.isdir(wurzel):
            bekannt.update(os.listdir(wurzel))
    for name in sorted(os.listdir(ziel)):
        pfad = os.path.join(ziel, name)
        if name in bekannt or not os.path.isfile(pfad):
            continue
        if any(ex in pfad for ex in c7.get("exclude_substrings", ())):
            continue
        if _ist_paketverwaltet(pfad, fremd_verzeichnisse):
            continue
        if os.path.realpath(pfad) in nachweis:
            continue
        if _ist_venv_datei(pfad):
            continue
        if not _ist_skript(pfad):
            continue
        kopf = "\n".join(read_lines(pfad)[:40])
        if NICHT_VERSIONIERT_RE.search(kopf):
            continue
        findings.append(Finding(
            "EIGEN-NICHT-IM-REPO", os.path.relpath(pfad, base), 1,
            "liegt unter %s, aber nirgends im Repo" % ziel,
            "Skript mit Shebang, keine Spur zu einem Paketmanager -- vermutlich von "
            "Hand gebaut und nie aufgenommen. Entweder ins Repo aufnehmen, oder falls "
            "es bewusst nur lokal bleiben soll, in den ersten 40 Zeilen selbst "
            "vermerken: 'NICHT VERSIONIERT: <Begruendung>'.", severity="error"))


