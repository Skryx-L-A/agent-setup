# Was vor dem eigentlichen Befehl stehen darf, ohne dass er ein anderer wird.
TMUX_VORSPANN = {"env", "exec", "nohup", "sudo", "time", "builtin", "command", "eval", "then",
                 "do", "else", "elif", "if", "while", "until", "!", "{", "("}

# Trennzeichen, hinter denen ein NEUER Befehl anfaengt.
_BEFEHLSTRENNER = re.compile(r"(\|\||&&|\||;|\$\(|`|\bthen\b|\bdo\b|\belse\b|\{)")

_FUNKTION_RE = re.compile(r"^\s*(?:function\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*\(\)\s*\{?")
_ZUWEISUNG_RE = re.compile(r"^\s*(?:export\s+|local\s+|declare\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
_SOCKET_FLAGGE = re.compile(r"(?<![A-Za-z0-9_-])-[LS](?:\s|=|\"|'|\$)")
# Ein Verweis auf das Binary, nicht auf einen Aufruf: `command -v tmux`, `which tmux`.
_TMUX_SUCHE = re.compile(r"(?:command\s+-v|which|type\s+-p)\s+tmux\b")


def _ohne_kommentar(zeile):
    """Alles ab einem Rautezeichen weg, das ausserhalb von Anfuehrungszeichen steht."""
    einfach = doppelt = False
    for i, z in enumerate(zeile):
        if z == "'" and not doppelt:
            einfach = not einfach
        elif z == '"' and not einfach:
            doppelt = not doppelt
        elif z == "#" and not einfach and not doppelt:
            if i == 0 or zeile[i - 1] in " \t":
                return zeile[:i]
    return zeile


def _huellen_sammeln(lines):
    """Namen, hinter denen ein festgelegter Socket steckt, und Namen, die auf das
    tmux-Binary zeigen. Zwei Listen, weil sie GEGENTEILIGES bedeuten: die erste
    ist sicher, die zweite muss wie `tmux` selbst geprueft werden. Dazu die Namen
    der PATH-Schirme (siehe unten), die dasselbe auf einem dritten Weg leisten.

    Drittens die Zeilennummern des RUMPFES jeder erkannten Huelle. Ohne die meldete
    die Pruefung die Huelle an sich selbst: eine Funktion, die den Socket setzt,
    traegt in ihrem Rumpf einen tmux-Aufruf, und ein Zweig wie `else tmux "$@"`
    steht dort ohne Socket, obwohl genau diese Funktion ihn setzt."""
    sicher, aliasse, rumpfzeilen, schirme = set(), set(), set(), set()
    i, n = 0, len(lines)
    while i < n:
        roh = _ohne_kommentar(lines[i])
        m = _FUNKTION_RE.match(roh)
        if m:
            # Rumpf bis zur schliessenden Klammer einsammeln (einzeilig wie mehrzeilig).
            rumpf, j = [roh], i
            while j + 1 < n and roh.rstrip().endswith("{") is False and "}" not in roh:
                j += 1
                roh2 = _ohne_kommentar(lines[j])
                rumpf.append(roh2)
                if roh2.strip() in ("}", "};"):
                    break
                if j - i > 30:      # keine Funktion in dieser Sammlung ist so lang
                    break
            text = "\n".join(rumpf)
            if "tmux" in text and _SOCKET_FLAGGE.search(text):
                sicher.add(m.group(1))
                rumpfzeilen.update(range(i + 1, j + 2))   # 1-basiert wie die Meldung
            i += 1
            continue
        z = _ZUWEISUNG_RE.match(roh)
        if z:
            name, wert = z.group(1), z.group(2)
            if "tmux" in wert and _SOCKET_FLAGGE.search(wert):
                sicher.add(name)
            elif _TMUX_SUCHE.search(wert) or re.search(r"[\"'/]tmux[\"']?\s*$", wert.strip()):
                aliasse.add(name)
        # DER PATH-SCHIRM. Mehrere Suiten legen ein Verzeichnis an, in dem ein
        # ausfuehrbares `tmux` steht, das nichts tut als den echten tmux mit -L zu
        # rufen -- und schieben dieses Verzeichnis in die PATH jedes Panes, den sie
        # oeffnen (betriebslauf.sh, test-registry.sh, und die Reparatur, die nach dem
        # Vorfall vom 04.08. genau dort eingebaut wurde). Ein Aufruf `tmux attach` in
        # so einem Pane landet auf dem TESTSOCKET, obwohl in der Zeile kein -L steht.
        # Ohne diese Erkennung meldete die Pruefung ausgerechnet die Reparatur als
        # Fehler.
        m2 = re.search(r">\s*[\"']?\$\{?(\w+)\}?/tmux\b", roh)
        if m2:
            # Der Rumpf des Schirms folgt in den naechsten Zeilen (Here-Dokument).
            block = "\n".join(lines[i:i + 8])
            if "tmux" in block and _SOCKET_FLAGGE.search(block):
                schirme.add(m2.group(1))
        i += 1
    # Der Schirm wird selten direkt in die PATH gesetzt; ueblich ist eine zweite
    # Variable, die ihn einsammelt (`PANE_PATH="$SHIM:$BIN:/usr/bin:..."`) und DIE
    # dann in die PATH des Panes geht. Ein Durchgang ueber diese Weitergabe reicht
    # fuer jedes Muster, das in diesen Suiten wirklich vorkommt.
    if schirme:
        for zeile in lines:
            z = _ZUWEISUNG_RE.match(_ohne_kommentar(zeile))
            if z and any(re.search(r"\$\{?%s\b" % re.escape(sch), z.group(2)) for sch in list(schirme)):
                schirme.add(z.group(1))
    return sicher, aliasse, rumpfzeilen, schirme


def _in_anfuehrung(zeile, pos):
    """Steht diese Stelle innerhalb von Anfuehrungszeichen?"""
    einfach = doppelt = False
    for i, z in enumerate(zeile[:pos]):
        if z == "'" and not doppelt:
            einfach = not einfach
        elif z == '"' and not einfach:
            doppelt = not doppelt
    return einfach or doppelt


def _tmux_aufrufe(zeile, sicher, aliasse, schirme=()):
    """Die tmux-Aufrufe dieser Zeile, je als (befehlstext, unterbefehl, zitiert)."""
    roh = _ohne_kommentar(zeile)
    if "tmux" not in roh and not any(a in roh for a in aliasse):
        return []
    treffer = []
    for teil in _BEFEHLSTRENNER.split(roh):
        if not teil or not teil.strip():
            continue
        if _TMUX_SUCHE.search(teil):
            continue
        woerter = teil.strip().split()
        k = 0
        while k < len(woerter):
            w = woerter[k].strip('"\'')
            if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w) or w in TMUX_VORSPANN:
                k += 1
                continue
            break
        if k >= len(woerter):
            continue
        kopf = woerter[k].strip('"\'')
        name = kopf.lstrip("$").strip("{}")
        basis = name.rsplit("/", 1)[-1]
        if basis in sicher or name in sicher:
            continue
        if basis != "tmux" and name not in aliasse:
            continue
        rest = " ".join(woerter[k + 1:])
        if _SOCKET_FLAGGE.search(rest):
            continue
        # Laeuft der Aufruf unter einem PATH-Schirm dieser Datei?
        if any(re.search(r"PATH=[^\s]*\$\{?%s\b" % re.escape(sch), teil) for sch in schirme):
            continue
        unterbefehl = ""
        for w in woerter[k + 1:]:
            w = w.strip('"\'').rstrip(",.;:!?")
            if w.startswith("-"):
                continue
            unterbefehl = w
            break
        # PROSA-FILTER. In diesen Dateien steht viel deutscher Fliesstext, in dem das
        # Wort "tmux" vorkommt -- in Kommentaren, in Meldungen, in Zeichenketten, die
        # `echo` ausgibt. Folgt darauf kein echter Unterbefehl, war es ein Satz und
        # kein Aufruf. GRENZE, offen benannt: ein Aufruf, dessen Unterbefehl aus einer
        # Variablen kommt (`tmux $CMD ...`), faellt damit ebenfalls heraus. Beides
        # laesst sich hier nicht auseinanderhalten, und ein Hagel von Falsch-Positiven
        # erzieht zum Wegsehen -- dann findet auch der echte Befund niemanden mehr.
        if unterbefehl not in TMUX_UNTERBEFEHLE:
            continue
        zitiert = _in_anfuehrung(roh, roh.find(kopf) if kopf in roh else 0)
        treffer.append((teil.strip(), unterbefehl, zitiert))
    return treffer


def _docstring_zeilen(path, lines):
    """Zeilennummern, die in einer .py-Datei innerhalb eines dreifach zitierten
    Textblocks liegen. Der Kopfkommentar von test-knopf-tastendruck.py erklaert
    woertlich, warum der direkte Tastenweg dort NICHT taugt -- ohne diese Ausnahme
    meldete die Pruefung ausgerechnet diese Erklaerung als Verstoss."""
    if not path.endswith(".py"):
        return set()
    drin, marke, treffer = False, "", set()
    for nr, zeile in enumerate(lines, 1):
        rest = zeile
        while rest:
            if not drin:
                pos3, pos1 = rest.find('"""'), rest.find("'''")
                kandidaten = [x for x in (pos3, pos1) if x >= 0]
                if not kandidaten:
                    break
                pos = min(kandidaten)
                marke = rest[pos:pos + 3]
                drin = True
                rest = rest[pos + 3:]
            else:
                treffer.add(nr)
                pos = rest.find(marke)
                if pos < 0:
                    break
                drin = False
                rest = rest[pos + 3:]
        if drin:
            treffer.add(nr)
    return treffer


# Der eine Weg, eine Datei stillzulegen -- und zwar SCHRIFTLICH, in ihr selbst.
# Dieselbe Bauart wie 'NICHT INSTALLIERT:' in check7: keine Ausnahmeliste in einer
# Konfiguration, die niemand mehr liest, sondern ein Satz im Kopf der Datei, den der
# Naechste sieht, wenn er sie oeffnet. Eine Suite darf den Live-Server absichtlich
# LESEN (test-context-guard-live-socket-unberuehrt.sh ist genau dafuer da) -- dann
# gehoert der Grund dorthin, wo er gebraucht wird.
LIVE_ABSICHT_RE = re.compile(r"LIVE-SOCKET ABSICHTLICH:\s*\S", re.I)


def check8_test_socket(cfg, base):
    c8 = cfg.get("check8_test_socket")
    if not c8:
        return []
    praefix = c8.get("live_session_prefix", "wb-")
    findings = []
    for path in expand_globs(c8["test_globs"], c8.get("exclude_substrings", ())):
        lines = read_lines(path)
        if not lines:
            continue
        # Eine Datei, die TMUX_TMPDIR setzt, hat ihren Server ohnehin umgelenkt.
        if any(re.search(r"\bTMUX_TMPDIR\s*=", _ohne_kommentar(l)) for l in lines):
            continue
        # Sagt die Datei in ihrem Kopf selbst, dass der Live-Server gemeint ist?
        if LIVE_ABSICHT_RE.search("\n".join(lines[:40])):
            continue
        sicher, aliasse, rumpfzeilen, schirme = _huellen_sammeln(lines)
        textzeilen = _docstring_zeilen(path, lines)
        for nr, zeile in enumerate(lines, 1):
            if nr in rumpfzeilen or nr in textzeilen:
                continue
            for befehl, unterbefehl, zitiert in _tmux_aufrufe(zeile, sicher, aliasse, schirme):
                schreibt = unterbefehl in TMUX_SCHREIB_VERBEN
                nennt_live = praefix in befehl
                # In einer Zeichenkette ist ein Befehl nicht zwingend einer: die
                # Guard-Suiten reichen Befehlszeilen als PRUEFDATEN weiter und fuehren
                # sie nie aus (hooks/tests/test-hooks.sh haelt `tmux kill-session -t
                # =wb-...` als Fall vor, den der Guard ablehnen SOLL). Von aussen sind
                # Datum und Tat hier nicht zu unterscheiden, also faellt der Zweifel
                # auf die leise Seite: gemeldet wird, aber nur als Hinweis.
                if schreibt and nennt_live and not zitiert:
                    findings.append(Finding(
                        "TEST-LIVE-SOCKET", path, nr,
                        "ruft `tmux %s` ohne -L/-S und nennt dabei den Live-Praefix "
                        "'%s': %s" % (unterbefehl or "?", praefix, befehl[:160]),
                        "das trifft den Standard-Server, auf dem der Nutzer arbeitet. Genau "
                        "diese Klasse Fehler hat am 04.08. dem Orchestrator eine Anweisung "
                        "untergeschoben. Ein Test gehoert auf einen eigenen Socket "
                        "(tmux -L wbtest-<name>-$$).",
                        severity="error"))
                else:
                    findings.append(Finding(
                        "TEST-SOCKET-OFFEN", path, nr,
                        "ruft tmux ohne -L/-S und ohne TMUX_TMPDIR%s%s: %s"
                        % (" (%s)" % unterbefehl if unterbefehl else "",
                           " -- steht in einer Zeichenkette, kann also auch Pruefdatum sein"
                           if zitiert else "", befehl[:160]),
                        "damit landet der Aufruf auf dem Standard-Server. Lesend ist das "
                        "manchmal Absicht (eine Probe, die die Live-Sitzung gerade NICHT "
                        "anfassen soll); schreibend ist es der Fehler vom 04.08. Nachsehen "
                        "und entweder auf einen eigenen Socket legen oder im Kopf der Datei "
                        "sagen, warum der Live-Server hier gemeint ist.",
                        severity="hint"))
    return findings


# --------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--base", default=os.path.expanduser("~"))
    ap.add_argument("--repo", default=os.path.expanduser("~/AI/claude-workbench"),
                    help="Arbeitsbaum der Werkbank ({REPO} in der Konfiguration)")
    ap.add_argument("--config", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "wb-consistency.config.json"))
    args = ap.parse_args()

    cfg = load_config(args.config, args.base, args.repo)

    all_findings = []
    all_findings += check1_model_caps(cfg, args.base)
    all_findings += check2_generated_blocks(cfg, args.base)
    all_findings += check3_dangling_refs(cfg, args.base)
    all_findings += check4_skill_vs_rules(cfg, args.base)
    all_findings += check5_config_claims(cfg, args.base)
    all_findings += check6_settings_switches(cfg, args.base)
    all_findings += check7_kopien(cfg, args.base)
    all_findings += check8_test_socket(cfg, args.base)

    if not args.quiet:
        for f in all_findings:
            print(f.render())

    errors = [f for f in all_findings if f.severity == "error"]
    hints = [f for f in all_findings if f.severity == "hint"]
    expected = [f for f in all_findings if f.severity == "expected"]

    n = len(errors)
    by_check = {}
    for f in errors:
        by_check[f.check] = by_check.get(f.check, 0) + 1
    summary_parts = ", ".join(f"{k}={v}" for k, v in sorted(by_check.items()))
    hint_suffix = f" (+{len(hints)} Hinweis(e), zaehlen nicht als Fehler)" if hints else ""
    expected_suffix = (
        f" (+{len(expected)} auf anderer Maschine erwartet, zaehlen nicht als Fehler)" if expected else ""
    )
    if n == 0:
        print(f"wb-consistency: 0 Abweichungen -- sauber.{hint_suffix}{expected_suffix}")
    else:
        print(f"wb-consistency: {n} Abweichung(en) -- {summary_parts}{hint_suffix}{expected_suffix}")

    return 1 if n else 0


if __name__ == "__main__":
    sys.exit(main())
