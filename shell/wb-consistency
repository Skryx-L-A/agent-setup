                "WERKZEUG-AUSSAGE", erste, 1,
                "`%s.%s` steht in %d Ablagen verschieden" % (hid, feld, len(werte)),
                "eine gemessene Tatsache ueber ein Werkzeug hat keine zwei Fassungen: %s" % wo))


def _sorte_c(c7, findings):
    # Vokabular AUS DER KONFIGURATION. Ohne Muster wird nicht geraten, sondern
    # nichts geprueft -- eine stumme Pruefung ist ehrlicher als eine, die sich
    # ihre Suchbegriffe selbst ausdenkt.
    muster = [re.compile(p) for p in c7.get("marker_patterns", [])]
    bez_pat = c7.get("identifier_pattern")
    if not muster or not bez_pat:
        return
    bez_re = re.compile(bez_pat)
    test_text = ""
    for pat in c7.get("test_globs", []):
        for p in expand_globs([pat]):
            test_text += "\n" + "\n".join(read_lines(p))
    for pat in c7.get("marker_globs", []):
        for p in expand_globs([pat], c7.get("exclude_substrings", ())):
            if not _ist_code(p):
                continue          # Datendateien tragen keine doppelte Implementierung
            zeilen = read_lines(p)
            for i, zeile in enumerate(zeilen, 1):
                if not any(m.search(zeile) for m in muster):
                    continue
                # Der Bezeichner kann auf der Markerzeile oder der naechsten stehen.
                block = zeile + " " + (zeilen[i] if i < len(zeilen) else "")
                for bez in set(bez_re.findall(block)):
                    if bez in test_text:
                        continue
                    findings.append(Finding(
                        "DOPPELUNG-OHNE-TEST", os.path.relpath(p, c7["repo_dir"]), i,
                        "meldet eine bewusste Doppelung an (`%s`)" % bez,
                        "kein Test nennt `%s` -- die angemeldete Gleichhaltung prueft "
                        "niemand nach. Die uebrigen angemeldeten Doppelungen des Hauses "
                        "haben je einen Vergleichstest." % bez))


