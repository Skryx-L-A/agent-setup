#   * die Musterliste war umgezogen, der Zeiger blieb stehen.
#   * `run-all.sh` faehrt `~/.claude/hooks/tests/`, gepflegt wurde das Repo.
# Dieselbe Klasse wie die sieben toten Schalter aus Check 6, eine Ebene hoeher.
#
# Drei Sorten, jede mit einer Regel, die aus der SACHE folgt statt aus einer Liste:
#
#   A INSTALLIERT GEGEN REPO. Was in `shell/` liegt, gehoert nach `~/.local/bin`;
#     was in `hooks/` liegt, nach `~/.claude/hooks` (mit Unterverzeichnissen).
#     WELCHE Dateien verglichen werden, sagt nicht eine Liste, sondern der
#     Zielort: verglichen wird, was dort SCHON LIEGT. Damit traegt sich die
#     Pruefung selbst fort -- eine neue Datei faellt beim ersten Ausrollen in die
#     Menge und bleibt drin. Eine Datei, die nur im Repo lebt, wird gemeldet, bis
#     sie den Grund dafuer SELBST traegt (Zeile `NICHT INSTALLIERT: <warum>` in
#     ihrem Kopf) -- die Begruendung gehoert an die Datei, nicht in eine
#     Ausnahmeliste im Pruefwerkzeug.
#
#   B WERKZEUG-AUSSAGEN. `shell/models.default.json` (Auslieferung), die echte
#     `models.json` (gepflegt) und die eingebauten Adapter im Code von `wb-state`
#     duerfen sich in den MODELLEN unterscheiden -- die echte traegt 86, die
#     Vorlage 15. Was sie nicht duerfen, sind die Aussagen ueber ein WERKZEUG:
#     wie es Effort annimmt, woran man erkennt, dass es bereit ist, wie es
#     fortsetzt. Diese Felder sind gemessene Tatsachen, und eine Tatsache hat
#     keine zwei Fassungen.
#
#   C BEWUSSTE DOPPELUNGEN OHNE PARITAETSTEST. Das Haus meldet gewollte Kopien
#     im Text an, in einer festen Wendung, die auf die jeweils andere Stelle
#     zeigt und zusagt, beide gleichzuhalten. Genau diese Anmeldung ist die
#     Regel: wer sie schreibt, verspricht etwas, und ein Versprechen braucht
#     einen Test. Gemeldet wird der angemeldete Bezeichner, den KEIN Test nennt.
#
#     DIE WENDUNG SELBST STEHT NICHT HIER, sondern in der Konfiguration
#     (`marker_patterns`). Sie stand bis zum 2026-08-06 als Regex im Quelltext,
#     und der Kommentar darueber erklaerte sie, indem er sie WOERTLICH zitierte
#     -- damit passte der Erkenner auf seine eigene Beschreibung und meldete
#     diese Datei. Das ist die Hausregel, die in den Koepfen der Suiten steht:
#     ein Erkenner darf nicht auf seine eigene Beschreibung passen. Der Ausweg
#     ist derselbe wie bei den Secret-Mustern -- was ein Erkenner SUCHT, gehoert
#     in eine externe Konfiguration, nicht in seinen Quelltext. Eine Ausnahme
#     fuer die eigene Datei waere der falsche Weg gewesen: ein Filter nimmt sich
#     nie selbst von seiner Pruefung aus.
#
#     Aus demselben Grund werden nur CODE-Dateien nach Anmeldungen durchsucht.
#     Eine Datendatei (.json) traegt keine Doppelung einer Implementierung, wohl
#     aber -- als Konfiguration eines Erkenners -- dessen Vokabular. Das gilt
#     fuer jede Datendatei gleich und ist keine Regel ueber eine bestimmte.

NICHT_INSTALLIERT_RE = re.compile(r"NICHT[ _-]INSTALLIERT\s*:\s*(\S.*)")
NICHT_VERSIONIERT_RE = re.compile(r"NICHT[ _-]VERSIONIERT\s*:\s*(\S.*)")


def _installationsziel(rel, c7):
    """Wohin diese Repo-Datei gehoert, oder None. Aus dem VERZEICHNIS abgeleitet,
    nicht aus einer Paarliste -- eine Paarliste veraltet, ein Verzeichnis nicht."""
    for prefix, ziel in c7["install_map"]:
        if rel.startswith(prefix):
            return os.path.join(ziel, rel[len(prefix):])
    return None


def _installiert_richtung(repo_datei, inst_datei, repo_dir):
    """'veraltet' (Ausrollen vergessen) oder 'eigenmaechtig' (jemand hat an der
    installierten Kopie gearbeitet) -- und woher wir das wissen.

    Der belastbare Weg fuehrt ueber git: entspricht der installierte Inhalt IRGEND
    EINEM frueheren Stand der Repo-Datei, dann ist er ein alter Stand, Punkt. Passt
    er zu keinem, hat diesen Inhalt nie ein Commit getragen -- dann wurde an der
    installierten Kopie gearbeitet, und das ist die gefaehrlichere Richtung, weil
    die Arbeit beim naechsten Ausrollen verschwindet.

    Ohne git bleibt die Aenderungszeit, und die ist nur ein Hinweis: sie wird
    entsprechend gekennzeichnet."""
    try:
        inhalt = open(inst_datei, "rb").read()
    except OSError:
        return "unklar", "installierte Datei nicht lesbar"
    rel = os.path.relpath(repo_datei, repo_dir)
    try:
        shas = subprocess.run(["git", "-C", repo_dir, "log", "--format=%H", "-40", "--", rel],
                              capture_output=True, text=True, timeout=20).stdout.split()
    except Exception:
        shas = []
    for sha in shas:
        try:
            alt = subprocess.run(["git", "-C", repo_dir, "show", "%s:%s" % (sha, rel)],
                                 capture_output=True, timeout=20)
        except Exception:
            break
        if alt.returncode == 0 and alt.stdout == inhalt:
            return "veraltet", "der installierte Inhalt ist der Repo-Stand von %s" % sha[:9]
    if shas:
        return "eigenmaechtig", ("dieser Inhalt stand in keinem der letzten %d Commits "
                                 "dieser Datei" % len(shas))
    try:
        neuer = os.path.getmtime(inst_datei) > os.path.getmtime(repo_datei)
    except OSError:
        return "unklar", "Zeitstempel nicht lesbar"
    return ("eigenmaechtig" if neuer else "veraltet"), "nur nach Aenderungszeit geschlossen"


def _ziel_fuer(rel, name, c7):
    """Der Zielort dieser Datei, aus dem Verzeichnis UND dem Dateinamen abgeleitet.

    Ein Eintrag der install_map ist [prefix, ziel] oder [prefix, ziel, muster].
    Der erste passende gewinnt, deshalb stehen engere Eintraege zuerst. Das
    Muster ist noetig, weil nicht jede Datei EINES Verzeichnisses am selben Ort
    landet: `shell/*.plist` gehoert nach ~/Library/LaunchAgents, alles andere aus
    `shell/` nach ~/.local/bin. Ohne diese Unterscheidung meldete die Pruefung
    zwei launchd-Dateien als 'liegt nur im Repo', obwohl sie sehr wohl
    installiert sind -- nur eben dort, wo launchd sie sucht (gemessen 2026-08-06)."""
    for eintrag in c7["install_map"]:
        prefix, ziel = eintrag[0], eintrag[1]
        muster = eintrag[2] if len(eintrag) > 2 else None
        if not rel.startswith(prefix):
            continue
        if muster and not fnmatch.fnmatch(name, muster):
            continue
        return ziel
    return None


def _sorte_a(c7, findings):
    repo_dir = c7["repo_dir"]
    gesehen = set()
    for prefix, ziel_unbenutzt in [(e[0], e[1]) for e in c7["install_map"]]:
        wurzel = os.path.join(repo_dir, prefix)
        if not os.path.isdir(wurzel):
            continue
        for name in sorted(os.listdir(wurzel)):
            repo_datei = os.path.join(wurzel, name)
            if not os.path.isfile(repo_datei):
                continue
            if any(ex in repo_datei for ex in c7.get("exclude_substrings", ())):
                continue
            rel = os.path.join(prefix, name)
            if rel in gesehen:
                continue
            gesehen.add(rel)
            ziel = _ziel_fuer(rel, name, c7)
            if ziel is None:
                continue
            inst_datei = os.path.join(ziel, name)
            if not os.path.exists(inst_datei):
                # Traegt die Datei ihre Begruendung selbst? Dann ist sie kein Befund.
                kopf = "\n".join(read_lines(repo_datei)[:40])
                if NICHT_INSTALLIERT_RE.search(kopf):
                    continue
                findings.append(Finding(
                    "KOPIE-NUR-REPO", rel, 1,
                    "liegt nur im Repo",
                    "unter %s liegt nichts. Entweder ausrollen, oder die Datei sagt in "
                    "ihrem Kopf selbst warum nicht: 'NICHT INSTALLIERT: <Begruendung>'."
                    % ziel, severity="hint"))
                continue
            if open(repo_datei, "rb").read() == open(inst_datei, "rb").read():
                continue
            richtung, warum = _installiert_richtung(repo_datei, inst_datei, repo_dir)
            if richtung == "veraltet":
                findings.append(Finding(
                    "KOPIE-VERALTET", rel, 1,
                    "Repo und %s sind verschieden" % inst_datei,
                    "die INSTALLIERTE Fassung ist ein alter Stand (%s) -- Ausrollen "
                    "vergessen. Die Suiten fahren teils die installierte Fassung, also "
                    "faellt das erst im Gesamtlauf auf." % warum))
            elif richtung == "eigenmaechtig":
                findings.append(Finding(
                    "KOPIE-EIGENMAECHTIG", rel, 1,
                    "Repo und %s sind verschieden" % inst_datei,
                    "die INSTALLIERTE Fassung traegt Inhalt, den das Repo nicht kennt "
                    "(%s) -- jemand hat an der installierten Kopie gearbeitet. Beim "
                    "naechsten Ausrollen ist diese Arbeit weg." % warum))
            else:
                findings.append(Finding(
                    "KOPIE-VERSCHIEDEN", rel, 1,
                    "Repo und %s sind verschieden" % inst_datei,
                    "Richtung nicht bestimmbar (%s)." % warum))


def _harness_liste(quelle):
    try:
        if quelle.endswith(".json"):
            return json.load(open(quelle)).get("harnesses") or []
        # Die eingebauten Adapter stehen als Python-Literal im Code von wb-state.
        m = re.search(r"^BUILTIN_HARNESSES = (\[.*?^\])", open(quelle, errors="replace").read(),
                      re.S | re.M)
        return ast.literal_eval(m.group(1)) if m else []
    except Exception:
        return []


