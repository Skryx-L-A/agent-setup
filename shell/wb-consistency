RANK = {"low": 0, "medium": 1, "high": 2, "xhigh": 3, "max": 4}


def load_config(path, base, repo=None):
    """{BASE} ist das Heimatverzeichnis, {REPO} der Arbeitsbaum der Werkbank.

    Zwei Platzhalter, weil zwei verschiedene Baeume geprueft werden: die Regel-
    und Werkzeugdateien liegen unter $HOME (installiert), der QUELLTEXT der
    Oberflaeche und der Skripte liegt im Repo. Check 6 braucht den Quelltext --
    ein Schalter ist tot oder lebendig im Code, nicht in der Installation.
    Beide sind ueber die Kommandozeile umlenkbar, damit ein Test seine eigene
    Kopie pruefen kann und nie den echten Baum."""
    with open(path, "r") as f:
        raw = f.read()
    raw = raw.replace("{BASE}", base)
    raw = raw.replace("{REPO}", repo or os.path.expanduser("~/AI/claude-workbench"))
    return json.loads(raw)


MAX_SCAN_BYTES = 2_000_000  # rule/comment files are KB-sized; this excludes compiled binaries/bundles


def is_probably_text(path):
    try:
        if os.path.getsize(path) > MAX_SCAN_BYTES:
            return False
        with open(path, "rb") as f:
            chunk = f.read(8192)
        return b"\x00" not in chunk
    except OSError:
        return False


def expand_globs(patterns, exclude_substrings=()):
    files = []
    seen = set()
    for pat in patterns:
        for p in globmod.glob(pat, recursive=True):
            if not os.path.isfile(p):
                continue
            if any(ex in p for ex in exclude_substrings):
                continue
            if p in seen:
                continue
            if not is_probably_text(p):
                continue
            seen.add(p)
            files.append(p)
    return sorted(files)


def read_lines(path):
    try:
        with open(path, "r", errors="replace") as f:
            return f.read().splitlines()
    except OSError:
        return []


COMMENT_RE = re.compile(r"^(\s*)#+ ?(.*)$")


def strip_comment_markers(lines):
    """Kommentarzeichen aus einer NICHT-Markdown-Datei entfernen, damit der Text
    darin wie Prosa gelesen werden kann.

    Warum das noetig ist (gemessen 2026-08-06): die Scan-Liste enthaelt
    `{BASE}/.local/bin/*`, also die installierten Skripte -- und genau dort stehen
    die meisten Cap-Behauptungen, als Kommentar im Kopf von `claude-worker`. Die
    Blockbildung hielt jede Zeile, die mit '#' beginnt, fuer eine
    Markdown-UEBERSCHRIFT und begann bei jeder einen neuen Block. Eine Behauptung,
    die sich ueber zwei Kommentarzeilen zieht --

        #   fable5   ... Effort cap
        #            `high` (raised from medium)

    -- zerfiel damit in zwei Bloecke, und der Modellname stand nie im selben Block
    wie der Wert. Zusaetzlich haette das '#' zwischen 'cap' und '`high`' das Muster
    gebrochen, das nur Leerraum dazwischen erlaubt. Die Pruefung war also
    vorhanden und still blind, und zwar ausgerechnet fuer die Dateiart, in der die
    Werkbank ihre Caps am haeufigsten behauptet.

    Nur fuer Dateien ohne `.md`: in Markdown IST '#' eine Ueberschrift, und die
    Blockbildung daran ist richtig."""
    out = []
    for line in lines:
        m = COMMENT_RE.match(line)
        out.append(m.group(1) + m.group(2) if m else line)
    return out


class Finding:
    def __init__(self, check, file, line, claim, truth, severity="error"):
        self.check = check
        self.file = file
        self.line = line
        self.claim = claim
        self.truth = truth
        self.severity = severity  # "error" (counts toward exit 1), "hint" (informational only,
        # unresolved ambiguity -- still needs a human read) or "expected" (informational only,
        # resolved for certain by check3's machine_tool_map -- no ambiguity left)

    def render(self):
        return f"{self.file}:{self.line}: [{self.check}] behauptet: {self.claim} -- Wahrheit: {self.truth}"


# --------------------------------------------------------------------------
# Check 1 -- model effort caps: registry vs. everywhere else
# --------------------------------------------------------------------------

# "max" is itself a valid cap value AND the filler word in the phrase "max
# effort = ..." -- the lookahead keeps that filler from being misread as a
# claimed value.
CAP_VALUE = r"(?:low|medium|high|xhigh|max)(?!\s*effort)"

# Each pattern requires the value to sit directly next to an explicit cap
# keyword/connector -- no loose "somewhere nearby" windows, those produced
# false positives on prose that merely mentions "Effort-Cap" and "max" in
# the same sentence without asserting a value for a specific model.
CAP_CLAIM_PATTERNS = [
    re.compile(rf"max\s*effort\s*=\s*`?(?P<cap>{CAP_VALUE})`?", re.I),
    re.compile(rf"\bcap\s*`?(?P<cap>{CAP_VALUE})`?\b", re.I),
    re.compile(rf"gedeckelt\s+auf\s+`?(?P<cap>{CAP_VALUE})`?", re.I),
    re.compile(rf"auf\s+`?(?P<cap>{CAP_VALUE})`?\s+gedeckelt", re.I),
    re.compile(rf"auf\s+`?(?P<cap>{CAP_VALUE})`?\s+angehoben", re.I),
]

HISTORICAL_PREFIX = re.compile(r"(von|from)\s*$", re.I)


def build_model_variants(registry_models, extra_variants):
    """model_alias -> sorted list of (variant_text) longest first."""
    variants = {}
    for m in registry_models:
        alias = m.get("alias")
        if not alias:
            continue
        vs = {alias}
        vs.update(extra_variants.get(alias, []))
        variants[alias] = sorted(vs, key=len, reverse=True)
    return variants


def starts_with_label(line, labels):
    """Beginnt diese Zeile mit einem Modellnamen als LABEL? (2026-08-06)

    Die Routing-Liste im Kopf von `claude-worker` ist eine Spaltenliste ohne
    Aufzaehlungszeichen: links der Name, rechts die Prosa, und die Prosa laeuft
    ueber mehrere Zeilen weiter.

        haiku45:low    mechanical (rename, config tweak, ...)
        fable5         NEVER without explicit word ... Effort cap
                       `high` (raised from medium 2026-07-30).

    Ohne diese Erkennung faellt die ganze Liste in EINEN Block, und die
    Nachbarschaftspruefung paart die Behauptung dann mit dem falschen Modell
    oder mit gar keinem. Ein Name am Zeilenanfang eroeffnet deshalb einen
    Eintrag, genau wie ein Aufzaehlungszeichen.

    Ein Label ist AUSGERICHTET: hinter ihm steht die Spaltenluecke (zwei oder
    mehr Leerzeichen) oder das Zeilenende. Diese Bedingung ist der ganze
    Unterschied zwischen einem Label und einem Satzanfang -- ohne sie eroeffnete
    'Fable 5 liegt (1341 zu 1324, Stand 2026-07-29) ...' aus einer
    Elo-Begruendung einen Eintrag und zerschnitt einen Absatz mitten im Satz
    (gemessen 2026-08-06 an regeln/orchestrierung.md). Ein Effort-Suffix gehoert
    zum Label ('haiku45:low'), ein einzelnes Leerzeichen mit Fliesstext dahinter
    nicht."""
    for lab in labels:
        # \s{2,} = Spaltenluecke, $ = Label allein auf der Zeile.
        if re.match(r"^\s*" + re.escape(lab) + r"(:[A-Za-z]+)?(\s{2,}|$)",
                    line, re.I):
            return True
    return False


def iter_bullet_blocks(lines, label_variants=()):
    """Chunk markdown lines into top-level-bullet blocks (a new block starts
    at a column-0 '-'/'*' bullet or a heading; continuation/nested lines are
    folded in). Yields (start_line_1indexed, joined_text).

    `label_variants` (2026-08-06, nur von check1 benutzt) laesst zusaetzlich eine
    Zeile, die mit einem Modellnamen beginnt, einen Block eroeffnen -- siehe
    starts_with_label. Ohne das Argument ist das Verhalten unveraendert, der
    zweite Aufrufer (check4) bleibt also, wie er war."""
    block_start = None
    block_lines = []

    def flush():
        if block_lines:
            yield_ = (block_start, " ".join(block_lines))
            return yield_
        return None

    blocks = []
    for i, line in enumerate(lines, start=1):
        # allow indented bullets too (nested lists, e.g. "  - **...**") -- a
        # column-0-only check let a whole indented section after a routing
        # table collapse into one giant block and mis-pair unrelated clauses.
        is_new = (bool(re.match(r"^\s*[-*]\s", line)) or bool(re.match(r"^#", line))
                  or starts_with_label(line, label_variants))
        # markdown table rows are DATA (preset/routing tables), not prose claims about
        # a specific model -- fold them out like a blank line so a claim in one row
        # can never get paired with a model name from an unrelated row.
        is_table_row = bool(re.match(r"^\s*\|", line))
        is_blank = not line.strip() or is_table_row
        if is_blank:
            if block_lines:
                blocks.append((block_start, " ".join(block_lines)))
            block_start, block_lines = None, []
            continue
        if is_new:
            if block_lines:
                blocks.append((block_start, " ".join(block_lines)))
            block_start = i
            block_lines = [line.strip()]
        else:
            if block_start is None:
                block_start = i
            block_lines.append(line.strip())
    if block_lines:
        blocks.append((block_start, " ".join(block_lines)))
    return blocks


def find_cap_claims_in_block(text):
    """Return list of (start, end, cap_value), excluding ones that are
    clearly the OLD value in a 'von X ... angehoben' / 'from X' clause."""
    claims = []
    for pat in CAP_CLAIM_PATTERNS:
        for m in pat.finditer(text):
            s, e = m.start("cap"), m.end("cap")
            pre = text[max(0, s - 20):s]
            if HISTORICAL_PREFIX.search(pre):
                continue
            claims.append((s, e, m.group("cap").lower()))
    claims.sort(key=lambda t: t[0])
    return claims


def find_model_mentions(text, variants_by_alias):
    """Return list of (start, end, alias) model mentions, using
    longest-variant priority so a specific variant (e.g. 'ornith-9b') claims
    its span before a shorter bare variant of a different model
    (e.g. 'ornith') can."""
    flat = []
    for alias, vs in variants_by_alias.items():
        for v in vs:
            flat.append((alias, v))
    flat.sort(key=lambda t: len(t[1]), reverse=True)

    claimed = bytearray(len(text))
    found = []
    lower = text.lower()
    for alias, variant in flat:
        pat = re.compile(r"(?<![a-z0-9_])" + re.escape(variant.lower()) + r"(?![a-z0-9_])")
        for m in pat.finditer(lower):
            s, e = m.start(), m.end()
            if any(claimed[s:e]):
                continue
            claimed[s:e] = b"\x01" * (e - s)
            found.append((s, e, alias))
    found.sort(key=lambda t: t[0])
    return found


PROXIMITY_WINDOW = 150
SENTENCE_BOUNDARY = re.compile(r"[.;]\s")


def trim_to_sentence_start(text, hard_start, pos):
    """Move hard_start forward past the last sentence/clause boundary ('. '
    or '; ') inside [hard_start, pos), so a model mentioned in an earlier,
    unrelated sentence can't be pulled into this claim's window just
    because it fits inside the raw character count."""
    last_end = None
    for m in SENTENCE_BOUNDARY.finditer(text, hard_start, pos):
        last_end = m.end()
    return last_end if last_end is not None else hard_start


def pair_claims_with_models(claims, mentions, text, block_label=None):
    """For each cap claim, attribute it to the model mention(s) immediately
    before it (bounded by the previous claim and by the start of the current
    sentence/clause, so 'fable ... = high; opus5 ... = xhigh' doesn't leak
    fable into opus5's window, and an unrelated model named in the previous
    sentence doesn't leak into this one), falling back to mentions
    immediately after if none precede. A claim with no nearby model mention
    at all is dropped rather than guessed at."""
    pairs = []  # (alias, cap_value)
    for i, (cstart, cend, cap) in enumerate(claims):
        window_start = max(cstart - PROXIMITY_WINDOW, claims[i - 1][1] if i > 0 else 0)
        window_start = trim_to_sentence_start(text, window_start, cstart)
        before = [a for (s, e, a) in mentions if window_start <= s and e <= cstart]
        if before:
            for a in before:
                pairs.append((a, cap))
            continue
        next_claim_start = claims[i + 1][0] if i + 1 < len(claims) else cend + PROXIMITY_WINDOW
        window_end = min(cend + PROXIMITY_WINDOW, next_claim_start)
        after = [a for (s, e, a) in mentions if cend <= s and e <= window_end]
        if after:
            for a in after:
                pairs.append((a, cap))
            continue
        # LETZTER Rueckfall (2026-08-06): steht am ANFANG des Blocks ein Modellname
        # als Label, ist er der Gegenstand des ganzen Eintrags -- auch ueber
        # Satzgrenzen hinweg. Die Fenster- und Satzpruefungen oben sind fuer
        # Fliesstext gebaut und schneiden bei
        #     fable5   NEVER without explicit word, for any task. Effort cap `high`
        # genau vor 'Effort cap' ab, wodurch der Name aus dem Fenster faellt und die
        # Behauptung verworfen wird. In einer Spaltenliste ist das falsch: die Zeile
        # HANDELT von fable5, ganz gleich wie viele Saetze dazwischenstehen. Nur als
        # Rueckfall, damit ein naeher stehender Name weiterhin gewinnt.
        if block_label:
            pairs.append((block_label, cap))
    return pairs


def check1_model_caps(cfg, base):
    # Fehlt der Konfigurationsblock, wird diese Pruefung UEBERSPRUNGEN statt
    # abzustuerzen (2026-08-06). Die neueren Checks halten es schon so, und
    # eine Teilkonfiguration ist ein legitimer Fall: ein Test richtet genau
    # eine Pruefung auf sein Spielfeld und laesst die uebrigen weg.
    c1 = cfg.get("check1_model_caps")
    if not c1:
        return []
    registry_path = c1["registry_path"]
    findings = []
    try:
        with open(registry_path) as f:
            registry = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        return [Finding("MODELL-CAPS", registry_path, 0,
                         "Registry lesbar", f"Registry nicht lesbar/kaputt: {e}")]

    models = registry.get("models", [])
    truth = {m["alias"]: m.get("maxEffort") for m in models if m.get("alias")}
    variants = build_model_variants(models, c1.get("extra_model_name_variants", {}))
    # Flache Liste aller Schreibweisen, laengste zuerst -- die Blockbildung fragt
    # damit, ob eine Zeile mit einem Modellnamen ANFAENGT.
    alle_varianten = sorted({v for vs in variants.values() for v in vs},
                            key=len, reverse=True)

    files = expand_globs(c1["scan_globs"], c1.get("exclude_substrings", ()))
    files = [f for f in files if os.path.abspath(f) != os.path.abspath(registry_path)]

    for path in files:
        lines = read_lines(path)
        if not lines:
            continue
        if not path.endswith(".md"):
            lines = strip_comment_markers(lines)
        for start_line, block_text in iter_bullet_blocks(lines, alle_varianten):
            mentions = find_model_mentions(block_text, variants)
            if not mentions:
                continue
            claims = find_cap_claims_in_block(block_text)
            if not claims:
                continue
            # Ein Modellname GANZ AM ANFANG des Blocks ist sein Label (Spaltenliste).
            block_label = next((a for (s, _e, a) in mentions if s == 0), None)
            for alias, claimed_cap in pair_claims_with_models(claims, mentions,
                                                              block_text, block_label):
                real_cap = truth.get(alias)
                if real_cap is None:
                    continue
                if claimed_cap != real_cap:
                    findings.append(Finding(
                        "MODELL-CAPS", path, start_line,
                        f"`{alias}` max effort = `{claimed_cap}`",
                        f"Registry ({registry_path}) sagt maxEffort=`{real_cap}` fuer {alias}",
                    ))
    return findings


# --------------------------------------------------------------------------
# Check 2 -- generated blocks: content/hash drift + double-loaded duplicates
# --------------------------------------------------------------------------

BLOCK_RE = re.compile(r"<!--\s*([\w:.\-]+):start\s*-->(.*?)<!--\s*\1:end\s*-->", re.S)
HASH_RE = re.compile(r"SHA-256=([0-9a-fA-F]+)")


def normalize_block(text):
    return "\n".join(line.rstrip() for line in text.strip("\n").splitlines())


def file_matches_group(path, group_files):
    for pat in group_files:
        if os.path.abspath(path) in (os.path.abspath(p) for p in globmod.glob(pat, recursive=True)):
            return True
    return False


def check2_generated_blocks(cfg, base):
    # Fehlt der Konfigurationsblock, wird diese Pruefung UEBERSPRUNGEN statt
    # abzustuerzen (2026-08-06). Die neueren Checks halten es schon so, und
    # eine Teilkonfiguration ist ein legitimer Fall: ein Test richtet genau
    # eine Pruefung auf sein Spielfeld und laesst die uebrigen weg.
    c2 = cfg.get("check2_generated_blocks")
    if not c2:
        return []
    findings = []
    files = expand_globs(c2["scan_globs"], c2.get("exclude_substrings", ()))

    # marker -> list of dicts: file, line, content, hash
    occurrences = {}
    for path in files:
        try:
            with open(path, "r", errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        for m in BLOCK_RE.finditer(text):
            marker = m.group(1)
            block = m.group(2)
            line = text[:m.start()].count("\n") + 1
            hm = HASH_RE.search(block)
            occurrences.setdefault(marker, []).append({
                "file": path,
                "line": line,
                "content": normalize_block(block),
                "hash": hm.group(1) if hm else None,
            })

    groups = c2.get("session_load_groups", [])

    for marker, occs in occurrences.items():
        # Only markers that carry a declared generator hash are meant to be a
        # byte-identical copy distributed from one source (per spec: "tragen
        # einen Generator-Hash im Kommentar"). A marker without one (e.g. a
        # per-file gardener block) is not a synced copy and comparing it
        # across files would just flag every project's own MOC against
        # every other project's own MOC.
        occs = [o for o in occs if o["hash"]]
        if len(occs) < 2:
            continue
        for i in range(len(occs)):
            for j in range(i + 1, len(occs)):
                a, b = occs[i], occs[j]
                if a["file"] == b["file"]:
                    continue
                same_content = a["content"] == b["content"]
                same_hash = a["hash"] == b["hash"]
                if not (same_content and same_hash):
                    findings.append(Finding(
                        "GENERIERTE-BLOECKE", a["file"], a["line"],
                        f"Block '{marker}' (hash={a['hash']})",
                        f"weicht ab von {b['file']}:{b['line']} (hash={b['hash']})",
                    ))
                if same_content:
                    for grp in groups:
                        if file_matches_group(a["file"], grp["files"]) and file_matches_group(b["file"], grp["files"]):
                            findings.append(Finding(
                                "GENERIERTE-BLOECKE-DOPPELT", a["file"], a["line"],
                                f"Block '{marker}' identisch auch in {b['file']}:{b['line']}",
                                f"beide Dateien laden in derselben Session ({grp['name']}) -- doppelt geladen, doppelt bezahlt",
                            ))
    return findings


# --------------------------------------------------------------------------
# Check 3 -- backticked command names that resolve nowhere
# --------------------------------------------------------------------------

FENCE_RE = re.compile(r"^\s*```")
INLINE_CODE_RE = re.compile(r"`([^`\n]+)`")
COMMAND_TOKEN_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]{1,40}$")


LABEL_PREFIX_RE = re.compile(r"([A-Za-zäöüÄÖÜ]+)\s*\(?\s*$")


def candidate_command(span):
    span = span.strip()
    if not span:
        return None
    parts = span.split(None, 1)
    token = parts[0]
    has_args = len(parts) > 1
    has_hyphen = "-" in token
    if not (has_hyphen or has_args):
        return None
    if not COMMAND_TOKEN_RE.match(token):
        return None
    if token.upper() == token and len(token) > 1:
        # looks like an ENV VAR (e.g. PROJECT), not a command
        return None
    return token


def build_search_path(extra_path_dirs):
    """PATH fuer die which()-Suche unten: die echten Verzeichnisse des
    Prozesses PLUS die konfigurierten extra_path_dirs vorneweg.

    Befund 2026-08-10: `wb-consistency` laeuft ueber den woechentlichen
    launchd-Job (siehe hooks/sessionstart-hygiene-status.sh), und launchd
    startet ohne Login-Shell -- das Standard-PATH dort ist nur
    /usr/bin:/bin:/usr/sbin:/sbin, ohne /opt/homebrew/bin. `tmux`, `ollama`,
    `npm`, `uv`, `llama-server`, `llama-bench`, `rsvg-convert` und `pi` liegen
    aber alle unter /opt/homebrew/bin (Apple Silicon Homebrew) -- 30 der 31
    gemeldeten VERWEIS-INS-LEERE-Befunde vom selben Tag waren dieser eine
    fehlende Ordner, nicht 30 verschiedene kaputte Regeldateien. Die Liste
    kommt aus der Konfiguration (extra_path_dirs), nicht hartkodiert im Code
    -- gleiches Prinzip wie tool_dirs/skill_dirs/machine_tool_map oben, ein
    Pruefer haelt seine Ausnahmen extern (2026-08-03 Regel).
    os.environ["PATH"] wird nur gelesen, nie veraendert -- ein anderer Check
    in diesem Lauf soll die echte Prozessumgebung nicht anders vorfinden."""
    real_path = os.environ.get("PATH", "")
    return os.pathsep.join([d for d in extra_path_dirs if d] + ([real_path] if real_path else []))


def tool_exists(name, tool_dirs, skill_dirs, registry_ids, search_path=None):
    for d in tool_dirs:
        # hooks are named in prose by their base name ("bash-guard-kill-pattern"),
        # the file on disk carries a .sh suffix -- try both before giving up.
        if os.path.isfile(os.path.join(d, name)) or os.path.isfile(os.path.join(d, name + ".sh")):
            return True
    for d in skill_dirs:
        if os.path.isfile(os.path.join(d, name, "SKILL.md")):
            return True
    if name in registry_ids:
        return True
    return shutil.which(name, path=search_path) is not None


def load_registry_identifiers(registry_path):
    """Model ids/aliases/modelRefs referenced in prose (e.g. `claude-opus-5`)
    are data identifiers, not filesystem tools -- don't flag them as
    dangling refs just because they aren't in PATH."""
    ids = set()
    try:
        with open(registry_path) as f:
            registry = json.load(f)
    except (OSError, json.JSONDecodeError):
        return ids
    for m in registry.get("models", []):
        for key in ("id", "alias", "modelRef"):
            v = m.get(key)
            if v:
                ids.add(v)
    return ids


def label_precedes(line, span_start):
    """True if the text right before this backtick span looks like a label
    ('Service `wb-gmail`', 'Dienst `foo`') rather than an invocation --
    those name an identifier, they don't call a tool."""
    pre = line[:span_start]
    m = LABEL_PREFIX_RE.search(pre)
    return m


def current_machine_id(c3):
    """Which machine is THIS process running on, as one of the ids used in
    machine_tool_map (config, not code -- 2026-08-03 self-exemption rule).
    WB_CONSISTENCY_MACHINE_ID overrides for tests, so the test fixture can
    exercise both directions (this-machine / other-machine) from a single
    real machine without SSH, without touching peer, and without faking
    platform.system(). Falls back to "unknown" for any OS not listed in
    machine_ids_by_os, so an unrecognized machine gets neither branch of the
    machine-map logic and everything on it still runs through the older
    marker-heuristic fallback below instead of silently misclassifying."""
    override = os.environ.get("WB_CONSISTENCY_MACHINE_ID")
    if override:
        return override
    machine_ids_by_os = c3.get("machine_ids_by_os", {})
    return machine_ids_by_os.get(platform.system(), "unknown")


def check3_dangling_refs(cfg, base):
    # Fehlt der Konfigurationsblock, wird diese Pruefung UEBERSPRUNGEN statt
    # abzustuerzen (2026-08-06). Die neueren Checks halten es schon so, und
    # eine Teilkonfiguration ist ein legitimer Fall: ein Test richtet genau
    # eine Pruefung auf sein Spielfeld und laesst die uebrigen weg.
    c3 = cfg.get("check3_dangling_refs")
    if not c3:
        return []
    findings = []
    files = expand_globs(c3["scan_globs"])
    tool_dirs = list(c3.get("tool_dirs", []))
    skill_dirs = list(c3.get("skill_dirs", []))
    registry_ids = load_registry_identifiers(c3["registry_path"]) if c3.get("registry_path") else set()
    extra_path_dirs = list(c3.get("extra_path_dirs", []))
    search_path = build_search_path(extra_path_dirs)
    marker = c3.get("cross_machine_marker", "peer")
    label_prefixes = {s.lower() for s in c3.get("label_prefixes_exclude", [])}
    non_commands = {s.lower() for s in c3.get("known_non_commands", [])}
    # Backticked identifiers that are real and correctly named, but name a
    # tmux session / Syncthing folder / other non-filesystem thing -- never a
    # tool to look up, so (unlike machine_tool_map below) they never produce
    # a finding at all, exactly like known_non_commands above (Befund 2026-08-04:
    # `wb-orch`, `secrets-sync`, `vault-secrets` were mis-flagged as dangling
    # tool refs).
    non_tool_identifiers = {
        d["name"].lower() for d in c3.get("known_non_tool_identifiers", []) if d.get("name")
    }
    # Werkzeuge, die es per Konfiguration wirklich nur auf EINER Maschine gibt
    # (Befund 2026-08-04: geteilte Regeldateien, aber nicht geteilte
    # ~/.local/bin-Inhalte). tool_machine: lowercased tool name -> machine id.
    machine_tool_map = c3.get("machine_tool_map", {})
    tool_machine = {}
    for machine_id, tools in machine_tool_map.items():
        for t in tools:
            tool_machine[t.lower()] = machine_id
    current_machine = current_machine_id(c3)

    for path in files:
        lines = read_lines(path)
        blocks = iter_bullet_blocks(lines)
        in_fence = False
        reported_on_line = set()
        for lineno, line in enumerate(lines, start=1):
            if FENCE_RE.match(line):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            if re.match(r"^\s*\|", line):
                # markdown table row -- data cells (preset ids), not prose
                continue
            for m in INLINE_CODE_RE.finditer(line):
                span = m.group(1)
                cmd = candidate_command(span)
                if not cmd:
                    continue
                if cmd.lower() in non_commands:
                    continue
                if cmd.lower() in non_tool_identifiers:
                    continue
                lp = label_precedes(line, m.start())
                if lp and lp.group(1).lower() in label_prefixes:
                    continue
                if tool_exists(cmd, tool_dirs, skill_dirs, registry_ids, search_path=search_path):
                    continue
                key = (lineno, cmd)
                if key in reported_on_line:
                    continue
                reported_on_line.add(key)

                assigned_machine = tool_machine.get(cmd.lower())
                if assigned_machine is not None:
                    # The config already knows, for certain, which machine this
                    # tool belongs to -- no need to guess from the word "peer"
                    # showing up (or not) in the surrounding prose.
                    if assigned_machine == current_machine:
                        findings.append(Finding(
                            "VERWEIS-INS-LEERE", path, lineno,
                            f"`{cmd}` als aufzurufendes Werkzeug genannt",
                            f"laut machine_tool_map auf dieser Maschine ('{current_machine}') "
                            f"erwartet, aber nicht gefunden in {tool_dirs}, {skill_dirs} "
                            f"oder PATH (inkl. {extra_path_dirs})",
                            severity="error",
                        ))
                    else:
                        findings.append(Finding(
                            "VERWEIS-ANDERE-MASCHINE", path, lineno,
                            f"`{cmd}` als aufzurufendes Werkzeug genannt",
                            f"laut machine_tool_map nur auf Maschine '{assigned_machine}' erwartet "
                            f"-- diese Maschine ist '{current_machine}', erwartetes Fehlen, kein Fehler",
                            severity="expected",
                        ))
                    continue

                # Fallback for anything NOT in machine_tool_map: the original
                # 2026-08-03 heuristic (does the enclosing paragraph mention
                # "peer" at all?) -- kept as-is, still the only signal for
                # tool names the map doesn't know about yet.
                # look at the whole enclosing bullet/paragraph block, not just
                # this physical line -- prose wraps, and the "auf peer"
                # mention is often one line up or down from the backticked name.
                block_text = ""
                for bstart, btext in blocks:
                    if bstart <= lineno:
                        block_text = btext
                    else:
                        break
                hint = marker in block_text or marker in line
                findings.append(Finding(
                    "VERWEIS-INS-LEERE" if not hint else "VERWEIS-HINWEIS",
                    path, lineno,
                    f"`{cmd}` als aufzurufendes Werkzeug genannt",
                    f"nicht gefunden in {tool_dirs}, {skill_dirs} oder PATH (inkl. {extra_path_dirs})" + (
                        f" (Hinweis: Absatz erwaehnt '{marker}' -- evtl. nur auf der anderen Maschine)" if hint else ""
                    ),
                    severity="hint" if hint else "error",
                ))
    return findings


