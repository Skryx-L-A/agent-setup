def check4_skill_vs_rules(cfg, base):
    # Fehlt der Konfigurationsblock, wird diese Pruefung UEBERSPRUNGEN statt
    # abzustuerzen (2026-08-06). Die neueren Checks halten es schon so, und
    # eine Teilkonfiguration ist ein legitimer Fall: ein Test richtet genau
    # eine Pruefung auf sein Spielfeld und laesst die uebrigen weg.
    c4 = cfg.get("check4_skill_vs_rules")
    if not c4:
        return []
    findings = []
    # Standing rules aren't only in CLAUDE.md -- some (e.g. "workers don't spawn
    # workers") live in roles/*.md, loaded into every worker session just the
    # same. rule_text_globs (plural) covers both; "claude_md" (singular) stays
    # as a fallback for an older config so this never hard-breaks on a stale file.
    rule_globs = c4.get("rule_text_globs") or [c4["claude_md"]]
    claude_md_text = ""
    for pat in rule_globs:
        for path in sorted(globmod.glob(pat)):
            try:
                with open(path, "r", errors="replace") as f:
                    claude_md_text += f.read() + "\n"
            except OSError:
                continue

    pairs = c4.get("rule_pairs", [])
    skill_files = sorted(globmod.glob(c4["skills_glob"]))

    for path in skill_files:
        try:
            with open(path, "r", errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        desc = parse_frontmatter_description(text)
        if not desc:
            continue
        for pair in pairs:
            if not re.search(pair["description_pattern"], desc):
                continue
            if not re.search(pair["rule_pattern"], claude_md_text):
                continue
            findings.append(Finding(
                "SKILL-VS-REGEL", path, 1,
                f"description widerspricht Standing Rule '{pair['id']}': \"{desc[:140]}\"",
                pair["explanation"],
            ))
    return findings


