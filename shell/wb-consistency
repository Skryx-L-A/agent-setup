# Check 4 -- skill descriptions vs. standing rules (conservative scaffold)
# --------------------------------------------------------------------------

def parse_frontmatter_description(text):
    if not text.startswith("---"):
        return None
    end = text.find("\n---", 3)
    if end == -1:
        return None
    fm = text[3:end]
    lines = fm.splitlines()
    for idx, line in enumerate(lines):
        m = re.match(r"^description:\s*(.*)$", line)
        if not m:
            continue
        val = m.group(1).strip()
        if val:
            return val
        # block scalar: following indented lines
        collected = []
        for cont in lines[idx + 1:]:
            if re.match(r"^\S", cont):
                break
            collected.append(cont.strip())
        return " ".join(collected)
    return None


def _ollama_bin():
    """WB_CONSISTENCY_OLLAMA_BIN (env) ueberschreibt den Binaerpfad, damit ein
    Test-Fixture eine Fake-'ollama' verwenden kann, ohne die echte Installation
    und den echten Daemon zu beruehren -- gleiches Muster wie
    WB_CONSISTENCY_MACHINE_ID bei current_machine_id()."""
    return os.environ.get("WB_CONSISTENCY_OLLAMA_BIN", "ollama")


def _ollama_available(timeout_sec):
    """Einmal pro Lauf: antwortet der ollama-Client ueberhaupt? Kein laufender
    Daemon oder ein fehlendes Binary heisst: Check 5 kann fuer Ollama-Eintraege
    nichts Eigenes nachschlagen und faellt konservativ auf die plist zurueck."""
    bin_path = _ollama_bin()
    try:
        r = subprocess.run([bin_path, "list"], capture_output=True, text=True, timeout=timeout_sec)
        return r.returncode == 0
    except Exception:
        return False


def _ollama_baked_num_ctx(model_id, num_ctx_pattern, timeout_sec):
    """Liest 'PARAMETER num_ctx N' aus 'ollama show <id> --modelfile'.

    Rueckgabe (known, baked): known=False heisst Tag unbekannt oder der Aufruf
    ist gescheitert -- der Aufrufer faellt dann auf die plist zurueck. known=True,
    baked=None heisst: das Tag existiert, traegt aber KEIN eigenes num_ctx --
    auch dann gilt weiterhin die plist. known=True, baked=N heisst: dieses Tag
    hat ein eigenes eingebranntes num_ctx, GEGEN DAS wird geprueft, nicht mehr
    gegen die plist (Anlass 2026-08-15: die -200k/-100k/-41k-Varianten aus dem
    pictx-Kontextfenster-Auftrag trugen contextWindow-Werte ueber der plist und
    waren trotzdem korrekt, weil ihr eigenes Ollama-Tag den groesseren Wert
    tatsaechlich serviert -- Check 5 kannte diesen Unterschied bislang nicht)."""
    try:
        r = subprocess.run([_ollama_bin(), "show", model_id, "--modelfile"],
                            capture_output=True, text=True, timeout=timeout_sec)
    except Exception:
        return False, None
    if r.returncode != 0:
        return False, None
    m = re.search(num_ctx_pattern, r.stdout)
    if not m:
        return True, None
    try:
        return True, int(m.group(1))
    except ValueError:
        return True, None


def _check_must_not_exceed_provider_aware(cf, pcfg, claim, base_truth, truth_file):
    """Provider-bewusste Variante von must_not_exceed_files (2026-08-15).

    Ein contextWindow-Wert in einer models.json-artigen Datei gehoert zu GENAU
    einem Provider-Block (baseUrl) und optional einem Modell-Eintrag (id) --
    beide stehen in derselben Datei vor dem jeweiligen Wert. Zwei Faelle:
      * Provider ist nicht Ollama (baseUrl traegt nicht 'ollama_baseurl_marker',
        z.B. mlx-lokal auf 8080 statt 11434): Check 5 gilt fuer diesen Provider
        gar nicht -- eigene Konfigurationsdatei fuer ein anderes lokales
        Backend, keine Ollama-plist-Vorgabe. Ergebnis: ein HINWEIS, keine
        Abweichung.
      * Provider ist Ollama: das zugehoerige Tag (id) wird per 'ollama show
        --modelfile' auf ein eigenes num_ctx geprueft (siehe
        _ollama_baked_num_ctx). Gefunden -> Vergleich gegen DIESEN Wert.
        Nicht gefunden/unbekannt/ollama nicht erreichbar -> Vergleich wie
        bisher gegen die plist, mit einem Hinweis dazu im Meldungstext.

    Die Zustandsverfolgung (current_baseurl/current_id) ist eine einfache
    Zeilen-Abfolge, kein JSON-Parser: in models.json steht 'baseUrl' immer vor
    den Modellen eines Providers, und 'id' immer unmittelbar vor 'contextWindow'
    desselben Modell-Objekts (siehe die Datei selbst) -- das reicht fuer diese
    eine, bekannte Dateiform, ohne einen JSON-Baum mitzufuehren und dabei die
    Zeilennummern zu verlieren, die die Meldung braucht. Die Annahme wird
    seit 2026-08-15 nicht mehr nur geglaubt: ein Tag gilt fuer GENAU EINEN
    contextWindow-Wert und wird danach verworfen, und Werte ohne eigenes Tag
    bekommen einen Hinweis, statt stillschweigend unter dem Tag des vorigen
    Modells geprueft zu werden (Reviewbefunde 15 und 17).

    NICHT BEHANDELT, bewusst (Reviewbefund 18, heute nicht scharf): eine
    baseUrl wie 'http://peer:11434/v1' traegt den Ollama-Marker, ihr Tag liegt
    aber auf der ANDEREN Maschine. 'ollama show' scheitert dann lokal, der Lauf
    meldet 'Tag unbekannt' und vergleicht gegen die LOKALE plist -- beides sagt
    nichts ueber das entfernte Ziel aus. Solange die geprueften Dateien auf
    localhost zeigen, kann der Fall nicht eintreten; wer hier einmal einen
    entfernten Ollama-Endpunkt eintraegt, muss den Host aus der baseUrl
    mitnehmen (OLLAMA_HOST fuer den show-Aufruf) oder den Wert ueberspringen.
    Ein stiller Vergleich gegen die eigene plist waere in dem Fall die falsche
    Antwort."""
    findings = []
    try:
        with open(cf, "r", errors="replace") as f:
            lines = f.read().split("\n")
    except OSError:
        return findings

    baseurl_re = re.compile(pcfg["baseurl_pattern"])
    id_re = re.compile(pcfg["id_pattern"])
    value_re = re.compile(claim["must_not_exceed_pattern"])
    marker = pcfg["ollama_baseurl_marker"]
    num_ctx_pattern = pcfg["num_ctx_pattern"]
    timeout_sec = pcfg.get("show_timeout_sec", 10)

    # Die Wahrheit EINMAL umwandeln, statt an drei Stellen blank `int()` zu
    # rufen (Reviewbefund 16 vom 15.08.): faengt `truth_pattern` einmal etwas
    # Nichtnumerisches, brach damit der ganze wb-consistency-Lauf ab, statt --
    # wie im alten Pfad -- diese eine Behauptung auszulassen.
    try:
        truth_num = int(base_truth)
    except (TypeError, ValueError):
        return findings

    ollama_ok = None
    show_cache = {}
    current_baseurl = None
    current_id = None
    # Gesammelt statt je Zeile gemeldet (Reviewbefund 17): ein Hinweis je
    # contextWindow-Zeile skaliert mit der Modellzahl und uebertoent den Rest
    # des Laufs. Schluessel ist die Basis-URL (None = noch keine gesehen).
    nicht_ollama = {}
    ohne_tag = []

    for i, line in enumerate(lines, 1):
        m = baseurl_re.search(line)
        if m:
            current_baseurl = m.group(1)
            current_id = None
            continue
        m = id_re.search(line)
        if m:
            current_id = m.group(1)
            continue
        m = value_re.search(line)
        if not m:
            continue
        try:
            claimed = int(m.group(1))
        except ValueError:
            continue
        # Das Tag gilt fuer GENAU DIESEN Wert. Ohne dieses Zuruecksetzen truege
        # ein contextWindow ohne eigenes vorangehendes `id` das Tag des VORIGEN
        # Modells -- und die Pruefung liefe gegen ein fremdes eingebranntes
        # num_ctx, ohne dass irgendwo ein Fehler erschiene (Reviewbefund 15).
        tag = current_id
        current_id = None

        if current_baseurl is None or marker not in current_baseurl:
            nicht_ollama.setdefault(current_baseurl, []).append((i, claimed, tag))
            continue

        if ollama_ok is None:
            ollama_ok = _ollama_available(timeout_sec)
        if not ollama_ok:
            if claimed > truth_num:
                wer = f" (Tag `{tag}`)" if tag else ""
                findings.append(Finding(
                    "KONFIG-BEHAUPTUNG", cf, i,
                    f"{claim['id']}: Wert `{claimed}`{wer} ueberschreitet das Servierte",
                    f"{truth_file} serviert `{base_truth}` -- ollama nicht "
                    f"erreichbar, konservativ gegen die plist geprueft",
                ))
            continue

        if not tag:
            # Ohne Tag laesst sich das eingebrannte num_ctx nicht abfragen. Die
            # Pruefung gegen die plist bleibt (sie ist die konservative Seite),
            # aber dass hier gar nicht je Modell geurteilt wurde, wird gesagt --
            # gesammelt, nicht je Zeile (Reviewbefund 15/17).
            ohne_tag.append((i, claimed))
            known, baked = False, None
        else:
            if tag not in show_cache:
                show_cache[tag] = _ollama_baked_num_ctx(tag, num_ctx_pattern, timeout_sec)
            known, baked = show_cache[tag]

        if not known:
            if claimed > truth_num:
                grund = (f"Tag `{tag}` bei 'ollama show' unbekannt" if tag
                         else "kein Modell-Tag zu diesem Wert gefunden")
                findings.append(Finding(
                    "KONFIG-BEHAUPTUNG", cf, i,
                    f"{claim['id']}: Wert `{claimed}` ueberschreitet das Servierte",
                    f"{truth_file} serviert `{base_truth}` -- {grund}, "
                    f"konservativ gegen die plist geprueft",
                ))
            continue

        if baked is None:
            if claimed > truth_num:
                findings.append(Finding(
                    "KONFIG-BEHAUPTUNG", cf, i,
                    f"{claim['id']}: Wert `{claimed}` ueberschreitet das Servierte",
                    f"{truth_file} serviert `{base_truth}` -- Tag `{tag}` "
                    f"traegt kein eigenes num_ctx, geprueft gegen die plist",
                ))
            continue

        if claimed > baked:
            findings.append(Finding(
                "KONFIG-BEHAUPTUNG", cf, i,
                f"{claim['id']}: Wert `{claimed}` ueberschreitet das Servierte",
                f"Tag `{tag}` hat eingebranntes `PARAMETER num_ctx {baked}` "
                f"(ollama show {tag} --modelfile) -- stille Trunkierung droht",
            ))

    # Die gesammelten Hinweise, je Provider einer statt einer je Zeile.
    for basis, treffer in nicht_ollama.items():
        zeilen = ", ".join(str(z) for z, _, _ in treffer)
        if basis is None:
            grund = ("vor diesen Werten steht in der Datei noch keine Basis-URL -- "
                     "ohne Provider laesst sich Check 5 nicht zuordnen")
            wo = "ohne vorangehende Basis-URL"
        else:
            grund = ("Check 5 gilt nur fuer Ollama-Provider -- kein Ollama-Ziel, "
                     "keine Pruefung gegen die plist")
            wo = f"Provider `{basis}` (ohne '{marker}')"
        findings.append(Finding(
            "KONFIG-BEHAUPTUNG", cf, treffer[0][0],
            f"{claim['id']}: {len(treffer)} contextWindow-Werte {wo}, Zeilen {zeilen}",
            grund,
            severity="hint",
        ))
    if ohne_tag:
        zeilen = ", ".join(str(z) for z, _ in ohne_tag)
        findings.append(Finding(
            "KONFIG-BEHAUPTUNG", cf, ohne_tag[0][0],
            f"{claim['id']}: {len(ohne_tag)} contextWindow-Werte ohne zugehoeriges Modell-Tag, "
            f"Zeilen {zeilen}",
            "ohne `id` vor dem Wert laesst sich kein 'ollama show' fragen -- "
            "konservativ gegen die plist geprueft",
            severity="hint",
        ))
    return findings


def check5_config_claims(cfg, base):
    """Regeltext behauptet einen Konfigurationswert -- stimmt er mit der Konfiguration?

    Anlass (2026-08-03): Die Regel nannte OLLAMA_CONTEXT_LENGTH=131072 und verlangte, dass
    pi's contextWindow darunter bleibt. Die plist stand seit dem 2026-07-19 auf 65536, acht
    pi-Modelle waren auf 131072 deklariert. Ein Worker lief damit in stille Trunkierung --
    zwei Wochen lang, ohne dass irgendwo ein Fehler erschien. Check 1 sah das nicht, weil er
    nur Modell-Caps aus der Registry prueft.

    Jede Behauptung steht in der externen Konfiguration (kein Hardcoding hier), mit: wo der
    WAHRE Wert steht (Datei + Muster), wo er BEHAUPTET wird (Dateien + Muster) und optional
    Dateien, deren Werte den wahren Wert nicht ueberschreiten duerfen.

    Erweitert 2026-08-15: ein must_not_exceed_files-Eintrag kann statt eines blossen
    Pfads ein Objekt mit 'file' + 'provider_aware' sein (siehe
    _check_must_not_exceed_provider_aware) -- dann gilt die Pruefung nicht mehr pauschal
    gegen die plist, sondern je Provider/Modell-Tag. Ein blosser String bleibt exakt das
    alte Verhalten, unveraendert.
    """
    c5 = cfg.get("check5_config_claims")
    if not c5:
        return []
    findings = []
    for claim in c5.get("claims", []):
        truth = None
        try:
            with open(claim["truth_file"], "r", errors="replace") as f:
                m = re.search(claim["truth_pattern"], f.read())
                if m:
                    truth = m.group(1)
        except OSError:
            continue
        if truth is None:
            continue
        for cf in claim.get("claim_files", []):
            try:
                with open(cf, "r", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            for i, line in enumerate(text.split("\n"), 1):
                m = re.search(claim["claim_pattern"], line)
                if m and m.group(1) != truth:
                    findings.append(Finding(
                        "KONFIG-BEHAUPTUNG", cf, i,
                        f"{claim['id']}: behauptet `{m.group(1)}`",
                        f"{claim['truth_file']} sagt `{truth}`",
                    ))
        # Werte, die den wahren Wert nicht ueberschreiten duerfen
        for lf in claim.get("must_not_exceed_files", []):
            if isinstance(lf, dict):
                pcfg = lf.get("provider_aware")
                cf = lf.get("file")
                if pcfg and cf:
                    findings.extend(_check_must_not_exceed_provider_aware(
                        cf, pcfg, claim, truth, claim["truth_file"]))
                    continue
                lf = cf  # Objekt ohne provider_aware -- 'file' traegt den blossen Pfad
                if not lf:
                    continue
            try:
                with open(lf, "r", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            for i, line in enumerate(text.split("\n"), 1):
                m = re.search(claim["must_not_exceed_pattern"], line)
                if not m:
                    continue
                try:
                    if int(m.group(1)) > int(truth):
                        findings.append(Finding(
                            "KONFIG-BEHAUPTUNG", lf, i,
                            f"{claim['id']}: Wert `{m.group(1)}` ueberschreitet das Servierte",
                            f"{claim['truth_file']} serviert `{truth}` -- "
                            f"stille Trunkierung droht",
                        ))
                except ValueError:
                    continue
    return findings


# --------------------------------------------------------------------------
# Check 6 -- Einstellungs-Schalter: schreibt jemand, liest jemand, passt es?
# --------------------------------------------------------------------------
# Anlass (2026-08-06): Ein Reviewer fand in zwei Durchgaengen sieben tote oder
# halbtote Schalter, immer nach demselben Muster -- das Menue schrieb einen
# Schluessel, gelesen wurde ein anderer. `guardsDisabled` gegen `guards`:
# vier Guard-Schalter taten nichts, und ein wirklich abgeschalteter Guard
# erschien im Menue als "an". `contextGuardWatchOrchestrator` dasselbe.
# `workerSkipPermissions`: ein Mensch nahm den Workern die Autonomie, und
# pi-worker setzte das Flag weiter unbedingt.
#
# KEINER davon faellt in einem Test auf, und das ist die eigentliche Lehre. Jede
# Seite ist fuer sich getestet: die eine prueft, dass geschrieben wird, die
# andere, dass gelesen wird. Sie treffen sich nirgends. Gefunden wurden alle
# sieben von Menschen, die drei Stellen von Hand verglichen haben.
#
# DIE SCHWIERIGE FRAGE IST "wer LIEST den Wert". Ein grep nach dem Namen findet
# auch die Vorgabentabelle, die Kommentare und das Menue selbst -- dann sieht
# jeder Schluessel benutzt aus und die Pruefung meldet nie etwas. Genau daran war
# die Cap-Pruefung (Check 1) still gescheitert. Deshalb bekommt hier jede Datei
# eine ROLLE, und die Rolle entscheidet, was ein Fund bedeutet:
#
#   MENUE   app/src/einstellungen/, extension/src/settings*.ts
#           Schreibt und ZEIGT an. Ein Fund hier ist nie ein Leser -- das Menue
#           liest den Wert nur, um das Feld zu fuellen. Wuerde das als Benutzung
#           zaehlen, waere jeder tote Schalter automatisch lebendig.
#   SPEICHER shell/wb-state
#           Die DEFAULTS-Tabelle und die Pruef-Tabellen sind die DEKLARATION des
#           Schluessels, keine Benutzung. Alles andere in der Datei ist Code, der
#           mit dem Wert etwas tut.
#   REST    alles uebrige in shell/, hooks/, app/src/, extension/src/
#           Ein Fund ist ein Leser.
#
# Das ist keine Ausnahmeliste, sondern eine Rollenzuweisung: eine Ausnahmeliste
# wuerde einzelne Schluessel von der Pruefung befreien, hier bekommt jede DATEI
# eine Bedeutung, und jeder Schluessel laeuft durch dieselbe Regel.
#
# INDIREKTE Zugriffe kommen ueber zwei zusaetzliche Wege mit:
#   * `settings get "$VAR"` / `settings set "$VAR"` mit einer Variablen -- dann
#     zaehlen die Zuweisungen `VAR=<schluessel>` derselben Datei. So findet die
#     Pruefung, dass `wb-state effort-cap set` den Schluessel `effortCaps`
#     schreibt, obwohl der Name nie neben `settings set` steht.
#   * ein blosses Vorkommen des Namens im REST -- `context-guard` liest
#     `guardWorkerWarnPct` ueber eine Hilfsfunktion, der Name steht nur an der
#     Aufrufstelle. Das ist grob, aber gefahrlos: das Universum besteht
#     ausschliesslich aus Schluesseln, die irgendwo deklariert oder angeboten
#     werden, und diese Namen kollidieren mit nichts.
#
# Datendateien (.json, .md, plist, Bilder) werden NICHT nach Lesern durchsucht.
# Ein Name in einer Datei, die niemand ausfuehrt, ist eine Erwaehnung.

# Rollen-Zuordnung. Bewusst als Glob-Muster in der Konfiguration und nicht hier
# fest verdrahtet -- wer das Menue verschiebt, aendert eine Zeile in der Konfig.
def _rolle(path, c6):
    # Die Rolle haengt am Pfad IM ARBEITSBAUM, nicht am Heimatverzeichnis. Mit
    # $HOME als Bezug lautete der relative Pfad
    # '.pi-workers/worktrees/effort/app/src/einstellungen/...', kein menu_glob
    # traf, und damit galt das Menue als LESER -- die Pruefung meldete 0 Befunde
    # und sah dabei aus wie eine bestandene Pruefung. Genau die Sorte stiller
    # Blindheit, gegen die sie gebaut ist (gemessen 2026-08-06).
    rel = os.path.relpath(path, c6["repo_dir"])
    for pat in c6.get("menu_globs", []):
        if fnmatch.fnmatch(rel, pat):
            return "menue"
    if os.path.abspath(path) == os.path.abspath(c6["store_file"]):
        return "speicher"
    return "rest"


CODE_SUFFIXE = (".ts", ".js", ".py", ".sh", "")     # "" = Skript ohne Endung


def _ist_code(path):
    _, ext = os.path.splitext(path)
    return ext in CODE_SUFFIXE


def _store_deklaration_spans(text):
    """Zeilenbereiche in wb-state, die den Schluessel nur DEKLARIEREN."""
    spans = []
    m = re.search(r"^DEFAULTS = \{.*?^\}", text, re.S | re.M)
    if m:
        spans.append(m.span())
    # Die Pruef-Tabellen (NUM/ENUM/BOOL/LIST/OBJ) nennen jeden Schluessel, den
    # sie typisieren -- ebenfalls Deklaration.
    for tm in re.finditer(r"^\s*(?:NUM|ENUM|BOOL|LIST|OBJ)\s*=\s*[\({\[].*?[\)}\]]\s*$",
                          text, re.S | re.M):
        spans.append(tm.span())
    return spans


def _in_span(pos, spans):
    return any(a <= pos <= b for a, b in spans)


def check6_settings_switches(cfg, base):
    c6 = cfg.get("check6_settings_switches")
    if not c6:
        return []
    store = c6["store_file"]
    try:
        store_text = open(store, errors="replace").read()
    except OSError as e:
        return [Finding("SCHALTER", store, 0, "Speicherdatei lesbar",
                        f"{store} nicht lesbar: {e}")]

    dateien = expand_globs(c6["scan_globs"], c6.get("exclude_substrings", ()))
    dateien = [p for p in dateien if _ist_code(p)]

    # ── Universum: was ueberhaupt ein Einstellungs-Schluessel IST ────────────
    # Nur deklarierte oder angebotene Namen. Ohne diese Schranke faengt die
    # Lesersuche jedes `settings.foo` und jedes `cfg.get("bar")` im ganzen Baum
    # ein, und die Pruefung ertrinkt in Feldern, die mit den Einstellungen nichts
    # zu tun haben (gemessen: 15 solcher Treffer, darunter `json`, `render`, `ts`).
    universum, schreiber = set(), {}

    def merke_schreiber(key, path, pos, text):
        schreiber.setdefault(key, []).append(
            (os.path.relpath(path, c6["repo_dir"]), text[:pos].count("\n") + 1))

    m = re.search(r"^DEFAULTS = \{(.*?)^\}", store_text, re.S | re.M)
    if m:
        universum |= set(re.findall(r'^\s{4}"([A-Za-z][A-Za-z0-9_]*)":', m.group(1), re.M))
    store_spans = _store_deklaration_spans(store_text)

    # Ein `settings set <schluessel>` IM MENUE ist kein Programmaufruf, sondern
    # ein dokumentierter Weg fuer den Menschen -- das Feld `logPaths` etwa steht
    # dort als "Nur Anzeige. Aendern: wb-state settings set logPaths '[…]'".
    # Das zaehlt trotzdem als Schreiber, und zwar mit Absicht: gemeint ist
    # "irgendwo wird dieser Schluessel angeboten", und ein im Menue genannter
    # Befehl ist ein Angebot. Ohne diese Lesart meldete die Pruefung jedes
    # bewusst nur-per-CLI gepflegte Feld als Mangel, und wer sie dreimal
    # unberechtigt sieht, schaltet sie ab.
    SET_MUSTER = [re.compile(p) for p in c6["write_patterns"]]
    GET_MUSTER = [re.compile(p) for p in c6["read_patterns"]]
    # Der Schluessel steht nicht immer als Literal neben `settings set`. Zwei
    # Formen kommen in dieser Werkbank wirklich vor:
    #   shell   `"$0" settings set "$SKEY" …`   mit `SKEY=effortCaps` weiter oben
    #   python  `subprocess.run([SELF, "settings", "set", KEY, …])` mit
    #           `KEY = {"guard": "guards", …}[CMD]`
    # Beide Male traegt eine VARIABLE den Namen. Ohne diese zwei Muster meldete
    # die Pruefung `effortCaps`, `guards` und `kontextwache` als "unsichtbar
    # verstellbar", obwohl `wb-state guard set …` genau dafuer da ist -- drei
    # Fehlmeldungen, gemessen beim ersten Lauf.
    VAR_SET = re.compile(r"settings\s+set\s+\"?\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?\"?")
    VAR_GET = re.compile(r"settings\s+get\s+\"?\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?\"?")
    ARGV_SET = re.compile(r"[\"']settings[\"']\s*,\s*[\"']set[\"']\s*,\s*([A-Za-z_][A-Za-z0-9_]*)")
    ARGV_GET = re.compile(r"[\"']settings[\"']\s*,\s*[\"']get[\"']\s*,\s*([A-Za-z_][A-Za-z0-9_]*)")

    def zuweisungen(text, var):
        """Alle Namen, die dieser Variablen zugewiesen werden -- als blosses Wort
        (shell) oder als Zeichenkette (python), jeweils auf der Zuweisungszeile.
        Eine Zuweisung ueber mehrere Zeilen erfasst das nicht; kommt sie vor, ist
        der Schluessel wieder unsichtbar und die Pruefung meldet ihn -- lieber so
        herum als eine stille Luecke."""
        for am in re.finditer(r"(?<![A-Za-z0-9_])" + re.escape(var) + r"\s*=\s*([^\n]*)", text):
            zeile = am.group(1)
            for lit in re.findall(r"[\"']([A-Za-z][A-Za-z0-9_]*)[\"']", zeile):
                yield lit, am.start()
            # Blosses Wort, wie es in einer case-Verzweigung steht:
            #     effort-cap) SKEY=effortCaps ;;
            # Der Abschluss darf `;;`, ein Kommentar oder das Zeilenende sein --
            # ohne diese Endungen blieb `SKEY=effortCaps ;;` unerkannt, und der
            # Schluessel galt als unsichtbar verstellbar, obwohl `wb-state
            # effort-cap set` genau dafuer da ist.
            bw = re.match(r"([A-Za-z][A-Za-z0-9_]*)\s*(?:;;|;|&&|\|\||#|$)", zeile.strip())
            if bw:
                yield bw.group(1), am.start()

    var_leser = {}
    for p in dateien:
        try:
            text = open(p, errors="replace").read()
        except OSError:
            continue
        for pat in SET_MUSTER:
            for mm in pat.finditer(text):
                universum.add(mm.group(1))
                merke_schreiber(mm.group(1), p, mm.start(), text)
        # Im MENUE zaehlt jeder bekannte Schluessel als angeboten, egal durch
        # welche Hilfsfunktion er dorthin kommt (2026-08-06, zweite Messung).
        # Die Muster oben kennen `setze('x')` und `set('x')`; das Menue im
        # Hauptzweig reicht den Schluessel inzwischen an Wrapper weiter --
        # `stufenwahl(g1, 'orchestratorEffort', …)`, `chipListe(…,
        # 'secretExcludePatterns', …)`. Gegen den Stand dort meldete die
        # Pruefung deshalb drei Schluessel als unsichtbar, die in Wahrheit
        # mitten im Menue stehen. Jedem neuen Wrapper hinterherzupflegen ist
        # genau die Bruechigkeit, die den urspruenglichen Fehler unsichtbar
        # gemacht hat.
        #
        # Diese Regel kann nur SCHREIBER hinzufuegen. Ein toter Schalter
        # (Schreiber ohne Leser) bleibt davon unberuehrt -- gefunden wird er
        # ueber die fehlenden LESER, und daran aendert ein zusaetzlicher
        # Schreiber nichts. Weicher wird allein die Kategorie "unsichtbar
        # verstellbar", und das ist die richtige Richtung: lieber eine Meldung
        # zu wenig ueber ein Feld, das im Menue steht, als drei zu viel.
        if _rolle(p, c6) == "menue":
            for k in list(universum):
                mm = re.search(r"[\"'`]" + re.escape(k) + r"[\"'`]", text)
                if mm:
                    merke_schreiber(k, p, mm.start(), text)
        # Indirekt: der Schluessel reist in einer Variablen.
        for var in set(VAR_SET.findall(text)) | set(ARGV_SET.findall(text)):
            for key, pos in zuweisungen(text, var):
                universum.add(key)
                merke_schreiber(key, p, pos, text)
        for var in set(VAR_GET.findall(text)) | set(ARGV_GET.findall(text)):
            for key, pos in zuweisungen(text, var):
                var_leser.setdefault(key, []).append(
                    (os.path.relpath(p, c6["repo_dir"]), text[:pos].count("\n") + 1))

    # ── Leser ───────────────────────────────────────────────────────────────
    leser = dict(var_leser)
    for p in dateien:
        rolle = _rolle(p, c6)
        if rolle == "menue":
            continue                       # schreibt und zeigt an, benutzt nicht
        try:
            text = open(p, errors="replace").read()
        except OSError:
            continue
        rel = os.path.relpath(p, c6["repo_dir"])
        for k in universum:
            for mm in re.finditer(r"(?<![A-Za-z0-9_])" + re.escape(k)
                                  + r"(?![A-Za-z0-9_])", text):
                if rolle == "speicher" and _in_span(mm.start(), store_spans):
                    continue               # Deklaration, keine Benutzung
                leser.setdefault(k, []).append((rel, text[:mm.start()].count("\n") + 1))
                break                      # eine Fundstelle je Datei genuegt
        # Zusaetzlich die ausdruecklichen Lese-Idiome, auch im Speicher.
        for pat in GET_MUSTER:
            for mm in pat.finditer(text):
                if mm.group(1) in universum:
                    leser.setdefault(mm.group(1), []).append(
                        (rel, text[:mm.start()].count("\n") + 1))

    def baeume(eintraege):
        return sorted({e[0].split("/")[0] for e in eintraege})

    findings = []
    for k in sorted(universum):
        s, l = schreiber.get(k, []), leser.get(k, [])
        if s and not l:
            ort, zeile = s[0]
            findings.append(Finding(
                "TOTER-SCHALTER", ort, zeile,
                f"`{k}` wird geschrieben",
                "niemand liest ihn -- der Schalter tut nichts. Entweder anschliessen "
                "oder aus der Oberflaeche nehmen."))
        elif l and not s:
            ort, zeile = l[0]
            findings.append(Finding(
                "UNSICHTBAR-VERSTELLBAR", ort, zeile,
                f"`{k}` wird gelesen und wirkt",
                "kein Menue und kein Werkzeug schreibt ihn -- er laesst sich nur von "
                "Hand in der Datei aendern."))
        elif s and l:
            sb, lb = baeume(s), baeume(l)
            # Der Fall aus dem Befund: das Menue des NEUEN Programms schreibt,
            # gelesen wird nur in der alten VS-Code-Erweiterung. Zwei getrennte
            # Programme; wer den Haken in app/ setzt, aendert nichts an app/.
            if "app" in sb and lb == ["extension"]:
                ort, zeile = s[0]
                findings.append(Finding(
                    "SCHALTER-GETRENNT", ort, zeile,
                    f"`{k}` wird im Menue von app/ geschrieben",
                    "gelesen wird er ausschliesslich in extension/ -- zwei getrennte "
                    "Programme. Im laufenden Programm bewirkt der Haken nichts."))
    return findings


