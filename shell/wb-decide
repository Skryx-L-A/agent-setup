#!/bin/bash
# wb-decide — the ORCHESTRATOR decides a worker's request for a sub-worker.
#
#   wb-decide <antrags-datei> approve|reject [begruendung]
#
# Writes <antrag>.decision, updates the decision column of
# ~/.pi-workers/requests/log.tsv and, on approve, prints the ready-to-run spawn
# command. It NEVER spawns anything itself: deciding and executing both stay with
# the orchestrator, so an approval is always a deliberate second step.
# Approving needs a MEASURED origin (orchestrator pane or a human, see HERKUNFT
# below); a worker pane is refused with exit 3. Rejecting needs a measured origin
# too (14.10.2026), with one exception: a worker may reject its OWN request.
set -u

REQ="${1:?Antrags-Datei}"; ACTION="${2:?approve|reject}"; shift 2
REASON="$*"
LOG="$HOME/.pi-workers/requests/log.tsv"

[ -f "$REQ" ] || { echo "wb-decide: Antrag nicht gefunden: $REQ" >&2; exit 2; }
case "$ACTION" in approve|reject) ;; *) echo "wb-decide: '$ACTION' ist weder approve noch reject." >&2; exit 2 ;; esac
# Die Begruendung ist FREIWILLIG (19.08., auf Ansage des Nutzers): steht sie da,
# landet sie unveraendert in der .decision-Datei und damit in der Auswertung;
# steht sie nicht da, wird trotzdem entschieden. Ein leeres $* ist hier
# ungefaehrlich, weil REASON alles NACH Antrag und Aktion einsammelt -- es kann
# nichts an eine andere Stelle rutschen.
if [ -e "$REQ.decision" ]; then
  echo "wb-decide: bereits entschieden — $REQ.decision:" >&2
  cat "$REQ.decision" >&2
  exit 2
fi

# Erst LESEN, dann entscheiden. Der Antrag wird vollstaendig ausgewertet, bevor
# irgendetwas geschrieben wird — sonst steht die Entscheidung fest und der Rest des
# Werkzeugs stirbt daran (Befund 2026-08-15, nachgestellt mit kaputtem JSON: ".decision:
# approved" lag auf der Platte, waehrend das Skript an einer nicht gesetzten Variablen
# abbrach; die Logzeile blieb 'pending', und den Spawn-Befehl bekam nie jemand zu sehen).
FELDER="$(/usr/bin/python3 - "$REQ" <<'PY'
import json, shlex, sys
try:
    r = json.load(open(sys.argv[1]))
    if not isinstance(r, dict):
        raise ValueError("kein JSON-Objekt")
except Exception as e:
    sys.stderr.write("%s\n" % e)
    sys.exit(1)
for k in ("ts", "parent", "child_name", "child_model", "child_effort", "dir", "task"):
    print("R_%s=%s" % (k.upper(), shlex.quote(str(r.get(k) or ""))))
print("R_FILES=%s" % shlex.quote(", ".join(r.get("files") or [])))
PY
)" || { echo "wb-decide: Antrag '$REQ' laesst sich nicht lesen — nichts entschieden, nichts geschrieben." >&2; exit 2; }
eval "$FELDER"
for feld in R_TS R_PARENT R_CHILD_NAME; do
  eval "wert=\"\${$feld:-}\""
  [ -n "$wert" ] || { echo "wb-decide: Antrag '$REQ' ist unvollstaendig ($feld fehlt) — nichts entschieden, nichts geschrieben." >&2; exit 2; }
done

# HERKUNFT DES ANNEHMENS (13.10.2026, Folge zum Steuerkanal-Fix 9c052599). Bis dahin
# entschied, wer die Antragsdatei nannte: ein Worker konnte seinen eigenen Antrag oder
# den eines anderen Workers annehmen, und ueber den Steuersocket der App jeder Prozess
# des Benutzers. Annehmen braucht jetzt eine GEMESSENE Herkunft; Ablehnen seit 14.10.
# ebenso, ausser dem eigenen Antrag eines Workers (Abschnitt HERKUNFT DES ABLEHNENS).
#   * Die Ahnenkette dieses Aufrufs, soweit ihre Glieder die pane_pid eines Panes auf einem
#     der eigenen tmux-Server sind (dasselbe Verfahren wie wb-mensch A3 und wb-inbox
#     HERKUNFT; TMUX_PANE zaehlt nicht), entscheidet die Rolle. Strengste Lesart wie
#     hooks/lib/rollen.py: Worker, sobald bei IRGENDEINEM Pane der Kette (auf welchem Server
#     auch immer) @wb_role, @wb_worker ODER das Rollenregister das sagen -> abgelehnt.
#   * Hauptagent nur, wenn der NAECHSTE Pane der Kette @wb_role=orchestrator traegt, das
#     Register nicht widerspricht UND der Pane auf dem Werkbank-Server liegt: Standard-Socket
#     (Darwin /private/tmp/tmux-<uid>/default, Linux /tmp/tmux-<uid>/default, fester Pfad je
#     System) oder der Name aus tmuxSocket der config.json im Heimatverzeichnis laut
#     Benutzerdatenbank (nie aus $HOME/AWB_CONFIG; nie Testnamen wbtest-*, wbk*). Gemessen:
#     der echte Orchestrator hat oft keinen Registereintrag, also kann das Register nicht
#     verlangt werden; und es ist allein nicht tragfaehig, weil es sich per
#     AWB_ROLLEN_DIR/HOME umlenken laesst. Ein Pane auf einem anderen Server (`tmux -L x`,
#     ein Aufrufer legt ihn selbst an und setzt dort @wb_role) ist ein Pane ohne Rolle und
#     faellt auf wb-mensch zurueck.
#     GRENZE: wer die echte config.json schreibt, kann einen Server benennen (gleiche Klasse
#     wie ~/.local/bin schreiben). Die Testnaht ist eine Kopie dieses Skripts mit
#     umgeschriebenen Konstanten (WB_SOCKET_BASIS, WB_CONFIG_DATEI), nie ein Schalter hier.
#   * Sonst (kein Pane, Pane ohne Rolle) nur, wenn `wb-mensch pruefen` einen Menschen
#     misst: Terminal ohne Agent darueber (M1) oder die Oberflaeche als Ahne (M2; der
#     Kern setzt WB_MENSCH_QUELLE/WB_APP_PID nur nach einem echten Klick).
# GRENZE wie bei wb-mensch: Code, der seine Herkunft aktiv verwischt (etwa ein neues
# tmux-Fenster ohne Rolle aufmacht), wird hier nicht erkannt.
wb_herkunft() {
  /usr/bin/python3 - "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/hooks/lib" \
    "$HOME/.claude/hooks/lib" <<'PY'
import json, os, pwd, re, socket, subprocess, sys

# FESTE ORTE (die Testnaht: eine KOPIE dieses Skripts, in der genau diese zwei Zeilen
# umgeschrieben sind; shell/tests/lib-decide-kopie.sh. Das installierte Werkzeug hat keinen
# Schalter, keine Variable, keine Datei daneben).
#   Socketverzeichnis des Systems: tmux legt seine Sockets unter <Basis>/tmux-<uid>/ ab.
#   Die Konfiguration der Werkbank: ~/.config/agent-workbench/config.json im Heimatverzeichnis
#   laut Benutzerdatenbank, NIE aus $HOME oder AWB_CONFIG (beide setzt der Aufrufer).
WB_SOCKET_BASIS = "/private/tmp" if sys.platform == "darwin" else "/tmp"
WB_CONFIG_DATEI = os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".config", "agent-workbench", "config.json")

def tmux_fest():
    for k in ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux", "/bin/tmux"):
        if os.access(k, os.X_OK):
            return k
    return None

def sockets():
    uid = os.getuid()
    raus, gesehen = [], set()
    t = os.environ.get("TMUX", "").split(",")[0]
    kandidaten = [t] if t else []
    for d in ("%s/tmux-%d" % (WB_SOCKET_BASIS, uid), "/private/tmp/tmux-%d" % uid, "/tmp/tmux-%d" % uid,
              os.path.join(os.environ.get("TMPDIR", "/tmp"), "tmux-%d" % uid)):
        try:
            if os.stat(d).st_uid != uid:
                continue
            kandidaten += [os.path.join(d, n) for n in sorted(os.listdir(d))]
        except OSError:
            continue
    for p in kandidaten:
        try:
            real = os.path.realpath(p)
            st = os.stat(real)
        except OSError:
            continue
        if real in gesehen or st.st_uid != uid:
            continue
        gesehen.add(real)
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1)
        try:
            s.connect(real)
        except (ConnectionRefusedError, FileNotFoundError):
            continue
        except OSError:
            pass
        finally:
            s.close()
        raus.append(real)
    return raus

def ahnen():
    try:
        r = subprocess.run(["ps", "-A", "-o", "pid=", "-o", "ppid="], capture_output=True,
                           text=True, timeout=5, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return []
    eltern = {}
    for z in r.stdout.splitlines():
        t = z.split()
        if len(t) == 2 and t[0].isdigit() and t[1].isdigit():
            eltern[int(t[0])] = int(t[1])
    kette, pid = [], os.getppid()
    for _ in range(64):
        if pid <= 1 or pid not in eltern:
            break
        kette.append(pid)
        pid = eltern[pid]
    return kette

def werkbank_sockets():
    """Die Server der Werkbank, als realpath: der Standard-Socket des Benutzers unter dem
    festen Verzeichnis des Systems (Darwin /private/tmp, sonst /tmp, je tmux-<uid>/default;
    derselbe umgebende Server, den wb-inbox HERKUNFT nimmt) und, falls die Werkbank unter
    eigenem Namen laeuft, der Name aus dem Schluessel tmuxSocket der config.json
    (wie wb-autorevive: nur dieser Schluessel, nur ein schlichter Name, nie Testnamen
    wbtest-*/wbk*). Weder TMUX noch TMPDIR noch TMUX_TMPDIR noch HOME noch AWB_CONFIG wirken
    hier: wer selbst einen Server anlegt, macht ihn damit nicht zum Werkbank-Server.
    GRENZE: wer die echte config.json des Benutzers schreibt, kann einen Server benennen --
    dieselbe Klasse wie ~/.local/bin schreiben."""
    basis = os.path.join(WB_SOCKET_BASIS, "tmux-%d" % os.getuid())
    namen = ["default"]
    try:
        st = os.stat(WB_CONFIG_DATEI)
        if st.st_uid == os.getuid() and not st.st_mode & 0o022:
            with open(WB_CONFIG_DATEI, "r", encoding="utf-8") as fh:
                wert = json.load(fh).get("tmuxSocket", "")
            if (isinstance(wert, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", wert)
                    and not wert.startswith(("wbtest-", "wbk"))):
                namen.append(wert)
    except (OSError, ValueError, AttributeError):
        pass
    return {os.path.realpath(os.path.join(basis, n)) for n in namen}

tm = tmux_fest()
panes = {}
if tm:
    for sock in sockets():
        try:
            r = subprocess.run([tm, "-S", sock, "list-panes", "-a", "-F",
                                "#{pane_pid}\t#{pane_id}\t#{@wb_role}\t#{@wb_worker}"],
                               capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            continue
        for z in r.stdout.splitlines():
            t = z.split("\t")
            if len(t) == 4 and t[0].isdigit():
                panes.setdefault(int(t[0]), (sock, t[1], t[2].strip(), t[3].strip()))
kette = [panes[p] for p in ahnen() if p in panes]
if not kette:
    print("keiner\t-\t")
    sys.exit(0)

def registriert_von(sock, pane):
    for lib in sys.argv[1:]:
        if os.path.isfile(os.path.join(lib, "rollen.py")):
            sys.path.insert(0, lib)
            try:
                import rollen
                rollen.tmux_server_waehlen(["-S", sock])
                return ((rollen.eintrag(pane) or {}).get("rolle") or "").strip()
            except Exception:
                return ""
    return ""

# Drei Felder, Tab-getrennt: Klasse, Pane, Worker-Name (leer, wenn keiner gesetzt ist).
# Worker: JEDER Pane der Ahnenkette auf JEDEM Server, der nach @wb_role, @wb_worker oder
# Register Worker ist -- ein Worker kommt nicht aus der Klasse, indem ein naeherer Pane
# eines Fremdservers dazwischenliegt.
for sock, pane, rolle, worker in kette:
    if rolle == "worker" or worker or registriert_von(sock, pane) == "worker":
        print("worker\t%s\t%s" % (pane, worker))
        sys.exit(0)
# Orchestrator: der NAECHSTE Pane, und nur auf dem Werkbank-Server. Ein Pane eines anderen
# Servers, auch mit @wb_role=orchestrator, ist ein Pane ohne Rolle (-> wb-mensch pruefen).
sock, pane, rolle, worker = kette[0]
if rolle == "orchestrator" and sock in werkbank_sockets() \
        and registriert_von(sock, pane) in ("", "orchestrator"):
    print("orchestrator\t%s\t" % pane)
else:
    print("pane-ohne-rolle\t%s\t" % pane)
PY
}

# HERKUNFT DES ABLEHNENS (14.10.2026). Ablehnen war bisher frei; ein Worker konnte damit
# fremde Antraege sabotieren. Jetzt gilt fuer Ablehnen dieselbe Messung wie fuer Annehmen,
# mit einer Ausnahme: ein Worker darf den EIGENEN Antrag ablehnen bzw. zurueckziehen.
#   * Worker-Pane: nur wenn sein gemessener @wb_worker gleich dem Antragsteller (Feld
#     "parent", von wb-request aus dem Pane des Antragstellers geschrieben) ist.
#   * Orchestrator-Pane: darf jeden Antrag ablehnen.
#   * Sonst (Pane ohne Rolle, kein Pane) nur mit gemessenem Menschen (wb-mensch pruefen).
HERKUNFT="$(wb_herkunft 2>/dev/null)" || HERKUNFT=""
H_KLASSE="${HERKUNFT%%	*}"; H_REST="${HERKUNFT#*	}"
H_PANE="${H_REST%%	*}"; H_NAME="${H_REST#*	}"
H_WO="${H_PANE}${H_NAME:+ $H_NAME}"; [ "$H_PANE" = "-" ] && H_WO=""
if [ "$ACTION" = approve ]; then
  case "$H_KLASSE" in
    orchestrator) ;;
    worker)
      echo "wb-decide: ABGELEHNT — Annehmen aus einem Worker-Pane ($H_WO). Ueber Antraege entscheidet der Orchestrator oder der Mensch, nie ein Worker, auch nicht ueber den eigenen. Nichts geschrieben." >&2
      exit 3 ;;
    *)
      MENSCH_BIN="$(dirname "${BASH_SOURCE[0]}")/wb-mensch"
      [ -x "$MENSCH_BIN" ] || MENSCH_BIN="$HOME/.local/bin/wb-mensch"
      if ! { [ -x "$MENSCH_BIN" ] && "$MENSCH_BIN" pruefen </dev/null >/dev/null 2>&1; }; then
        echo "wb-decide: ABGELEHNT — Annehmen ohne gemessene Herkunft (${H_KLASSE:-unbestimmt}${H_WO:+ $H_WO}): weder ein Orchestrator-Pane noch ein Mensch (wb-mensch). Ablehnen geht ohne Nachweis. Nichts geschrieben." >&2
        exit 3
      fi ;;
  esac
else
  case "$H_KLASSE" in
    orchestrator) ;;
    worker)
      if [ -z "$H_NAME" ] || [ "$H_NAME" != "$R_PARENT" ]; then
        echo "wb-decide: ABGELEHNT — Worker-Pane ($H_WO) lehnt nur den EIGENEN Antrag ab. Dieser Antrag gehoert '$R_PARENT'. Fremde Antraege lehnen nur Orchestrator oder Mensch ab. Nichts geschrieben." >&2
        exit 3
      fi ;;
    *)
      MENSCH_BIN="$(dirname "${BASH_SOURCE[0]}")/wb-mensch"
      [ -x "$MENSCH_BIN" ] || MENSCH_BIN="$HOME/.local/bin/wb-mensch"
      if ! { [ -x "$MENSCH_BIN" ] && "$MENSCH_BIN" pruefen </dev/null >/dev/null 2>&1; }; then
        echo "wb-decide: ABGELEHNT — Ablehnen ohne gemessene Herkunft (${H_KLASSE:-unbestimmt}${H_WO:+ $H_WO}): weder ein Orchestrator-Pane noch ein Mensch (wb-mensch) noch der eigene Antrag eines Workers. Nichts geschrieben." >&2
        exit 3
      fi ;;
  esac
fi

# Past tense, identical to the log column — wb-request greps '^decision: approved'
# to find children that are still running.
[ "$ACTION" = approve ] && DECIDED=approved || DECIDED=rejected
{
  echo "decision: $DECIDED"
  echo "at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "reason: $REASON"
} > "$REQ.decision"

# decision column (7) of the matching row — matched on ts + parent, which is unique.
if [ -f "$LOG" ]; then
  /usr/bin/python3 - "$LOG" "$R_TS" "$R_PARENT" "$ACTION" <<'PY'
import os, sys, tempfile, fcntl
log, ts, parent, action = sys.argv[1:5]
lock = open(log + ".lock", "w")
fcntl.flock(lock, fcntl.LOCK_EX)
try:
    rows = [l.rstrip("\n").split("\t") for l in open(log) if l.strip()]
    hit = 0
    for r in rows:
        while len(r) < 10:
            r.append("")
        if r[0] == ts and r[1] == parent:
            r[6] = "approved" if action == "approve" else "rejected"
            hit += 1
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(log))
    with os.fdopen(fd, "w") as fh:
        for r in rows:
            fh.write("\t".join(r) + "\n")
    # mkstemp() erzeugt IMMER 0600, unabhaengig vom umask -- ohne dies wird log.tsv bei
    # JEDER Entscheidung ein Stueck enger, bis nur noch der Eigentuemer lesen kann, obwohl
    # nichts das je beabsichtigt hat (2026-08-16, bugjagd shell/niedrig, reproduziert: 644
    # vor dem Aufruf, 600 danach). Der bestehende Modus der Datei bleibt einfach erhalten.
    try:
        os.chmod(tmp, os.stat(log).st_mode & 0o777)
    except OSError:
        pass
    os.replace(tmp, log)
    if hit == 0:
        sys.stderr.write("wb-decide: WARNUNG — keine passende Zeile in log.tsv (ts=%s parent=%s).\n" % (ts, parent))
finally:
    fcntl.flock(lock, fcntl.LOCK_UN)
PY
fi

# Eine Zeile, die auch ohne Begruendung etwas sagt -- "Begruendung: " mit nichts
# dahinter liest sich wie ein Fehler, und genau das ist es hier nicht mehr.
grundzeile() { [ -n "$REASON" ] && echo "Begruendung: $REASON" || echo "Begruendung: keine angegeben"; }

if [ "$ACTION" = reject ]; then
  echo "Abgelehnt: $REQ"
  grundzeile
  exit 0
fi

MODELARG="$R_CHILD_MODEL"
[ -n "$R_CHILD_EFFORT" ] && MODELARG="$R_CHILD_MODEL:$R_CHILD_EFFORT"
case "$R_CHILD_MODEL" in
  claude*|opus*|sonnet*|haiku*|fable*) TOOL="claude-worker" ;;
  *) TOOL="pi-worker" ;;
esac

echo "Genehmigt: $REQ"
grundzeile
[ -n "$R_FILES" ] && echo "Dateien laut Antrag: $R_FILES"
echo
echo "Starten (der Orchestrator fuehrt das aus, nichts passiert automatisch):"
printf '%s %s %s %s %s\n' "$TOOL" "$(printf %q "$R_CHILD_NAME")" "$(printf %q "$MODELARG")" \
  "$(printf %q "$R_DIR")" "$(printf %q "$R_TASK")"
