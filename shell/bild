#!/bin/bash
# bild — lokale Bildgenerierung mit einem Befehl, komplett offline-fähig.
#
#   bild "ein roter Apfel auf Holztisch"              Qualität (Default, ~1 Min)
#   bild --schnell "ein roter Apfel"                  Schnell (~10 Sek)
#   bild --text "Ladenschild mit Text ROESTEREI NORD" Bester Text im Bild (~3 Min, 34 GB Modell!)
#   bild --unzensiert "..."                           UNZENSIERT: klein-9B + NSFW-LoRA
#   bild --unzensiert-gross "..."                     UNZENSIERT: Qwen 20B + NSFW-LoRA (~3 Min)
#   bild --bearbeiten foto.png "give her a short bob" Foto bearbeiten (FLUX.2 klein Edit)
#
# Optionen:
#   --bearbeiten DATEI     Quellbild bearbeiten; mehrfach = mehrere Referenzbilder
#                          (das ERSTE Bild ist das zu bearbeitende)
#   --edit-modell V        beste (Default) | sparsam; mit --unzensiert ergibt das
#                          die vier Plätze beste/beste-frei/sparsam/sparsam-frei
#   --breite N --hoehe N   Bildgröße (Default 1024x1024; beim Bearbeiten aus dem Quellbild)
#   --maxkante N           Bearbeiten: längste Kante der Ausgabe (Default 1024)
#   --schritte N           Sampling-Schritte (Default je Modus, Bearbeiten 28)
#   --guidance N           Guidance/CFG (Default: Modellvorgabe)
#   --seed N               reproduzierbar; MEHRFACH = mehrere Varianten in einem Lauf
#                          (mflux hängt dann _seed_<N> an den Dateinamen an)
#   -o name                Ausgabedatei (Default ~/Pictures/bild-<datum>.png)
#   --kein-open            Bild nach Generierung nicht öffnen
#
# Ergebnisse landen in ~/Pictures/. Läuft ohne Internet (Modelle sind lokal).
set -euo pipefail

export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1

# Modellpfade zentral — Wechsel auf eine andere Quantisierung ist eine Zeile.
MODELL_KLEIN9B="$HOME/AI/models/flux2-klein-9b-4bit"
MODELL_QWEN="$HOME/AI/models/qwen-image-8bit"
LORA_NSFW="$HOME/AI/loras/flux-klein9b-nsfw-v2.safetensors"
LORA_NSFW_QWEN="$HOME/AI/loras/qwen-image-nsfw-lora.safetensors"

# Edit-Modelle (gemessen 2026-07-14, jeweils bei 1024 px Arbeitsauflösung):
EDIT_9B_8BIT="$HOME/AI/models/flux2-klein-9b-8bit"   # 28 Schr. -> 267 s, 32 GB, kein Spill
EDIT_9B_6BIT="$HOME/AI/models/flux2-klein-9b-6bit"   # gleichwertig, 29 GB (Reserve)
EDIT_9B_4BIT="$HOME/AI/models/flux2-klein-9b-4bit"   # 14 Schr. -> ~2 Min
EDIT_4B_4BIT="$HOME/AI/models/flux2-klein-4b-4bit"   # 12 Schr. -> 58 s, 24 GB

# EDIT_MODELLE — die vier Plätze des Bearbeiten-Modus. Eine Zeile pro Variante,
# Felder: MODELL | LORA (leer = keine) | QUANT (leer = Modellvorgabe) | SCHRITTE.
# Ein Modellwechsel ist genau EINE Zeile hier (plus das Label in EDIT_MODELLE in
# app.py). Das LoRA-Feld darf leer bleiben.
#
# Warum diese Belegung (Messungen 2026-07-14):
#   * Das 9B-Basismodell ist NACHWEISLICH ungefiltert — unzensiert braucht daher
#     keine LoRA. Das LoRA-Feld bleibt für B/D vorerst leer (Prüfung läuft noch).
#   * Das 4B-Modell ist für den UNZENSIERTEN Sparmodus UNGEEIGNET: es verdeckt bei
#     NSFW-Prompts die Genitalregion mit einem dunklen Fleck. Es bleibt deshalb
#     ausschließlich der ZENSIERTE Sparmodus (C).
edit_modell() {
  case "$1" in
    beste)        echo "$EDIT_9B_8BIT|||28" ;;  # A zensiert / beste
    beste-frei)   echo "$EDIT_9B_8BIT|||28" ;;  # B unzensiert / beste (ohne LoRA)
    sparsam)      echo "$EDIT_4B_4BIT|||12" ;;  # C zensiert / sparsam
    sparsam-frei) echo "$EDIT_9B_4BIT|||14" ;;  # D unzensiert / sparsam (NICHT 4B!)
    *)            echo "" ;;
  esac
}

MODE="quality"
EDIT_VARIANTE="beste"
EDIT_PFAD=""       # eigene Pipeline: Modellordner direkt, ohne die Tabelle
EDIT_LORA_ARG=""   # eigene Pipeline: LoRA direkt
WIDTH=1024; HEIGHT=1024
WIDTH_SET=0; HEIGHT_SET=0
MAXKANTE=1024
OUT=""; OPEN=1
STEPS=""; GUIDANCE=""
PROMPT=""
FREI=0
EDIT_IMAGES=()
SEEDS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --schnell) MODE="fast"; shift ;;
    --text)    MODE="text"; shift ;;
    --unzensiert)       FREI=1; shift ;;
    --unzensiert-gross) MODE="frei-gross"; shift ;;
    --bearbeiten) EDIT_IMAGES+=("$2"); MODE="edit"; shift 2 ;;
    --edit-modell) EDIT_VARIANTE="$2"; shift 2 ;;
    --edit-pfad)   EDIT_PFAD="$2"; shift 2 ;;
    --edit-lora)   EDIT_LORA_ARG="$2"; shift 2 ;;
    --breite)  WIDTH="$2"; WIDTH_SET=1; shift 2 ;;
    --hoehe)   HEIGHT="$2"; HEIGHT_SET=1; shift 2 ;;
    --maxkante) MAXKANTE="$2"; shift 2 ;;
    --schritte) STEPS="$2"; shift 2 ;;
    --guidance) GUIDANCE="$2"; shift 2 ;;
    --seed)    SEEDS+=("$2"); shift 2 ;;
    -o)        OUT="$2"; shift 2 ;;
    --kein-open) OPEN=0; shift ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         PROMPT="$1"; shift ;;
  esac
done

# --unzensiert allein ist der klein-9B-Modus; zusammen mit --bearbeiten schaltet
# es nur die NSFW-LoRA zum Edit-Modell dazu.
if [[ $FREI -eq 1 && "$MODE" != "edit" ]]; then
  MODE="frei"
fi

if [[ -z "$PROMPT" ]]; then
  echo "Fehler: kein Prompt. Aufruf: bild \"beschreibung des bildes\"" >&2
  exit 1
fi

[[ -z "$OUT" ]] && OUT="$HOME/Pictures/bild-$(date +%Y%m%d-%H%M%S).png"

# bash 3.2 + set -u: leeres Array expandieren crasht — deshalb Strings statt Arrays
SEED_ARG=""
if [[ ${#SEEDS[@]} -gt 0 ]]; then
  SEED_ARG="--seed ${SEEDS[*]}"
fi
GUIDANCE_ARG=""; [[ -n "$GUIDANCE" ]] && GUIDANCE_ARG="--guidance $GUIDANCE"

# auf ein Vielfaches von 16 runden, mindestens 16
runde16() {
  local v=$1
  v=$(( (v + 8) / 16 * 16 ))
  [[ $v -lt 16 ]] && v=16
  echo "$v"
}

# Zielmaße aus dem Quellbild: Seitenverhältnis behalten, längste Kante <= MAXKANTE
masse_aus_quelle() {
  local src="$1" dims sw sh longest
  dims=$(sips -g pixelWidth -g pixelHeight "$src" 2>/dev/null || true)
  sw=$(echo "$dims" | awk '/pixelWidth/ {print $2}')
  sh=$(echo "$dims" | awk '/pixelHeight/ {print $2}')
  if [[ -z "$sw" || -z "$sh" || "$sw" -le 0 || "$sh" -le 0 ]]; then
    echo "Warnung: Maße von $src nicht lesbar — nutze ${WIDTH}x${HEIGHT}." >&2
    return 0
  fi
  longest=$sw
  [[ $sh -gt $longest ]] && longest=$sh
  if [[ $longest -gt $MAXKANTE ]]; then
    sw=$(( sw * MAXKANTE / longest ))
    sh=$(( sh * MAXKANTE / longest ))
  fi
  if [[ $WIDTH_SET -eq 0 ]]; then WIDTH=$(runde16 "$sw"); fi
  if [[ $HEIGHT_SET -eq 0 ]]; then HEIGHT=$(runde16 "$sh"); fi
  # WICHTIG: explizit 0 — sonst erbt die Funktion den Status des letzten Tests
  # und `set -e` beendet das Skript still, sobald --breite/--hoehe gesetzt sind.
  return 0
}

case "$MODE" in
  fast)
    echo "Schnell-Modus (Z-Image-Turbo, ~10 Sek) ..."
    mflux-generate-z-image-turbo --prompt "$PROMPT" \
      --width "$WIDTH" --height "$HEIGHT" --steps "${STEPS:-8}" -q 4 \
      $SEED_ARG $GUIDANCE_ARG --output "$OUT"
    ;;
  text)
    echo "Text-Modus (Qwen-Image 20B, ~3 Min — nichts Großes parallel laufen lassen) ..."
    mflux-generate-qwen --model "$MODELL_QWEN" \
      --prompt "$PROMPT" --width "$WIDTH" --height "$HEIGHT" --steps "${STEPS:-30}" \
      $SEED_ARG $GUIDANCE_ARG --output "$OUT"
    ;;
  quality)
    echo "Qualitäts-Modus (FLUX.2-klein-9B, ~1 Min) ..."
    mflux-generate-flux2 --model "$MODELL_KLEIN9B" \
      --prompt "$PROMPT" --width "$WIDTH" --height "$HEIGHT" --steps "${STEPS:-28}" \
      $SEED_ARG $GUIDANCE_ARG --output "$OUT"
    ;;
  frei)
    echo "UNZENSIERT-Modus (FLUX.2-klein-9B + NSFW-LoRA, ~1 Min) ..."
    mflux-generate-flux2 --model "$MODELL_KLEIN9B" \
      --lora-paths "$LORA_NSFW" \
      --prompt "$PROMPT" --width "$WIDTH" --height "$HEIGHT" --steps "${STEPS:-28}" \
      $SEED_ARG $GUIDANCE_ARG --output "$OUT"
    ;;
  frei-gross)
    echo "UNZENSIERT-Modus groß (Qwen-Image 20B + NSFW-LoRA, ~3 Min) ..."
    mflux-generate-qwen --model "$MODELL_QWEN" \
      --lora-paths "$LORA_NSFW_QWEN" \
      --prompt "$PROMPT" --width "$WIDTH" --height "$HEIGHT" --steps "${STEPS:-30}" \
      $SEED_ARG $GUIDANCE_ARG --output "$OUT"
    ;;
  edit)
    for img in "${EDIT_IMAGES[@]}"; do
      if [[ ! -f "$img" ]]; then
        echo "Fehler: Quellbild nicht gefunden: $img" >&2
        exit 1
      fi
    done
    masse_aus_quelle "${EDIT_IMAGES[0]}"
    if [[ -n "$EDIT_PFAD" ]]; then
      # eigene Pipeline aus dem UI: Modell/LoRA direkt, Tabelle wird übersprungen
      EDIT_MODELL="$EDIT_PFAD"; EDIT_LORA="$EDIT_LORA_ARG"
      EDIT_QUANT=""; EDIT_STEPS=28
      VARIANTE="pipeline"
    else
      VARIANTE="$EDIT_VARIANTE"
      [[ $FREI -eq 1 ]] && VARIANTE="$EDIT_VARIANTE-frei"
      ZEILE="$(edit_modell "$VARIANTE")"
      if [[ -z "$ZEILE" ]]; then
        echo "Fehler: unbekanntes Edit-Modell: $VARIANTE" >&2
        exit 1
      fi
      IFS='|' read -r EDIT_MODELL EDIT_LORA EDIT_QUANT EDIT_STEPS <<< "$ZEILE"
    fi
    LORA_ARG=""; [[ -n "$EDIT_LORA" ]] && LORA_ARG="--lora-paths $EDIT_LORA"
    QUANT_ARG=""; [[ -n "$EDIT_QUANT" ]] && QUANT_ARG="-q $EDIT_QUANT"
    echo "Bearbeiten-Modus ($VARIANTE) ..."
    echo "Quelle: ${EDIT_IMAGES[*]} — Ausgabe ${WIDTH}x${HEIGHT}"
    mflux-generate-flux2-edit --model "$EDIT_MODELL" \
      --image-paths "${EDIT_IMAGES[@]}" \
      --prompt "$PROMPT" --width "$WIDTH" --height "$HEIGHT" \
      --steps "${STEPS:-$EDIT_STEPS}" \
      $LORA_ARG $QUANT_ARG $SEED_ARG $GUIDANCE_ARG --output "$OUT"
    ;;
esac

echo "Fertig: $OUT"
if [[ $OPEN -eq 1 ]]; then open "$OUT"; fi
