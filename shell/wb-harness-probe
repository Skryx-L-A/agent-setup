sys.stdout.write("══ REGISTRY-ENTWURF (Vorschlag, KEIN Eintrag) ══════════════════════════════\n")
sys.stdout.write(json.dumps(ausgabe, indent=2, ensure_ascii=False) + "\n")
if JSONOUT:
    with open(JSONOUT, "w") as fh:
        json.dump(ausgabe, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    sys.stdout.write("\nEntwurf auch in: %s\n" % JSONOUT)
PY
}

