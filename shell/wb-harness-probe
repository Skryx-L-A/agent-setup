#!/bin/bash
# wb-harness-probe — den Harness-Vertrag messen und einen Registry-ENTWURF ausgeben.
#
#   wb-harness-probe <harness-id> [<model-id>] [--seconds <n>] [--real-home]
#                    [--aufnahme <verzeichnis>] [--json <datei>]
#                    [--only <punkte>] [--skip <punkte>] [--spawn-beleg]
#                    [--models-file <pfad>]
#   wb-harness-probe analyze <aufnahme-verzeichnis> [--json <datei>]
#
# No CLI documents which glyph means "ready for input" (SPEC-V3 H) — and a task
# pasted into a still-booting TUI disappears without a trace, which has happened
# twice. So an adapter without a MEASURED readyPattern is not startable, and this
# is the tool that measures it: it starts the harness, records the rendered screen
# for up to 60s, proposes an ANCHORED pattern and prints the command that records it.
#
# SEIT 2026-08-08 misst es nicht mehr nur das readyPattern, sondern den GANZEN
# Vertrag — die neun Punkte, die bisher jeder Harness-Einbau von vorn beantwortet
# hat. Anlass: zehn Harnesses sind eingebaut, jeder hat rund eine Stunde gekostet,
# und `bradAGI/awesome-cli-coding-agents` fuehrt ueber sechzig. Einzeln geht das
# nicht auf.
#
#   1 readyPattern     in DREI Zustaenden (leer, getippt, laufende Antwort)
#   2 promptPattern    in der Form, die pi-worker wirklich benutzt, samt der drei
#                      bekannten Fallen
#   3 Kontext          Prozentanzeige in den letzten fuenf Zeilen, sonst Sitzungsdatei
#   4 systemPrompt     Kennwort-Probe ueber die Kandidatendateien
#   5 resume           der Dreiklang (Kennwort / ohne Flag leer / mit Flag Verlauf)
#   6 trustStore       Vertrauensdialog beim Erststart in einem FRISCHEN Verzeichnis
#   7 autonomy.args    aus der Hilfe, plus der Sonderfall Umgebungsvariable
#   8 discover         Unterbefehl, der Modelle auflistet
#   9 probe / notes    was gemessen wurde, mit Version und Datum — und was NICHT
#
# DER ENTWURF IST EIN VORSCHLAG, KEIN EINTRAG. Dieses Werkzeug schreibt NICHTS in
# die Registry. Es druckt JSON, das ein Mensch oder ein Orchestrator liest, prueft
# und uebernimmt, und jedes Feld traegt seine HERKUNFT: "gemessen", "aus der Hilfe
# gelesen" oder "nicht ermittelbar" mit Grund. Ein geratenes Feld ist schlimmer als
# ein leeres — ein leeres sieht man, ein geratenes glaubt man.
#
# WAS DER BAUKASTEN NICHT ERSETZT: den Spawn-Beleg. Ein Harness gilt erst als
# integriert, wenn ein echter `pi-worker`-Lauf einen Auftrag angenommen und seine
# Ergebnisdatei geschrieben hat. `--spawn-beleg` bereitet diesen Schritt vor und
# nennt ihn beim Namen; unterstellt wird er nie.
#
# VORAUSSETZUNG (2026-08-09): <harness-id> muss in der Registry stehen (`wb-state harness
# get`) — ohne Eintrag bricht die Probe sofort mit "Harness '<id>' ist nicht registriert"
# ab, noch bevor irgendetwas gemessen wird. Fuer den ERSTEINBAU, wenn der Harness noch
# nirgends eingetragen ist, zeigt `--models-file <pfad>` auf eine EIGENE Registry-Datei
# (Kopie von `shell/models.default.json` plus ein Entwurfseintrag) statt der echten
# `~/.claude/workbench/models.json` — die Probe misst dann gegen den ENTWURF, und die
# echte Registry bleibt unberuehrt. Der Pfad muss existieren und lesbar sein, sonst
# FEHLER (kein stiller Rueckfall auf die echte Registry). Intern: `WB_MODELS_FILE` in
# `wb-state`.
#
# ZWEI TEILE, EINE DATEI. Der MESSTEIL faehrt Panes und zeichnet Bildschirme auf,
# der AUSWERTETEIL (`analyze`) liest ausschliesslich die Aufzeichnung und baut den
# Entwurf. Die Naht dazwischen ist der Grund fuer den Schnitt: die Auswertung ist
# damit gegen aufgezeichnete Bildschirme testbar, ohne dass irgendein Werkzeug
# installiert sein muss (shell/tests/test-harness-baukasten.sh).
#
# It never touches the live workbench:
#   * own tmux server   (tmux -L wbprobe)   — never the session der Nutzer is in
#   * own HOME          (mktemp -d)         — never the real configuration
#   * `unset TMUX TMUX_PANE` right at the top: a helper that inherits $TMUX talks
#     to the LIVE server no matter which socket this script uses ($TMUX beats
#     TMUX_TMPDIR, measured 2026-07-25).
#   * cleanup kills only its OWN session name and its OWN socket — never a pattern
#     like "wb-", which has already killed the user's live client twice.
#
# Der Sockelname trug bis zum 2026-08-04 keine PID. Zwei gleichzeitige Proben teilten sich
# damit einen Server, und das Aufraeumen der einen riss der anderen den Server unter den
# Fuessen weg. Gemessen an genau diesem Tag: zwei parallele Laeufe von
# shell/tests/test-registry.sh, einer davon mit zwei Fehlschlaegen ("probe schlaegt ein
# Muster vor", "probe sah die Eingabezeile"), der andere gruen. Deshalb PID im Namen, wie
# bei jeder Testsuite auch. WB_PROBE_SOCK ueberschreibt ihn, damit ein Test den Namen
# kennen und danach pruefen kann, dass der Server wirklich weg ist.
unset TMUX TMUX_PANE
set -uo pipefail

SOCK="${WB_PROBE_SOCK:-wbprobe-$$}"
SECONDS_MAX=60
REAL_HOME=""
HID=""; MID=""; AUFNAHME=""; JSONOUT=""; ONLY=""; SKIP=""; SPAWNBELEG=""; MODELSFILE_OPT=""
MODE="messen"

# `analyze` ist ein eigener Einstieg und darf keine der Messoptionen verlangen.
if [ "${1:-}" = "analyze" ]; then MODE="analyze"; shift; fi

while [ $# -gt 0 ]; do
  case "$1" in
    --seconds) SECONDS_MAX="${2:?n}"; shift 2 ;;
    --real-home) REAL_HOME=1; shift ;;
    --aufnahme) AUFNAHME="${2:?verzeichnis}"; shift 2 ;;
    --json) JSONOUT="${2:?datei}"; shift 2 ;;
    --only) ONLY="${2:?punkte}"; shift 2 ;;
    --skip) SKIP="${2:?punkte}"; shift 2 ;;
    --spawn-beleg) SPAWNBELEG=1; shift ;;
    --models-file) MODELSFILE_OPT="${2:?pfad}"; shift 2 ;;
    -h|--help) sed -n '2,52p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "wb-harness-probe: unbekannte Option '$1'" >&2; exit 1 ;;
    *) if [ -z "$HID" ]; then HID="$1"; else MID="$1"; fi; shift ;;
  esac
done

# --models-file (2026-08-09): biegt jeden wb-state-Aufruf DIESES Laufs auf eine eigene
# Registry um (WB_MODELS_FILE, siehe dort). Der Pfad wird HIER geprueft, nicht erst dem
# ersten `wb-state harness get` ueberlassen — ein Tippfehler soll eine klare Meldung
# geben und nicht das Verhalten "leere Registry, faellt auf eingebaute Adapter zurueck"
# annehmen, das fuer den unbesetzten Regelfall richtig, hier aber Verschleierung waere.
if [ -n "$MODELSFILE_OPT" ]; then
  [ -r "$MODELSFILE_OPT" ] || {
    echo "FEHLER: --models-file '$MODELSFILE_OPT' ist nicht lesbar — kein Lauf." >&2
    exit 1
  }
  export WB_MODELS_FILE="$MODELSFILE_OPT"
  echo "wb-harness-probe: WB_MODELS_FILE=$WB_MODELS_FILE — misst gegen diese Registry, nicht die echte." >&2
fi

# ── Punktfilter ────────────────────────────────────────────────────────────────
# --only/--skip nennen die NUMMERN der neun Punkte. Gefiltert wird die MESSUNG,
# nicht die Auswertung: ein uebersprungener Punkt erscheint im Entwurf als "nicht
# ermittelbar, Grund: uebersprungen (--skip)". Eine Luecke stillschweigend
# auszulassen waere genau das Schoenen, gegen das die Herkunftsangabe gebaut ist.
punkt_an() {
  local n="$1"
  if [ -n "$ONLY" ]; then case ",$ONLY," in *",$n,"*) ;; *) return 1 ;; esac; fi
  if [ -n "$SKIP" ]; then case ",$SKIP," in *",$n,"*) return 1 ;; esac; fi
  return 0
}

# ══════════════════════════════════════════════════════════════════════════════
# AUSWERTUNG — liest NUR die Aufzeichnung, startet nichts.
# ══════════════════════════════════════════════════════════════════════════════
# Steht vor dem Messteil, weil `analyze` sie allein benutzt. Sie bekommt das
# Aufnahmeverzeichnis und schreibt Bericht (stdout) und Entwurf (JSON).
auswerten() {
  local dir="$1" jsonout="${2:-}"
  /usr/bin/python3 - "$dir" "$jsonout" <<'PY'
import json, os, re, sys

DIR, JSONOUT = sys.argv[1], sys.argv[2]

def lies(name):
    p = os.path.join(DIR, name)
    try:
        return open(p, encoding="utf-8", errors="replace").read()
    except OSError:
        return None

def liesjson(name, default=None):
    t = lies(name)
    if t is None:
        return default
    try:
        return json.loads(t)
    except Exception:
        return default

META = liesjson("meta.json", {}) or {}
HID = META.get("harness") or "?"

# Herkunft ist ein Vertrag, kein Freitext: genau drei Werte, und "raten" ist keiner.
def feld(wert, herkunft, grund="", belege=None):
    d = {"wert": wert, "herkunft": herkunft}
    if grund:
        d["grund"] = grund
    if belege:
        d["belege"] = belege
    return d

def offen(grund):
    return feld(None, "nicht ermittelbar", grund)

# 2026-08-11: 'session' loest 'contextSession' ab (SPEC-V4 6.3, Kopfkommentar von
# shell/models.default.json) -- der GEMEINSAME Block ueber die Gespraechsquelle, den
# context-guard UND die Chat-Ansicht lesen. probe.datum bleibt hier IMMER leer: das
# ist ein ENTWURF, kein Registry-Eintrag, und "OHNE Messdatum kein Eintrag" gilt erst,
# wenn ein Mensch ihn uebernimmt.
def session_wert(via, grund=None, ort=None, format=None, zuordnung="", live=False,
                  zeigtNicht=None, ablage=None, beleg=None):
    d = {"via": via, "ort": ort, "format": format, "maxAgeSec": None,
         "zuordnung": zuordnung, "live": live, "eingabe": "pane",
         "zeigtNicht": zeigtNicht or [],
         "probe": {"datum": None, "beleg": beleg}}
    if via == "":
        d["grund"] = grund or ""
    if ablage:
        d["ablage"] = ablage
    return d

ENTWURF = {}
BERICHT = []

def sag(*zeilen):
    BERICHT.extend(zeilen)

# ── Kandidaten fuer Zeilenmuster ───────────────────────────────────────────────
# Drei Bauarten, weil die zehn gemessenen TUIs genau drei Sorten Eingabezeile
# haben: ein Prompt-Zeichen am Zeilenanfang (aider, goose, agy, codex), eine
# beschriftete Kastenkante (kimi: '── input ─────') und eine Fusszeile mit einem
# Tastaturhinweis (opencode: 'ctrl+p commands'). Rahmen-/Boxzeichen allein sind
# NIE ein Muster — sie stehen beim Booten schon da (aider 0.86.2, 2026-07-28).
PROMPTZEICHEN = "❯>›»▶$#%◆●"
RAHMEN = lambda c: 0x2500 <= ord(c) <= 0x257F


def kandidaten(text):
    """Musterkandidaten aus einem gerenderten Bildschirm. Jeder Kandidat traegt,
    WIE er entstanden ist — das steht spaeter im Bericht, damit ein Mensch die
    Herleitung nachvollziehen kann statt einem Regex zu glauben."""
    aus = []
    zeilen = [z.rstrip() for z in (text or "").splitlines()]
    nichtleer = [z for z in zeilen if z.strip()]
    if not nichtleer:
        return aus

    # (a) Prompt-Zeichen, verankert auf die letzte nicht-leere Zeile.
    letzte = nichtleer[-1]
    t = letzte.lstrip()
    if t and not RAHMEN(t[0]) and t[0] in PROMPTZEICHEN:
        lead = letzte[:len(letzte) - len(t)]
        aus.append({"muster": "^" + re.escape(lead) + re.escape(t[0]),
                    "art": "Prompt-Zeichen am Anfang der letzten nicht-leeren Zeile"})

    # (b) beschriftete Kastenkante: '── input ───…' / '┌─ chat ─'. Verankert bis
    # EINSCHLIESSLICH des Zeichens hinter der Beschriftung, damit das Muster die
    # Kante meint und nicht irgendeine Zeile, die zufaellig 'input' enthaelt.
    #
    # Gesucht wird im GANZEN Bildschirm, nicht in den letzten Zeilen. Bei kimi 1.49.0
    # steht '── input ───…' in Zeile 15 von 50, weil die Eingabebox oben sitzt und
    # darunter noch die Statuszeile und eine Fusszeile folgen (gemessen 2026-08-08).
    # Mit dem Fenster der letzten zwoelf Zeilen fand die Probe sie nicht und meldete
    # 'keine Eingabezeile erkennbar' — bei einem Harness, der sie deutlich anschreibt.
    for z in zeilen:
        m = re.match(r"^([─-╿]{2,})\s*([A-Za-z][A-Za-z0-9 _-]{0,14}?)\s*[─-╿]", z)
        if m:
            k = "^" + re.escape(m.group(1) + " " + m.group(2) + " ") + "[─-╿]"
            if not any(x["muster"] == k for x in aus):
                aus.append({"muster": k, "art": "beschriftete Kastenkante der Eingabebox"})

    # (c) Tastaturhinweis in der Fusszeile. NICHT verankert: die Fusszeile wandert
    # mit der Fensterbreite, und opencode traegt sie mitten in einer Zeile.
    for z in nichtleer[-8:]:
        for m in re.finditer(r"(ctrl\+[a-z])\s+([a-z]{3,12})", z, re.I):
            k = m.group(1).replace("+", "\\+") + " " + m.group(2)
            if not any(x["muster"] == k for x in aus):
                aus.append({"muster": k, "art": "Tastaturhinweis in der Fusszeile"})
    return aus


def trifft(muster, text):
    if text is None:
        return False
    try:
        return re.search(muster, text, re.M) is not None
    except re.error:
        return False


# ══ Punkt 1 — readyPattern in drei Zustaenden ═════════════════════════════════
LEER = lies("ready-leer.txt")
GETIPPT = lies("ready-getippt.txt")
LAUFEND = lies("ready-laufend.txt")

# Der Gegenprobe-Bildschirm. Ein Muster, das schon VOR der Eingabebereitschaft
# trifft, feuert, waehrend das Modell noch laedt — und ein Task, der dann eingefuegt
# wird, verschwindet. Zwei Gegenproben, und sie sind verschieden viel wert:
#   * ein LEERER Bildschirm (hier synthetisch) schliesst jedes Muster aus, das auf
#     Nichts trifft. Diese Probe gilt immer.
#   * die frueheste Abtastung gilt nur dann als Boot-Bildschirm, wenn sie sich vom
#     fertigen Bild UNTERSCHEIDET. Bei goose erschien die TUI schon im ersten
#     0,4-s-Schritt; die frueheste Abtastung IST dort der fertige Bildschirm, und
#     sie als Gegenprobe zu nehmen wuerde jedes richtige Muster verwerfen.
LEERSCHIRM = "\n\n   \n\n"
_boot_roh = lies("boot-fruehestens.txt")
BOOT = None
BOOT_HINWEIS = ""
if _boot_roh is not None and _boot_roh.strip():
    if LEER is not None and _boot_roh.strip() == (LEER or "").strip():
        BOOT_HINWEIS = ("die TUI stand schon im ersten Abtastschritt (0,4 s) — es gibt keinen "
                        "Boot-Bildschirm zum Gegenpruefen. Das ist selbst ein Messergebnis: das "
                        "Muster ist nicht frueher da als die Eingabebereitschaft.")
    else:
        BOOT = _boot_roh
        BOOT_HINWEIS = "die frueheste Abtastung unterscheidet sich vom fertigen Bild — sie gilt als Boot-Bildschirm."
else:
    BOOT_HINWEIS = "die frueheste Abtastung war leer."

sag("── 1 readyPattern ─────────────────────────────────────────────────────────")
if BOOT_HINWEIS:
    sag("  Gegenprobe: %s" % BOOT_HINWEIS)
if LEER is None:
    ENTWURF["readyPattern"] = offen("Punkt 1 wurde nicht gemessen (uebersprungen oder Start gescheitert)")
    sag("  nicht gemessen.")
else:
    kand = []
    for quelle, txt in (("leer", LEER), ("getippt", GETIPPT), ("laufend", LAUFEND)):
        for k in kandidaten(txt):
            if not any(x["muster"] == k["muster"] for x in kand):
                k["gefunden_in"] = quelle
                kand.append(k)
    for k in kand:
        k["zustaende"] = [z for z, t in (("leer", LEER), ("getippt", GETIPPT), ("laufend", LAUFEND))
                          if trifft(k["muster"], t)]
        k["trifft_bootschirm"] = trifft(k["muster"], BOOT)
        k["trifft_leerschirm"] = trifft(k["muster"], LEERSCHIRM)
        k["alle_drei"] = len(k["zustaende"]) == 3
        k["empfohlen"] = bool(k["alle_drei"] and not k["trifft_bootschirm"]
                              and not k["trifft_leerschirm"])
    empf = [k for k in kand if k["empfohlen"]]
    if empf:
        ENTWURF["readyPattern"] = feld(empf[0]["muster"], "gemessen",
                                       "trifft alle drei Zustaende (leer, getippt, laufende Antwort) "
                                       "und nicht den leeren Startbildschirm",
                                       belege=kand)
    elif kand:
        ENTWURF["readyPattern"] = offen(
            "kein Kandidat trifft alle drei Zustaende — ein Muster, das nur den leeren "
            "Zustand trifft, verschwindet beim ersten Tastendruck (der opencode-Fehler). "
            "Kandidaten stehen unter 'belege'.")
        ENTWURF["readyPattern"]["belege"] = kand
    else:
        ENTWURF["readyPattern"] = offen(
            "auf dem aufgezeichneten Bildschirm ist keine Eingabezeile der drei bekannten "
            "Bauarten zu erkennen (Prompt-Zeichen / beschriftete Kastenkante / Fusszeilen-Hinweis)")
    # Die eine Zeile, die ein Mensch sucht — und an der die Registry-Suite haengt.
    if empf:
        sag("  VORSCHLAG readyPattern: %s" % empf[0]["muster"])
    else:
        sag("  KEIN VORSCHLAG: kein Kandidat trifft alle drei Zustaende.")
    for k in kand:
        sag("  %-38s %-10s Zustaende: %-26s %s"
            % (k["muster"], "EMPFOHLEN" if k["empfohlen"] else "",
               ",".join(k["zustaende"]) or "keiner",
               ("TRIFFT AUCH DEN BOOTSCHIRM" if k["trifft_bootschirm"] else "")
               + (" TRIFFT DEN LEEREN BILDSCHIRM" if k["trifft_leerschirm"] else "")))
        sag("      %s" % k["art"])
    if not empf:
        sag("  KEIN Kandidat trifft alle drei Zustaende — nichts empfohlen.")

# ══ Punkt 2 — promptPattern / promptIgnore ════════════════════════════════════
# Geprueft wird in der Form, die pi-worker WIRKLICH benutzt:
#     zeile=$(grep -E "<muster>" <bildschirm> | tail -1)
#     grep -qE "<muster>[[:space:]]+[^[:space:]]"  <<< "$zeile"    # haengt noch?
# Jede andere Form misst etwas anderes als der Betrieb.
sag("", "── 2 promptPattern / promptIgnore ─────────────────────────────────────────")


def letzte_trefferzeile(muster, text):
    if text is None:
        return None
    tr = [z for z in text.splitlines() if re.search(muster, z)]
    return tr[-1] if tr else None


def haengt(muster, zeile):
    if zeile is None:
        return False
    return re.search(muster + r"[ \t]+[^ \t]", zeile) is not None


if GETIPPT is None or LEER is None:
    ENTWURF["promptPattern"] = offen("Punkt 2 wurde nicht gemessen")
    sag("  nicht gemessen.")
else:
    marke = META.get("tippmarke") or ""
    pk = []
    for k in kandidaten(GETIPPT) + kandidaten(LEER):
        if any(x["muster"] == k["muster"] for x in pk):
            continue
        m = k["muster"]
        zg = letzte_trefferzeile(m, GETIPPT)
        zl = letzte_trefferzeile(m, LEER)
        fallen = []
        # FALLE A — ein Muster, das selbst auf Leerraum endet, verlangt anschliessend
        # ein ZWEITES Leerzeichen und trifft nie: jeder haengende Auftrag gaelte als
        # abgeschickt (goose, 2026-08-08).
        if re.search(r"(\\?[ \t]|\[\[:space:\]\]|\\s)$", m):
            fallen.append("Muster endet auf Leerraum — die Pruefung verlangt danach ein "
                          "ZWEITES Leerzeichen und trifft nie; jeder haengende Auftrag "
                          "gaelte als abgeschickt")
        # FALLE B — die letzte Trefferzeile ist gar nicht die Eingabezeile, sondern
        # eine zweite Zeile mit demselben Zeichen darunter (opencode: die Statuszeile
        # ist immer die unterste Kastenzeile).
        if zg is not None and marke and marke not in zg:
            fallen.append("die letzte Trefferzeile ist nicht die Eingabezeile, sondern "
                          "'%s' — darunter steht eine zweite Zeile derselben Form" % zg.strip()[:60])
        # FALLE C — die LEERE Box traegt einen Platzhalter; ohne promptIgnore meldete
        # jeder Auftrag "haengt noch" (codex 0.145).
        pign = None
        if haengt(m, zl):
            # Nur die ersten Woerter des Platzhalters, nicht die ganze Zeile: der
            # Rest ist Tastaturhinweis und aendert sich mit jeder Fassung des
            # Werkzeugs. Ein promptIgnore, das an einer Versionsnummer haengt, ist
            # beim naechsten Update still kaputt.
            roh = (zl or "").strip()
            kurz = " ".join(roh.split()[:4])
            pign = "^" + re.escape(kurz)
            fallen.append("die LEERE Eingabezeile traegt einen Platzhalter ('%s') — ohne "
                          "promptIgnore meldete jeder Auftrag 'haengt noch'" % (zl or "").strip()[:60])
        k2 = dict(k)
        k2.update({"zeile_getippt": zg, "zeile_leer": zl,
                   "haengt_bei_text": haengt(m, zg),
                   "haengt_bei_leer": haengt(m, zl),
                   "fallen": fallen,
                   "promptIgnore_vorschlag": pign})
        k2["brauchbar"] = bool(k2["haengt_bei_text"] and (not k2["haengt_bei_leer"] or pign)
                               and not any(f.startswith("die letzte Trefferzeile") for f in fallen))
        pk.append(k2)
    gut = [k for k in pk if k["brauchbar"]]
    if gut:
        ENTWURF["promptPattern"] = feld(gut[0]["muster"], "gemessen",
                                        "trifft die Eingabezeile mit Text in der Form, die pi-worker "
                                        "benutzt, und meldet die leere Box nicht als haengend",
                                        belege=pk)
        ENTWURF["promptIgnore"] = (feld(gut[0]["promptIgnore_vorschlag"], "gemessen",
                                        "Platzhalter der leeren Eingabezeile")
                                   if gut[0]["promptIgnore_vorschlag"]
                                   else feld(None, "gemessen", "die leere Eingabezeile traegt keinen "
                                                              "Platzhalter — promptIgnore ist unnoetig"))
    else:
        ENTWURF["promptPattern"] = feld(
            None, "gemessen",
            "KEIN promptPattern moeglich — und das ist ein Messergebnis, kein Versaeumnis. "
            "Kein Kandidat erfuellt beides: die Eingabezeile treffen UND bei getipptem Text "
            "anschlagen. Der Spawn sagt dann ehrlich 'Submission NICHT verifizierbar' statt "
            "einen haengenden Auftrag als abgeschickt zu melden (kimi, opencode).",
            belege=pk)
        ENTWURF["promptIgnore"] = feld(None, "gemessen", "ohne promptPattern gegenstandslos")
    for k in pk:
        sag("  %-38s %s" % (k["muster"],
                            "BRAUCHBAR" if k["brauchbar"] else "unbrauchbar"))
