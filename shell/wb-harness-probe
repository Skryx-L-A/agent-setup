# ══ Punkt 3 — Kontextauslastung ═══════════════════════════════════════════════
# Die Kontextwache liest die letzten FUENF Zeilen des Panes. Was weiter oben
# steht, sieht sie nie — deshalb wird hier auch genau dort gesucht.
sag("", "── 3 Kontextauslastung ────────────────────────────────────────────────────")
PROZENT = re.compile(r"([0-9]{1,3})(?:\.[0-9]+)?\s?%")
PAAR = re.compile(r"[0-9]+(?:\.[0-9]+)?[kKmM]?\s?/\s?[0-9]+(?:\.[0-9]+)?[kKmM]")


def letzte_fuenf(text):
    """Genau das Fenster, das die Kontextwache liest — nachgebaut, nicht idealisiert.
    Sie holt `cap=$(tmux capture-pane -p …)`, und die Kommando-Ersetzung schneidet
    ABSCHLIESSENDE Leerzeilen weg; erst danach kommt `tail -5`. Wer hier stur die
    letzten fuenf Zeilen der Rohaufnahme nimmt, sieht bei einem 50-Zeilen-Pane fuenf
    leere Zeilen und meldet 'keine Anzeige', obwohl der Balken zwei Zeilen darueber
    steht (gemessen an der ersten goose-Aufnahme, 2026-08-08)."""
    z = (text or "").splitlines()
    while z and not z[-1].strip():
        z.pop()
    return "\n".join(z[-5:])


ctx_treffer = []
for name, txt in (("leer", LEER), ("getippt", GETIPPT), ("laufend", LAUFEND),
                  ("nach-zug", lies("kontext-nach-zug.txt"))):
    if txt is None:
        continue
    f5 = letzte_fuenf(txt)
    for z in f5.splitlines():
        if PROZENT.search(z):
            ctx_treffer.append({"zustand": name, "zeile": z.strip(),
                                "hat_paar": bool(PAAR.search(z))})
SITZUNG = liesjson("sitzungsdateien.json", []) or []
if ctx_treffer:
    # Verankert wird NACH RECHTS, nicht nach links, und nie an einem Rahmenzeichen.
    # Links vom Prozentwert steht bei goose und aehnlichen TUIs der Fortschrittsbalken
    # ('╌╌╌╌' vor dem Zug, '━╌╌╌' danach) — ein Muster mit diesem Vorspann trifft
    # genau den Startzustand und danach nie wieder. Rechts steht dagegen das
    # Zahlenpaar, und dessen FORM ('4k/128k') aendert sich nicht. Dieselbe Regel wie
    # beim readyPattern: Rahmen-/Boxzeichen sind nie Teil eines Musters.
    treffer_zeilen = [t["zeile"] for t in ctx_treffer]
    z = treffer_zeilen[-1]
    m = PROZENT.search(z)
    komma = r"\.[0-9]+" if "." in m.group(0) else ""
    kern = r"([0-9]{1,3})" + komma + r"\s?%"
    nach = z[m.end():]
    paar = PAAR.search(nach)
    if paar and paar.start() <= 3:
        zwischen = re.escape(nach[:paar.start()]) if nach[:paar.start()] else ""
        muster = kern + zwischen + r"\s?[0-9.]+[kKmM]?/[0-9.]+[kKmM]?"
        grund = ("Prozentanzeige in den letzten fuenf Zeilen, nach RECHTS auf das Zahlenpaar "
                 "verankert. Der Balken links davon aendert sich von Zug zu Zug und taugt "
                 "nicht als Anker; Rahmenzeichen kommen in kein Muster.")
    else:
        wort = re.search(r"([A-Za-z][A-Za-z ]{2,14}?)[: ]+$", z[:m.start()])
        vor = re.escape(wort.group(1).strip()) + r"[: ]+" if wort else ""
        muster = vor + kern
        grund = ("Prozentanzeige in den letzten fuenf Zeilen%s. Kein Zahlenpaar dahinter, "
                 "also am Beschriftungswort davor verankert — Rahmenzeichen kommen in kein "
                 "Muster." % (", verankert an '%s'" % wort.group(1).strip() if wort else ""))
    # Gegenprobe an ALLEN Trefferzeilen: ein Muster, das nur den Startbildschirm
    # trifft, meldete spaeter jeden Pane als 0 % — schlimmer als gar kein Muster.
    passt_ueberall = all(re.search(muster, t) for t in treffer_zeilen)
    ENTWURF["contextPattern"] = feld(
        muster, "gemessen" if passt_ueberall else "nicht ermittelbar",
        grund + (" Es trifft alle %d aufgezeichneten Anzeigezeilen." % len(treffer_zeilen)
                 if passt_ueberall else
                 " ACHTUNG: es trifft NICHT jede aufgezeichnete Anzeigezeile — so nicht "
                 "eintragen, sonst meldet die Wache spaeter falsche Zahlen."),
        belege=ctx_treffer)
    for t in ctx_treffer:
        sag("  %-9s %s%s" % (t["zustand"], t["zeile"][:100],
                             "   (traegt auch das Zahlenpaar)" if t["hat_paar"] else ""))
    sag("  Vorschlag: %s" % muster)
else:
    if SITZUNG:
        ENTWURF["contextPattern"] = feld(None, "gemessen",
                                         "keine Prozentanzeige in den letzten fuenf Zeilen — dieser "
                                         "Harness zeigt seine Auslastung nicht an")
        sag("  keine Prozentanzeige. Sitzungsdateien, die waehrend der Messung geschrieben wurden:")
    else:
        ENTWURF["contextPattern"] = offen(
            "keine Prozentanzeige in den letzten fuenf Zeilen UND keine Sitzungsdatei mit "
            "Tokenzahlen gefunden — DIESER HARNESS BLEIBT UNBEWACHT. Das ist eine Aussage, "
            "kein fehlendes Feld: der Guard behandelt solche Panes als UNBEKANNT, nie als "
            "unkritisch. Nichts wird geschaetzt.")
        sag("  keine Prozentanzeige und keine Sitzungsdatei mit Tokenzahlen —"
            " DIESER HARNESS BLIEBE UNBEWACHT.")
if SITZUNG:
    mit = [s for s in SITZUNG if s.get("hat_tokenzahlen")]
    for s in SITZUNG:
        sag("  %-58s %s" % (s.get("pfad", "?"),
                            "TOKENZAHLEN GEFUNDEN" if s.get("hat_tokenzahlen") else "keine Tokenzahl"))
    if mit and ctx_treffer:
        # Zeigt der Bildschirm die Auslastung, ist eine Sitzungsquelle UNNOETIG —
        # nicht offen. Die Wache liest die Anzeige, und eine zweite Quelle zu bauen,
        # um dieselbe Zahl noch einmal zu holen, waere Aufwand ohne Gewinn (so steht
        # es auch in den Handeintraegen von goose und kimi). Die gefundene Datei
        # bleibt als 'ablage' vermerkt, falls die Anzeige spaeter wegfaellt.
        ENTWURF["session"] = feld(
            session_wert(
                "", grund=("unnoetig: die Anzeige nennt die Zahlen selbst (siehe "
                           "contextPattern). Der Harness schreibt sie zwar auch in eine "
                           "Datei, aber eine zweite Quelle fuer dieselbe Zahl ist Aufwand "
                           "ohne Gewinn."),
                zeigtNicht=["freigabedialog", "arbeits-anzeige"],
                ablage=mit[0].get("pfad"),
                beleg="Sitzungsdatei(en) mit Tokenzahlen gefunden, aber die Bildschirmanzeige "
                      "deckt die Kontextwache bereits ab (siehe contextPattern)."),
            "gemessen",
            "unnoetig: die Anzeige nennt die Zahlen selbst (siehe contextPattern). Der "
            "Harness schreibt sie zwar auch in eine Datei, aber eine zweite Quelle fuer "
            "dieselbe Zahl ist Aufwand ohne Gewinn.", belege=SITZUNG)
    elif mit:
        fmt = mit[0].get("formatvorschlag")
        ENTWURF["session"] = feld(
            session_wert(
                "sessionFile" if fmt else "",
                grund=None if fmt else (
                    "Datei traegt Tokenzahlen, aber in keinem der drei gebauten Formate "
                    "(codex-jsonl, aider-chat-history, crush-sqlite) — ein neues Format "
                    "waere zu bauen, geschaetzt wird nichts"),
                ort=mit[0].get("pfad"), format=fmt,
                zuordnung="cwd" if fmt else "", live=bool(fmt),
                zeigtNicht=(["freigabedialog", "arbeits-anzeige"] if fmt else
                            ["freigabedialog", "kontextauslastung", "arbeits-anzeige"]),
                beleg=mit[0].get("beleg")),
            "gemessen" if fmt else "nicht ermittelbar",
            ("Datei traegt echte Tokenzahlen; das Format ist eins der drei gebauten"
             if fmt else
             "Datei traegt Tokenzahlen, aber in keinem der drei gebauten Formate "
             "(codex-jsonl, aider-chat-history, crush-sqlite) — ein neues Format waere zu bauen, "
             "geschaetzt wird nichts"),
            belege=SITZUNG)
    else:
        ENTWURF["session"] = feld(
            session_wert(
                "", grund=("die geschriebenen Sitzungsdateien tragen keine Tokenzahlen — aus "
                           "Dateigroesse oder Zeichenzahl wird nichts geschaetzt"),
                zeigtNicht=["freigabedialog", "kontextauslastung", "arbeits-anzeige"],
                beleg="keine der gefundenen Sitzungsdateien traegt eine erkennbare Tokenzahl"),
            "gemessen",
            "die geschriebenen Sitzungsdateien tragen keine Tokenzahlen — "
            "aus Dateigroesse oder Zeichenzahl wird nichts geschaetzt")

