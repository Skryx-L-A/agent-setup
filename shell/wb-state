def load_raw():
    # A broken registry must never be an error on the READ path — the built-ins
    # answer instead, exactly as a broken settings.json falls back to defaults.
    try:
        raw = json.load(open(MODELS_FILE))
        return raw if isinstance(raw, dict) else {}
    except Exception:
        return {}

def merge(raw, key, builtins):
    # A file entry overrides the built-in FIELD BY FIELD; fields it does not mention
    # are taken from the built-in. Wholesale replacement was the earlier rule and it
    # had a quiet failure mode: a hand-written {"id":"claude","command":"…"} dropped
    # readyPattern/effort/systemPrompt with it, and the claude spawn stopped working
    # for reasons nothing on screen explained. Filling in is announced once.
    out, order = {}, []
    base = {}
    for b in builtins:
        out[b["id"]] = dict(b); base[b["id"]] = dict(b); order.append(b["id"])
    for e in (raw.get(key) or []):
        if not isinstance(e, dict) or not e.get("id"):
            continue
        i = e["id"]
        if i not in out:
            order.append(i); out[i] = e; continue
        missing = [k for k in base[i] if k not in e]
        merged = dict(base[i]); merged.update(e)
        out[i] = merged
        if missing:
            sys.stderr.write("wb-state: HINWEIS — %s '%s' in models.json fehlen %s; aus dem "
                             "eingebauten Adapter ergaenzt.\n" % (key[:-2], i, ", ".join(missing)))
    return [out[i] for i in order]

RAW = load_raw()
PROVIDERS = merge(RAW, "providers", BUILTIN_PROVIDERS)
HARNESSES = merge(RAW, "harnesses", BUILTIN_HARNESSES)
MODELS = [m for m in (RAW.get("models") or []) if isinstance(m, dict) and m.get("id")]

def byid(lst, i):
    return next((e for e in lst if e.get("id") == i), None)

def opts(argv, names, flags=()):
    vals = dict((n, None) for n in names)
    fl = dict((f, False) for f in flags)
    pos, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and a[2:] in vals:
            if i + 1 >= len(argv):
                die("FEHLER: Option %s braucht einen Wert." % a)
            vals[a[2:]] = argv[i + 1]; i += 2
        elif a.startswith("--") and a[2:] in fl:
            fl[a[2:]] = True; i += 1
        else:
            pos.append(a); i += 1
    return vals, fl, pos

def need_model(mid):
    m = byid(MODELS, mid)
    if not m:
        die("FEHLER: Modell '%s' ist nicht registriert." % mid,
            "In den Settings unter 'Modelle & Harnesses' hinzufuegen,",
            "oder: wb-state models add '<json>'.",
            "Registriert: " + (" ".join(e["id"] for e in MODELS) or "(keins)"))
    return m

# ── secrets: presence only, never the value ─────────────────────────────────────
# Reading order per SPEC-V3 A.1: Keychain -> ~/.secrets-sync/api-keys/<provider>
# -> environment variable. wb-harness-run walks the SAME order to get the value;
# if one of the two changes, the other has to change with it.
def secret_chain(prov):
    chain = []
    svc = prov.get("keychainService")
    if svc:
        chain.append("@keychain:" + svc)
    chain.append("@file:" + os.path.join(HOME, ".secrets-sync", "api-keys", prov["id"]))
    env = prov.get("apiKeyEnv")
    if env:
        chain.append("@env:" + env)
    return chain

def secret_present(prov):
    svc = prov.get("keychainService")
    if svc and shutil.which("security"):
        # deliberately WITHOUT -w: presence needs no value, and not reading the
        # value cannot trigger a keychain access prompt that would block a spawn.
        r = subprocess.run(["security", "find-generic-password", "-s", svc],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            return True, "Keychain " + svc
    path = os.path.join(HOME, ".secrets-sync", "api-keys", prov["id"])
    if os.path.exists(path):
        mode = os.stat(path).st_mode & 0o777
        if mode & 0o077:
            die("FEHLER: %s hat Mode %o, verlangt 600 — Key wird nicht gelesen." % (path, mode),
                "Beheben: chmod 600 %s" % path)
        return True, path
    env = prov.get("apiKeyEnv")
    if env and os.environ.get(env):
        return True, "Umgebungsvariable " + env
    return False, ""

def key_required(prov):
    return (prov.get("kind") or "cloud") == "cloud" and (
        prov.get("apiKeyEnv") or prov.get("keychainService"))

# ── the ONE exception to "never read the value" ──────────────────────────────────
# A catalog HTTP fetch (SPEC-V3-MODELS discover Vertrag Teil 2) genuinely has to send
# the key in a request header -- unlike every spawn path above, which only ever hands
# the SHELL a placeholder chain and lets wb-harness-run resolve it inside the pane.
# This function is used ONLY by the http-json catalog fetch below. Its return value
# must never be assigned into anything that later gets printed, logged, cached to
# disk, or written into the registry -- only into a mode-600 temp header file that
# http_get_json deletes right after the curl call.
def read_secret_value(prov):
    svc = prov.get("keychainService")
    if svc and shutil.which("security"):
        try:
            r = subprocess.run(["security", "find-generic-password", "-s", svc, "-w"],
                               capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                v = r.stdout.strip()
                if v:
                    return v
        except Exception:
            pass
    path = os.path.join(HOME, ".secrets-sync", "api-keys", prov["id"])
    if os.path.exists(path):
        try:
            mode = os.stat(path).st_mode & 0o777
            if mode & 0o077:
                sys.stderr.write("wb-state: WARNUNG — %s hat Mode %o, verlangt 600 — Key wird "
                                 "nicht gelesen (Provider '%s' gilt als 'kein Key').\n"
                                 % (path, mode, prov["id"]))
            else:
                v = open(path).read().strip()
                if v:
                    return v
        except Exception:
            pass
    env = prov.get("apiKeyEnv")
    if env and os.environ.get(env):
        v = os.environ[env].strip()
        if v:
            return v
    return None

# ── Die Stufenliste gehoert dem HARNESS (2026-08-06) ────────────────────────────
# Bis dahin trug jeder Modelleintrag seine eigene `efforts`-Liste: 86 Kopien
# derselben vier Stufen, und keine einzige kannte `max`, obwohl `claude --help`
# und `pi --help` es fuehren. Was ein Harness annimmt, ist eine Eigenschaft des
# HARNESS. Ein Modell darf die Liste EINSCHRAENKEN (`efforts` am Modell), nie
# erweitern -- eine Stufe, die der Harness nicht annimmt, kann kein Modell
# anbieten.
def harness_efforts(h):
    if not h:
        return []
    eff = h.get("effort") or {}
    if (eff.get("style") or "none") == "none":
        return []                      # dieser Harness kennt gar keine Stufen
    mp = eff.get("map") or {}
    return sorted((k for k in mp if k in RANK), key=lambda k: RANK[k])

def model_efforts(m, h=None):
    if h is None:
        h = byid(HARNESSES, m.get("harness") or "")
    hl = harness_efforts(h)
    own = m.get("efforts")
    if isinstance(own, list) and own:
        eng = [e for e in hl if e in own]
        return eng or hl
    return hl

# ── Der Deckel: Auslieferung in der Registry, Setzung in den Einstellungen ──────
# `maxEffort` in models.json ist, was AUSGELIEFERT wird. Was der Nutzer in den
# Einstellungen setzt (settings.json, effortCaps), ueberschreibt es und ist als
# seine Setzung erkennbar -- daran, dass es dort steht und einen Grund traegt.
def effective_cap(m):
    """(Stufe, Quelle, Grund) -- Quelle ist 'einstellung', 'registry' oder '-'."""
    caps = read_setting("effortCaps", {})
    e = caps.get(m["id"]) if isinstance(caps, dict) else None
    if isinstance(e, dict) and e.get("cap") in RANK:
        return e["cap"], "einstellung", str(e.get("grund") or "")
    mx = m.get("maxEffort")
    if mx in RANK:
        # Ein Modell, das in keiner Registry steht, bekommt den Deckel seines
        # HARNESS (die hoechste Stufe unter `max`, A20 2026-08-06). Die Quelle
        # gehoert benannt: "Modell-Registry" waere hier eine Falschauskunft und
        # schickt jeden, der sie liest, in eine Datei, in der nichts steht.
        return mx, ("harness" if m.get("_deckel_vom_harness") else "registry"), ""
    return None, "-", ""

def mensch_belegt(flag):
    """Gilt `--mensch` fuer DIESEN Aufruf? (2026-08-06)

    Gemessen, nicht geglaubt -- dieselbe Messung wie in pi-worker und wb-code,
    nur eine Ebene tiefer. Sie steht hier zusaetzlich, weil `wb-state` selbst ein
    Kommando ist, das jeder Pane aufrufen kann: `models effort <id> --effort max
    --mensch` lieferte sonst die ungedeckelte Stufe, ohne dass jemals jemand die
    Herkunft angesehen haette.

    Die Produktionswege bleiben unberuehrt. Ruft ein Mensch `pi-worker` oder
    `wb-code` auf, ist wb-state ein KIND dieses Aufrufs: dieselbe Ahnenreihe,
    dasselbe Terminal, dieselben Variablen der Oberflaeche -- die zweite Messung
    kommt zum selben Ergebnis wie die erste. Ein Agent dagegen bringt seine
    Herkunft in jede Kindprozess-Ebene mit; er kann sie nicht an der Tuer abgeben.

    KEIN Abbruch, sondern Rueckfall auf den Deckel: dieses Kommando ist eine
    ABFRAGE, und die richtige Antwort auf 'was bekomme ich' ist die Stufe, die
    gilt -- nicht ein Fehler. Gesagt wird es trotzdem, sonst waere es ein stiller
    Rueckfall. (pi-worker und wb-code brechen ab, und das ist dort richtig: sie
    starten etwas, und ein ueberraschender Start ist schlimmer als eine
    Ablehnung.)"""
    if not flag:
        return False
    wb = os.path.join(HOME, ".local", "bin", "wb-mensch")
    try:
        ok = subprocess.run([wb, "pruefen"]).returncode == 0
    except Exception as e:
        sys.stderr.write("wb-state: '--mensch' nicht pruefbar (%s) — es gilt der Deckel.\n" % e)
        return False
    if ok:
        return True
    beleg = ""
    try:
        beleg = subprocess.run([wb, "beleg"], capture_output=True, text=True).stdout.strip()
    except Exception:
        pass
    sys.stderr.write(
        "wb-state: '--mensch' gilt hier nicht — der Aufruf kommt nicht von einem Menschen.\n"
        "  Erkannt wurde: %s\n"
        "  Es gilt der Deckel; Diagnose: wb-mensch beleg ; wb-mensch ahnen\n"
        % (beleg or "kein Beleg"))
    return False

def log_mensch_effort(m, eff, cap, quelle, rolle="worker"):
    """Protokolliert, wenn ein MENSCH ueber dem Deckel startet. Keine Warnung --
    eine spaetere Auswertung muss Selbstbindung und Ausnahme auseinanderhalten
    koennen, und dafuer braucht sie die Ausnahmen mit Datum. Vorbild ist das
    Aenderungsprotokoll der Einstellungen: nur anhaengen, eine Zeile je Aufruf,
    ein Fehler beim Schreiben bricht nie den Start ab.

    Die letzte Spalte sagt, WAS gestartet wurde (2026-08-06, siebte Spalte
    nachgetragen). Ohne sie stuenden die eigene Sitzung eines Menschen und ein
    Worker, den er ueber dem Deckel losschickt, ununterscheidbar nebeneinander --
    und genau die beiden sollen nicht durcheinandergeraten: der Deckel meint die
    Worker, die Stufe des Orchestrators ist die Entscheidung des Menschen."""
    if cap not in RANK or RANK[eff] <= RANK[cap]:
        return
    pfad = os.path.join(HOME, ".local", "state", "wb-effort-mensch.log")
    try:
        os.makedirs(os.path.dirname(pfad), exist_ok=True)
        with open(pfad, "a") as lg:
            lg.write("%s\t%s\t%s\t%s\t%s\t%s\t%s\n" % (
                datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                ACTOR, m["id"], eff, cap, quelle, rolle))
    except Exception as e:
        sys.stderr.write("wb-state: WARNUNG — Mensch-Protokoll nicht schreibbar (%s)\n" % e)

# ── Der Deckel bindet den ORCHESTRATOR, nicht den Menschen (2026-08-06) ─────────
# `mensch=True` erreicht diese Funktion nur ueber `--mensch`, und dieses Merkmal
# wird nicht geglaubt, sondern von `wb-mensch` an der Herkunft des Aufrufers
# GEMESSEN (siehe dort). Was auch fuer einen Menschen gilt: die Stufenliste des
# Harness. `max` ist waehlbar, wo der Harness es annimmt, und nur dort.
def policy_effort(m, requested, mensch=False, rolle="worker"):
    h = byid(HARNESSES, m.get("harness") or "")
    erlaubt = model_efforts(m, h)
    explizit = bool(requested)
    e = requested or m.get("defaultEffort") or "medium"
    if e not in RANK:
        die("FEHLER: unbekannter effort '%s'. Gueltig: %s."
            % (e, " ".join(sorted(RANK, key=lambda k: RANK[k]))))
    # 1. Was der Harness nicht annimmt, gibt es fuer dieses Modell nicht -- fuer
    #    einen Agenten so wenig wie fuer einen Menschen. Das ist keine Regel, die
    #    jemand gesetzt hat, sondern die Grenze des Werkzeugs dahinter.
    if erlaubt and e not in erlaubt:
        die("FEHLER: Harness '%s' nimmt effort '%s' nicht an (Modell '%s')."
            % (h["id"] if h else "?", e, m["id"]),
            "Angenommen werden: %s." % " ".join(erlaubt))
    # 2. Der DECKEL. Er bindet den Orchestrator; ein Mensch geht darueber hinweg,
    #    und das wird protokolliert statt verhindert.
    cap, quelle, grund = effective_cap(m)
    if mensch:
        log_mensch_effort(m, e, cap, quelle, rolle)
        return e
    if cap in RANK and RANK[e] > RANK[cap]:
        # AUSDRUECKLICH verlangt -> Ablehnung. Ein gesetzter Deckel muss WIRKEN,
        # und ein stilles Absenken sieht von aussen aus wie ein erfuellter
        # Wunsch. Kommt die Stufe dagegen nur aus einer VORGABE (defaultEffort,
        # orchestratorEffort=xhigh), wird weiterhin gesenkt statt abgelehnt --
        # sonst waere jedes Modell, das bei 'high' endet, mit einer
        # xhigh-Vorgabe gar nicht mehr startbar (der Grund, aus dem hier
        # ueberhaupt gesenkt wurde).
        if explizit:
            die("FEHLER: '%s' ist auf effort '%s' gedeckelt (%s%s) — '%s' abgelehnt."
                % (m["id"], cap,
                   {"einstellung": "Einstellung",
                    "harness": "Harness-Deckel"}.get(quelle, "Modell-Registry"),
                   (": " + grund) if grund else "", e),
                "Deckel aendern: wb-state effort-cap set %s <stufe> --grund '<warum>'" % m["id"],
                "Als MENSCH darueber hinaus starten: --mensch (nur vom Terminal oder "
                "aus der Oberflaeche, nie aus einem Pane).")
        sys.stderr.write("wb-state: Modell '%s' ist auf effort '%s' gedeckelt (%s) — '%s' wird "
                         "auf '%s' gesenkt.\n" % (m["id"], cap, quelle, e, cap))
        e = cap
    return e

def system_prompt_file(h, role):
    sp = h.get("systemPrompt") or {}
    p = sp.get(role) or sp.get("path")
    return ex(p) if p else None

def subst(s, ctx, where):
    if not isinstance(s, str):
        return s
    out = s
    for k, v in ctx.items():
        out = out.replace("{%s}" % k, str(v))
    if "{secret" in out:
        die("FEHLER: ein Secret-Platzhalter steht in %s ('%s') — Keys duerfen nie in einem "
            "Kommando-Argument landen (Prozessliste), nur in einer Umgebungsvariablen." % (where, s))
    return out

def cmd_resolve():
    # --probe is for wb-harness-probe ALONE: it lifts exactly the two gates that
    # make an unmeasured adapter unstartable (ready pattern, missing key), because
    # measuring the pattern is what the probe is for and it runs in a throwaway HOME
    # without a keychain. Nothing else changes — no spawner ever passes it.
    # --mensch hebt den DECKEL auf, nie die Stufenliste des Harness, und wird HIER
    # gemessen (mensch_belegt) -- nicht nur bei den Aufrufern.
    #
    # Bis 2026-08-06 stand an dieser Stelle die Zusage, das Merkmal komme
    # "ausschliesslich von pi-worker" und sei dort schon geprueft. Fuer die
    # Produktionswege stimmte das; als Zusage stimmte es nicht, denn
    # `wb-state models resolve … --mensch` laesst sich aus jedem Pane direkt
    # aufrufen. Ein Kommentar, der mehr verspricht als der Code haelt, ist
    # schlimmer als keiner: er beendet genau die Nachfrage, die den Weg gefunden
    # haette. Jetzt misst die Stelle selbst, und die Zusage ist wieder wahr.
    vals, fl, pos = opts(ARGV, ["role", "effort", "dir", "name"], ["probe", "mensch"])
    if not pos:
        die("FEHLER: wb-state models resolve <id> --role worker|orchestrator "
            "[--effort e] [--dir d] [--name n] [--mensch]")
    m = need_model(pos[0])
    role = vals["role"] or "worker"
    if role not in ("worker", "orchestrator"):
        die("FEHLER: unbekannte Rolle '%s' (worker|orchestrator)." % role)
    # `enabled=false` wird NICHT sofort gemeldet, sondern unten mit den anderen
    # Startsperren zusammen (2026-08-06). Vorher gewann es, weil es hier stand: ein
    # Aufruf auf `gpt-5-codex` sagte "deaktiviert", und dass ausserdem der Binary
    # fehlt, erfuhr man erst nach dem Einschalten. Genau die Sorte Meldung, nach der
    # man an der falschen Stelle sucht. Dieselbe Begruendung wie beim Sammler unten.
    roles = m.get("roles") or ["worker", "orchestrator"]
    if role not in roles:
        die("FEHLER: Modell '%s' ist fuer die Rolle '%s' nicht freigegeben (roles: %s)."
            % (m["id"], role, ", ".join(roles)))
    machines = m.get("machines")
    if machines and MACHINE not in machines:
        die("FEHLER: Modell '%s' darf auf dieser Maschine (%s) nicht laufen (machines: %s)."
            % (m["id"], MACHINE, ", ".join(machines)))
    h = byid(HARNESSES, m.get("harness") or "")
    if not h:
        die("FEHLER: Harness '%s' von Modell '%s' ist nicht registriert."
            % (m.get("harness"), m["id"]))
    prov = byid(PROVIDERS, m.get("provider") or "")
    if not prov:
        die("FEHLER: Provider '%s' von Modell '%s' ist nicht registriert."
            % (m.get("provider"), m["id"]))
    eff = policy_effort(m, vals["effort"], mensch=mensch_belegt(fl["mensch"]))

    # ALLE Startsperren werden gesammelt und GEMEINSAM gemeldet, nicht nacheinander.
    # Vorher gewann die erste: bei einem frischen Preset stand nur "Binary nicht
    # installiert" da, und nach der Installation kam als naechstes "readyPattern nicht
    # gemessen", danach "kein Key". Drei Anlaeufe fuer eine Antwort, die man in einem
    # Satz haben kann — und der Stresslauf hielt es fuer einen fehlenden Ready-Guard,
    # weil er die Meldung des Binary-Gates sah.
    blockers = []

    # Abgeschaltet ist eine Startsperre wie jede andere. Der Grund steht, wenn es
    # einen gibt, im `notes`-Feld des Modells -- bei `gpt-5-codex` etwa "modelRef
    # ungeprueft"; ihn hier mitzunehmen erspart das Nachschlagen in der Registry.
    if m.get("enabled") is False:
        hinweis = (m.get("notes") or "").strip()
        blockers.append(("Modell ist abgeschaltet (enabled=false)."
                         + (" Grund: " + hinweis if hinweis else ""),
                         ["Einschalten: wb-state models set %s enabled true" % m["id"]]))

    # No binary, no start line (Stress-Befund B17). `models check` saw this all
    # along, but nothing on the spawn path ever asked it — the pane was created and
    # died on exec, which looks like a crashed worker instead of a missing install.
    if binary_missing(h):
        blockers.append(("Binary '%s' fuer Harness '%s' ist nicht installiert."
                         % (h.get("command"), h["id"]),
                         ["Pruefen: wb-state models check %s" % m["id"]]))

    # Zweite Startbedingung derselben Art: die Konfigurationsdatei, ohne die der
    # Harness gar nicht erst zu seiner Eingabezeile kommt (SPEC-V3 A.2 `configFiles`).
    # Ohne diesen Gate ist der Ausgang nicht etwa ein Fehler, sondern eine Wartezeit:
    # crush bleibt ohne ~/.config/crush/crushrc im Modellwaehler stehen, der Ready-Wait
    # laeuft 60 s ins Leere, und danach steht dort, das Muster sei nicht erschienen —
    # eine wahre Meldung, die auf die falsche Ursache zeigt.
    #
    # Unter --probe wird NICHT gesperrt, aus demselben Grund wie beim Ready-Muster:
    # die Probe misst in einem umgelenkten HOME, in dem die Datei per Definition nicht
    # liegt. Sie sagt es stattdessen sichtbar, damit ein leerer Modellwaehler im
    # Probelauf nicht als Eigenart des Werkzeugs missverstanden wird.
    for spec in config_missing(h):
        if fl["probe"]:
            sys.stderr.write("wb-state: WARNUNG — Konfigdatei %s fehlt (Harness '%s'); im "
                             "Probelauf mit umgelenktem HOME ist das der Normalfall, im "
                             "Betrieb waere es eine Startsperre.\n" % (spec.get("target"), h["id"]))
            continue
        blockers.append(("Konfigdatei %s fuer Harness '%s' fehlt.%s"
                         % (spec.get("target"), h["id"],
                            (" " + spec["why"]) if spec.get("why") else ""),
                         ["Ausrollen: wb-harness-config apply %s" % h["id"],
                          "Pruefen:   wb-harness-config check"]))

    # No measured ready pattern, no start. An adapter without one is exactly how a
    # task disappeared into a booting TUI twice in 2026-07 (SPEC-V3 H).
    ready = h.get("readyPattern")
    if not ready and not fl["probe"]:
        blockers.append(("readyPattern fuer %s ist nicht gemessen." % h["id"],
                         ["Messen: wb-harness-probe %s" % h["id"],
                          "Ohne gemessenes Muster wird kein Task eingefuegt: ein Paste in eine "
                          "noch bootende TUI verschwindet still."]))

    # The key gate hangs off the PROVIDER, not off whether the adapter happens to
    # declare {secret:…} (Stress-Befund B04): 'opencode' ships with env: null, so a
    # cloud model on the same provider as a gated one started with no auth at all.
    # A forgotten env entry in an adapter must not be able to switch the check off.
    if key_required(prov):
        ok, _src = secret_present(prov)
        if not ok:
            if fl["probe"]:
                sys.stderr.write("wb-state: WARNUNG — kein Key hinterlegt (Provider '%s'); der "
                                 "Probelauf sieht womoeglich einen Login-Screen statt der "
                                 "Eingabezeile.\n" % prov["id"])
            else:
                blockers.append(("kein Key hinterlegt (Provider '%s')." % prov["id"],
                                 ["Mac:  security add-generic-password -s %s -a <konto> -w"
                                  % (prov.get("keychainService") or ("wb-" + prov["id"])),
                                  "peer: ~/.secrets-sync/api-keys/%s (Mode 600)" % prov["id"]]))

    if blockers:
        lines = ["FEHLER: '%s' ist nicht startbar (%d %s):"
                 % (m["id"], len(blockers), "Grund" if len(blockers) == 1 else "Gruende")]
        for i, (head, hints) in enumerate(blockers, 1):
            lines.append("%d) %s" % (i, head))
            lines.extend(["   " + hnt for hnt in hints])
        die(lines[0], *lines[1:])

    ctx = {"model": m.get("modelRef") or m["id"],
           "effort": ((h.get("effort") or {}).get("map") or {}).get(eff, eff),
           "workdir": vals["dir"] or os.getcwd(),
           "name": vals["name"] or m["id"]}
    if h.get("sessionDir"):
        ctx["sessionDir"] = ex(subst(h["sessionDir"], ctx, "sessionDir"))
    # Die Fenstergroesse DIESES Modells, fuer eine CLI, die ihren Nenner selbst nicht
    # kennt (nanocoder, gemessen 2026-08-10: ohne ihn faellt die ctx-Anzeige ganz weg
    # und der Worker ist unbewacht). Nur gesetzt, wenn das Modell sie wirklich traegt —
    # siehe die env-Schleife unten, die die Zeile sonst weglaesst.
    if isinstance(m.get("contextWindow"), int) and m["contextWindow"] > 0:
        ctx["contextWindow"] = m["contextWindow"]
    spf = system_prompt_file(h, role)
    if spf:
        ctx["systemPromptFile"] = spf

    # env: the ONLY place a secret may travel. Its value stays a placeholder chain
    # here; {baseUrl:<provider>} and plain values are substituted normally.
    envlines = []
    secret_providers = []
    for k, v in (h.get("env") or {}).items():
        val = str(v)
        # A literal key that got in by hand-editing must not be executed either —
        # masking it here would hand the CLI the mask (B08: display masks, execution
        # refuses).
        if looks_like_secret(val):
            die("FEHLER: env '%s' des Harness '%s' enthaelt einen Klartext-Schluessel."
                % (k, h["id"]),
                "Ersetzen durch {secret:<provider>}; der Wert gehoert in den Keychain bzw. "
                "nach ~/.secrets-sync/api-keys/<provider>.")
        if "{secret" in val:
            pid = val.split("{secret", 1)[1].lstrip(":").split("}")[0] or m["provider"]
            sp = byid(PROVIDERS, pid)
            if not sp:
                die("FEHLER: Harness '%s' verlangt den Key von Provider '%s' — den gibt es nicht."
                    % (h["id"], pid))
            if key_required(sp):
                ok, _ = secret_present(sp)
                if not ok and fl["probe"]:
                    sys.stderr.write("wb-state: WARNUNG — kein Key hinterlegt (Provider '%s'); der "
                                     "Probelauf sieht womoeglich einen Login-Screen statt der "
                                     "Eingabezeile.\n" % sp["id"])
                elif not ok:
                    die("FEHLER: kein Key hinterlegt (Provider '%s') — kein Start ohne Auth." % sp["id"],
                        "Mac:  security add-generic-password -s %s -a <konto> -w"
                        % (sp.get("keychainService") or ("wb-" + sp["id"])),
                        "peer: ~/.secrets-sync/api-keys/%s (Mode 600)" % sp["id"])
            envlines.append((k, secret_chain(sp)))
            secret_providers.append(sp["id"])
            continue
        for p2 in PROVIDERS:
            bu = p2.get("baseUrl") or ""
            if p2["id"] == "ollama":
                bu = ollama_baseurl(bu)
            val = val.replace("{baseUrl:%s}" % p2["id"], str(bu))
        provbu = prov.get("baseUrl") or ""
        if prov.get("id") == "ollama":
            provbu = ollama_baseurl(provbu)
        val = val.replace("{baseUrl}", str(provbu))
        # {contextWindow} ist der einzige Platzhalter, der FEHLEN darf (2026-08-10,
        # fuer NANOCODER_CONTEXT_LIMIT): die Fenstergroesse haengt am Modell, nicht am
        # Harness, und nicht jedes Modell traegt sie. Fehlt sie, faellt die ganze Zeile
        # weg — eine leere oder geratene Zahl waere schlimmer als die fehlende Variable,
        # denn genau daraus baut die CLI dann eine Prozentanzeige, der die Kontextwache
        # glaubt. Steht der Platzhalter nach subst() noch da, ist ctx["contextWindow"]
        # nicht gesetzt worden.
        if "{contextWindow}" in val and "contextWindow" not in ctx:
            continue
        envlines.append((k, [subst(val, ctx, "env " + k)]))

    # If the provider needs a key and no adapter env line carries it, hand it over
    # under the provider's own variable name — a gate that blocks the start but never
    # delivers the key would only move the failure into the pane.
    if key_required(prov) and prov.get("apiKeyEnv") and not any(
            prov["id"] == pid for pid in secret_providers):
        envlines.append((prov["apiKeyEnv"], secret_chain(prov)))

    parts = []            # ("q", text) = shell-quoted, ("r", text) = raw fragment
    if not h.get("command"):
        die("FEHLER: Harness '%s' hat kein 'command'." % h["id"])
    parts.append(("q", ex(h["command"])))
    for a in (h.get("args") or []):
        parts.append(("q", subst(a, ctx, "args")))
    est = (h.get("effort") or {}).get("style") or "none"
    if est == "arg" and model_takes_effort(m):
        for a in ((h.get("effort") or {}).get("args") or []):
            parts.append(("q", subst(a, ctx, "effort.args")))
    # Die Autonomie-Flags eines Harness (bei claude: --dangerously-skip-permissions)
    # haengen seit dem 06.08. an `workerSkipPermissions` -- aber nur fuer WORKER.
    # Ein Orchestrator ist kein Worker, und der Schalter im Menue spricht
    # ausdruecklich von Workern. Fehlt der Schluessel oder ist die Datei kaputt,
    # gilt True: die sichere Richtung ist hier "laeuft weiter wie bisher", denn
    # aus heisst, dass jeder Worker an seiner eigenen Rueckfrage stehenbleibt.
    autonom = role != "worker" or read_setting_bool("workerSkipPermissions", True)
    if autonom:
        for a in ((h.get("autonomy") or {}).get("args") or []):
            parts.append(("q", subst(a, ctx, "autonomy.args")))
    # Remote Control (Vorgabe des Nutzers 2026-08-05): der eingebaute claude-Harnisch
    # bekommt sie im Orchestrator-Zweig immer, im Worker-Zweig nie. Hierher gehoert
    # das, weil `role` an genau dieser Stelle feststeht und dies laut Kopfkommentar
    # DIE einzige Stelle ist, die einen Startbefehl baut -- wb-code und pi-worker
    # bauen den eingebauten claude-Aufruf zwar direkt selbst (siehe dort) und
    # erreichen diesen Zweig fuer harness='claude' im heutigen Aufrufgraphen nie,
    # aber ein KUENFTIGER Aufrufer, der Rolle+Harnisch ueber die Registry aufloest,
    # bekommt so dieselbe Regel statt einer dritten, unabhaengigen Kopie davon.
    if h["id"] == "claude" and role == "orchestrator":
        parts.append(("q", "--remote-control"))
        parts.append(("q", ctx["name"]))
    res = h.get("resume") or {}
    if res.get("args"):
        probe = res.get("probe") or "always"
        add = probe == "always"
        if probe == "session-dir" and ctx.get("sessionDir"):
            add = bool(glob.glob(os.path.join(ctx["sessionDir"], "*.json*")))
        if add:
            for a in res["args"]:
                parts.append(("q", subst(a, ctx, "resume.args")))
    sp = h.get("systemPrompt") or {}
    style = sp.get("style") or "none"
    if style in ("flag-content", "flag-path"):
        if not spf:
            sys.stderr.write("wb-state: WARNUNG — Harness '%s' hat fuer die Rolle '%s' keine "
                             "Rollendatei; startet ohne Rollen-Prompt.\n" % (h["id"], role))
        else:
            if not os.path.exists(spf):
                sys.stderr.write("wb-state: WARNUNG — Rollendatei %s fehlt; %s startet ohne "
                                 "Rollen-Prompt.\n" % (spf, h["id"]))
            parts.append(("q", sp.get("flag") or "--append-system-prompt"))
            if style == "flag-path":
                parts.append(("q", spf))
            else:
                parts.append(("r", '"$(cat %s)"' % shlex.quote(spf)))
    elif style == "file":
        # Seit dem 2026-08-06 gibt es den Generator: wb-harness-run schreibt die Datei
        # unmittelbar vor dem exec. Der Hinweis sagt deshalb, WOHIN sie geht, statt eine
        # Bringschuld zu benennen, die niemand mehr hat.
        ziel = sp.get("projectPath")
        sys.stderr.write("wb-state: HINWEIS — '%s' liest die Rolle aus einer Datei (%s); "
                         "wb-harness-run schreibt sie vor dem Start.\n"
                         % (h["id"],
                            ("<arbeitsverzeichnis>/" + ziel) if ziel
                            else (sp.get("path") or "keine Datei angegeben")))

    cmd = " ".join(t if k == "r" else shlex.quote(t) for k, t in parts)
    if (h.get("cwdMode") or "cd") == "cd":
        cmd = "cd %s && exec %s" % (shlex.quote(ctx["workdir"]), cmd)
    else:
        cmd = "exec " + cmd

    print("harness\t%s" % h["id"])
    print("model\t%s" % ctx["model"])
    print("effort\t%s" % eff)
    print("title\t%s" % h["id"])
    print("ready\t%s" % (ready or ""))
    # The pattern of the INPUT line, for the paste-and-enter verification. Separate
    # from readyPattern on purpose: "the TUI is up" and "the input line still holds
    # my text" are two different questions, and for aider they are two different
    # strings. Empty means: this spawn cannot be verified and has to say so.
    print("prompt\t%s" % (h.get("promptPattern") or ""))
    # Platzhalter-Text, der in einer LEEREN Eingabezeile stehen darf. Ohne das hielt
    # die Absende-Verifikation codex' Vorschlagszeile fuer haengenden Text und meldete
    # einen Fehlschlag, obwohl der Task angekommen war (gemessen 2026-07-28).
    print("promptignore\t%s" % (h.get("promptIgnore") or ""))
    # Zweiter Absende-Weg (2026-08-09, SPEC-V3 A.2 altSubmit): getrennt von promptPattern,
    # weil "die Box ist leer" und "dieser Harness braucht hier eine ANDERE Taste als
    # Enter" zwei verschiedene Fragen sind. Leer, wenn der Harness kein altSubmit traegt —
    # dann sendet pi-worker wie immer nur Enter.
    _altsub = h.get("altSubmit") or {}
    print("altsubmittrigger\t%s" % (_altsub.get("trigger") or ""))
    print("altsubmitkey\t%s" % (_altsub.get("key") or ""))
    print("compact\t%s" % (h.get("compactCommand") or ""))
    print("context\t%s" % (h.get("contextPattern") or ""))
    for k, chain in envlines:
        print("env\t%s\t%s" % (k, "\t".join(chain)))
    print("cmd\t%s" % cmd.replace("\t", " "))

def cmd_list():
    vals, fl, _ = opts(ARGV, ["role", "machine", "harness"], ["all"])
    for m in MODELS:
        if not fl["all"] and m.get("enabled") is False:
            continue
        if vals["role"] and vals["role"] not in (m.get("roles") or ["worker", "orchestrator"]):
            continue
        if vals["machine"] and m.get("machines") and vals["machine"] not in m["machines"]:
            continue
        if vals["harness"] and m.get("harness") != vals["harness"]:
            continue
        print(m["id"])

def cmd_get():
    vals, _, pos = opts(ARGV, ["field"])
    if not pos:
        die("FEHLER: wb-state models get <id> [--field <f>]")
    m = need_model(pos[0])
    if vals["field"]:
        v = mask(m.get(vals["field"]))
        if v is None:
            return
        print(v if isinstance(v, (str, int, float)) and not isinstance(v, bool)
              else json.dumps(v, ensure_ascii=False))
        return
    print(json.dumps(mask(m), indent=2, ensure_ascii=False))

def cmd_harness_get():
    if not ARGV:
        die("FEHLER: wb-state harness get <id>", "Registriert: " + " ".join(h["id"] for h in HARNESSES))
    h = byid(HARNESSES, ARGV[0])
    if not h:
        die("FEHLER: Harness '%s' ist nicht registriert." % ARGV[0],
            "Registriert: " + " ".join(x["id"] for x in HARNESSES))
    print(json.dumps(mask(h), indent=2, ensure_ascii=False))

# One model can be the right answer to SEVERAL jobs at different effort — sonnet5
# for "short and well specified" (high) AND "larger but clear" (xhigh). So
# `workerClass` may be a string (one row, model default effort), a list of strings,
# or a list of objects {class, effort, goodFor} — one table row each (SPEC-V3 A.3).
def worker_rows(m):
    wc = m.get("workerClass")
    if not wc:
        return []
    out = []
    for it in (wc if isinstance(wc, list) else [wc]):
        if isinstance(it, str):
            out.append((it, m.get("defaultEffort") or "medium", m.get("goodFor") or ""))
        elif isinstance(it, dict) and it.get("class"):
            out.append((it["class"],
                        it.get("effort") or m.get("defaultEffort") or "medium",
                        it.get("goodFor") or m.get("goodFor") or ""))
    return out

# Stays the data on this machine? Explicit field wins (model before provider),
# otherwise it follows provider.kind == "local". `subscription` and `cloud` are never
# local by default — that is the whole point of the distinction.
def data_stays_local(m):
    if isinstance(m.get("dataStaysLocal"), bool):
        return m["dataStaysLocal"]
    p = byid(PROVIDERS, m.get("provider") or "") or {}
    if isinstance(p.get("dataStaysLocal"), bool):
        return p["dataStaysLocal"]
    return (p.get("kind") or "cloud") == "local"

# Does this MODEL understand an effort/reasoning flag? Explicit field wins; without
# it, a local model gets nothing sent (Befund 2026-07-28: aider passed
# `--reasoning-effort` to `ollama/ornith:35b`, which does not know it, and warned on
# every start). The harness only says HOW to pass effort, not whether the model
# behind it can take it.
def model_takes_effort(m):
    if isinstance(m.get("supportsEffort"), bool):
        return m["supportsEffort"]
    return not data_stays_local(m)

# What you actually TYPE. For a model the spawners resolve through a built-in alias
# that is the alias, not the full id (`sonnet5:high`, never `claude-sonnet-5:high`) —
# a routing table showing an id nobody types is the reason this column exists.
# The effort suffix is only shown where it really arrives: pi-worker's alias path
# drops it for workers (adapter switches it off), a harness without an effort flag
# has nowhere to put it, and a model that does not take one must not advertise it.
def spawn_spelling(m, eff):
    name = m.get("alias") or m["id"]
    h = byid(HARNESSES, m.get("harness") or "") or {}
    style = (h.get("effort") or {}).get("style") or "none"
    show = h.get("effortInSpawnSpelling")
    if show is None:
        show = style != "none"
    return "%s:%s" % (name, eff) if show and model_takes_effort(m) else name

# Der Stand von `wb-kontingent` -- Plan, Anmeldung und Restkontingent je Harness
# (~/.claude/workbench/kontingent.json). GELESEN, nie erhoben: die Routing-Tabelle
# wird bei jedem `wb-instructions sync` gebaut und darf dafuer keine Messung
# anstossen. Fehlt die Datei, sagt die Tabelle nichts dazu -- 'unbekannt' ist kein
# Befund und gehoert nicht in eine Zeile, die Tokens kostet.
def kontingent_stand():
    try:
        with open(os.path.join(HOME, ".claude", "workbench", "kontingent.json")) as f:
            d = json.load(f)
        return d.get("harnesses") or {}
    except Exception:
        return {}

def kontingent_marke(eintrag, modelref):
    """Der kurze Zusatz vor der Eignung, oder ''. Eine Marke pro Zeile, kein
    zweiter Absatz je Harness -- der Sockel jeder Session ist Tokenbudget."""
    if not isinstance(eintrag, dict):
        return ""
    if eintrag.get("erschoepft") is True:
        bis = ((eintrag.get("kontingent") or {}).get("faellt_zurueck_am") or "")[:10]
        return "ERSCHOEPFT%s" % (" bis %s" % bis if bis else "")
    if eintrag.get("art") == "abo" and eintrag.get("angemeldet") is False:
        return "NICHT ANGEMELDET"
    if modelref and modelref in (eintrag.get("modelle_gesperrt") or []):
        return "MODELL FEHLT (ollama pull %s)" % modelref.split("/")[-1]
    return ""

def cmd_table():
    stand = kontingent_stand()
    rows = []
    for m in MODELS:
        if m.get("enabled") is False:
            continue
        if "worker" not in (m.get("roles") or ["worker", "orchestrator"]):
            continue
        for cls, eff, good in worker_rows(m):
            rows.append((CLASSES.index(cls) if cls in CLASSES else len(CLASSES),
                         cls, eff, good, m))
    rows.sort(key=lambda r: (r[0], r[4]["id"], RANK.get(r[2], 9)))
    print("| Aufgabe | So spawnen | Harness | Eignung |")
    print("|---|---|---|---|")
    for _, cls, eff, good, m in rows:
        # A row the orchestrator cannot act on has to say so IN the row. Skipping it
        # would hide that the model exists; leaving it unmarked costs a turn (the
        # spawn refuses, correctly, but only after it was typed).
        h = byid(HARNESSES, m.get("harness") or "") or {}
        if not h.get("readyPattern"):
            good = "NICHT STARTBAR (Ready ungemessen, wb-harness-probe %s) — %s" % (
                m.get("harness") or "?", good)
        # Same gate the spawn path (cmd_resolve) checks right before it starts a
        # pane — a harness whose binary isn't installed on THIS machine must say so
        # here, not just fail after the orchestrator already tried the spawn line.
        # A harness with no command configured at all isn't ours to judge; skip it.
        if h.get("command") and binary_missing(h):
            good = "NICHT STARTBAR auf %s (Binary '%s' fehlt) — %s" % (
                MACHINE, h["command"], good)
        # Und dieselbe Auskunft fuer die zweite Startbedingung: eine fehlende
        # Pflicht-Konfigurationsdatei kostet sonst denselben Zug wie ein fehlendes
        # Binary — die Zeile sieht startbar aus, der Spawn ist es nicht.
        for spec in config_missing(h):
            good = "NICHT STARTBAR auf %s (Konfigdatei %s fehlt, wb-harness-config apply %s) — %s" % (
                MACHINE, spec.get("target"), h["id"], good)
        # Dieselbe Auskunft fuer die dritte Startbedingung, die keine Datei auf
        # dieser Maschine beantwortet: das Kontingent des Kontos. Ein Worker in ein
        # erschoepftes Monatslimit zu spawnen kostet einen ganzen Zug und liefert
        # nichts -- genau der Fehler vom 10.08., wegen dem `wb-kontingent` existiert.
        marke = kontingent_marke(stand.get(m.get("harness") or ""), m.get("modelRef") or "")
        if marke:
            good = "%s — %s" % (marke, good)
        local = data_stays_local(m)
        label = CLASS_LABEL_LOCAL[cls] if (local and cls in CLASS_LABEL_LOCAL) \
            else CLASS_LABEL.get(cls, cls)
        print("| %s | `%s` | %s | %s |"
              % (label, spawn_spelling(m, eff),
                 m.get("harness") or "-", good.replace("|", "/")))

def cmd_check():
    if not ARGV:
        die("FEHLER: wb-state models check <id>")
    m = need_model(ARGV[0])
    ok = True
    print("Modell:   %s (%s)" % (m["id"], m.get("label") or m["id"]))
    h = byid(HARNESSES, m.get("harness") or "")
    if not h:
        print("Harness:  %s — NICHT REGISTRIERT" % m.get("harness")); ok = False
    else:
        binp = ex(h.get("command") or "")
        found = shutil.which(binp) or (binp if os.path.exists(binp) else None)
        print("Harness:  %s — Binary '%s': %s"
              % (h["id"], h.get("command"), found or "FEHLT (nicht im PATH)"))
        ok = ok and bool(found)
        if h.get("readyPattern"):
            print("Ready:    Muster gemessen (%s)" % h["readyPattern"])
        else:
            print("Ready:    UNGEMESSEN — wb-harness-probe %s ausfuehren" % h["id"]); ok = False
        # Konfigurationsdateien sind eine Startbedingung wie das Binary daneben, und
        # sie werden hier genauso beantwortet: nicht "vermutlich da", sondern geprueft.
        specs = h.get("configFiles")
        if isinstance(specs, list) and specs:
            for spec in specs:
                if not isinstance(spec, dict) or not spec.get("target"):
                    continue
                da = os.path.exists(ex(spec["target"]))
                pflicht = spec.get("required") is not False
                print("Konfig:   %s: %s%s" % (
                    spec["target"],
                    "vorhanden" if da else ("FEHLT — wb-harness-config apply %s" % h["id"]),
                    "" if (da or pflicht) else " (optional)"))
                if not da and spec.get("why"):
                    print("          Folge, wenn sie fehlt: %s" % spec["why"])
                if not da and pflicht:
                    ok = False
    prov = byid(PROVIDERS, m.get("provider") or "")
    if not prov:
        print("Provider: %s — NICHT REGISTRIERT" % m.get("provider")); ok = False
    elif key_required(prov):
        present, src = secret_present(prov)
        print("Provider: %s (%s) — %s"
              % (prov["id"], prov.get("kind") or "cloud",
                 ("Key hinterlegt: " + src) if present else "kein Key hinterlegt"))
        ok = ok and present
    else:
        print("Provider: %s (%s) — kein Key noetig" % (prov["id"], prov.get("kind") or "cloud"))
    if prov and (prov.get("kind") == "local") and prov["id"] == "ollama" and shutil.which("ollama"):
        ref = (m.get("modelRef") or "").split("/")[-1]
        try:
            out = subprocess.run(["ollama", "list"], capture_output=True, text=True, timeout=15).stdout
        except Exception:
            out = ""
        have = any(line.split()[0] == ref for line in out.splitlines()[1:] if line.split())
        print("Ollama:   Modell '%s': %s" % (ref, "installiert" if have else "NICHT installiert"))
        ok = ok and have
    machines = m.get("machines")
    if machines and MACHINE not in machines:
        print("Maschine: %s NICHT erlaubt (machines: %s)" % (MACHINE, ", ".join(machines))); ok = False
    else:
        print("Maschine: %s erlaubt" % MACHINE)
    sys.exit(0 if ok else 1)

# ── writes ──────────────────────────────────────────────────────────────────────
# Same two-lock, atomic, read-modify-write, change-logged shape as `settings set`
# above — deliberately rebuilt, not reinvented: the extension's mkdir lock and the
# flock used here are blind to each other, so a write takes both.
def write_registry(mutate):
    os.makedirs(os.path.dirname(MODELS_FILE), exist_ok=True)
    MKLOCK = os.path.join(LOCKDIR, os.path.basename(MODELS_FILE) + ".lock.d")
    STALE, TIMEOUT = 10.0, 60.0

    def drop_stale(path):
        try:
            os.rmdir(path)
        except OSError:
            shutil.rmtree(path, ignore_errors=True)

    start = time.time()
    while True:
        try:
            os.mkdir(MKLOCK); break
        except FileExistsError:
            try:
                age = time.time() - os.path.getmtime(MKLOCK)
            except OSError:
                continue
            if age >= STALE:
                drop_stale(MKLOCK); continue
            if time.time() - start > TIMEOUT:
                sys.stderr.write("wb-state: Registry-Lock %s haelt seit %ds — uebernehme es.\n"
                                 % (MKLOCK, int(time.time() - start)))
                drop_stale(MKLOCK); continue
            time.sleep(0.1)

    lock = open(os.path.join(LOCKDIR, os.path.basename(MODELS_FILE) + ".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        try:
            cfg = json.load(open(MODELS_FILE))
            if not isinstance(cfg, dict):
                raise ValueError("kein JSON-Objekt")
        except FileNotFoundError:
            cfg = {"version": 1}
        except Exception as e:
            cfg = {"version": 1}
            try:
                snapdir = os.path.expanduser("~/.local/trash-snapshots/%s-wb-state-models"
                                             % datetime.date.today().isoformat())
                os.makedirs(snapdir, exist_ok=True)
                snap = os.path.join(snapdir, "models.json.%s" % time.strftime("%H%M%S"))
                shutil.copy2(MODELS_FILE, snap)
            except Exception as e2:
                snap = "(Snapshot fehlgeschlagen: %s)" % e2
            sys.stderr.write("wb-state: WARNUNG — %s ist kein gueltiges JSON (%s).\n"
                             "  Kopie: %s\n"
                             "  Die Datei wird jetzt neu aufgebaut.\n" % (MODELS_FILE, e, snap))
        entries = mutate(cfg)           # list of (what, old, new) for the log
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(MODELS_FILE))
        with os.fdopen(fd, "w") as f:
            json.dump(cfg, f, indent=2, ensure_ascii=False)
            # Trailing newline like every other text file here. Without it the first
            # write through the CLI/UI made the installed models.json differ from
            # shell/models.default.json in exactly one invisible byte — a permanent
            # false positive for the deploy-drift check (measured 2026-07-28).
            f.write("\n")
        os.replace(tmp, MODELS_FILE)
        try:
            os.makedirs(os.path.dirname(CHANGELOG), exist_ok=True)
            with open(CHANGELOG, "a") as lg:
                for what, old, new in entries:
                    lg.write("%s\t%s\t%s\t%s -> %s\n" % (
                        datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                        ACTOR, what,
                        json.dumps(mask(old), ensure_ascii=False),
                        json.dumps(mask(new), ensure_ascii=False)))
        except Exception as e:
            sys.stderr.write("wb-state: WARNUNG — Registry-Aenderungslog nicht schreibbar (%s)\n" % e)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        drop_stale(MKLOCK)

KINDS = {"model": "models", "harness": "harnesses", "provider": "providers"}

def validate(kind, e, cfg):
    refuse_secrets(e, "%s:%s" % (kind, e.get("id") or "?"))
    i = e.get("id")
    if not i or not isinstance(i, str) or i.strip() != i or " " in i:
        die("FEHLER: 'id' fehlt oder enthaelt Leerzeichen.")
    if kind == "model":
        if ":" in i:
            die("FEHLER: ein Modell-id darf keinen Doppelpunkt enthalten — der trennt den "
                "Effort-Suffix (modell:effort).")
        if i in RESERVED:
            die("FEHLER: '%s' ist ein eingebauter Alias — der gewinnt immer, der Eintrag "
                "waere nie benutzbar (SPEC-V3 A.3)." % i)
        hs = [x["id"] for x in HARNESSES] + [x.get("id") for x in (cfg.get("harnesses") or [])]
        if e.get("harness") not in hs:
            die("FEHLER: Harness '%s' ist nicht registriert." % e.get("harness"),
                "Vorhanden: " + " ".join(sorted(set(x for x in hs if x))))
        ps = [x["id"] for x in PROVIDERS] + [x.get("id") for x in (cfg.get("providers") or [])]
        if e.get("provider") not in ps:
            die("FEHLER: Provider '%s' ist nicht registriert." % e.get("provider"),
                "Vorhanden: " + " ".join(sorted(set(x for x in ps if x))))
        for r in (e.get("roles") or []):
            if r not in ("worker", "orchestrator"):
                die("FEHLER: unbekannte Rolle '%s' (worker|orchestrator)." % r)
        # Was eine Stufe ist, sagt RANK; was DIESES Modell annimmt, sagt sein
        # Harness (harness_efforts). Bis 2026-08-06 stand hier "'max' nie" --
        # eine Regel, die als Formpruefung getarnt war und `max` auch dort
        # unmoeglich machte, wo der Harness es annimmt. Die Regel selbst gilt
        # weiter, aber sie steht jetzt dort, wo sie hingehoert: als Deckel
        # (maxEffort / effortCaps), den ein Mensch aendern kann.
        stufen = " ".join(sorted(RANK, key=lambda k: RANK[k]))
        # Der Harness-EINTRAG, nicht nur seine id: er kann schon geladen sein
        # (HARNESSES) oder in derselben Schreiboperation neu dazukommen (cfg).
        # Findet sich keiner oder traegt er keine Stufen, wird nichts
        # eingeschraenkt — eine Formpruefung darf nie strenger sein als das,
        # was sie nachweisen kann.
        hh = byid(HARNESSES, e.get("harness") or "") or next(
            (x for x in (cfg.get("harnesses") or [])
             if isinstance(x, dict) and x.get("id") == e.get("harness")), None)
        erlaubt = harness_efforts(hh) if hh else []
        for f in ("maxEffort", "defaultEffort"):
            if e.get(f) and e[f] not in RANK:
                die("FEHLER: %s '%s' ungueltig (%s)." % (f, e[f], stufen))
            if e.get(f) and erlaubt and e[f] not in erlaubt:
                die("FEHLER: %s '%s' — Harness '%s' nimmt diese Stufe nicht an."
                    % (f, e[f], e.get("harness")),
                    "Angenommen: " + " ".join(erlaubt))
        for v in (e.get("efforts") or []):
            if v not in RANK:
                die("FEHLER: effort '%s' ungueltig (%s)." % (v, stufen))
            # Ein Modell darf die Liste des Harness EINSCHRAENKEN, nie erweitern.
            if erlaubt and v not in erlaubt:
                die("FEHLER: efforts enthaelt '%s', aber Harness '%s' nimmt das nicht an."
                    % (v, e.get("harness")),
                    "Angenommen: " + " ".join(erlaubt),
                    "Ein Modell darf die Stufenliste seines Harness nur einschraenken.")
        # `alias` documents the spelling the SPAWNER already understands on its fast
        # path. Anything else would put a spelling into the routing table that fails
        # when typed — the registry does not resolve aliases itself.
        if e.get("alias") and e["alias"] not in RESERVED:
            die("FEHLER: alias '%s' ist kein eingebauter Alias — nur die kennt der schnelle "
                "Pfad von pi-worker/claude-worker." % e["alias"],
                "Eingebaut: " + " ".join(sorted(RESERVED)),
                "Ohne alias zeigt die Tabelle die id '%s'." % i)
        for cls, eff, _g in worker_rows(e):
            if cls not in CLASSES:
                die("FEHLER: workerClass '%s' ungueltig." % cls, "Gueltig: " + " ".join(CLASSES))
            if eff not in RANK:
                die("FEHLER: workerClass '%s': effort '%s' ungueltig (%s)."
                    % (cls, eff, stufen))
            # A table row must never advertise an effort the caps would refuse.
            # Der fable-Sonderfall stand bis 2026-08-06 daneben und nannte
            # 'medium' im Klartext -- eine dritte Stelle mit einer Zahl, die
            # CLAUDE.md laengst auf 'high' angehoben hatte. Genau die Drift, die
            # die Registry beenden soll. Der Deckel steht jetzt nur noch in
            # maxEffort (Auslieferung) bzw. in den Einstellungen (Setzung des
            # Menschen), und diese Zeile prueft gegen ihn statt gegen sich selbst.
            mx = e.get("maxEffort")
            if mx in RANK and RANK[eff] > RANK[mx]:
                die("FEHLER: workerClass '%s' empfiehlt effort '%s', das Modell ist auf '%s' "
                    "gedeckelt." % (cls, eff, mx))
        for mm in (e.get("machines") or []):
            if mm not in ("mac", "peer"):
                die("FEHLER: machine '%s' ungueltig (mac|peer)." % mm)
        for f in ("supportsEffort", "dataStaysLocal"):
            if f in e and not isinstance(e[f], bool):
                die("FEHLER: %s muss true oder false sein." % f)
    elif kind == "harness":
        if not e.get("command"):
            die("FEHLER: Harness '%s' braucht ein 'command'." % i)
    elif kind == "provider":
        if (e.get("kind") or "cloud") not in ("cloud", "local", "subscription"):
            die("FEHLER: provider kind '%s' ungueltig (cloud|local|subscription)." % e.get("kind"))

def cmd_add():
    vals, _, pos = opts(ARGV, ["kind"])
    kind = vals["kind"] or "model"
    if kind not in KINDS:
        die("FEHLER: --kind %s (model|harness|provider)" % kind)
    if not pos:
        die("FEHLER: wb-state models add [--kind model|harness|provider] '<json>'  (oder '-' fuer stdin)")
    text = stdin_text("das JSON") if pos[0] == "-" else pos[0]
    try:
        e = json.loads(text)
    except Exception as err:
        die("FEHLER: kein gueltiges JSON (%s)." % err)
    if not isinstance(e, dict):
        die("FEHLER: erwartet wird ein JSON-Objekt.")

    def mutate(cfg):
        lst = cfg.setdefault(KINDS[kind], [])
        if any(x.get("id") == e["id"] for x in lst if isinstance(x, dict)):
            die("FEHLER: '%s' gibt es schon — aendern mit 'wb-state models set'." % e["id"])
        validate(kind, e, cfg)
        lst.append(e)
        return [("%s:%s" % (kind, e["id"]), "<neu>", e)]
    write_registry(mutate)
    print("wb-state: %s '%s' hinzugefuegt." % (kind, e["id"]))

def cmd_set():
    vals, _, pos = opts(ARGV, ["kind"])
    kind = vals["kind"] or "model"
    if kind not in KINDS or len(pos) < 3:
        die("FEHLER: wb-state models set [--kind model|harness|provider] <id> <feld> <wert>",
            "<wert> darf '-' sein; dann wird er von stdin gelesen.")
    mid, field, value = pos[0], pos[1], pos[2]
    if field == "id":
        die("FEHLER: 'id' ist nicht aenderbar — remove + add.")
    if value == "-":
        value = stdin_text("den Wert")
    try:
        parsed = json.loads(value)
    except Exception:
        parsed = value

    def mutate(cfg):
        lst = cfg.setdefault(KINDS[kind], [])
        cur = next((x for x in lst if isinstance(x, dict) and x.get("id") == mid), None)
        if cur is None:
            # An entry that only exists as a BUILT-IN gets materialised into the file
            # first, so overriding one field does not throw the rest away.
            builtin = byid({"harness": HARNESSES, "provider": PROVIDERS, "model": MODELS}[kind], mid)
            if builtin is None:
                die("FEHLER: %s '%s' gibt es nicht." % (kind, mid))
            cur = dict(builtin); lst.append(cur)
        old = cur.get(field, None)
        cur[field] = parsed
        validate(kind, cur, cfg)
        return [("%s:%s.%s" % (kind, mid, field), old, parsed)]
    write_registry(mutate)
    print("wb-state: %s '%s'.%s gesetzt." % (kind, mid, field))

def cmd_remove():
    vals, _, pos = opts(ARGV, ["kind"])
    kind = vals["kind"] or "model"
    if kind not in KINDS or not pos:
        die("FEHLER: wb-state models remove [--kind model|harness|provider] <id>")
    if pos[0] == "-":
        die("FEHLER: 'remove' hat keine Eingabe von stdin — die id gehoert als Argument dahinter.")
    mid = pos[0]

    def mutate(cfg):
        if kind in ("harness", "provider"):
            key = "harness" if kind == "harness" else "provider"
            users = [m["id"] for m in (cfg.get("models") or []) if m.get(key) == mid]
            if users:
                die("FEHLER: %s '%s' wird noch benutzt von: %s" % (kind, mid, " ".join(users)))
        lst = cfg.get(KINDS[kind]) or []
        cur = next((x for x in lst if isinstance(x, dict) and x.get("id") == mid), None)
        if cur is None:
            die("FEHLER: %s '%s' steht nicht in %s." % (kind, mid, MODELS_FILE))
        lst.remove(cur)
        cfg[KINDS[kind]] = lst
        return [("%s:%s" % (kind, mid), cur, "<entfernt>")]
    write_registry(mutate)
    print("wb-state: %s '%s' entfernt." % (kind, mid))

# ── migrate-session (2026-08-11, SPEC-V4 6.3 Punkt 2) ───────────────────────────
# Die AUSLIEFERUNG (shell/models.default.json) hat seit dem 11.08. je Harness einen
# session-Block, und contextSession gibt es dort nicht mehr. Die GEPFLEGTE Registry
# dieser Maschine kennt ihn noch nicht — bis sie ihn kennt, findet die Kontextwache
# fuer die Harnesses mit Sitzungsdatei keine fuenfte Quelle mehr. Dieses Kommando
# traegt die ausgelieferten Bloecke ein und entfernt contextSession im selben Zug.
#
# Warum HART und nicht als Uebergang, der beide Felder liest: zwei Felder ueber
# dieselbe Datei sind zwei Wahrheiten, und genau diese Fehlerklasse hat am 06.08.
# sieben tote Schalter gekostet. Ein Feld, das niemand mehr liest, bleibt hier
# deshalb nicht liegen.
def cmd_migrate_session():
    vals, fl, _ = opts(ARGV, ["from"], ["dry-run"])
    quelle = vals["from"]
    if not quelle:
        die("FEHLER: wb-state models migrate-session --from <models.default.json> [--dry-run]",
            "Die Auslieferung ist die Quelle der Bloecke; ein Pfad wird nicht geraten.")
    try:
        raw = json.load(open(os.path.expanduser(quelle)))
    except Exception as e:
        die("FEHLER: %s ist nicht lesbar: %s" % (quelle, e))
    liefer = dict((h["id"], h["session"]) for h in (raw.get("harnesses") or [])
                  if isinstance(h, dict) and h.get("id") and isinstance(h.get("session"), dict))
    if not liefer:
        die("FEHLER: %s traegt keinen einzigen session-Block." % quelle)
    if fl["dry-run"]:
        for hid in sorted(liefer):
            h = byid(HARNESSES, hid) or {}
            print("%s\tsession: %s\tcontextSession: %s" % (
                hid, "schon da" if h.get("session") else "neu",
                "wird entfernt" if "contextSession" in h else "-"))
        return

    def mutate(cfg):
        lst = cfg.setdefault("harnesses", [])
        aenderungen = []
        for hid in sorted(liefer):
            cur = next((x for x in lst if isinstance(x, dict) and x.get("id") == hid), None)
            if cur is None:
                builtin = byid(HARNESSES, hid)
                if builtin is None:
                    continue          # ein Harness, den diese Maschine nicht kennt
                cur = dict(builtin); lst.append(cur)
            alt = cur.get("session")
            cur["session"] = liefer[hid]
            if alt != liefer[hid]:
                aenderungen.append(("harness:%s.session" % hid, alt, liefer[hid]))
            if "contextSession" in cur:
                aenderungen.append(("harness:%s.contextSession" % hid,
                                    cur.pop("contextSession"), "<entfernt>"))
        return aenderungen
    write_registry(mutate)
    # Was die Auslieferung nicht kennt, bleibt stehen — aber es wird GESAGT, sonst
    # traegt ein handgepflegter Eintrag ein totes Feld weiter.
    rest = [h["id"] for h in merge(load_raw(), "harnesses", BUILTIN_HARNESSES)
            if "contextSession" in h or not isinstance(h.get("session"), dict)]
    print("wb-state: session-Bloecke fuer %d Harnesses uebernommen." % len(liefer))
    if rest:
        print("wb-state: HINWEIS — ohne session-Block (oder mit uebrigem contextSession): %s. "
              "Die Kontextwache liest fuer sie keine Sitzungsdatei." % " ".join(rest))

# ── discover: automatic model detection (Vertrag scratchpad/CONTRACT-discover.md,
# 2026-07-29) ────────────────────────────────────────────────────────────────────
# A harness with a "discover" block names a LOCAL source (an installed CLI or a
# file it already writes) that lists what models it knows about right now. This
# command turns that list into 'source: "auto"' registry entries — the user's own
# words: "automatisch importieren, wo der CLI seine Modelle selbst nennt". No
# network access happens here, only local commands/files the machine already has.
MANAGED_FIELDS = ["label", "provider", "modelRef", "roles", "efforts", "maxEffort",
                  "defaultEffort", "machines", "supportsEffort", "discoveredAt"]
# discoveredAt refreshes on EVERY successful run by design (it is a last-seen
# marker) — comparing it would report every untouched entry as "updated" forever,
# since it never equals the previous run's value. It is still written like any
# other managed field; it just does not decide added/updated/kept on its own.
DIFF_FIELDS = [f for f in MANAGED_FIELDS if f != "discoveredAt"]
DISCOVER_TIMEOUT = 20   # seconds per source (Vertrag 1)

def slug_ref(ref):
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", ref.lower())).strip("-")

def discover_ollama(timeout):
    # 'ollama list' fragt selbst nach OLLAMA_HOST (Vorgabe 127.0.0.1:11434, wenn die
    # Variable fehlt) -- ohne diese Zeile haette ein gesetzter ollamaEndpoint hier NIE
    # gewirkt, obwohl genau das eine echte Verbindung ist (2026-08-11 nachgetragen,
    # zusammen mit der Adresse als Einstellungsschluessel).
    env = dict(os.environ)
    ollama_prov = byid(PROVIDERS, "ollama") or {}
    env["OLLAMA_HOST"] = ollama_baseurl(ollama_prov.get("baseUrl") or "http://127.0.0.1:11434")
    try:
        r = subprocess.run(["ollama", "list"], capture_output=True, text=True, timeout=timeout, env=env)
    except Exception as e:
        return None, str(e)
    if r.returncode != 0:
        return None, "ollama list: exit %d (%s)" % (r.returncode, (r.stderr or "").strip()[:200])
    refs = []
    for line in r.stdout.splitlines()[1:]:      # erste Zeile ist die Kopfzeile
        line = line.strip()
        if line:
            refs.append(line.split()[0])
    return refs, None

def discover_command_lines(command, timeout, separator=None):
    try:
        r = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
    except Exception as e:
        return None, str(e)
    if r.returncode != 0:
        return None, "%s: exit %d (%s)" % (" ".join(command), r.returncode,
                                            (r.stderr or "").strip()[:200])
    lines = [l for l in r.stdout.splitlines() if l.strip()]
    # NACHTRAG 2026-08-08 zu dem Bannerschutz unten. Bis heute galt: eine Zeile mit
    # (innerem) Leerzeichen oder Steuerzeichen ist ein Banner. Das war zu grob. `agy
    # models` liefert seit einer Formataenderung ZWEI Spalten, durch einen Tabulator
    # getrennt:
    #     gemini-3.6-flash-high\tGemini 3.6 Flash (High)
    # Damit fiel JEDE Zeile heraus, die Liste war leer, und der Lauf meldete
    # "agy: +0 neu, 0 aktualisiert, -9 entfernt" — neun Modelle weg, weil das
    # Ausgabeformat sich geaendert hat. (Gegen den Datenverlust selbst steht jetzt
    # die Leer-Sperre in empty_answer_guard; hier steht, dass die Zeilen wieder
    # gelesen werden.)
    #
    # Der Schutz wird deshalb GENAUER statt schwaecher: gibt es ein Trennzeichen, ist
    # eine Datenzeile daran zu erkennen, dass sie es traegt — und die Referenz ist die
    # ERSTE Spalte, die weiterhin ein blankes Wort sein muss. Ein Banner wie
    # "Fetching available models..." traegt keinen Tabulator und faellt heraus, ein
    # Banner MIT Tabulator scheitert an der Wortpruefung der ersten Spalte.
    #
    # Das Trennzeichen kommt aus dem discover-Block (`separator`, neben `source`,
    # `command`, `provider`), sonst aus der Ausgabe selbst: traegt IRGENDEINE Zeile
    # einen Tabulator, ist die Ausgabe tabellarisch. Die Erkennung ist bewusst der
    # Normalfall und die Registry-Angabe die Ausnahme — so ueberlebt ein Harness den
    # Wechsel in BEIDE Richtungen ohne Registry-Pflege (`opencode models` ist
    # einspaltig und laeuft unveraendert weiter), waehrend ein Format, das die
    # Erkennung nicht raten kann (etwa ' | ' oder ','), es hinschreiben kann.
    sep = separator or ("\t" if any("\t" in l for l in lines) else None)
    refs = []
    for line in lines:
        if sep:
            if sep not in line:
                continue                      # keine Datenzeile -> Banner
            t = line.split(sep, 1)[0].strip()
        else:
            t = line.strip()
        if not t:
            continue
        # Zeilen mit (innerem) Leerzeichen oder Steuerzeichen sind ein Banner, keine
        # Referenz (Schutz vor Bannern, Vertrag 1). Bei getrennter Ausgabe gilt die
        # Pruefung fuer die erste Spalte.
        if any(c.isspace() for c in t) or any(ord(c) < 32 for c in t):
            continue
        refs.append(t)
    return refs, None

# Shared by 'file-json' (Vertrag Teil 1) and 'http-json' (Vertrag Teil 2) — both use
# the SAME 'a[].b' list form, only the data source differs (a local file vs. an HTTP
# response). Nur diese eine Form, keine allgemeine Pfadsprache.
def json_list_field(data, json_path):
    m = re.match(r"^([A-Za-z0-9_]+)\[\]\.([A-Za-z0-9_]+)$", json_path or "")
    if not m:
        return None, "jsonPath '%s' wird nicht unterstuetzt (nur 'a[].b')." % json_path
    listkey, field = m.group(1), m.group(2)
    lst = data.get(listkey) if isinstance(data, dict) else None
    if not isinstance(lst, list):
        return None, "Feld '%s' fehlt oder ist keine Liste." % listkey
    return [(item, item.get(field)) for item in lst if isinstance(item, dict)], None

def discover_file_json(file_path, json_path, filt, timeout):
    if not file_path:
        return None, "discover.file fehlt."
    path = ex(file_path)
    try:
        data = json.load(open(path))
    except Exception as e:
        return None, str(e)
    pairs, err = json_list_field(data, json_path)
    if err:
        return None, err
    refs = []
    for item, v in pairs:
        if filt and item.get(filt.get("field")) != filt.get("equals"):
            continue
        if isinstance(v, str) and v.strip():
            refs.append(v.strip())
    return refs, None

# ── http-json: provider catalogs (Vertrag Teil 2, scratchpad/CONTRACT-katalog.md) ──
# Unlike ollama/command-lines/file-json (harness-scoped, unchanged above), a catalog
# belongs to a PROVIDER: one HTTP call covers every harness that can run it
# (Vertrag 3 — registering the cross product per harness would double the registry
# for no reason). 'discover' with source 'http-json' therefore lives on the
# PROVIDER object, not on a harness; cmd_discover treats providers-with-a-catalog as
# a second kind of target alongside harnesses-with-a-local-source.
def get_path(obj, path):
    """Dotted path getter ('pricing.prompt', 'data.limit_remaining') — a DIFFERENT,
    simpler form than json_list_field's 'a[].b': no arrays, just nested dict keys."""
    cur = obj
    for part in (path or "").split("."):
        if not part or not isinstance(cur, dict) or part not in cur:
            return None
        cur = cur[part]
    return cur

def http_get_json(url, headers, timeout):
    # headers travel in a mode-600 temp FILE ('-H @file'), never in argv — a key on
    # the command line is visible to any other process on this machine via `ps` for
    # as long as curl runs. The file is removed right after, success or not.
    hdrfile = None
    if headers:
        os.makedirs(CATALOG_DIR, exist_ok=True)
        fd, hdrfile = tempfile.mkstemp(dir=CATALOG_DIR)
        os.chmod(hdrfile, 0o600)
        with os.fdopen(fd, "w") as f:
            for k, v in headers:
                f.write("%s: %s\n" % (k, v))
    try:
        cmd = ["/usr/bin/curl", "-s", "-S", "--max-time", str(timeout)]
        if hdrfile:
            cmd += ["-H", "@" + hdrfile]
        cmd += [url]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 5)
        except Exception:
            return None, "curl fehlgeschlagen (Timeout oder Prozessfehler)."
    finally:
        if hdrfile:
            try:
                os.unlink(hdrfile)
            except Exception:
                pass
    if r.returncode != 0:
        # NIE r.stderr ausgeben: curl haengt bei einem Fehler mitunter die Ziel-URL an
        # seine Meldung, und ein Query-String koennte theoretisch Nutzdaten tragen.
        return None, "curl exit %d" % r.returncode
    try:
        return json.loads(r.stdout), None
    except Exception:
        return None, "Antwort ist kein JSON."

def is_zero_price(v):
    if isinstance(v, bool):
        return False
    if isinstance(v, (int, float)):
        return float(v) == 0.0
    if isinstance(v, str):
        try:
            return float(v) == 0.0
        except ValueError:
            return False
    return False

def catalog_items(data, json_path, price_fields):
    pairs, err = json_list_field(data, json_path)
    if err:
        return None, err
    items = []
    for item, ref in pairs:
        if not (isinstance(ref, str) and ref.strip()):
            continue
        pin = get_path(item, (price_fields or {}).get("in") or "") if price_fields else None
        pout = get_path(item, (price_fields or {}).get("out") or "") if price_fields else None
        items.append({"ref": ref.strip(), "priceIn": pin, "priceOut": pout})
    return items, None

def is_free_item(it):
    # kostenlos = Preisfelder aus priceFields sind '0' bzw. 0 (Vertrag 2) — ohne ein
    # 'in'-Preisfeld (Anbieter ohne priceFields) ist "kostenlos" nicht feststellbar,
    # gemessen 2026-07-29 gegen die echte OpenRouter-Liste: Pruefung nur auf 'in'
    # ergab dieselben 17 wie 'in' UND 'out', beide Varianten stimmen mit des Nutzers
    # Messung ueberein — 'out' bleibt als Gegenprobe drin, falls sich das je trennt.
    if it.get("priceIn") is None or not is_zero_price(it["priceIn"]):
        return False
    if it.get("priceOut") is not None and not is_zero_price(it["priceOut"]):
        return False
    return True

CATALOG_DIR = os.path.join(HOME, ".local", "state", "wb-model-catalog")

def catalog_cache_path(pid):
    return os.path.join(CATALOG_DIR, "%s.json" % pid)

def balance_cache_path(pid):
    return os.path.join(CATALOG_DIR, "%s.balance.json" % pid)

def write_cache_file(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, indent=2, ensure_ascii=False)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except Exception:
            pass
        raise

def fetch_provider_balance(prov, key, timeout):
    """(value, err). value stays None with err=None when there is simply no
    'balance' block to check (Vertrag 2: those providers register everything
    once a key exists, no Guthaben concept applies)."""
    bal = prov.get("balance")
    if not bal or not bal.get("url"):
        return None, None
    headers = []
    auth = (prov.get("discover") or {}).get("auth") or {}
    if key and auth.get("header") and auth.get("value"):
        headers.append((auth["header"], auth["value"].replace("{key}", key)))
    data, err = http_get_json(bal["url"], headers, timeout)
    if err:
        return None, err
    val = get_path(data, bal.get("jsonPath") or "")
    # Some accounts express the balance as two numbers rather than one. OpenRouter's
    # /api/v1/credits answers {"data":{"total_credits":0,"total_usage":0}}; its
    # /api/v1/key answers limit_remaining, which is null whenever no spending limit is
    # set — indistinguishable from "could not read it" and therefore useless as the
    # deciding value (measured 2026-07-29). `minusJsonPath` lets the block name the
    # second number and subtract it.
    minus = bal.get("minusJsonPath")
    if minus and val is not None:
        used = get_path(data, minus)
        try:
            val = float(val) - float(used or 0)
        except (TypeError, ValueError):
            return None, None
    return val, None

def catalog_for_provider(prov, dry_run, timeout):
    """The ONE entry point for a provider's http-json catalog: fetch/cache the
    catalog and (if the provider has a 'balance' block) the balance, decide which
    refs are eligible for registration this run, apply maxModels. Returns
    {"refs": [...]|None, "error": str|None, "meta": {...}|None}. meta never
    contains the key itself — only booleans/numbers/timestamps for 'models catalog'
    and for the discover --json report."""
    pid = prov["id"]
    dc = prov.get("discover") or {}
    url = dc.get("url")
    if not url:
        return {"refs": None, "error": "discover.url fehlt.", "meta": None}
    auth = dc.get("auth") or {}
    key = read_secret_value(prov)
    if bool(auth.get("required")) and not key:
        # Vertrag 1: gar nicht erst abrufen, gilt als "kein Key" -- kein Netzzugriff,
        # kein Cache-Schreibvorgang, nichts registriert.
        return {"refs": [], "error": None, "meta": {
            "catalogSize": None, "freeCount": None, "hasKey": False, "fetchedAt": None,
            "stale": None, "balance": None, "balanceAt": None, "mode": "no-key"}}

    cache_path = catalog_cache_path(pid)
    cache_hours = float(dc.get("cacheHours", 24))
    cache_exists = os.path.exists(cache_path)
    cache_fresh = cache_exists and (
        (time.time() - os.path.getmtime(cache_path)) / 3600.0 < cache_hours)
    data, fetch_err, fetched_now = None, None, False
    if not cache_fresh:
        headers = []
        if key and auth.get("header") and auth.get("value"):
            headers.append((auth["header"], auth["value"].replace("{key}", key)))
        data, fetch_err = http_get_json(url, headers, timeout)
        fetched_now = data is not None

    stale = False
    if data is None:
        # Netz weg, Fehler, oder noch frisch genug -> letzter Stand vom Datentraeger
        # (Vertrag 1: "Ohne Netz gilt der letzte Stand, und die Seite sagt das").
        if cache_exists:
            try:
                data = json.load(open(cache_path))
                stale = not cache_fresh
            except Exception:
                data = None
        if data is None:
            return {"refs": None, "error": fetch_err or "kein Katalog verfuegbar "
                    "(kein Cache, keine Antwort).", "meta": None}

    if fetched_now and not dry_run:
        try:
            write_cache_file(cache_path, data)
        except Exception as e:
            sys.stderr.write("wb-state: WARNUNG — Katalog-Cache fuer '%s' nicht "
                             "schreibbar (%s)\n" % (pid, e))

    items, list_err = catalog_items(data, dc.get("jsonPath"), dc.get("priceFields"))
    if list_err:
        return {"refs": None, "error": list_err, "meta": None}
    max_models = int(dc.get("maxModels", 1000))
    catalog_size = len(items)
    free_items = [it for it in items if is_free_item(it)]
    free_count = len(free_items)
    fetched_at = None
    if os.path.exists(cache_path):
        fetched_at = datetime.datetime.fromtimestamp(
            os.path.getmtime(cache_path), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    elif fetched_now:
        fetched_at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    if not key:
        # Katalog ANGEZEIGT, aber nichts registriert (Vertrag 1): auch ein
        # kostenloses Modell laeuft ohne Key nicht.
        return {"refs": [], "error": None, "meta": {
            "catalogSize": catalog_size, "freeCount": free_count, "hasKey": False,
            "fetchedAt": fetched_at, "stale": stale, "balance": None, "balanceAt": None,
            "mode": "no-key"}}

    balance_val, balance_at, mode = None, None, "all"
    bal_cfg = prov.get("balance")
    if bal_cfg:
        bpath = balance_cache_path(pid)
        bhours = float(bal_cfg.get("cacheHours", cache_hours))
        b_fresh = os.path.exists(bpath) and (
            (time.time() - os.path.getmtime(bpath)) / 3600.0 < bhours)
        if b_fresh:
            try:
                cached = json.load(open(bpath))
                balance_val, balance_at = cached.get("value"), cached.get("at")
            except Exception:
                b_fresh = False
        if not b_fresh:
            val, berr = fetch_provider_balance(prov, key, timeout)
            if berr is None:
                balance_val = val
                balance_at = datetime.datetime.now(datetime.timezone.utc).strftime(
                    "%Y-%m-%dT%H:%M:%SZ")
                if not dry_run:
                    try:
                        write_cache_file(bpath, {"value": val, "at": balance_at})
                    except Exception as e:
                        sys.stderr.write("wb-state: WARNUNG — Guthaben-Cache fuer '%s' "
                                         "nicht schreibbar (%s)\n" % (pid, e))
            elif os.path.exists(bpath):
                try:
                    cached = json.load(open(bpath))
                    balance_val, balance_at = cached.get("value"), cached.get("at")
                except Exception:
                    pass
        if balance_val is None:
            # Kein lesbarer Betrag. Der Vertrag ist hier eindeutig: "Guthaben 0 oder
            # UNBEKANNT -> nur die kostenlosen". Die Kehrseite waere teuer und still —
            # ohne Guthaben registrierte Bezahlmodelle stehen auswaehlbar in der Liste
            # und scheitern erst beim Start. `freeWhenEmpty` stand vorher genau
            # verkehrt herum ('all', wenn der Wert fehlt) und hat deshalb alle 367
            # OpenRouter-Modelle eingetragen, obwohl das Konto 0 Guthaben hat
            # (gemessen 2026-07-29 ueber /api/v1/credits).
            mode = "free" if bal_cfg.get("freeWhenEmpty", True) else "all"
        else:
            try:
                mode = "all" if float(balance_val) > 0 else "free"
            except (TypeError, ValueError):
                mode = "free"
    # Kein balance-Block: Key vorhanden = alles (Vertrag 2, OpenAI/Anthropic/Google —
    # es gibt dort keine guenstige Guthaben-Abfrage, mode bleibt 'all').

    eligible = items if mode == "all" else free_items
    eligible = eligible[:max_models]
    refs = [it["ref"] for it in eligible]
    return {"refs": refs, "error": None, "meta": {
        "catalogSize": catalog_size, "freeCount": free_count, "hasKey": True,
        "fetchedAt": fetched_at, "stale": stale, "balance": balance_val,
        "balanceAt": balance_at, "mode": mode}}

def compute_ref(dc, ref):
    return (dc.get("refTemplate") or "{name}").replace("{name}", ref)

def compute_id(dc, hid, model_ref):
    # Slug der FERTIGEN modelRef (nach refTemplate), nicht der rohen Quell-Referenz —
    # 'ollama/ornith:35b' -> 'ollama-ornith-35b' ist das Vertrags-Beispiel woertlich
    # (Vertrag 3), und nur so tragen aider-Referenzen ihr 'ollama/'-Praefix im Slug.
    idprefix = dc.get("idPrefix") or (hid + "-")
    return idprefix + slug_ref(model_ref)

# Was ein automatisch gefundenes Modell mitbekommt. Shared by build_entry
# (harness-local sources) and plan_for_catalog (provider catalogs) so the policy
# lives in exactly one place.
#
# 2026-08-06, zwei Aenderungen mit derselben Begruendung:
#   * `efforts` ist jetzt die VOLLE Stufenliste des Harness, `max` eingeschlossen
#     — sie beschreibt, was das Werkzeug annimmt, und das ist gemessen.
#   * `maxEffort` bleibt die hoechste Stufe UNTERHALB von `max`. Der ausgelieferte
#     DECKEL ist die Selbstbindung der Agenten, und die hebt sich nicht von selbst
#     an, nur weil eine Stufe darueber existiert. `max` erreicht damit, wer es
#     ausdruecklich will: ein Mensch (--mensch) oder ein Deckel, den der Nutzer
#     bewusst dorthin setzt. 'ultra' kennt RANK nicht und wird still uebergangen.
def derive_efforts(effort_map):
    keys = sorted((k for k in effort_map if k in RANK), key=lambda k: RANK[k])
    if not keys:
        return None
    ohne_max = [k for k in keys if k != "max"] or keys
    return {"efforts": keys, "maxEffort": ohne_max[-1],
            "defaultEffort": "medium" if "medium" in keys else keys[0]}

def build_entry(hid, dc, ref, model_ref, mid, now_iso, effort_map, effort_style):
    provider = dc.get("provider")
    for prefix, pid in (dc.get("providerByPrefix") or []):
        if model_ref.startswith(prefix):
            provider = pid
            break
    roles = dc.get("roles") or ["worker", "orchestrator"]
    supports = dc.get("supportsEffort")
    if supports is None:
        supports = effort_style != "none"
    entry = {
        "id": mid, "label": ref, "harness": hid, "provider": provider,
        "modelRef": model_ref, "roles": roles, "machines": ["mac", "peer"],
        "enabled": True, "source": "auto", "discoveredAt": now_iso,
        "supportsEffort": bool(supports),
    }
    if supports:
        eff = derive_efforts(effort_map)
        if eff:
            entry.update(eff)
    return entry

def plan_for(hid, dc, refs, models_list, now_iso, effort_map, effort_style):
    by_id, curated_pairs = {}, set()
    for m in models_list:
        if not isinstance(m, dict) or not m.get("id"):
            continue
        by_id[m["id"]] = m
        if m.get("source") != "auto":                     # Vertrag 4.1/4.2
            curated_pairs.add((m.get("harness"), m.get("modelRef")))
    # Aufgeraeumt wird nur, was DIESER Lauf auch anlegen koennte -- also die
    # automatischen Eintraege dieses Harness AUS SEINEN EIGENEN QUELLEN
    # (2026-08-06). Vorher stand hier "alle automatischen Eintraege dieses
    # Harness", und das war zu grob: unter EINEM Harness koennen mehrere Quellen
    # registrieren. Ein `aider`-Harness-Lauf meldete so "-17 entfernt", und diese
    # 17 waren sSmtlich `aider-openrouter-*` aus einem KATALOG-Lauf -- Eintraege,
    # die dieser Lauf nie haette anlegen koennen und deren Quelle er nicht einmal
    # abgefragt hat. Stiller Datenverlust in der Registry, ausgeloest von einem
    # Befehl, der wie eine Bestandsaufnahme aussieht.
    #
    # Welche Anbieter dieser Lauf bedienen kann, steht in seinem discover-Block
    # und wird von build_entry genauso gelesen: `provider`, plus alles aus
    # `providerByPrefix`. Ein Lauf ohne Anbieterangabe legt Eintraege mit
    # provider=None an und raeumt dann genau die auf -- deshalb steht `None` hier
    # bewusst mit in der Menge und wird nicht weggefiltert.
    #
    # plan_for_catalog unten macht dasselbe seit jeher (dort nach Harness UND
    # Anbieter); die Begruendung stand da und fehlte nur auf dieser Seite.
    eigene_provider = {dc.get("provider")}
    eigene_provider.update(pid for _prefix, pid in (dc.get("providerByPrefix") or []))
    existing_auto = set(mid for mid, m in by_id.items()
                        if m.get("harness") == hid and m.get("source") == "auto"
                        and m.get("provider") in eigene_provider)
    seen, added, updated, warnings, new_entries = set(), [], [], [], {}
    for ref in refs:
        model_ref = compute_ref(dc, ref)
        mid = compute_id(dc, hid, model_ref)
        if (hid, model_ref) in curated_pairs:
            continue                                        # Vertrag 4.2: kein Duplikat
        if mid in RESERVED:
            warnings.append("erkannte id '%s' ist ein eingebauter Alias — uebersprungen." % mid)
            continue
        cur = by_id.get(mid)
        if cur is not None and cur.get("source") != "auto":
            warnings.append("erkannte id '%s' (Harness %s, Referenz '%s') kollidiert mit einem "
                            "kuratierten Eintrag — uebersprungen." % (mid, hid, ref))
            continue                                        # Vertrag 4.5
        seen.add(mid)
        entry = build_entry(hid, dc, ref, model_ref, mid, now_iso, effort_map, effort_style)
        new_entries[mid] = entry
        if cur is None:
            added.append(mid)
        elif any(cur.get(f) != entry.get(f) for f in DIFF_FIELDS):
            updated.append(mid)                             # Vertrag 4.4
    removed = sorted(existing_auto - seen)                  # Vertrag 4.3 (nur bei Erfolg aufgerufen)
    kept = len(seen) - len(added) - len(updated)
    return {"added": sorted(added), "removed": removed, "updated": sorted(updated),
            "kept": kept, "new_entries": new_entries, "warnings": warnings}

# Same shape as plan_for above, but scoped by (harness, PROVIDER) instead of just
# harness: several providers can register under the SAME runner harness (Vertrag
# Teil 2 Abschnitt 3 — 'aider' runs both openrouter and openai models), each as its
# OWN independent discover call. Scoping existing_auto/curated_pairs by harness alone
# would make one provider's run see (and remove) another provider's entries under the
# same harness. modelRef is the raw catalog ref itself — no refTemplate/idPrefix
# override, no providerByPrefix (there is only ever ONE provider per call here); the
# id form 'aider-openrouter-qwen-qwen3-max' (Vertrag 3) is harness + provider + slug.
def plan_for_catalog(hid, pid, refs, models_list, now_iso, effort_map, effort_style, roles):
    by_id, curated_pairs = {}, set()
    for m in models_list:
        if not isinstance(m, dict) or not m.get("id"):
            continue
        by_id[m["id"]] = m
        if m.get("source") != "auto":
            curated_pairs.add((m.get("harness"), m.get("modelRef")))
    existing_auto = set(mid for mid, m in by_id.items()
                        if m.get("harness") == hid and m.get("provider") == pid
                        and m.get("source") == "auto")
    idprefix = "%s-%s-" % (hid, pid)
    seen, added, updated, warnings, new_entries = set(), [], [], [], {}
    for ref in refs:
        mid = idprefix + slug_ref(ref)
        if (hid, ref) in curated_pairs:
            continue
        if mid in RESERVED:
            warnings.append("erkannte id '%s' ist ein eingebauter Alias — uebersprungen." % mid)
            continue
        cur = by_id.get(mid)
        if cur is not None and cur.get("source") != "auto":
            warnings.append("erkannte id '%s' (Harness %s, Anbieter %s, Referenz '%s') "
                            "kollidiert mit einem kuratierten Eintrag — uebersprungen."
                            % (mid, hid, pid, ref))
            continue
        seen.add(mid)
        supports = effort_style != "none"
        entry = {"id": mid, "label": ref, "harness": hid, "provider": pid,
                 "modelRef": ref, "roles": roles, "machines": ["mac", "peer"],
                 "enabled": True, "source": "auto", "discoveredAt": now_iso,
                 "supportsEffort": bool(supports)}
        if supports:
            eff = derive_efforts(effort_map)
            if eff:
                entry.update(eff)
        new_entries[mid] = entry
        if cur is None:
            added.append(mid)
        elif any(cur.get(f) != entry.get(f) for f in DIFF_FIELDS):
            updated.append(mid)
    removed = sorted(existing_auto - seen)
    kept = len(seen) - len(added) - len(updated)
    return {"added": sorted(added), "removed": removed, "updated": sorted(updated),
            "kept": kept, "new_entries": new_entries, "warnings": warnings}

# Eine LEERE Antwort ist kein Ergebnis, sondern ein Ausfall (2026-08-08). Vertrag 4.3
# sagt seit jeher "eine gescheiterte Quelle entfernt NICHTS", aber das haengt an `err`.
# Am 08.08. kam von `agy models` err=None und refs=[] — formal ein Erfolg —, und
# plan_for raeumte pflichtgemaess alle neun automatischen Eintraege des Harness weg.
# Der Formatfehler oben ist repariert; diese Sperre gilt gegen JEDE kuenftige
# Formataenderung, gegen einen Dienst, der gerade nicht laeuft, und gegen einen Key,
# der aus dem Schluesselbund verschwunden ist:
#
#   Lieferte eine Quelle NICHTS, waehrend sie noch automatische Eintraege hat, wird
#   nichts entfernt, und der Lauf meldet, dass hier eine Entscheidung UNTERBLIEBEN
#   ist. Sie gilt nur fuer die VOLLSTAENDIG leere Antwort — eine Quelle, die 10 von
#   11 nennt, verliert das elfte wie bisher; ein Anbieter, der ein Modell wirklich
#   abkuendigt, ist damit unberuehrt.
#
# Der Weg fuer den echten Gegenfall (ein Harness, dessen Liste wirklich leer wird)
# ist `--allow-empty`: ein ausdruecklicher Schalter FUER DIESEN EINEN LAUF, der
# nichts speichert — dieselbe Form wie --force und --no-network daneben. Eine
# Rueckfrage waere hier falsch: discover laeuft unbeaufsichtigt aus wb-code und mit
# --if-stale, da sitzt niemand, der sie beantwortet. Wer nur einen einzelnen Eintrag
# los werden will, hat weiterhin 'wb-state models remove <id>'.
def empty_answer_guard(tid, refs, plan, allow_empty):
    if refs or allow_empty or not plan["removed"]:
        return None
    return ("Quelle lieferte 0 Modelle, waehrend %d automatische Eintraege bestehen — "
            "nichts entfernt, Entscheidung UNTERBLIEBEN (Ausfall angenommen). Ist die "
            "Liste wirklich leer: 'wb-state models discover %s --allow-empty'."
            % (len(plan["removed"]), tid))

# Applies a plan (from plan_for OR plan_for_catalog — identical dict shape) to the
# registry cfg: remove vanished refs, then add/update managed fields. Shared by the
# local-harness and provider-catalog branches of do_mutate below so the "only the
# MANAGED fields survive an update, enabled/workerClass never do" rule lives once.
def apply_plan(cfg, models_list, plan, entries_log):
    if plan["removed"]:
        rset = set(plan["removed"])
        for mid in plan["removed"]:
            old = next((m for m in models_list if m.get("id") == mid), None)
            entries_log.append(("model:%s" % mid, old, "<entfernt (discover)>"))
        models_list[:] = [m for m in models_list if m.get("id") not in rset]
    for mid, new_e in plan["new_entries"].items():
        cur = next((m for m in models_list if m.get("id") == mid), None)
        if cur is None:
            validate("model", new_e, cfg)
            models_list.append(new_e)
            entries_log.append(("model:%s" % mid, "<neu>", new_e))
        else:
            old = dict(cur)
            for f in MANAGED_FIELDS:
                if f in new_e:
                    cur[f] = new_e[f]
                elif f in cur:
                    del cur[f]
            validate("model", cur, cfg)
            if mid in plan["updated"]:
                entries_log.append(("model:%s" % mid, old, dict(cur)))

# Nachtrag 2026-07-29 (Extension-Seite): die Oberflaeche liest Katalog-/Guthabenzahlen
# vom PROVIDER-Objekt selbst (catalogStatus/balanceStatus), nicht aus einer eigenen
# Datei — der rohe Katalog liegt trotzdem ZUSAETZLICH im Cache (fuer 'models catalog'
# und fuer freeCount, das nicht auf dem Provider steht). Materialisiert einen
# Nur-eingebauten Provider ins File, genau wie cmd_set es fuer ein einzelnes Feld tut.
def upsert_provider_field(cfg, pid, field, value):
    provs = cfg.setdefault("providers", [])
    cur = next((p for p in provs if isinstance(p, dict) and p.get("id") == pid), None)
    if cur is None:
        builtin = byid(PROVIDERS, pid)
        if builtin is None:
            return
        cur = dict(builtin)
        provs.append(cur)
    cur[field] = value

def cmd_discover():
    _vals, fl, pos = opts(ARGV, [], ["all", "if-stale", "dry-run", "json", "force", "no-network",
                                     "allow-empty"])
    # Vertrag Teil 2 Abschnitt 5 + Nachtrag (2026-07-29, Extension-Seite): modelDiscoveryAuto
    # gates ONLY the network path (catalog providers below) — ollama/command-lines/
    # file-json are local, cost nothing, never leave the machine, and are never
    # affected by either flag. --force is the "Kataloge jetzt aktualisieren"-Knopf:
    # overrides modelDiscoveryAuto=false for this one call. --no-network is the
    # opposite override: suppresses the network path for this one call regardless of
    # the setting, even over --force (an explicit "not now" always wins over a
    # standing default). Neither flag persists anything.
    if fl["no-network"]:
        auto_enabled = False
    else:
        auto_enabled = fl["force"] or read_setting_bool("modelDiscoveryAuto", True)

    local_ids = [h["id"] for h in HARNESSES if isinstance(h.get("discover"), dict)]
    catalog_ids = [p["id"] for p in PROVIDERS
                  if isinstance(p.get("discover"), dict) and p["discover"].get("source") == "http-json"]
    # Vertrag 1: ohne Argument = --all. Katalog-Anbieter sind darin NUR enthalten,
    # wenn der Netzabruf gerade erlaubt ist — ein --all-Lauf mit modelDiscoveryAuto=
    # false soll still bleiben, nicht fuer jeden Anbieter eine Zeile "steht aus" zeigen.
    requested = pos if pos else local_ids + (catalog_ids if auto_enabled else [])

    STATEFILE = os.path.join(HOME, ".local", "state", "wb-models-discover.json")
    try:
        ttl_state = json.load(open(STATEFILE))
        if not isinstance(ttl_state, dict):
            ttl_state = {}
    except Exception:
        ttl_state = {}

    now = datetime.datetime.now(datetime.timezone.utc)
    now_iso = now.strftime("%Y-%m-%dT%H:%M:%SZ")

    output = {}      # id -> {"added":[],"removed":[],"updated":[],"kept":n,"error":None|str, …}
    to_query_local = []      # (hid, h, dc)
    to_query_catalog = []    # (pid, prov, dc)
    for tid in requested:
        h = byid(HARNESSES, tid)
        prov = byid(PROVIDERS, tid)
        is_local = h is not None and isinstance(h.get("discover"), dict)
        is_catalog = (not is_local) and prov is not None and isinstance(prov.get("discover"), dict) \
                     and prov["discover"].get("source") == "http-json"
        if not is_local and not is_catalog:
            output[tid] = {"added": [], "removed": [], "updated": [], "kept": 0,
                           "error": "kein discover-Block fuer '%s' (weder Harness noch "
                                    "Anbieter mit Katalog)." % tid}
            continue
        if is_catalog and not auto_enabled:
            # Explizit angefordert, aber der Netzpfad ist fuer diesen Lauf unterdrueckt:
            # nicht stillschweigend ignorieren, sondern sagen wieso (die Situation ist
            # anders als "gar nicht angefordert", die einfach aus der --all-Liste
            # faellt, siehe oben). --no-network wird zuerst genannt, weil es explizit
            # fuer GENAU diesen Aufruf gilt, waehrend modelDiscoveryAuto ein Dauerzustand
            # ist, den --force ueberschreiben kann.
            if fl["no-network"]:
                msg = "--no-network unterdrueckt den Netzabruf fuer diesen Lauf."
            else:
                msg = ("modelDiscoveryAuto ist aus — 'models discover %s --force' "
                      "erzwingt diesen einen Netzabruf." % tid)
            output[tid] = {"added": [], "removed": [], "updated": [], "kept": 0, "error": msg}
            continue
        dc = h["discover"] if is_local else prov["discover"]
        if fl["if-stale"]:
            st = ttl_state.get(tid) or {}
            at = st.get("at")
            if at:
                try:
                    dt = datetime.datetime.strptime(at, "%Y-%m-%dT%H:%M:%SZ").replace(
                        tzinfo=datetime.timezone.utc)
                    ttl_hours = dc.get("ttlHours", dc.get("cacheHours", 12))
                    if (now - dt).total_seconds() < float(ttl_hours) * 3600.0:
                        continue        # Vertrag 1: frisch genug, ganz uebersprungen
                except Exception:
                    pass
        if is_local:
            to_query_local.append((tid, h, dc))
        else:
            to_query_catalog.append((tid, prov, dc))

    # Quellen abfragen BEVOR der Registry-Lock genommen wird — ein 20s-Timeout pro
    # Ziel darf keinen Schreibvorgang blockieren, den niemand sonst anfassen kann.
    fetched_local = {}
    for hid, h, dc in to_query_local:
        source = dc.get("source")
        if source == "ollama":
            refs, err = discover_ollama(DISCOVER_TIMEOUT)
        elif source == "command-lines":
            cmd = dc.get("command")
            refs, err = (None, "discover.command fehlt.") if not cmd else \
                discover_command_lines(cmd, DISCOVER_TIMEOUT, dc.get("separator"))
        elif source == "file-json":
            refs, err = discover_file_json(dc.get("file"), dc.get("jsonPath"), dc.get("filter"),
                                           DISCOVER_TIMEOUT)
        else:
            refs, err = None, "unbekannte discover.source '%s'." % source
        if refs is not None:
            order, dedup = set(), []
            for r in refs:
                if r not in order:
                    order.add(r); dedup.append(r)
            refs = dedup
        fetched_local[hid] = (refs, err)

    fetched_catalog = {}
    for pid, prov, dc in to_query_catalog:
        fetched_catalog[pid] = catalog_for_provider(prov, bool(fl["dry-run"]), DISCOVER_TIMEOUT)

    def do_mutate(cfg):
        # EIN Schreibvorgang fuer den ganzen Lauf (Vertrag 1), aber ein
        # Aenderungslog-Eintrag pro betroffenem Modell.
        entries_log = []
        models_list = cfg.setdefault("models", [])
        for hid, h, dc in to_query_local:
            refs, err = fetched_local[hid]
            if err:
                # Vertrag 4.3 / 1: eine gescheiterte Quelle entfernt NICHTS — bestehende
                # automatische Eintraege dieses Harness bleiben unberuehrt.
                kept = sum(1 for m in models_list
                          if isinstance(m, dict) and m.get("harness") == hid
                          and m.get("source") == "auto")
                output[hid] = {"added": [], "removed": [], "updated": [], "kept": kept, "error": err}
                continue
            style = ((h.get("effort") or {}).get("style")) or "none"
            emap = ((h.get("effort") or {}).get("map")) or {}
            plan = plan_for(hid, dc, refs, models_list, now_iso, emap, style)
            for w in plan["warnings"]:
                sys.stderr.write("wb-state: WARNUNG — %s\n" % w)
            guard = empty_answer_guard(hid, refs, plan, fl["allow-empty"])
            if guard:
                # Wie der err-Zweig darueber: nichts anwenden, nichts entfernen, und
                # AUCH KEIN Zeitstempel — ein Ausfall darf die Quelle nicht fuer die
                # naechsten Stunden als "frisch erkannt" abhaken (--if-stale).
                output[hid] = {"added": [], "removed": [], "updated": [],
                               "kept": len(plan["removed"]), "error": guard,
                               "skippedEmpty": True}
                continue
            output[hid] = {"added": plan["added"], "removed": plan["removed"],
                           "updated": plan["updated"], "kept": plan["kept"], "error": None}
            apply_plan(cfg, models_list, plan, entries_log)
            ttl_state[hid] = {"at": now_iso, "count": len(refs)}
        for pid, prov, dc in to_query_catalog:
            result = fetched_catalog[pid]
            if result["error"]:
                kept = sum(1 for m in models_list
                          if isinstance(m, dict) and m.get("provider") == pid
                          and m.get("source") == "auto")
                output[pid] = {"added": [], "removed": [], "updated": [], "kept": kept,
                               "error": result["error"]}
                continue
            # Nachtrag 2026-07-29: die Zahlen gehoeren an den Provider selbst, unabhaengig
            # davon, ob die Registrierung unten ueberhaupt gelingt (falscher/fehlender
            # defaultRunner darf einen erfolgreichen Katalogabruf nicht verschweigen).
            meta = result["meta"] or {}
            old_prov = byid(cfg.get("providers") or [], pid) or byid(PROVIDERS, pid) or {}
            if meta.get("fetchedAt") is not None:
                new_status = {"count": meta.get("catalogSize"), "fetchedAt": meta["fetchedAt"]}
                if old_prov.get("catalogStatus") != new_status:
                    entries_log.append(("provider:%s.catalogStatus" % pid,
                                        old_prov.get("catalogStatus"), new_status))
                upsert_provider_field(cfg, pid, "catalogStatus", new_status)
            if meta.get("balanceAt") is not None:
                new_bal = {"amount": meta.get("balance"), "currency": "USD",
                          "fetchedAt": meta["balanceAt"]}
                if old_prov.get("balanceStatus") != new_bal:
                    entries_log.append(("provider:%s.balanceStatus" % pid,
                                        old_prov.get("balanceStatus"), new_bal))
                upsert_provider_field(cfg, pid, "balanceStatus", new_bal)
            runner = prov.get("defaultRunner")
            rh = byid(HARNESSES, runner) if runner else None
            if not runner or not rh:
                output[pid] = {"added": [], "removed": [], "updated": [], "kept": 0,
                               "error": "kein gueltiger defaultRunner fuer Anbieter '%s'." % pid}
                continue
            style = ((rh.get("effort") or {}).get("style")) or "none"
            emap = ((rh.get("effort") or {}).get("map")) or {}
            roles = dc.get("roles") or ["worker", "orchestrator"]
            plan = plan_for_catalog(runner, pid, result["refs"], models_list, now_iso,
                                    emap, style, roles)
            for w in plan["warnings"]:
                sys.stderr.write("wb-state: WARNUNG — %s\n" % w)
            # Derselbe Ausfall trifft den Katalogpfad ohne jede Formataenderung:
            # catalog_for_provider gibt bei fehlendem Key refs=[] MIT error=None
            # zurueck (mode "no-key"). Ein Key, der aus dem Schluesselbund faellt,
            # haette bis heute alle automatischen Eintraege dieses Anbieters
            # entfernt. Das meta-Feld unten nennt weiterhin den echten Grund.
            guard = empty_answer_guard(pid, result["refs"], plan, fl["allow-empty"])
            if guard:
                output[pid] = {"added": [], "removed": [], "updated": [],
                               "kept": len(plan["removed"]), "error": guard,
                               "skippedEmpty": True, "catalog": result["meta"]}
                continue
            output[pid] = {"added": plan["added"], "removed": plan["removed"],
                           "updated": plan["updated"], "kept": plan["kept"], "error": None,
                           "catalog": result["meta"]}
            apply_plan(cfg, models_list, plan, entries_log)
            ttl_state[pid] = {"at": now_iso, "count": len(result["refs"])}
        return entries_log

    if not to_query_local and not to_query_catalog:
        pass                                       # alles frisch (--if-stale) oder nichts angefordert
    elif fl["dry-run"]:
        # Vertrag 1: rechnen, ausgeben, NICHTS schreiben — auch keinen Zeitstempel und
        # keinen Katalog-/Guthaben-Cache (catalog_for_provider bekam dry_run oben schon).
        for hid, h, dc in to_query_local:
            refs, err = fetched_local[hid]
            if err:
                kept = sum(1 for m in MODELS if m.get("harness") == hid and m.get("source") == "auto")
                output[hid] = {"added": [], "removed": [], "updated": [], "kept": kept, "error": err}
                continue
            style = ((h.get("effort") or {}).get("style")) or "none"
            emap = ((h.get("effort") or {}).get("map")) or {}
            plan = plan_for(hid, dc, refs, MODELS, now_iso, emap, style)
            for w in plan["warnings"]:
                sys.stderr.write("wb-state: WARNUNG — %s\n" % w)
            # Die Leer-Sperre gilt im Probelauf genauso: --dry-run soll zeigen, was
            # ein echter Lauf taete, und der taete hier nichts.
            guard = empty_answer_guard(hid, refs, plan, fl["allow-empty"])
            if guard:
                output[hid] = {"added": [], "removed": [], "updated": [],
                               "kept": len(plan["removed"]), "error": guard,
                               "skippedEmpty": True}
                continue
            output[hid] = {"added": plan["added"], "removed": plan["removed"],
                           "updated": plan["updated"], "kept": plan["kept"], "error": None}
        for pid, prov, dc in to_query_catalog:
            result = fetched_catalog[pid]
            if result["error"]:
                kept = sum(1 for m in MODELS if m.get("provider") == pid and m.get("source") == "auto")
                output[pid] = {"added": [], "removed": [], "updated": [], "kept": kept,
                               "error": result["error"]}
                continue
            runner = prov.get("defaultRunner")
            rh = byid(HARNESSES, runner) if runner else None
            if not runner or not rh:
                output[pid] = {"added": [], "removed": [], "updated": [], "kept": 0,
                               "error": "kein gueltiger defaultRunner fuer Anbieter '%s'." % pid}
                continue
            style = ((rh.get("effort") or {}).get("style")) or "none"
            emap = ((rh.get("effort") or {}).get("map")) or {}
            roles = dc.get("roles") or ["worker", "orchestrator"]
            plan = plan_for_catalog(runner, pid, result["refs"], MODELS, now_iso,
                                    emap, style, roles)
            for w in plan["warnings"]:
                sys.stderr.write("wb-state: WARNUNG — %s\n" % w)
            guard = empty_answer_guard(pid, result["refs"], plan, fl["allow-empty"])
            if guard:
                output[pid] = {"added": [], "removed": [], "updated": [],
                               "kept": len(plan["removed"]), "error": guard,
                               "skippedEmpty": True, "catalog": result["meta"]}
                continue
            output[pid] = {"added": plan["added"], "removed": plan["removed"],
                           "updated": plan["updated"], "kept": plan["kept"], "error": None,
                           "catalog": result["meta"]}
    else:
        write_registry(do_mutate)
        try:
            os.makedirs(os.path.dirname(STATEFILE), exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(STATEFILE))
            with os.fdopen(fd, "w") as f:
                json.dump(ttl_state, f, indent=2)
            os.replace(tmp, STATEFILE)
        except Exception as e:
            sys.stderr.write("wb-state: WARNUNG — Discover-Zeitstempel nicht schreibbar (%s)\n" % e)

    if fl["json"]:
        print(json.dumps(output, ensure_ascii=False))
    else:
        for tid in requested:
            r = output.get(tid)
            if r is None:
                print("%s: uebersprungen (--if-stale, noch frisch)" % tid)
            elif r["error"]:
                print("%s: FEHLER — %s" % (tid, r["error"]))
            else:
                print("%s: +%d neu, %d aktualisiert, -%d entfernt, %d unveraendert"
                     % (tid, len(r["added"]), len(r["updated"]), len(r["removed"]), r["kept"]))

    # Vertrag 1: Exit 1 nur, wenn ALLE angeforderten Ziele gescheitert sind.
    attempted = [tid for tid in requested if tid in output]
    failed = [tid for tid in attempted if output[tid].get("error")]
    if attempted and len(failed) == len(attempted):
        sys.exit(1)

def cmd_catalog():
    # Vertrag Teil 2 Abschnitt 6: "ein Weg, die Zahlen fuer die Oberflaeche zu lesen,
    # ohne dass sie selbst rechnet" — rein lesend, kein Netzzugriff. Katalogumfang und
    # Abrufzeitpunkt kommen (Nachtrag 2026-07-29) direkt vom PROVIDER-Objekt
    # (catalogStatus/balanceStatus), derselben Quelle, die die Oberflaeche selbst
    # liest — 'wie viele kostenlos' steht dort NICHT (nur 'count'), dafuer bleibt der
    # rohe Katalog-Cache die einzige Quelle.
    _vals, fl, _pos = opts(ARGV, [], ["json"])
    rows = []
    for prov in PROVIDERS:
        dc = prov.get("discover")
        if not isinstance(dc, dict) or dc.get("source") != "http-json":
            continue
        pid = prov["id"]
        cat_status = prov.get("catalogStatus") or {}
        bal_status = prov.get("balanceStatus") or {}
        catalog_size = cat_status.get("count")
        fetched_at = cat_status.get("fetchedAt")
        balance_val = bal_status.get("amount")
        balance_at = bal_status.get("fetchedAt")
        free_count = None
        cpath = catalog_cache_path(pid)
        if os.path.exists(cpath):
            try:
                data = json.load(open(cpath))
                items, err = catalog_items(data, dc.get("jsonPath"), dc.get("priceFields"))
                if not err:
                    if catalog_size is None:
                        catalog_size = len(items)   # Registry noch ohne catalogStatus -> Cache reicht
                    free_count = sum(1 for it in items if is_free_item(it))
            except Exception:
                pass
        has_key = False
        if key_required(prov):
            has_key, _src = secret_present(prov)
        registered = sum(1 for m in MODELS if m.get("provider") == pid and m.get("source") == "auto")
        rows.append({"provider": pid, "catalogSize": catalog_size, "freeCount": free_count,
                    "hasKey": has_key, "fetchedAt": fetched_at, "balance": balance_val,
                    "balanceAt": balance_at, "registered": registered})
    if fl["json"]:
        print(json.dumps(dict((r["provider"], r) for r in rows), ensure_ascii=False))
    else:
        for r in rows:
            print("%s: Katalog %s (%s kostenlos), Key: %s, Guthaben %s (%s), registriert: %d"
                 % (r["provider"],
                    r["catalogSize"] if r["catalogSize"] is not None else "?",
                    r["freeCount"] if r["freeCount"] is not None else "?",
                    "ja" if r["hasKey"] else "nein",
                    r["balance"] if r["balance"] is not None else "unbekannt",
                    r["fetchedAt"] or "nie abgerufen", r["registered"]))

def cmd_effort():
    """`wb-state models effort <id> [--effort e] [--mensch]`

    Druckt die Stufe, mit der wirklich gestartet wird, oder bricht mit der
    Ablehnung ab. Es gibt sie, damit der SCHNELLE Pfad in pi-worker (die
    eingebauten claude-Aliase, die die Registry sonst nicht befragen) dieselbe
    Entscheidung bekommt wie `resolve` -- vorher stand die Pruefung dort ein
    zweites Mal in bash und war schon einmal auseinandergelaufen.

    `--mensch` wird gemessen (mensch_belegt), nicht geglaubt: dieses Kommando ist
    aus jedem Pane aufrufbar, und ohne die Messung waere es der kuerzeste Weg an
    den Deckel vorbei. Aus einem Pane heraus kommt die GEDECKELTE Stufe zurueck,
    mit einer Zeile nach stderr, warum."""
    vals, fl, pos = opts(ARGV, ["effort", "harness", "rolle"], ["mensch", "liste"])
    if not pos:
        die("FEHLER: wb-state models effort <id> [--harness h] [--effort e] "
            "[--rolle worker|orchestrator] [--mensch] [--liste]")
    # `--rolle` aendert NICHTS an der Entscheidung -- es steht nur in der
    # Protokollzeile, damit spaeter zu sehen ist, ob ein Mensch sich seine eigene
    # Sitzung hochgestellt hat oder einen Worker ueber den Deckel geschickt hat.
    rolle = vals["rolle"] or "worker"
    if rolle not in ("worker", "orchestrator"):
        die("FEHLER: unbekannte Rolle '%s' (worker|orchestrator)." % rolle)
    m = byid(MODELS, pos[0])
    if m is None and vals["harness"]:
        # OHNE models.json gibt es die eingebauten ADAPTER, aber keine
        # eingebauten MODELLE -- der schnelle Pfad von pi-worker (claude-sonnet5
        # & Co.) kennt sein Harness trotzdem und muss weiter starten koennen.
        # Genau das ist beim Umbau am 2026-08-06 einmal gebrochen: ohne Registry
        # scheiterte jeder claude-Worker an einem 'Modell unbekannt'.
        # Der Deckel faellt dabei NICHT weg: ohne Registry gilt die hoechste
        # Stufe UNTER `max` -- dieselbe Regel, nach der derive_efforts den
        # ausgelieferten Deckel bildet. `max` bleibt damit auch hier dem
        # Menschen vorbehalten.
        h = byid(HARNESSES, vals["harness"])
        if not h:
            die("FEHLER: Harness '%s' ist nicht registriert." % vals["harness"])
        liste = harness_efforts(h)
        ohne_max = [e for e in liste if e != "max"]
        # `_deckel_vom_harness` sagt der Meldung, WOHER der Deckel kommt. Ohne
        # das Merkmal nennt sie die "Modell-Registry" -- und genau dort steht
        # dieses Modell ja nicht, sonst haetten wir es nicht bauen muessen.
        m = {"id": pos[0], "harness": vals["harness"],
             "maxEffort": ohne_max[-1] if ohne_max else None,
             "_deckel_vom_harness": True}
    if m is None:
        m = need_model(pos[0])
    if fl["liste"]:
        # Was dieses Modell ueberhaupt anbietet -- die Oberflaeche baut daraus
        # ihre Auswahl, statt vier Stufen fest einzutragen.
        print(" ".join(model_efforts(m)))
        return
    print(policy_effort(m, vals["effort"], mensch=mensch_belegt(fl["mensch"]), rolle=rolle))

def cmd_cap_get():
    """`wb-state models cap <id>` -> <stufe> TAB <quelle> TAB <grund>"""
    vals, fl, pos = opts(ARGV, [], ["json"])
    if not pos:
        die("FEHLER: wb-state models cap <id> [--json]")
    m = need_model(pos[0])
    cap, quelle, grund = effective_cap(m)
    if fl["json"]:
        print(json.dumps({"model": m["id"], "cap": cap, "quelle": quelle,
                          "grund": grund, "registry": m.get("maxEffort"),
                          "efforts": model_efforts(m)}, ensure_ascii=False))
    else:
        print("%s\t%s\t%s" % (cap or "-", quelle, grund))

def cmd_cap_list():
    """Alle Modelle mit einer SETZUNG. Die Auslieferung steht in der Registry und
    wird hier nicht wiederholt -- diese Liste beantwortet 'was hat ein Mensch
    entschieden', nicht 'was kann das Modell'."""
    vals, fl, pos = opts(ARGV, [], ["json"])
    caps = read_setting("effortCaps", {})
    if fl["json"]:
        print(json.dumps(caps, ensure_ascii=False))
        return
    for mid in sorted(caps):
        e = caps[mid]
        if not isinstance(e, dict):
            continue
        print("%s\t%s\t%s\t%s" % (mid, e.get("cap") or "-", e.get("gesetzt") or "-",
                                  e.get("grund") or ""))

DISPATCH = {"list": cmd_list, "get": cmd_get, "resolve": cmd_resolve, "table": cmd_table,
            "check": cmd_check, "add": cmd_add, "set": cmd_set, "remove": cmd_remove,
            "harness-get": cmd_harness_get, "discover": cmd_discover, "catalog": cmd_catalog,
            "effort": cmd_effort, "cap": cmd_cap_get, "caps": cmd_cap_list,
            "migrate-session": cmd_migrate_session}
if SUB not in DISPATCH:
    die("FEHLER: unbekanntes Registry-Kommando '%s'." % SUB,
        "Gueltig: " + " ".join(sorted(DISPATCH)))
DISPATCH[SUB]()
PY
    ;;

  *)
    echo "wb-state: unbekanntes Kommando '$CMD' (touch|add-worker|session|list|new-key|path|worker-model|worker-machine|settings|models|harness)" >&2
    exit 1
    ;;
esac
