#!/bin/bash
# wb-state — read/write the Claude Workbench state files.
#
#   wb-state touch <dir> [tmux-session]        create/update the session state
#            [--name <name>] [--key <sessionKey>]
#            [--harness claude|pi] [--model <model>]
#            [--claude-session <id>]           remember the Claude conversation
#   wb-state add-worker <name> <kind> <model> <dir> [tmux-session] [--machine <m>]
#            [--claude-session <id>]           remember the worker's Claude conversation
#   wb-state remove-worker <name> <dir> [tmux-session]
#                                               forget a worker (wb-close calls this
#                                               after the pane is really gone, 2026-08-16)
#   wb-state worker-machine <name>             print the worker's machine (empty = local)
#   wb-state worker-claude-session <name>      print the worker's claudeSessionId (empty = unknown)
#   wb-state worker-transcript <name>          print the worker's transcript file path (empty = unknown)
#   wb-state session <dir> [--key <sessionKey>]   print tmuxSession (empty if none)
#   wb-state claude-session <dir> [--key <k>]  print claudeSessionId (empty if none)
#   wb-state list <dir>                        one line per session of that dir:
#                                              <sessionKey>|<name>|<tmuxSession>
#   wb-state by-tmux <tmux-session>            the session owning that tmux session:
#                                              <dir>|<sessionKey> (empty = none)
#   wb-state new-key <dir>                     print a fresh, unused sessionKey
#   wb-state path <dir> [--key <sessionKey>]   print the state file path
#   wb-state settings get <key>                print the setting (empty = unset)
#   wb-state settings set <key> <value> [--grund '<warum>']
#                                               write it (read-modify-write); --grund ist
#                                               nur fuer orchestratorPermissionMode Pflicht
#                                               (siehe unten), jeder andere Schluessel
#                                               ignoriert es
#   wb-state settings valid                    Exit 0: Datei fehlt oder ist gueltiges JSON;
#                                               Exit 1: Datei ist da, aber kaputt. Nur fuer
#                                               Aufrufer, die den Unterschied zur leisen
#                                               Vorgaben-Rueckfalllogik von `get` brauchen
#                                               (2026-08-16, shell/wb-code)
#
# Was ein MENSCH lockert (2026-08-06) — vier Sicherungen, eine Auflage. Jede
# LOCKERUNG verlangt einen echten Menschen (gemessen von `wb-mensch`, nie
# behauptet) und einen Grund; jede Wiederherstellung darf jeder, jederzeit:
#   wb-state effort-cap get <modell> | list
#   wb-state effort-cap set <modell> <stufe> --grund '<warum>' | clear <modell>
#   wb-state guard list | get <guard>
#   wb-state guard set <guard> an|aus [--grund '<warum>'] [--rolle alle|worker|orchestrator]
#   wb-state wache get [<rolle>] [--json]
#   wb-state wache set <orchestrator|worker> [--an true|false] [--mahnen-ab <n>]
#            [--eingreifen true|false] [--notbremse-ab <n>] [--grund '<warum>']
#   wb-state settings set orchestratorPermissionMode bypassPermissions --grund '<warum>'
#            (2026-08-16) -- die vierte Sicherung, aber ohne eigenes Sub-Kommando: der
#            Wert ist ein einzelnes ENUM-Feld (wie orchestratorEffort), keines der drei
#            Objekte oben. SENKEN (jeder andere der sechs Werte) geht immer und ohne
#            Grund; nur das ANHEBEN auf bypassPermissions -- die staerkste Stufe, mit der
#            der Orchestrator startet -- braucht wb-mensch UND --grund. Sonst waere dieser
#            Schluessel selbst der Weg, auf dem sich ein Agent die Berechtigungsabfrage
#            seines eigenen Orchestrators abschaltet.
#
# V3 (SPEC-V3-MODELS section B) — the model/harness/provider REGISTRY:
#   wb-state models list [--role worker|orchestrator] [--machine mac|peer]
#            [--harness <id>] [--all]           registered model ids
#   wb-state models get <id> [--field <f>]      one entry as JSON (or one field)
#   wb-state models resolve <id> --role <r> [--effort <e>] [--dir <d>] [--name <n>]
#            [--mensch]                         the finished start line + env placeholders
#   wb-state models effort <id> [--effort <e>] [--mensch] | --liste
#                                               the effort a spawn would really use
#                                               (or the levels this model offers)
#   wb-state models cap <id> [--json]           effective cap: level, source, reason
#   wb-state models caps                        every cap a HUMAN has set
#   wb-state models table                       markdown routing table
#   wb-state models check <id>                  binary there? key there? pattern measured?
#   wb-state models add|set|remove [--kind model|harness|provider] …
#   wb-state models migrate-session --from <models.default.json> [--dry-run]
#                                               traegt die ausgelieferten session-Bloecke
#                                               in die gepflegte Registry ein und entfernt
#                                               contextSession im selben Zug (2026-08-11,
#                                               SPEC-V4 6.3 Punkt 2)
#   wb-state models discover [--all | <harnessId|providerId> ...]
#            [--if-stale] [--dry-run] [--json] [--force] [--no-network] [--allow-empty]
#                                               auto-detect installed models per harness'
#                                               'discover' block (ollama/CLI/file source)
#                                               AND per provider's 'discover' block
#                                               (http-json catalog, e.g. OpenRouter),
#                                               write 'source: auto' entries. --force
#                                               overrides settings.modelDiscoveryAuto=false
#                                               for this one call (the "Kataloge jetzt
#                                               aktualisieren" button); --no-network
#                                               suppresses the catalog/network path for
#                                               this one call regardless of the setting
#                                               or --force (contracts: scratchpad/
#                                               CONTRACT-discover.md, CONTRACT-katalog.md,
#                                               2026-07-29). --allow-empty (2026-08-08)
#                                               laesst eine Quelle, die NICHTS mehr
#                                               nennt, ihre automatischen Eintraege
#                                               wirklich entfernen; ohne den Schalter
#                                               gilt die leere Antwort als Ausfall und
#                                               es wird nichts geloescht
#   wb-state models catalog [--json]            per provider with a catalog: size, free
#                                               count, balance + fetch time, key present?,
#                                               how many registered — read-only, no network
#   wb-state harness get <id>                   one harness adapter as JSON
#
# Registry file: ~/.claude/workbench/models.json, change log
# ~/.local/state/wb-models-changes.log — same rules as the settings file above
# (missing/broken file falls back to the BUILT-IN adapters `claude` and `pi`, never
# an error; writes are atomic under both locks; unknown keys survive). Mit
# WB_MODELS_FILE wandert auch das Protokoll mit: es liegt dann als
# <registry>.changes.log neben der umgebogenen Datei (2026-08-11).
# WB_MODELS_FILE=<pfad> (2026-08-09) biegt die Registry-Datei fuer EINEN Lauf um — fuer
# einen Harness-Ersteinbau, bei dem noch nichts in der echten Registry steht (siehe
# wb-harness-probe --models-file). Unbesetzt: kein Unterschied zu vorher. Gesetzt, aber
# nicht lesbar: FEHLER, kein stiller Rueckfall auf die echte Datei.
# `resolve` is the ONLY place that builds a start command, and it never prints a
# secret: an API key appears as the placeholder chain @keychain:<service> →
# @file:<path> → @env:<VAR>, which wb-harness-run resolves inside the pane.
#
# State lives in ~/.claude/workbench/sessions/<slug>.json, slug = project path
# with '/' replaced by '-' (same convention as ~/.claude/projects/). Writes are
# atomic (tmp + mv) and serialised with an exclusive lock in
# ~/.claude/workbench/locks/, so parallel worker spawns cannot lose entries.
# Contract with the VSCode extension: see SPEC.md.
#
# V2 (SPEC-V2 section B): a folder can hold SEVERAL sessions. The first one keeps
# the plain <slug>.json file (default session, unchanged — old files stay valid and
# are never renamed); every further session lives in <slug>__<sessionKey>.json with
# a 6-hex sessionKey. `name` and `sessionKey` are optional fields; a missing name
# means the UI falls back to basename(dir).
# Settings (SPEC-V2 section A) live in ~/.claude/workbench/settings.json under the
# same lock directory; they are the single source of truth for defaults. Missing
# file, missing key or broken JSON always fall back to the built-in defaults —
# never an error. `settings set` and the extension share ONE lock kind for this
# file: a mkdir lock (settings.json.lock.d, stale takeover after 10s), the only
# scheme both a shell script and the extension's Node process can take without a
# fragile dependency (2026-08-04, see the lock's own comment below for why).
set -euo pipefail

STATEDIR="$HOME/.claude/workbench/sessions"
LOCKDIR="$HOME/.claude/workbench/locks"
SETTINGS="$HOME/.claude/workbench/settings.json"
# WB_MODELS_FILE (2026-08-09): biegt die Registry-Datei fuer EINEN Lauf um — gebaut
# fuer den Ersteinbau eines Harness, der noch nirgends eingetragen ist (wb-harness-probe
# --models-file). Unbesetzt aendert sich nichts: derselbe Vorgabepfad wie immer, und ein
# fehlender/kaputter Vorgabepfad faellt wie bisher lautlos auf die eingebauten Adapter
# zurueck (load_raw() unten). Explizit GESETZT ist die Variable dagegen eine Behauptung,
# gegen welche Datei gemessen werden soll — zeigt sie auf nichts Lesbares, ist das ein
# Fehler mit klarer Meldung, kein stiller Rueckfall auf die echte Registry: sonst haette
# ein Tippfehler im Pfad genau dieselbe Meldung ("Harness 'x' ist nicht registriert") wie
# eine bewusst isolierte Probe gegen einen Entwurf, und niemand koennte die beiden Faelle
# auseinanderhalten.
MODELSFILE="${WB_MODELS_FILE:-$HOME/.claude/workbench/models.json}"
if [ -n "${WB_MODELS_FILE:-}" ] && [ ! -r "$MODELSFILE" ]; then
  echo "FEHLER: WB_MODELS_FILE='$MODELSFILE' ist nicht lesbar — kein Lauf gegen diese Registry." >&2
  echo "  Kein stiller Rueckfall auf die echte Registry ($HOME/.claude/workbench/models.json)." >&2
  exit 1
fi
mkdir -p "$STATEDIR" "$LOCKDIR"

slug() { printf '%s' "$1" | tr '/' '-'; }

# state file of ONE session: the default session keeps the plain slug file, every
# further session is suffixed with '__<sessionKey>'.
own_file() {
  local key="${2:-}"
  if [ -n "$key" ]; then
    printf '%s/%s__%s.json' "$STATEDIR" "$(slug "$1")" "$key"
  else
    printf '%s/%s.json' "$STATEDIR" "$(slug "$1")"
  fi
}

# state file for a WORKER: its dir may differ from the project dir of the
# workbench it runs in, so an existing state file claiming that tmux session
# wins. Never used for `touch` (that must only ever write its own slug file).
worker_file() {
  local dir="$1" sess="${2:-}" f owner
  if [ -n "$sess" ]; then
    for f in "$STATEDIR"/*.json; do
      [ -e "$f" ] || continue
      if /usr/bin/python3 -c 'import json,sys
try: sys.exit(0 if json.load(open(sys.argv[1])).get("tmuxSession")==sys.argv[2] else 1)
except Exception: sys.exit(1)' "$f" "$sess"; then
        printf '%s' "$f"; return 0
      fi
    done
    # No file claims $sess yet. own_file(dir) is trusted here only when it does
    # NOT already belong to a DIFFERENT, named session -- otherwise a stale file
    # left behind by an unrelated dead session that happens to share this dir's
    # slug would silently steal the worker (measured 2026-08-06: worker 'symbol'
    # landed in a dead session's '-Users-<user>-AI-claude-workbench.json' this way
    # on its first spawn, because that file already existed under the same
    # dir-derived name). No owner yet, or the owner already IS $sess -> safe to
    # (re)use. Any other owner -> refuse; print nothing so the caller's existence
    # check reports it instead of guessing.
    f="$(own_file "$dir")"
    if [ -e "$f" ]; then
      owner=$(/usr/bin/python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("tmuxSession") or "")
except Exception: pass' "$f" 2>/dev/null || true)
      if [ -z "$owner" ] || [ "$owner" = "$sess" ]; then
        printf '%s' "$f"
      else
        echo "wb-state: '$f' gehoert Session '$owner', nicht '$sess' -- kein automatischer Rueckfall auf own_file." >&2
      fi
    fi
    return 0
  fi
  own_file "$dir"
}

# --name/--key/--harness/--model/--machine/--claude-session may appear anywhere;
# everything else stays positional so that all V1 call forms keep working unchanged.
OPT_NAME=""; OPT_KEY=""; OPT_HARNESS=""; OPT_MODEL=""; OPT_MACHINE=""; OPT_CSESS=""; POS=()
parse_opts() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)    OPT_NAME="${2:?name}"; shift 2 ;;
      --key)     OPT_KEY="${2:?sessionKey}"; shift 2 ;;
      --harness) OPT_HARNESS="${2:?harness}"; shift 2 ;;
      --model)   OPT_MODEL="${2:?model}"; shift 2 ;;
      --machine) OPT_MACHINE="${2:?machine}"; shift 2 ;;
      --claude-session) OPT_CSESS="${2:?claude session id}"; shift 2 ;;
      *)         POS[${#POS[@]}]="$1"; shift ;;
    esac
  done
}
pos() { # pos <index, 1-based> — empty if absent
  local i="$1"
  [ "${#POS[@]}" -ge "$i" ] && printf '%s' "${POS[$((i-1))]}" || true
}

CMD="${1:?usage: wb-state touch|add-worker|session|list|by-tmux|new-key|path|worker-model|worker-machine|settings|models|harness ...}"; shift

case "$CMD" in
  path)
    parse_opts "$@"
    own_file "$(pos 1)" "$OPT_KEY"; echo
    ;;

  session)
    parse_opts "$@"
    FILE="$(own_file "$(pos 1)" "$OPT_KEY")"
    [ -e "$FILE" ] || exit 0
    /usr/bin/python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("tmuxSession") or "")
except Exception: pass' "$FILE"
    ;;

  # Claude conversation id of THIS workbench session (crash recovery, 2026-07-25).
  # Recorded at start by wb-code, read by wb-code when the tmux session is gone:
  # a lost tmux server must not cost the conversation. Empty when unknown.
  claude-session)
    parse_opts "$@"
    FILE="$(own_file "$(pos 1)" "$OPT_KEY")"
    [ -e "$FILE" ] || exit 0
    /usr/bin/python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("claudeSessionId") or "")
except Exception: pass' "$FILE"
    ;;

  # Welche Sitzung gehoert zu DIESER tmux-Session? Antwort: '<dir>|<sessionKey>',
  # der sessionKey leer bei der Standardsitzung des Ordners; keine Ausgabe, wenn
  # keine Zustandsdatei sie fuer sich beansprucht.
  #
  # Gebaut fuer hooks/sessionstart-claude-session.sh (11.08.): Ein Haken sitzt in
  # einem Pane und kennt nur dessen tmux-Sessionnamen. Ueber den Ordner allein
  # findet er die Datei NICHT -- in einem Ordner koennen mehrere Sitzungen liegen
  # (SPEC-V2 B), und `-Users-<user>-AI.json` neben `-Users-<user>-AI__76be6c.json`
  # ist genau der Normalfall. Wer da raet, schreibt die Unterhaltung der einen in
  # die Zustandsdatei der anderen.
  #
  # Der tmux-Sessionname ist der eindeutige Schluessel dafuer: `wb-code` schreibt
  # ihn beim Anlegen in `tmuxSession`, und dieselbe Zuordnung benutzt `worker_file`
  # oben schon fuer die Worker. Gelesen wird nur.
  by-tmux)
    SESS="${1:?tmux session}"
    /usr/bin/python3 - "$STATEDIR" "$SESS" <<'PY'
import json, os, sys
statedir, sess = sys.argv[1:3]
for fn in sorted(os.listdir(statedir)):
    if not fn.endswith(".json"):
        continue
    try:
        st = json.load(open(os.path.join(statedir, fn)))
    except Exception:
        continue
    if st.get("tmuxSession") != sess or not st.get("dir"):
        continue
    print("%s|%s" % (st["dir"], st.get("sessionKey") or ""))
    break
PY
    ;;

  list)
    DIR="${1:?dir}"
    /usr/bin/python3 - "$STATEDIR" "$(slug "$DIR")" "$DIR" <<'PY'
import json, os, sys
statedir, slug, dir_ = sys.argv[1:4]
rows = []
for fn in sorted(os.listdir(statedir)):
    if not fn.endswith(".json"):
        continue
    base = fn[:-5]
    if base == slug:
        key_from_name = ""
    elif base.startswith(slug + "__"):
        key_from_name = base[len(slug) + 2:]
    else:
        continue
    try:
        st = json.load(open(os.path.join(statedir, fn)))
    except Exception:
        continue
    # a folder named 'foo__bar' can produce a slug that also matches the glob of
    # its sibling 'foo' — the file's own dir field settles it.
    if st.get("dir") and st["dir"] != dir_:
        continue
    rows.append((key_from_name,
                 st.get("sessionKey") or key_from_name,
                 st.get("name") or "",
                 st.get("tmuxSession") or ""))
# default session (no key) first, then deterministic by file suffix
for _, key, name, sess in sorted(rows, key=lambda r: r[0]):
    print("%s|%s|%s" % (key, name, sess))
PY
    ;;

  new-key)
    DIR="${1:?dir}"
    /usr/bin/python3 - "$STATEDIR" "$(slug "$DIR")" <<'PY'
import os, secrets, sys
statedir, slug = sys.argv[1:3]
while True:
    key = secrets.token_hex(3)
    if not os.path.exists(os.path.join(statedir, "%s__%s.json" % (slug, key))):
        print(key)
        break
PY
    ;;

  touch)
    parse_opts "$@"
    DIR="$(pos 1)"; SESS="$(pos 2)"
    [ -n "$DIR" ] || { echo "wb-state touch: dir fehlt" >&2; exit 1; }
    [ -n "$SESS" ] || { echo "wb-state touch: tmux session fehlt" >&2; exit 1; }
    FILE="$(own_file "$DIR" "$OPT_KEY")"
    /usr/bin/python3 - "$FILE" "$DIR" "$SESS" "$LOCKDIR" "$OPT_NAME" "$OPT_KEY" "$OPT_HARNESS" "$OPT_MODEL" "$OPT_CSESS" <<'PY'
import json, os, sys, tempfile, datetime, fcntl
file, dir_, sess, lockdir, name, key, harness, model, csess = sys.argv[1:10]
lock = open(os.path.join(lockdir, os.path.basename(file) + ".lock"), "w")
fcntl.flock(lock, fcntl.LOCK_EX)
try:
    try:
        st = json.load(open(file))
    except Exception:
        st = {}
    # slug() maps '/' to '-', so two different dirs (e.g. 'a/b' and 'a-b') can
    # land on the same state file (2026-08-16, bugjagd shell/mittel). Without
    # this check the second project's touch silently overwrites the first
    # project's session data (workers, claudeSessionId) with no trace.
    existing_dir = st.get("dir")
    if existing_dir and existing_dir != dir_:
        print("wb-state touch: '%s' gehoert bereits Projekt '%s', nicht '%s' "
              "-- slug-Kollision, kein Ueberschreiben." % (file, existing_dir, dir_),
              file=sys.stderr)
        sys.exit(1)
    st["dir"] = dir_
    st["tmuxSession"] = sess
    # name/sessionKey are only written when given: an empty --name must not wipe
    # the name a previous start already stored.
    if name:
        st["name"] = name
    if key:
        st["sessionKey"] = key
    # harness/model are informative (start page): which harness runs this session
    # and with which model (SPEC-V2 section F).
    if harness:
        st["harness"] = harness
    if model:
        st["model"] = model
    # Crash recovery (2026-07-25): the Claude conversation running in this
    # session. Only ever written when given — a plain touch must not wipe it,
    # because it is the only thing that survives a lost tmux server.
    if csess:
        st["claudeSessionId"] = csess
    st["lastActive"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    st.setdefault("workers", [])
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(file))
    with os.fdopen(fd, "w") as f:
        json.dump(st, f, indent=2)
    os.replace(tmp, file)
finally:
    fcntl.flock(lock, fcntl.LOCK_UN)
PY
    ;;

  add-worker)
    parse_opts "$@"
    NAME="$(pos 1)"; KIND="$(pos 2)"; MODEL="$(pos 3)"; DIR="$(pos 4)"; SESS="$(pos 5)"
    [ -n "$NAME" ] || { echo "wb-state add-worker: name fehlt" >&2; exit 1; }
    [ -n "$KIND" ] || { echo "wb-state add-worker: kind fehlt" >&2; exit 1; }
    [ -n "$MODEL" ] || { echo "wb-state add-worker: model fehlt" >&2; exit 1; }
    [ -n "$DIR" ] || { echo "wb-state add-worker: dir fehlt" >&2; exit 1; }
    FILE="$(worker_file "$DIR" "$SESS")"
    if [ ! -e "$FILE" ]; then
      # Not silent any more (2026-08-06): this used to exit 0 without a trace,
      # and the caller's warning is wired to a NON-ZERO exit code, so nothing
      # ever told the user a worker was missing from the sidebar. This is a
      # legitimate outcome (a dir/session with no workbench state at all), so
      # the early exit stays -- only the visibility was missing, not the check.
      echo "WARNUNG: wb-state add-worker: kein Zustandsdokument fuer Worker '$NAME' (dir='$DIR', session='${SESS:-unbekannt}') gefunden — Worker fehlt in der Workbench-Sidebar." >&2
      exit 0
    fi
    /usr/bin/python3 - "$FILE" "$NAME" "$KIND" "$MODEL" "$DIR" "$LOCKDIR" "$OPT_MACHINE" "$OPT_CSESS" <<'PY'
import json, os, sys, tempfile, datetime, fcntl
file, name, kind, model, dir_, lockdir, machine, csess = sys.argv[1:9]
lock = open(os.path.join(lockdir, os.path.basename(file) + ".lock"), "w")
fcntl.flock(lock, fcntl.LOCK_EX)
try:
    try:
        st = json.load(open(file))
    except Exception:
        st = {}
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    old = next((w for w in st.get("workers", []) if w.get("name") == name), None)
    workers = [w for w in st.get("workers", []) if w.get("name") != name]
    entry = {"name": name, "kind": kind, "model": model, "dir": dir_, "spawnedAt": now}
    # PRESERVE, do not just set-if-given (Reviewer-Befund 3+4, round 5): every
    # add-worker call replaces the whole entry, so a caller that omits --machine or
    # --claude-session must not silently erase a value an EARLIER call already
    # recorded. Both fall back to the entry being replaced when the flag is empty this
    # time -- 'machine' marks a worker on the OTHER machine (ssh), absent for local
    # workers; 'claudeSessionId' mirrors the orchestrator's own field, filled in later
    # by pi-worker's background watcher once the transcript exists. This is the ONLY
    # place preservation happens now: pi-worker no longer reads either back itself.
    machine_val = machine or (old.get("machine") if old else None)
    csess_val = csess or (old.get("claudeSessionId") if old else None)
    if machine_val:
        entry["machine"] = machine_val
    if csess_val:
        entry["claudeSessionId"] = csess_val
    workers.append(entry)
    st["workers"] = workers
    st["lastActive"] = now
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(file))
    with os.fdopen(fd, "w") as f:
        json.dump(st, f, indent=2)
    os.replace(tmp, file)
finally:
    fcntl.flock(lock, fcntl.LOCK_UN)
PY
    ;;

  # Gegenstueck zu add-worker (2026-08-16, bugjagd shell/mittel, wb-close:227 +
  # pi-worker:531-561): nichts entfernte je einen Eintrag, die Liste wuchs nur
  # ueber die Lebensdauer einer Session (reproduziert: wb-close meldet
  # "geschlossen", der Worker steht danach unveraendert weiter in workers[]).
  # Aufgerufen von wb-close, NACHDEM der Pane wirklich weg ist. Fehlt die
  # Zustandsdatei oder der Name darin, ist das kein Fehler -- idempotent, wie
  # add-worker es auch schon fuer den umgekehrten Fall ist.
  remove-worker)
    parse_opts "$@"
    NAME="$(pos 1)"; DIR="$(pos 2)"; SESS="$(pos 3)"
    [ -n "$NAME" ] || { echo "wb-state remove-worker: name fehlt" >&2; exit 1; }
    FILE="$(worker_file "$DIR" "$SESS")"
    [ -e "$FILE" ] || exit 0
    /usr/bin/python3 - "$FILE" "$NAME" "$LOCKDIR" <<'PY'
import json, os, sys, tempfile, datetime, fcntl
file, name, lockdir = sys.argv[1:4]
lock = open(os.path.join(lockdir, os.path.basename(file) + ".lock"), "w")
fcntl.flock(lock, fcntl.LOCK_EX)
try:
    try:
        st = json.load(open(file))
    except Exception:
        st = {}
    before = st.get("workers", [])
    workers = [w for w in before if w.get("name") != name]
    if len(workers) == len(before):
        sys.exit(0)
    st["workers"] = workers
    st["lastActive"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(file))
    with os.fdopen(fd, "w") as f:
        json.dump(st, f, indent=2)
    os.replace(tmp, file)
finally:
    fcntl.flock(lock, fcntl.LOCK_UN)
