            "zaehlen hier nicht mit." % (verbraucht, grenze, zz.get("grenze_quelle") or "?"))


def _netz_erlaubt():
    """Die drei Netz-Ausnahmen (Rang, Preise, Guthaben) schaltet
    WB_KONTINGENT_KEIN_NETZ zuverlaessig ab -- ein Schirm auf 'security'
    allein reicht dafuer NICHT, weil /api/v1/models oeffentlich ist und auch
    ohne Schluessel erreichbar bliebe (gemessen 2026-08-27: kein
    Authorization-Header noetig). Tests setzen diese Variable, damit keiner
    der drei Aufrufe je das echte Netz erreicht."""
    return not os.environ.get("WB_KONTINGENT_KEIN_NETZ")


def openrouter_schluessel():
    """Wie shell/messungen/freie-modelle/messlauf.py: Schluesselbund zuerst, dann
    die Datei -- dieselbe Reihenfolge, damit es nicht zwei Wahrheiten gibt, wo
    der Schluessel herkommt. `security` gibt es nur auf macOS; auf peer (Linux)
    wirft subprocess.run FileNotFoundError, das faengt der except ab und die
    Datei bleibt der Rueckfallweg -- kein Mac-only-Pfad ohne Ausweg."""
    try:
        r = subprocess.run(["security", "find-generic-password", "-s", "wb-openrouter", "-w"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except Exception:
        pass
    try:
        with open(hp("~/.secrets-sync/api-keys/openrouter"), encoding="utf-8") as f:
            k = f.read().strip()
            return k or None
    except OSError:
        return None


def openrouter_rang_pruefen(zaehler_eintrag):
    """Die EINZIGE Ausnahme von 'kein Netzzugriff' in diesem Werkzeug (siehe
    Kopf-Grundregel), und deshalb absichtlich eng gefasst: ob ein Konto 50 oder
    1000 kostenlose Anfragen am Tag hat, haengt am eingezahlten Guthaben und
    steht nirgends lokal -- ein geratener Standardwert wuerde ein aufgeladenes
    Konto zwanzigfach zu frueh sperren. Der Aufruf gegen /api/v1/key beantwortet
    genau das (is_free_tier), braucht keinen Login (der API-Schluessel traegt
    das schon) und bekommt eine kurze Zeitgrenze (5s). Aufgerufen wird er NUR
    aus cmd_auffrischen (der expliziten Aktion), NIE aus dem impliziten
    Auto-Refresh in zustand_frisch()/pruefen -- und selbst dort hoechstens
    einmal pro Tag, sonst wuerde jeder Session-Start, der `auffrischen` zieht,
    erneut ins Netz gehen. Rueckgabe None heisst: nichts zu tun, alter Rang gilt
    weiter (oder es gibt noch keinen)."""
    if not _netz_erlaubt():
        return None
    heute = _heutiger_tag_utc()
    if (zaehler_eintrag or {}).get("grenze_geprueft_am_tag") == heute:
        return None
    schluessel = openrouter_schluessel()
    if not schluessel:
        return None
    try:
        anfrage = urllib.request.Request(
            "https://openrouter.ai/api/v1/key",
            headers={"Authorization": "Bearer %s" % schluessel})
        with urllib.request.urlopen(anfrage, timeout=5) as antwort:
            d = json.loads(antwort.read().decode("utf-8", "replace"))
    except Exception:
        return None
    frei = ((d or {}).get("data") or {}).get("is_free_tier")
    if frei is None:
        return None
    grenze = 50 if frei else 1000
    return {
        "grenze": grenze,
        "grenze_quelle": "netz:https://openrouter.ai/api/v1/key (is_free_tier=%s; Grenzen laut "
                          "openrouter.ai/docs/api-reference/limits, abgerufen 2026-08-27; "
                          "50er-Grenze zusaetzlich belegt durch den Tag selbst, siehe oben)" % frei,
        "grenze_geprueft_am_tag": heute,
        "grenze_geprueft_am": jetzt_iso(),
    }


def openrouter_preise_pruefen(alte_preise):
    """Zweite Netz-Ausnahme, aus demselben Grund wie oben nur in
    cmd_auffrischen: EIN GET gegen /api/v1/models -- oeffentlich, kein
    Schluessel, kein Modellaufruf, nur die Preisliste. Anders als der
    Rang-Check NICHT auf einmal-am-Tag gedrosselt: Preise koennen sich
    mehrmals am Tag aendern, und der Aufruf laeuft ohnehin nur, wenn jemand
    `auffrischen` von Hand oder aus einem eigenen Skript zieht -- nie am
    Spawn-Pfad (pruefen/zustand_frisch ruehren diese Funktion nie an).

    AKTION = Preis (prompt+completion, USD/Token) niedriger als beim
    zuletzt GESEHENEN Stand derselben Modell-ID -- der Sonderfall 'Preis
    faellt auf 0' zaehlt genauso, ohne Extra-Behandlung: 0 < irgendein
    positiver alter Preis ist einfach eine weitere Preissenkung. Ein Modell,
    das beim ALLERERSTEN Sehen schon 0 kostet, hat keinen alten Preis zum
    Vergleich -- es wird nur als Basislinie eingetragen, nie als Aktion
    gemeldet. Das ist der normale Freibestand, keine Aktion.

    EIN RABATT HEISST NICHT GLEICHZEITIG, DASS DAS MODELL GUENSTIG IST --
    das muss der Orchestrator dann entscheiden. Diese Funktion waehlt
    nichts aus, sie macht die Aktion nur sichtbar (Vorgabe des Nutzers,
    2026-08-27)."""
    if not _netz_erlaubt():
        return None
    try:
        with urllib.request.urlopen("https://openrouter.ai/api/v1/models", timeout=8) as antwort:
            d = json.loads(antwort.read().decode("utf-8", "replace"))
    except Exception:
        return None
    modelle = (d or {}).get("data") or []
    if not modelle:
        return None
    neu = dict(alte_preise or {})
    jetzt_str = jetzt_iso()
    for m in modelle:
        mid = m.get("id")
        if not mid:
            continue
        preisblock = m.get("pricing") or {}
        try:
            preis = float(preisblock.get("prompt") or 0) + float(preisblock.get("completion") or 0)
        except (TypeError, ValueError):
            continue
        alt = neu.get(mid)
        alter_preis = alt.get("preis") if alt else None
        if not isinstance(alter_preis, (int, float)):
            neu[mid] = {"preis": preis, "gesehen_am": jetzt_str}
        elif preis < alter_preis:
            neu[mid] = {"preis": preis, "gesehen_am": jetzt_str,
                        "aktion": {"vorher": alter_preis, "seit": jetzt_str}}
        elif preis > alter_preis:
            neu[mid] = {"preis": preis, "gesehen_am": jetzt_str}  # zurueckgestiegen -- Aktion vorbei
        else:
            eintrag = dict(alt)
            eintrag["gesehen_am"] = jetzt_str
            neu[mid] = eintrag  # unveraendert -- eine laufende Aktion bleibt sichtbar
    return neu


# Warnschwelle fuers OpenRouter-Guthaben: absolut, nicht prozentual, weil ein
# Prozentwert bei jedem neuen Aufladebetrag neu begruendet werden muesste, ohne
# dass sich am eigentlichen Risiko etwas aendert. 1 (Konto-Waehrung, siehe
# /api/v1/credits) liegt klar ueber dem, was eine gewoehnliche Session an
# bezahlten Modellrufen verursacht (die Preise oben liegen im Bereich von
# Bruchteilen eines Cents je 1000 Token), aber nah genug an 0, dass die Warnung
# nicht bei jedem 'zeigen' anschlaegt. Der eigentliche Grund ist nicht das Geld
# selbst: faellt das Guthaben auf 0, kann openrouter_rang_pruefen beim naechsten
# Messen den Rang wieder auf die 50er-Tagesgrenze zurueckfallen lassen (belegt:
# das Konto stand am 2026-08-27 mit 5 geladen und 0,05 verbraucht auf 1000) --
# und genau das soll sichtbar sein, BEVOR es passiert, nicht erst danach.
GUTHABEN_WARNSCHWELLE = 1.0


def openrouter_guthaben_pruefen():
    """Dritte Netz-Ausnahme, wieder nur in cmd_auffrischen: EIN GET gegen
    /api/v1/credits, authentifiziert (der Kontostand ist kontospezifisch,
    anders als die oeffentliche Modell-Preisliste oben)."""
    if not _netz_erlaubt():
        return None
    schluessel = openrouter_schluessel()
    if not schluessel:
        return None
    try:
        anfrage = urllib.request.Request(
            "https://openrouter.ai/api/v1/credits",
            headers={"Authorization": "Bearer %s" % schluessel})
        with urllib.request.urlopen(anfrage, timeout=5) as antwort:
