def cmd_auffrischen(args):
    start = datetime.datetime.now()
    if args.wenn_aelter_als is not None:
        z = lies_zustand()
        a = alter_sekunden(z) if z else None
        if z is not None and a is not None and a <= args.wenn_aelter_als * 3600:
            if not args.json:
                print("wb-kontingent: Stand ist %d Minuten alt -- nichts zu tun." % (a / 60))
            else:
                print(json.dumps(z, ensure_ascii=False, indent=2))
            return 0
    daten = auffrischen(args.harness)
    # codex-Kontingent (2026-09-10): der AKTIVE Endpunkt-Aufruf, siehe Kopfkommentar
    # "CODEX-KONTINGENT UEBER DEN CHATGPT-ENDPUNKT" -- bewusst hier und nicht in
    # sammle_codex, aus demselben Grund wie die drei OpenRouter-Aufrufe unten: sonst
    # zoege ihn auch der implizite Auto-Refresh aus zustand_frisch()/pruefen mit,
    # und jeder Spawn zahlte einen Netzaufruf. Nur, wenn dieser Lauf den codex-
    # Eintrag ueberhaupt neu erhoben hat (kein --harness-Filter auf einen anderen
    # Harness).
    codex_eintrag = daten.get("harnesses", {}).get("codex")
    if codex_eintrag is not None:
        auth = lies_json(hp("~/.codex/auth.json")) or {}
        tokens = auth.get("tokens") or {}
        codex_antwort = codex_usage_abrufen(tokens.get("access_token"), tokens.get("account_id"))
        if codex_antwort is not None:
            erfolg, fenster_meta = codex_usage_anwenden(codex_eintrag, codex_antwort)
            if erfolg:
                codex_verlauf_schreiben(codex_eintrag, fenster_meta)
        else:
            codex_eintrag["hinweis"] = (codex_eintrag.get("hinweis") or "").rstrip() + \
                " Kontingent-Endpunkt (%s) nicht erreichbar -- alter Weg (JWT/Sitzungsdateien) gilt weiter." % (
                    os.environ.get("WB_CODEX_USAGE_URL") or CODEX_USAGE_URL_DEFAULT)
        schreibe_zustand(daten)
    # Luecke 2d (2026-08-27): hoechstens einmal am Tag den Rang des OpenRouter-
    # Schluessels pruefen (50 vs. 1000 kostenlose Anfragen) -- die einzige
    # Ausnahme von 'kein Netzzugriff', siehe openrouter_rang_pruefen(). Bewusst
    # NUR hier (der expliziten Aktion), nicht in auffrischen() selbst, sonst
    # wuerde ihn auch der implizite Auto-Refresh aus pruefen() mitziehen.
    aktualisierung = openrouter_rang_pruefen(
        (daten.get("zaehler") or {}).get("openrouter-frei"))
    if aktualisierung:
        daten.setdefault("zaehler", {}).setdefault("openrouter-frei", {}).update(aktualisierung)
        schreibe_zustand(daten)
    # Zweiter Nachtrag (2026-08-27): Preis-Historie und Guthaben, dieselbe
    # Ausnahme, aber OHNE Tages-Drossel -- siehe Begruendung bei
    # openrouter_preise_pruefen(). Beide scheitern fuer sich allein (kein Netz,
    # kein Schluessel, kaputte Antwort); ein Fehlschlag hier darf den Rest von
    # 'auffrischen' nie anhalten.
    neue_preise = openrouter_preise_pruefen(daten.get("openrouter_preise"))
    if neue_preise is not None:
        daten["openrouter_preise"] = neue_preise
        schreibe_zustand(daten)
    neues_guthaben = openrouter_guthaben_pruefen()
    if neues_guthaben is not None:
        daten["openrouter_guthaben"] = neues_guthaben
        schreibe_zustand(daten)
    dauer = (datetime.datetime.now() - start).total_seconds()
    if args.json:
        print(json.dumps(daten, ensure_ascii=False, indent=2))
    else:
        print("wb-kontingent: %d Harness(es) erhoben in %.2fs -> %s"
              % (len(daten["harnesses"]), dauer, STATE_FILE))
    return 0


def _lesbar(iso_zeit):
    return iso_zeit[:16].replace("T", " ") if iso_zeit else "unbekannt"


def _aktive_aktionen(z):
    """Modelle mit einer laufenden Preisaktion, juengste zuerst -- gemeinsame
    Quelle fuer 'zeigen', '--knapp' und 'aktionen', damit die drei nicht
    auseinanderlaufen koennen."""
    preise = z.get("openrouter_preise") or {}
    return sorted(
        ((mid, e) for mid, e in preise.items() if e.get("aktion")),
        key=lambda kv: kv[1]["aktion"].get("seit") or "", reverse=True)


def _zeile(hid, e, beob=None):
    k = e.get("kontingent") or {}
    if beob is not None:
        # Beobachtet, nicht gemessen -- ueberstimmt den Sammler sichtbar, statt
        # neben ihm zu stehen (sonst zeigt die Zeile 'unbekannt', obwohl ein
        # Nachweis vorliegt).
        zustand = "BEOBACHTET ERSCHOEPFT bis " + _lesbar(beob.get("faellt_zurueck_am"))
    elif e.get("erschoepft") is True:
        zustand = "ERSCHOEPFT"
        if k.get("faellt_zurueck_am"):
            zustand += " bis " + k["faellt_zurueck_am"][:16].replace("T", " ")
    elif e.get("angemeldet") is False and e.get("art") == "abo":
        zustand = "NICHT ANGEMELDET"
    elif e.get("erschoepft") is False:
        zustand = "frei"
    elif e.get("art") == "lokal":
        # 'unbekannt' waere hier irrefuehrend: erschoepfen kann sich eine lokale
        # Spur nicht, die einzige Frage ist der Katalog -- und die ist beantwortet.
        fehlen = len(e.get("modelle_gesperrt") or [])
        zustand = "%d Modell(e) fehlen" % fehlen if fehlen else "Katalog vollstaendig"
    else:
        zustand = "unbekannt"
    rest = ""
    if k.get("rest") is not None:
        rest = "%s %s" % (k["rest"], k.get("einheit") or "")
    elif k.get("verbraucht") is not None:
        rest = "%s %s verbraucht" % (k["verbraucht"], k.get("einheit") or "")
    elif k.get("art") == "keins":
        rest = "kein Kontingent"
    return "%-15s %-9s %-14s %-27s %s" % (
        hid, e.get("art") or "?", e.get("plan") or "-", zustand, rest)


