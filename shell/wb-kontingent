def _finde_modell(kennung, harness_id):
    """Ein Modell-Argument darf eine Registry-id ODER ein roher modelRef sein --
    pi-worker kennt an dieser Stelle beides."""
    _, modelle, _ = registry()
    for m in modelle:
        if m.get("id") == kennung:
            return m.get("modelRef") or m.get("id")
    for m in modelle:
        if m.get("harness") == harness_id and (m.get("modelRef") or "") == kennung:
            return kennung
    return kennung


def cmd_pruefen(args):
    # Grenze 0 (18.08.): das Programm des Harness fehlt auf DIESER Maschine.
    # Bis dahin meldete `pruefen` fuer einen Harness ohne Binary eine 0, und der
    # Fehler zeigte sich erst im Pane -- gemessen an `cline`, das auf dem Mac nicht
    # installiert ist, waehrend die Routing-Tabelle fuenf cline-Eintraege fuehrt.
    # Der Aufrufname steht in der Registry; fehlt er dort, wird der Harness-Name
    # selbst versucht. Das ist eine reine PATH-Frage und kostet keine Messung.
    aufruf = _harness_befehl(args.harness)
    # Ein Eintrag darf einen PFAD statt eines Namens tragen (`claude` steht in der
    # Registry als `~/.local/bin/claude`). `shutil.which` findet einen Pfad mit
    # Tilde nicht -- ohne diese Zeile haette der neue Riegel JEDEN Claude-Spawn
    # gesperrt. Gemessen und beinahe ausgeliefert, 18.08.
    if aufruf:
        aufruf = os.path.expanduser(aufruf)
        vorhanden = (os.access(aufruf, os.X_OK) and os.path.isfile(aufruf)) \
            if os.sep in aufruf else (shutil.which(aufruf) is not None)
    else:
        vorhanden = True
    if not vorhanden:
        print("wb-kontingent: Harness '%s' ist auf dieser Maschine nicht installiert "
              "('%s' liegt in keinem PATH-Verzeichnis) -- kein Start."
              % (args.harness, aufruf), file=sys.stderr)
        return 6


    z, _ = zustand_frisch()

    # Beobachtung (Luecke 1, 2026-08-27): ueberstimmt den Sammler, solange sie
    # gilt -- unabhaengig davon, ob der Harness ueberhaupt einen Sammler-Eintrag
    # hat (agy z.B. hat nie ein 'erschoepft', der Sammler kann es nicht messen).
    beob = beobachtung_wirksam(z, args.harness)
    if beob is not None:
        print("wb-kontingent: Harness '%s' ist laut Beobachtung erschoepft (nicht gemessen, "
              "kein Sammler kann das hier belegen) -- kein Start. Wieder frei ab: %s. Quelle: %s"
              % (args.harness, beob.get("faellt_zurueck_am") or "unbekannt",
                 beob.get("quelle") or "?"), file=sys.stderr)
        return 3

    # OpenRouter-Tageslimit (Luecke 2, 2026-08-27): haengt am Modell, nicht am
    # Harness -- deshalb hier vor der harness-spezifischen Pruefung und auch
    # dann wirksam, wenn der Harness selbst keinen Sammler-Eintrag hat.
    if args.modell:
        ref_openrouter = _finde_modell(args.modell, args.harness)
        if _ist_openrouter_frei_ref(ref_openrouter):
            sperre = _openrouter_frei_sperre(z)
            if sperre:
                print(sperre, file=sys.stderr)
                return 3

    e = (z.get("harnesses") or {}).get(args.harness)
    if e is None:
        # Grenze 1: unbekannt sperrt nie. Das gilt fuer den KONTINGENT-Stand --
        # ein fehlendes Programm ist damit schon oben abgefangen, sonst kaeme ein
        # Harness, den die Zustandsdatei nicht kennt, nie an der Pruefung vorbei.
        return 0

    if e.get("erschoepft") is True:
        k = e.get("kontingent") or {}
        wieder = k.get("faellt_zurueck_am") or "unbekannt"
        print("wb-kontingent: Harness '%s' ist nachweislich erschoepft -- kein Start. "
              "Wieder frei ab: %s. Beleg: %s"
              % (args.harness, wieder, k.get("quelle") or "?"), file=sys.stderr)
        return 3

    if e.get("art") == "abo" and e.get("angemeldet") is False:
        print("wb-kontingent: Harness '%s' ist nachweislich nicht angemeldet -- kein Start. %s"
              % (args.harness, e.get("hinweis") or ""), file=sys.stderr)
        return 5

    if args.modell:
        ref = _finde_modell(args.modell, args.harness)
        if ref in (e.get("modelle_gesperrt") or []):
            kand = ollama_kandidaten(ref)
            print("wb-kontingent: Modell '%s' ist auf dieser Maschine nicht vorhanden "
                  "(nicht in 'ollama list') -- kein Start. Holen: ollama pull %s"
                  % (ref, kand[-1] if kand else ref), file=sys.stderr)
            return 4
        # Speicher ist eine WARNUNG, kein Riegel: Ollama entlaedt bei Druck selbst,
        # und ein Riegel an dieser Stelle wuerde raten, wo er messen muesste.
        if e.get("art") == "lokal" and ref in (e.get("modelle_nutzbar") or []):
            frei = freier_speicher_mib()
            if frei is not None and frei < 4096:
                print("wb-kontingent: WARNUNG -- nur %d MiB frei; ein grosses lokales Modell "
                      "verdraengt hier moeglicherweise ein anderes." % frei, file=sys.stderr)
    return 0


def cmd_erschoepft(args):
    z = lies_zustand() or {"stand": jetzt_iso(), "harnesses": {}}
    z.setdefault("beobachtungen", {})
    rueck = parse_zeitpunkt(args.reset) if args.reset else None
    if args.reset and rueck is None:
        print("wb-kontingent: '%s' ist weder eine Restdauer ('167h41m') noch ein Zeitpunkt "
              "('2026-09-03T13:25') -- die Beobachtung wird trotzdem eingetragen, aber ohne "
              "Rueckfallzeitpunkt (verfaellt dann nie von selbst)." % args.reset, file=sys.stderr)
    z["beobachtungen"][args.spur] = {
        "zustand": "erschoepft",
        "seit": jetzt_iso(),
        "faellt_zurueck_am": rueck.strftime(ISO) if rueck else "",
        "quelle": args.quelle or "",
    }
    schreibe_zustand(z)
    print("wb-kontingent: '%s' als erschoepft eingetragen%s."
          % (args.spur, (" -- wieder frei ab %s" % rueck.strftime(ISO)) if rueck else
             " -- ohne Rueckfallzeitpunkt, verfaellt nicht von selbst"))
    return 0


def cmd_frei(args):
    z = lies_zustand() or {"stand": jetzt_iso(), "harnesses": {}}
    z.setdefault("beobachtungen", {})
    z["beobachtungen"][args.spur] = {
        "zustand": "frei", "seit": jetzt_iso(), "faellt_zurueck_am": "",
        "quelle": args.quelle or "",
    }
    schreibe_zustand(z)
    print("wb-kontingent: '%s' als beobachtet-frei eingetragen -- eine fruehere "
          "'erschoepft'-Beobachtung ist damit aufgehoben, der Sammler entscheidet wieder allein."
          % args.spur)
    return 0


def cmd_zaehl(args):
    z = lies_zustand() or {"stand": jetzt_iso(), "harnesses": {}}
    z.setdefault("zaehler", {})
    eintrag = z["zaehler"].setdefault(args.spur, {})
    heute = _heutiger_tag_utc()
    if eintrag.get("tag") != heute:
        eintrag["verbraucht"] = 0
        eintrag["tag"] = heute
    eintrag["verbraucht"] = (eintrag.get("verbraucht") or 0) + args.anzahl
    eintrag["aktualisiert_am"] = jetzt_iso()
    schreibe_zustand(z)
    print("wb-kontingent: '%s' heute %d verbraucht." % (args.spur, eintrag["verbraucht"]))
    return 0


def cmd_knapp(args):
    z, _ = zustand_frisch()
    for hid in sorted((z.get("beobachtungen") or {}).keys()):
        beob = beobachtung_wirksam(z, hid)
        if beob is not None:
            print("%s: BEOBACHTET erschoepft, wieder frei ab %s (Quelle: %s)"
                  % (hid, _lesbar(beob.get("faellt_zurueck_am")), beob.get("quelle") or "?"))
    beobachtet_schon = set((z.get("beobachtungen") or {}).keys())
    for hid, e in sorted((z.get("harnesses") or {}).items()):
        if hid in beobachtet_schon or e.get("erschoepft") is not True:
            continue
        k = e.get("kontingent") or {}
        print("%s: erschoepft, wieder ab %s" % (hid, _lesbar(k.get("faellt_zurueck_am"))))
    zz = (z.get("zaehler") or {}).get("openrouter-frei") or {}
    grenze = zz.get("grenze")
    if zz.get("tag") == _heutiger_tag_utc() and grenze:
        # Ohne gemessenen Rang gibt es hier nichts Ehrliches zu meckern -- ein
        # Rueckfallwert waere geraten, und geraten sperrt nicht (Grundregel 1).
        verbraucht = zz.get("verbraucht") or 0
        rest = max(0, grenze - verbraucht)
        # Schwelle 'knapp': 20 % der Grenze oder 10 Anfragen, je nachdem, was
        # groesser ist -- bei 50 sind das 10 (die tatsaechlich gemessene
        # Restluft am 2026-08-27, als der Rauchtest den Tag beendete), bei 1000
        # eher 200, sonst waere 'knapp' bei einem aufgeladenen Konto nie zu sehen.
        if rest <= max(10, grenze * 0.2):
            print("openrouter-frei: %d von %d heute noch frei (%d verbraucht, %s, Reset laut "
                  "OpenRouter-Doku Mitternacht UTC)"
                  % (rest, grenze, verbraucht, "erschoepft" if rest <= 0 else "knapp"))
    guthaben = z.get("openrouter_guthaben") or {}
    rest_guthaben = guthaben.get("rest")
    if isinstance(rest_guthaben, (int, float)) and rest_guthaben < GUTHABEN_WARNSCHWELLE:
        print("openrouter-guthaben: nur noch %s uebrig (< %s) -- der Rang koennte beim naechsten "
              "Messen auf die 50er-Tagesgrenze zurueckfallen" % (rest_guthaben, GUTHABEN_WARNSCHWELLE))
    aktive = _aktive_aktionen(z)
    if aktive:
        # KNAPP bleibt knapp: bis zu fuenf Treffer ausgeschrieben, darueber nur
        # die Zahl -- jede Zeile hier landet im Kontext jedes Orchestrators bei
        # jedem Session-Start (Vorgabe des Nutzers, 2026-08-27).
        if len(aktive) <= 5:
            for mid, e in aktive:
                a = e["aktion"]
                print("openrouter-aktion: %s %.8g -> %.8g USD/Token" % (mid, a["vorher"], e["preis"]))
        else:
            print("openrouter-aktion: %d Modelle mit Preisaktion -- Liste: wb-kontingent aktionen"
                  % len(aktive))
    return 0


def cmd_aktionen(args):
    z = lies_zustand() or {}
    aktive = _aktive_aktionen(z)
    if not aktive:
        print("wb-kontingent: keine laufende Preisaktion bei OpenRouter bekannt "
              "(Stand: %s)." % (z.get("stand") or "noch nie erhoben"))
        return 0
    print("%d Modell(e) mit laufender Preisaktion bei OpenRouter (Stand: %s):"
          % (len(aktive), z.get("stand")))
    for mid, e in aktive:
        a = e["aktion"]
        print("  %-50s %.8g -> %.8g USD/Token (seit %s)"
              % (mid, a["vorher"], e["preis"], _lesbar(a.get("seit"))))
    # Vorgabe des Nutzers woertlich: ein Rabatt heisst nicht gleichzeitig, dass
    # das Modell guenstig ist -- das muss der Orchestrator dann entscheiden.
    # Diese Liste waehlt nichts aus, sie macht die Aktion nur sichtbar.
    print("Ein Rabatt heisst nicht gleichzeitig, dass das Modell guenstig ist -- "
          "das muss der Orchestrator dann entscheiden.")
    return 0


def _harness_befehl(harness):
    """Der AUFRUFNAME eines Harness, aus der Registry -- nicht sein Name.

    Beides faellt regelmaessig auseinander: `copilot-cloud` faehrt ueber das
    Programm `copilot`, und `cline` heisst als Programm `clite`. Wer den
    Harness-Namen fuer den Aufruf haelt, sperrt einen funktionierenden Harness
    und laesst einen fehlenden durch (beides gemessen am 18.08.). Faellt die
    Registry aus, wird nicht geraten: dann gibt es keinen Riegel.
    """
    pfad = os.environ.get("WB_MODELS_FILE") or os.path.expanduser(
        "~/.claude/workbench/models.json")
    try:
        with open(pfad, encoding="utf-8") as fh:
            daten = json.load(fh)
    except Exception:
        return None
    for h in (daten.get("harnesses") or []):
        if h.get("id") == harness:
            return h.get("command")
    return None

def freier_speicher_mib():
    exe = shutil.which("check-resources")
    if not exe:
        return None
    try:
        r = subprocess.run([exe], capture_output=True, text=True, timeout=10)
        d = json.loads(r.stdout)
        return (d.get("ram") or {}).get("free_mib")
    except Exception:
        return None


def main():
    ap = argparse.ArgumentParser(prog="wb-kontingent", add_help=True,
                                 description="Plan, nutzbare Modelle und Restkontingent je Harness.")
    # Top-level statt Unterbefehl, weil der SessionStart-Hook genau diesen einen
    # Aufruf macht ('wb-kontingent --knapp') und keinen Unterbefehl parsen muss.
    ap.add_argument("--knapp", action="store_true",
                    help="eine Zeile je Spur, die erschoepft oder knapp ist -- sonst still")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("auffrischen", help="alle Quellen lesen und die Zustandsdatei schreiben")
    p.add_argument("--harness")
    p.add_argument("--wenn-aelter-als", dest="wenn_aelter_als", type=float, metavar="STUNDEN")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_auffrischen)

    p = sub.add_parser("zeigen", help="lesbare Uebersicht")
    p.add_argument("harness", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_zeigen)

    p = sub.add_parser("pruefen", help="0 = spawnbar, sonst Grund auf stderr")
    p.add_argument("harness")
    p.add_argument("modell", nargs="?")
    p.set_defaults(fn=cmd_pruefen)

    p = sub.add_parser("pfad", help="Pfad der Zustandsdatei")
    p.set_defaults(fn=lambda a: (print(STATE_FILE), 0)[1])

    p = sub.add_parser("erschoepft", help="eine beobachtete Erschoepfung eintragen (Nachweis, kein Sammler-Messwert)")
    p.add_argument("spur")
    p.add_argument("--reset", metavar="ZEIT",
                   help="Restdauer ('167h41m', wie die CLIs sie melden) oder Zeitpunkt "
                        "('2026-09-03T13:25', Ortszeit)")
    p.add_argument("--quelle", help="woher die Beobachtung stammt, z.B. 'Meldung im Pane 2026-08-27 11:44'")
    p.set_defaults(fn=cmd_erschoepft)

    p = sub.add_parser("frei", help="eine fruehere 'erschoepft'-Beobachtung aufheben")
    p.add_argument("spur")
    p.add_argument("--quelle")
    p.set_defaults(fn=cmd_frei)

    p = sub.add_parser("zaehl", help="einen eigenen Aufruf gegen eine Spur buchen (taeglicher Rueckfall)")
    p.add_argument("spur")
    p.add_argument("anzahl", nargs="?", type=int, default=1)
    p.set_defaults(fn=cmd_zaehl)

    p = sub.add_parser("aktionen", help="volle Liste der laufenden OpenRouter-Preisaktionen")
    p.set_defaults(fn=cmd_aktionen)

    args = ap.parse_args()
    if args.knapp:
        return cmd_knapp(args)
    if not getattr(args, "fn", None):
        ap.print_help()
        return 2
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
