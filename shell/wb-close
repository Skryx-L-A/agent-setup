#!/usr/bin/env bash
# wb-close — the ONLY sanctioned way for an orchestrator to close a pane.
#
# Hard guarantees (enforced here, not just by prompt):
#   * REFUSES to close any pane whose @wb_role is "orchestrator".
#   * REFUSES to close the caller's own pane ($TMUX_PANE).
#   * Closes ONLY panes whose @wb_role is exactly "worker".
# => An orchestrator can neither close itself nor any other orchestrator through
#    this tool. Only der Nutzer closes orchestrators (by hand). Raw `tmux kill-pane`
#    / `kill-session` for worker cleanup is forbidden by the orchestrator role.
#
# The old self-kill bug filtered targets by @wb_worker — which is ALSO set on the
# orchestrator pane (claude-worker/orch-launch set it there). Keying on @wb_role
# makes that class of mistake impossible.
#
# Nach jedem tatsaechlichen Schliessen (2026-08-11, verschaerft am selben Tag):
# eine rein lesende Pruefung per `wb-waisen`, ob jetzt ein BESTAETIGTER Waise
# dasteht — Anlass war eine Kernel-Panik, ausgeloest von einem per
# `nohup ... & disown` gestarteten Modellserver, dessen Pane geschlossen wurde
# und der danach mit 21,9 GB unbemerkt weiterlief. Diese Pruefung AENDERT NICHTS
# an der Kill-Logik oben und beendet selbst nichts; sie laeuft NACH dem
# Schliessen und nur, wenn dabei wirklich ein Pane geschlossen wurde.
# Gewarnt wird NUR bei wb-waisens Klasse "waise" (Exit 1: ein Eigentuemer-
# Eintrag existiert, dessen Pane bestaetigt tot ist) — NIE bei "unregistriert"
# (Exit 2, blosser Verdacht ohne Eigentuemer-Beleg). Grund: die erste Fassung
# von wb-waisen stufte einen echten, gerade benutzten Modellserver einer
# FREMDEN Sitzung faelschlich als Waise ein (siehe dessen Kopfkommentar,
# "Fund 2") — eine Warnung, die auf so einer Vermutung einen kill vorschlaegt,
# ist schlimmer als keine Warnung. Fehlt `wb-waisen` (z. B. auf einer Maschine
# ohne dessen Ausrollung) oder laeuft die Maschine nicht unter macOS, bleibt
# die Pruefung schlicht stumm. Der Aufruf nutzt `wb-waisens` Option
# `--nur-waisen` (Befund 8, unabhaengiger Pruefdurchgang 2026-08-11): diese
# Warnung wollte "unregistriert"-Funde ohnehin nie sehen, zahlte aber vorher
# trotzdem dessen Messfenster mit, sobald irgendein unregistrierter
# Kandidat existierte -- gemessen 3,8s Wartezeit bei jedem `wb-close`.
#
# Usage:
#   wb-close <pane-id|worker-name> [more...]   close specific worker pane(s)
#   wb-close --all-workers                     close every worker pane (never orchestrators, never self)
#   wb-close --list                            list closable worker panes (read-only)
#
# Exit: 0 ok / nothing to do; 2 a target was refused; 1 usage/error.
set -euo pipefail
# tmux binary: never hardcode a machine-specific path — /usr/bin/tmux on Linux,
# /opt/homebrew/bin/tmux on the Mac. $TMUX_BIN wins, else whatever is on PATH.
T="${TMUX_BIN:-$(command -v tmux 2>/dev/null || true)}"
[ -n "$T" ] || T=tmux
SELF="${TMUX_PANE:-}"

# Basis statt zurueckgemeldeter Name (2026-08-04, systematischer Befund am selben
# Tag: derselbe Pane kann je nach Sessiongruppen-Zustand mal die Basis, mal die
# '-view'-Schwester liefern — siehe context-guard's base_session_name() fuer die
# volle Begruendung und regeln/worker-panes.md). Ueberall dort gebraucht, wo der
# Name als SCHLUESSEL ueber den Aufruf hinaus weiterlebt (Guard-Slug, Session-
# Scoping) — nicht dort, wo er nur eine `list-panes -s`-Abfrage im selben Atemzug
# fuettert (die liefert ueber Basis ODER Sicht dieselbe Pane-Menge).
base_session_of(){   # pane-id -> Basis-Sessionname
  local pane="$1" sess grp
  sess=$($T display -p -t "$pane" '#{session_name}' 2>/dev/null)
  grp=$($T display -p -t "$pane" '#{session_group}' 2>/dev/null)
  printf '%s' "${grp:-$sess}"
}

# The caller's own session. --all-workers is scoped to it: V2 runs SEVERAL
# workbench sessions at once, and the routine end-of-session cleanup of one
# session must never close the running workers of another (reproduced: a call in
# session A closed session B's worker). $WB_SESSION is the explicit form for a
# caller with no tmux context at all — same convention as pi-worker.
own_session(){
  if [ -n "${WB_SESSION:-}" ]; then printf '%s' "$WB_SESSION"; return; fi
  [ -n "$SELF" ] && base_session_of "$SELF" || true
}

role_of(){ $T display -p -t "$1" '#{@wb_role}' 2>/dev/null || true; }
worker_of(){ $T display -p -t "$1" '#{@wb_worker}' 2>/dev/null || true; }
exists(){ $T display -p -t "$1" '#{pane_id}' 2>/dev/null || true; }

resolve(){ # arg -> pane_id. accepts %id directly or a @wb_worker name.
  local a="$1"
  if [[ "$a" == %* ]]; then printf '%s' "$a"; return; fi
  $T list-panes -a -F '#{pane_id} #{@wb_worker}' 2>/dev/null \
    | awk -v n="$a" '$2==n{print $1; exit}'
}

# context-guard's done-notified-Markierung fuer diesen Worker mitsetzen (2026-08-04):
# schliesst der Orchestrator einen Worker-Pane ueber DIESES Werkzeug -- den "ONLY
# sanctioned way" laut Kopfkommentar oben --, hat er das Ergebnis erkennbar schon
# gelesen und verarbeitet; eine spaetere Fertigmeldung des Guards waere dann nur noch
# Laerm (gemessen 2026-08-04: sessionfix, tabnachlegen, doctortab, fensterstart —
# vier wertlose Meldungen, weil der Guard-Poll erst NACH dem `wb-close` ankam). Ein
# Pane, der auf ANDEREM Weg verschwindet (Absturz, rohes `tmux kill-pane` am Guard
# vorbei), bleibt UNMARKIERT -- der Guard meldet dann weiterhin wie bisher. Das ist
# absichtlich: genau dieser Fall (Pane schon weg, Ergebnis kommt/liegt trotzdem vor)
# ist der urspruengliche a project-Bug, den die Fertigmeldung ueberhaupt erst behoben
# hat (siehe test-context-guard-fertigmeldung.sh, Fall d) — ein pauschales
# "Pane fehlt => nie melden" wuerde ihn wieder aufreissen. Der Unterschied zwischen
# "bewusst ueber wb-close geschlossen" und "sonstwie verschwunden" ist genau das,
# was diese Markierung hier festhaelt.
#
# Slug/Sanitizing dupliziert bewusst context-guard's eigene socket_slug()/
# sanitize_name() (dort: Kommentarblock ueber STATE_BASE) -- beide Skripte muessen
# bitgleich denselben Pfad berechnen; ein gemeinsames Sourcing waere hier mehr
# Kopplung als die paar Zeilen wert sind. Aus demselben Grund ist die Sperre unten
# eine EIGENE, duplizierte Fassung von context-guards acquire_done_lock() (siehe
# dessen Kommentar bei LOCK_DIR) -- kein Sourcing, keine zusaetzliche Kopplung.
#
# Sperre gegen context-guard (2026-08-22, Auftrag "Fertigmeldung: Sperre gebaut"):
# ohne sie kann eine Fertigmeldung sichtbar werden, WAEHREND dieser Schreibzugriff
# hier gerade laeuft -- context-guards eigene "frisch nachpruefen"-Stelle schliesst
# nur das Fenster VOR ihrem nudge()-Aufruf, nicht das Fenster INNERHALB davon. Zwei
# Deckel: WBCLOSE_LOCK_TIMEOUT_S begrenzt die Wartezeit auf die Sperre, danach wird
# OHNE sie geschrieben (zweite Auflage: kein Ausfall, nur dieselbe Reihenfolge wie
# vorher); WBCLOSE_LOCK_STALE_S uebernimmt eine Sperre, die laenger steht, statt sie
# fuer immer zu respektieren (erste Auflage: ein abgestuerzter Halter darf den Guard
# nie dauerhaft verstummen lassen).
WBCLOSE_LOCK_TIMEOUT_S="${WBCLOSE_LOCK_TIMEOUT_S:-5}"
WBCLOSE_LOCK_STALE_S="${WBCLOSE_LOCK_STALE_S:-20}"
acquire_close_lock() {   # <sperrverzeichnis> -> 0 erworben, 1 Deckel erreicht
  local d="$1" deadline age mtime
  deadline=$((SECONDS + WBCLOSE_LOCK_TIMEOUT_S))
  while :; do
    mkdir "$d" 2>/dev/null && return 0
    if [ -d "$d" ]; then
      mtime="$(stat -L -c %Y "$d" 2>/dev/null || stat -L -f %m "$d" 2>/dev/null || echo 0)"
      age=$(( $(date +%s) - mtime ))
      if [ "$age" -gt "$WBCLOSE_LOCK_STALE_S" ]; then
        rmdir "$d" 2>/dev/null || rm -rf "$d" 2>/dev/null
        continue
      fi
    fi
    [ $SECONDS -lt $deadline ] || return 1
    sleep 0.1
  done
}
mark_worker_done(){   # socket-path session-name worker-name -> setzt das done-notified-Flag, best effort
  local sp="$1" sess="$2" wname="$3" slug base lockdir lockpath have_lock=0
  [ -n "$wname" ] && [ -n "$sp" ] || return 0
  slug="$(printf '%s|%s' "$sp" "$sess" | tr -c 'a-zA-Z0-9' '-')"
  base="$HOME/.local/state/wb-context-guard/$slug.done-notified"
  mkdir -p "$base" 2>/dev/null || return 0
  lockdir="$HOME/.local/state/wb-context-guard/$slug.done-lock"
  mkdir -p "$lockdir" 2>/dev/null || true
  lockpath="$lockdir/$(printf '%s' "$wname" | tr -c 'a-zA-Z0-9' '-')"
  acquire_close_lock "$lockpath" && have_lock=1
  touch "$base/$(printf '%s' "$wname" | tr -c 'a-zA-Z0-9' '-')" 2>/dev/null || true
  [ "$have_lock" = 1 ] && rmdir "$lockpath" 2>/dev/null
}

# Worktree-Aufraeumen (2026-08-04). Ein geschlossener Worker laesst sonst seinen
# Arbeitsbaum unter ~/.pi-workers/worktrees/ stehen, bis ihn niemand mehr zuordnen
# kann. Aufgeraeumt wird NUR, wenn wb-worktree selbst bestaetigt, dass nichts
# verlorengeht: unbeachtete Aenderungen ODER Commits, die die Basis nicht hat,
# lassen den Baum stehen und werden hier GEMELDET -- entscheiden tut der Nutzer
# (`wb-worktree diff|adopt|remove --force`). Das Schliessen des Panes haengt daran
# nie: Exit-Code und Ablauf von wb-close bleiben unveraendert, egal was hier
# passiert. Fehlt das Werkzeug (aeltere Maschine), passiert gar nichts.
# Gegenstueck zu pi-worker's `wb-state add-worker` (2026-08-16, bugjagd
# shell/mittel, wb-close:227 + pi-worker:531-561): ohne diesen Aufruf entfernte
# NICHTS je einen Eintrag aus workers[] -- die Liste wuchs ueber die gesamte
# Lebensdauer einer Session nur (reproduziert: wb-close meldete "geschlossen",
# der Worker stand danach unveraendert weiter im Zustandsdokument). $sess ist
# hier bereits die BASIS (siehe base_session_of oben) -- worker_file() in
# wb-state sucht bei gesetzter Session ohnehin ueber alle Zustandsdateien nach
# dem passenden tmuxSession-Feld, ein DIR wird dabei nicht gebraucht. Best
# effort: ein Fehlschlag hier darf das eigentliche Schliessen nie rueckwirkend
# als fehlgeschlagen erscheinen lassen.
remove_worker_entry(){   # $1 = worker name, $2 = base session
  local wname="$1" sess="$2"
  [ -n "$wname" ] && [ -n "$sess" ] || return 0
  "$HOME/.local/bin/wb-state" remove-worker "$wname" "" "$sess" 2>/dev/null \
    || echo "wb-close: HINWEIS — '$wname' konnte nicht aus der Worker-Liste entfernt werden (wb-state remove-worker fehlgeschlagen)." >&2
  return 0
}

cleanup_worktree(){ # $1 = worker name
  local wname="$1" wt="$HOME/.local/bin/wb-worktree" out rc=0
  [ -n "$wname" ] || return 0
  [ -x "$wt" ] || return 0
  out="$("$wt" remove "$wname" 2>&1)" || rc=$?
  case "$rc" in
    0) [ -n "$out" ] && printf '%s\n' "$out" ;;
    3) printf '%s\n' "$out"
       echo "wb-close: HINWEIS — der Worktree von '$wname' bleibt stehen, es steckt Arbeit darin (siehe oben)." ;;
    *) : ;;   # kein Worktree vermerkt: der Normalfall ohne git, nichts zu melden
  esac
  return 0
}

# Belegungstafel und Gruppen (2026-10-09, Plan Tafel und Gruppen): ein geschlossener Worker
# haelt nichts mehr. VOR dem Schliessen traegt wb-close verbliebene Tafel-Eintraege und
# Wartende dieses Panes aus -- als sein Orchestrator, ueber die Kennungen aus
# `wb-tafel --json` -- und meldet jeden; ein toter Pane verfiele sonst erst beim naechsten
# Tafel-Aufruf, und ein mit --pid gebundener Lauf ueberlebte das Schliessen gar. NACH dem
# Schliessen kommt der Worker aus der Team-Gruppe (`wb-gruppe team weg`). Beides ist best
# effort: fehlt ein Werkzeug oder scheitert es, bleibt Schliessen, Exit-Code und Ablauf
# unveraendert, es gibt nur einen Hinweis. $WB_TAFEL/$WB_GRUPPE zeigen fuer Tests auf Kopien.
tafel_austragen(){   # pane-id socket-path worker-name
  local pane="$1" sp="$2" wname="$3" tafel="${WB_TAFEL:-$HOME/.local/bin/wb-tafel}" ids id platz out
  [ -x "$tafel" ] || return 0
  ids="$("$tafel" --json 2>/dev/null | /usr/bin/python3 -c '
import json, os, sys
pane, sp = sys.argv[1], sys.argv[2]
try:
    d = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
def gleich(a, b):
    return bool(a) and bool(b) and (a == b or os.path.realpath(a) == os.path.realpath(b))
for p in d.get("plaetze") or []:
    for e in (p.get("eintraege") or []) + (p.get("schlange") or []):
        h = e.get("halter") or {}
        if h.get("pane") == pane and gleich(h.get("socket", ""), sp):
            print("%s\t%s" % (e.get("id", ""), p.get("name", "")))
' "$pane" "$sp" 2>/dev/null)" || true
  [ -n "$ids" ] || return 0
  while IFS=$'\t' read -r id platz; do
    [ -n "$id" ] || continue
    if out="$("$tafel" gib "$id" 2>&1 </dev/null)"; then
      echo "wb-close: Tafel -- $id ($platz) von ${wname:-$pane} ausgetragen."
    else
      echo "wb-close: HINWEIS -- Tafel-Eintrag $id ($platz) von ${wname:-$pane} liess sich nicht austragen: $(printf '%s\n' "$out" | tail -1)" >&2
    fi
  done <<< "$ids"
  return 0
}

gruppe_austragen(){   # worker-name
  local wname="$1" gruppe="${WB_GRUPPE:-$HOME/.local/bin/wb-gruppe}" out
  [ -n "$wname" ] && [ -x "$gruppe" ] || return 0
  # `--geschlossen` (14.10.2026): wb-close hat den Pane gerade geschlossen und sagt es der Gruppe;
  # das gilt auch ueber ssh (kein Pane in der Ahnenreihe, sonst "Absender nicht bestimmbar").
  # wb-gruppe prueft selbst, dass kein Pane den Namen mehr traegt. Eine aeltere wb-gruppe kennt
  # die Option nicht (Exit 2): dann der bisherige Aufruf.
  local rc=0
  out="$("$gruppe" team weg "$wname" --geschlossen 2>&1)" || rc=$?
  [ "$rc" -eq 2 ] && { rc=0; out="$("$gruppe" team weg "$wname" 2>&1)" || rc=$?; }
  if [ "$rc" -eq 0 ]; then
    [ -n "$out" ] && echo "wb-close: Gruppe -- $out"
  else
    echo "wb-close: HINWEIS -- $wname nicht aus der Team-Gruppe ausgetragen: $(printf '%s\n' "$out" | tail -1)" >&2
  fi
  return 0
}

# Zaehlt tatsaechliche Schliessungen dieses Aufrufs (nicht Kandidaten, nicht
# Fehlversuche) -- warn_waisen laeuft nur, wenn hier wirklich etwas geschlossen
# wurde, siehe Kopfkommentar.
closed_count=0
closed_workers=""

capture_worker_context(){ # pane-id worker-name -> append pane, socket, worktree, process tree
  local pane="$1" worker="$2" socket path marker pane_path worktree_root expected root tree rows record
  socket="$($T display -p -t "$pane" '#{socket_path}' 2>/dev/null)"
  marker="$($T display -p -t "$pane" '#{@wb_worktree}' 2>/dev/null)"
  path=""
  if [ -n "$marker" ]; then
    path="$(cd -P "$marker" 2>/dev/null && pwd -P)"
  elif [ -n "$worker" ]; then
    pane_path="$($T display -p -t "$pane" '#{pane_current_path}' 2>/dev/null)"
    pane_path="$(cd -P "$pane_path" 2>/dev/null && pwd -P)"
    worktree_root="$(cd -P "$HOME/.pi-workers/worktrees" 2>/dev/null && pwd -P)"
    expected="$(cd -P "$worktree_root/$worker" 2>/dev/null && pwd -P)"
    if [ -n "$worktree_root" ] && [ -n "$expected" ] \
        && [ "${expected%/*}" = "$worktree_root" ] \
        && [ "${expected##*/}" = "$worker" ] \
        && [ "$pane_path" = "$expected" ]; then
      path="$expected"
    fi
  fi
  root="$($T display -p -t "$pane" '#{pane_pid}' 2>/dev/null)"
  tree=""
  if [[ "$root" =~ ^[0-9]+$ ]]; then
    rows="$(ps -axo pid=,ppid= 2>/dev/null)"
    tree="$(printf '%s\n' "$rows" | awk -v root="$root" '
      { pid[NR]=$1; ppid[NR]=$2 }
      END {
        found[root]=1
        for (pass=0; pass<NR; pass++)
          for (i=1; i<=NR; i++) if (found[ppid[i]]) found[pid[i]]=1
        sep=""
        for (i=1; i<=NR; i++) if (found[pid[i]]) { printf "%s%s", sep, pid[i]; sep="," }
      }')"
  fi
  printf -v record '%s\t%s\t%s\t%s\t%s\n' "$pane" "$worker" "$socket" "$path" "$tree"
  closed_workers="${closed_workers}${record}"
}

waise_gehoert_dazu(){ # pid detail -> 0 if a closed worker matches
  local pid="$1" detail="$2" owner owner_worker owner_socket cwd cwd_real pane worker socket path tree
  owner="$(printf '%s\n' "$detail" | sed -n 's/.*zuletzt \(%[0-9][0-9]*\).*/\1/p')"
  owner_worker="$(printf '%s\n' "$detail" | sed -n "s/.*Worker '\([^']*\)'.*/\1/p")"
  if [ -n "$owner" ]; then
    owner_socket="$(/usr/bin/python3 - "$HOME/.local/state/wb-nohup/eigentuemer/$pid.json" 2>/dev/null <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as source:
        print(json.load(source).get("socket_path") or "")
except Exception:
    pass
PY
)"
  fi
  while IFS=$'\t' read -r pane worker socket path tree; do
    [ -n "$pane" ] || continue
    if [ "$owner" = "$pane" ] && [ -n "$owner_socket" ] && [ "$owner_socket" = "$socket" ] \
        && { [ -z "$worker" ] || [ "$worker" = "$owner_worker" ]; }; then return 0; fi
    case ",$tree," in *",$pid,"*) return 0 ;; esac
    if [ -n "$path" ] && command -v lsof >/dev/null 2>&1; then
      cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
      case "$cwd" in "$path"|"$path (deleted)"|"$path/"*) return 0 ;; esac
      cwd_real="$(cd -P "$cwd" 2>/dev/null && pwd -P)"
      case "$cwd_real/" in "$path/"*) return 0 ;; esac
    fi
  done <<< "$closed_workers"
  return 1
}

# Rein lesende Pruefung nach dem Schliessen: gibt es jetzt einen schweren
# Hintergrundprozess ohne lebenden Besitzer, wird er benannt -- beendet wird
# hier nichts, das bleibt bei wb-waisen selbst (siehe dessen Kopfkommentar) und
# einer bewussten Entscheidung danach. `$WB_WAISEN` erlaubt Tests, auf eine
# andere Kopie zu zeigen, exakt wie `$WB_DOCTOR` es fuer wb-doctor tut.
# Faellt hier der letzte Worker weg, darf drueben kein toter Spiegel zurueckbleiben
# (2026-08-13). `wb-remote-view --announce` bittet die andere Maschine, ihre Sicht auf
# diese hier neu zu bewerten; sie raeumt den Spiegel-Pane ab, sobald hier kein
# lebender Worker mehr steht. Abgekoppelt und gedrosselt — ein Schliessen darf daran
# nie haengenbleiben.
melde_spiegel(){
  local rv="${WB_REMOTE_VIEW:-$HOME/.local/bin/wb-remote-view}"
  [ -x "$rv" ] || return 0
  # Ohne Drossel: ein Abbau darf nicht daran scheitern, dass kurz zuvor ein Spawn
  # dieselbe Ansage geschickt hat — sonst bleibt genau der tote Spiegel stehen,
  # den diese Zeile verhindern soll.
  WB_REMOTE_VIEW_ANNOUNCE_GAP=0 "$rv" --announce >/dev/null 2>&1 || true
}

warn_waisen(){
  local wt="${WB_WAISEN:-$HOME/.local/bin/wb-waisen}" out rc=0
  melde_spiegel
  [ -x "$wt" ] || return 0
  # `|| rc=$?` statt eines eigenen `rc=$?` danach: unter `set -e` (aktiv in
  # diesem Skript) bricht eine Zuweisung aus einer fehlschlagenden
  # Kommandosubstitution SOFORT ab, noch bevor die naechste Zeile den Code
  # lesen kann -- wb-waisen meldet einen Fund gerade ueber einen Exit-Code
  # ungleich 0 (1), also genau der Fall, den dieses Werkzeug zeigen soll.
  # Gemessen: ohne `||` hier beendete sich wb-close beim ersten echten Fund
  # sofort mit Exit 1, bevor auch nur eine Zeile der Warnung gedruckt wurde.
  # --nur-waisen (Befund 8, unabhaengiger Pruefdurchgang 2026-08-11): diese
  # Warnung druckt ohnehin ausschliesslich die Klasse "waise" (siehe unten),
  # zahlt vorher aber sonst IMMER das gemeinsame Messfenster von Weg B mit --
  # gemessen 3,8s bei jedem einzelnen wb-close, allein weil auf der Maschine
  # ein FREMDER, unregistrierter Prozess lief, an dem diese Warnung nie
  # interessiert war. --nur-waisen laesst Weg B ganz weg (Weg-A-Kandidaten mit
  # totem Eigentuemer werden weiterhin gemessen, das ist Befund 1 und bleibt
  # unangetastet); Exit-Code kennt dann nur noch 0 oder 1.
  out="$("$wt" --lines --nur-waisen 2>/dev/null)" || rc=$?
  # rc==1 heisst "mindestens ein bestaetigter Waise".
  [ "$rc" -eq 1 ] || return 0
  echo
  local fremde=0 eigene=0
  local tmp="$out" pid rss etime ports kategorie klasse detail cmd
  while IFS='|' read -r pid rss etime ports kategorie klasse detail cmd; do
    [ -n "$pid" ] || continue
    [ "$klasse" = "waise" ] || continue
    if waise_gehoert_dazu "$pid" "$detail"; then eigene=$((eigene+1)); else fremde=$((fremde+1)); fi
  done <<EOF
$tmp
EOF
  [ "$eigene" -gt 0 ] && echo "wb-close: HINWEIS — bestaetigte Waisen dieses geschlossenen Workers (Eigentuemer-Pane tot, nur gelesen, nichts beendet):"
  printf '%s\n' "$out" | while IFS='|' read -r pid rss etime ports kategorie klasse detail cmd; do
    [ -n "$pid" ] || continue
    [ "$klasse" = "waise" ] || continue
    if ! waise_gehoert_dazu "$pid" "$detail"; then continue; fi
    printf '  PID %-8s %s%s\n' "$pid" "$kategorie" "${ports:+ (Port $ports)}"
    printf '      %s\n' "$detail"
    printf '      Befehl:  %s\n' "$cmd"
    # Ein "waise" mit totem Eigentuemer, der gerade BENUTZT wird, traegt den
    # Text "kein automatischer kill-Vorschlag" in DETAIL (wb-waisen misst das
    # seit Befund 1, unabhaengiger Pruefdurchgang 2026-08-11) -- dann keinen
    # kill vorschlagen, sonst waere diese Warnung selbst wieder Fund 2.
    case "$detail" in
      *"kein automatischer kill-Vorschlag"*) : ;;
      *) printf '      Beenden: kill %s\n' "$pid" ;;
    esac
  done
  [ "$fremde" -gt 0 ] && echo "wb-close: $fremde weitere bestätigte Waisen auf dieser Maschine gehören nicht zu diesem Worker — ansehen mit wb-waisen"
  return 0
}

close_one(){ # $1 = pane-id or worker-name ; echoes result, returns 0/2
  local arg="$1" pid role wname sp sess
  pid="$(resolve "$arg")"
  if [[ -z "$pid" ]]; then echo "wb-close: kein Pane für '$arg' gefunden"; return 2; fi
  pid="$(exists "$pid")"
  if [[ -z "$pid" ]]; then echo "wb-close: Pane '$arg' existiert nicht (schon zu)"; return 0; fi
  if [[ -n "$SELF" && "$pid" == "$SELF" ]]; then
    echo "wb-close: VERWEIGERT — $pid ist DEIN eigener Pane. Ein Orchestrator schließt sich nie selbst."; return 2
  fi
  role="$(role_of "$pid")"
  if [[ "$role" == "orchestrator" ]]; then
    echo "wb-close: VERWEIGERT — $pid ist ein ORCHESTRATOR-Pane. Nur der Nutzer beendet Orchestratoren."; return 2
  fi
  if [[ "$role" != "worker" ]]; then
    echo "wb-close: VERWEIGERT — $pid hat @wb_role='$role' (nicht 'worker'). Nur Worker-Panes werden geschlossen."; return 2
  fi
  # read the name AND the guard-slug context BEFORE the kill — afterwards the pane
  # is gone and both the success message and mark_worker_done need them. sess MUSS
  # die Basis sein (base_session_of, nicht der rohe '#{session_name}'-Read): sonst
  # rechnet mark_worker_done denselben Slug aus, den context-guard NACH seinem
  # eigenen Punkt-0-Fix nie mehr verwendet, und die Markierung landet in einer
  # Datei, die niemand liest -- die Meldung waere weiterhin da, nur unsichtbar
  # falsch benannt statt sichtbar falsch (gemessen 2026-08-04, systematischer Befund).
  wname="$(worker_of "$pid")"
  capture_worker_context "$pid" "$wname"
  sp="$($T display -p -t "$pid" '#{socket_path}' 2>/dev/null)"
  sess="$(base_session_of "$pid")"
  tafel_austragen "$pid" "$sp" "$wname"
  $T kill-pane -t "$pid" && { echo "wb-close: geschlossen $pid (worker=$wname arg=$arg)"; mark_worker_done "$sp" "$sess" "$wname"; cleanup_worktree "$wname"; remove_worker_entry "$wname" "$sess"; gruppe_austragen "$wname"; closed_count=$((closed_count+1)); }
  return 0
}

list_workers(){
  printf '%-6s %-16s %-20s %s\n' PANE WORKER SESSION STATE
  # Ein Pane einer Sessiongruppe erscheint in `list-panes -a` ZWEIMAL, einmal je
  # Session (Basis und '-view' teilen sich die Panes, aber jede listet sie unter
  # ihrem EIGENEN Namen) -- geprueft 2026-08-04, systematischer Befund. Anders als
  # bei --all-workers unten (dort filtert ein exakter Session-Vergleich die
  # Duplikate implizit weg) ist das hier eine reine Anzeige ohne Filter: ohne
  # Dedup erschiene jeder Worker zweimal, als gaebe es ihn doppelt. `!seen[$1]++`
  # behaelt die ERSTE Zeile pro Pane-Id.
  $T list-panes -a -F '#{pane_id}|#{@wb_role}|#{@wb_worker}|#{session_name}|#{pane_dead}' 2>/dev/null \
    | awk -F'|' '$2=="worker" && !seen[$1]++{printf "%-6s %-16s %-20s %s\n",$1,$3,$4,($5=="1"?"dead":"live")}'
}

[[ $# -eq 0 ]] && { sed -n '2,38p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

case "${1:-}" in
  --help|-h) sed -n '2,38p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --list|-l) list_workers; exit 0 ;;
  --all-workers|-a)
    rc=0
    sess="$(own_session)"
    if [[ -z "$sess" ]]; then
      echo "wb-close: --all-workers braucht die eigene Session, sie ist hier nicht bestimmbar (kein tmux-Kontext)." >&2
      echo "  Entweder aus dem Orchestrator-Pane aufrufen, oder WB_SESSION=<session> setzen, oder die Panes einzeln nennen." >&2
      exit 1
    fi
    # snapshot worker pane-ids first (kill mutates the list); never include SELF,
    # and never a pane of a FOREIGN session (see own_session above).
    # read-loop instead of `mapfile`: macOS ships bash 3.2, which has no mapfile —
    # there the builtin is simply missing and --all-workers aborts with 127. This
    # form behaves identically and works on both machines.
    # Auch hier erscheint ein gruppierter Pane als zwei Zeilen (Basis + '-view'),
    # aber ungefaehrlich: $1==s trifft pro Pane hoechstens die EINE Zeile, deren
    # Session-Label exakt gleich der Basis-Referenz $sess ist -- die andere Zeile
    # (mit dem jeweils ANDEREN Label) faellt schon am Vergleich raus. Kein Pane
    # kann also doppelt in $panes landen (geprueft 2026-08-04, systematischer Befund).
    panes=()
    while IFS= read -r p; do
      [ -n "$p" ] && panes[${#panes[@]}]="$p"
    done < <($T list-panes -a -F '#{session_name}|#{pane_id}|#{@wb_role}' 2>/dev/null \
                          | awk -F'|' -v self="$SELF" -v s="$sess" '$1==s && $3=="worker" && $2!=self{print $2}')
    if [[ ${#panes[@]} -eq 0 ]]; then echo "wb-close: keine Worker-Panes offen (Session $sess)"; exit 0; fi
    for p in "${panes[@]}"; do close_one "$p" || rc=2; done
    [[ "$closed_count" -gt 0 ]] && warn_waisen
    exit $rc ;;
  -*) echo "wb-close: unbekannte Option '$1'" >&2; exit 1 ;;
esac

rc=0
for a in "$@"; do close_one "$a" || rc=2; done
[[ "$closed_count" -gt 0 ]] && warn_waisen
exit $rc
