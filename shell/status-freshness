#!/bin/bash
# status-freshness — findet geteilte Projekte, deren STATUS.md hinter dem letzten Commit
#   im zugehoerigen Repo zurueckliegt.
#
# WARUM: shared-projects.md (~/Knowledge/10-global/) ist das Sichtbarkeits-Modell fuer die
#   sechs gemeinsamen Projekte (der Nutzer/ein Mitnutzer) — jede STATUS.md soll den aktuellen Stand
#   tragen. Veralten passiert lautlos, bis zwei Leute parallel im selben Bereich landen.
#   Dieses Tool macht das Veralten sichtbar, statt es der Disziplin zu ueberlassen.
#
# BENUTZUNG: status-freshness            (gegen den echten Vault ~/Knowledge)
#            status-freshness --vault <pfad>   (gegen eine Kopie, z.B. zum Testen)
#
# Rein lesend: kein git pull, kein git add, kein Schreiben. Exit-Code ist IMMER 0 —
#   das Tool meldet, es blockiert nichts (kein CI-Gate, reine Information).
#
# GRENZEN (bewusst einfach gehalten):
#   - Freshness-Datum kommt aus "Stand (YYYY-MM-DD...)"-Markern im STATUS.md-Fliesstext
#     (Konvention dieses Vaults), nicht aus einem strukturierten Feld. Fehlt ein solcher
#     Marker, faellt das Tool auf das letzte Commit-Datum der STATUS.md-Datei selbst zurueck
#     und sagt das dazu.
#   - Bei mehreren "Stand (...)"-Markern zaehlt der spaeteste (max), nicht der zuletzt
#     im Text stehende — manche STATUS.md haengen Eintraege nicht chronologisch an.
#   - Lokaler Projekt-Checkout wird per Remote-URL-Abgleich unter ~/AI gesucht (Tiefe 3),
#     nicht hart codiert. Fehlt der lokale Checkout auf dieser Maschine (z.B. claude-setup),
#     wird das Projekt uebersprungen und gemeldet statt zu fehlschlagen.

set -u

VAULT="$HOME/Knowledge"

while [ $# -gt 0 ]; do
  case "$1" in
    --vault) VAULT="$2"; shift 2 ;;
    *) echo "Unbekannte Option: $1" >&2; exit 0 ;;
  esac
done

# Der Vault selbst ist das Repo fuer "knowledge-vault" — darum als eigener Kandidat,
# nicht nur ~/AI/*. Reihenfolge wird erst hier gesetzt, damit --vault sie mitbestimmt.
SEARCH_ROOTS=("$HOME/AI" "$HOME/AI/Minecraft/Shader" "$VAULT")

SHARED_MD="$VAULT/10-global/shared-projects.md"
if [ ! -f "$SHARED_MD" ]; then
  echo "status-freshness: $SHARED_MD nicht gefunden — nichts zu pruefen."
  exit 0
fi

find_local_repo() {
  # Sucht unter SEARCH_ROOTS eine .git-Arbeitskopie, deren origin-Remote den Repo-Slug enthaelt.
  slug="$1"   # z.B. <your-github-user>/claude-workbench
  for root in "${SEARCH_ROOTS[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r gitdir; do
      repo="$(dirname "$gitdir")"
      url=$(git -C "$repo" config --get remote.origin.url 2>/dev/null)
      [ -n "$url" ] || continue
      case "$url" in
        *"$slug"*|*"$slug".git*) echo "$repo"; return 0 ;;
      esac
    done < <(find "$root" -maxdepth 3 -type d -name ".git" 2>/dev/null)
  done
  return 1
}

max_status_date() {
  # Groesstes "Stand (YYYY-MM-DD" Datum im Fliesstext, leer wenn keins gefunden.
  grep -oE 'Stand \(?[0-9]{4}-[0-9]{2}-[0-9]{2}' "$1" 2>/dev/null \
    | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' \
    | sort -u | tail -1
}

echo "status-freshness — Vault: $VAULT"
echo

found_any=0
stale_any=0

while IFS='|' read -r _ proj repo _owner _mitarb statuspath_raw _; do
  proj=$(echo "$proj" | xargs)
  repo=$(echo "$repo" | tr -d '`' | xargs)
  [ -n "$proj" ] || continue
  found_any=1

  statuspath=$(echo "$statuspath_raw" | grep -o '`[^`]*`' | head -1 | tr -d '`' | xargs)
  status_file="$VAULT/$statuspath"

  echo "== $proj =="
  if [ ! -f "$status_file" ]; then
    echo "  STATUS.md fehlt ($statuspath) — uebersprungen."
    echo
    continue
  fi

  local_repo=$(find_local_repo "$repo")
  if [ -z "$local_repo" ]; then
    echo "  kein lokales Repo-Checkout fuer $repo gefunden unter ${SEARCH_ROOTS[*]} — uebersprungen."
    echo
    continue
  fi

  status_date=$(max_status_date "$status_file")
  source_note=""
  if [ -z "$status_date" ]; then
    status_date=$(git -C "$VAULT" log -1 --format=%cs -- "$statuspath" 2>/dev/null)
    source_note=" (kein \"Stand (...)\"-Marker gefunden, nutze Datei-Commit-Datum)"
  fi

  commit_date=$(git -C "$local_repo" log -1 --format=%cs 2>/dev/null)

  if [ -z "$status_date" ] || [ -z "$commit_date" ]; then
    echo "  Datum nicht ermittelbar (STATUS: '${status_date:-?}', letzter Commit: '${commit_date:-?}')."
    echo
    continue
  fi

  echo "  STATUS.md-Stand: $status_date$source_note"
  echo "  letzter Commit ($local_repo): $commit_date"
  if [[ "$commit_date" > "$status_date" ]]; then
    echo "  VERALTET — seit dem letzten STATUS.md-Update wurde committet."
    stale_any=1
  else
    echo "  aktuell."
  fi
  echo
done < <(grep '^|' "$SHARED_MD" | grep -v -- '^|---' | grep -v '| Projekt |')

if [ "$found_any" -eq 0 ]; then
  echo "keine Projekt-Zeilen in $SHARED_MD gefunden — Tabellenformat pruefen."
fi

if [ "$stale_any" -eq 1 ]; then
  echo "Ergebnis: mindestens ein Projekt hat einen frischeren Commit als seine STATUS.md."
else
  echo "Ergebnis: keine Veraltung gefunden (soweit lokal pruefbar)."
fi

exit 0
