def parse_skill_frontmatter(text):
    """Minimal YAML-frontmatter reader, only for the two keys we need: name, description.
    Handles a folded block scalar (`description: >-` followed by indented lines) the way our
    SKILL.md files actually use it, plus the plain one-line form."""
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 4)
    if end == -1:
        return {}
    block = text[4:end].splitlines()
    result = {}
    i = 0
    while i < len(block):
        line = block[i]
        m = re.match(r"^([a-zA-Z_]+):\s*(.*)$", line)
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        if val in (">-", ">", "|-", "|"):
            parts = []
            i += 1
            while i < len(block) and (block[i].startswith("  ") or block[i].strip() == ""):
                parts.append(block[i].strip())
                i += 1
            result[key] = " ".join(p for p in parts if p).strip()
            continue
        result[key] = val.strip('"').strip("'")
        i += 1
    return result


def discover_skills():
    skills = []
    if not os.path.isdir(SRC_SKILLS_DIR):
        return skills
    for name in sorted(os.listdir(SRC_SKILLS_DIR)):
        skill_dir = os.path.join(SRC_SKILLS_DIR, name)
        skill_md = os.path.join(skill_dir, "SKILL.md")
        if not os.path.isfile(skill_md):
            continue
        text = read_text(skill_md)
        meta = parse_skill_frontmatter(text)
        skills.append({
            "name": meta.get("name", name),
            "description": meta.get("description", "(keine description im Frontmatter gefunden)"),
            "dir": skill_dir,
            "skill_md_text": text,
        })
    return skills


def render_skills_index(skills):
    if not skills:
        return "(keine Skills unter ~/.claude/skills/ gefunden.)\n"
    lines = []
    for s in skills:
        lines.append("- **%s** -- `~/.agent-skills/%s/SKILL.md`" % (s["name"], s["name"]))
        lines.append("  %s" % s["description"])
    return "\n".join(lines) + "\n"


def snapshot_before_overwrite(path, day_tag):
    if not os.path.exists(path):
        return None
    snap_dir = os.path.join(SNAPSHOT_ROOT, "%s-wb-instructions" % day_tag)
    os.makedirs(snap_dir, exist_ok=True)
    dest = os.path.join(snap_dir, os.path.basename(path).lstrip(".") or "dotfile")
    # avoid collisions between same-named files from different harnesses
    base, ext = os.path.splitext(dest)
    n = 1
    while os.path.exists(dest):
        dest = "%s.%d%s" % (base, n, ext)
        n += 1
    shutil.copy2(path, dest)
    return dest


def sync_skills_mirror(dry_run, day_tag, report):
    skills = discover_skills()
    for s in skills:
        target_dir = os.path.join(AGENT_SKILLS_DIR, s["name"])
        target_md = os.path.join(target_dir, "SKILL.md")
        body = s["skill_md_text"]
        body_hash = sha256_text(body)
        marker = build_marker([SRC_SKILLS_DIR + "/" + s["name"] + "/SKILL.md"],
                               {SRC_SKILLS_DIR + "/" + s["name"] + "/SKILL.md": sha256_text(body)},
                               body_hash, now_generated_at_for(target_md, body_hash))
        full = marker + body
        status = write_generated(target_md, full, body_hash, dry_run, day_tag, force=False)
        report.append(("skill:%s" % s["name"], status, target_md))
        # accompanying files: verbatim mirror, no marker (scripts/binaries must stay byte-exact)
        for root, _dirs, files in os.walk(s["dir"]):
            for fn in files:
                if fn == "SKILL.md" and root == s["dir"]:
                    continue
                src_file = os.path.join(root, fn)
                rel = os.path.relpath(src_file, s["dir"])
                dst_file = os.path.join(target_dir, rel)
                with open(src_file, "rb") as f:
                    src_bytes = f.read()
                changed = True
                if os.path.exists(dst_file):
                    with open(dst_file, "rb") as f:
                        changed = f.read() != src_bytes
                if not changed:
                    report.append(("skill-asset:%s/%s" % (s["name"], rel), "unchanged", dst_file))
                    continue
                if dry_run:
                    report.append(("skill-asset:%s/%s" % (s["name"], rel), "would-write", dst_file))
                    continue
                os.makedirs(os.path.dirname(dst_file), exist_ok=True)
                snapshot_before_overwrite(dst_file, day_tag)
                with open(dst_file, "wb") as f:
                    f.write(src_bytes)
                report.append(("skill-asset:%s/%s" % (s["name"], rel), "written", dst_file))
    return skills


# ---------------------------------------------------------------------------
# Marker + conflict-safe writer for the 7 generated harness instruction files
# (and, reusing the same mechanism, the skill mirrors)
# ---------------------------------------------------------------------------

def build_marker(source_paths, source_hashes, content_hash, generated_at):
    lines = ["<!-- wb-instructions:generated"]
    lines.append("Quelle(n): " + " ".join(source_paths))
    lines.append("Zeitpunkt: " + generated_at)
    lines.append("SHA-256 Quelle(n): " + " ".join(
        "%s=%s" % (os.path.basename(p), source_hashes[p]) for p in source_paths))
    lines.append("SHA-256 Inhalt (nur der Text unterhalb dieser Marker-Zeilen): " + content_hash)
    lines.append("Erzeugt von: wb-instructions sync (%s)" % TOOL_SELF_PATH)
    lines.append(
        "WARNUNG: Handaenderungen unterhalb dieser Marker-Zeilen gehen beim naechsten "
        "\"wb-instructions sync\" verloren. Aenderungen gehoeren in die Quelle(n) oben, nicht hierhin."
    )
    lines.append("-->")
    return "\n".join(lines) + "\n"


def check_target(target_path):
    """Returns (status, body_on_disk_or_None). status in:
    'new' (file absent), 'clean' (marker present, hash matches -- safe to regenerate/compare),
    'conflict' (file exists but wasn't ours, or was hand-edited since)."""
    if not os.path.exists(target_path):
        return "new", None
    disk = read_text(target_path)
    m = MARKER_RE.match(disk)
    if not m:
        return "conflict", disk
    body_on_disk = disk[m.end():]
    hm = CONTENT_HASH_RE.search(m.group(0))
    if not hm:
        return "conflict", disk
    if hm.group(1) != sha256_text(body_on_disk):
        return "conflict", disk
    return "clean", body_on_disk


def now_generated_at_for(target_path, new_body_hash):
    """Idempotency: only advance the timestamp when the body actually changes. If the target
    already carries our marker with the SAME content hash, keep its old timestamp so re-running
    sync with unchanged sources produces a byte-identical file (true no-op)."""
    status, disk_body = check_target(target_path)
    if status == "clean" and os.path.exists(target_path):
        old_marker = MARKER_RE.match(read_text(target_path)).group(0)
        old_hash = CONTENT_HASH_RE.search(old_marker).group(1)
        if old_hash == new_body_hash:
            tm = re.search(r"Zeitpunkt: (.*)", old_marker)
            if tm:
                return tm.group(1).strip()
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


# Unteilbar (Auftrag 5, siehe atomar_schreiben.py): das ist die unangenehmste
# der drei Fundstellen, weil ein halb geschriebener Rollen-Prompt syntaktisch
# gueltiger Text bleibt -- eine Sitzung, die ihn in genau diesem Moment liest,
# faellt nicht mit einem Fehler auf, sie verhaelt sich nur schlechter, ohne
# dass irgendjemand den Grund sieht. modus=0o644: derselbe Wert, den ein
# gewoehnliches open(path,'w') unter dem hier ueblichen umask 022 ohnehin
# ergeben haette -- ohne ihn wuerden diese Dateien nach dem Umbau ploetzlich
# mit den engeren 0600 von tempfile.mkstemp dastehen, eine stille
# Rechte-Verschaerfung, die niemand gebeten hat.
def write_generated(target_path, full_content, body_hash, dry_run, day_tag, force):
    status, disk_body = check_target(target_path)
    if status == "new":
        if dry_run:
            return "new"
        atomar_schreiben.schreiben(target_path, full_content, modus=0o644)
        return "new"
    if status == "conflict":
        if not force:
            return "conflict"
        if dry_run:
            return "conflict-would-force"
        snapshot_before_overwrite(target_path, day_tag)
        atomar_schreiben.schreiben(target_path, full_content, modus=0o644)
        return "conflict-forced"
    # status == 'clean'
    if disk_body == full_content[len(MARKER_RE.match(full_content).group(0)):]:
        return "unchanged"
    if dry_run:
        return "would-update"
    snapshot_before_overwrite(target_path, day_tag)
    atomar_schreiben.schreiben(target_path, full_content, modus=0o644)
    return "updated"


