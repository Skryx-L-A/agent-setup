def hp(p):
    """expand a ~/-relative path against $HOME (not the process's real home, so tests that set
    HOME=$(mktemp -d) never touch the real files)."""
    if p.startswith("~/"):
        return os.path.join(HOME, p[2:])
    return os.path.expanduser(p)


