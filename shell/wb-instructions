def _apply_replacements_raw(text, harness):
    """The translation table (task requirement: a DATA table, not substitutions scattered
    through the code). Exactly the three minimum substitutions from the task, nothing more:
    1) /compact -> this harness's own compaction command (or an UNVERIFIED note).
    2) ~/.claude/skills/ -> ~/.agent-skills/ (the harness-neutral mirror).
    3) the self-referential Claude Code model id -> a pointer at the model registry.

    The search pattern for (1) is the WHOLE backtick-wrapped token `` `/compact` `` (backticks
    included), never the bare word -- the source always writes it as inline code. Replacing only
    the bare word left the source's own surrounding backticks in place and wrapped a SECOND pair
    of backticks (or a bracketed note that itself contains backticks) inside them, producing
    broken nested-backtick markdown (found in review 2026-07-28, M1). Matching the full token and
    replacing it outright avoids that: the replacement is either a single clean `` `cmd` `` span
    or a plain bracketed note with no backticks of its own.
    """
    if harness["compact"]:
        compact_repl = "`%s`" % harness["compact"]
    else:
        compact_repl = "[keine /compact-Entsprechung fuer %s -- %s]" % (harness["label"], harness["compact_note"])
    out = text.replace("`/compact`", compact_repl)
    out = out.replace("~/.claude/skills/", "~/.agent-skills/")
    out = out.replace("`claude-opus-5`", REGISTRY_HINT)
    return out


def apply_replacements(text, harness):
    """Wraps _apply_replacements_raw so the machine-generated routing-table block (between
    <!-- wb:routing-table:start/end -->, once CLAUDE.md/orchestrator.md have been synced) is
    passed through byte-for-byte. That block is DATA (model ids, table cells from `wb-state
    models table`), not prose -- substituting inside it broke the table structure and could
    rewrite a model id mid-cell (review 2026-07-28, M1). Everything outside the block still gets
    the normal translation."""
    m = ROUTING_BLOCK_RE.search(text)
    if m is None:
        return _apply_replacements_raw(text, harness)
    return (_apply_replacements_raw(text[:m.start()], harness)
            + text[m.start():m.end()]
            + _apply_replacements_raw(text[m.end():], harness))


def sha256_text(s):
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def read_text(path):
    with open(path, "r", encoding="utf-8") as f:
        return f.read()


