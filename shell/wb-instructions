        "Skill-Feature.\n\n"
        "%s"
        % (harness["label"], harness["label"],
           harness["compact"] or "(kein Kommando)", harness["compact_note"],
           extra,
           claude_text, orch_text, agent_text,
           harness["label"], skills_index)
    )


def read_regeln():
    """The rule files CLAUDE.md points at since the 2026-08-03 router rebuild.

    Claude Code reads them on demand, guided by the Verweisbaum. The other harnesses
    have no such mechanism -- they get ONE instruction file -- so without this they
    would silently end up with FEWER rules than before the rebuild. Bundling them is
    what keeps 'Kuerzen gilt als Loeschen' true for those harnesses too.
    """
    d = hp("~/.claude/regeln")
    if not os.path.isdir(d):
        return []
    out = []
    for fn in sorted(os.listdir(d)):
        if not fn.endswith(".md"):
            continue
        with open(os.path.join(d, fn), encoding="utf-8") as fh:
            out.append((fn, fh.read()))
    return out


def render_regeln_section(harness, regeln):
    if not regeln:
        return ""
    parts = [
        "\n\n## Teil 5 -- Ausgelagerte Regeln (Quelle: ~/.claude/regeln/)\n\n"
        "Claude Code laedt diese Dateien bei Bedarf ueber den Verweisbaum in Teil 1. %s hat\n"
        "keinen solchen Mechanismus, deshalb stehen sie hier vollstaendig. Sie gelten\n"
        "unveraendert -- der Ausloeser am Kopf jeder Datei sagt, wann die Regel greift.\n"
        % harness["label"]
    ]
    for fn, text in regeln:
        parts.append("\n### regeln/%s\n\n%s\n" % (fn, apply_replacements(text, harness)))
    return "".join(parts)


def sync_harness(harness, sources, source_hashes, skills_index, dry_run, day_tag, force):
    claude_t = apply_replacements(sources["claude"], harness)
    orch_t = apply_replacements(sources["orch"], harness)
    agent_t = apply_replacements(sources["agent"], harness)
    body = render_harness_body(harness, claude_t, orch_t, agent_t, skills_index)
    body += render_regeln_section(harness, read_regeln())
    body_hash = sha256_text(body)
    target = hp(harness["target"])
    generated_at = now_generated_at_for(target, body_hash)
    marker = build_marker([SRC_CLAUDE, SRC_ORCH, SRC_AGENT], source_hashes, body_hash, generated_at)
    full = marker + body
    status = write_generated(target, full, body_hash, dry_run, day_tag, force)
    return status, target, full


# ---------------------------------------------------------------------------
# Routing-table markers in the LIVE ~/.claude/CLAUDE.md and roles/orchestrator.md.
#
# HARD RULE (2026-07-28, after an incident: the first version of this function matched
# the EXISTING hand-curated table and *replaced* the matched span with the generated
# one -- losing the curated rows the moment a fill command became available): the two
# marker comment lines are ALWAYS inserted as an EMPTY block at a fixed anchor point.
# They never match against, wrap, or otherwise depend on any existing table text. The
# generated content that later goes *between* the markers is purely additive -- it is
# never allowed to consume or overwrite a single character outside that empty slot.
#
# Safety net on top of that: content between the markers only ever gets touched by this
# tool if it is either still empty, OR carries this tool's own inner
# "wb-instructions:generated SHA-256=..." tag with a hash that matches what follows it
# (i.e. we recognise it as our own previous output). Anything else between the markers
# -- including the ORIGINAL untagged output from the buggy first version of this
# function -- counts as foreign content and is refused exactly like a hand-edited
# target file: reported as a conflict, exit != 0, overridable with --force (snapshot
# taken first, same as everywhere else in this tool).
# ---------------------------------------------------------------------------

ROUTING_START = "<!-- wb:routing-table:start -->"
ROUTING_END = "<!-- wb:routing-table:end -->"
ROUTING_BLOCK_RE = re.compile(
    r"^([ \t]*)" + re.escape(ROUTING_START) + r"\n(.*?)^[ \t]*" + re.escape(ROUTING_END) + r"\n",
    re.S | re.M)
ROUTING_INNER_TAG_RE = re.compile(
    r"\A[ \t]*<!-- wb-instructions:generated SHA-256=([0-9a-f]{64}) -->\n(.*)\Z", re.S)


REPO_WB_STATE = "~/AI/claude-workbench/shell/wb-state"
INSTALLED_WB_STATE = "~/.local/bin/wb-state"


def check_wb_state_drift():
    """Review 2026-07-28 (H3): the routing table this tool writes comes from whichever
    `wb-state` resolves on PATH -- normally ~/.local/bin/wb-state -- which is a COPY of the repo
    file, not the file itself. If someone edits shell/wb-state and forgets to redeploy the copy,
    `wb-instructions sync` silently bakes an outdated table into every generated file without any
    signal that it happened. Returns a warning string, or None if both files exist and match (or
    either side is missing -- e.g. in an isolated test HOME, where this simply doesn't apply)."""
    installed, repo = hp(INSTALLED_WB_STATE), hp(REPO_WB_STATE)
    if not (os.path.isfile(installed) and os.path.isfile(repo)):
        return None
    with open(installed, "rb") as f:
        installed_bytes = f.read()
    with open(repo, "rb") as f:
        repo_bytes = f.read()
    if installed_bytes == repo_bytes:
        return None
    return (
        "WARNUNG: %s (installiert, das die Worker tatsaechlich benutzen) und %s (Repo) "
        "unterscheiden sich. Die Routing-Tabelle, die dieses \"sync\" gerade schreibt, kommt von "
        "`wb-state models table` ueber PATH -- also von der INSTALLIERTEN Version -- und kann "
        "damit von einer anderen Version stammen als die, gegen die claude-worker/pi-worker "
        "wirklich spawnen. Fix: `cp %s %s` und `wb-instructions sync` danach erneut ausfuehren."
        % (installed, repo, repo, installed)
    )


def fetch_routing_table_markdown():
    """Calls the fill command ONLY if it is actually on PATH and the `models table`
    subcommand actually works (SPEC-V3 B, built by a different worker). If it isn't
    there yet, returns None and the caller leaves the marker block's content untouched."""
    exe = shutil.which("wb-state")
    if not exe:
        return None, "wb-state nicht im PATH gefunden"
    try:
        r = subprocess.run([exe, "models", "table"], capture_output=True, text=True, timeout=15)
    except Exception as e:
        return None, "wb-state models table fehlgeschlagen: %s" % e
    if r.returncode != 0 or not r.stdout.strip():
        return None, "wb-state models table lieferte keinen Output (exit %d): %s" % (
            r.returncode, (r.stderr or "").strip()[:200])
    return r.stdout.rstrip("\n"), None


def routing_block_status(between_text):
    """'empty' (nothing there yet -- safe to fill), 'ours' (our own tagged output, hash
    matches -- safe to refresh), or 'foreign' (anything else -- never touch)."""
    if between_text.strip() == "":
        return "empty"
    m = ROUTING_INNER_TAG_RE.match(between_text)
    if m and m.group(1) == sha256_text(m.group(2)):
        return "ours"
    return "foreign"


def build_routing_fill(table_md, indent):
    """Empty string when there is nothing to fill with (fill command unavailable) --
    NOT the same as 'foreign': an empty desired state compares equal to an already-empty
    block, so a still-unavailable fill command keeps correctly reporting 'unchanged'."""
    if not table_md:
        return ""
    rows = "\n".join((indent + line) if line else line for line in table_md.splitlines()) + "\n"
    tag = "%s<!-- wb-instructions:generated SHA-256=%s -->\n" % (indent, sha256_text(rows))
    return tag + rows


def sync_routing_block(path, label, anchor_fn, table_md, table_err, dry_run, day_tag, force, report):
    text = read_text(path)
    m = ROUTING_BLOCK_RE.search(text)
    if m is None:
        # Phase A: pure insertion of an EMPTY block + a short note, at a FIXED anchor
        # point that never depends on any existing table. Nothing before/after the
        # anchor is touched.
        insert_at, note = anchor_fn(text)
        if insert_at is None:
            report.append(("routing-table:%s" % label, "anchor-not-found", path))
            return
        indent = "  "
        empty_block = "%s%s\n%s%s\n" % (indent, ROUTING_START, indent, ROUTING_END)
        insertion = "%s%s\n%s" % (indent, note, empty_block)
        if dry_run:
            report.append(("routing-table:%s" % label, "would-insert-empty-block", path))
            return
        snapshot_before_overwrite(path, day_tag)
        new_text = text[:insert_at] + insertion + text[insert_at:]
        # Unteilbar (Auftrag 5): 'path' ist hier CLAUDE.md oder
        # orchestrator.md -- gelesen bei jedem Sitzungsstart, dieselbe
        # Fundstelle wie write_generated() oben, nur im selben Atemzug
        # mitgefunden statt eigens gemeldet.
        atomar_schreiben.schreiben(path, new_text, modus=0o644)
        if not table_md:
            # nothing to fill yet -- report once, don't fall through to a no-op Phase B
            report.append(("routing-table:%s" % label,
                            "inserted-empty-block (Fuellbefehl: %s)" % table_err, path))
            return
        report.append(("routing-table:%s" % label, "inserted-empty-block", path))
        text, m = new_text, ROUTING_BLOCK_RE.search(new_text)

    # Phase B: only ever touch the text strictly BETWEEN the two marker lines.
    indent, between = m.group(1), m.group(2)
    status = routing_block_status(between)
    desired = build_routing_fill(table_md, indent)

    if status == "foreign" and not force:
        report.append(("routing-table:%s" % label, "conflict", path))
        return "conflict"
    if status != "foreign" and between == desired:
        report.append(("routing-table:%s" % label,
                        "unchanged" if not table_err else "unchanged (Fuellbefehl: %s)" % table_err,
                        path))
        return
    if dry_run:
        verb = "would-force-fill" if status == "foreign" else "would-fill"
        report.append(("routing-table:%s" % label,
                        verb if not table_err else "%s (Fuellbefehl: %s)" % (verb, table_err), path))
        return "conflict-would-force" if status == "foreign" else None

    snapshot_before_overwrite(path, day_tag)
    new_region = "%s%s\n%s%s%s\n" % (indent, ROUTING_START, desired, indent, ROUTING_END)
    new_text = text[:m.start()] + new_region + text[m.end():]
    atomar_schreiben.schreiben(path, new_text, modus=0o644)
    verb = "conflict-forced" if status == "foreign" else ("filled" if desired else "left-empty")
    report.append(("routing-table:%s" % label,
                    verb if not table_err else "%s (%s)" % (verb, table_err), path))


def claude_md_anchor(text):
    anchor = "- **Effort ist ein Knopf**"
    idx = text.find(anchor)
    if idx == -1:
        return None, None
    note = ("<!-- Dieser Block wird von \"wb-instructions sync\" automatisch gefuellt/aktualisiert "
            "-- die Routing-Tabelle OBEN bleibt Handarbeit und wird nie angefasst. -->")
    return idx, note


def orchestrator_md_anchor(text):
    anchor = "- Modellwahl (Tabelle und HARD CAPS: CLAUDE.md) — Begründungen und Zusätze:\n"
    idx = text.find(anchor)
    if idx == -1:
        return None, None
    note = "<!-- Dieser Block wird von \"wb-instructions sync\" automatisch gefuellt/aktualisiert. -->"
    return idx + len(anchor), note


def sync_routing_markers(dry_run, day_tag, force, report):
    table_md, table_err = fetch_routing_table_markdown()
    conflicts = 0
    # Only the ORCHESTRATOR role carries the generated table. Until 2026-08-03 it was
    # written into CLAUDE.md as well; an orchestrator loads both files, so the block --
    # 4.584 characters -- was paid for twice every session, and `sync` kept two copies
    # alive that could drift. CLAUDE.md now holds a one-line pointer instead. Whoever
    # re-adds SRC_CLAUDE here re-creates that duplication.
    for path, label, anchor_fn in (
        (SRC_ORCH, "orchestrator.md", orchestrator_md_anchor),
    ):
        result = sync_routing_block(path, label, anchor_fn, table_md, table_err,
                                     dry_run, day_tag, force, report)
        if result == "conflict":
            conflicts += 1
    return conflicts


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def cmd_sync(args):
    for p in (SRC_CLAUDE, SRC_ORCH, SRC_AGENT):
        if not os.path.isfile(p):
            print("wb-instructions: Quelle fehlt: %s" % p, file=sys.stderr)
            return 1
    if args.harness and args.harness not in HARNESS_BY_ID:
        print("wb-instructions: unbekannter Harness '%s'. Bekannt: %s"
              % (args.harness, ", ".join(HARNESS_BY_ID)), file=sys.stderr)
        return 1

    drift_warning = check_wb_state_drift()
    if drift_warning:
        print(drift_warning, file=sys.stderr)

    day_tag = datetime.date.today().isoformat()
    report = []
    conflicts = 0

    # Routing markers run FIRST and, when not a dry-run, mutate the live CLAUDE.md/orchestrator.md
    # in place. Reading the sources for the harness targets only AFTER this step is what makes a
    # single `sync` call self-consistent: harness copies always reflect the CURRENT CLAUDE.md
    # (markers included), so a second run has nothing left to change. Reading sources first would
    # make every harness target one run stale relative to the routing-marker insertion.
    conflicts += sync_routing_markers(args.dry_run, day_tag, args.force, report)

    sources = {"claude": read_text(SRC_CLAUDE), "orch": read_text(SRC_ORCH), "agent": read_text(SRC_AGENT)}
    source_hashes = {SRC_CLAUDE: sha256_text(sources["claude"]),
                      SRC_ORCH: sha256_text(sources["orch"]),
                      SRC_AGENT: sha256_text(sources["agent"])}
    skills = discover_skills()
    skills_index = render_skills_index(skills)
    targets = [HARNESS_BY_ID[args.harness]] if args.harness else HARNESSES
    for h in targets:
        status, target, full = sync_harness(h, sources, source_hashes, skills_index,
                                             args.dry_run, day_tag, args.force)
        report.append((h["id"], status, target))
        if status == "conflict":
            conflicts += 1
        if args.dry_run:
            old = read_text(target) if os.path.exists(target) else ""
            if old != full:
                import difflib
                diff = "".join(difflib.unified_diff(
                    old.splitlines(True), full.splitlines(True),
                    fromfile=target + " (aktuell)", tofile=target + " (neu)"))
                if diff:
                    print(diff)

    sync_skills_mirror(args.dry_run, day_tag, report)

    print("%-28s %-24s %s" % ("HARNESS/ZIEL", "STATUS", "DATEI"))
    for name, status, target in report:
        print("%-28s %-24s %s" % (name, status, target))

    if conflicts and not args.force:
        print("\n%d Zieldatei(en) von Hand geaendert -- NICHT ueberschrieben. "
              "Mit --force ueberschreiben (Sicherungskopie geht vorher nach %s-wb-instructions/)."
              % (conflicts, day_tag), file=sys.stderr)
        return 1
    return 0


def main():
    ap = argparse.ArgumentParser(prog="wb-instructions")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("sync", help="Regeln/Rollen/Skills fuer alle registrierten Harnesses generieren")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--harness", default=None)
    sp.add_argument("--force", action="store_true")
    args = ap.parse_args()
    if args.cmd == "sync":
        sys.exit(cmd_sync(args))


if __name__ == "__main__":
    main()
