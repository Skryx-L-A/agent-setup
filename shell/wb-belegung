def cmd_gib(a):
    halter = eigener_halter()
    if a.eigene and not halter.get("pane"):
        fehler("--eigene braucht einen eigenen tmux-Pane, sonst waere 'eigene' nicht von "
               "'alle ohne Pane' zu unterscheiden. Gib die Kennung an.")
    with Sperre():
        gueltige, _ = buch_pruefen(buch_lesen())
        bleiben, weg = [], []
        for e in gueltige:
            fremder_pane = (e.get("halter") or {}).get("pane", "")
            # Eine Belegung OHNE Pane gehoert niemandem nachweisbar — an ihr laesst
            # sich kein Eigentum messen, also verlangt ihre Freigabe auch keinen
            # Nachweis. Sonst waere eine ausserhalb tmux angelegte Belegung von
            # niemandem mehr regulaer freizugeben.
            eigen = (not fremder_pane) or (halter.get("pane") and fremder_pane == halter["pane"])
            treffer = (a.eigene and eigen) or (a.kennung and e.get("id") == a.kennung)
            if not treffer:
                bleiben.append(e)
                continue
            if not a.eigene and not eigen and not a.fremd:
                fehler("die Belegung %s gehoert %s, nicht Dir. Wenn Du sicher bist, dass "
                       "sie tot ist: --fremd." % (e.get("id"), halter_text(e)), code=1)
            weg.append(e)
        if not weg:
            print("wb-belegung: nichts freizugeben.", file=sys.stderr)
            return 1
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in bleiben])
    for e in weg:
        gib_aus("Freigegeben: %s (%s GiB, %s)" % (e.get("id"), zahl(e.get("gb", 0.0)),
                                                  e.get("zweck") or ""))
    return 0


def cmd_geladen(a):
    """Der Halter meldet, dass sein Modell jetzt wirklich im Speicher steht. Ab da
    sieht die Messung den Speicher selbst, und die Belegung wird nicht mehr zusaetzlich
    von Grenze A abgezogen."""
    halter = eigener_halter()
    if a.eigene and not halter.get("pane"):
        fehler("--eigene braucht einen eigenen tmux-Pane, sonst ist 'eigene' nicht von "
               "'alle ohne Pane' zu unterscheiden. Gib die Kennung an.")
    with Sperre():
        gueltige, _ = buch_pruefen(buch_lesen())
        getroffen = []
        for e in gueltige:
            eigen = (halter.get("pane") and
                     (e.get("halter") or {}).get("pane") == halter["pane"])
            if (a.eigene and eigen) or (a.kennung and e.get("id") == a.kennung):
                if e.get("realisiert"):
                    continue
                e["realisiert"] = True
                e["realisiert_iso"] = iso(jetzt())
                getroffen.append(e)
        if not getroffen:
            print("wb-belegung: keine ladende Belegung getroffen.", file=sys.stderr)
            return 1
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in gueltige])
    for e in getroffen:
        gib_aus("Als geladen gemeldet: %s (%s GiB, %s)"
                % (e.get("id"), zahl(e.get("gb", 0.0)), e.get("zweck") or ""))
    return 0


def cmd_verlaengern(a):
    pruefe_zahl(a.frist, "--frist", 0)
    with Sperre():
        gueltige, _ = buch_pruefen(buch_lesen())
        getroffen = None
        for e in gueltige:
            if e.get("id") == a.kennung:
                # Die Frist laeuft ab JETZT neu — genau das ist die Antwort des
                # Halters auf die Frage "brauchst Du das noch?".
                e["seit"] = jetzt()
                e["seit_iso"] = iso(jetzt())
                e["frist_s"] = int(a.frist) * 60
                getroffen = e
        if not getroffen:
            print("wb-belegung: keine Belegung mit der Kennung '%s'." % a.kennung, file=sys.stderr)
            return 1
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in gueltige])
    gib_aus("Verlaengert: %s, neue Frist %d min ab jetzt." % (a.kennung, int(a.frist)))
    return 0


def cmd_aufraeumen(a):
    with Sperre():
        gueltige, entfernt = buch_pruefen(buch_lesen())
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in gueltige])
    if a.json:
        print(json.dumps({"verfallen": [{"id": e.get("id"), "grund": e.get("_grund")}
                                        for e in entfernt],
                          "offen": len(gueltige)}, indent=2, ensure_ascii=False))
        return 0
    if not entfernt:
        gib_aus("Nichts verfallen; %d Belegung(en) offen." % len(gueltige))
    for e in entfernt:
        gib_aus("verfallen: %s (%s GiB, %s) — %s"
                % (e.get("id"), zahl(e.get("gb", 0.0)), halter_text(e), e.get("_grund")))
    return 0


def cmd_kv(a):
    if a.kv_befehl == "liste":
        modelle = kv_registry()
        if a.json:
            print(json.dumps(modelle, indent=2, ensure_ascii=False))
            return 0
        gib_aus("KV-Bedarf je Token (was ANGENOMMEN ist, traegt beim Rechnen den "
                "Sicherheitsfaktor %s):" % zahl(SICHERHEITSFAKTOR))
        for name in sorted(modelle):
            e = modelle[name]
            gib_aus("  %-24s %6s MiB/Token  %-11s %s"
                    % (name, zahl(e["mib_je_token"], 2), e.get("herkunft", "?"),
                       e.get("wann", "")))
            if e.get("notiz"):
                gib_aus("  %-24s %s" % ("", e["notiz"]))
        return 0
    # setzen
    if a.herkunft not in ("gemessen", "angenommen"):
        fehler("--herkunft muss 'gemessen' oder 'angenommen' sein.")
    if not a.modell.strip():
        fehler("ohne Modellnamen laesst sich kein KV-Bedarf eintragen.")
    # Eine Null oder eine negative Zahl steht danach DAUERHAFT im Buch und gilt fuer
    # jede kuenftige Anfrage zu diesem Modell. Gemessen im Pruefdurchgang vom 11.08.:
    # -2,0 wurde angenommen, und die naechste Anfrage rechnete eine Spitze von
    # -230 GiB und bekam ein Ja.
    a.mib = pruefe_zahl(a.mib, "der KV-Bedarf je Token", 0, strikt=True)
    with Sperre():
        daten = json_lesen(KV_DATEI, {"version": 1, "modelle": {}})
        daten.setdefault("modelle", {})
        daten["modelle"][a.modell.lower()] = {
            "mib_je_token": float(a.mib),
            "herkunft": a.herkunft,
            "wann": time.strftime("%Y-%m-%d"),
            "notiz": a.notiz or "",
        }
        atomar_schreiben(KV_DATEI, daten)
    gib_aus("Eingetragen: %s = %s MiB/Token (%s)." % (a.modell, zahl(a.mib, 2), a.herkunft))
    return 0


# ------------------------------------------------------------------ Aufruf

def rechen_argumente(p):
    p.add_argument("--gb", type=float, default=None,
                   help="die Spitze in GiB, selbst gerechnet (statt --gewichte-gb)")
    p.add_argument("--gewichte-gb", type=float, default=None,
                   help="Groesse der Modellgewichte in GiB")
    p.add_argument("--parallel", type=int, default=1,
                   help="gleichzeitige Anfragen (Vorgabe 1)")
    p.add_argument("--kontext", type=int, default=None,
                   help="Kontext-Token je Anfrage")
    p.add_argument("--modell", default="",
                   help="Modellname fuer den KV-Bedarf je Token")
    p.add_argument("--zuschlag-gb", type=float, default=ZUSCHLAG_GIB,
                   help="Zuschlag fuer Prompt-Cache und Spitzen (Vorgabe %s)" % ZUSCHLAG_GIB)
    p.add_argument("--reserve-gb", type=float, default=RESERVE_GIB,
                   help="was dem System bleibt (Vorgabe %s)" % RESERVE_GIB)
    p.add_argument("--abtastungen", type=int, default=ABTASTUNGEN,
                   help="Abtastungen des freien Speichers (Vorgabe %d)" % ABTASTUNGEN)
    p.add_argument("--abstand", type=float, default=ABSTAND_S,
                   help="Sekunden zwischen den Abtastungen (Vorgabe %s)" % ABSTAND_S)
    p.add_argument("--beruhigen", type=float, default=0.0,
                   help="Beruhigungsfrist in Sekunden vor der Messung")
    p.add_argument("--ohne-messung", action="store_true",
                   help="entscheidet ALLEIN nach den offenen Belegungen, wenn der freie "
                        "Speicher nicht messbar ist (sonst: Nein)")
    p.add_argument("--json", action="store_true")


def pruefe_rechnung(a):
    if a.gb is None and a.gewichte_gb is None:
        fehler("entweder --gb (Spitze selbst gerechnet) oder --gewichte-gb. "
               "Belegt wird die SPITZE, nicht das Gewicht.")
    if a.gb is not None and a.gewichte_gb is not None:
        fehler("--gb und --gewichte-gb zugleich ergeben zwei Spitzen. Eine davon.")
    if a.gewichte_gb is not None and a.kontext is None:
        fehler("--kontext fehlt. Die Spitze ist Gewichte + Anfragen x Kontext x "
               "KV-Bedarf je Token + Zuschlag; ohne Kontext waere sie geraten.")
    a.gb = pruefe_zahl(a.gb, "--gb", 0, strikt=True)
    a.gewichte_gb = pruefe_zahl(a.gewichte_gb, "--gewichte-gb", 0, strikt=True)
    # Der Zuschlag darf null sein (wer ihn ausdruecklich abwaehlt, weiss was er tut),
    # negativ nicht: er wuerde die Spitze verkleinern.
    a.zuschlag_gb = pruefe_zahl(a.zuschlag_gb, "--zuschlag-gb", 0)
    a.reserve_gb = pruefe_zahl(a.reserve_gb, "--reserve-gb", 0)
    a.abstand = pruefe_zahl(a.abstand, "--abstand", 0)
    a.beruhigen = pruefe_zahl(a.beruhigen, "--beruhigen", 0)
    pruefe_zahl(a.abtastungen, "--abtastungen", 1)
    if a.gewichte_gb is not None:
        # Mindestens eine Anfrage mit mindestens einem Token: alles darunter macht den
        # KV-Anteil zu null, und dann steht wieder nur das Gewicht in der Belegung.
        pruefe_zahl(a.parallel, "--parallel", 1)
        pruefe_zahl(a.kontext, "--kontext", 1)
    if a.kontext is None:
        a.kontext = 0


def main(argv):
    p = argparse.ArgumentParser(
        prog="wb-belegung",
        description="Belegungsbuch fuer grosse Ressourcen: darf ich, wer haelt, wieder frei.")
    sub = p.add_subparsers(dest="befehl")

    p_darf = sub.add_parser("darf", help="nur fragen, nichts eintragen")
    rechen_argumente(p_darf)

    p_nimm = sub.add_parser("nimm", help="fragen und eintragen, unter einer Sperre")
    rechen_argumente(p_nimm)
    p_nimm.add_argument("--zweck", default="", help="wofuer (Pflicht)")
    p_nimm.add_argument("--halter", default="", help="zusaetzliches Etikett fuer den Halter")
    p_nimm.add_argument("--frist", type=int, default=FRIST_MIN,
                        help="Frist in Minuten (Vorgabe %d)" % FRIST_MIN)
    p_nimm.add_argument("--karenz", type=int, default=KARENZ_MIN,
                        help="Karenz nach der Frist, nur ohne Pane wirksam (Vorgabe %d)" % KARENZ_MIN)

    p_wer = sub.add_parser("wer", help="wer haelt gerade was, seit wann")
    p_wer.add_argument("--json", action="store_true")

    p_gib = sub.add_parser("gib", help="eine Belegung freigeben")
    p_gib.add_argument("kennung", nargs="?", default="")
    p_gib.add_argument("--eigene", action="store_true", help="alle Belegungen dieses Panes")
    p_gib.add_argument("--fremd", action="store_true", help="eine fremde Belegung freigeben")

    p_gel = sub.add_parser("geladen", help="melden, dass das Modell jetzt im Speicher steht")
    p_gel.add_argument("kennung", nargs="?", default="")
    p_gel.add_argument("--eigene", action="store_true", help="alle Belegungen dieses Panes")

    p_verl = sub.add_parser("verlaengern", help="die Frist einer Belegung neu setzen")
    p_verl.add_argument("kennung")
    p_verl.add_argument("--frist", type=int, default=FRIST_MIN)

    p_auf = sub.add_parser("aufraeumen", help="Verfallenes entfernen")
    p_auf.add_argument("--json", action="store_true")

    p_kv = sub.add_parser("kv", help="der KV-Bedarf je Token, je Modell, mit Herkunft")
    kvsub = p_kv.add_subparsers(dest="kv_befehl")
    p_kvl = kvsub.add_parser("liste")
    p_kvl.add_argument("--json", action="store_true")
    p_kvs = kvsub.add_parser("setzen")
    p_kvs.add_argument("modell")
    p_kvs.add_argument("mib", type=float)
    p_kvs.add_argument("--herkunft", required=True, choices=("gemessen", "angenommen"))
    p_kvs.add_argument("--notiz", default="")
    p_kvs.add_argument("--json", action="store_true")

    a = p.parse_args(argv)
    if not a.befehl:
        p.print_help()
        return 2

    os.makedirs(STATE_DIR, exist_ok=True)

    if a.befehl == "darf":
        pruefe_rechnung(a)
        return cmd_darf(a)
    if a.befehl == "nimm":
        pruefe_rechnung(a)
        return cmd_nimm(a)
    if a.befehl == "wer":
        return cmd_wer(a)
    if a.befehl == "gib":
        if not a.kennung and not a.eigene:
            fehler("wb-belegung gib <kennung> — oder --eigene.")
        return cmd_gib(a)
    if a.befehl == "geladen":
        if not a.kennung and not a.eigene:
            fehler("wb-belegung geladen <kennung> — oder --eigene.")
        return cmd_geladen(a)
    if a.befehl == "verlaengern":
        return cmd_verlaengern(a)
    if a.befehl == "aufraeumen":
        return cmd_aufraeumen(a)
    if a.befehl == "kv":
        if not getattr(a, "kv_befehl", ""):
            p_kv.print_help()
            return 2
        if not hasattr(a, "json"):
            a.json = False
        return cmd_kv(a)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
