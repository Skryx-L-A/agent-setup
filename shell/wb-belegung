def prozess_lstart(pid):
    """Der exakte `ps -o lstart=`-Wert einer PID, oder leer, wenn sie nicht
    (mehr) existiert. LC_ALL=C (nicht die Login-Locale) ist Absicht, nicht
    Zufall: derselbe Wert muss bei 'geladen' (Registrierung) und bei jeder
    spaeteren Pruefung dieselbe Zeichenkette liefern, egal unter welcher
    LC_TIME gerade gelaufen wird -- exakt dieselbe Festlegung wie shell/
    wb-nohup und shell/wb-waisen fuer denselben Zweck (siehe dort, 'PID-
    WIEDERVERWENDUNG')."""
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    try:
        p = subprocess.run(["ps", "-o", "lstart=", "-p", str(int(pid))],
                            capture_output=True, text=True, timeout=3, env=env)
    except (subprocess.TimeoutExpired, OSError, ValueError, TypeError):
        return ""
    return p.stdout.strip()


def prozess_lebt(pid, lstart_pruefwert):
    """True/False/None. None heisst 'nicht pruefbar' (keine PID oder kein
    gespeicherter Pruefwert) -- das ist ausdruecklich KEIN Urteil, ein
    Aufrufer darf None nie als 'tot' lesen. Der eigentliche Vergleich ist
    derselbe wie in shell/wb-waisen: eine PID allein beweist nichts, sie
    kann laengst zu einem ganz anderen Prozess gehoeren (PID-Wiederverwendung,
    'lade_eigentuemer' dort) -- erst der exakte Startzeitpunkt bestaetigt,
    dass es wirklich noch derselbe Prozess ist."""
    if not pid or not lstart_pruefwert:
        return None
    jetzt = prozess_lstart(pid)
    return bool(jetzt) and jetzt == lstart_pruefwert


def prozess_tot(eintrag):
    """True nur fuer eine REALISIERTE Belegung mit einer eingetragenen PID,
    deren Prozess nachweislich nicht mehr derselbe ist (siehe prozess_lebt).

    'laedt noch' (realisiert=False) bleibt IMMER unangetastet -- waehrend ein
    Server gerade startet, laeuft er zu Recht noch nicht und hat trotzdem eine
    gueltige Buchung (Auftrag 2026-08-21 abends, Punkt 3: genau dieser Zustand
    trat bei jedem Fehlversuch der Kernel-Panik-Nacht auf; ihn als 'tot'
    einzustufen wuerde einem startenden Server die Buchung unter den Fuessen
    wegraeumen). Eine Belegung ohne PID (die meisten -- z. B. pi-workers
    'eigene Sequenz', gebunden an einen tmux-Pane, nicht an eine Server-PID)
    bleibt ebenso unangetastet: fuer sie gilt weiterhin ausschliesslich die
    Pane-Lebendigkeit (zustand_bestimmen unten), die eigentliche Frage dieser
    Funktion stellt sich fuer sie gar nicht."""
    if not eintrag.get("realisiert"):
        return False
    pid = eintrag.get("prozess_pid")
    if not pid:
        return False
    return prozess_lebt(pid, eintrag.get("prozess_lstart") or "") is False


def zustand_bestimmen(eintrag, panes_je_socket):
    """'offen' | 'ueberfaellig' | 'tot' | 'verfallen', plus ein Satz zur Begruendung.

    Das HARTE Kriterium ist der Pane. Die Frist ist die Warnung davor: sie macht
    eine Belegung ueberfaellig, sie raeumt sie nie ab. Nur ohne messbaren Pane
    entscheidet Frist + Karenz, sonst koennte eine vergessene Belegung die Maschine
    dauerhaft sperren.

    'tot' ist ein VIERTER, eigener Zustand (Nachtrag "Karteileiche", 2026-08-21
    abends): eine Belegung mit eingetragener PID, deren Prozess nachweislich
    nicht mehr laeuft (siehe prozess_tot) -- gemessen an einem MLX-Server, der
    ohne Abschiedszeile starb, waehrend seine Buchung drei Stunden lang
    unbeirrt als 'geladen' weiterlief und jede Vergabe (wb-belegung darf/nimm)
    um ihre volle Groesse belastete. Bewusst NICHT wie 'verfallen' behandelt:
    eine Anzeige, die Dinge von selbst verschwinden laesst, ist schwerer zu
    verstehen als eine, die sagt, was sie sieht (Vorgabe des Nutzers) -- 'tot'
    bleibt deshalb in der gueltigen Liste sichtbar (buch_pruefen raeumt es
    NICHT weg, nur 'wb-belegung aufraeumen' tut das explizit), zaehlt aber
    nirgends mehr in die Vergabe (siehe entscheiden()). PANE-Verfallenheit
    wird weiterhin ZUERST geprueft und gewinnt, wenn beides zutrifft -- sie
    entfernt ohnehin vollstaendig, ein zusaetzliches 'tot'-Etikett auf einem
    bereits verschwindenden Eintrag waere ueberfluessig."""
    alter = jetzt() - float(eintrag.get("seit", 0))
    frist = float(eintrag.get("frist_s", FRIST_MIN * 60))
    karenz = float(eintrag.get("karenz_s", KARENZ_MIN * 60))
    halter = eintrag.get("halter") or {}
    pane = halter.get("pane", "")
    if pane:
        socket = halter.get("socket", "")
        if socket not in panes_je_socket:
            panes_je_socket[socket] = panes_des_servers(socket)
        lage, karte = panes_je_socket[socket]
        if lage == "kein-server":
            return "verfallen", "der tmux-Server des Halters ist fort"
        if lage == "ok" and (pane not in karte or karte[pane]):
            return "verfallen", "der Pane %s des Halters lebt nicht mehr" % pane
        if lage == "unklar" and alter > frist + karenz:
            return "verfallen", ("die Lebendigkeit des Panes ist nicht messbar und "
                                 "Frist samt Karenz sind seit %d min um"
                                 % minuten(alter - frist - karenz))
    else:
        if alter > frist + karenz:
            return "verfallen", ("kein Pane als Halter, und Frist samt Karenz sind "
                                 "seit %d min um" % minuten(alter - frist - karenz))
    if prozess_tot(eintrag):
        return "tot", ("Prozess (PID %s) laeuft nicht mehr -- die Belegung meldete "
                       "'geladen', ihr Prozess ist aber nachweislich nicht mehr derselbe "
                       "(neu gestartet, abgestuerzt, oder die PID laengst wiederverwendet)"
                       % eintrag.get("prozess_pid"))
    if alter > frist:
        return "ueberfaellig", "die Frist ist seit %d min um" % minuten(alter - frist)
    return "offen", ""


def buch_pruefen(belegungen):
    """(gueltige, entfernte). Bewertet jede Belegung genau einmal und haengt ihren
    Zustand an — der Rest des Programms misst danach nicht noch einmal nach.

    'tot' bleibt bewusst in 'gueltige' (nicht 'entfernte') -- siehe
    zustand_bestimmen(): sichtbar in wb-belegung wer, aber ausgeschlossen von
    der Vergabe (entscheiden()); entfernt wird ein toter Eintrag ausschliesslich
    durch 'wb-belegung aufraeumen'."""
    panes_je_socket = {}
    gueltig, entfernt = [], []
    for eintrag in belegungen:
        if not isinstance(eintrag, dict):
            continue
        zustand, grund = zustand_bestimmen(eintrag, panes_je_socket)
        eintrag = dict(eintrag)
        eintrag["_zustand"] = zustand
        eintrag["_grund"] = grund
        if zustand == "verfallen":
            entfernt.append(eintrag)
        else:
            gueltig.append(eintrag)
    return gueltig, entfernt


def halter_text(eintrag):
    h = eintrag.get("halter") or {}
    teile = [t for t in (h.get("sitzung", ""), h.get("pane", "")) if t]
    if h.get("worker"):
        teile.append("Worker '%s'" % h["worker"])
    if h.get("etikett"):
        teile.append("'%s'" % h["etikett"])
    if not teile:
        teile.append("ohne Pane, Host %s" % h.get("host", "?"))
    return " ".join(teile)


def belegungen_zeigen(gueltige):
    """Die Antwort auf 'wer haelt gerade was' — und dieselbe Liste, die ein
    abgelehnter Frager zu sehen bekommt, damit er den Halter ansprechen kann statt
    blind zu warten."""
    if not gueltige:
        gib_aus("  Keine offene Belegung.")
        return
    for e in gueltige:
        alter = minuten(jetzt() - float(e.get("seit", 0)))
        frist = float(e.get("frist_s", FRIST_MIN * 60))
        rest = minuten(float(e.get("seit", 0)) + frist - jetzt())
        status = "geladen" if e.get("realisiert") else "laedt noch"
        if e.get("_zustand") == "tot":
            status = "TOT"
        gib_aus("  %-8s %8s GiB  %-12s %s"
                % (e.get("id", "?"), zahl(e.get("gb", 0.0)), status, halter_text(e)))
        gib_aus("           Zweck: %s" % (e.get("zweck") or "(nicht genannt)"))
        # Nachtrag 2026-08-21, zweiter Pruefpass: kv_ersatzwert stand bisher NUR in
        # 'rechnung' (JSON) -- der eigene Kommentar bei cmd_nimm behauptete, das mache
        # es "sichtbar auch im Buch", aber diese Funktion, die das Buch im Klartext
        # zeigt, las das Feld nie. Wer 'wb-belegung wer' ohne --json liest, sah also
        # nichts vom geratenen KV-Wert. Kurz gehalten (der volle Klartext steht nur in
        # der Direktantwort von darf/nimm) -- Modellname und der eine Handgriff, der
        # es behebt, reichen, um die Zeile ohne Nachschlagen zu verstehen.
        if (e.get("rechnung") or {}).get("kv_ersatzwert"):
            gib_aus("           KV-WERT GERATEN: kein Eintrag fuer '%s' in kv-bedarf.json "
                    "getroffen -- gerechnet mit dem Ersatzwert des hungrigsten gemessenen "
                    "Modells. Messen und eintragen: wb-belegung kv setzen %s <mib-je-token> "
                    "--herkunft gemessen"
                    % (e.get("modell") or "?", e.get("modell") or "<modell>"))
        if e.get("auf_eigene_gefahr"):
            gib_aus("           AUF EIGENE GEFAHR eingetragen — diese Belegung ist NICHT durch")
            gib_aus("           die Pruefung gekommen, ein Mensch hat sie ausdruecklich gewollt.")
        if e.get("_zustand") == "tot":
            # TOT zaehlt nicht mehr in die Vergabe (entscheiden()), bleibt aber
            # sichtbar stehen, bis 'wb-belegung aufraeumen' sie wirklich entfernt --
            # eine Anzeige, die von selbst Dinge verschwinden laesst, ist schwerer
            # zu verstehen als eine, die sagt, was sie sieht.
            gib_aus("           %s -- zaehlt NICHT mehr in die Vergabe, aufraeumen um sie zu entfernen"
                    % e.get("_grund", ""))
        elif e.get("_zustand") == "ueberfaellig":
            h = e.get("halter") or {}
            gib_aus("           seit %d min, UEBERFAELLIG (%s)" % (alter, e.get("_grund", "")))
            if h.get("sitzung"):
                gib_aus("           Halter fragen: wb-post schreiben %s 'brauchst Du die "
                        "%s GiB noch?'" % (h["sitzung"], zahl(e.get("gb", 0.0))))
        else:
            gib_aus("           seit %d min, Frist laeuft in %d min ab" % (alter, rest))


