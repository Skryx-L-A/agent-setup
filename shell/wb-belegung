def fehler(text, code=2):
    print("wb-belegung: " + text, file=sys.stderr)
    sys.exit(code)


def zahl(wert, stellen=1):
    """Deutsche Schreibweise, Komma statt Punkt — die Ausgabe liest ein Mensch.

    Was sich nicht formatieren laesst, wird gezeigt, wie es dasteht. Eine Anzeige
    darf nie der Grund sein, warum ein Werkzeug abbricht: genau daran ist das
    Entfernen eines unbrauchbaren Buch-Eintrags gescheitert, also die eine Handlung,
    die den Zustand wieder in Ordnung bringt."""
    try:
        return ("%.*f" % (stellen, float(wert))).replace(".", ",")
    except (TypeError, ValueError):
        return "%s" % (wert,)


