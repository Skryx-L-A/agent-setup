def zustand_bestimmen(eintrag, panes_je_socket):
    """'offen' | 'ueberfaellig' | 'verfallen', plus ein Satz zur Begruendung.

    Das HARTE Kriterium ist der Pane. Die Frist ist die Warnung davor: sie macht
    eine Belegung ueberfaellig, sie raeumt sie nie ab. Nur ohne messbaren Pane
    entscheidet Frist + Karenz, sonst koennte eine vergessene Belegung die Maschine
    dauerhaft sperren."""
    alter = jetzt() - float(eintrag.get("seit", 0))
    frist = float(eintrag.get("frist_s", FRIST_MIN * 60))
    karenz = float(eintrag.get("karenz_s", KARENZ_MIN * 60))
    halter = eintrag.get("halter") or {}
    pane = halter.get("pane", "")
    if pane:
        socket = halter.get("socket", "")
        if socket not in panes_je_socket:
            panes_je_socket[socket] = panes_des_servers(socket)
        lage, karte = panes_je_socket[socket]
        if lage == "kein-server":
            return "verfallen", "der tmux-Server des Halters ist fort"
        if lage == "ok" and (pane not in karte or karte[pane]):
            return "verfallen", "der Pane %s des Halters lebt nicht mehr" % pane
        if lage == "unklar" and alter > frist + karenz:
            return "verfallen", ("die Lebendigkeit des Panes ist nicht messbar und "
                                 "Frist samt Karenz sind seit %d min um"
                                 % minuten(alter - frist - karenz))
    else:
        if alter > frist + karenz:
            return "verfallen", ("kein Pane als Halter, und Frist samt Karenz sind "
                                 "seit %d min um" % minuten(alter - frist - karenz))
    if alter > frist:
        return "ueberfaellig", "die Frist ist seit %d min um" % minuten(alter - frist)
    return "offen", ""


def buch_pruefen(belegungen):
    """(gueltige, entfernte). Bewertet jede Belegung genau einmal und haengt ihren
    Zustand an — der Rest des Programms misst danach nicht noch einmal nach."""
    panes_je_socket = {}
    gueltig, entfernt = [], []
    for eintrag in belegungen:
        if not isinstance(eintrag, dict):
            continue
        zustand, grund = zustand_bestimmen(eintrag, panes_je_socket)
        eintrag = dict(eintrag)
        eintrag["_zustand"] = zustand
        eintrag["_grund"] = grund
        if zustand == "verfallen":
            entfernt.append(eintrag)
        else:
            gueltig.append(eintrag)
    return gueltig, entfernt


def halter_text(eintrag):
    h = eintrag.get("halter") or {}
    teile = [t for t in (h.get("sitzung", ""), h.get("pane", "")) if t]
    if h.get("worker"):
        teile.append("Worker '%s'" % h["worker"])
    if h.get("etikett"):
        teile.append("'%s'" % h["etikett"])
    if not teile:
        teile.append("ohne Pane, Host %s" % h.get("host", "?"))
    return " ".join(teile)


def belegungen_zeigen(gueltige):
    """Die Antwort auf 'wer haelt gerade was' — und dieselbe Liste, die ein
    abgelehnter Frager zu sehen bekommt, damit er den Halter ansprechen kann statt
    blind zu warten."""
    if not gueltige:
        gib_aus("  Keine offene Belegung.")
        return
    for e in gueltige:
        alter = minuten(jetzt() - float(e.get("seit", 0)))
        frist = float(e.get("frist_s", FRIST_MIN * 60))
        rest = minuten(float(e.get("seit", 0)) + frist - jetzt())
        gib_aus("  %-8s %8s GiB  %-12s %s"
                % (e.get("id", "?"), zahl(e.get("gb", 0.0)),
                   "geladen" if e.get("realisiert") else "laedt noch", halter_text(e)))
        gib_aus("           Zweck: %s" % (e.get("zweck") or "(nicht genannt)"))
        if e.get("_zustand") == "ueberfaellig":
            h = e.get("halter") or {}
            gib_aus("           seit %d min, UEBERFAELLIG (%s)" % (alter, e.get("_grund", "")))
            if h.get("sitzung"):
                gib_aus("           Halter fragen: wb-post schreiben %s 'brauchst Du die "
                        "%s GiB noch?'" % (h["sitzung"], zahl(e.get("gb", 0.0))))
        else:
            gib_aus("           seit %d min, Frist laeuft in %d min ab" % (alter, rest))


# ----------------------------------------------------------- die Rechnung

def spitze_rechnen(a):
    """Die Spitze, nicht das Gewicht. Rueckgabe: (gb, zeilen, kv_herkunft)."""
    if a.gb is not None:
        return float(a.gb), ["  Spitze     %s GiB (selbst genannt, hier nicht nachgerechnet)"
                             % zahl(a.gb)], "keine (Spitze selbst genannt)"
    # Ohne max(0, …): die Werte sind in pruefe_rechnung() geprueft, und ein Klemmen
    # wuerde eine unsinnige Angabe wieder in eine stille Null verwandeln.
    gewichte = float(a.gewichte_gb)
    parallel = int(a.parallel)
    kontext = int(a.kontext)
    zuschlag = float(a.zuschlag_gb)
    kv_mib, herkunft, _roh, _gemessen = kv_fuer(a.modell)
    kv_gib = parallel * kontext * kv_mib / MIB_JE_GIB
    spitze = gewichte + kv_gib + zuschlag
    zeilen = [
        "  Spitze     %s GiB = Gewichte %s + KV-Cache %s + Zuschlag %s"
        % (zahl(spitze), zahl(gewichte), zahl(kv_gib), zahl(zuschlag)),
        "  KV-Cache   %d Anfragen x %d Token x %s MiB/Token"
        % (parallel, kontext, zahl(kv_mib, 2)),
        "             %s" % herkunft,
    ]
    if "ANGENOMMEN" in herkunft:
        zeilen.append("             einmal messen und eintragen: wb-belegung kv setzen "
                      "%s <mib-je-token> --herkunft gemessen" % (a.modell or "<modell>"))
    return spitze, zeilen, herkunft


def nicht_geladen(gueltige):
    """Die Summe der Belegungen, deren Modell noch NICHT im Speicher ist.

    Befund 2 des Pruefdurchgangs vom 11.08.: Grenze B zieht vom Gesamtspeicher nur
    Reserve und Belegungen ab, nie die Grundlast der Maschine — auf diesem Mac gerade
    18 GiB (30681 von 49152 MiB frei). Grenze A kannte die Grundlast, sah aber ein
    ladendes Modell nicht. Zwei aufeinanderfolgende Anfragen im Ladefenster kamen so
    beide durch und ergaben zusammen mehr, als die Maschine hat; zwei GLEICHZEITIGE
    Anfragen braucht es dafuer nicht einmal, die Sperre schuetzt nur die Buchfuehrung.

    Wer nach dem Laden `wb-belegung geladen <kennung>` meldet, gibt den Betrag aus
    dieser Summe frei — der Speicher steht dann ja in der Messung. Wer es VERGISST,
    rechnet doppelt und bekommt zu frueh ein Nein: die harmlose Richtung, und sie
    faellt auf, weil `wer` jede Belegung als „laedt noch" ausweist."""
    return sum(float(e.get("gb", 0.0)) for e in gueltige if not e.get("realisiert"))


def entscheiden(spitze_gb, gueltige, messung, reserve_gib, ohne_messung=False):
    """Zwei Grenzen, die kleinere gewinnt. Sie werden nicht addiert (das zaehlte ein
    fertig geladenes Modell doppelt) und nicht gegeneinander abgewogen.

    EIN NICHT MESSBARER FREIER SPEICHER IST EIN NEIN (Befund 1 des Pruefdurchgangs
    vom 11.08.). Vorher stand hier `verfuegbar = None` und eine Zeile weiter
    `ja = (verfuegbar is None) or …` — damit sagte das Buch zu ALLEM ja, auch zu
    200 GiB bei 44 GiB offener Belegung, und die Ausgabe behauptete dabei, es werde
    nach den offenen Belegungen entschieden. Entschieden wurde nach nichts. Der Weg
    dorthin ist kein Gedankenspiel: unter dem nackten launchd-PATH fehlt /usr/sbin,
    `check-resources` findet sein `sysctl` nicht und bricht mit Exit 127 ab — ein
    Modellstart aus einem launchd-Job bekam also immer ein Ja.

    Mit `--ohne-messung` wird ausdruecklich allein nach Grenze B entschieden. Dann
    stimmt der Satz „entschieden wird allein nach den offenen Belegungen" auch, und
    er steht unter dem Vorbehalt, dass niemand ungebucht Speicher haelt.

    OLLAMA (Nachtrag 16.08.): Grenze A sieht eine Ollama-Ladung automatisch, weil
    ihr Verbrauch den GEMESSENEN freien Speicher senkt -- sie hier zusaetzlich
    abzuziehen waere dieselbe Doppelzaehlung, vor der oben bei den eigenen
    Belegungen gewarnt wird. Grenze B sieht dagegen nichts ausserhalb des Buches;
    deshalb, und nur deshalb, zaehlt eine STABILE Ollama-Ladung hier mit rein
    (siehe OLLAMA_STABIL_SCHWELLE_S). Fluechtige Ladungen und ein 'unbekannter'
    Ollama-Zustand zaehlen mit 0,0 GiB -- sonst waere die Vergabe haerter als vor
    diesem Umbau, und genau das soll sie nicht sein.

    Rueckgabe: (ja, verfuegbar, offen, grenze_a, grenze_b, grund)."""
    offen = sum(float(e.get("gb", 0.0)) for e in gueltige) + ollama_stabile_summe(messung)
    if not messung["messbar"]:
        if not ohne_messung:
            return (False, None, offen, None, None,
                    "der freie Speicher ist NICHT MESSBAR (%s). Ein Ja waere geraten, "
                    "und geraten wird hier nicht." % messung["quelle"])
        if not messung.get("gesamt_bekannt"):
            return (False, None, offen, None, None,
                    "weder der freie noch der Gesamtspeicher sind messbar — auch "
                    "--ohne-messung hat dann nichts, worauf es sich stuetzen koennte.")
        grenze_b = messung["gesamt_gib"] - reserve_gib - offen
        return (spitze_gb <= grenze_b, grenze_b, offen, None, grenze_b,
                "" if spitze_gb <= grenze_b else "")
    grenze_b = messung["gesamt_gib"] - reserve_gib - offen
    # Grenze A minus dem, was belegt, aber noch nicht im Speicher ist. Der gemessene
    # freie Speicher sieht ein ladendes Modell noch nicht — wer nur gegen ihn prueft,
    # vergibt denselben Speicher zweimal, solange das Ladefenster offen ist.
    grenze_a = messung["frei_gib"] - reserve_gib - nicht_geladen(gueltige)
    verfuegbar = min(grenze_a, grenze_b)
    return spitze_gb <= verfuegbar, verfuegbar, offen, grenze_a, grenze_b, ""


def entscheidung_zeigen(spitze_gb, zeilen, gueltige, messung, reserve_gib,
                        ja, verfuegbar, offen, grenze_a, grenze_b, grund=""):
    for z in zeilen:
        gib_aus(z)
    if messung["messbar"]:
        gib_aus("  Frei       %s GiB gemessen (%s)" % (zahl(messung["frei_gib"]), messung["verfahren"]))
        laedt = nicht_geladen(gueltige)
        gib_aus("  Grenze A   %s GiB = %s frei - %s Reserve - %s belegt, aber noch nicht geladen"
                % (zahl(grenze_a), zahl(messung["frei_gib"]), zahl(reserve_gib), zahl(laedt)))
        gib_aus("  Grenze B   %s GiB = %s gesamt - %s Reserve - %s offen belegt "
                "(Buch + stabile Ollama-Ladungen)"
                % (zahl(grenze_b), zahl(messung["gesamt_gib"]), zahl(reserve_gib), zahl(offen)))
        gib_aus("  Verfuegbar %s GiB (die kleinere der beiden)" % zahl(verfuegbar))
    else:
        gib_aus("  Frei       NICHT MESSBAR (%s)" % messung["quelle"])
        if grenze_b is not None:
            gib_aus("  Grenze B   %s GiB = %s gesamt - %s Reserve - %s offen belegt "
                    "(Buch + stabile Ollama-Ladungen)"
                    % (zahl(grenze_b), zahl(messung["gesamt_gib"]), zahl(reserve_gib), zahl(offen)))
            gib_aus("  Verfuegbar %s GiB — allein aus den offenen Belegungen (--ohne-messung)."
                    % zahl(grenze_b))
            gib_aus("             Was jemand OHNE Belegung UND OHNE Ollama haelt, sieht diese "
                    "Rechnung nicht.")
        else:
            gib_aus("  Offen      %s GiB belegt" % zahl(offen))
    if grund:
        gib_aus()
        gib_aus("  NEIN: %s" % grund)
        gib_aus("  Wer trotzdem entscheiden muss, nimmt --ohne-messung; dann zaehlt allein,")
        gib_aus("  was im Buch steht.")
    gib_aus()
    gib_aus("  Offene Belegungen:")
    belegungen_zeigen(gueltige)
    gib_aus()
    for z in ollama_zeigen(messung):
        gib_aus(z)


def absage_erklaeren(ja, gueltige, messung, grund=""):
    """Wer ein Nein bekommt, soll wissen, WORAN es lag — an einem anderen Halter,
    an Ollama, an der Maschine selbst, oder daran, dass gar nicht gemessen werden
    konnte. Das sind verschiedene naechste Schritte."""
    if ja:
        return
    if grund:
        return      # der Grund steht bereits im Klartext ueber dieser Stelle
    ollama_status, ollama_eintraege, _grund = messung.get("ollama", ("unbekannt", [], ""))
    ollama_zaehlt = ollama_status == "ladungen" and any(
        e["stabil"] for e in ollama_bewerten(ollama_eintraege))
    gib_aus()
    if gueltige:
        gib_aus("  Sprich den Halter an, statt blind zu warten — die Zeile dafuer steht")
        gib_aus("  oben bei seiner Belegung.")
    elif ollama_zaehlt:
        gib_aus("  Im Buch haelt niemand etwas, aber Ollama tut es — siehe die Ollama-Zeilen")
        gib_aus("  oben. Dort steht kein Halter-Pane, nur die Ladung selbst: warten, bis sie")
        gib_aus("  von selbst ablaeuft, oder kleiner rechnen.")
    else:
        gib_aus("  Niemand haelt etwas: die Maschine selbst hat nicht so viel frei. Hier")
        gib_aus("  hilft nur, kleiner zu rechnen (weniger gleichzeitige Anfragen, kuerzerer")
        gib_aus("  Kontext, kleinere Quantisierung) oder zu warten.")


def antwort_json(ja, spitze_gb, verfuegbar, offen, messung, gueltige, extra=None):
    ollama_status, ollama_eintraege, ollama_grund = messung.get("ollama", ("unbekannt", [], ""))
    # 'fremd' wird MITGEZEIGT, aber nie mitgezaehlt: die Ladungen gibt es
    # wirklich, nur eben auf einer anderen Maschine. Sie hier zu verschweigen
    # waere dieselbe Halbwahrheit wie sie mitzurechnen.
    ollama_bewertet = (ollama_bewerten(ollama_eintraege)
                       if ollama_status in ("ladungen", "fremd") else [])
    d = {
        "ja": ja,
        "spitze_gib": round(spitze_gb, 3),
        "verfuegbar_gib": None if verfuegbar is None else round(verfuegbar, 3),
        "offen_gib": round(offen, 3),
        "frei_messbar": messung["messbar"],
        "frei_gib": round(messung["frei_gib"], 3) if messung["messbar"] else None,
        "gesamt_gib": round(messung["gesamt_gib"], 3) if messung["messbar"] else None,
        "messverfahren": messung["verfahren"],
        "belegungen": [{k: v for k, v in e.items() if k != "_grund"} for e in gueltige],
        "ollama_status": ollama_status,
        "ollama_grund": ollama_grund,
        "ollama_ladungen": ollama_bewertet,
        "ollama_gezaehlt_gib": round(sum(e["gb"] for e in ollama_bewertet if e["stabil"])
                                     if ollama_status == "ladungen" else 0.0, 3),
    }
    if extra:
        d.update(extra)
    print(json.dumps(d, indent=2, ensure_ascii=False))


# ------------------------------------------------------------ Unterbefehle

def messung_holen(a):
    return frei_messen(a.abtastungen, a.abstand, a.beruhigen)


def cmd_darf(a):
    spitze, zeilen, _ = spitze_rechnen(a)
    with Sperre():
        gueltige, entfernt = buch_pruefen(buch_lesen())
        pruefe_buch(gueltige)
        if entfernt:
            buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                            for e in gueltige])
        messung = messung_holen(a)
        ja, verfuegbar, offen, ga, gb, grund = entscheiden(
            spitze, gueltige, messung, a.reserve_gb, a.ohne_messung)
    if a.json:
        antwort_json(ja, spitze, verfuegbar, offen, messung, gueltige,
                     {"verfallen": [e.get("id") for e in entfernt], "grund": grund})
        return 0 if ja else 1
    gib_aus("%s — %s GiB Spitze angefragt%s"
            % ("JA" if ja else "NEIN",
               zahl(spitze),
               "" if verfuegbar is None else (", %s GiB verfuegbar" % zahl(verfuegbar))))
    gib_aus()
    entscheidung_zeigen(spitze, zeilen, gueltige, messung, a.reserve_gb,
                        ja, verfuegbar, offen, ga, gb, grund)
    if entfernt:
        gib_aus()
        for e in entfernt:
            gib_aus("  verfallen: %s (%s)" % (e.get("id"), e.get("_grund")))
    absage_erklaeren(ja, gueltige, messung, grund)
    return 0 if ja else 1


