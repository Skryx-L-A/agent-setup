def tmux_pfad():
    """Dieselbe Vorsicht wie in hooks/sessionstart-claude-session.sh und
    app/src/main/pfad.ts: ein Prozess, der nicht aus einer Login-Shell stammt —
    ein launchd-Job zum Beispiel — hat /opt/homebrew/bin nicht im PATH."""
    p = shutil.which("tmux")
    if p:
        return p
    for p in ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux"):
        if os.access(p, os.X_OK):
            return p
    return None


def tmux_ruf(argumente, socket_pfad="", frist=3.0):
    """(rc, ausgabe). rc 127 heisst: tmux war gar nicht da. Nie ohne Zeitlimit."""
    binaer = tmux_pfad()
    if not binaer:
        return 127, ""
    befehl = [binaer]
    if socket_pfad:
        befehl += ["-S", socket_pfad]
    befehl += argumente
    try:
        p = subprocess.run(befehl, capture_output=True, text=True, timeout=frist)
        return p.returncode, p.stdout
    except (subprocess.TimeoutExpired, OSError):
        return 126, ""


def eigener_halter():
    """Wer bin ich? Pane, Socket, Sitzung, Workername — soweit messbar.

    Der SOCKETPFAD reist mit, weil die Lebendigkeit spaeter von einem anderen
    Prozess geprueft wird, der moeglicherweise auf einem anderen tmux-Server sitzt
    (Testsocket, zweite Sitzung). Der Basis-Sessionname kommt aus
    `#{session_group}`, nicht aus `#{session_name}`: sobald der Worker-Tab offen
    ist, haengt die Sitzung in einer Gruppe, und derselbe Pane meldet je nach
    Augenblick mal 'wb-AI', mal 'wb-AI-view' — dieselbe Messung und dieselbe
    Begruendung wie in shell/pi-worker und shell/context-guard."""
    halter = {"pane": "", "socket": "", "sitzung": "", "worker": "",
              "host": os.uname().nodename.split(".")[0], "etikett": ""}
    pane = os.environ.get("TMUX_PANE", "")
    tmux_env = os.environ.get("TMUX", "")
    if tmux_env:
        halter["socket"] = tmux_env.split(",")[0]
    if not pane:
        return halter
    halter["pane"] = pane
    rc, aus = tmux_ruf(["display", "-p", "-t", pane,
                        "#{session_group}\t#{session_name}\t#{@wb_worker}"],
                       halter["socket"])
    if rc == 0 and aus.strip():
        teile = (aus.strip("\n").split("\t") + ["", "", ""])[:3]
        halter["sitzung"] = teile[0] or teile[1]
        halter["worker"] = teile[2]
    return halter


def panes_des_servers(socket_pfad):
    """('ok', {pane: tot?}) | ('kein-server', {}) | ('unklar', {}).

    Die drei Faelle bleiben getrennt, weil sie Verschiedenes bedeuten. 'kein-server'
    heisst: dieser tmux ist fort, seine Panes sind es auch. 'unklar' heisst: wir
    wissen es nicht — und dann wird NICHT fuer tot erklaert, sondern die Karenz
    entscheidet. Wer beides gleich behandelt, raeumt bei einem tmux-Aussetzer eine
    laufende Belegung ab."""
    if socket_pfad and not os.path.exists(socket_pfad):
        return "kein-server", {}
    rc, aus = tmux_ruf(["list-panes", "-a", "-F", "#{pane_id}\t#{pane_dead}"], socket_pfad)
    if rc == 127 or rc == 126:
        return "unklar", {}
    if rc != 0:
        # tmux antwortet, hat aber keine Sitzung: "no server running on ..."
        return ("kein-server", {}) if not aus.strip() else ("unklar", {})
    karte = {}
    for zeile in aus.splitlines():
        if "\t" not in zeile:
            continue
        pane, tot = zeile.split("\t", 1)
        karte[pane] = (tot.strip() == "1")
    return "ok", karte


