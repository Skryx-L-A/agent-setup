def mensch_oder_ende():
    """`--auf-eigene-gefahr` ist eine BEHAUPTUNG und wird nie geglaubt -- gemessen
    wird sie von `wb-mensch` an der Herkunft des Aufrufs, genau wie beim
    Effort-Deckel und bei den Guards (siehe dort). Ein Agent, der den Schalter im
    Quelltext liest und mitschickt, kommt damit nicht durch: er kann seine eigene
    Elternkette nicht wegschreiben.

    IM ZWEIFEL KEIN MENSCH. Ist `wb-mensch` nicht aufrufbar, gilt Nein -- die
    andere Richtung waere ein Loch, das sich durch das blosse Loeschen einer Datei
    aufmachen liesse."""
    pfad = wb_mensch_pfad()
    if not pfad:
        fehler("'--auf-eigene-gefahr' braucht wb-mensch, und das ist hier nicht "
               "aufrufbar (~/.local/bin/wb-mensch). Im Zweifel gilt: kein Mensch, "
               "also kein Weg an der Buchung vorbei.")
    try:
        rc = subprocess.run([pfad, "pruefen"], timeout=15).returncode
    except (OSError, subprocess.SubprocessError) as e:
        fehler("'--auf-eigene-gefahr' braucht wb-mensch, und der Aufruf ist "
               "gescheitert (%s). Im Zweifel gilt: kein Mensch." % e)
    if rc == 0:
        return
    beleg = ""
    try:
        p = subprocess.run([pfad, "beleg"], capture_output=True, text=True, timeout=15)
        beleg = (p.stdout or "").strip()
    except (OSError, subprocess.SubprocessError):
        pass
    fehler("'--auf-eigene-gefahr' ist NUR fuer den Menschen — dieser Aufruf kommt "
           "nicht von einem.\n"
           "  Erkannt wurde: %s\n"
           "  Der Weg gehoert an die Hand am Terminal und an die Auswahl in der "
           "Oberflaeche, nicht in\n"
           "  pi-worker, claude-worker oder wb-harness-run — und es gibt ihn "
           "bewusst nicht als\n"
           "  Umgebungsvariable, die sich beilaeufig setzen laesst.\n"
           "  Diagnose: wb-mensch beleg ; wb-mensch ahnen"
           % (beleg or "kein Beleg"))


