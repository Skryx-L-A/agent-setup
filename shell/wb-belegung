def pruefe_rechnung(a):
    # ZUERST die Herkunft, vor jeder Rechnung: wer 'auf eigene Gefahr' sagt, muss
    # ein Mensch sein, und das wird gemessen, nicht geglaubt (siehe
    # mensch_oder_ende()). Ein Aufruf, der daran scheitert, soll gar nicht erst
    # rechnen -- sonst stuende in der Ausgabe eine Spitze neben einer Absage, und
    # der Leser muesste raten, welche der beiden gilt.
    if getattr(a, "auf_eigene_gefahr", False):
        mensch_oder_ende()
    # --metal-fraktion ist der dritte Weg zur Spitze (Nachtrag "vllm-metal als zweiter
    # Motor", 2026-08-21, siehe METAL_ARBEITSSATZ_GIB). Er wird HIER, vor allen anderen
    # Pruefungen, in eine gewoehnliche --gb-Spitze umgerechnet -- alles darunter sieht
    # danach eine selbst genannte Spitze wie bisher, und nur die Ausgabezeile in
    # spitze_rechnen() erklaert zusaetzlich, wo die Zahl herkommt.
    metal_fraktion = getattr(a, "metal_fraktion", None)
    if metal_fraktion is not None:
        if a.gb is not None or a.gewichte_gb is not None:
            fehler("--metal-fraktion nennt die Spitze bereits (Fraktion x %s GiB); "
                   "zusammen mit --gb oder --gewichte-gb waeren es zwei. Eine davon."
                   % zahl(METAL_ARBEITSSATZ_GIB))
        # Eine Fraktion ueber 1 waere kein Tippfehler mit harmloser Richtung: sie wuerde
        # dem Motor mehr zusagen, als Metal ueberhaupt als Arbeitssatz empfiehlt.
        metal_fraktion = pruefe_zahl(metal_fraktion, "--metal-fraktion", 0, strikt=True)
        if metal_fraktion > 1:
            fehler("--metal-fraktion %s ist groesser als 1 -- die Fraktion ist ein Anteil "
                   "an Metals Arbeitssatz (%s GiB), kein Vielfaches davon."
                   % (zahl(metal_fraktion, 2), zahl(METAL_ARBEITSSATZ_GIB)))
        a.metal_fraktion = metal_fraktion
        a.gb = round(metal_fraktion * METAL_ARBEITSSATZ_GIB, 4)
    if a.gb is None and a.gewichte_gb is None:
        fehler("entweder --gb (Spitze selbst gerechnet), --gewichte-gb oder "
               "--metal-fraktion (Motor vllm-metal). "
               "Belegt wird die SPITZE, nicht das Gewicht.")
    if a.gb is not None and a.gewichte_gb is not None:
        fehler("--gb und --gewichte-gb zugleich ergeben zwei Spitzen. Eine davon.")
    if a.gewichte_gb is not None and a.kontext is None:
        fehler("--kontext fehlt. Die Spitze ist Gewichte + Anfragen x Kontext x "
               "KV-Bedarf je Token + Zuschlag; ohne Kontext waere sie geraten.")
    a.gb = pruefe_zahl(a.gb, "--gb", 0, strikt=True)
    a.gewichte_gb = pruefe_zahl(a.gewichte_gb, "--gewichte-gb", 0, strikt=True)
    # Entwerfer-Gewichte duerfen null sein (kein Entwerfer, der Regelfall),
    # negativ nicht: er wuerde die Spitze verkleinern, wie beim Zuschlag.
    a.gewichte_entwerfer_gb = pruefe_zahl(a.gewichte_entwerfer_gb, "--gewichte-entwerfer-gb", 0)
    # Plaetze duerfen null sein (ungebucht, der bisherige Zustand), negativ nicht --
    # dieselbe Regel wie bei den Entwerfer-Gewichten oben.
    a.prompt_cache_plaetze = int(pruefe_zahl(a.prompt_cache_plaetze, "--prompt-cache-plaetze", 0))
    if getattr(a, "prompt_cache_gb", None) is not None:
        if a.prompt_cache_plaetze:
            fehler("--prompt-cache-gb und --prompt-cache-plaetze zusammen ergaeben zwei "
                   "Betraege fuer denselben Cache. Eine davon -- und wo es einen Deckel "
                   "gibt, ist es der Deckel.")
        a.prompt_cache_gb = pruefe_zahl(a.prompt_cache_gb, "--prompt-cache-gb", 0)
    # Der Zuschlag darf null sein (wer ihn ausdruecklich abwaehlt, weiss was er tut),
    # negativ nicht: er wuerde die Spitze verkleinern.
    a.zuschlag_gb = pruefe_zahl(a.zuschlag_gb, "--zuschlag-gb", 0)
    a.reserve_gb = pruefe_zahl(a.reserve_gb, "--reserve-gb", 0)
    a.abstand = pruefe_zahl(a.abstand, "--abstand", 0)
    a.beruhigen = pruefe_zahl(a.beruhigen, "--beruhigen", 0)
    pruefe_zahl(a.abtastungen, "--abtastungen", 1)
    if a.gewichte_gb is not None:
        # Mindestens eine Anfrage mit mindestens einem Token: alles darunter macht den
        # KV-Anteil zu null, und dann steht wieder nur das Gewicht in der Belegung.
        pruefe_zahl(a.parallel, "--parallel", 1)
        pruefe_zahl(a.kontext, "--kontext", 1)
        # Ohne --zuschlag-gb: an die tatsaechliche Nebenlaeufigkeit DIESER Buchung
        # gebunden herleiten, statt eines von Hand gesetzten festen Werts (Betriebsfehler
        # 1, zweite Runde Prueferbefunde, 2026-08-19) -- siehe zuschlag_herleiten().
        if a.zuschlag_gb is None:
            a.zuschlag_gb = zuschlag_herleiten(a.parallel, ohne_sockel=a.ohne_sockel)
    if a.kontext is None:
        a.kontext = 0


def main(argv):
    p = argparse.ArgumentParser(
        prog="wb-belegung",
        description="Belegungsbuch fuer grosse Ressourcen: darf ich, wer haelt, wieder frei.")
    sub = p.add_subparsers(dest="befehl")

    p_darf = sub.add_parser("darf", help="nur fragen, nichts eintragen")
    rechen_argumente(p_darf)

    p_nimm = sub.add_parser("nimm", help="fragen und eintragen, unter einer Sperre")
    rechen_argumente(p_nimm)
    p_nimm.add_argument("--zweck", default="", help="wofuer (Pflicht)")
    p_nimm.add_argument("--halter", default="", help="zusaetzliches Etikett fuer den Halter")
    p_nimm.add_argument("--frist", type=int, default=FRIST_MIN,
                        help="Frist in Minuten (Vorgabe %d)" % FRIST_MIN)
    p_nimm.add_argument("--karenz", type=int, default=KARENZ_MIN,
                        help="Karenz nach der Frist, nur ohne Pane wirksam (Vorgabe %d)" % KARENZ_MIN)

    p_wer = sub.add_parser("wer", help="wer haelt gerade was, seit wann")
    p_wer.add_argument("--json", action="store_true")

    p_gib = sub.add_parser("gib", help="eine Belegung freigeben")
    p_gib.add_argument("kennung", nargs="?", default="")
    p_gib.add_argument("--eigene", action="store_true", help="alle Belegungen dieses Panes")
    p_gib.add_argument("--fremd", action="store_true", help="eine fremde Belegung freigeben")

    p_gel = sub.add_parser("geladen", help="melden, dass das Modell jetzt im Speicher steht")
    p_gel.add_argument("kennung", nargs="?", default="")
    p_gel.add_argument("--eigene", action="store_true", help="alle Belegungen dieses Panes")
    p_gel.add_argument("--pid", type=int, default=0,
                        help="PID des jetzt wirklich laufenden Prozesses (z. B. der geladene "
                             "MLX-Server) -- ohne sie kann diese Belegung spaeter nicht als "
                             "'tot' erkannt werden, wenn ihr Prozess ohne Abschiedszeile "
                             "verschwindet (Nachtrag 'Karteileiche', 2026-08-21 abends). Optional: "
                             "eine Belegung ohne Pane als Halter (z. B. ein detached Server) hat "
                             "sonst KEIN Kriterium, an dem sie je als tot erkannt wuerde.")

    p_verl = sub.add_parser("verlaengern", help="die Frist einer Belegung neu setzen")
    p_verl.add_argument("kennung")
    p_verl.add_argument("--frist", type=int, default=FRIST_MIN)

    p_ueb = sub.add_parser("uebernehmen", help="die Belegung an den EIGENEN, "
                            "aktuellen Pane haengen (Lebendigkeit statt Frist-Versprechen, Befund N5)")
    p_ueb.add_argument("kennung")

    p_auf = sub.add_parser("aufraeumen", help="Verfallenes entfernen")
    p_auf.add_argument("--json", action="store_true")

    p_kv = sub.add_parser("kv", help="der KV-Bedarf je Token, je Modell, mit Herkunft")
    kvsub = p_kv.add_subparsers(dest="kv_befehl")
    p_kvl = kvsub.add_parser("liste")
    p_kvl.add_argument("--json", action="store_true")
    p_kvs = kvsub.add_parser("setzen")
    p_kvs.add_argument("modell")
    p_kvs.add_argument("mib", type=float)
    p_kvs.add_argument("--herkunft", required=True, choices=("gemessen", "angenommen"))
    p_kvs.add_argument("--kv-quant", default="", choices=("", "off", "q8", "q4"),
                       help="unter WELCHER Cache-Quantisierung dieser Wert gilt. Ohne "
                            "Angabe bleibt der Eintrag darueber stumm -- und ein KV-Wert "
                            "ohne sie ist eine halbe Angabe (bf16 kostet das Doppelte "
                            "von q8).")
    p_kvs.add_argument("--notiz", default="")
    p_kvs.add_argument("--json", action="store_true")

    p_of = sub.add_parser("ollama-freigeben", help="Ollama-Speicher verlaesslich "
                          "freibekommen, jeder Schritt verifiziert statt angenommen "
                          "(Befund 20.08.: 'ollama stop' meldet Erfolg und wirkt nicht)")
    p_of.add_argument("--frist", type=float, default=30.0,
                      help="Sekunden, die je Eskalationsstufe auf Wirkung/Rueckkehr "
                           "gewartet wird (Vorgabe 30)")
    p_of.add_argument("--json", action="store_true")

    a = p.parse_args(argv)
    if not a.befehl:
        p.print_help()
        return 2

    os.makedirs(STATE_DIR, exist_ok=True)

    if a.befehl == "darf":
        pruefe_rechnung(a)
        return cmd_darf(a)
    if a.befehl == "nimm":
        pruefe_rechnung(a)
        return cmd_nimm(a)
    if a.befehl == "wer":
        return cmd_wer(a)
    if a.befehl == "gib":
        if not a.kennung and not a.eigene:
            fehler("wb-belegung gib <kennung> — oder --eigene.")
        return cmd_gib(a)
    if a.befehl == "geladen":
        if not a.kennung and not a.eigene:
            fehler("wb-belegung geladen <kennung> — oder --eigene.")
        return cmd_geladen(a)
    if a.befehl == "verlaengern":
        return cmd_verlaengern(a)
    if a.befehl == "uebernehmen":
        return cmd_uebernehmen(a)
    if a.befehl == "aufraeumen":
        return cmd_aufraeumen(a)
    if a.befehl == "kv":
        if not getattr(a, "kv_befehl", ""):
            p_kv.print_help()
            return 2
        if not hasattr(a, "json"):
            a.json = False
        return cmd_kv(a)
    if a.befehl == "ollama-freigeben":
        return cmd_ollama_freigeben(a)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
