def kv_registry():
    """Die eingebauten Zahlen, ueberschrieben von dem, was jemand gemessen und
    eingetragen hat. Die Schluessel werden beim Lesen wie beim Schreiben normalisiert,
    damit ein Eintrag nicht daran scheitert, wie er getippt wurde."""
    daten = json_lesen(KV_DATEI, {"version": 1, "modelle": {}})
    modelle = dict(EINGEBAUTE_KV)
    for name, eintrag in (daten.get("modelle") or {}).items():
        if isinstance(eintrag, dict) and isinstance(eintrag.get("mib_je_token"), (int, float)):
            modelle[kv_schluessel(name)] = eintrag
    return modelle


def kv_schluessel(modell):
    """Der Name, unter dem gesucht und eingetragen wird: ohne Rand-Leerzeichen,
    klein geschrieben. Ein ' kat' mit fuehrendem Leerzeichen hat den Eintrag sonst
    still verfehlt (gemessen am 11.08.)."""
    return (modell or "").strip().lower()


ENDUNG_RE = re.compile(r"\.(gguf|safetensors|npz|bin|mlx|pt|pth)$")
QUANT_RE = re.compile(
    r"[-_@.]?(q\d+(_[0-9a-z]+)*|\d+bit|int\d+|fp\d+|bf\d+|f16|f32|mlx|awq|gptq)$")


def kv_kandidaten(schluessel):
    """Aus einer Modellangabe die Namen ableiten, die dasselbe Modell meinen koennten:
    der letzte Bestandteil eines Pfades, der Name ohne Dateiendung, der Name vor der
    Ollama-Marke, der Name ohne Quantisierungskuerzel — und alles davon auch
    kombiniert.

    Die Lehre kommt aus der Sperrliste der Nachbarsitzung: sie hat einen Lauf gegen
    ein gesperrtes Modell auch dann abgelehnt, als er eine ganz andere Modellkennung
    mitbrachte, weil sie zusaetzlich gegen den Pfad und dessen letzten Bestandteil
    prueft. Ohne das waere die Sperre still daran vorbeigelaufen."""
    aus, gesehen = [], {schluessel}
    arbeit = [schluessel.rstrip("/")]
    while arbeit and len(aus) < 12:
        s = arbeit.pop(0)
        abkoemmlinge = (
            (s.rsplit("/", 1)[-1] if "/" in s else s, "Pfad"),
            (ENDUNG_RE.sub("", s), "Dateiendung"),
            (s.split(":", 1)[0] if ":" in s else s, "Ollama-Marke"),
            (QUANT_RE.sub("", s), "Quantisierungskuerzel"),
        )
        for neu, wie in abkoemmlinge:
            neu = neu.strip(" -_.")
            if neu and neu != s and neu not in gesehen:
                gesehen.add(neu)
                aus.append((neu, wie))
                arbeit.append(neu)
    return aus


def kv_fuer(modell):
    """(mib_je_token_effektiv, herkunft_klartext, roh, gemessen?).

    Drei Faelle, und der dritte ist der, an dem eine Sperre still versagen koennte.

    1. GENAU GENANNT. Wer den eingetragenen Namen schreibt, bekommt dessen Zahl, wie
       sie dasteht — auch wenn sie klein ist. Das ist eine Aussage des Aufrufers ueber
       das Modell, das er gleich laedt, und die gilt in beide Richtungen.
    2. UNBEKANNT. Nicht mit der geerbten 0,11er-Konstante gerechnet, sondern mit dem
       hungrigsten gemessenen Wert mal Sicherheitsfaktor. Die harmlose Richtung.
    3. LOSE ZUGEORDNET — derselbe Modellstand unter einem Pfad, mit anderer Gross- und
       Kleinschreibung oder mit angehaengtem Quantisierungskuerzel. Hier gilt: eine
       lose Zuordnung darf die Zahl nur ERHOEHEN, nie senken. Sonst waere sie ein Weg,
       an der Vorsicht vorbeizukommen: ein grosses Modell, dessen Pfadname zufaellig
       auf einen kleinen gemessenen Eintrag passt, wuerde mit einem Bruchteil seines
       Bedarfs belegt, und genau das ist die gefaehrliche Richtung. Gemessen am
       11.08.: `/opt/modelle/winzig-6bit` traf vorher gar nichts (harmlos, aber die
       Messung blieb ungenutzt); mit einer naiven Normalisierung haette es 0,02
       MiB/Token getroffen.

    Die Grenze, offen benannt: der Modellname ist eine BEHAUPTUNG des Aufrufers. Wer
    ein grosses Modell laedt und ein kleines nennt, kommt durch — dagegen hilft kein
    Abgleich von Zeichenketten, sondern nur eine Messung nach dem Laden."""
    modelle = kv_registry()
    hoechster = max([float(e["mib_je_token"]) for e in modelle.values()
                     if e.get("herkunft") == "gemessen"] + [KV_NOTFALL])
    grundwert = hoechster * SICHERHEITSFAKTOR      # was ein unbekanntes Modell kostet
    schluessel = kv_schluessel(modell)

    eintrag = modelle.get(schluessel)
    if eintrag and eintrag.get("herkunft") == "gemessen":
        return (float(eintrag["mib_je_token"]),
                "GEMESSEN an '%s'%s" % (schluessel,
                                        (", " + eintrag["wann"]) if eintrag.get("wann") else ""),
                float(eintrag["mib_je_token"]), True)
    if eintrag:
        roh = float(eintrag["mib_je_token"])
        return (roh * SICHERHEITSFAKTOR,
                "ANGENOMMEN fuer '%s' (%s MiB/Token x Sicherheitsfaktor %s)"
                % (schluessel, zahl(roh, 2), zahl(SICHERHEITSFAKTOR, 1)),
                roh, False)

    for kandidat, wie in kv_kandidaten(schluessel):
        e = modelle.get(kandidat)
        if not e:
            continue
        roh = float(e["mib_je_token"])
        wert = max(grundwert, roh * SICHERHEITSFAKTOR)
        gehoben = " — angehoben auf den Wert eines unbekannten Modells" if wert > roh * SICHERHEITSFAKTOR else ""
        return (wert,
                "ANGENOMMEN (ueber %s auf den Eintrag '%s' zurueckgefuehrt: %s MiB/Token %s "
                "x Sicherheitsfaktor %s; eine lose Zuordnung darf nur erhoehen%s)"
                % (wie, kandidat, zahl(roh, 2), e.get("herkunft", "?"),
                   zahl(SICHERHEITSFAKTOR, 1), gehoben),
                roh, False)

    quelle = "unbekanntes Modell" if not schluessel else "Modell '%s' nicht eingetragen" % schluessel
    return (grundwert,
            "ANGENOMMEN (%s: gerechnet mit dem hoechsten gemessenen Wert %s MiB/Token "
            "x Sicherheitsfaktor %s)" % (quelle, zahl(hoechster, 2), zahl(SICHERHEITSFAKTOR, 1)),
            hoechster, False)


