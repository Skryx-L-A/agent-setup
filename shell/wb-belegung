def zuschlag_herleiten(parallel, ohne_sockel=False):
    """Der Zuschlag fuer Prompt-Cache und Spitzen, GEBUNDEN an die tatsaechliche
    Nebenlaeufigkeit DIESER Buchung -- nicht mehr ein fester Wert aus einer anderen
    Betriebsart geliehen (Betriebsfehler 1, zweite Runde Prueferbefunde, 2026-08-19).

    FIXKOSTEN-SOCKEL PLUS PRO-SEQUENZ-RATE (Worker "mlxsrv", 2026-08-20, siehe der
    lange Nachtrag bei ZUSCHLAG_JE_SEQUENZ_GIB oben fuer die vollen Messwerte): die
    fruehere Annahme reiner Proportionalitaet durch den Ursprung war ein bewusst
    einfaches Modell aus EINEM historischen Messpunkt (sieben Sequenzen,
    11.08.2026) und ist an drei ECHTEN Laeufen gegen einen echten qwen38-27b-Server
    (1/4/8 gleichzeitige, verschiedene Anfragen) widerlegt: der benoetigte Zuschlag
    waechst NICHT linear durch den Ursprung -- schon bei EINER Sequenz liegt er bei
    rund 3,8 GiB, ein Sockel, der bei einem reinen Proportionalmodell fehlen wuerde
    und die Buchung gerade beim haeufigsten Fall (ein einzelner Aufrufer, parallel=1)
    unterschaetzt haette. Die Formel ist deshalb ZUSCHLAG_FIXED_GIB + parallel x
    ZUSCHLAG_JE_SEQUENZ_GIB, mit der Steigung aus dem steilsten gemessenen Abschnitt
    (eins auf vier Stroeme), damit die Buchung bei groesseren, NICHT gemessenen
    Stromzahlen absichtlich zu grosszuegig statt zu knapp rechnet -- siehe die
    Begruendung fuer sechzehn Stroeme im Nachtrag oben.

    OHNE_SOCKEL (Nachtrag, Auftrag "der feste Sockel wird je Worker erneut
    gebucht", 2026-08-20): ZUSCHLAG_FIXED_GIB ist Server-Fixkosten -- Metal-
    Scratch-/Kompilierpuffer, die EINMAL je Server anfallen, nicht je Sequenz
    und nicht je Aufrufer. In der Betriebsart, in der jeder Worker seine EIGENE
    Sequenz einzeln bucht (BELEGUNG_PARALLEL=1, siehe pi-worker), zaehlte der
    Sockel bisher bei JEDEM einzelnen `nimm`-Aufruf erneut -- beim Serverstart
    UND bei jedem Worker obendrauf, real gemessen im Echttest vom 20.08.2026:
    zwei durchgelaufene Worker plus Server standen mit 3x4,3 GiB Zuschlag statt
    einmal im Buch, ein dritter und vierter Worker wurden deshalb bei ~40 GiB
    abgelehnt, obwohl der wirkliche Bedarf bei rund 33 GiB lag. Wer den Sockel
    TRAEGT, muss aus dem Aufruf hervorgehen: der Server bucht ihn beim Start
    (ohne_sockel=False, die Vorgabe -- unveraendert fuer wb-mlx-server und
    wb-llama-server), ein Worker, der sich an einen bereits laufenden Server
    haengt (`--ohne-sockel`, siehe pi-worker), bucht nur seinen eigenen Anteil
    an der Pro-Sequenz-Rate."""
    n = max(1, int(parallel))
    sockel = 0.0 if ohne_sockel else ZUSCHLAG_FIXED_GIB
    return round(sockel + n * ZUSCHLAG_JE_SEQUENZ_GIB, 4)


def spitze_rechnen(a):
    """Die Spitze, nicht das Gewicht. Rueckgabe: (gb, zeilen, kv_herkunft, kv_ersatzwert)."""
    if a.gb is not None:
        # Nachtrag "vllm-metal als zweiter Motor" (2026-08-21): dieselbe selbst genannte
        # Spitze, aber mit ihrer Herkunft davor -- eine Zeile "selbst genannt, hier nicht
        # nachgerechnet" waere fuer diesen Weg unwahr, die Zahl IST hier gerechnet.
        # kv_ersatzwert bleibt hier IMMER False: dieser Weg rechnet gar kein KV (die Spitze
        # kommt vom Aufrufer selbst), es gibt also nichts, wobei ein Schluessel raten koennte.
        metal_fraktion = getattr(a, "metal_fraktion", None)
        if metal_fraktion is not None:
            return float(a.gb), [
                "  Spitze     %s GiB = Metal-Arbeitssatz %s GiB x Fraktion %s "
                "(VLLM_METAL_MEMORY_FRACTION)"
                % (zahl(a.gb), zahl(METAL_ARBEITSSATZ_GIB), zahl(metal_fraktion, 2)),
                "             vllm-metal teilt sich dieses Budget beim Start vorab selbst zu "
                "und haelt es",
                "             unabhaengig von Stroemen und Kontext -- deshalb KEINE "
                "Gewichte-plus-KV-Rechnung.",
                # Wortlaut der Protokollzeile, unveraendert zitiert (Punkt statt Komma):
                # wer danach im Protokoll sucht, soll sie finden.
                "             ACHTUNG: der Motor setzt beim Start 'Set Metal wired_limit to "
                "42.0 GB', auch",
                "             bei kleiner Fraktion. Diese Buchung ist dann die einzige "
                "Bremse (11.08.).",
            ], "keine (Budget des Motors, nicht KV-gerechnet)", False
        return float(a.gb), ["  Spitze     %s GiB (selbst genannt, hier nicht nachgerechnet)"
                             % zahl(a.gb)], "keine (Spitze selbst genannt)", False
    # Ohne max(0, …): die Werte sind in pruefe_rechnung() geprueft, und ein Klemmen
    # wuerde eine unsinnige Angabe wieder in eine stille Null verwandeln.
    gewichte = float(a.gewichte_gb)
    # Entwerfer-Gewichte (Nachtrag 2026-08-20, "Vorhersage im Betrieb"):
    # eigenes Feld statt vorab in --gewichte-gb hineingerechnet, damit die
    # Zeile unten SICHTBAR macht, wieviel vom Ziel und wieviel vom Entwerfer
    # kommt -- eine Belegung, die "20 GiB Gewichte" nur summiert zeigt, laesst
    # nicht erkennen, ob das ein groesseres Ziel oder ein Ziel-plus-Entwerfer
    # ist. Ein Entwerfer traegt seine eigene, sehr kleine KV-Last nicht extra
    # in dieser Formel -- sein Fenster ist auf wenige Draft-Token begrenzt,
    # winzig gegen das Ziel-Fenster, und wird vom Zuschlag mitgedeckt (siehe
    # zuschlag_herleiten()), genau wie der rekurrente SSM-Zustand.
    gewichte_entwerfer = float(getattr(a, "gewichte_entwerfer_gb", 0.0) or 0.0)
    parallel = int(a.parallel)
    kontext = int(a.kontext)
    zuschlag = float(a.zuschlag_gb)
    # Prompt-Cache-Plaetze (Nachtrag "MTPLX im Betrieb", 2026-08-20): eigener
    # Posten, siehe PROMPT_CACHE_GB_JE_PLATZ und den Kopfkommentar dort --
    # NICHT Teil von zuschlag, sonst wuerde eine Belegung mit Cache-Buchung
    # den Zuschlag-Wert unerklaert groesser zeigen, als zuschlag_herleiten()
    # fuer dasselbe --parallel liefert.
    # Ein DECKEL (--prompt-cache-gb) ist eine Tatsache ueber den Server, der
    # gleich startet; eine Platzzahl mal angenommener Platzgroesse ist eine
    # Schaetzung darueber, wie gross die Plaetze im Betrieb werden. Wo es einen
    # Deckel gibt, gewinnt er (Nachtrag 2026-08-21).
    cache_plaetze = int(getattr(a, "prompt_cache_plaetze", 0) or 0)
    cache_deckel = getattr(a, "prompt_cache_gb", None)
    if cache_deckel is not None:
        cache_gib = float(cache_deckel) * PROMPT_CACHE_DECKEL_FAKTOR
    else:
        cache_gib = cache_plaetze * PROMPT_CACHE_GB_JE_PLATZ
    kv_mib, herkunft, _roh, _gemessen, kv_quant_eintrag, kv_ersatzwert = kv_fuer(a.modell)
    kv_gib = parallel * kontext * kv_mib / MIB_JE_GIB
    spitze = gewichte + gewichte_entwerfer + kv_gib + zuschlag + cache_gib
    if gewichte_entwerfer > 0:
        zeilen = [
            "  Spitze     %s GiB = Gewichte %s (Ziel) + %s (Entwerfer) + KV-Cache %s + Zuschlag %s"
            % (zahl(spitze), zahl(gewichte), zahl(gewichte_entwerfer), zahl(kv_gib), zahl(zuschlag)),
        ]
    else:
        zeilen = [
            "  Spitze     %s GiB = Gewichte %s + KV-Cache %s + Zuschlag %s"
            % (zahl(spitze), zahl(gewichte), zahl(kv_gib), zahl(zuschlag)),
        ]
    if cache_gib > 0:
        zeilen[-1] += " + Prompt-Cache %s" % zahl(cache_gib)
        if cache_deckel is not None:
            zeilen.append("  Prompt-Cache %s GiB Deckel (mlx_lm.server --prompt-cache-bytes) "
                          "x %s = %s GiB gebucht."
                          % (zahl(float(cache_deckel)), zahl(PROMPT_CACHE_DECKEL_FAKTOR, 1),
                             zahl(cache_gib)))
            zeilen.append("             Der Faktor ist gemessen: der Deckel wirkt (der Cache "
                          "verdraengt und bleibt stehen),")
            zeilen.append("             haelt aber rund das Doppelte -- siehe "
                          "PROMPT_CACHE_DECKEL_FAKTOR im Quelltext.")
        else:
            zeilen.append("  Prompt-Cache %d Plaetze x %s GiB/Platz (mlx_lm.servers eigene LRUPromptCache)"
                          % (cache_plaetze, zahl(PROMPT_CACHE_GB_JE_PLATZ)))
    zeilen += [
        "  KV-Cache   %d Anfragen x %d Token x %s MiB/Token"
        % (parallel, kontext, zahl(kv_mib, 2)),
        "             %s" % herkunft,
    ]
    if "ANGENOMMEN" in herkunft:
        zeilen.append("             einmal messen und eintragen: wb-belegung kv setzen "
                      "%s <mib-je-token> --herkunft gemessen --kv-quant q8"
                      % (a.modell or "<modell>"))
    # Die Cache-Quantisierung (Nachtrag 2026-08-21). Sie wird NIE eingerechnet, nur
    # verglichen und benannt: derselbe Kontext kostet in bf16 doppelt so viel wie in
    # q8, und wer beides verwechselt, bucht entweder die Haelfte zu viel (harmlos,
    # aber es sperrt Stufen, die passen wuerden -- genau der Fall vom 21.08.) oder
    # die Haelfte zu wenig (der teure Fall). Ein Umrechnungsfaktor waere wieder eine
    # Annahme; hier gilt der gemessene Wert fuer die Einstellung, unter der er
    # gemessen wurde, und alles andere ist ein sichtbarer Widerspruch.
    kv_quant_lauf = (getattr(a, "kv_quant", "") or "").strip().lower()
    if kv_quant_eintrag:
        zeilen.append("             KV-Cache-Quantisierung des Eintrags: %s" % kv_quant_eintrag)
    if kv_quant_lauf:
        if not kv_quant_eintrag:
            zeilen.append("             ACHTUNG: der Motor faehrt den KV-Cache mit '%s', der "
                          "Eintrag sagt nicht," % kv_quant_lauf)
            zeilen.append("             wofuer seine Zahl gilt. Sie wird UNVERAENDERT gerechnet "
                          "-- einmal unter '%s' messen" % kv_quant_lauf)
            zeilen.append("             und mit --kv-quant %s eintragen." % kv_quant_lauf)
        elif kv_quant_lauf != kv_quant_eintrag:
            zeilen.append("             ACHTUNG: der Motor faehrt '%s', der Eintrag gilt fuer "
                          "'%s'. Die Zahl wird" % (kv_quant_lauf, kv_quant_eintrag))
            zeilen.append("             UNVERAENDERT gerechnet (kein stiller Umrechnungsfaktor) "
                          "-- unter '%s' messen und" % kv_quant_lauf)
            zeilen.append("             eintragen, sonst bucht diese Rechnung dauerhaft daneben.")
    return spitze, zeilen, herkunft, kv_ersatzwert


def nicht_geladen(gueltige):
    """Die Summe der Belegungen, deren Modell noch NICHT im Speicher ist.

    Befund 2 des Pruefdurchgangs vom 11.08.: Grenze B zieht vom Gesamtspeicher nur
    Reserve und Belegungen ab, nie die Grundlast der Maschine — auf diesem Mac gerade
    18 GiB (30681 von 49152 MiB frei). Grenze A kannte die Grundlast, sah aber ein
    ladendes Modell nicht. Zwei aufeinanderfolgende Anfragen im Ladefenster kamen so
    beide durch und ergaben zusammen mehr, als die Maschine hat; zwei GLEICHZEITIGE
    Anfragen braucht es dafuer nicht einmal, die Sperre schuetzt nur die Buchfuehrung.

    Wer nach dem Laden `wb-belegung geladen <kennung>` meldet, gibt den Betrag aus
    dieser Summe frei — der Speicher steht dann ja in der Messung. Wer es VERGISST,
    rechnet doppelt und bekommt zu frueh ein Nein: die harmlose Richtung, und sie
    faellt auf, weil `wer` jede Belegung als „laedt noch" ausweist."""
    return sum(float(e.get("gb", 0.0)) for e in gueltige if not e.get("realisiert"))


def entscheiden(spitze_gb, gueltige, messung, reserve_gib, ohne_messung=False):
    """Zwei Grenzen, die kleinere gewinnt. Sie werden nicht addiert (das zaehlte ein
    fertig geladenes Modell doppelt) und nicht gegeneinander abgewogen.

    EIN NICHT MESSBARER FREIER SPEICHER IST EIN NEIN (Befund 1 des Pruefdurchgangs
    vom 11.08.). Vorher stand hier `verfuegbar = None` und eine Zeile weiter
    `ja = (verfuegbar is None) or …` — damit sagte das Buch zu ALLEM ja, auch zu
    200 GiB bei 44 GiB offener Belegung, und die Ausgabe behauptete dabei, es werde
    nach den offenen Belegungen entschieden. Entschieden wurde nach nichts. Der Weg
    dorthin ist kein Gedankenspiel: unter dem nackten launchd-PATH fehlt /usr/sbin,
    `check-resources` findet sein `sysctl` nicht und bricht mit Exit 127 ab — ein
    Modellstart aus einem launchd-Job bekam also immer ein Ja.

    Mit `--ohne-messung` wird ausdruecklich allein nach Grenze B entschieden. Dann
    stimmt der Satz „entschieden wird allein nach den offenen Belegungen" auch, und
    er steht unter dem Vorbehalt, dass niemand ungebucht Speicher haelt.

    OLLAMA (Nachtrag 16.08.): Grenze A sieht eine Ollama-Ladung automatisch, weil
    ihr Verbrauch den GEMESSENEN freien Speicher senkt -- sie hier zusaetzlich
    abzuziehen waere dieselbe Doppelzaehlung, vor der oben bei den eigenen
    Belegungen gewarnt wird. Grenze B sieht dagegen nichts ausserhalb des Buches;
    deshalb, und nur deshalb, zaehlt eine STABILE Ollama-Ladung hier mit rein
    (siehe OLLAMA_STABIL_SCHWELLE_S). Fluechtige Ladungen und ein 'unbekannter'
    Ollama-Zustand zaehlen mit 0,0 GiB -- sonst waere die Vergabe haerter als vor
    diesem Umbau, und genau das soll sie nicht sein.

    GEGENPROBE (Nachtrag 20.08., siehe der lange Kommentar bei OLLAMA_STABIL_
    SCHWELLE_S): eine stabile Ollama-Ladung, deren Prozess in Wahrheit tot ist,
    zieht Grenze B nach unten, ohne dass Grenze A das jemals bestaetigt --
    Grenze A ist rechnerisch IMMER <= Grenze B, solange die Ollama-Meldung
    stimmt (die unbekannte Grundlast des Systems, die nur Grenze A sieht, zieht
    sie zusaetzlich nach unten; eine korrekt gemeldete Ollama-Last hebt diese
    Ungleichung nicht auf). Grenze A > Grenze B laesst sich also nur aus einer
    ueberhoehten Ollama-Meldung erklaeren. Tritt das ein, zaehlt die stabile
    Ollama-Summe fuer DIESE Entscheidung nicht mehr mit -- die Fremdanzeige
    gewinnt nie mehr stillschweigend gegen die eigene Messung -- und der
    Widerspruch wird im vierten Rueckgabewert als Text mitgegeben, damit er
    sichtbar wird statt nur intern zu korrigieren.

    Rueckgabe: (ja, verfuegbar, offen, grenze_a, grenze_b, grund, widerspruch).

    Zustand 'tot' zaehlt hier NICHT mit (Nachtrag "Karteileiche", 2026-08-21
    abends): eine Belegung, deren Prozess nachweislich nicht mehr laeuft, ist
    kein Speicherverbrauch mehr, den die Vergabe schuetzen muesste -- der
    reale, gemessene freie Speicher (Grenze A) hat den Unterschied laengst
    gesehen, nur das Buch (Grenze B) wusste es bisher nicht. buch_pruefen()
    entfernt 'tot' bewusst NICHT aus 'gueltige' (sichtbar in wb-belegung wer,
    siehe zustand_bestimmen), deshalb der Filter genau hier fuer Grenze B.
    Grenze A (nicht_geladen(), unten in dieser Rechnung ueber 'gueltige'
    aufgerufen) braucht KEINEN eigenen Filter: eine tote Belegung ist immer
    'realisiert' (siehe prozess_tot()), nicht_geladen() zaehlt also ohnehin
    nur unrealisierte Belegungen -- ein toter Eintrag war dort nie drin,
    nicht weil hier gefiltert wird, sondern aus einem eigenen, unabhaengigen
    Grund."""
    offen = (sum(float(e.get("gb", 0.0)) for e in gueltige if e.get("_zustand") != "tot")
             + ollama_stabile_summe(messung))
    if not messung["messbar"]:
        if not ohne_messung:
            return (False, None, offen, None, None,
                    "der freie Speicher ist NICHT MESSBAR (%s). Ein Ja waere geraten, "
                    "und geraten wird hier nicht." % messung["quelle"], "")
        if not messung.get("gesamt_bekannt"):
            return (False, None, offen, None, None,
                    "weder der freie noch der Gesamtspeicher sind messbar — auch "
                    "--ohne-messung hat dann nichts, worauf es sich stuetzen koennte.", "")
        grenze_b = messung["gesamt_gib"] - reserve_gib - offen
        return (spitze_gb <= grenze_b, grenze_b, offen, None, grenze_b,
                "" if spitze_gb <= grenze_b else "", "")
    grenze_b = messung["gesamt_gib"] - reserve_gib - offen
    # Grenze A minus dem, was belegt, aber noch nicht im Speicher ist. Der gemessene
    # freie Speicher sieht ein ladendes Modell noch nicht — wer nur gegen ihn prueft,
    # vergibt denselben Speicher zweimal, solange das Ladefenster offen ist.
    grenze_a = messung["frei_gib"] - reserve_gib - nicht_geladen(gueltige)

    widerspruch = ""
    ollama_sum = ollama_stabile_summe(messung)
    if ollama_sum > 0 and grenze_a > grenze_b + OLLAMA_GEGENPROBE_TOLERANZ_GIB:
        widerspruch = (
            "Ollama meldet %s GiB stabile Ladung, aber der wirklich gemessene freie "
            "Speicher (Grenze A, %s GiB) ist HOEHER als die Buchrechnung MIT dieser "
            "Ladung (Grenze B, %s GiB) -- sie taucht im echten freien Speicher nicht auf. "
            "Ein Abzug fuer eine Ladung, die dort nicht auftaucht, ist falsch: sie zaehlt "
            "hier NICHT."
            % (zahl(ollama_sum), zahl(grenze_a), zahl(grenze_b)))
        offen = offen - ollama_sum
        grenze_b = messung["gesamt_gib"] - reserve_gib - offen

    verfuegbar = min(grenze_a, grenze_b)
    return spitze_gb <= verfuegbar, verfuegbar, offen, grenze_a, grenze_b, "", widerspruch


def entscheidung_zeigen(spitze_gb, zeilen, gueltige, messung, reserve_gib,
                        ja, verfuegbar, offen, grenze_a, grenze_b, grund="", widerspruch=""):
    for z in zeilen:
        gib_aus(z)
    if messung["messbar"]:
        gib_aus("  Frei       %s GiB gemessen (%s)" % (zahl(messung["frei_gib"]), messung["verfahren"]))
        laedt = nicht_geladen(gueltige)
        gib_aus("  Grenze A   %s GiB = %s frei - %s Reserve - %s belegt, aber noch nicht geladen"
                % (zahl(grenze_a), zahl(messung["frei_gib"]), zahl(reserve_gib), zahl(laedt)))
        gib_aus("  Grenze B   %s GiB = %s gesamt - %s Reserve - %s offen belegt "
                "(Buch + stabile Ollama-Ladungen)"
                % (zahl(grenze_b), zahl(messung["gesamt_gib"]), zahl(reserve_gib), zahl(offen)))
        if widerspruch:
            gib_aus("  WIDERSPRUCH  %s" % widerspruch)
        gib_aus("  Verfuegbar %s GiB (die kleinere der beiden)" % zahl(verfuegbar))
    else:
        gib_aus("  Frei       NICHT MESSBAR (%s)" % messung["quelle"])
        if grenze_b is not None:
            gib_aus("  Grenze B   %s GiB = %s gesamt - %s Reserve - %s offen belegt "
                    "(Buch + stabile Ollama-Ladungen)"
                    % (zahl(grenze_b), zahl(messung["gesamt_gib"]), zahl(reserve_gib), zahl(offen)))
            gib_aus("  Verfuegbar %s GiB — allein aus den offenen Belegungen (--ohne-messung)."
                    % zahl(grenze_b))
            gib_aus("             Was jemand OHNE Belegung UND OHNE Ollama haelt, sieht diese "
                    "Rechnung nicht.")
        else:
            gib_aus("  Offen      %s GiB belegt" % zahl(offen))
    if grund:
        gib_aus()
        gib_aus("  NEIN: %s" % grund)
        gib_aus("  Wer trotzdem entscheiden muss, nimmt --ohne-messung; dann zaehlt allein,")
        gib_aus("  was im Buch steht.")
    gib_aus()
    gib_aus("  Offene Belegungen:")
    belegungen_zeigen(gueltige)
    gib_aus()
    for z in ollama_zeigen(messung):
        gib_aus(z)
    if widerspruch:
        gib_aus("  (GEZAEHLT oben beschreibt nur die Frist-Stabilitaet -- fuer DIESE")
        gib_aus("  Entscheidung zaehlt die Ladung wegen des Widerspruchs oben NICHT.)")


def absage_erklaeren(ja, gueltige, messung, grund=""):
    """Wer ein Nein bekommt, soll wissen, WORAN es lag — an einem anderen Halter,
    an Ollama, an der Maschine selbst, oder daran, dass gar nicht gemessen werden
    konnte. Das sind verschiedene naechste Schritte."""
    if ja:
        return
    if grund:
        return      # der Grund steht bereits im Klartext ueber dieser Stelle
    ollama_status, ollama_eintraege, _grund = messung.get("ollama", ("unbekannt", [], ""))
