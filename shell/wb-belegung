                          "ollama_grund": ollama_grund,
                          "ollama_ladungen": ollama_bewertet,
                          "ollama_gezaehlt_gib": round(ollama_gezaehlt, 3)},
                         indent=2, ensure_ascii=False))
        return 0
    summe = sum(float(e.get("gb", 0.0)) for e in gueltige)
    gib_aus("Offene Belegungen: %d, zusammen %s GiB (Buch)" % (len(gueltige), zahl(summe)))
    belegungen_zeigen(gueltige)
    for e in entfernt:
        gib_aus("  verfallen: %s (%s)" % (e.get("id"), e.get("_grund")))
    gib_aus()
    for z in ollama_zeigen(messung):
        gib_aus(z)
    if ollama_gezaehlt > 0:
        gib_aus("  Fuer die Vergabe zaehlen zusammen: %s GiB (Buch %s + Ollama %s)"
                % (zahl(summe + ollama_gezaehlt), zahl(summe), zahl(ollama_gezaehlt)))
