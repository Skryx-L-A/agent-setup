    """Was ein Mensch gesagt bekommt, bevor er trotzdem startet. Ausfuehrlich und
    in ganzen Saetzen, absichtlich: hier ist Verkuerzung gefaehrlich."""
    zeilen = [
        "",
        "  ======================================================================",
        "  AUF EIGENE GEFAHR — diese Belegung waere ABGELEHNT worden.",
        "",
    ]
    if grund:
        zeilen.append("  Grund der Ablehnung: %s" % grund)
    else:
        zeilen.append("  Angefragt sind %s GiB Spitze, verfuegbar waeren %s GiB."
                      % (zahl(spitze_gb),
                         "nicht bestimmbar" if verfuegbar is None else zahl(verfuegbar)))
    zeilen += [
        "",
        "  WAS PASSIEREN KANN: Am 10. und 11.08.2026 ist diese Maschine zweimal in",
        "  zwei Stunden hart stehengeblieben — Kernel-Panik mit der Signatur",
        "  'completeMemory() prepare count underflow @IOGPUMemory.cpp:550', ausgeloest",
        "  aus einem MLX-Prozess. Beide Male standen zwei grosse GPU-Nutzer gleichzeitig.",
        "  Genau diesen Zustand verhindert die Buchung, die hier gerade uebergangen wird.",
        "  Stuerzt die Maschine ab, ist jede laufende Arbeit weg: offene Sitzungen,",
        "  ungespeicherte Dateien, laufende Worker.",
        "",
        "  Die Zahl wird NICHT zurechtgebogen: gebucht wird %s GiB, also genau das,"
        % zahl(spitze_gb),
        "  was angefragt wurde.",
        "  ======================================================================",
        "",
    ]
    return zeilen


