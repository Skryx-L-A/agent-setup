        gib_aus("  Freigeben, sobald es wieder heraus ist:  wb-belegung gib %s" % neu["id"])
        if not halter.get("pane"):
            gib_aus("  ACHTUNG: kein tmux-Pane als Halter messbar. Hier ist die Frist das")
            gib_aus("  harte Kriterium — nach Frist + Karenz (%d min) verfaellt die Belegung"
                    % int(a.karenz))
            gib_aus("  von selbst, auch wenn Dein Lauf noch laeuft.")
        gib_aus()
    else:
        gib_aus("NEIN — %s GiB Spitze angefragt%s, nichts eingetragen."
                % (zahl(spitze),
                   "" if verfuegbar is None else (", nur %s GiB verfuegbar" % zahl(verfuegbar))))
        gib_aus()
    entscheidung_zeigen(spitze, zeilen, gueltige, messung, a.reserve_gb,
                        ja, verfuegbar, offen, ga, gb, grund)
    absage_erklaeren(ja, gueltige, messung, grund)
    return 0 if ja else 1


def cmd_wer(a):
    with Sperre():
        gueltige, entfernt = buch_pruefen(buch_lesen())
        if entfernt:
            buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                            for e in gueltige])
    # 'wer' beantwortet die Frage 'was belegt gerade wirklich' -- dazu gehoert seit
    # dem Nachtrag vom 16.08. auch Ollama, sonst zeigt das Buch weiterhin nur die
    # Prozesse, die sich freiwillig eintragen. Eine einzelne Abtastung reicht: es
    # geht um Anzeige, nicht um eine Vergabeentscheidung (die misst in darf/nimm
