        # (Fehler 2/3, Auftrag 2026-08-20): bisher endete die Funktion bei leerem
        # 'weg' VOR buch_schreiben() -- eine Belegung, deren Pane laengst tot war
        # (buch_pruefen() oben stuft sie deshalb schon als 'verfallen' ein und
        # nimmt sie aus 'gueltige' heraus), blieb dadurch trotzdem auf der Platte
        # stehen, solange 'gib' sie nicht selbst per Kennung/--eigene fand. Genau
        # das hat wb-mlx-servers 'gib <kennung>' dann als 'beide Versuche
        # gescheitert' gemeldet: der erste Versuch traf 'nichts freizugeben' (die
        # Belegung war schon aus 'gueltige' raus), der zweite (--fremd) ebenso --
        # keiner der beiden schrieb je das bereinigte Buch.
        if entfernt or weg:
            buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                            for e in bleiben])
        if not weg:
            bereits_verfallen = next((e for e in entfernt if a.kennung and e.get("id") == a.kennung), None)
            if bereits_verfallen:
                gib_aus("Bereits verfallen: %s (%s) -- Buch bereinigt, nichts mehr freizugeben."
                        % (a.kennung, bereits_verfallen.get("_grund", "")))
                return 0
            print("wb-belegung: nichts freizugeben.", file=sys.stderr)
            return 1
    for e in weg:
        gib_aus("Freigegeben: %s (%s GiB, %s)" % (e.get("id"), zahl(e.get("gb", 0.0)),
                                                  e.get("zweck") or ""))
    return 0


def cmd_geladen(a):
    """Der Halter meldet, dass sein Modell jetzt wirklich im Speicher steht. Ab da
    sieht die Messung den Speicher selbst, und die Belegung wird nicht mehr zusaetzlich
    von Grenze A abgezogen.

    --pid (Nachtrag "Karteileiche", 2026-08-21 abends): genau HIER, im Moment, in
    dem der Aufrufer die Lebendigkeit gerade selbst bestaetigt hat (Health-Probe
    o.ae. bereits gelaufen), laesst sich der Startzeitpunkt der PID einfangen --
    derselbe Pruefwert, den shell/wb-nohup bei seiner eigenen Registrierung
    einfaengt (siehe dort, 'PID-WIEDERVERWENDUNG'). Ohne --pid bleibt die Belegung
    wie bisher: ihre einzige Lebendigkeits-Pruefung ist der Pane des Halters."""
    halter = eigener_halter()
    if a.eigene and not halter.get("pane"):
        fehler("--eigene braucht einen eigenen tmux-Pane, sonst ist 'eigene' nicht von "
               "'alle ohne Pane' zu unterscheiden. Gib die Kennung an.")
    pid = int(getattr(a, "pid", 0) or 0)
    lstart = prozess_lstart(pid) if pid else ""
    if pid and not lstart:
        err_txt = ("WARNUNG: --pid %d liess sich nicht bestaetigen (Prozess nicht mehr da) -- "
                   "die Belegung wird trotzdem als geladen markiert, aber ohne PID-Merkmal "
                   "eingetragen.") % pid
        print(err_txt, file=sys.stderr)
        pid = 0
    with Sperre():
        gueltige, entfernt = buch_pruefen(buch_lesen())
        getroffen = []
        for e in gueltige:
            eigen = (halter.get("pane") and
                     (e.get("halter") or {}).get("pane") == halter["pane"])
            if (a.eigene and eigen) or (a.kennung and e.get("id") == a.kennung):
                if e.get("realisiert"):
                    continue
                e["realisiert"] = True
                e["realisiert_iso"] = iso(jetzt())
                if pid:
                    e["prozess_pid"] = pid
                    e["prozess_lstart"] = lstart
                getroffen.append(e)
        if not getroffen:
            # Verfallenes trotzdem schreiben (dieselbe Luecke wie in cmd_gib,
            # Fehler 2/3, Auftrag 2026-08-20): sonst bleibt eine Belegung mit
            # totem Pane im Buch, nur weil dieser Aufruf sie nicht selbst traf.
            if entfernt:
                buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                                for e in gueltige])
            print("wb-belegung: keine ladende Belegung getroffen.", file=sys.stderr)
            return 1
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in gueltige])
    for e in getroffen:
        gib_aus("Als geladen gemeldet: %s (%s GiB, %s)"
                % (e.get("id"), zahl(e.get("gb", 0.0)), e.get("zweck") or ""))
    return 0


def cmd_verlaengern(a):
    pruefe_zahl(a.frist, "--frist", 0)
    with Sperre():
        gueltige, entfernt = buch_pruefen(buch_lesen())
        getroffen = None
        for e in gueltige:
            if e.get("id") == a.kennung:
                # Die Frist laeuft ab JETZT neu — genau das ist die Antwort des
                # Halters auf die Frage "brauchst Du das noch?".
                e["seit"] = jetzt()
                e["seit_iso"] = iso(jetzt())
                e["frist_s"] = int(a.frist) * 60
                getroffen = e
        if not getroffen:
            # Verfallenes trotzdem schreiben, dieselbe Luecke wie in cmd_gib
            # (Fehler 2/3, Auftrag 2026-08-20).
            if entfernt:
                buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                                for e in gueltige])
            print("wb-belegung: keine Belegung mit der Kennung '%s'." % a.kennung, file=sys.stderr)
            return 1
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in gueltige])
    gib_aus("Verlaengert: %s, neue Frist %d min ab jetzt." % (a.kennung, int(a.frist)))
    return 0


def cmd_uebernehmen(a):
    """Haengt eine bestehende Belegung an den GERADE AUFRUFENDEN Pane, statt an
    ihren urspruenglichen Halter (Befund N5, zweiter Pruefpass, 2026-08-19:
    "die Verlaengerung soll am Leben des Workers haengen, nicht an einem
    Versprechen").

    DER FALL, DEN DAS LOEST: `nimm` liest den Halter-Pane aus der Umgebung DES
    AUFRUFERS ZUM ZEITPUNKT DER BUCHUNG (eigener_halter(), oben) -- wer VOR dem
    eigentlichen Arbeits-Pane bucht (etwa ein Orchestrator, der erst prueft, ob
    ueberhaupt Platz ist, und den Worker-Pane erst danach aufmacht), bucht unter
    dem FALSCHEN, kurzlebigen Pane. Die Buchung verfaellt dann, sobald DIESER
    kurze Aufrufer-Pane verschwindet (oder gar nie einen Pane hatte) -- nicht,
    wenn der eigentliche Worker stirbt. Genau das war die Ursache hinter Befund
    N5: die Buchung des Worker-Prozesses war an ein FRIST-VERSPRECHEN gebunden
    (die 240-Minuten-Frist ohne periodische Erneuerung), weil sie NIE einen
    lebendigen Pane als Halter hatte, der sie automatisch am Leben haelt.

    DIE LOESUNG: ruft der WORKER selbst (aus SEINEM eigenen, lang lebenden
    Pane heraus, sobald der existiert) `wb-belegung uebernehmen <kennung>` auf,
    haengt die Belegung ab diesem Moment an GENAU DIESEN Pane -- dieselbe
    Lebendigkeits-Pruefung wie bei jeder anderen Belegung mit Pane
    (zustand_bestimmen() oben: laeuft der Pane, bleibt die Belegung offen bzw.
    ueberfaellig, NIE verfallen; stirbt er, verfaellt sie sofort). Das ist eine
    TATSACHE (tmux weiss, ob ein Pane lebt), kein Versprechen (eine periodische
    `verlaengern`-Schleife, die vergessen, verzoegert oder abgebrochen werden
    kann). Danach ist die Frist fuer diese Belegung praktisch bedeutungslos --
    sie kann beliebig lange ueberfaellig bleiben, ohne je automatisch zu
    verfallen, solange der Pane lebt.

    Ohne messbaren Pane beim Aufruf (kein TMUX_PANE in der Umgebung) wird
    NICHTS uebernommen und ein Fehler gemeldet -- ein Uebernehmen INS LEERE
    waere schlimmer als der Ausgangszustand: es wuerde einen vielleicht noch
    gueltigen alten Halter durch gar keinen ersetzen."""
    neuer_halter = eigener_halter()
    if not neuer_halter.get("pane"):
        print("wb-belegung: kein TMUX_PANE in der Umgebung dieses Aufrufs -- "
              "nichts uebernommen. 'uebernehmen' ohne eigenen Pane wuerde den "
              "bisherigen Halter durch GAR KEINEN ersetzen, das waere schlimmer "
              "als der jetzige Zustand.", file=sys.stderr)
        return 2
    with Sperre():
        gueltige, entfernt = buch_pruefen(buch_lesen())
        getroffen = None
        for e in gueltige:
            if e.get("id") == a.kennung:
                e["halter"] = neuer_halter
                getroffen = e
        if not getroffen:
            # Verfallenes trotzdem schreiben, dieselbe Luecke wie in cmd_gib
            # (Fehler 2/3, Auftrag 2026-08-20).
            if entfernt:
                buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                                for e in gueltige])
            print("wb-belegung: keine Belegung mit der Kennung '%s'." % a.kennung, file=sys.stderr)
            return 1
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in gueltige])
    gib_aus("Uebernommen: %s haengt jetzt an Pane %s (Sitzung %s) -- verfaellt "
            "erst, wenn dieser Pane stirbt, nicht mehr nach einer Frist."
            % (a.kennung, neuer_halter["pane"], neuer_halter.get("sitzung") or "?"))
    return 0


def cmd_aufraeumen(a):
    # 'tot' (Nachtrag "Karteileiche", 2026-08-21 abends): buch_pruefen() haelt eine
    # tote Belegung ABSICHTLICH in 'gueltige' (sichtbar in 'wer', ausgeschlossen von
    # der Vergabe in entscheiden()) -- ERST hier, beim ausdruecklichen Aufraeumen,
    # wird sie wirklich aus dem Buch entfernt. Getrennt von 'verfallen' berichtet:
    # unterschiedliche Kriterien (Pane- gegen Prozess-Lebendigkeit), derselbe Leser
    # soll den Unterschied sehen koennen, nicht nur "irgendwas ist weg".
    with Sperre():
        gueltige, entfernt = buch_pruefen(buch_lesen())
        tot = [e for e in gueltige if e.get("_zustand") == "tot"]
        bleibt = [e for e in gueltige if e.get("_zustand") != "tot"]
        buch_schreiben([{k: v for k, v in e.items() if not k.startswith("_")}
                        for e in bleibt])
    if a.json:
        print(json.dumps({"verfallen": [{"id": e.get("id"), "grund": e.get("_grund")}
                                        for e in entfernt],
                          "tot": [{"id": e.get("id"), "grund": e.get("_grund")}
                                  for e in tot],
                          "offen": len(bleibt)}, indent=2, ensure_ascii=False))
        return 0
    if not entfernt and not tot:
        gib_aus("Nichts verfallen, nichts tot; %d Belegung(en) offen." % len(bleibt))
    for e in entfernt:
        gib_aus("verfallen: %s (%s GiB, %s) — %s"
                % (e.get("id"), zahl(e.get("gb", 0.0)), halter_text(e), e.get("_grund")))
    for e in tot:
        gib_aus("tot: %s (%s GiB, %s) — %s"
                % (e.get("id"), zahl(e.get("gb", 0.0)), halter_text(e), e.get("_grund")))
    return 0


def cmd_kv(a):
    if a.kv_befehl == "liste":
        modelle = kv_registry()
        if a.json:
            print(json.dumps(modelle, indent=2, ensure_ascii=False))
            return 0
        gib_aus("KV-Bedarf je Token (was ANGENOMMEN ist, traegt beim Rechnen den "
                "Sicherheitsfaktor %s):" % zahl(SICHERHEITSFAKTOR))
        for name in sorted(modelle):
            e = modelle[name]
            gib_aus("  %-24s %6s MiB/Token  %-11s %-9s %s"
                    % (name, zahl(e["mib_je_token"], 4), e.get("herkunft", "?"),
                       "KV " + kv_quant_von(e) if kv_quant_von(e) else "KV ?",
                       e.get("wann", "")))
            if e.get("notiz"):
                gib_aus("  %-24s %s" % ("", e["notiz"]))
        return 0
    # setzen
    if a.herkunft not in ("gemessen", "angenommen"):
        fehler("--herkunft muss 'gemessen' oder 'angenommen' sein.")
    if not a.modell.strip():
        fehler("ohne Modellnamen laesst sich kein KV-Bedarf eintragen.")
    # Eine Null oder eine negative Zahl steht danach DAUERHAFT im Buch und gilt fuer
    # jede kuenftige Anfrage zu diesem Modell. Gemessen im Pruefdurchgang vom 11.08.:
    # -2,0 wurde angenommen, und die naechste Anfrage rechnete eine Spitze von
    # -230 GiB und bekam ein Ja.
    a.mib = pruefe_zahl(a.mib, "der KV-Bedarf je Token", 0, strikt=True)
    with Sperre():
        daten = json_lesen(KV_DATEI, {"version": 1, "modelle": {}})
        daten.setdefault("modelle", {})
        daten["modelle"][a.modell.lower()] = {
            "mib_je_token": float(a.mib),
            "herkunft": a.herkunft,
            "wann": time.strftime("%Y-%m-%d"),
            "notiz": a.notiz or "",
            # Leerer String heisst "nicht vermerkt" und ist NICHT dasselbe wie "off"
            # -- siehe kv_quant_von() oben.
            "kv_quant": (a.kv_quant or "").strip().lower(),
        }
        atomar_schreiben(KV_DATEI, daten)
    gib_aus("Eingetragen: %s = %s MiB/Token (%s%s)."
            % (a.modell, zahl(a.mib, 4), a.herkunft,
               ", KV-Cache %s" % a.kv_quant if a.kv_quant else ", Cache-Quantisierung nicht vermerkt"))
    return 0


