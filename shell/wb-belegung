def pruefe_zahl(wert, name, mindest, strikt=False):
    """Endlich, und nicht unter der Schranke. Sonst Abbruch mit Klartext.

    Befund 4 des Pruefdurchgangs vom 11.08.: ohne diese Pruefung wurden
    `--parallel -5` und `--kontext 0` klaglos auf null geklemmt — die Spitze bestand
    dann nur noch aus Gewichten und Zuschlag, also genau aus der Belegung, die der
    Kopf dieses Werkzeugs als toedlich beschreibt. `nimm --gb -5` stand mit -5,0 GiB
    im Buch und vergroesserte ueber Grenze B die Kapazitaet fuer alle anderen.

    nan und Unendlich werden ausdruecklich abgewiesen, weil sie sich nicht wie Zahlen
    verhalten: `min(30.0, float('nan'))` gibt in Python 30.0 zurueck, ein
    `--reserve-gb nan` hat Grenze B damit lautlos abgeschaltet."""
    if wert is None:
        return None
    w = float(wert)
    if math.isnan(w) or math.isinf(w):
        fehler("%s: '%s' ist keine endliche Zahl. Mit nan oder Unendlich laesst sich "
               "keine Grenze rechnen — sie faellt dann lautlos aus." % (name, wert))
    if strikt and w <= mindest:
        fehler("%s muss groesser als %s sein, angegeben ist %s."
               % (name, zahl(mindest, 1), zahl(w, 2)))
    if not strikt and w < mindest:
        fehler("%s darf nicht unter %s liegen, angegeben ist %s."
               % (name, zahl(mindest, 1), zahl(w, 2)))
    return w


def pruefe_buch(gueltige):
    """Keine Zahl aus dem Buch geht ungeprueft in eine Grenze. Ein Eintrag mit einer
    unbrauchbaren Groesse haelt die Entscheidung an, statt sie zu verfaelschen — er
    kann von einer aelteren Fassung stammen oder von Hand geschrieben sein."""
    for e in gueltige:
        try:
            w = float(e.get("gb"))
        except (TypeError, ValueError):
            w = float("nan")
        if math.isnan(w) or math.isinf(w) or w <= 0:
            fehler("die Belegung %s traegt die unbrauchbare Groesse '%s'. Es wird nichts "
                   "entschieden, solange sie im Buch steht.\n"
                   "         Entfernen: wb-belegung gib %s --fremd"
                   % (e.get("id", "?"), e.get("gb"), e.get("id", "?")), code=3)


def atomar_schreiben(pfad, objekt):
    """Nie halb lesbar: erst vollstaendig in eine Nachbardatei, dann ein
    os.replace() — das ist auf demselben Dateisystem ein einziger Schritt."""
    os.makedirs(os.path.dirname(pfad), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(pfad), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(objekt, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, pfad)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def json_lesen(pfad, vorgabe):
    try:
        with open(pfad) as f:
            wert = json.load(f)
        return wert if isinstance(wert, dict) else dict(vorgabe)
    except (OSError, ValueError):
        # Eine kaputte oder fehlende Datei ist kein Fehler, sondern ein leeres Buch.
        # Ein Werkzeug, das an dieser Stelle abbricht, sperrt die Maschine genau
        # dann, wenn ohnehin schon etwas schiefging.
        return dict(vorgabe)


class Sperre(object):
    """Ausschliessliche Sperre mit FRIST. Blockierend zu warten waere hier der
    naechste Weg, die Maschine anzuhalten; nach der Frist gibt es eine klare
    Meldung und Exit 3."""

    def __init__(self, frist_s=30.0):
        self.frist_s = frist_s
        self.f = None

    def __enter__(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.f = open(SPERRDATEI, "w")
        ende = time.monotonic() + self.frist_s
        while True:
            try:
                fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.monotonic() >= ende:
                    fehler("das Buch ist seit %d s gesperrt (%s) — nichts geaendert."
                           % (int(self.frist_s), SPERRDATEI), code=3)
                time.sleep(0.1)

    def __exit__(self, *_):
        try:
            fcntl.flock(self.f, fcntl.LOCK_UN)
            self.f.close()
        except OSError:
            pass
        return False


