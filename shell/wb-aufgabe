# ---------------------------------------------------------------- Mensch --
def _wb_mensch_pfad():
    p = os.path.join(os.path.expanduser("~"), ".local", "bin", "wb-mensch")
    if os.access(p, os.X_OK):
        return p
    from shutil import which
    return which("wb-mensch") or None


def _ist_mensch_gemessen():
    pfad = _wb_mensch_pfad()
    if not pfad:
        return False
    try:
        return subprocess.run([pfad, "pruefen"], timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _beleg_datei_sagt_mensch(pfad):
    if not pfad:
        return False
    try:
        with open(pfad, "r", encoding="utf-8") as f:
            inhalt = f.read()
    except OSError:
        return False
    erstes_wort = inhalt.strip().split()[0] if inhalt.strip() else ""
    return erstes_wort.split("\t")[0] == "mensch"


# --mensch-beleg gilt NUR im Testbett (Reviewer-Befund 2/7, 2026-09-10): eine
# Belegdatei, deren Gueltigkeit nirgends an eine Testumgebung gebunden ist, kann
# sich ein autonomer Hauptagent im echten Betrieb selbst schreiben und sich damit
# Freigabe, Abnahme oder Verwerfen erteilen. Im echten HOME (kein --base/--vorrat/
# WB_VORRAT nach ausserhalb zeigend) zaehlt deshalb ausschliesslich die GEMESSENE
# Herkunft ueber `wb-mensch pruefen`.
def im_testbett(args):
    home = os.path.realpath(os.path.expanduser("~"))

    def aussen(pfad):
        if not pfad:
            return False
        real = os.path.realpath(pfad)
        return real != home and not real.startswith(home + os.sep)

    if aussen(getattr(args, "base", None)):
        return True
    if aussen(os.environ.get("WB_VORRAT")):
        return True
    if aussen(getattr(args, "vorrat", None)):
        return True
    return False


def mensch_verlangen(args, wofuer):
    if _ist_mensch_gemessen():
        return
    beleg = getattr(args, "mensch_beleg", None)
    if beleg:
        if not im_testbett(args):
            fehler(
                "--mensch-beleg gilt nur im Testbett (--base/--vorrat/WB_VORRAT "
                "ausserhalb des echten HOME) — im echten HOME zaehlt ausschliesslich "
                "'wb-mensch pruefen'."
            )
        if _beleg_datei_sagt_mensch(beleg):
            return
    fehler(
        "%s darf nur ein MENSCH — gemessen von 'wb-mensch pruefen' oder, im "
        "Testbett, belegt ueber --mensch-beleg <pfad> (erstes Wort 'mensch')." % wofuer
    )


