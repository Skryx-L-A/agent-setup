TRAEGER_NACHSEHEN_AN = os.environ.get("WB_TRAEGER_NACHSEHEN", "1") != "0"


def traeger_anstossen(args):
    """`wb-traeger nachsehen` abgelöst starten, wenn es im PATH liegt (sonst
    Hinweis auf stderr). Bewusst Popen und kein wait: der Aufrufer (Mensch,
    Oberflaeche, Companion) wartet nie auf den Takt."""
    wb = shutil.which("wb-traeger")
    if not wb:
        sys.stderr.write(
            "wb-aufgabe: wb-traeger liegt nicht im PATH — es wurde kein "
            "Träger-Nachsehen angestoßen.\n")
        return
    try:
        subprocess.Popen(
            [wb, "nachsehen", "--base", os.path.abspath(args.base),
             "--vorrat", os.path.abspath(vorrat_root_bestimmen(args))],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        sys.stderr.write(
            "wb-aufgabe: wb-traeger nachsehen liess sich nicht starten (%s).\n" % e)


def fehler(text):
    sys.stderr.write("wb-aufgabe: FEHLER — %s\n" % text)
    sys.exit(2)


def jetzt_iso():
    roh = os.environ.get("WB_TRAEGER_JETZT", "").strip()
    if roh:
        d = datetime.datetime.fromisoformat(roh[:-1] + "+00:00" if roh.endswith("Z") else roh)
        if d.tzinfo is None:
            d = d.replace(tzinfo=datetime.timezone.utc)
        return d.astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def jetzt_ms():
    return int(datetime.datetime.now(datetime.timezone.utc).timestamp() * 1000)


