def cmd_stand(args):
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)

    if args.stand not in STAENDE:
        fehler("Stand '%s' ist ungueltig (erlaubt: %s)" % (args.stand, ", ".join(STAENDE)))
    endgueltig_pruefen(verlauf, args.id)

    von = args.von
    if args.stand in STAENDE_MENSCH_PFLICHT:
        mensch_verlangen(args, "eine Aufgabe auf '%s' setzen" % args.stand)
        von = "mensch"

    alt = verlauf.get("stand")
    verlauf["stand"] = args.stand
    verlauf["grund"] = args.grund or ""
    if args.weckzeit is not None:
        verlauf["weckzeit"] = None if args.weckzeit == "keine" else args.weckzeit
    # steckt_vorher (Bau-Schritt 2): beim UEBERGANG auf „steckt" merkt sich das
    # Feld den vorigen Stand, damit der Träger ihn wiederherstellen kann, wenn
    # die Umgebung wieder da ist. Jeder Wechsel WEG von „steckt" leert es.
    if args.stand == "steckt":
        if alt != "steckt":
            verlauf["steckt_vorher"] = alt
    else:
        verlauf["steckt_vorher"] = None
    if args.stand == "steckt":
        verlauf_anhaengen(verlauf, verlauf_eintrag(
            "steckt", "Stand '%s' -> 'steckt'%s" % (alt, (" (%s)" % args.grund) if args.grund else ""),
            von=von))
    else:
        verlauf_anhaengen(verlauf, verlauf_eintrag(
            "pausiert" if args.stand.startswith("pausiert") else "runde",
            "Stand '%s' -> '%s'%s" % (alt, args.stand, (" (%s)" % args.grund) if args.grund else ""),
            von=von))
    json_schreiben(verlauf_datei, verlauf)
    ausgabe(args, "wb-aufgabe: '%s' steht jetzt auf '%s'." % (args.id, args.stand),
            daten={"id": args.id, "stand": args.stand})
    if TRAEGER_NACHSEHEN_AN:
        traeger_anstossen(args)
    return 0


