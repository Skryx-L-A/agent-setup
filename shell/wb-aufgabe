def cmd_worker(args):
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)
    worker = verlauf.setdefault("worker", [])

    if args.aktion == "setzen":
        endgueltig_pruefen(verlauf, args.id)
        neuer = {
            "name": args.name, "rolle": args.rolle, "zustand": args.zustand,
            "pane": args.pane, "ergebnispfad": args.ergebnis, "aufgabe_id": args.id,
        }
        for i, w in enumerate(worker):
            if w.get("name") == args.name:
                worker[i] = neuer
                break
        else:
            worker.append(neuer)
        team = verlauf.setdefault("team", [])
        if not any(t.get("rolle") == args.rolle for t in team):
            team.append({"rolle": args.rolle, "herkunft": "besetzt"})
        verlauf_anhaengen(verlauf, verlauf_eintrag(
            "worker-vergeben", "Worker '%s' (Rolle %s) -> %s" % (args.name, args.rolle, args.zustand)))
        json_schreiben(verlauf_datei, verlauf)
        ausgabe(args, "wb-aufgabe: Worker '%s' gesetzt." % args.name,
                daten={"id": args.id, "worker": args.name})
        return 0

    # entfernen
    vorher = len(worker)
    verlauf["worker"] = [w for w in worker if w.get("name") != args.name]
    if len(verlauf["worker"]) == vorher:
        fehler("Worker '%s' ist bei '%s' nicht bekannt." % (args.name, args.id))
    verlauf_anhaengen(verlauf, verlauf_eintrag("worker-vergeben", "Worker '%s' entfernt." % args.name))
    json_schreiben(verlauf_datei, verlauf)
    ausgabe(args, "wb-aufgabe: Worker '%s' entfernt." % args.name,
            daten={"id": args.id, "worker": args.name})
    return 0


