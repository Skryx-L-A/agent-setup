def auftrag_hash(auftrag):
    ohne_approval = {k: v for k, v in auftrag.items() if k != "approval"}
    kanonisch = json.dumps(ohne_approval, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(kanonisch.encode("utf-8")).hexdigest()


# Gemeinsame Prüfungen, die auch wb-traeger aus dieser Datei lädt, damit beide
# Werkzeuge nie verschieden urteilen.
def freigabe_gueltig(auftrag):
    """Freigegeben ist nur, wessen Hash zum heutigen Auftragstext passt; ein
    von Hand eingetragenes oder nach der Freigabe verändertes approval zählt nicht."""
    approval = auftrag.get("approval")
    return isinstance(approval, dict) and approval.get("text_sha256") == auftrag_hash(auftrag)


def repo_schluessel(pfad):
    """Vergleichsform eines Projektpfads: Symlinks aufgelöst; auf macOS ohne
    Groß- und Kleinschreibung, weil APFS sie in der Vorgabe nicht unterscheidet."""
    if not pfad:
        return None
    echt = os.path.realpath(pfad)
    return echt.lower() if sys.platform == "darwin" else os.path.normcase(echt)


def pid_lebt(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def belegt_repo(verlauf):
    """Das Repo einer Aufgabe ist belegt, solange sie läuft, ihr Hauptagent
    lebt, oder sie in einem Stand, in dem der Hauptagent weiterarbeiten darf,
    noch arbeitende Worker führt."""
    stand = verlauf.get("stand") or ""
    if stand == "läuft":
        return True
    sitzung = verlauf.get("hauptagent_sitzung") or {}
    if sitzung.get("pid") and pid_lebt(sitzung["pid"]):
        return True
    weiterarbeitend = stand in ("wartet auf den Nutzer", "zur Abnahme") or stand.startswith("pausiert")
    return weiterarbeitend and any(w.get("zustand") == "arbeitet" for w in (verlauf.get("worker") or []))


def pfad_gueltig(pfad):
    """Ein Eintrag in `pfade`: relativ, innerhalb des Repos, nie die Wurzel."""
    if not isinstance(pfad, str) or not pfad.strip() or os.path.isabs(pfad):
        return False
    if ".." in pfad.replace("\\", "/").split("/"):
        return False
    return os.path.normpath(pfad) not in (".", "")


_SPERREN = []


def verlauf_sperren(verlauf_datei):
    """flock auf <verlauf>.lock bis zum Prozessende: jeder Lese-Ändere-
    Schreib-Weg eines Aufrufs liegt damit unter einer Sperre."""
    f = open(verlauf_datei + ".lock", "a")
    fcntl.flock(f, fcntl.LOCK_EX)
    _SPERREN.append(f)


GITIGNORE_ZEILE = ".companion/auftraege/"


def gitignore_sichern(projekt):
    """In einem git-Projekt gehört .companion/auftraege/ in .gitignore: die
    Verlaufsdatei ändert sich je Takt, und über die Maschinengrenze gehen
    Auftrag und Verlauf per scp, nicht über git. Rückgabe True, wenn ergänzt."""
    if subprocess.run(["git", "-C", projekt, "rev-parse", "--git-dir"],
                      capture_output=True, timeout=30).returncode != 0:
        return False
    pfad = os.path.join(projekt, ".gitignore")
    try:
        with open(pfad, "r", encoding="utf-8") as f:
            vorhanden = f.read()
    except OSError:
        vorhanden = ""
    gedeckt = (GITIGNORE_ZEILE, "/" + GITIGNORE_ZEILE, ".companion/", "/.companion/", ".companion", "/.companion")
    if any(z.strip() in gedeckt for z in vorhanden.splitlines()):
        return False
    with open(pfad, "a", encoding="utf-8") as f:
        f.write(("" if not vorhanden or vorhanden.endswith("\n") else "\n") + GITIGNORE_ZEILE + "\n")
    return True


def geladen_aus_id(args):
    vorrat_root = vorrat_root_bestimmen(args)
    eintrag = vorrat_eintrag_lesen(vorrat_root, args.id)
    auftrag_pfad = eintrag["auftrag"]
    auftrag = auftrag_lesen(auftrag_pfad)
    verlauf_datei = verlauf_pfad_aus(args.id, auftrag_pfad)
    verlauf_sperren(verlauf_datei)
    verlauf = verlauf_lesen(verlauf_datei)
    return vorrat_root, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf


# ------------------------------------------------------------- anlegen --
def cmd_anlegen(args):
    base = args.base
    projekt = os.path.abspath(args.projekt)
    vorrat_root = vorrat_root_bestimmen(args)
    os.makedirs(vorrat_root, exist_ok=True)

    maschine = args.maschine or einstellung("agents.standardMaschine", "peer", base)
    hauptagent_roh = args.hauptagent or einstellung("agents.hauptagentModell", "opus5:xhigh", base)
    modell, effort = modell_effort_teilen(hauptagent_roh, "high")
    # Gespeichert wird die Registry-Kennung, nicht der Alias: der Träger kann
    # auf einer Maschine laufen, deren Registry den Alias nicht kennt.
    eintrag = registry_eintrag(modell, base)
    if eintrag is None:
        fehler("Modell '%s' ist nicht in der Registry (weder Kennung noch Alias); "
               "die Liste zeigt 'wb-state models list'." % modell)
    modell = eintrag["id"]

    fallback_roh = args.fallback or einstellung("agents.fallbackModell", FALLBACK_VORGABE, base)
    if fallback_roh == "keins":
        fallback = None
    else:
        fb_modell, fb_effort = modell_effort_teilen(fallback_roh, "medium")
        if ist_fable(fb_modell):
            fehler("Fable ist nie ein Fallback ('%s')." % fb_modell)
        if args.daten_lokal and modell_klasse(fb_modell, base) != "lokal":
            fehler("--daten-lokal verlangt ein lokales Fallback-Modell oder 'keins' "
                   "('%s' ist nicht als lokal bekannt)." % fb_modell)
        fallback = {"model": fb_modell, "effort": fb_effort}

    nachtmodus = args.nachtmodus or "pausieren"
    if nachtmodus not in NACHTMODUS_WERTE:
        fehler("--nachtmodus muss einer von %s sein" % ", ".join(NACHTMODUS_WERTE))

    freigaben = {a: (a in (args.freigabe or [])) for a in FREIGABE_ARTEN}
    for a in (args.freigabe or []):
        if a not in FREIGABE_ARTEN:
            fehler("--freigabe kennt '%s' nicht (erlaubt: %s)" % (a, ", ".join(FREIGABE_ARTEN)))

    id_ = kennung_erzeugen(args.ziel, vorrat_root)
    auftrag_pfad = os.path.join(projekt, ".companion", "auftraege", "%s.json" % id_)
    verlauf_datei = verlauf_pfad_aus(id_, auftrag_pfad)

    stand_anfang, grund_anfang = "offen", ""
    if args.daten_lokal:
        klasse = modell_klasse(modell, base)
        if klasse == "cloud":
            grund_anfang = "Daten lokal, Hauptagent Cloud"
        else:
            grund_anfang = "Daten lokal, lokaler Hauptagent noch nicht gemessen"
        stand_anfang = "wartet auf den Nutzer"

    auftrag = {
        "schema_version": 1,
        "id": id_,
        "project": projekt,
        "goal": args.ziel,
        "done_criterion": args.fertig,
        "reference": None,
        "guardrails": [],
        "gate_commands": [],
        "limits": {"iterations": None, "tokens": None, "time_seconds": None},
        "loop_type": "loop",
        "model": modell,
        "approval": None,
        "freigaben": freigaben,
        "hauptagent": {"model": modell, "effort": effort, "fallback": fallback},
        "maschine": maschine,
        "grenzen": {
            "frist": args.frist,
            "runden": args.runden,
            "nachtmodus": nachtmodus,
            "nachtfenster": None,
            "daten-lokal": bool(args.daten_lokal),
        },
    }
    verlauf = {
        "id": id_,
        "stand": stand_anfang,
        "grund": grund_anfang,
        "maschine": maschine,
        "worker": [],
        "team": [],
        "verlauf": [],
        "ergebnis": {"pfad": None, "commit": None, "belege": [], "reviewer_befunde": []},
        "kosten": {"token_schaetzung": None, "lokale_stunden": None},
        "wiederaufnahme": "",
        "weckzeit": None,
        "frage": None,
        "pfade": [],
        "hauptagent_sitzung": None,
        "steckt_vorher": None,
    }
    verlauf_anhaengen(verlauf, verlauf_eintrag("gestartet", "Aufgabe angelegt: %s" % args.ziel))
    if grund_anfang:
        verlauf_anhaengen(verlauf, verlauf_eintrag("pausiert", grund_anfang))

    if gitignore_sichern(projekt):
        verlauf_anhaengen(verlauf, verlauf_eintrag(
            "gitignore", "'%s' in .gitignore des Projekts ergänzt." % GITIGNORE_ZEILE))
    json_schreiben(auftrag_pfad, auftrag)
    json_schreiben(verlauf_datei, verlauf)

    bestehende_raenge = []
    for name in os.listdir(vorrat_root) if os.path.isdir(vorrat_root) else []:
        if name.endswith(".json") and not name.startswith("."):
            try:
                with open(os.path.join(vorrat_root, name), "r", encoding="utf-8") as f:
                    bestehende_raenge.append(json.load(f).get("rang", 0))
            except (OSError, json.JSONDecodeError):
                continue
    rang = args.rang if args.rang is not None else (max(bestehende_raenge) + 1 if bestehende_raenge else 1)

    vorrat_eintrag = {
        "rang": rang, "projekt": projekt, "auftrag": auftrag_pfad,
        "maschine": maschine, "aufgenommen": jetzt_iso(),
    }
    json_schreiben(vorrat_pfad(vorrat_root, id_), vorrat_eintrag)

    ausgabe(args, id_, daten={"id": id_, "auftrag": auftrag_pfad, "stand": stand_anfang})
    return 0


