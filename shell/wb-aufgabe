    gemeinsam.add_argument("--vorrat", default=None)
    gemeinsam.add_argument("--json", action="store_true")

    ap = argparse.ArgumentParser(prog="wb-aufgabe")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("anlegen", parents=[gemeinsam])
    p.add_argument("projekt")
    p.add_argument("--ziel", required=True)
    p.add_argument("--fertig", required=True)
    p.add_argument("--maschine")
    p.add_argument("--hauptagent")
    p.add_argument("--fallback")
    p.add_argument("--rang", type=int, default=None)
    # Kein choices= (Reviewer-Hinweis 9): argparse lehnt einen ungueltigen Wert
    # sonst selbst ab, mit einer englischen Meldung, bevor unser eigener,
    # deutscher fehler()-Weg unten je zum Zug kommt.
    p.add_argument("--nachtmodus")
    p.add_argument("--daten-lokal", action="store_true")
    p.add_argument("--frist")
    p.add_argument("--runden", type=int, default=None)
    p.add_argument("--freigabe", action="append")
    p.set_defaults(func=cmd_anlegen)

    p = sub.add_parser("freigeben", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("--mensch-beleg", dest="mensch_beleg")
    p.add_argument("--neu-freigeben", action="store_true")
    p.set_defaults(func=cmd_freigeben)

    p = sub.add_parser("stand", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("stand")
    p.add_argument("--grund")
    p.add_argument("--von")
    p.add_argument("--weckzeit")
    p.add_argument("--mensch-beleg", dest="mensch_beleg")
    p.set_defaults(func=cmd_stand)

    p = sub.add_parser("verlauf", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("art")
    p.add_argument("text")
    p.add_argument("--von")
    p.add_argument("--kennung")
    p.add_argument("--grund")
    p.add_argument("--bis")
    p.set_defaults(func=cmd_verlauf)

    p = sub.add_parser("worker", parents=[gemeinsam])
    p.add_argument("id")
    wsub = p.add_subparsers(dest="aktion", required=True)
    ws = wsub.add_parser("setzen", parents=[gemeinsam])
    ws.add_argument("name")
    ws.add_argument("--rolle", required=True)
    ws.add_argument("--zustand", required=True)
    ws.add_argument("--pane")
    ws.add_argument("--ergebnis")
    we = wsub.add_parser("entfernen", parents=[gemeinsam])
    we.add_argument("name")
    p.set_defaults(func=cmd_worker)

    p = sub.add_parser("frage", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("--text", required=True)
    p.add_argument("--option", action="append", required=True)
    p.add_argument("--empfehlung")
    p.set_defaults(func=cmd_frage)

    p = sub.add_parser("antwort", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("text")
    p.add_argument("--mensch-beleg", dest="mensch_beleg")
    p.set_defaults(func=cmd_antwort)

    p = sub.add_parser("wiederaufnahme", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("text")
    p.set_defaults(func=cmd_wiederaufnahme)

    p = sub.add_parser("weckzeit", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("wert")
    p.set_defaults(func=cmd_weckzeit)

    p = sub.add_parser("rang", parents=[gemeinsam])
    p.add_argument("id")
    p.add_argument("n", type=int)
    p.set_defaults(func=cmd_rang)

    p = sub.add_parser("pfade", parents=[gemeinsam])
    p.add_argument("id")
    psub = p.add_subparsers(dest="aktion", required=True)
    ps = psub.add_parser("setzen", parents=[gemeinsam])
    ps.add_argument("pfad", nargs="+")
    pe = psub.add_parser("entfernen", parents=[gemeinsam])
    pe.add_argument("pfad", nargs="+")
    p.set_defaults(func=cmd_pfade)

    p = sub.add_parser("sitzung", parents=[gemeinsam])
