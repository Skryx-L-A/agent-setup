# --------------------------------------------------------- Einstellungen --
def einstellung(schluessel, vorgabe, base):
    """`wb-state settings get <schluessel>`, wenn das geht (nicht-leere
    Ausgabe, Exit 0); sonst direkt aus <base>/.claude/workbench/settings.json
    gelesen, punktweise verschachtelt (agents.standardMaschine -> cfg["agents"]
    ["standardMaschine"]). wb-state kennt diesen punktierten Schluessel heute
    nicht (flache DEFAULTS, siehe dessen 'settings get') — der Fallback ist
    deshalb der Normalfall, nicht ein Sonderfall fuer kaputte Installationen."""
    try:
        r = subprocess.run(["wb-state", "settings", "get", schluessel],
                            capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    pfad = os.path.join(base, ".claude", "workbench", "settings.json")
    try:
        with open(pfad, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, json.JSONDecodeError):
        return vorgabe
    node = cfg
    for teil in schluessel.split("."):
        if not isinstance(node, dict) or teil not in node:
            return vorgabe
        node = node[teil]
    if node is None:
        return vorgabe
    return node


# -------------------------------------------------------- Modell-Klasse --
# Die EINE Stelle, an der eine Modellangabe zum Registry-Eintrag wird; wb-traeger
# lädt sie von hier (wa().registry_eintrag), damit Anlegen und Träger nie
# verschieden urteilen. Gemessen am 11.09.: `anlegen --hauptagent sonnet5:high`
# ging durch, der Träger meldete „Modell nicht in der Registry: sonnet5".
def registry_eintrag(model_id, base):
    """Der Registry-Eintrag zu einer Kennung oder einem Alias, in der
    Reihenfolge von `wb-state models resolve` (erst die Kennung, dann der
    Alias, case-sensitiv). Es gilt die Registry <base>/.claude/workbench/
    models.json, dieselbe Datei, die wb-state liest; nur wenn sie fehlt oder
    unlesbar ist, die Auslieferung shell/models.default.json neben diesem
    Skript. Ein Eintrag, den nur die Auslieferung kennt, gilt also nicht,
    solange es eine Registry gibt, genau wie bei wb-state. None, wenn unbekannt."""
    for pfad in (os.path.join(base, ".claude", "workbench", "models.json"),
                 os.path.join(SKRIPT_DIR, "models.default.json")):
        try:
            with open(pfad, "r", encoding="utf-8") as f:
                reg = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        modelle = [e for e in reg.get("models") or [] if isinstance(e, dict) and e.get("id")]
        return (next((e for e in modelle if e["id"] == model_id), None)
                or next((e for e in modelle if e.get("alias") == model_id), None))
    return None


def modell_klasse(model_id, base):
    """'cloud' | 'lokal' | 'unbekannt', gemessen an harness/provider des
    Registry-Eintrags (registry_eintrag)."""
    eintrag = registry_eintrag(model_id, base)
    if eintrag is None:
        return "unbekannt"
    if eintrag.get("harness") == "claude" or eintrag.get("provider") == "claude-subscription":
        return "cloud"
    return "lokal"


def ist_fable(model_id):
    """'Fable ist nie ein Fallback' (docs/AGENTS-PLAN.md) -- Fable-Modelle
    heissen immer 'fable...' (Alias) oder 'claude-fable-...' (id), eine
    Teilzeichenkette reicht, case-insensitiv."""
    return "fable" in model_id.lower()


def modell_effort_teilen(roh, effort_vorgabe):
    if ":" in roh:
        modell, effort = roh.rsplit(":", 1)
    else:
        modell, effort = roh, effort_vorgabe
    return modell, effort


# --------------------------------------------------------------- Kennung --
_UMLAUTE = str.maketrans({
    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
})


def slug_aus_text(text, laenge=40):
    s = text.translate(_UMLAUTE).lower()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    if len(s) > laenge:
        s = s[:laenge].rstrip("-")
    return s or "aufgabe"


def kennung_erzeugen(ziel, vorrat_root):
    basis = "%s-%s" % (datetime.date.today().strftime("%Y%m%d"), slug_aus_text(ziel))
    kandidat, n = basis, 2
    while os.path.exists(os.path.join(vorrat_root, "%s.json" % kandidat)):
        kandidat = "%s-%d" % (basis, n)
        n += 1
    return kandidat


