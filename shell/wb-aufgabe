def cmd_verlauf(args):
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)

    if args.art == "zustellung" and args.kennung:
        for e in verlauf.get("verlauf", []):
            if e.get("art") == "zustellung" and e.get("kennung") == args.kennung:
                ausgabe(args, "schon quittiert", daten={"id": args.id, "schon_quittiert": True})
                return 0

    zusatz = {}
    if args.kennung:
        zusatz["kennung"] = args.kennung
    if args.grund:
        zusatz["grund"] = args.grund
    # `wach --bis <iso>`: Weg 1 des Plans (wach bleiben, sich selbst wecken).
    # Bis zu dieser Zeit gilt der Hauptagent für die Sicherung als entschieden.
    if args.art == "wach" and not args.bis:
        fehler("'verlauf <id> wach' braucht --bis <ISO-Zeit>.")
    if args.bis:
        try:
            datetime.datetime.fromisoformat(args.bis[:-1] + "+00:00" if args.bis.endswith("Z") else args.bis)
        except ValueError:
            fehler("--bis '%s' ist keine ISO-Zeit." % args.bis)
        zusatz["bis"] = args.bis
    verlauf_anhaengen(verlauf, verlauf_eintrag(args.art, args.text, von=args.von, zusatz=zusatz or None))
    json_schreiben(verlauf_datei, verlauf)
    ausgabe(args, "wb-aufgabe: Verlaufseintrag '%s' fuer '%s' angehaengt." % (args.art, args.id),
            daten={"id": args.id, "art": args.art})
    return 0


