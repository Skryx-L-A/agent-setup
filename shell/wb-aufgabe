            "sitzung", "Sitzung des Hauptagenten geleert (Sitzung endgültig weg).", von="traeger"))
        json_schreiben(verlauf_datei, verlauf)
        ausgabe(args, "wb-aufgabe: hauptagent_sitzung von '%s' geleert." % args.id,
                daten={"id": args.id, "hauptagent_sitzung": None})
        return 0
    if args.aktion == "gesehen":
        sitzung = verlauf.get("hauptagent_sitzung") or {}
        sitzung["zuletzt_gesehen"] = jetzt_iso()
        verlauf["hauptagent_sitzung"] = sitzung
        json_schreiben(verlauf_datei, verlauf)
        ausgabe(args, "wb-aufgabe: '%s' zuletzt gesehen %s." % (args.id, sitzung["zuletzt_gesehen"]),
                daten={"id": args.id, "zuletzt_gesehen": sitzung["zuletzt_gesehen"]})
        return 0
    sitzung = verlauf.get("hauptagent_sitzung") or {}
    for feld in ("tmux_session", "pane", "claude_session_id", "pid"):
        wert = getattr(args, feld, None)
        if wert is not None:
            sitzung[feld] = wert
    sitzung["gestartet"] = args.gestartet or jetzt_iso()
    sitzung.setdefault("zuletzt_gesehen", sitzung["gestartet"])
    verlauf["hauptagent_sitzung"] = sitzung
    endgueltig_pruefen(verlauf, args.id)
    verlauf_anhaengen(verlauf, verlauf_eintrag(
        "sitzung", "Hauptagent-Sitzung gesetzt: %s%s" % (
            sitzung.get("tmux_session") or sitzung.get("pane") or "?",
            (" (PID %s)" % sitzung["pid"]) if sitzung.get("pid") else ""),
        von="traeger"))
    json_schreiben(verlauf_datei, verlauf)
    ausgabe(args, "wb-aufgabe: hauptagent_sitzung von '%s' gesetzt." % args.id,
            daten={"id": args.id, "hauptagent_sitzung": sitzung})
    return 0


