def cmd_naechste(args):
    """Die vorderste offene Aufgabe nach Rang, die freigegeben ist und deren
    Repo von keiner Aufgabe im Stand „läuft" belegt ist. Exit 0 mit JSON, wenn
    es eine gibt; Exit 1 mit einer deutschen Meldung, wenn nicht."""
    vorrat_root = vorrat_root_bestimmen(args)
    kandidaten = []
    for name in sorted(os.listdir(vorrat_root)) if os.path.isdir(vorrat_root) else []:
        if not name.endswith(".json") or name.startswith("."):
            continue
        try:
            with open(os.path.join(vorrat_root, name), "r", encoding="utf-8") as f:
                eintrag = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        kandidaten.append((eintrag.get("rang", 0), name[:-len(".json")], eintrag))
    kandidaten.sort(key=lambda k: (k[0], k[1]))

    belegte = []
    for rang, id_, eintrag in kandidaten:
        try:
            verlauf = verlauf_lesen(verlauf_pfad_aus(id_, eintrag["auftrag"]))
        except (SystemExit, KeyError, TypeError):
            continue
        if belegt_repo(verlauf):
            belegte.append((repo_schluessel(eintrag.get("projekt")), id_))
    ausser = set(args.ausser or [])
    zurueckgestellt = []
    for rang, id_, eintrag in kandidaten:
        if id_ in ausser:
            continue
        # Ein Eintrag ohne Maschine gilt als einer der eigenen Maschine.
        if args.maschine and (eintrag.get("maschine") or args.maschine) != args.maschine:
            continue
        try:
            verlauf = verlauf_lesen(verlauf_pfad_aus(id_, eintrag["auftrag"]))
            auftrag = auftrag_lesen(eintrag["auftrag"])
        except (SystemExit, KeyError, TypeError):
            continue
        if verlauf.get("stand") != "offen":
            continue
        if not auftrag.get("approval"):
            continue
        if not freigabe_gueltig(auftrag):
            zurueckgestellt.append({"id": id_, "grund": "Freigabe ungültig", "warten": True})
            continue
        schluessel = repo_schluessel(eintrag.get("projekt"))
        andere = next((b for s, b in belegte if s == schluessel and b != id_), None) if schluessel else None
        if andere:
            zurueckgestellt.append({"id": id_, "grund": "Repo belegt durch Aufgabe %s" % andere})
            continue
        hauptagent = auftrag.get("hauptagent") or {}
        ausgabe(args, "%s" % id_, daten={
            "id": id_, "rang": rang, "projekt": eintrag.get("projekt"),
            "maschine": eintrag.get("maschine"), "hauptagent": hauptagent,
            "freigegeben": bool(auftrag.get("approval")), "stand": "offen",
            "zurueckgestellt": zurueckgestellt,
        })
        return 0
    if args.json:
        print(json.dumps({"id": None, "zurueckgestellt": zurueckgestellt}, ensure_ascii=False))
    sys.stderr.write("wb-aufgabe: keine startbare Aufgabe im Vorrat.\n")
    return 1


# ----------------------------------------------------- aufnehmen (Schritt 2) --
def cmd_aufnehmen(args):
    """Vorratseintrag für eine schon im Projekt liegende Auftragsdatei — der
    Weg, über den der Träger die Aufgabe eines fremden Trägers per ssh auf der
    Zielmaschine in dessen Vorrat legt. Idempotent: steht sie schon drin, tut
    der Aufruf nichts."""
    vorrat_root = vorrat_root_bestimmen(args)
    os.makedirs(vorrat_root, exist_ok=True)
    projekt = os.path.abspath(args.projekt)
    auftrag_pfad = os.path.join(projekt, ".companion", "auftraege", "%s.json" % args.id)
    auftrag = auftrag_lesen(auftrag_pfad)
    # Die aktuelle Maschine steht im Verlauf (verschieben ändert nur ihn, der
    # Auftrag bleibt wegen des Freigabe-Hashes unverändert).
    maschine = args.maschine
    if not maschine:
        try:
            with open(verlauf_pfad_aus(args.id, auftrag_pfad), "r", encoding="utf-8") as f:
                maschine = json.load(f).get("maschine")
        except (OSError, json.JSONDecodeError):
            maschine = None
    maschine = maschine or auftrag.get("maschine")
    ziel = vorrat_pfad(vorrat_root, args.id)
    if os.path.exists(ziel):
        ausgabe(args, "wb-aufgabe: '%s' steht schon im Vorrat (%s) — nichts zu tun."
                % (args.id, ziel), daten={"id": args.id, "schon_aufgenommen": True})
        return 0
    bestehende_raenge = []
    for name in os.listdir(vorrat_root) if os.path.isdir(vorrat_root) else []:
        if name.endswith(".json") and not name.startswith("."):
            try:
                with open(os.path.join(vorrat_root, name), "r", encoding="utf-8") as f:
                    bestehende_raenge.append(json.load(f).get("rang", 0))
            except (OSError, json.JSONDecodeError):
                continue
    rang = args.rang if args.rang is not None else (max(bestehende_raenge) + 1 if bestehende_raenge else 1)
    eintrag = {
        "rang": rang, "projekt": projekt, "auftrag": auftrag_pfad,
        "maschine": maschine, "aufgenommen": jetzt_iso(),
    }
    json_schreiben(ziel, eintrag)
    ausgabe(args, "wb-aufgabe: '%s' in den Vorrat aufgenommen (%s)." % (args.id, ziel),
            daten={"id": args.id, "rang": rang, "maschine": eintrag["maschine"]})
    if TRAEGER_NACHSEHEN_AN:
        traeger_anstossen(args)
    return 0


# ---------------------------------------------------- verschieben (Schritt 2) --
def cmd_verschieben(args):
    """Maschine einer Aufgabe wechseln. Verlangt (docs/AGENTS-PLAN.md, Abschnitt
    4, „Die Maschine"): keine Worker-Spur im Zustand „arbeitet", kein „Daten
    bleiben auf der Maschine", und einen gepushten Repo-Stand (sauberer
    Arbeitsbaum und nichts über der Upstream-Referenz). In den Vorrat der
    Zielmaschine übernimmt ihn der Träger — hier wird nur der Vorratseintrag
    auf die neue Maschine umgestellt und der Verlauf geschrieben."""
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)
    endgueltig_pruefen(verlauf, args.id)
    arbeitende = [w.get("name") for w in verlauf.get("worker", [])
                  if w.get("zustand") == "arbeitet"]
    if arbeitende:
        fehler("'%s' hat Worker im Zustand 'arbeitet' (%s) — erst einsammeln, dann verschieben."
               % (args.id, ", ".join(arbeitende)))
    if verlauf.get("stand") == "läuft":
        fehler("'%s' läuft — erst pausieren oder abschließen, dann verschieben." % args.id)
    sitzung = verlauf.get("hauptagent_sitzung") or {}
    if sitzung.get("pid") and pid_lebt(sitzung["pid"]):
        fehler("'%s' hat einen lebenden Hauptagenten (PID %s) — erst schließen, dann verschieben."
               % (args.id, sitzung["pid"]))
    if auftrag.get("grenzen", {}).get("daten-lokal"):
        fehler("'%s' trägt 'Daten bleiben auf der Maschine' — ein Verschieben ist mechanisch gesperrt." % args.id)
    projekt = eintrag.get("projekt")
    if subprocess.run(["git", "-C", projekt, "rev-parse", "--git-dir"],
                      capture_output=True, timeout=30).returncode != 0:
        fehler("'%s' liegt nicht in einem git-Repo (%s) — Repo-Stand kann nicht als gepusht gelten." % (args.id, projekt))
    if subprocess.run(["git", "-C", projekt, "status", "--porcelain"],
                      capture_output=True, timeout=30).stdout.strip():
        fehler("'%s' hat uncommittete Aenderungen — erst committen und pushen, dann verschieben." % args.id)
    hinter = subprocess.run(["git", "-C", projekt, "log", "@{u}..HEAD", "--oneline"],
                            capture_output=True, timeout=30)
    if hinter.returncode != 0:
        fehler("'%s' hat keinen Upstream-Zweig — ein gepushter Stand ist nicht belegt (Verschieben abgelehnt)." % args.id)
    if hinter.stdout.strip():
        fehler("'%s' hat Commits über dem Upstream — erst pushen, dann verschieben." % args.id)
    alt = verlauf.get("maschine")
    verlauf["maschine"] = args.nach
    verlauf_anhaengen(verlauf, verlauf_eintrag(
        "verschoben", "Maschine '%s' -> '%s'" % (alt, args.nach)))
    json_schreiben(verlauf_datei, verlauf)
    vorrat_root = vorrat_root_bestimmen(args)
    vorrat_eintrag_lesen(vorrat_root, args.id)
    eintrag["maschine"] = args.nach
    json_schreiben(vorrat_pfad(vorrat_root, args.id), eintrag)
    ausgabe(args, "wb-aufgabe: '%s' soll auf '%s' laufen — der Vorratseintrag wurde umgestellt; "
                  "der Träger übernimmt ihn dort." % (args.id, args.nach),
            daten={"id": args.id, "maschine": args.nach})
    return 0


# ---------------------------------------------------------------- rang --
def cmd_rang(args):
    vorrat_root = vorrat_root_bestimmen(args)
    pfad = vorrat_pfad(vorrat_root, args.id)
    eintrag = vorrat_eintrag_lesen(vorrat_root, args.id)
    eintrag["rang"] = args.n
    json_schreiben(pfad, eintrag)
    ausgabe(args, "wb-aufgabe: Rang von '%s' auf %d gesetzt." % (args.id, args.n),
            daten={"id": args.id, "rang": args.n})
    return 0


# --------------------------------------------------------------- liste --
def cmd_liste(args):
    vorrat_root = vorrat_root_bestimmen(args)
    zeilen = []
    for name in sorted(os.listdir(vorrat_root)) if os.path.isdir(vorrat_root) else []:
        if not name.endswith(".json") or name.startswith("."):
            continue
        id_ = name[:-len(".json")]
        try:
            with open(os.path.join(vorrat_root, name), "r", encoding="utf-8") as f:
                eintrag = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        stand = None
        hauptagent = None
        try:
            verlauf = verlauf_lesen(verlauf_pfad_aus(id_, eintrag["auftrag"]))
            stand = verlauf.get("stand")
            auftrag = auftrag_lesen(eintrag["auftrag"])
            hauptagent = auftrag.get("hauptagent")
        except SystemExit:
            stand = "unbekannt"
        if args.stand and stand != args.stand:
            continue
        zeilen.append({
            "id": id_, "rang": eintrag.get("rang", 0), "projekt": eintrag.get("projekt"),
            "maschine": eintrag.get("maschine"), "stand": stand, "hauptagent": hauptagent,
        })
    zeilen.sort(key=lambda z: (z["rang"], z["id"]))

    if args.json:
        print(json.dumps(zeilen, ensure_ascii=False))
    else:
        for z in zeilen:
            print("%-4s %-30s %-20s %s" % (z["rang"], z["id"], z["stand"], z["projekt"]))
    return 0


# --------------------------------------------------------------- zeigen --
def cmd_zeigen(args):
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)
    if args.json:
        print(json.dumps({"vorrat": eintrag, "auftrag": auftrag, "verlauf": verlauf}, ensure_ascii=False))
        return 0
    hauptagent = auftrag.get("hauptagent") or {}
    fallback = hauptagent.get("fallback")
    fallback_text = ("%s:%s" % (fallback["model"], fallback["effort"])) if fallback else "keins"
    print("Aufgabe %s" % args.id)
    print("  Ziel:   %s" % auftrag.get("goal"))
    print("  Fertig: %s" % auftrag.get("done_criterion"))
    print("  Stand:  %s%s" % (verlauf.get("stand"), (" (%s)" % verlauf["grund"]) if verlauf.get("grund") else ""))
    print("  Rang:   %s" % eintrag.get("rang"))
    print("  Maschine: %s" % verlauf.get("maschine"))
    print("  Hauptagent: %s:%s (Fallback: %s)" % (hauptagent.get("model"), hauptagent.get("effort"), fallback_text))
    print("  Freigabe: %s" % ("keine" if not auftrag.get("approval") else
                              "gültig" if freigabe_gueltig(auftrag) else "UNGÜLTIG (Hash passt nicht zum Auftrag)"))
    return 0


# -------------------------------------------------------------- pruefen --
def cmd_pruefen(args):
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)
    verstoesse = []
    for feld in PFLICHTFELDER_AUFTRAG:
        if feld not in auftrag:
            verstoesse.append("Auftragsdatei: Pflichtfeld '%s' fehlt" % feld)
    for feld in PFLICHTFELDER_VERLAUF:
        if feld not in verlauf:
            verstoesse.append("Verlaufsdatei: Pflichtfeld '%s' fehlt" % feld)
    if verlauf.get("stand") not in STAENDE:
        verstoesse.append("Verlaufsdatei: ungueltiger Stand '%s'" % verlauf.get("stand"))
    if auftrag.get("approval") and not freigabe_gueltig(auftrag):
        erwartet = auftrag_hash(auftrag)
        tatsaechlich = auftrag["approval"].get("text_sha256") if isinstance(auftrag["approval"], dict) else None
        if tatsaechlich != erwartet:
            verstoesse.append(
                "Auftragsdatei: Hash der Freigabe stimmt nicht mehr (erwartet %s, gefunden %s)"
                % (erwartet, tatsaechlich))

    hauptagent = auftrag.get("hauptagent")
    if isinstance(hauptagent, dict):
        if "fallback" not in hauptagent:
            verstoesse.append("Auftragsdatei: hauptagent.fallback fehlt")
        else:
            fallback = hauptagent["fallback"]
            if fallback is not None:
                if not isinstance(fallback, dict) or "model" not in fallback or "effort" not in fallback:
                    verstoesse.append("Auftragsdatei: hauptagent.fallback ist kein gueltiges {model, effort}")
                else:
                    if ist_fable(fallback["model"]):
                        verstoesse.append(
                            "Auftragsdatei: hauptagent.fallback ist ein Fable-Modell ('%s') — "
                            "Fable ist nie ein Fallback" % fallback["model"])
                    if auftrag.get("grenzen", {}).get("daten-lokal") \
                            and modell_klasse(fallback["model"], args.base) != "lokal":
                        verstoesse.append(
                            "Auftragsdatei: 'Daten bleiben auf der Maschine' verlangt ein lokales "
                            "Fallback oder 'keins' ('%s' ist nicht als lokal bekannt)" % fallback["model"])

    if args.json:
        print(json.dumps({"id": args.id, "verstoesse": verstoesse}, ensure_ascii=False))
    else:
        if verstoesse:
            for v in verstoesse:
                sys.stderr.write(v + "\n")
        else:
            print("wb-aufgabe pruefen %s: keine Verstoesse" % args.id)
    return 2 if verstoesse else 0


# ------------------------------------------------------------------ CLI --
def main():
    gemeinsam = argparse.ArgumentParser(add_help=False)
