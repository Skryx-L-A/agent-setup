def cmd_pfade(args):
    """Verlaufsfeld `pfade`: die Pfade, die der Hauptagent als seine führt und
    die der Stop-Hook (bzw. der Träger beim lokalen Hauptagenten) beim Zugende
    committet. Gesetzt und entfernt wird einzeln genannt — nie ein Verzeichnis
    pauschal (Hausregel „Wer committet, nennt seine Pfade")."""
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)
    endgueltig_pruefen(verlauf, args.id)
    pfade = verlauf.setdefault("pfade", [])
    if args.aktion == "setzen":
        falsch = [p for p in args.pfad if not pfad_gueltig(p)]
        if falsch:
            fehler("ungültige Pfade %s: erlaubt sind relative Pfade im Repo, nie '.', '..', "
                   "leer, absolut oder mit '..'-Segment." % ", ".join(repr(p) for p in falsch))
        geaendert = []
        for p in args.pfad:
            if p not in pfade:
                pfade.append(p)
                geaendert.append(p)
        if not geaendert:
            ausgabe(args, "wb-aufgabe: alle genannten Pfade stehen schon bei '%s'." % args.id,
                    daten={"id": args.id, "pfade": pfade})
            return 0
        verlauf_anhaengen(verlauf, verlauf_eintrag(
            "pfade", "Pfade geführt: %s" % ", ".join(geaendert)))
    else:
        vorher = len(pfade)
        verlauf["pfade"] = [p for p in pfade if p not in args.pfad]
        if len(verlauf["pfade"]) == vorher:
            fehler("keiner der genannten Pfade wird bei '%s' geführt." % args.id)
        verlauf_anhaengen(verlauf, verlauf_eintrag(
            "pfade", "Pfade entfernt: %s" % ", ".join(p for p in args.pfad if p not in verlauf["pfade"])))
    json_schreiben(verlauf_datei, verlauf)
    ausgabe(args, "wb-aufgabe: Pfade von '%s' aktualisiert (%d geführt)." % (args.id, len(verlauf["pfade"])),
            daten={"id": args.id, "pfade": verlauf["pfade"]})
    return 0


# ------------------------------------------------------ sitzung (Schritt 2) --
def cmd_sitzung(args):
    """Verlaufsfeld `hauptagent_sitzung`: die lebende Sitzung des Hauptagenten.
    `setzen` übernimmt die genannten Felder und stempelt `gestartet`; `gesehen`
    stempelt nur `zuletzt_gesehen` (der Takt des Trägers); `leeren` löscht das
    ganze Feld."""
    _, eintrag, auftrag_pfad, auftrag, verlauf_datei, verlauf = geladen_aus_id(args)
    if args.aktion == "leeren":
        verlauf["hauptagent_sitzung"] = None
