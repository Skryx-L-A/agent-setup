    p = sub.add_parser("pruefen", parents=[gemeinsam])
    p.add_argument("id")
    p.set_defaults(func=cmd_pruefen)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
