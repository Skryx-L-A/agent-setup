# Der Deckel (--max-num-seqs) fuer den Motor vllm-metal. Er rastet auf die
# beiden GEMESSENEN Werte ein statt der verlangten Stromzahl blind zu folgen --
# siehe VLLM_DECKEL_UNTEN/VLLM_DECKEL_OBEN oben fuer den Knick bei zwoelf.
# Ueber sechzehn hinaus gibt es keine Messung mehr; dort folgt der Deckel der
# Stromzahl, weil ein kleinerer Deckel die verlangten Stroeme aktiv ausbremsen
# wuerde und ein erfundener groesserer nichts belegt.
deckel_waehlen() {
  local stroeme="$1"
  if [ "$stroeme" -le "$VLLM_DECKEL_UNTEN" ]; then
    printf '%s' "$stroeme"
  elif [ "$stroeme" -le "$VLLM_DECKEL_OBEN" ]; then
    printf '%s' "$VLLM_DECKEL_OBEN"
  else
    printf '%s' "$stroeme"
  fi
}

