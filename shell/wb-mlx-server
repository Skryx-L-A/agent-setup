is_ours() {
  local pid="$1"
  # mlx_lm.server, mlx-dspark serve (Nachtrag 7), mtplx serve (Nachtrag 8),
  # vllm serve (Nachtrag 10) ODER mlx_vlm.server (Nachtrag 22, 2026-08-27) --
