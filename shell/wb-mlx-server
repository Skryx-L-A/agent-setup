err() { printf 'wb-mlx-server: %s\n' "$*" >&2; }

# Alter, in grug-server bis 2026-08-19 erprobter Festwert (siehe Kopfkommentar
# "OHNE --kontext"). Letzter Rueckfall, wenn wb-kontext fehlt oder scheitert.
VORGABE_KONTEXT_ALT=18432

# Ermittelt den Kontext fuer 'ensure', wenn --kontext NICHT explizit gegeben
# wurde. NIE das Modell-Maximum als stille Vorgabe (Kopfkommentar). Gibt den
# gewaehlten Wert auf stdout aus, die Herkunft IMMER auf stderr -- auch im
# Fehlerfall, denn `$(...)` faengt nur stdout, wb-kontexts eigener HINWEIS
# (etwa "Sicherheitsboden nicht erreicht, kleinste Stufe trotzdem gewaehlt")
# laeuft unveraendert durch, weil hier NICHTS von wb-kontexts stderr
# umgeleitet wird.
kontext_vorgabe_ermitteln() {
  local kennung_oder_pfad="$1" parallel="$2"
  # --parallel <n> (Nachtrag 6): dieselbe Zahl, die auch gebucht und an
  # mlx_lm.server gereicht wird (siehe cmd_ensure) -- die Empfehlung soll
  # dieselbe Sequenzzahl meinen wie die tatsaechliche Buchung, sonst
  # empfiehlt wb-kontext einen anderen Kontext als der, fuer den tatsaechlich
  # gebucht wird.
  #
  # --denken (Pruefer-Befund B12): aus RES_CHAT_TEMPLATE_ARGS abgeleitet, der
  # Registry-Vorgabe fuer DIESES Modell (siehe resolve_modell, global gesetzt,
  # bevor diese Funktion aufgerufen wird). Fuer qwen38 steht dort fest
  # reasoning_effort=low -- das Modell denkt IMMER, die Empfehlung muss also
  # die zusaetzlichen Ausgabe-Token einrechnen. Kein Wert ableitbar (kein
  # chatTemplateArgs, z.B. grug) heisst KEIN --denken-Schalter -- dann
  # entscheidet wb-kontexts eigene Vorgabe (denken_vorgabe() dort), nicht
  # eine geratene Annahme hier.
  local denken; denken="$(chat_template_denken_wert)"
  if command -v wb-kontext >/dev/null 2>&1; then
    local wert rc
    set -- empfehlung "$kennung_oder_pfad" --parallel "$parallel"
    if [ -n "$denken" ]; then set -- "$@" --denken "$denken"; fi
    wert="$(wb-kontext "$@")"
    rc=$?
    case "$wert" in ''|*[!0-9]*) wert="" ;; esac
    if [ "$rc" -eq 0 ] && [ -n "$wert" ]; then
      err "Kontext: $wert Token (wb-kontext $*)."
      printf '%s' "$wert"
      return 0
    fi
    err "wb-kontext lieferte keinen brauchbaren Wert (Exit $rc) fuer '$kennung_oder_pfad' — falle auf den alten Festwert $VORGABE_KONTEXT_ALT zurueck."
  else
    err "wb-kontext nicht installiert — falle auf den alten Festwert $VORGABE_KONTEXT_ALT zurueck."
  fi
  err "Kontext: $VORGABE_KONTEXT_ALT Token (Vorgabe, wie bisher grug-servers BELEGUNG_KONTEXT bis 2026-08-19)."
  printf '%s' "$VORGABE_KONTEXT_ALT"
}

# Denkstufe (reasoning_effort) aus RES_CHAT_TEMPLATE_ARGS, der
# Registry-Vorgabe fuer DIESES Modell (siehe resolve_modell, global gesetzt,
# bevor diese Funktion aufgerufen wird) -- leer, wenn kein chatTemplateArgs
# in der Registry steht (z.B. grug). Gemeinsame Extraktion fuer
# kontext_vorgabe_ermitteln() UND die mlx-dspark-Weiche in cmd_ensure
# (--reasoning-effort dort), damit beide Stellen dieselbe Zahl meinen statt
# sie zweimal getrennt aus demselben JSON zu ziehen.
chat_template_denken_wert() {
