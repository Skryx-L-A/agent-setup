  fi

  # DIE EINE Speicherpruefung vor jedem Start (Nachtrag 21.08.2026: bis dahin
  # gab es zusaetzlich die entfernte B11-Pruefung weiter oben, VOR dem
  # Beenden -- siehe der lange Kommentar dort fuer den Befund). Sie laeuft
  # HIER, weil sie an dieser Stelle IMMER gegen den gerade wirklich freien
  # Speicher misst: entweder es lief nie etwas auf diesem Port (reiner
  # Kaltstart), oder das Alte ist ueber `_stop_pruefen_und_beenden` bereits
  # verifiziert weg (Wechsel) -- in beiden Faellen ist `check-resources`
  # HIER die Wahrheit, nie eine Schaetzung. Sie deckt beide Faelle aus dem
  # Vorfall vom 11.08. mit derselben Schwelle ab: ein Wechsel, dessen neuer
  # Koerper auch nach dem Freiwerden des alten nicht hineinpasst, UND ein
  # zusaetzliches grosses Modell neben einem anderen Speicherverbraucher bei
  # einem reinen Kaltstart.
  if ! command -v check-resources >/dev/null 2>&1; then
    err "check-resources nicht gefunden — kein Start ohne Speicherpruefung."
    return 1
  fi
  local free_mib
  free_mib="$(check-resources 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["ram"]["free_mib"])' 2>/dev/null)"
  if [ -z "$free_mib" ]; then
    err "check-resources lieferte keinen lesbaren Wert — kein Start ohne Speicherpruefung."
    return 1
  fi
  # MIN_FREE_MIB steht seit 2026-08-27 auf 0 (siehe die Konstante oben) --
  # diese Pruefung bleibt stehen, damit ein spaeter wieder gesetzter,
  # positiver Boden ohne weitere Aenderung greift, feuert aber mit der
  # heutigen Vorgabe nie. Der freie Wert wird trotzdem geloggt: informativ,
  # keine Schwelle mehr.
  err "freier Speicher vor dem Start: ${free_mib} MiB (informativ -- die scharfe Grenze ist jetzt wb-notbremse NACH dem Start, siehe dort)."
  if [ "$free_mib" -lt "$MIN_FREE_MIB" ]; then
    err "nur ${free_mib} MiB frei, mindestens ${MIN_FREE_MIB} MiB noetig — Start abgebrochen."
    err "Grund: siehe Kopfkommentar dieser Datei und ~/Knowledge/10-global/incident-2026-08-11-kernel-panik-durch-gpu-speichermangel.md"
    return 1
  fi

  if [ "$motor" = "mlx-dspark" ]; then
    if ! command -v mlx-dspark >/dev/null 2>&1; then
      err "mlx-dspark nicht im PATH gefunden -- kein Start mit Vorhersage moeglich."
      return 1
    fi
  elif [ "$motor" = "mtplx" ]; then
    if ! command -v mtplx >/dev/null 2>&1; then
      err "mtplx nicht im PATH gefunden -- kein Start mit eingebauter Vorhersage moeglich."
      return 1
    fi
  elif [ "$motor" = "vllm-metal" ]; then
    # Die Ausfuehrbarkeit ist bei der Motorwahl oben schon geprueft (sonst
    # waere motor gar nicht auf vllm-metal gesprungen) -- hier steht nur noch
    # die Pruefung gegen ein zwischenzeitlich verschwundenes Werkzeug.
    if [ ! -x "$buendel_bin" ]; then
      err "'$buendel_bin' ist nicht (mehr) ausfuehrbar -- kein Start ueber vllm-metal."
      return 1
    fi
  elif [ "$motor" = "mlx-vlm" ]; then
    # WB_MLX_VLM_BIN (Nachtrag 2026-09-08, VIERTE RUNDE, Auftrag (C)): Pfad zur
    # mlx_vlm.server-Binaerdatei, Vorgabe wie bisher ueber PATH
    # (`command -v mlx_vlm.server`). Der Anlass: ein Messlauf soll die
    # Fassung 0.7.0 unter einem eigenen venv (z.B.
    # ~/.venv-mlx-vlm-070/bin/mlx_vlm.server) MIT Buchung starten koennen,
    # OHNE die auf dieser Maschine installierte 0.6.17 zu verdraengen -- kein
    # zweiter, ungebuchter Weg am Werkzeug vorbei.
    MLX_VLM_BIN="${WB_MLX_VLM_BIN:-$(command -v mlx_vlm.server)}"
    if [ -z "$MLX_VLM_BIN" ] || [ ! -x "$MLX_VLM_BIN" ]; then
      err "mlx_vlm.server nicht gefunden oder nicht ausfuehrbar (WB_MLX_VLM_BIN='${WB_MLX_VLM_BIN:-}', aufgeloest '$MLX_VLM_BIN') -- kein Start mit Vorhersage ueber diesen Motor moeglich."
      return 1
    fi
    # Fassung ins Log, VOR jedem Start (Auftrag (C), Punkt 1): dasselbe
    # Python, das $MLX_VLM_BIN mitbringt -- ein `import mlx_vlm` gegen ein
    # ANDERES, zufaellig im PATH stehendes Python koennte eine andere Fassung
    # oder gar keine finden, obwohl $MLX_VLM_BIN selbst laeuft.
    #
    # NACHTRAG (2026-09-08, SECHSTE RUNDE, echter Ladetest): `command -v
    # mlx_vlm.server` liefert bei `uv tool install` ueblicherweise einen
    # SYMLINK (z.B. ~/.local/bin/mlx_vlm.server -> .../uv/tools/mlx-vlm/
    # bin/mlx_vlm.server) -- dirname DES SYMLINKS (~/.local/bin) hat kein
    # eigenes python, das python liegt nur im AUFGELOESTEN venv-Verzeichnis.
    # macOS' `readlink` kennt kein garantiertes `-f`, deshalb die Kette hier
    # von Hand aufgeloest (portabel, ohne GNU-readlink/python3-Annahme).
    local MLX_VLM_REAL="$MLX_VLM_BIN" MLX_VLM_ZIEL="" MLX_VLM_PY="" MLX_VLM_SHEBANG=""
    while [ -L "$MLX_VLM_REAL" ]; do
      MLX_VLM_ZIEL="$(readlink "$MLX_VLM_REAL")"
      case "$MLX_VLM_ZIEL" in
        /*) MLX_VLM_REAL="$MLX_VLM_ZIEL" ;;
        *) MLX_VLM_REAL="$(cd "$(dirname "$MLX_VLM_REAL")" && pwd)/$MLX_VLM_ZIEL" ;;
      esac
    done
    MLX_VLM_PY="$(dirname "$MLX_VLM_REAL")/python"
    if [ ! -x "$MLX_VLM_PY" ]; then
      # Rueckfall: die Shebang-Zeile der aufgeloesten Datei nennt ihr Python
      # direkt (#!/pfad/zu/python) -- deckt venv-Layouts ab, die kein
      # "python" neben der Binaerdatei ablegen.
      MLX_VLM_SHEBANG="$(head -1 "$MLX_VLM_REAL" 2>/dev/null)"
      case "$MLX_VLM_SHEBANG" in
        '#!'*) MLX_VLM_PY="${MLX_VLM_SHEBANG#\#!}"; MLX_VLM_PY="${MLX_VLM_PY%% *}" ;;
      esac
    fi
    MLX_VLM_VERSION="$("$MLX_VLM_PY" -c 'import mlx_vlm; print(mlx_vlm.__version__)' 2>/dev/null)"
    if [ -n "$MLX_VLM_VERSION" ]; then
      err "mlx_vlm.server: $MLX_VLM_BIN (Fassung $MLX_VLM_VERSION, Python $MLX_VLM_PY)."
    else
      err "WARNUNG: Fassung von mlx_vlm unter '$MLX_VLM_BIN' nicht ermittelbar (import ueber '$MLX_VLM_PY' fehlgeschlagen) -- APC und --model-discovery bleiben deshalb aus (siehe apc_aktiv/model_discovery_ok unten), sicherer als eine geratene Fassung."
      MLX_VLM_VERSION=""
    fi
    # URSPRUENGLICH STAND HIER (erste Runde, GELOESCHT und jetzt per
    # Loeschverbot wiederhergestellt, ZWEITE RUNDE, Wiederherstellung b) der
    # damalige, wortwoertliche Kommentar samt Code:
    #
    #   # Version >= 0.7.0? `sort -V` (auf dieser Maschine vorhanden, GEPRUEFT) --
    #   # kein eigener Versions-Parser fuer ein Format, das die Bibliothek selbst
    #   # schon herausgibt.
    #   MLX_VLM_AB_070=0
    #   if [ -n "$MLX_VLM_VERSION" ] \
    #      && [ "$(printf '%s\n%s\n' "0.7.0" "$MLX_VLM_VERSION" | sort -V | head -1)" = "0.7.0" ]; then
    #     MLX_VLM_AB_070=1
    #   fi
    #
    # UEBERHOLT: dieser Vergleich war falsch, siehe die Korrektur unten.
    #
    # Version >= 0.7.0? UEBERARBEITET (Nachtrag 2026-09-08, Auftrag "buchung",
    # Kleinkram-Befund "sort -V reiht 0.7.0rc0 NACH 0.7.0"): `sort -V` (BSD-
    # Fassung dieser Maschine, GEPRUEFT: `sort --version` -> "2.3-Apple") sortiert
    # rein lexikographisch UEBER den gemeinsamen Praefix hinaus und kennt keine
    # SemVer-/PEP-440-Vorrangregel fuer Vorabversionen -- GEMESSEN:
    # `printf '0.7.0\n0.7.0rc0\n' | sort -V` liefert "0.7.0" VOR "0.7.0rc0", als
    # sei die Vorabversion NEUER als die fertige Fassung. Der alte Vergleich
    # haette APC/--model-discovery deshalb schon fuer eine 0.7.0rc0-Vorabversion
    # aktiviert, die eigentlich noch AELTER als 0.7.0 gilt.
    #
    # ERSTER VERSUCH (verworfen, nicht nur dokumentiert -- GEMESSEN am eigenen
    # Fehlschlag): `packaging.version` waere die naheliegende Bibliothek, aber
    # sie ist auf dieser Maschine ein PIP-INSTALL-USER-Paket unter
    # $HOME/Library/Python/.../site-packages, KEIN Python-Standardpaket -- unter
    # einem ANDEREN $HOME (jeder Test mit eigenem HOME, jede Maschine ohne genau
    # dieses pip-Paket, z.B. peer ungeprueft) schlaegt der Import fehl und die
    # konservative Ausweichung (NEIN) griff dann IMMER, auch fuer eine echte
    # 0.7.0 -- GEMESSEN in test-mlx-server-mlx-vlm-070.sh, das mit eigenem HOME
    # arbeitet: Faelle 3/6/7/8 (alle "0.7.0, sollte AN sein") schlugen fehl.
    #
    # Ersetzt durch einen KLEINEN, selbstgeschriebenen PEP-440-Teilvergleich
    # ohne jede Fremdbibliothek (nur `re`/`sys`, Python-Standardbibliothek,
    # ueberall vorhanden): numerischer Anteil ("0.7.0") wird verglichen, ein
    # ANGEHAENGTER Rest ("rc0", "b1", ".dev0", …) gilt als Vorabversion und ist
    # bei gleicher Zahl IMMER kleiner als die reine Fassung -- exakt die eine
    # Regel, die hier gebraucht wird, nicht die volle PEP-440-Spezifikation.
    # Kein Parsen moeglich (kein fuehrendes "X.Y..."): konservativ NEIN, nie
    # failoffen in Richtung "neu genug" bei einer Zahl, die sich nicht verstehen
    # laesst (dieselbe Sicherheitsrichtung wie ueberall in dieser Datei).
    MLX_VLM_AB_070=0
    if [ -n "$MLX_VLM_VERSION" ] && python3 -c '
import re, sys

def parse(v):
    m = re.match(r"^(\d+(?:\.\d+)*)", v)
    if not m:
        raise ValueError(v)
    release = tuple(int(x) for x in m.group(1).split("."))
    ist_vorab = bool(v[m.end():])
    return release, ist_vorab

def ge(v, ziel):
    rv, vorab_v = parse(v)
    rz, vorab_z = parse(ziel)
    laenge = max(len(rv), len(rz))
    rv = rv + (0,) * (laenge - len(rv))
    rz = rz + (0,) * (laenge - len(rz))
    if rv != rz:
        return rv > rz
    # gleiche Zahl: eine Vorabversion ist NIE >= der reinen Fassung.
    return not (vorab_v and not vorab_z)

try:
    sys.exit(0 if ge(sys.argv[1], "0.7.0") else 1)
except Exception:
    sys.exit(1)
' "$MLX_VLM_VERSION" 2>/dev/null; then
      MLX_VLM_AB_070=1
    fi
    # APC (Automatic Prefix Cache, Auftrag (C) Punkt 2, VORGABE GEAENDERT IN
    # DER FUENFTEN RUNDE, siehe apc_gewuenscht oben): existiert laut Auftrag
    # erst ab 0.7.0.
    #   apc_gewuenscht=auto (Vorgabe seit der fuenften Runde): APC an, sobald
    #     die Fassung reicht -- KEINE Warnung, wenn nicht: eine Vorgabe, die
    #     sich an die verfuegbare Fassung anpasst, ist kein Fehler des
    #     Aufrufers.
    #   apc_gewuenscht=1 (--apc/WB_MLX_SERVER_APC=1, ausdruecklicher Wunsch):
    #     zu alt heisst laute Warnung, Start OHNE APC -- kein Abbruch, ein
    #     Wunsch nach einer Beschleunigung ist kein Grund, den Start ganz zu
    #     verweigern.
    #   apc_gewuenscht=0 (WB_MLX_SERVER_APC=0, ausdruecklicher Verzicht):
    #     bleibt aus, unabhaengig von der Fassung, keine Warnung.
    apc_aktiv=0
    if [ "$MLX_VLM_AB_070" -eq 1 ] && { [ "$apc_gewuenscht" = auto ] || [ "$apc_gewuenscht" = 1 ]; }; then
      apc_aktiv=1
    elif [ "$apc_gewuenscht" = 1 ]; then
      err "WARNUNG: --apc verlangt, aber mlx_vlm ${MLX_VLM_VERSION:-<Fassung unbekannt>} ist aelter als 0.7.0 (APC existiert dort nicht) -- Start OHNE APC."
    fi
    # NACHTRAG 2026-09-10, Auftrag "apcspeicher": die schlanken APC-Knoepfe
    # wirken nur mit dem lokalen Patch (Markierung "wb-apcspeicher" in
    # mlx_vlm/apc.py). Ohne ihn liest mlx_vlm die Variablen gar nicht -- der
    # Server liefe mit dem alten Speicherbedarf, und nichts saehe danach aus.
    # apc_patch_ok entscheidet im exec-Zweig, ob SCHLANK (Vorgabe) wirklich
    # gesetzt wird.
    local apc_patch_ok=0
    if [ "$apc_aktiv" -eq 1 ]; then
      local apc_patch_datei
      apc_patch_datei="$("$MLX_VLM_PY" -c 'import importlib.util, os; print(os.path.join(os.path.dirname(importlib.util.find_spec("mlx_vlm").origin), "apc.py"))' 2>/dev/null)"
      if [ -n "$apc_patch_datei" ] && grep -q "wb-apcspeicher" "$apc_patch_datei" 2>/dev/null; then
        apc_patch_ok=1
      elif [ "${WB_MLX_SERVER_APC_SCHLANK:-1}" = 1 ] || [ -n "${WB_MLX_SERVER_APC_SNAPSHOT_BITS:-}" ]; then
        err "WARNUNG: mlx_vlm ist nicht gepatcht (${apc_patch_datei:-apc.py nicht gefunden}) -- APC laeuft mit dem alten Speicherbedarf (gemessen 2026-09-10: bei 60k Token rund 44 GiB, darueber Metal-Speichermangel). Nachholen: shell/messungen/apc-speicher/patch-apc-speicher.py anwenden"
      fi
    fi
    # --model-discovery (Auftrag (C) Punkt 3): nur setzen, wenn die Fassung
    # den Schalter WIRKLICH kennt (0.7.0), sonst lehnt ein aelterer Server den
    # unbekannten Schalter unter Umstaenden ab. Dieselbe Versionspruefung wie
    # bei APC -- eine zweite, unabhaengige `--help`-Sonde waere eine zweite
    # Quelle fuer dieselbe Frage.
    model_discovery_ok="$MLX_VLM_AB_070"
  elif ! command -v mlx_lm.server >/dev/null 2>&1; then
    err "mlx_lm.server nicht im PATH gefunden."
    return 1
  fi
  if [ ! -d "$MODEL_PATH" ]; then
    err "Modellverzeichnis fehlt: $MODEL_PATH"
    return 1
  fi
  if [ "$vorh_bauart" = "entwerfer" ] && [ ! -d "$vorh_modell" ]; then
    err "Entwerferverzeichnis fehlt: $vorh_modell"
    return 1
  fi

  local gewichte_gb
  if [ "$motor" = "vllm-metal" ]; then
    # Gebucht wird bei diesem Motor sein eigenes Budget, nicht Gewichte + KV +
    # Zuschlag (siehe Kopfkommentar NACHTRAG 10 und METAL_ARBEITSSATZ_GIB in
    # wb-belegung) -- eine Gewichtszahl wird hier deshalb gar nicht erst
    # ermittelt. Leer statt null: eine Null waere eine Behauptung ueber das
    # Gewicht, leer ist die Wahrheit ("wird fuer diese Buchungsart nicht
    # gebraucht").
    gewichte_gb=""
    vorh_gewichte_gb=""
  elif [ "$motor" = "mtplx" ]; then
    # Kein separater Entwerfer: der Modellkoerper selbst traegt den MTP-Kopf
    # (siehe Motorwahl oben, MODEL_PATH == vorh_modell) -- die Registry-
    # Vorgabe fuer DIESEN Koerper ist deshalb vorh_gewichte_gb
    # (vorhersage.gewichteGb), NICHT RES_GEWICHTE_GB (das waere das Gewicht
    # des URSPRUENGLICH angeforderten, kleineren Ziel-Eintrags).
    gewichte_gb="$(gewichte_gb_ermitteln "$MODEL_PATH" "$vorh_gewichte_gb")" || return 1
    vorh_gewichte_gb=""
  else
    gewichte_gb="$(gewichte_gb_ermitteln "$MODEL_PATH" "$RES_GEWICHTE_GB")" || return 1
    if [ "$vorh_bauart" = "entwerfer" ]; then
      # Gewichte des Entwerfers: Registry-Wert (WB_MLX_SERVER_VORHERSAGE_GEWICHTE_GB,
      # von wb-code/pi-worker aus vorhersage.gewichteGb gereicht), sonst wie beim
      # Ziel selbst aus der Plattenbelegung geschaetzt -- dieselbe Funktion,
      # derselbe "laut schaetzen statt still annehmen"-Grundsatz.
      vorh_gewichte_gb="$(gewichte_gb_ermitteln "$vorh_modell" "$vorh_gewichte_gb")" || return 1
    fi
  fi
  local basisname; basisname="$(basename "$MODEL_PATH")"
  local zweck="wb-mlx-server: MLX-Server fuer ${RES_ID:-$basisname} (${RES_ALIAS:-kein Alias}), Port $PORT"

  # Prompt-Cache-Plaetze (Nachtrag 8, siehe Kopfkommentar und wb-belegungs
  # eigener): NUR fuer den motor=mlx-lm-Weg gebucht -- das ist die einzige
  # Stelle, an der die 10-Plaetze-LRUPromptCache mit dem gemessenen
  # 0,47-GiB/Platz-Wert tatsaechlich beobachtet wurde (mlx_lm.server
  # --log-level INFO, "Prompt Cache: N sequences, X GB"). Ob mlx-dspark/mtplx
  # eine vergleichbare, eigene Cache-Struktur mit eigenem Speicherbedarf
  # haben, ist NICHT gemessen -- fuer beide bleibt der Posten bewusst 0
  # statt geraten (dieselbe Luecke, die der Kopfkommentar Nachtrag 7 fuer
  # mlx-dsparks Cache-Plaetze schon offen benennt).
  # Gebucht wird ab Nachtrag 16 der DECKEL in GiB (siehe PROMPT_CACHE_GIB oben),
  # nicht mehr die Plaetzezahl mal einer angenommenen Platzgroesse. Die Plaetze
  # bleiben gesetzt -- sie bestimmen, wie viele verschiedene Praefixe der Cache
  # vorhaelt --, aber wie viel SPEICHER er nehmen darf, sagt jetzt der Deckel.
  # GEKLAERT (Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag "buchung", Risiko 13,
  # "allokiert mlx-vlm KV je laufendem Strom oder haelt es decode-concurrency
  # Slots vorab?"): PER LAUFENDEM STROM, kein Vorab-Reservat. Quelltext dieser
  # Maschine gelesen (kein echter Serverstart), Fassung 0.7.0-Installation
  # unter ~/.local/share/uv/tools/mlx-vlm/lib/python3.12/site-packages/
  # mlx_vlm/server/generation.py, Zeilen ~1686-1707: der Generierungs-Thread
  # haelt ein dict `active` ("uid -> {rqueue, tokens, gen_kwargs}"), das NUR
  # waechst, wenn eine ECHTE Anfrage eintrifft (`_collect_pending_requests`);
  # `--max-num-seqs` (Umgebungsvariable MLX_VLM_MAX_NUM_SEQS, gesetzt ueber
  # `--max-num-seqs $parallel` bei mehreren Stroemen, siehe exec-Zweig weiter
  # unten) wirkt NUR als Aufnahme-Obergrenze
  # ("capacity = max_num_seqs - len(active)"), keine Vorab-Zuteilung. Damit
  # ist die bestehende Buchung (parallel x kontext x KV-Bedarf je Token, siehe
  # spitze_rechnen() in wb-belegung) das richtige Modell fuer diesen Motor --
  # es gibt kein zusaetzliches, decode-concurrency-breites Vorab-Reservat, das
  # separat gebucht werden muesste.
  local cache_gib=0 cache_ist_exakt=0
  if [ "$motor" = "mlx-lm" ]; then
    cache_gib="$PROMPT_CACHE_GIB"
  elif [ "$motor" = "mlx-vlm" ] && [ "$apc_aktiv" -eq 1 ]; then
    # URSPRUENGLICH STAND HIER (erste Runde, GELOESCHT und jetzt per
    # Loeschverbot wiederhergestellt, ZWEITE RUNDE, Wiederherstellung c) der
    # damalige, wortwoertliche Kommentar:
    #
    #   # APC-Blockpool (Auftrag (C) Punkt 2): APC_NUM_BLOCKS Bloecke a 16 Token
    #   # (siehe der Umgebungsaufbau im exec-Zweig weiter unten) decken zusammen
    #   # GENAU $kontext Token ab -- derselbe Speicherbedarf wie ein Prompt-Cache
    #   # in Kontextgroesse. Gebucht wird ueber DIESELBE wb-belegung-Buchung
    #   # (--prompt-cache-gb), die auch fuer mlx_lm.server den Deckelfaktor
    #   # (PROMPT_CACHE_DECKEL_FAKTOR) anwendet -- eine Quelle fuer "wie viel
    #   # bucht ein Cache-Deckel wirklich", nicht zwei.
    #
    # UEBERHOLT: sowohl die Bloeckezahl (nur $kontext, nicht x $parallel) als
    # auch die Buchungsart (--prompt-cache-gb mit dem Deckelfaktor) waren
    # falsch, siehe die Korrektur unten.
    #
    # APC-Blockpool (Auftrag (C) Punkt 2, UEBERARBEITET 2026-09-08, Auftrag
    # "buchung", Kleinkram-Befunde "KV-Wert der tatsaechlichen Quantisierung
    # statt des 2,2-Faktors" und "APC_NUM_BLOCKS x parallel"):
    #
    # APC_NUM_BLOCKS Bloecke a 16 Token (siehe der Umgebungsaufbau im exec-Zweig
    # weiter unten) decken zusammen $kontext x $parallel Token ab, NICHT nur
    # $kontext -- EIN Strom allein waere zu wenig, sobald mehrere gleichzeitige
    # Stroeme unterschiedliche, nicht geteilte Praefixe im selben Pool halten.
    #
    # Gebucht wird ueber --prompt-cache-exakt-gb (cache_ist_exakt=1, siehe
    # belegung_nehmen()), NICHT ueber --prompt-cache-gb: der Blockpool ist eine
    # EXAKTE, feste Zuteilung, kein weicher Deckel, der wie mlx_lm.servers
    # LRUPromptCache gemessen ueberschritten wird -- der PROMPT_CACHE_DECKEL_
    # FAKTOR (x2,2, hergeleitet fuer genau diese Ueberschreitung) waere hier
    # eine Ueberbuchung ohne Gegenstueck in der Wirklichkeit.
    #
    # Die KV-ZAHL muss zur tatsaechlichen Quantisierung passen: bei einem Strom
    # faehrt der Motor mit --kv-bits 8 (kv_quant_buchung/kv_modellname_buchung
    # weiter unten), ab zwei Stroemen OHNE (mlx-vlm 0.6.17, NACHTRAG 24) --
    # derselbe kv8-Name, den die spaetere KV-Buchung dafuer waehlt, gilt deshalb
    # auch hier, nicht blind der groessere unquantisierte Basiswert.
    #
    # NACHTRAG 2026-09-10, Auftrag "apcspeicher": der kv8-Name gilt nur noch, wenn
    # der Motor wirklich quantisiert faehrt. Seit heute ist die Vorgabe dieses
    # Motors unquantisiert (KV_QUANT_MLX_VLM=off); die Bedingung hier kannte das
    # nicht und buchte den APC-Topf mit 0,0332 statt 0,0625 MiB/Token -- halb so
    # viel, wie die Schnappschuesse in bf16 wirklich belegen.
    local apc_kv_modellname="$basisname"
    if [ "$parallel" -le 1 ] && [ "${KV_QUANT_MLX_VLM:-off}" = q8 ] && [ -n "$(kv_mib_je_token_fuer "${basisname}-kv8")" ]; then
      apc_kv_modellname="${basisname}-kv8"
    fi
    local apc_kv_mib; apc_kv_mib="$(kv_mib_je_token_fuer "$apc_kv_modellname")"
    if [ -n "$apc_kv_mib" ]; then
      # LC_ALL=C: awk formatiert Kommazahlen nach LC_NUMERIC. Unter de_DE stand
      # hier "2,0000", und wb-belegung lehnte --prompt-cache-exakt-gb als
      # "invalid float value" ab -- kein Start (gemessen 2026-09-13).
      cache_gib="$(LC_ALL=C awk -v k="$kontext" -v p="$parallel" -v m="$apc_kv_mib" 'BEGIN { printf "%.4f", k * p * m / 1024 }')"
      cache_ist_exakt=1
    else
      err "WARNUNG: kein KV-Bedarf fuer '$basisname' im Register (wb-belegung kv liste) -- der APC-Blockpool wird OHNE Buchung gestartet (keine geratene Zahl). Eintragen mit: wb-belegung kv setzen $basisname <mib-je-token> --herkunft gemessen"
    fi
  fi

  # MIT WELCHER KV-QUANTISIERUNG DIESER SERVER GLEICH FAEHRT (NACHTRAG 11).
  # Die Buchung rechnet damit NICHT -- sie vergleicht es mit dem Registereintrag
  # und sagt einen Widerspruch laut (siehe wb-belegung, --kv-quant). Genau dieser
  # Widerspruch war der Fehler vom 21.08.: gerechnet wurde mit einem bf16-Wert aus
  # der config.json, waehrend die Hausregel seit zwei Tagen q8 vorschreibt.
  # 'off' ist hier kein Versaeumnis, sondern die gemessene Wahrheit fuer diese
  # Motoren (siehe KV_QUANT oben): sie haben den Schalter nicht.
  #
  # Beim Motor mlx-dspark haengt es am ZIELKOERPER: haelt ein Teil seiner Lagen
  # einen rekurrenten Zustand statt eines KV-Caches, nimmt der Motor gar keinen
  # --kv-bits an (siehe dspark_ziel_ist_hybrid oben, gemessen 2026-08-21) --
  # dann laeuft der Cache unquantisiert, und genau das muss hier stehen.
  local dspark_ziel_hybrid=0
  if [ "$motor" = "mlx-dspark" ] && dspark_ziel_ist_hybrid "$MODEL_PATH"; then
    dspark_ziel_hybrid=1
  fi
  local kv_quant_buchung="off"
  if [ "$motor" = "mtplx" ]; then
    kv_quant_buchung="$KV_QUANT"
  elif [ "$motor" = "mlx-dspark" ]; then
    [ "$dspark_ziel_hybrid" -eq 1 ] || kv_quant_buchung="$KV_QUANT"
  elif [ "$motor" = "mlx-vlm" ]; then
    # NACHTRAG 23 (2026-08-27): dieser Motor faehrt mit --kv-bits 8 (siehe den
    # exec-Zweig weiter unten, dort steht die Messung). Die Buchung muss denselben
    # Wert kennen, sonst bucht sie den doppelt so grossen unquantisierten Cache
    # und lehnt Starts ab, die in Wahrheit passen.
    #
    # NACHTRAG 24 (2026-09-01): ab ZWEI Stroemen faehrt er OHNE, weil quantisierter
    # Cache und gebuendeltes spekulatives Dekodieren sich in mlx-vlm 0.6.17
    # ausschliessen (Begruendung und Messung im exec-Zweig). Die Buchung muss
    # denselben Weg gehen, sonst bucht sie halb so viel, wie der Server nimmt --
    # und das ist die gefaehrliche Richtung: zu klein gebucht heisst, ein zweiter
    # Verbraucher bekommt Platz zugesagt, den es nicht gibt. Der Cache kostet
    # dann 0,0625 statt 0,0332 MiB/Token, bei 32768 Token also 2,00 statt 1,06
    # GiB je Strom.
    #
    # NACHTRAG 2026-09-10: auch beim Einzelstrom ist die Vorgabe jetzt "off"
    # (Messung bei KV_QUANT_MLX_VLM); quantisiert wird nur auf ausdrueckliche
    # Anweisung, und genau das bucht die Zeile hier mit.
    if [ "$parallel" -gt 1 ]; then
      kv_quant_buchung="off"
    else
      case "${KV_QUANT_MLX_VLM:-off}" in q8|q4) kv_quant_buchung="$KV_QUANT_MLX_VLM" ;; *) kv_quant_buchung="off" ;; esac
    fi
  elif [ "$motor" = "vllm-metal" ]; then
    # Bei diesem Motor geht der KV-Cache gar nicht in die gebuchte Zahl ein
    # (--metal-fraktion bucht sein Gesamtbudget) -- eine Angabe waere hier eine
    # Aussage ueber eine Groesse, die diese Buchung nicht rechnet.
    kv_quant_buchung=""
  fi

  # Unter WELCHEM Namen der KV-Bedarf nachgeschlagen wird (NACHTRAG 23). Das
  # Register rechnet nichts um, es schlaegt nach -- also braucht der 8-Bit-Fall
  # einen eigenen Schluessel. Er wird nur benutzt, wenn er wirklich eingetragen
  # ist: sonst faellt die Buchung auf den Ersatzwert eines unbekannten Modells
  # zurueck, und das waere fuer ein Modell, dessen unquantisierter Wert sauber
  # gemessen im Register steht, ein Rueckschritt statt einer Verbesserung.
  local kv_modellname_buchung=""
  # NACHTRAG 24 (2026-09-01): nur beim EINZELSTROM. Ab zwei Stroemen faehrt der
  # Motor ohne --kv-bits (siehe oben), und dann ist der kv8-Name die falsche
  # Auskunft -- er nennt den halben Verbrauch. Die Buchung bleibt in dem Fall
  # beim unquantisierten Grundnamen, und das ist die sichere Richtung: lieber
  # eine Buchung, die zu gross ist, als ein zweiter Verbraucher, dem Platz
  # zugesagt wird, den es nicht gibt.
  # NACHTRAG 2026-09-10: der kv8-Schluessel gilt nur noch, wenn der Motor auch
  # wirklich mit --kv-bits 8 faehrt (KV_QUANT_MLX_VLM=q8, Vorgabe ist off).
  if [ "$motor" = "mlx-vlm" ] && [ "$parallel" -le 1 ] && [ "${KV_QUANT_MLX_VLM:-off}" = q8 ]; then
    local kv_kandidat="${basisname}-kv8"
    # NACHTRAG 2026-09-08, Auftrag "buchung", Kleinkram-Befund "grep -F": ueber
    # kv_mib_je_token_fuer() statt eines eigenen grep-Musters -- derselbe exakte
    # Feldvergleich, eine Quelle fuer "steht dieser Schluessel im Register".
    if [ -n "$(kv_mib_je_token_fuer "$kv_kandidat")" ]; then
      kv_modellname_buchung="$kv_kandidat"
    else
      err "HINWEIS: '$kv_kandidat' steht nicht im KV-Register — die Buchung rechnet mit dem unquantisierten Wert von '$basisname', obwohl der Motor mit --kv-bits 8 faehrt. Sie ueberschaetzt damit, sie unterschaetzt nicht. Eintragen mit: wb-belegung kv setzen $kv_kandidat <mib-je-token> --herkunft gemessen --kv-quant q8"
      kv_quant_buchung="off"
    fi
  fi

  # Nachtrag 10: leer fuer die drei alten Motoren (dann laeuft die bisherige
  # Gewichte-plus-KV-Rechnung unveraendert), gesetzt nur fuer vllm-metal.
  local metal_fraktion=""
  if [ "$motor" = "vllm-metal" ]; then
    metal_fraktion="$buendel_fraktion"
  fi

  if ! belegung_nehmen "$basisname" "$gewichte_gb" "$kontext" "$frist_min" "$zweck" "$parallel" "$vorh_gewichte_gb" "$cache_gib" "$metal_fraktion" "$kv_quant_buchung" "$auf_eigene_gefahr" "$kv_modellname_buchung" "$cache_ist_exakt"; then
    # Die AUTOMATISCHE Vorgabe darf hier noch einmal kleiner werden, bevor
    # ganz aufgegeben wird — das ist kein blinder zweiter Versuch derselben
    # abgelehnten Anfrage (der ist verboten), sondern ein zweiter, kleinerer,
    # dokumentierter Wert in derselben Vorgabekette wie oben. Ein von HAND
    # gesetztes --kontext bekommt diesen Rueckfall NICHT: eine ausdrueckliche
    # Wahl wird respektiert, auch wenn sie abgelehnt wird.
    if [ "$kontext_automatisch" -eq 1 ] && [ "$kontext" -ne "$VORGABE_KONTEXT_ALT" ]; then
      err "wb-kontext-Empfehlung ($kontext Token) abgelehnt — letzter Rueckfall: der alte Festwert $VORGABE_KONTEXT_ALT."
      kontext="$VORGABE_KONTEXT_ALT"
      if ! belegung_nehmen "$basisname" "$gewichte_gb" "$kontext" "$frist_min" "$zweck" "$parallel" "$vorh_gewichte_gb" "$cache_gib" "$metal_fraktion" "$kv_quant_buchung" "$auf_eigene_gefahr" "$kv_modellname_buchung" "$cache_ist_exakt"; then
        # ROLLBACK-SICHERHEIT (Gegenleser-Befund Punkt 11): der alte Server
        # ($KAPAZITAETS_ALTER_PID) wurde in diesem Zweig NIE gestoppt (siehe
        # die KAPAZITAETS_NEUSTART-Bedingung weiter oben) -- eine abgelehnte
        # groessere Buchung zerstoert also nichts. $KENNUNG_DATEI zeigt noch
        # unveraendert auf die ALTE Buchung, nicht angefasst.
        if [ "$KAPAZITAETS_NEUSTART" -eq 1 ] && [ -n "$KAPAZITAETS_ALTER_PID" ]; then
          err "Kapazitaets-Neustart abgelehnt (wb-belegung: auch der kleinere Rueckfallkontext $kontext passt nicht) -- der bisherige Server (PID $KAPAZITAETS_ALTER_PID) laeuft unveraendert mit seiner alten Kapazitaet weiter."
          printf 'modell=%s\n' "$(bedienter_modellname "$motor" "$MODEL_PATH")"
          printf 'pid=%s\n' "$KAPAZITAETS_ALTER_PID"
          printf 'neustart=abgelehnt\n'
          return 0
        fi
        return 1
      fi
    else
      # Siehe der Kommentar im Zweig oben (Rollback-Sicherheit, Punkt 11):
      # der alte Server steht hier noch unangetastet.
      if [ "$KAPAZITAETS_NEUSTART" -eq 1 ] && [ -n "$KAPAZITAETS_ALTER_PID" ]; then
        err "Kapazitaets-Neustart abgelehnt (wb-belegung: keine groessere Buchung moeglich) -- der bisherige Server (PID $KAPAZITAETS_ALTER_PID) laeuft unveraendert mit seiner alten Kapazitaet weiter."
        printf 'modell=%s\n' "$(bedienter_modellname "$motor" "$MODEL_PATH")"
        printf 'pid=%s\n' "$KAPAZITAETS_ALTER_PID"
        printf 'neustart=abgelehnt\n'
        return 0
      fi
      return 1
    fi
  fi
  # Kapazitaets-Neustart: JETZT, ERST NACH der erfolgreichen (groesseren)
  # Buchung, wird der alte Server wirklich gestoppt (Gegenleser-Befund Punkt
  # 11) -- vorher lief er unveraendert weiter, die neue Buchung zaehlte ihn
  # (ueber die alte, noch stehende Buchung) einfach zusaetzlich mit, die
  # sichere, nie die gefaehrliche Richtung.
  if [ "$KAPAZITAETS_NEUSTART" -eq 1 ] && [ -n "$KAPAZITAETS_ALTER_PID" ]; then
    # IN-FLIGHT-PRUEFUNG (Gegenleser-Befund Punkt 10): nie still mitten in
    # einer fremden Anfrage abreissen. Bestmoegliches Signal ohne Protokoll-
    # kenntnis des jeweiligen Motors: offene TCP-Verbindungen auf $PORT.
    # Wartet bis zu KAPAZITAETS_INFLIGHT_FRIST_S (Vorgabe 20s), druckt IMMER
    # eine Meldung -- ob leer oder nicht -- und beendet danach so oder so
    # (ein unbegrenztes Warten wuerde den Kapazitaetsengpass, der diesen
    # Neustart ausgeloest hat, nur verlaengern).
    local kap_frist="${WB_MLX_SERVER_KAPAZITAET_INFLIGHT_S:-20}" kap_gewartet=0 kap_offene
    kap_offene="$(lsof -nP -iTCP:"$PORT" -sTCP:ESTABLISHED -t 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${kap_offene:-0}" -eq 0 ] 2>/dev/null; then
      err "Kapazitaets-Neustart: keine offene Verbindung auf Port $PORT -- kein laufendes Gespraech wird unterbrochen."
    else
      err "Kapazitaets-Neustart: ${kap_offene} offene Verbindung(en) auf Port $PORT -- warte bis zu ${kap_frist}s, bevor der alte Server (PID $KAPAZITAETS_ALTER_PID) beendet wird."
      while [ "$kap_gewartet" -lt "$kap_frist" ]; do
        sleep 1; kap_gewartet=$((kap_gewartet + 1))
        kap_offene="$(lsof -nP -iTCP:"$PORT" -sTCP:ESTABLISHED -t 2>/dev/null | wc -l | tr -d ' ')"
        if [ "${kap_offene:-0}" -eq 0 ] 2>/dev/null; then
          err "Kapazitaets-Neustart: Verbindung(en) nach ${kap_gewartet}s geschlossen -- beende jetzt."
          break
        fi
      done
      if [ "${kap_offene:-0}" -gt 0 ] 2>/dev/null; then
        err "WARNUNG: nach ${kap_frist}s immer noch ${kap_offene} offene Verbindung(en) auf Port $PORT -- beende trotzdem (ein laengerer Aufschub verlaengert nur den Kapazitaetsengpass). Mindestens eine laufende Anfrage wird jetzt unterbrochen."
      fi
    fi
    # Befund 2 (siehe KAPAZITAETS_ALTE_KENNUNG oben): der alte Server wird ueber
    # SEINE EIGENE, frueh eingefangene Kennung freigegeben, NIE ueber den
    # --eigene-Fallback von belegung_freigeben -- der wuerde in diesem Pane auch
    # die brandneue Buchung $BELEGUNG_KENNUNG treffen.
    if ! _stop_pruefen_und_beenden "$KAPAZITAETS_ALTER_PID" "$KAPAZITAETS_ALTE_KENNUNG"; then
      # URSPRUENGLICHE FASSUNG (bis 2026-09-08, Auftrag "buchung", Befund 4;
      # stehen gelassen als Beleg der frueheren Entscheidung, siehe unten fuer
      # die Korrektur): "Die neue, groessere Buchung STEHT bereits
      # (BELEGUNG_KENNUNG) -- der alte Prozess laesst sich aber nicht beenden.
      # Bekanntes, nicht neu eingefuehrtes Risiko (derselbe Ausgang wie beim
      # normalen Modellwechsel oben, der an derselben Stelle ebenfalls
      # 'return 1' macht): zwei Buchungen fuer eine Weile im Buch, bis jemand
      # von Hand nachsieht. Kein sichereres Verhalten ohne einen
      # Rueckabwicklungspfad fuer eine schon bestaetigte Buchung, den es an
      # dieser Stelle im Werkzeug nicht gibt." Die zugehoerige Meldung sagte
      # damals "die neue Buchung ... steht trotzdem" UND rief direkt danach
      # das unveraenderte belegung_abbrechen() auf, das genau diese Buchung
      # freigab UND $KENNUNG_DATEI loeschte -- ein WIDERSPRUCH zur eigenen
      # Aussage, und (schwerer) ein Loeschen der Kennungsdatei des noch
      # laufenden, unangetasteten alten Servers (Befund 4).
      #
      # KORREKTUR (Befund 4): die neue Buchung STEHT bereits (BELEGUNG_
      # KENNUNG), aber der alte Prozess laesst sich nicht beenden -- ohne ihn
      # kann der neue nicht auf denselben Port. Der Versuch wird deshalb
      # VERWORFEN: die neue Buchung wird wieder freigegeben (die Meldung sagt
      # das jetzt auch so). $KENNUNG_DATEI bleibt UNANGETASTET
      # (--kennungsdatei-behalten) -- sie zeigt weiterhin korrekt auf den
      # alten, WEITERHIN LAUFENDEN Server, dessen eigene Buchung nie
      # angefasst wurde (der Stopp ist ja gescheitert). Kein "zwei Buchungen
      # im Buch"-Risiko mehr: es bleibt nur die eine, gueltige, alte.
      err "Kapazitaets-Neustart: alter Server (PID $KAPAZITAETS_ALTER_PID) liess sich nicht beenden -- die neue Buchung $BELEGUNG_KENNUNG wird verworfen, der alte Server laeuft mit seiner alten Kapazitaet unveraendert weiter. Von Hand pruefen: wb-mlx-server status, wb-belegung wer."
      belegung_abbrechen --kennungsdatei-behalten
      return 1
    fi
    # Ab hier ist der alte Server SICHER beendet und seine eigene Buchung
    # (KAPAZITAETS_ALTE_KENNUNG) SICHER freigegeben (belegung_freigeben_gezielt
    # in _stop_pruefen_und_beenden lief bereits) -- kein weiterer Freigabeschritt
    # noetig.
    #
    # URSPRUENGLICH STAND HIER (erste Runde dieses Auftrags, GELOESCHT und
    # jetzt per Loeschverbot wiederhergestellt, ZWEITE RUNDE, Wiederherstellung
    # a) folgender, damals AKTIVER Code mit seiner Begruendung:
    #
    #   # Geschwister-Einzelbuchungen freigeben (Nachtrag 2026-09-08, siehe
    #   # gebuchte_kennungen() weiter oben fuer die Entscheidung und ihre
    #   # Begruendung): NUR bei einem kapazitaetsbedingten Neustart, und ERST HIER,
    #   # nachdem die neue, groessere Buchung ($BELEGUNG_KENNUNG) bereits steht --
    #   # nie davor. "wb-belegung gib ... --fremd", weil diese Buchungen fremden
    #   # Panes gehoeren (pi-workers eigene "Eigene Sequenz"-Buchungen), nicht
    #   # diesem wb-mlx-server-Prozess.
    #   if [ "$KAPAZITAETS_NEUSTART" -eq 1 ] && [ -n "$BELEGUNG_KENNUNG" ]; then
    #     local wbb_release alte_kennung
    #     wbb_release="$(belegung_bin)"
    #     if [ -n "$wbb_release" ]; then
    #       gebuchte_kennungen "$basisname" "$BELEGUNG_KENNUNG" | while IFS= read -r alte_kennung; do
    #         [ -n "$alte_kennung" ] || continue
    #         if "$wbb_release" gib "$alte_kennung" --fremd >/dev/null 2>&1; then
    #           err "Geschwister-Buchung $alte_kennung freigegeben -- in der neuen Buchung $BELEGUNG_KENNUNG (Kapazitaet $parallel) bereits mitgezaehlt."
    #         else
    #           err "WARNUNG: Geschwister-Buchung $alte_kennung liess sich nicht freigeben -- sie zaehlt jetzt zusaetzlich zur neuen Buchung $BELEGUNG_KENNUNG, also ueberschaetzt statt unterschaetzt (die sichere Richtung)."
    #         fi
    #       done
    #     fi
    #   fi
    #
    # ENTFAELLT SEIT DER ERSTEN RUNDE (nicht mehr aufgerufen -- gebuchte_kennungen()
    # selbst bleibt aus demselben Loeschverbot als UEBERHOLT markiert stehen, siehe
    # dort): der neue Server bucht NIE mehr Stroeme fuer andere Worker mit --
    # zuerst ueber --nur-gewichte (erste Runde), inzwischen (ZWEITE RUNDE, siehe
    # "BASISSTROM STATT --nur-gewichte" bei belegung_nehmen()) ueber einen FESTEN,
    # eigenen Basisstrom, der KEINE fremde Worker-Buchung ersetzt oder beruehrt.
    # In BEIDEN Fassungen gilt: es gibt keine Geschwister-Buchungen mehr, die dem
    # Serverstart je gehoert haetten -- jede Strom-Buchung bleibt unangetastet
    # beim Worker, der sie haelt, ein Kapazitaets-Neustart aendert daran nichts.
    err "WICHTIG: '$laufend' (PID $KAPAZITAETS_ALTER_PID) ist jetzt beendet -- bis der angeforderte Neustart gelingt, laeuft KEIN mlx-lokal-Server mehr. Scheitert er, bleibt das so; die naechste Fehlermeldung nennt den Grund."
  fi
  mkdir -p "$(dirname "$KENNUNG_DATEI")" 2>/dev/null
  if [ -n "$BELEGUNG_KENNUNG" ]; then
    printf '%s\n' "$BELEGUNG_KENNUNG" > "$KENNUNG_DATEI"
  else
    rm -f "$KENNUNG_DATEI"
  fi
  # Ab hier haelt dieser Lauf ggf. eine Belegung -- jeder Abbruchpfad
  # darunter muss sie wieder freigeben (belegung_abbrechen).
  #
  # WB_MLX_SERVER_LOG_LEVEL (optional, unveraendert die Vorgabe INFO von
  # mlx_lm.server, wenn nicht gesetzt): reicht --log-level durch. Eingefuehrt
  # fuer die Denkstufen-Messung 2026-08-19 (siehe unten "DENKSTUFE") -- erst
  # mit DEBUG loggt mlx_lm.server den vollen eingehenden Anfragekoerper
  # (server.py:1148f, 'Incoming Request Body'), und nur darin steht, ob
  # chat_template_kwargs/reasoning_effort ueberhaupt ankommt. "$@" statt eines
  # Arrays, weil /bin/bash auf dieser Maschine 3.2 ist (Apple, letzte GPLv2-
  # Fassung) -- ein LEERES Array unter "${arr[@]}" wirft dort unter `set -u`
  # "unbound variable", ein leeres "$@" nicht.
  local newpid
  if [ "$motor" = "mlx-dspark" ]; then
    # mlx-dspark serve (Nachtrag 7) -- kein --decode-concurrency/
    # --prompt-concurrency (kennt das Werkzeug nicht, siehe --help), dafuer
    # --drafter fuer den externen Entwerfer und --prefix-cache-slots fuer die
    # Zahl gleichzeitig vorgehaltener Worker-Praefixe (nur explizit gesetzt,
    # wenn $parallel > 1 -- sonst greift mlx-dsparks eigene Vorgabe von 2,
    # die fuer den Regelfall "ein Aufrufer" bereits ausreicht und nicht
    # kleiner gemacht werden soll).
    set -- serve --model "$MODEL_PATH" --drafter "$vorh_modell" \
      --host 127.0.0.1 --port "$PORT"
    # --mode dflash NUR wenn der Entwerfer selbst ein DFlash-Checkpoint ist
    # (siehe dspark_ist_dflash_entwerfer oben, ECHTE Datei-Beobachtung, kein
    # geratener Festwert) -- mlx-dsparks eigene "auto"-Erkennung erkennt
    # DFlash NICHT (echter Fund, 2026-08-20, siehe dort). Fuer andere Formate
    # (DSpark) bleibt --mode bewusst unangetastet, weil "auto" laut
    # mlx-dspark-Dokumentation genau dafuer da ist -- das ist bislang NICHT
    # an einem echten DSpark-Entwerfer nachgemessen (siehe OPEN im Ergebnis
    # 20260820-014918.md), nur aus --help/Quelltext abgeleitet.
    if dspark_ist_dflash_entwerfer "$vorh_modell"; then
      set -- "$@" --mode dflash
    fi
    if [ "$parallel" -gt 1 ]; then
      set -- "$@" --prefix-cache-slots "$parallel"
    fi
    # 8-Bit-KV, dieselbe Hausregel wie bei mtplx (siehe KV_QUANT oben). Der Schalter
    # heisst hier --kv-bits und nimmt Zahlen; 'off' waere 0. FUER EINEN
    # HYBRIDKOERPER GIBT ES IHN NICHT (gemessen 2026-08-21, siehe
    # dspark_ziel_ist_hybrid): der Motor bricht dann schon beim Laden ab. Die
    # Buchung weiss davon (kv_quant_buchung oben), es wird also nichts kleiner
    # gebucht als gefahren -- gesagt wird es trotzdem, denn die Hausregel
    # "immer 8 Bit" ist auf diesem Weg nicht erfuellt, und das darf niemand
    # aus dem Schweigen dieses Skripts schliessen.
    if [ "$dspark_ziel_hybrid" -eq 1 ]; then
      err "KV-Quantisierung ist fuer diesen Koerper nicht zu haben: '$MODEL_PATH' haelt in einem Teil seiner Lagen einen rekurrenten Zustand statt eines KV-Caches (config.json, layer_types: linear_attention), und mlx-dspark lehnt --kv-bits dafuer ab ('their recurrent-state caches are not KV caches'). Der Cache laeuft unquantisiert; die Buchung rechnet mit genau diesem Wert, nicht mit dem quantisierten."
    else
      case "$KV_QUANT" in
        q8)  set -- "$@" --kv-bits 8 ;;
        q4)  set -- "$@" --kv-bits 4 ;;
        off) set -- "$@" --kv-bits 0 ;;
      esac
    fi
    # --context-window: derselbe Satz wie beim mtplx-Zweig darunter, und aus
    # demselben Grund (Nachtrag 19, 2026-08-21). Der Schalter existiert
    # (`mlx-dspark serve --help`), wurde hier aber nie gesetzt -- der Server
    # lief also auf dem Modellmaximum weiter, waehrend das Buch $kontext
    # eintrug. Eine Buchung, die ein kleineres Fenster nennt als das
    # gefahrene, ist keine Bremse mehr. Was gebucht ist, laeuft.
    set -- "$@" --context-window "$kontext"
    local denken; denken="$(chat_template_denken_wert)"
    if [ -n "$denken" ]; then
      set -- "$@" --reasoning-effort "$denken"
    fi
    # HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE=1 an ALLEN FUENF Motor-Starts
    # (Nachtrag 2026-09-08, Auftrag "kontextgewichte", FUENFTER TEIL, SICHERHEIT):
    # gemessen, dass mlx_vlm.server JEDEN im Feld 'model' einer Anfrage
    # genannten Namen von Hugging Face nachlaedt, auch wenn der Server mit
    # einem ganz anderen Modell gestartet wurde -- eine Anfrage mit
    # "Tongyi-MAI/Z-Image-Turbo" lud 31 GB in ~8 min, /v1/models listete danach
    # den ganzen HF-Cache. `mlx_vlm.server --help` kennt keinen Schalter, der
    # Fremdmodelle ablehnt. HF_HUB_OFFLINE=1 ist der Standardweg der
    # Huggingface-Hub-Bibliothek, jeden Netzwerkzugriff hart abzulehnen, statt
    # ihn stillschweigend auszufuehren -- lokale MLX-Modellverzeichnisse (der
    # einzige Weg, den diese Werkbank benutzt) sind davon nicht betroffen, nur
    # ein Nachladeversuch von aussen. Gesetzt an allen fuenf Motoren, nicht nur
    # mlx_vlm.server: dieselbe Vorsicht kostet bei den anderen vier nichts, und
    # ob sie dieselbe Luecke haben, ist ungemessen.
    newpid="$(HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_CACHE="$HF_HUB_CACHE_LEER" \
      "$HOME/.local/bin/wb-nohup" "$NAME" -- mlx-dspark "$@")" || {
      err "wb-nohup konnte mlx-dspark nicht starten — siehe $LOG"
      belegung_abbrechen; return 1
    }
  elif [ "$motor" = "mtplx" ]; then
    # mtplx serve (Nachtrag 8) -- natives MTP, eigener Motor. GEMESSEN
    # gewinnt --scheduler-mode serial (siehe Kopfkommentar Nachtrag 8):
    # mtp_batch scheitert architekturbedingt egal welche Schalter dazukommen
    # (messrunde4c: sieben erfuellte Bedingungen, dann trotzdem
    # QwenRowOwnedRouterConfigError) -- serial ist deshalb FEST, kein
    # Aufrufer-Schalter dafuer. --no-auth: derselbe lokale Betrieb wie bei
    # mlx_lm.server/mlx-dspark, kein API-Key-Umlauf noetig (127.0.0.1-Bind).
    #
    # --paged-kv-quantization (NACHTRAG 11, 2026-08-21): der KV-Cache laeuft
    # auf 8 Bit, siehe KV_QUANT oben und die Hausregel dort. mtplx ist der
    # EINZIGE der fuenf Motoren, der den Schalter FEST GESETZT bekommt --
    # deshalb steht die Hausregel bis heute nur hier im Code, und deshalb muss
    # sie gerade hier stehen: fuer diesen Motor gab es keinen Grund, sie nicht
    # einzuhalten, ausser dass niemand den Schalter gesucht hat.
    #
    # --context-window: der Server faehrt mit dem Fenster, das GEBUCHT wurde.
    # Bis zum 21.08. bekam mtplx gar keinen Kontextschalter und lief damit
    # auf dem Modellmaximum (262144) weiter, waehrend das Buch $kontext
    # eintrug -- eine Buchung, die den halben Bedarf nennt, ist keine Bremse
    # mehr, sondern eine Zusage, die niemand einhaelt. Was gebucht ist, laeuft.
    set -- serve --model "$MODEL_PATH" --host 127.0.0.1 --port "$PORT" \
      --no-auth --scheduler-mode serial \
      --paged-kv-quantization "$KV_QUANT" \
      --context-window "$kontext" \
      --prefill-chunk-tokens "$PREFILL_CHUNK_TOKENS"
    local denken; denken="$(chat_template_denken_wert)"
    if [ -n "$denken" ]; then
      set -- "$@" --reasoning-effort "$denken"
    fi
    newpid="$(HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_CACHE="$HF_HUB_CACHE_LEER" \
      "$HOME/.local/bin/wb-nohup" "$NAME" -- mtplx "$@")" || {
      err "wb-nohup konnte mtplx nicht starten — siehe $LOG"
      belegung_abbrechen; return 1
    }
  elif [ "$motor" = "vllm-metal" ]; then
    # vllm serve (Nachtrag 10) -- rein buendelnd, KEINE Vorhersage und deshalb
    # auch KEIN --no-async-scheduling (siehe Kopfkommentar: der Schalter ist
    # die Auflage fuer spekulatives Dekodieren, das hier fuer diese
    # Architektur ausfaellt -- er kostete 5 % im Einzelstrom und braechte
    # nichts).
    #
    # Das Modell steht POSITIONELL, so wie `vllm serve <pfad>` es verlangt.
    # --served-model-name traegt denselben Pfad zusaetzlich, weil vLLM den
    # Modellnamen einer Anfrage anders als mlx_lm.server tatsaechlich prueft
    # und jeder bestehende Aufrufer (pi ueber ~/.pi/agent/models.json,
    # wb-modell-proxy) den Pfad als Namen schickt; die Kennung kommt als
    # zweiter Name dazu, damit auch `-m qwen38-27b` bedient wird. Nebeneffekt,
    # auf den sich laufendes_modell() stuetzt: der Pfad steht damit in der
    # lebenden Kommandozeile.
    set -- serve "$MODEL_PATH" --served-model-name "$MODEL_PATH"
    if [ -n "${RES_ID:-}" ]; then
      set -- "$@" "$RES_ID"
    fi
    set -- "$@" --host 127.0.0.1 --port "$PORT" \
      --max-model-len "$kontext" \
      --max-num-seqs "$deckel"
    # Dieselbe Denkstufen-Vorgabe wie bei mlx_lm.server, nur heisst der
    # Schalter hier anders: --default-chat-template-kwargs wird mit dem
    # verschmolzen, was eine Anfrage selbst mitbringt (cli_args.py:93-95).
    # Ohne ihn stuende Qwen3.8s Vorlage auf xhigh -- siehe DENKSTUFEN-FALLE.
    if [ -n "$RES_CHAT_TEMPLATE_ARGS" ] && [ "$RES_CHAT_TEMPLATE_ARGS" != "null" ]; then
      set -- "$@" --default-chat-template-kwargs "$RES_CHAT_TEMPLATE_ARGS"
    fi
    # VLLM_METAL_MEMORY_FRACTION als Umgebungsvariable, NICHT als
    # --gpu-memory-utilization: die beiden sind nicht dasselbe, siehe
    # Kopfkommentar NACHTRAG 10 (is_auto_memory aendert, was platform.py dem
    # Motor als Gesamtspeicher meldet). VLLM_METAL_USE_PAGED_ATTENTION=1
    # gehoerte zur gemessenen Fassung und bleibt deshalb gesetzt.
    newpid="$(VLLM_METAL_MEMORY_FRACTION="$buendel_fraktion" \
      VLLM_METAL_USE_PAGED_ATTENTION=1 \
      HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_CACHE="$HF_HUB_CACHE_LEER" \
      "$HOME/.local/bin/wb-nohup" "$NAME" -- "$buendel_bin" "$@")" || {
      err "wb-nohup konnte vllm nicht starten — siehe $LOG"
      belegung_abbrechen; return 1
    }
  elif [ "$motor" = "mlx-vlm" ]; then
    # mlx_vlm.server (Nachtrag 22, 2026-08-27) -- eigenstaendiges Werkzeug,
    # dasselbe Modell wie mlx_lm.server ueber denselben MLX-Kern, aber ein
    # eigener Ladepfad, der (anders als mlx_lm.server, siehe Null-Resultat
    # Nachtrag 7) einen externen Entwerfer wirklich annimmt UND dessen Bauart
    # unterscheidet: --draft-kind {dflash,eagle3,mtp} kommt aus der Registry
    # (vorh_draftkind, siehe Motorwahl oben), NICHT geraten.
    #
    # FALLSTRICK 1 (Auftrag 2026-08-27, echt erlebt): der Server nimmt fuer
    # `model` im Anfragekoerper NUR einen vollen Pfad an -- ein Kurzname loest
    # einen HuggingFace-Ladeversuch aus und antwortet 400. bedienter_modellname()
    # weiss das schon (motor != "mtplx" -> Fallback bleibt der Pfad), hier
    # steht nur die Erinnerung, warum $MODEL_PATH unten unveraendert bleibt.
    #
    # FALLSTRICK 2 (Auftrag 2026-08-27, echt erlebt): ohne jinja2 im selben
    # Werkzeugbaum scheitert jede Chat-Anfrage mit "apply_chat_template
    # requires jinja2" (HTTP 500) -- der Server startet trotzdem sauber und
    # meldet "Drafter ready". Die Probeanfrage weiter unten prueft eine ECHTE
    # Antwort, kein reiner /health-Rauchtest -- genau deshalb faengt sie das ab.
    set -- --model "$MODEL_PATH" --draft-model "$vorh_modell" \
      --draft-kind "$vorh_draftkind" \
      --host 127.0.0.1 --port "$PORT"
    if [ -n "$vorh_draftblocksize" ]; then
      set -- "$@" --draft-block-size "$vorh_draftblocksize"
    fi
    # --enable-thinking: Vorgabe des Nutzers vom 2026-08-29, "ja immer enable
    # thinking". Sie stellt die stehende Regel "Worker denken immer, mindestens
    # low" auf diesem Weg ueberhaupt erst wieder her.
    #
    # ANLASS, GEMESSEN gegen den laufenden Server, dreimal dieselbe Aufgabe:
    #   ohne Angabe            398 Antwort-Token, Denkspur    0 Zeichen
    #   enable_thinking=True   292 Antwort-Token, Denkspur  570 Zeichen
    # Der MTP-Weg dachte also GAR NICHT. Die Schutzvorgabe aus der Registry
    # (chatTemplateArgs={"reasoning_effort":"low"}, Nachtrag 3) greift hier
    # nicht: sie ist fuer mlx_lm.server gebaut, und mlx_vlm.server kennt
    # `reasoning_effort` nicht -- drei Anfragen mit xhigh, low und ohne Angabe
    # lieferten Token fuer Token dieselbe Antwort. Dieser Motor hat stattdessen
    # eigene Schalter (--enable-thinking, --thinking-budget, siehe
    # `mlx_vlm.server --help`), und seit er am 2026-08-27 der Vorgabeweg wurde,
    # lief jeder qwen38-Worker ohne Denkleistung.
    #
    # Bewusst OHNE --thinking-budget: die Denktiefe soll nicht beschnitten
    # werden (der Nutzer am selben Tag: hohe Denkstufe bleibt, angepasst werden
    # die ANWEISUNGEN). Ein Aufrufer, der es anders braucht, setzt
    # enable_thinking oder thinking_budget je Anfrage -- beides ueberschreibt
    # diese Vorgabe, wie `--help` des Motors ausdruecklich sagt.
    set -- "$@" --enable-thinking
    # --max-kv-size: der einzige Kontextschalter, den dieser Motor kennt
    # (siehe laufender_kontext -- ohne ihn liefe der Server auf dem
    # Modellmaximum, waehrend das Buch $kontext eintraegt). Was gebucht ist,
    # laeuft, wie bei mtplx/vllm-metal.
    set -- "$@" --max-kv-size "$kontext"
    # --max-tokens: NACHGETRAGEN 2026-08-27, an einem echten Worker-Lauf gefunden.
    # Ohne diesen Schalter gilt die Vorgabe des Werkzeugs von 2048 Token je Antwort --
    # und die ist fuer einen Worker viel zu klein: der Messlauf brach mitten im Schreiben
    # ab, der Server meldete `finish_reason=length` bei genau 2048, und im Pane stand
    # "Response was truncated before completion".
    #
    # KORRIGIERT wenige Stunden spaeter, am selben Tag, weil die erste Fassung
    # (kontext/2) einen zweiten Fehler einbaute: dieser Motor prueft `Prompt +
    # max_tokens <= MAX_KV_SIZE` und lehnt sonst mit HTTP 400 ab. Der Deckel ist
    # also nicht nur eine Obergrenze fuer die Antwort, er NIMMT dem Prompt genau
    # so viel Platz weg. Mit kontext/2 blieben von 32768 Token nur 16384 fuer das
    # Gespraech -- ein Worker, dessen Sitzung darueber hinauswuchs, bekam auf JEDE
    # weitere Anfrage "Error: 400 status code (no body)" (erlebt im warmen Lauf von
    # dflash2, zweimal; der Wortlaut des Servers dazu lautet "Request needs 37540
    # context tokens (37520 prompt + 20 max generation), but MAX_KV_SIZE is 32768").
    # Ein Viertel laesst dem Gespraech drei Viertel des Fensters und deckt trotzdem
    # jede Antwort, die heute gemessen wurde (die laengste hatte 5216 Token).
    set -- "$@" --max-tokens "$(( kontext / 4 ))"
    # --kv-bits: seit 2026-08-27 GEMESSEN und deshalb gesetzt. Die Lueckennotiz,
    # die hier stand ("existiert, ist aber an dieser Hybridarchitektur nicht
    # gemessen"), ist damit geschlossen. Anders als mlx-dspark, das den Schalter
    # fuer diesen Koerper rundheraus ablehnt ("their recurrent-state caches are
    # not KV caches"), nimmt mlx_vlm.server ihn an und sagt es beim Start:
    # "KV cache quantization: bits=8.0 scheme=uniform". Gemessen wurde nicht nur
    # der Start, sondern eine echte Antwort -- eine Anfrage mit 10556 Prompt-Token
    # kam inhaltlich korrekt und mit intakten Umlauten zurueck, und 3000 Token
    # liefen mit 22,8 Tok/s, also in derselben Spanne wie ohne Quantisierung
    # (24,19 kalt / 21,70 warm). Der Cache kostet damit 0,0332 statt 0,0625
    # MiB/Token, bei 32768 Token also 1,06 statt 2,00 GiB.
    #
    # --kv-group-size 64 steht ausdruecklich da und ist keine Kosmetik: der
    # gebuchte Wert wurde mit QuantizedKVCache(bits=8, group_size=64) gemessen,
    # und eine andere Gruppengroesse waere eine andere Zahl. Was gebucht ist,
    # laeuft.
    #
    # NACHTRAG 24 (2026-09-01) -- KV-QUANTISIERUNG UND MEHRERE STROEME SCHLIESSEN
    # EINANDER AUS, UND ZWAR AN EINER EINZIGEN ZEILE FREMDEN CODES:
    #   mlx_vlm/models/qwen3_5/language.py:827
    #     if hasattr(cache, "bits") or queries.ndim != 4 or keys.ndim != 4:
    #         return None
    # Sobald der Cache quantisiert ist, steigt die gebuendelte Aufmerksamkeit aus
    # und der Rueckfall dahinter greift -- der erwartet ein Array, bekommt aber
    # die quantisierten Keys als Tupel und stirbt mit
    #   AttributeError: 'tuple' object has no attribute 'shape'
    #   speculative_verifier.py:1269, prefix_length = keys.shape[-2] - length
    # GEMESSEN am 01.09.2026, vier Konfigurationen, je eigener Serverstart:
    #   --kv-bits 8                                  -> HTTP 500 ab 2 Stroemen
    #   --kv-bits 8 --quantized-kv-start 2048        -> HTTP 500 ab 2 Stroemen
    #   --kv-bits 8 --kv-key-bits 16 --kv-value-bits 8 -> HTTP 500 ab 2 Stroemen
    #   ohne --kv-bits                               -> laeuft bis 4 Stroeme
    # Der Startindex hilft nicht, weil die Pruefung am TYP des Caches haengt und
    # nicht daran, ob schon quantisiert wurde; getrennte Bitbreiten helfen aus
    # demselben Grund nicht. mlx-vlm 0.6.17 ist die neueste Fassung -- ein
    # Update behebt es nicht, weil es schon das Update ist. Nicht blind gepatcht:
    # der Rueckfall schneidet danach in keys/values hinein, das ist mehr als eine
    # Zeile, und ein falscher Fix erzeugt hier stille Zahlenfehler statt eines
    # Absturzes.
    #
    # ALSO: EIN Strom behaelt die Quantisierung (der Cache kostet dann 0,0332
    # statt 0,0625 MiB/Token), MEHRERE bekommen sie nicht. Entscheidung des Nutzers
    # vom 01.09.2026 im Wortlaut: "wenn kv quant dann wirklich nicht geht, dann
    # denk daran das es bei einem modell immernoch an bleibt nur bei mehreren aus".
    # Was mehrere Stroeme dafuer einbringen, GEMESSEN am selben Abend (300 Token
    # je Strom, gleiche Laenge erzwungen, Tok/s gesamt / je Strom):
    #   1 Strom   20,2 / 20,2      2 Stroeme 32,1 / 16,0
    #   3 Stroeme 31,2 / 10,5      4 Stroeme 30,8 /  7,7
    # Der Gewinn sitzt bei ZWEI (+59 % gesamt); darueber bleibt die Gesamtrate
    # stehen. Ab drei Stroemen ist die Buendelung OHNE Vorhersage besser
    # (51,5 Tok/s gesamt, NACHTRAG 9) -- der Motorwechsel dort bleibt richtig.
    # MESSBEDINGUNG, die dazugehoert: die Zahlen oben entstanden am 01.09.2026
    # auf der damals INSTALLIERTEN Fassung dieses Skripts, und die trug
    # --enable-thinking noch nicht (das Repo schon -- die Kopie unter
    # ~/.local/bin war aelter, aufgefallen erst durch wb-consistency danach).
    # Gemessen wurde also ohne Denkspur. Fuer die Frage, OB der Durchsatz mit
    # der Stromzahl waechst, aendert das nichts; die absoluten Raten koennen
    # mit Denken anders liegen, weil je Aufgabe mehr Token entstehen.
    if [ "$parallel" -gt 1 ]; then
      err "Mehrere Stroeme ($parallel): --kv-bits bleibt WEG. Quantisierter KV-Cache und gebuendeltes spekulatives Dekodieren schliessen sich in mlx-vlm 0.6.17 aus (language.py:827, dann AttributeError in speculative_verifier.py:1269) -- GEMESSEN 01.09.2026, auch mit --quantized-kv-start und getrennten Key/Value-Bits. Der Cache kostet dadurch 0,0625 statt 0,0332 MiB/Token."
      set -- "$@" --max-num-seqs "$parallel"
    else
      # NACHTRAG 2026-09-10: Vorgabe OHNE --kv-bits (Messung bei KV_QUANT_MLX_VLM
      # oben: 19,6 statt 14,5 tok/s bei 38k Kontext). Wer den kleineren Cache
      # braucht, setzt WB_MLX_SERVER_KV_QUANT=q8 oder q4 ausdruecklich.
      # ${...:-off}: test-mlx-server-mlx-vlm-070.sh sourct nur diesen Block, ohne
      # den Kopf, in dem KV_QUANT_MLX_VLM gesetzt wird.
      case "${KV_QUANT_MLX_VLM:-off}" in
        q8) set -- "$@" --kv-bits 8 --kv-group-size 64 ;;
        q4) set -- "$@" --kv-bits 4 --kv-group-size 64 ;;
        *)  err "KV-Cache unquantisiert (Vorgabe fuer mlx_vlm.server seit 2026-09-10: 19,6 statt 14,5 tok/s bei 38k Kontext; WB_MLX_SERVER_KV_QUANT=q8 schaltet zurueck)." ;;
      esac
    fi
    # --model-discovery served (Auftrag (C) Punkt 3, nur ab 0.7.0, siehe
    # model_discovery_ok oben): ohne den Schalter listet /v1/models den
    # GANZEN Hugging-Face-Cache dieser Maschine (gemessen 20:59 Uhr, siehe
    # SICHERHEIT weiter oben bei HF_HUB_OFFLINE) -- "served" begrenzt das auf
    # das wirklich geladene Modell.
    if [ "$model_discovery_ok" -eq 1 ]; then
      set -- "$@" --model-discovery served
    fi
    # APC-Umgebung (Auftrag (C) Punkt 2, nur wenn apc_aktiv=1, siehe oben):
    # APC hat KEINE Befehlszeilenschalter, nur Umgebungsvariablen. 16 Token je
    # Block ist die im Auftrag genannte Blockgroesse; APC_NUM_BLOCKS x 16
    # deckt damit genau $kontext Token ab (Vorgabe im Auftrag: 2048 Bloecke x
    # 16 = 32768 fuer einen 32k-Kontext -- dieselbe Formel, allgemein
    # geschrieben). APC_EXACT_CACHE_ENTRIES=2 ist der im Auftrag genannte
    # Wert; Hybridmodelle laufen im APC laut dessen eigenem Kopfkommentar
    # (apc.py) im checkpoint/exact-Modus.
    #
    # x $parallel (Nachtrag 2026-09-08, Auftrag "buchung", Kleinkram-Befund
    # "APC_NUM_BLOCKS deckt nur einen Strom"): der Pool ist EIN gemeinsamer Topf
    # fuer ALLE gleichzeitigen Stroeme, nicht je Strom ein eigener -- bei
    # mehreren Stroemen mit unterschiedlichen, nicht geteilten Praefixen deckt
    # ein Pool fuer nur $kontext Token (statt $kontext x $parallel) den
    # Bedarf nicht, der Pool wirft dann staendig noch relevante Eintraege
    # hinaus. Dieselbe Skalierung wie bei der Buchung selbst (siehe cache_gib
    # weiter oben, cache_ist_exakt) -- eine Quelle fuer "wie gross muss der
    # Pool sein", nicht zwei auseinanderlaufende.
    local apc_env=()
    if [ "$apc_aktiv" -eq 1 ]; then
      # APC_EXACT_CACHE_ENTRIES und die Knoepfe darunter: NACHTRAG 2026-09-10,
      # Auftrag "apcspeicher" (Bedeutung und Pruefung bei apc_gewuenscht oben).
      # VORGABE: SCHLANK an, sobald der Patch da ist (apc_patch_ok, siehe die
      # mlx-vlm-Pruefung), und ein Schnappschuss je Strom. Ohne Patch bleiben
      # es zwei Eintraege: mlx_vlm legt dann je Anfrage zwei Schnappschuesse an
      # (N-1 und N), und nur N-1 trifft eine Fortsetzung -- mit einem Eintrag
      # bliebe ausgerechnet der nutzlose uebrig (gemessen, Stufe 38k Runde 1).
      local apc_schlank_wirkt=0 apc_eintraege_vorgabe=2
      if [ "${WB_MLX_SERVER_APC_SCHLANK:-1}" = 1 ] && [ "${apc_patch_ok:-0}" -eq 1 ]; then
        apc_schlank_wirkt=1
        apc_eintraege_vorgabe="$parallel"
      fi
      apc_env=(APC_ENABLED=1 "APC_NUM_BLOCKS=$(( kontext * parallel / 16 ))" "APC_EXACT_CACHE_ENTRIES=${WB_MLX_SERVER_APC_EINTRAEGE:-$apc_eintraege_vorgabe}")
      if [ "$apc_schlank_wirkt" -eq 1 ]; then
        # APC_WB_CACHE_LIMIT_GB (WB_MLX_SERVER_APC_POOL_GB, Vorgabe 0 = kein
        # Deckel): Deckel fuer MLXs Vorrat freigegebener Puffer. Er ist belegter
        # Metal-Speicher (bei 60k Token lagen 10 GiB darin, neben 24 GiB aktiv),
        # aber MLX gibt ihn selbst frei, sobald aktiv + Vorrat 95 % des
        # Metal-Arbeitssatzes erreichen (gemessen bei 128k: 25,6 + 14,0 GiB).
        # Ob ein Deckel Dekodierrate kostet, ist UNBELEGT: der Lauf mit 2 GiB
        # brach bei 38k ein, der Kontrolllauf OHNE Deckel unter derselben
        # Fremdlast genauso (2026-09-10). Vorgabe bleibt deshalb das unveraenderte
        # Verhalten von mlx_vlm; der Deckel ist fuer knappe Lagen da.
        apc_env+=(APC_WB_ONE_STORE=1 APC_WB_LEAN_STORE=1 APC_WB_LEAN_LOOKUP=1 APC_WB_FREE_DONE=1)
        if [ "${WB_MLX_SERVER_APC_POOL_GB:-0}" != 0 ]; then
          apc_env+=("APC_WB_CACHE_LIMIT_GB=$WB_MLX_SERVER_APC_POOL_GB")
        fi
      fi
      if [ -n "${WB_MLX_SERVER_APC_SNAPSHOT_BITS:-}" ]; then
        apc_env+=("APC_WB_SNAPSHOT_BITS=$WB_MLX_SERVER_APC_SNAPSHOT_BITS")
      fi
      # 2 = zusaetzlich eine Zeile je Prefill-Chunk (Fehlersuche).
      case "${WB_MLX_SERVER_APC_MEMLOG:-0}" in
        1|2) apc_env+=("APC_WB_MEMLOG=$WB_MLX_SERVER_APC_MEMLOG") ;;
      esac
      if [ -n "${WB_MLX_SERVER_APC_DISK:-}" ]; then
        # APC_DISK_MIN_FREE_RAM_GB=0: sonst laedt mlx_vlm nichts von der SSD
        # zurueck, sobald "frei + inaktiv" unter 2 GB liegt -- auf diesem Mac der
        # Normalzustand (vm_stat; psutil fehlt im venv).
        apc_env+=("APC_DISK_PATH=$WB_MLX_SERVER_APC_DISK" "APC_DISK_MAX_GB=${WB_MLX_SERVER_APC_DISK_GB:-64}" APC_DISK_MIN_FREE_RAM_GB=0)
      fi
    fi
    # "env ..." statt Array-Elemente direkt vor den Befehl zu stellen: ein per
    # "${arr[@]}" expandiertes Element wird von bash NICHT als
    # Umgebungszuweisung erkannt (das geht nur bei woertlich im Quelltext
    # stehenden VAR=wert-Woertern) -- GEMESSEN, das fruehere "${apc_env[@]}"
    # direkt vor wb-nohup scheiterte mit "APC_ENABLED=1: command not found".
    # `env` nimmt VAR=wert-Argumente dagegen ausdruecklich als eigene, nicht
    # als Shell-Syntax entgegen und setzt sie fuer den Kindprozess -- bei
    # leerem apc_env (APC nicht aktiv) ruft es "env" ohne Zusatzargumente auf,
    # was wirkungslos ist (keine Verhaltensaenderung ausserhalb von APC).
    newpid="$(HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_CACHE="$HF_HUB_CACHE_LEER" \
      env "${apc_env[@]+"${apc_env[@]}"}" \
      "$HOME/.local/bin/wb-nohup" "$NAME" -- "$MLX_VLM_BIN" "$@")" || {
      err "wb-nohup konnte mlx_vlm.server nicht starten — siehe $LOG"
      belegung_abbrechen; return 1
    }
  else
    # --prompt-cache-bytes: der Deckel, der oben gebucht wurde, jetzt auch
    # wirklich gesetzt (Nachtrag 16). Ohne ihn waere die Buchung eine Zusage,
    # die niemand einhaelt -- genau der Fehler, den --context-window bei mtplx
    # behoben hat.
    local cache_bytes
    cache_bytes="$(LC_ALL=C awk -v g="$PROMPT_CACHE_GIB" 'BEGIN { printf "%d", g * 1024 * 1024 * 1024 }')"
    set -- --model "$MODEL_PATH" --port "$PORT" \
      --decode-concurrency "$decode_conc" \
      --prompt-concurrency "$prompt_conc" \
      --prompt-cache-size "$PROMPT_CACHE_PLAETZE" \
      --prompt-cache-bytes "$cache_bytes"
    if [ -n "${WB_MLX_SERVER_LOG_LEVEL:-}" ]; then
      set -- "$@" --log-level "$WB_MLX_SERVER_LOG_LEVEL"
    fi
    # chatTemplateArgs aus der Registry (siehe resolve_modell) -- SERVERSEITIGE
    # Vorgabe fuer apply_chat_template. Noetig, weil pi sie NICHT im
    # Anfragekoerper mitschickt (gemessen 2026-08-19, DEBUG-Log ohne
    # chat_template_kwargs) und mlx_lm.server ohne --chat-template-args mit
    # {} startet -- dann entscheidet allein die Chat-Vorlage des Modells, und
    # bei Qwen3.8 ist das xhigh (28 Minuten statt rund einer Minute je
    # Anfrage, siehe Kopfkommentar "DENKSTUFEN-FALLE").
    if [ -n "$RES_CHAT_TEMPLATE_ARGS" ] && [ "$RES_CHAT_TEMPLATE_ARGS" != "null" ]; then
      set -- "$@" --chat-template-args "$RES_CHAT_TEMPLATE_ARGS"
    fi
    # KEIN --draft-model mehr hier (Nachtrag 7): mlx_lm.servers eigener
    # Entwerfer-Weg ist fuer diese Architektur nachweislich unmoeglich (siehe
    # Kopfkommentar) -- ein Entwerfer laeuft ausschliesslich ueber den
    # motor=mlx-dspark-Zweig oben.
    newpid="$(HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_CACHE="$HF_HUB_CACHE_LEER" \
      "$HOME/.local/bin/wb-nohup" "$NAME" -- mlx_lm.server "$@")" || {
      err "wb-nohup konnte den Server nicht starten — siehe $LOG"
      belegung_abbrechen; return 1
    }
  fi
  echo "wb-mlx-server: gestartet (PID $newpid, Modell ${RES_ID:-$MODEL_PATH}), warte auf Antwortbereitschaft..." >&2

  # SOFORT auf Prozess-Halter umhaengen (Nachtrag 2026-09-08, ZWEITE RUNDE,
  # Auftrag "buchung", Risiko 11): NICHT erst nach Health/Probeanfrage. Das
  # Laden eines grossen Modells dauert Minuten (siehe health_frist weiter
  # unten, bis zu 300s) -- solange die Buchung bis dahin noch am aufrufenden
  # Pane haengt, verfaellt sie, wenn GENAU DIESER (oft kurzlebige) Pane
  # waehrend des Ladens stirbt, obwohl der Serverprozess selbst voellig
  # gesund weiterlaedt (genau das Fenster, das Befund 1 fuer den ABGESCHLOSSENEN
  # Zustand schon behoben hat -- hier bleibt es fuer den LADENDEN Zustand offen,
  # solange der Umhaenge-Aufruf erst nach 'wait_health' faellt).
  #
  # 'wb-belegung uebernehmen --pid' statt 'geladen --pid --prozess-haelt': Der
  # Unterschied ist entscheidend. 'geladen' markiert 'realisiert=True' -- das
  # Modell steht DANN im Speicher, Grenze A hoert auf, die Buchung als "laedt
  # noch" abzuziehen. Waere DAS schon hier, vor jedem echten Fortschritt,
  # gesetzt, verloere Grenze A genau den Schutz gegen eine zweite, gleichzeitig
  # ladende Buchung, den der Kopfkommentar von wb-belegung ausdruecklich
  # beschreibt ("EINE BELEGUNG LAEDT ERST UND IST DANN REALISIERT"). 'uebernehmen
  # --pid' aendert NUR den Halter (Pane -> Prozess), ruehrt 'realisiert' nicht
  # an -- die spaetere 'geladen --pid --prozess-haelt' nach Health/Probeanfrage
  # bleibt UNVERAENDERT bestehen und markiert weiterhin exakt den Moment, in dem
  # das Modell wirklich antwortet (dort jetzt ein wirkungsloses, aber
  # unschaedliches zweites Umhaengen auf denselben Halter).
  if [ -n "$BELEGUNG_KENNUNG" ]; then
    local wbb_frueh; wbb_frueh="$(belegung_bin)"
    [ -n "$wbb_frueh" ] && "$wbb_frueh" uebernehmen "$BELEGUNG_KENNUNG" --pid "$newpid" 2>&1
  fi

  # DIE NOTBREMSE, ab jetzt bei jedem Modellstart (NACHTRAG 13, Auftrag des Nutzers
  # vom 21.08.2026). Sie ist die letzte Sicherung UNTERHALB der Buchung: faellt der
  # freie Speicher trotz allem unter die Schwelle (WAR 1 GiB; seit 2026-08-27
  # 512 MiB, siehe wb-notbremse SCHWELLE_MIB), beendet sie das Modell, bevor
  # die Maschine steht. Sie wird HIER gestartet und nicht dauerhaft gehalten
  # (stehende Regel vom 20.08.: kein Prozess laeuft auf Vorrat) und endet von
  # selbst, sobald der Modellprozess weg ist. Sie darf einen Serverstart NIE
  # verhindern -- deshalb `|| true` samt eigener, sichtbarer Zeile statt eines
  # Abbruchs: eine fehlende Bremse ist schlechter als keine, aber ein
  # verhinderter Start ist es auch.
  # Auch hier die installierte Fassung zuerst, aus demselben Grund wie bei
  # belegung_bin() -- ein Test mit eigenem HOME muss eine Attrappe unterschieben
  # koennen, sonst startet er im Testbett eine echte Wache.
  #
  # --pid "$newpid" (Nachtrag 27.08.2026): die PID kommt direkt von `wb-nohup`
  # weiter oben -- keine Musterjagd durch die Prozesstabelle noetig, wenn der
  # Aufrufer seine eigene PID schon kennt (Hausregel: `pgrep -f` trifft auch
  # den Agenten-Prompt, in dem der Suchbegriff vorkommt). Ein zweiter Aufruf
  # mit DERSELBEN PID bleibt wirkungslos wie bisher; ein Modellwechsel (neue
  # PID) startet jetzt korrekt eine EIGENE Wache fuer den neuen Prozess, statt
  # sich auf eine alte zu verlassen, die noch in ihrer Anlauffrist auf das
  # Verschwinden des vorigen Modells wartet (siehe piddatei_fuer() dort).
  local notbremse="$HOME/.local/bin/wb-notbremse"
  [ -x "$notbremse" ] || notbremse="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/wb-notbremse"
  if [ -x "$notbremse" ]; then
    "$notbremse" start --pid "$newpid" >&2 \
      || err "WARNUNG: wb-notbremse liess sich nicht starten — dieser Server laeuft OHNE die Notabschaltung."
  else
    err "WARNUNG: wb-notbremse fehlt ($notbremse) — dieser Server laeuft OHNE die Notabschaltung."
  fi

  # Wartefrist je Motor. Die 90 s reichen fuer die drei MLX-Motoren, die die
  # Gewichte direkt laden; vllm-metal baut zusaetzlich seinen Motorkern und
  # den Speicherplan auf und brauchte in der Messung vom 20.08. 77 Sekunden
  # bis zur ersten beantworteten Anfrage (m15-A16-async.log: 15:52:24 Start,
  # 15:53:41 "Available routes are"). 90 waeren damit knapp am gemessenen
  # Wert; 300 laesst Luft fuer einen kalten Ladevorgang, ohne die Frist
  # unbegrenzt zu machen.
  local health_frist=90
  if [ "$motor" = "vllm-metal" ]; then health_frist=300; fi
  if ! wait_health "$health_frist"; then
    err "Server antwortet nach ${health_frist}s nicht auf /health — siehe $LOG"
    # --pid (Nachtrag 2026-09-08, Auftrag "buchung", Befund 3): der Prozess IST
    # exec't, wurde aber nie gesund -- ohne ihn zu beenden bliebe er als
    # unbeaufsichtigte, unbebuchte Karteileiche stehen (belegung_abbrechen gibt
    # nur die Buchung frei, nicht den Prozess selbst).
    belegung_abbrechen --pid "$newpid"; return 1
  fi

  echo "wb-mlx-server: /health antwortet, sende Probeanfrage..." >&2
  local resp
  if ! resp="$(probe_request "$MODEL_PATH")"; then
    err "Probeanfrage fehlgeschlagen — Server ist erreichbar, liefert aber keine gueltige Antwort. Siehe $LOG"
    belegung_abbrechen --pid "$newpid"; return 1
  fi
  if ! printf '%s' "$resp" | python3 -c 'import json,sys
d=json.load(sys.stdin)
sys.exit(0 if d.get("choices") else 1)' 2>/dev/null; then
    err "Probeanfrage lieferte kein gueltiges Ergebnis: $resp"
    belegung_abbrechen --pid "$newpid"; return 1
  fi

  if [ -n "$BELEGUNG_KENNUNG" ]; then
    local wbb; wbb="$(belegung_bin)"
    # --pid (Nachtrag 21.08.2026, Worker "schluesselbund"): wb-belegung fuehrt
    # jetzt einen vierten Zustand "tot" -- eine als geladen gemeldete Buchung,
    # deren Prozess nachweislich nicht mehr derselbe ist, zaehlt nicht mehr in
    # die Vergabe. Ohne die PID hier bleibt dieser Mechanismus fuer JEDEN
    # ueber diese Datei gestarteten Server untaetig, qwen38-27b/MTPLX
    # eingeschlossen -- $newpid ist die PID, die gerade wirklich antwortet
    # (health/Probeanfrage sind bereits durch), also dieselbe, die spaeter
    # gegen 'tot' geprueft werden soll.
    # --prozess-haelt (Nachtrag 2026-09-08, Auftrag "buchung", Befund 1): ab
    # jetzt haelt der PROZESS diese Buchung, nicht mehr der (moeglicherweise
    # laengst wieder geschlossene) Pane, der 'ensure' aufgerufen hat -- siehe
    # wb-belegungs Kopfkommentar "EIN PROZESS KANN AUCH DER HALTER SEIN".
    [ -n "$wbb" ] && "$wbb" geladen "$BELEGUNG_KENNUNG" --pid "$newpid" --prozess-haelt 2>&1
  fi

  aktuell_schreiben "$RES_ID" "$RES_ALIAS" "$MODEL_PATH" "$kontext" "$BELEGUNG_KENNUNG"

  echo "wb-mlx-server: bereit (PID $newpid, Port $PORT, Modell ${RES_ID:-$MODEL_PATH}, Kontext $kontext), Probeanfrage erfolgreich." >&2
  # Der Name, unter dem dieser Server wirklich antwortet -- siehe
  # bedienter_modellname(). Auf stdout, weil es eine Auskunft an den Aufrufer
  # ist und keine Meldung an den Menschen.
  printf 'modell=%s\n' "$(bedienter_modellname "$motor" "$MODEL_PATH")"
  printf 'pid=%s\n' "$newpid"
  # gestartet=frisch (Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag (A);
  # BEDEUTUNG GEAENDERT 2026-09-08, Auftrag "buchung", Befund 1/5): dieser
  # Rueckgabepunkt ist der EINZIGE Erfolgspfad in cmd_ensure, der einen echten
  # (Neu-)Start durchlaeuft -- der "kein Start noetig"-Kurzschluss kehrt weiter
  # oben, vor diesem Punkt, mit einem eigenen return 0 zurueck (siehe dort) und
  # druckt diese Zeile nie. FRUEHER bedeutete das: der Serverstart bucht schon
  # EINE Sequenz mit, pi-worker liest diese Zeile und laesst seine eigene
  # "Eigene Sequenz"-Buchung deshalb aus. Das galt nur, solange der Serverstart
  # ueberhaupt Stroeme buchte (KAPAZITAETS_NEUSTART-Ratchet) -- seit
  # --nur-gewichte (siehe belegung_nehmen()) bucht der Serverstart NIE mehr
  # einen Strom fuer den Aufrufer, jeder Worker bucht IMMER seine eigene
  # Sequenz, auch beim allerersten Kaltstart (siehe shell/pi-worker, "Eigene
  # Sequenz buchen" -- der dortige Sonderfall fuer diese Zeile ist entfallen).
  # Diese Zeile bleibt als reine Information stehen ("es war wirklich ein
  # (Neu-)Start, kein Wiederverwenden"), steuert aber keine Buchungsentscheidung
  # mehr.
  printf 'gestartet=frisch\n'
  # Nachtrag 2026-09-08: Marker fuer den Aufrufer (siehe KAPAZITAETS_NEUSTART
  # oben) -- ohne ihn liest sich dieser Start wie ein ganz gewoehnlicher
  # Kaltstart, obwohl er in Wahrheit einen zu klein gewordenen Server abgeloest
  # hat. pi-worker liest diese Zeile und meldet den Neustart weiter.
  [ "$KAPAZITAETS_NEUSTART" -eq 1 ] && printf 'neustart=kapazitaet\n'
  return 0
}

cmd_stop() {
  local wunschmodell="${1:-}"
  local pid; pid="$(find_pid)"
  if [ -z "$pid" ]; then
    # Kein Prozess heisst NICHT "nichts zu tun" -- eine offene Belegung ohne
    # laufenden Server ist genau der Zustand, aus dem die Kernel-Panik-Nacht
    # entstand (siehe grug-servers Kopfkommentar, uebernommen).
    if [ -f "$KENNUNG_DATEI" ]; then
      echo "wb-mlx-server: kein Prozess, aber eine offene Belegung — gebe sie frei." >&2
      belegung_freigeben
    else
      echo "wb-mlx-server: nicht aktiv — nichts zu beenden." >&2
    fi
    return 0
  fi
  if ! is_ours "$pid"; then
    err "Port $PORT ist belegt von PID $pid, aber von keinem der fuenf bekannten Motoren (mlx_lm.server, mlx-dspark, mtplx, vllm, mlx_vlm.server) — nichts beendet."
    return 1
  fi

  if [ -n "$wunschmodell" ]; then
    resolve_modell "$wunschmodell" || return 1
    local laufend; laufend="$(laufendes_modell "$pid")"
    if [ "$laufend" != "$RES_PATH" ]; then
      err "angefordert wurde '$wunschmodell' ($RES_PATH), aber es laeuft '$laufend' — nichts beendet."
      err "Ohne Modellangabe beendet 'wb-mlx-server stop', was tatsaechlich laeuft."
      return 1
    fi
  fi

  _stop_pruefen_und_beenden "$pid"
}

unterbefehl="${1:-}"
shift 2>/dev/null || true

case "$unterbefehl" in
  ensure)   cmd_ensure "$@" ;;
  stop)     cmd_stop "$@" ;;
  status)   cmd_status ;;
  liste)    cmd_liste ;;
  # Abstimmung mit pi-worker (andere Spur, 19.08.2026, seit Nachtrag 6 LIVE
  # statt aus einer festen Konstante): Nebenlaeufigkeit ist seither je
  # Aufruf verschieden (--parallel), es gibt also keine EINE globale Zahl
  # mehr, nur noch die, mit der der LAUFENDE Server tatsaechlich gestartet
  # wurde. Gelesen aus der lebenden Kommandozeile (--decode-concurrency),
  # nicht aus einem separat gefuehrten Zustand -- dieselbe Lehre wie bei
  # "Kontext gebucht" (der Nutzer, Fehler 2, 2026-08-19): zwei Zahlen fuer
  # dieselbe Sache veralten, eine live gelesene nicht. Laeuft nichts, gibt
  # es keine "aktuelle" Kapazitaet zu berichten -- dann die Vorgabe, die ein
  # naechster Start ohne --parallel bekaeme, mit einem Hinweis, dass das nur
  # eine Vorgabe ist. Gibt NUR die Zahl aus, sonst nichts -- fuer's Einlesen
  # per $(wb-mlx-server parallel), Exit 0 immer (reiner Lesezugriff).
  parallel)
    _pid="$(find_pid)"
    if [ -n "$_pid" ] && is_ours "$_pid"; then
      _wert="$(laufende_decode_concurrency "$_pid")"
      echo "${_wert:-?}"
    else
      echo "$DECODE_PARALLEL_VORGABE"
    fi
    ;;
  *) echo "Usage: wb-mlx-server ensure [<modell>] [--kontext <token>] [--frist <minuten>] [--parallel <n>] [--vorhersage-weg <id>] [--auf-eigene-gefahr] | stop [<modell>] | status | liste | parallel" >&2; exit 2 ;;
esac
