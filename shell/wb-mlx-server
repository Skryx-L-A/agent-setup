# ein Test ueber ein eigenes HOME und legt seine Stellvertreter nach
# $HOME/.local/bin. Eine Suche, die den Nachbarn DAVOR stellt, hebelt jeden
# dieser Stellvertreter aus, ohne dass es jemand sieht -- die Tests riefen
# daraufhin das echte Werkzeug, massen den echten Speicher der Maschine, bekamen
# eine Absage und fingen eine leere Startzeile ab.
#
# Der Nachbar bleibt als RUECKFALL, fuer den Fall, dass gar nichts installiert
# ist. Wer aus einem Arbeitsbaum ausdruecklich gegen dessen eigenen Stand messen
# will, setzt die dafuer vorgesehene Variable -- eine Behauptung im Aufruf, nicht
# eine stille Vorfahrt im Pfad.
# Nachtrag 2026-09-08, VIERTE RUNDE, Auftrag (C) Punkt 2: der APC-Blockpool
# (mlx-vlm 0.7.0) muss wie der Prompt-Cache von mlx_lm.server als Speicher
# gebucht werden -- "Block-Pool = Kontext x KV je Token, konservativ". Die
# KV-Zahl je Token lebt einzig in wb-belegungs eigenem Register
# (`wb-belegung kv liste`) -- keine zweite, eigene Herleitung hier ("eine
# Quelle, nicht zwei", derselbe Grundsatz wie bei kv_quant_buchung oben).
# Liefert den UNQUANTISIERTEN Wert fuer $basisname zurueck (die konservative,
# groessere Zahl -- APC hat kein eigenes, gemessenes Quantisierungsschema),
# leer wenn nichts eingetragen ist.
kv_mib_je_token_fuer() {   # <basisname> -> MiB/Token oder leer
  local basisname="$1" wbb
  wbb="$(belegung_bin)"
  [ -n "$wbb" ] || return 0
  # NACHTRAG 2026-09-08, Auftrag "buchung", Kleinkram-Befund "grep -F": der
  # bisherige Weg (grep -i "^  *${basisname} ") liest $basisname als REGEX, nicht
  # als literale Zeichenkette -- ein Modellname mit einem Punkt (ueblich, z.B.
  # "Qwen3.8-27B-...") matcht damit JEDES Zeichen an dieser Stelle. awk mit
  # exaktem Feldvergleich ($1==m) ist unabhaengig vom Inhalt der Zeichenkette
  # immer ein exakter Treffer -- das Register hat keine Leerzeichen in Namen.
  "$wbb" kv liste 2>/dev/null | awk -v m="$basisname" '$1==m{print $2; exit}'
}

belegung_bin() {
  local p="$HOME/.local/bin/wb-belegung"
  if [ -x "$p" ]; then printf '%s' "$p"; return 0; fi
  local nebenan; nebenan="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/wb-belegung"
  if [ -x "$nebenan" ]; then printf '%s' "$nebenan"; return 0; fi
  command -v wb-belegung 2>/dev/null
}

