# DFlash2-config.json als DSpark-Format zu lesen versucht (DSpark traegt
# diese Felder TOP-LEVEL, z.B. Qwen3.8-27B-DSpark-DimInfer/config.json;
# DFlash2 traegt sie VERSCHACHTELT unter dflash_config). Die Unterscheidung
# ist deshalb eine ECHTE Datei-Beobachtung, keine geratene Konstante: steht
# im Entwerfer-config.json der Schluessel `dflash_config`, ist es ein
# DFlash-Checkpoint und braucht `--mode dflash` explizit; sonst bleibt
# --mode unangetastet (mlx-dsparks eigene Auto-Erkennung, die fuer das
# DSpark-Format nachweislich funktioniert -- dafuer existiert sie).
dspark_ist_dflash_entwerfer() {
  local konfig="$1/config.json"
  [ -f "$konfig" ] || return 1
  python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    sys.exit(0 if "dflash_config" in d else 1)
except Exception:
    sys.exit(1)
' "$konfig"
