  [ -n "$pid" ] && ps -o command= -p "$pid" 2>/dev/null | grep -qE "mlx_lm|mlx_vlm|mlx-dspark|mtplx|vllm"
}

# Das Modell, das GERADE unter dieser PID laeuft — aus dem lebenden
# --model-Argument gelesen, nicht aus einer Merkdatei. Das ist die Wahrheit
# fuer die Frage "ist das dasselbe Modell" (Modellwechsel-Logik oben);
# aktuell.json kann veraltet sein (siehe dort).
# WELCHEN NAMEN DER LAUFENDE SERVER WIRKLICH BEDIENT (Nachtrag 19, 2026-08-21).
#
# Der Anlass ist gemessen: der mtplx-Server fuer qwen38-27b meldet unter
# /v1/models AUSSCHLIESSLICH "mtplx-qwen38-27b-optimized-speed", waehrend
# wb-code pi mit dem Registry-Pfad "$HOME/AI/mlx-models/qwen38-27b-mlx-4bit"
# losschickte. mlx_lm.server ist gleichgueltig gegen den Namen und bedient jede
# Anfrage mit dem Modell, das es geladen hat -- mtplx PRUEFT ihn. Also lief ein
# fehlerfrei gestarteter Server, den sein einziger Aufrufer nicht ansprechen
# konnte.
#
# GEFRAGT WIRD DER SERVER, nicht das --model-Flag und nicht die Registry: nur er
# weiss, unter welchem Namen er antwortet. Genau diese Umkehr hat heute Abend
# schon einmal eine Messung gerettet.
#
# NUR fuer mtplx. Bei mlx_lm.server hat /v1/models am 21.08. den Namen eines
# voellig anderen Modells geliefert (lmstudio-community/Qwen3.6-35B-A3B-MLX-6bit,
# ein Rest aus einem fremden Lauf); wer den uebernimmt, bringt den Server dazu,
# ein zweites Modell nachzuladen. Dort bleibt es deshalb beim Pfad, den dieser
# Motor ohnehin akzeptiert.
bedienter_modellname() {
  local motor="$1" fallback="$2"
  if [ "$motor" != "mtplx" ]; then
    printf '%s' "$fallback"
    return 0
  fi
  local id
  id="$(curl -s --max-time 5 "http://127.0.0.1:$PORT/v1/models" 2>/dev/null \
        | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
namen = [m.get("id") for m in (d.get("data") or []) if m.get("id")]
# Genau EINER: bedient der Server mehrere Namen, ist keiner davon "der" Name,
# und eine Wahl waere geraten.
if len(namen) == 1:
    print(namen[0])
' 2>/dev/null)"
  if [ -n "$id" ]; then
    printf '%s' "$id"
  else
    err "WARNUNG: /v1/models auf Port $PORT nennt keinen eindeutigen Modellnamen — es bleibt beim Pfad '$fallback'. Ein Aufrufer, den dieser Motor abweist, findet hier den Grund."
    printf '%s' "$fallback"
  fi
}

laufendes_modell() {
  local pid="$1" cmd wert
  cmd="$(ps -o command= -p "$pid" 2>/dev/null)"
  wert="$(printf '%s' "$cmd" | sed -n 's/.*--model \([^ ]*\).*/\1/p')"
  if [ -z "$wert" ]; then
    # `vllm serve` (Nachtrag 10) nimmt das Modell POSITIONELL, nicht als
    # --model. Der Start unten reicht denselben Pfad zusaetzlich als
    # --served-model-name mit -- nicht als Zierde, sondern weil vLLM den
    # Modellnamen einer Anfrage im Gegensatz zu mlx_lm.server tatsaechlich
    # prueft und jeder bestehende Aufrufer (pi ueber ~/.pi/agent/models.json,
    # wb-modell-proxy) den PFAD als Namen schickt. Damit steht der Pfad auch
    # bei diesem Motor in der lebenden Kommandozeile, und die Gleichheits-
    # pruefung in cmd_ensure liest ihn dort statt aus einer Merkdatei.
    wert="$(printf '%s' "$cmd" | sed -n 's/.*--served-model-name \([^ ]*\).*/\1/p')"
  fi
  printf '%s' "$wert"
}

laufende_decode_concurrency() {
  local pid="$1" cmd wert
  cmd="$(ps -o command= -p "$pid" 2>/dev/null)"
  wert="$(printf '%s' "$cmd" | sed -n 's/.*--decode-concurrency \([0-9]*\).*/\1/p')"
  if [ -z "$wert" ]; then
    # mlx-dspark serve kennt --decode-concurrency nicht (Nachtrag 7) -- fuer
    # diesen Motor ist --prefix-cache-slots die vergleichbare Zahl: keine
    # gleichzeitige Dekodierung, aber so viele gleichzeitig vorgehaltene
    # Worker-Praefixe. Leer bleibt es nur, wenn WEDER der eine NOCH der
    # andere Schalter in der lebenden Kommandozeile steht.
    wert="$(printf '%s' "$cmd" | sed -n 's/.*--prefix-cache-slots \([0-9]*\).*/\1/p')"
  fi
  if [ -z "$wert" ]; then
    # vllm serve (Nachtrag 10) heisst der Schalter --max-num-seqs. ACHTUNG bei
    # der Deutung: das ist der DECKEL, den deckel_waehlen() auf acht bzw.
    # sechzehn einrastet, nicht zwingend die Stromzahl, die der Aufrufer
    # verlangt hat (siehe VLLM_DECKEL_UNTEN dort). Bis acht Stroeme sind beide
    # Zahlen gleich; darueber ist dies die groessere von beiden.
    wert="$(printf '%s' "$cmd" | sed -n 's/.*--max-num-seqs \([0-9]*\).*/\1/p')"
  fi
  printf '%s' "$wert"
}

# Nachtrag 2026-09-08 (Auftrag "kontextgewichte", ZWEITER TEIL, gemessen 19:20):
# `ensure` meldete "laeuft bereits (PID 98588) -- kein Start noetig", obwohl der
# laufende Server mit --parallel 1 (siehe laufende_decode_concurrency oben)
# gestartet war. Der zweite gleichzeitige Strom (ein pi-Worker neben einem
# laufenden brain-contradict-Richter) bekam danach HTTP 500 "'tuple' object has
# no attribute 'shape'" -- genau der Fall aus NACHTRAG 24 oben (Quantisierung bei
# einem Strom an, ab zwei aus). Die vorhandene "laeuft schon dasselbe"-Pruefung
# (Pfad, Entwerfer, Motor, Kontext) fragte nie, ob der laufende Server ueberhaupt
# noch einen WEITEREN Strom traegt.
#
# Wieviele Stroeme sind FUER DIESES MODELL schon zugesagt? Die einzige Quelle
# dafuer ist wb-belegung: der Serverstart bucht seine EIGENE Zahl (--parallel,
# dieselbe wie die Server-Kapazitaet, siehe NACHTRAG 6 im Kopfkommentar), jeder
# zusaetzliche lokale Worker bucht seine eigene Sequenz obendrauf (pi-worker,
# "Eigene Sequenz buchen", --parallel 1 je Buchung) -- die SUMME aller
# rechnung.parallel-Werte fuer denselben Modellnamen ist die Zahl gleichzeitiger
# Stroeme, die der laufende Server gerade tragen soll. "eine Quelle, nicht
# zwei": wb-belegung entscheidet, dieselbe Buchfuehrung, die auch den Speicher
# entscheidet (siehe Kopfkommentar von shell/wb-belegung).
#
# UEBERHOLT (Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag "buchung", Befund 8):
# der ERSTE Satz oben stimmt nicht mehr -- der Serverstart bucht seit der
# ersten Runde dieses Auftrags NICHT MEHR "seine EIGENE Zahl, dieselbe wie die
# Server-Kapazitaet", sondern einen FESTEN Basisstrom (--parallel 1, siehe
# belegung_nehmen() weiter unten, "BASISSTROM STATT --nur-gewichte"). Diese
# Server-eigene Buchung wird deshalb jetzt AUSDRUECKLICH aus der Summe
# ausgeschlossen (ueber ihren zweck, siehe die Python-Abfrage unten) -- die
# Summe zaehlt seither NUR NOCH Worker-Stroeme, nicht mehr Server + Worker
# gemischt. Der Rest des Absatzes (jeder Worker bucht seine eigene Sequenz,
# die Summe entscheidet ueber die noetige Kapazitaet) gilt unveraendert.
# NAMENSABGLEICH (Nachtrag 2026-09-08, DRITTE RUNDE, Gegenleser-Befund Punkt
# 6): der reine Vergleich gegen $basisname verfehlt die eigene Serverbuchung
# GENAU im Anlassfall -- ein mlx-vlm-Server mit EINEM Strom bucht unter
# "<basisname>-kv8" (siehe cmd_ensure weiter unten, kv_modellname_buchung),
# nicht unter dem blanken Basisnamen. Ohne diesen zweiten Namen zaehlte die
# Summe den Server selbst mit 0 -- die Kapazitaetspruefung haette den
# gemessenen Fehler (Server bei --parallel 1, zweiter Strom scheitert) NICHT
# erkannt. Beide Namen werden deshalb IMMER gegengeprueft, unabhaengig davon,
# welchen Namen DIESER Aufruf gerade selbst waehlen wuerde -- eine fremde,
# schon bestehende Buchung darf nicht von der Namenswahl des NEUEN Versuchs
# abhaengen.
#
# UEBERFAELLIG ZAEHLT WEITER MIT, ABSICHTLICH (Gegenleser-Befund Punkt 8): der
# Zustand "ueberfaellig" (siehe zustand_bestimmen() in shell/wb-belegung)
# bedeutet PER DEFINITION "die Frist ist um, ABER der Pane ist gerade
# nachweislich noch lebendig" -- genau das Gegenteil von "verfallen" (Pane
# tot). Eine Buchung mit lebendigem Pane hier NICHT mitzuzaehlen waere die
# gefaehrliche Richtung (Sicherheitsregel dieses Auftrags: im Zweifel zu viel
# buchen, nie zu wenig) -- ein wiederverwendeter Pane, der laengst etwas
# anderes tut, waere die einzige Faehrte, die eine "ueberfaellig"-Buchung
# unbegrenzt am Leben hielte, und das ist ein SELTENER Rand, kein Regelfall.
# "wb-belegung aufraeumen" laeuft trotzdem VORHER (billig, gleiche Sperre wie
# jede andere Operation) -- es entfernt "tot" und laengst "verfallene"
# Karteileichen aus dem Buch, bevor gezaehlt wird; es aendert nichts an
# "ueberfaellig" (das bleibt bewusst gezaehlt) und nichts an "offen".
gebuchte_sequenzen_summe() {   # <basisname> -> Summe rechnung.parallel der WORKER-Buchungen
  # (Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag "buchung", Risiko 10): schliesst
  # die Server-eigene Buchung (Gewichte + Basisstrom, zweck beginnt mit
  # "wb-mlx-server:") ausdruecklich aus -- ihr Basisstrom deckt Nicht-Worker-
  # Verbraucher (grug-server, wb-modell-proxy, brain-contradict-Richter, curl),
  # ist aber KEIN Slot, der einem Worker weggenommen wird (siehe die
  # Kapazitaetsrechnung bei belegung_nehmen()). Ohne diesen Ausschluss zaehlte
  # der Basisstrom hier doppelt mit -- einmal als Teil von "wieviel ist gebucht"
  # UND ein zweites Mal implizit ueber die reale --decode-concurrency, die schon
  # auf ihn ausgelegt war -- und haette jede Kapazitaetsrechnung um eins nach
  # oben verschoben, ohne dass je ein zusaetzlicher WORKER dazukam.
  local basisname="$1" wbb
  wbb="$(belegung_bin)"
  [ -n "$wbb" ] || { printf '0'; return 0; }
  "$wbb" aufraeumen --json >/dev/null 2>&1
  "$wbb" wer --json 2>/dev/null | python3 -c '
import json, sys
basisname = sys.argv[1]
namen = {basisname, basisname + "-kv8"}
try:
    d = json.load(sys.stdin)
except Exception:
    print(0)
    sys.exit(0)
summe = 0
for b in (d.get("belegungen") or []):
    if b.get("_zustand") == "tot":
        continue
    if (b.get("modell") or "") not in namen:
        continue
    if (b.get("zweck") or "").startswith("wb-mlx-server:"):
        continue
    try:
        summe += int((b.get("rechnung") or {}).get("parallel") or 0)
    except (TypeError, ValueError):
        pass
print(summe)
' "$basisname" 2>/dev/null || printf '0'
}

# UEBERHOLT (Nachtrag 2026-09-08, Auftrag "buchung", Befunde 1/2/3/4/5): die
# ganze ENTSCHEIDUNG unten -- "der Serverstart bucht Gewichte + ALLE Stroeme,
# Geschwister werden danach freigegeben" -- ist NICHT MEHR IN KRAFT. Ein
# Gegenleser fand darin den eigentlichen Entwurfsfehler: die Buchung des
# Serverstarts hing an dessen aufrufendem PANE, nicht am Serverprozess selbst,
# und starb deshalb regelmaessig VOR ihm (Befund 1, "Summe 0 bei N laufenden
# Stroemen"); die Geschwister-Freigabe unten lief zudem VOR der Bestaetigung des
# neuen Starts (Befund 3) und konnte in einer Sonderlage sogar die brandneue
# Buchung mit sich reissen (Befund 2). Die neue Loesung (siehe wb-belegungs
# eigener Kopfkommentar "JEDER STROM WIRD VOM WORKER GEBUCHT" und "EIN PROZESS
# KANN AUCH DER HALTER SEIN"): der Serverstart bucht NUR NOCH seine Gewichte,
# gehalten vom PROZESS selbst (`wb-belegung geladen ... --prozess-haelt`), NIE
# eine Strom-Zahl fuer einen Aufrufer stellvertretend; JEDER Strom wird vom
# Worker gebucht, der ihn faehrt, auch der erste. Damit gibt es keine
# Geschwister-Buchungen mehr, die einem Serverstart je "gehoert" haetten, und
# `gebuchte_kennungen()` unten wird nicht mehr aufgerufen (siehe cmd_ensure).
# Der Text bleibt stehen, weil er die damalige Entscheidung und ihre Abwaegung
# ehrlich dokumentiert -- nicht, weil er noch beschreibt, was das Skript tut.
#
# Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag (A) -- Doppelbuchung beim ersten
# Strom, siehe OPEN Punkt 2 der ersten Runde und kapazitaet_pruefen() darunter.
#
# ENTSCHEIDUNG (im Kopf dokumentiert, wie verlangt -- EINE Quelle, nicht zwei
# Politiken nebeneinander): bei einem kapazitaetsbedingten Neustart bucht der
# NEUE Serverstart Gewichte + ALLE Stroeme (die schon gebuchten Geschwister
# PLUS diesen neuen), nicht nur seine eigene EINE Sequenz. Die ALTEN
# Einzelbuchungen der Geschwister werden danach freigegeben. NICHT gewaehlt:
# "Server bucht nur Gewichte + eigene, Geschwister behalten ihre" -- das wuerde
# die wb-belegung-Buchung von der REALEN --decode-concurrency des Prozesses
# entkoppeln (Nachtrag 6, Kopfkommentar: "DIESELBE Zahl geht ... an mlx_lm.server
# als Server-Kapazitaet, ... UND an `wb-belegung nimm --parallel`" -- eine
# bewusste Kopplung, kein Zufall). Bleibt die Buchung bei parallel=1 stehen,
# waehrend der echte Prozess mit --decode-concurrency N+1 laeuft, ist die
# wb-belegung-Zahl kleiner als der wirkliche Speicherbedarf -- genau die
# gefaehrliche Richtung (Sicherheitsregel dieses Auftrags: im Zweifel zu viel
# buchen, nie zu wenig).
#
# REIHENFOLGE, NICHT VERHANDELBAR: die alten Geschwister-Buchungen werden ERST
# NACH einer ERFOLGREICHEN neuen Buchung freigegeben (siehe cmd_ensure, direkt
# nach belegung_nehmen()), nie vorher und nie ungeprueft. Zwischen "alter
# Server beendet" und "neue Buchung steht" zaehlen die alten Geschwister-
# Buchungen also WEITER mit -- eine ueberschaetzte, nie eine unterschaetzte
# Zwischenlage.
#
# BEKANNTE, OFFEN BENANNTE RESTLUECKE: die Liste der zu loeschenden Kennungen
# wird HIER, kurz vor dem Freigeben, neu erhoben (kleinstmoegliches Fenster,
# nicht Null) -- eine Buchung, die GENAU in diesem kurzen Fenster neu entsteht
# (ein weiterer Geschwister-Spawn waehrend dieses Neustarts), wuerde faelschlich
# mitgeloescht, obwohl sie zur neuen Gesamtzahl nicht mehr passt. Das ist ein
# echtes, seltenes Zeitfenster, keine False-Positive-Uebervorsicht -- siehe
# Ergebnisdatei dieses Auftrags fuer die Abwaegung, warum es hier offen bleibt
# (ein voller Lock ueber den ganzen Neustart, der auch pi-workers eigene
# Buchungsversuche blockiert, waere ein deutlich groesserer Eingriff).
# NICHT MEHR AUFGERUFEN (Nachtrag 2026-09-08, Auftrag "buchung") -- siehe die
# UEBERHOLT-Notiz oben. Stehen gelassen als Beleg der frueheren Entscheidung.
gebuchte_kennungen() {   # <basisname> <ausgenommene-kennung> -> eine Kennung je Zeile
  # Derselbe Namensabgleich wie gebuchte_sequenzen_summe() (siehe dort,
  # Gegenleser-Befund Punkt 6) -- sonst wuerde eine Buchung unter
  # "<basisname>-kv8" hier nie gefunden und nie freigegeben.
  local basisname="$1" ausgenommen="${2:-}" wbb
  wbb="$(belegung_bin)"
  [ -n "$wbb" ] || return 0
  "$wbb" wer --json 2>/dev/null | python3 -c '
import json, sys
basisname, ausgenommen = sys.argv[1], sys.argv[2]
namen = {basisname, basisname + "-kv8"}
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for b in (d.get("belegungen") or []):
    if b.get("_zustand") == "tot":
        continue
    if (b.get("modell") or "") not in namen:
        continue
    kennung = b.get("id") or ""
    if kennung and kennung != ausgenommen:
        print(kennung)
' "$basisname" "$ausgenommen" 2>/dev/null
}

# Traegt der laufende Server (PID $1) noch EINEN weiteren Strom fuer $2
# (Basisname, wie gebuchte_sequenzen_summe() ihn braucht)? $3 ist ein
# ausdruecklich vom Aufrufer verlangtes --parallel (leer, wenn keins gegeben) --
# eine ausdrueckliche Zahl gewinnt, wenn sie groesser ist als die errechnete
# Mindestzahl. Ausgabe (durch Leerzeichen getrennt, EIN Aufruf statt drei, damit
# `wer --json` nur einmal laeuft): "ja|nein <benoetigt> <laufende-kapazitaet-oder-?>".
#
# BEKANNTE GRENZE (ausdruecklich offen gelassen, siehe Ergebnisdatei dieses
# Auftrags): diese Pruefung sitzt in cmd_ensure NACH der Motorwahl (mtplx-Klemme,
# vllm-metal-Umschlagpunkt) -- ein Neustart mit hoeherem --parallel laesst den
# schon gewaehlten Motor unveraendert stehen, auch wenn die neue Stromzahl
# eigentlich einen Motorwechsel verlangen wuerde (buendelung.umschlagpunktStroeme).
# Sicherer als der bisherige Fehler (stiller Weiterbetrieb ueber Kapazitaet), aber
# kein vollstaendiger Ersatz fuer eine Motorwahl VOR dieser Pruefung.
kapazitaet_pruefen() {   # <pid> <basisname> <explizites-parallel-oder-leer>
  local pid="$1" basisname="$2" explizit="${3:-}"
  local kap; kap="$(laufende_decode_concurrency "$pid")"
  local gebucht; gebucht="$(gebuchte_sequenzen_summe "$basisname")"
  case "$gebucht" in ''|*[!0-9]*) gebucht=0 ;; esac
  local benoetigt=$((gebucht + 1))
  if [ -n "$explizit" ] && [ "$explizit" -gt "$benoetigt" ] 2>/dev/null; then
    benoetigt="$explizit"
  fi
  if [ -z "$kap" ]; then
    # Kapazitaet an der lebenden Kommandozeile nicht ablesbar (unbekannter Motor
    # oder Schalter) -- konservativ als ausreichend behandeln, sonst wuerde jeder
    # Motor ohne lesbaren Schalter bei jedem 'ensure' unnoetig neu gestartet.
    printf 'ja %s ?\n' "$benoetigt"
    return 0
  fi
  if [ "$benoetigt" -le "$kap" ] 2>/dev/null; then
    printf 'ja %s %s\n' "$benoetigt" "$kap"
  else
    printf 'nein %s %s\n' "$benoetigt" "$kap"
  fi
}

# Leer, wenn der laufende Prozess KEINEN Entwerfer traegt -- wichtig fuer den
# "schon laeuft, gleiches Modell"-Vergleich in cmd_ensure: zwei
# Registry-Eintraege koennen denselben modelRef teilen (das Ziel mit und ohne
# Entwerfer), der Pfadvergleich allein wuerde sie faelschlich als gleich
# behandeln. Zwei moegliche Schalter, je nach Motor: --draft-model
# (mlx_lm.server, dort nach wie vor unbenutzt -- siehe Null-Resultat
# Nachtrag 7 -- ABER seit Nachtrag 22, 2026-08-27 der ECHTE Schalter des
# vierten Motors mlx_vlm.server, der ihn tatsaechlich versteht) oder
# --drafter (mlx-dspark serve, der andere funktionierende Weg).
laufender_draft_pfad() {
  local pid="$1"
  ps -o command= -p "$pid" 2>/dev/null | sed -n -e 's/.*--draft-model \([^ ]*\).*/\1/p' -e 's/.*--drafter \([^ ]*\).*/\1/p'
}

# Mit welcher Kontextstufe dieser Prozess WIRKLICH laeuft (Nachtrag
# 21.08.2026, GEMESSEN am echten Doppelstart, siehe der lange Kommentar in
# cmd_ensure ueber dem "laeuft schon dasselbe"-Vergleich): mtplx, vllm-metal
# UND mlx-vlm (Nachtrag 22, 2026-08-27) tragen ihr Kontextfenster als echten
# Serverschalter (--context-window / --max-model-len / --max-kv-size) in der
# lebenden Kommandozeile -- dort ist DAS die Wahrheit, genau wie bei
# laufender_motor/laufender_draft_pfad. mlx_lm.server und mlx-dspark kennen
# KEINEN solchen Schalter (siehe Kopfkommentar "WARUM ES KEINEN
# --context-SCHALTER AN mlx_lm.server GIBT" -- der Server laedt bei diesen
# zwei IMMER das volle native Fenster, egal welches --kontext gebucht
# wurde). Fuer diese zwei faellt die Funktion auf aktuell.json zurueck, ABER
# NUR, wenn deren "modell"-Feld mit dem Pfad uebereinstimmt, den der
# Aufrufer gerade LIVE bestaetigt hat ($2) -- sonst
# koennte die Datei von einem laengst beendeten oder von aussen ersetzten
# Lauf stammen und eine falsche Zahl vortaeuschen (dieselbe Vorsicht, die
# laufendes_modell() schon gegen die reine Merkdatei hat). Leer heisst
# "unbekannt", nicht "0" -- ein Vergleich gegen die leere Zeichenkette
# schlaegt dann fehl und erzwingt lieber einen (im schlimmsten Fall
# ueberfluessigen) Wechsel, statt einen unverifizierten Kontext stillschweigend
# als gleich zu behandeln.
laufender_kontext() {
  local pid="$1" erwarteter_pfad="$2" aus_cmd
  aus_cmd="$(ps -o command= -p "$pid" 2>/dev/null \
    | sed -n -e 's/.*--context-window \([0-9]*\).*/\1/p' -e 's/.*--max-model-len \([0-9]*\).*/\1/p' -e 's/.*--max-kv-size \([0-9]*\).*/\1/p')"
  if [ -n "$aus_cmd" ]; then
    printf '%s' "$aus_cmd"
    return 0
  fi
  [ -f "$AKTUELL_DATEI" ] || return 0
  python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if d.get("modell") == sys.argv[2] and d.get("kontext") is not None:
    print(d["kontext"])
' "$AKTUELL_DATEI" "$erwarteter_pfad" 2>/dev/null
}

# Welcher der fuenf Motoren gerade laeuft -- aus der lebenden Kommandozeile
# gelesen, nicht aus einer Merkdatei (Nachtrag 10). Gebraucht wird das seit
# vllm-metal: es ist der erste Motor, der DENSELBEN Modellpfad ohne Entwerfer
# faehrt wie mlx_lm.server. Bis dahin genuegten Pfad und Entwerferzustand fuer
# die Frage "laeuft schon dasselbe" -- mtplx laedt einen anderen Koerper,
# mlx-dspark traegt einen --drafter. Bei vllm-metal stimmen beide ueberein und
# der Server waere trotzdem ein anderer; ohne diese Pruefung haette `ensure`
# einen laufenden mlx_lm.server faelschlich fuer den angeforderten vllm-metal
# gehalten und gar nicht erst gewechselt. Derselbe Grund gilt jetzt fuer den
# fuenften Motor, mlx-vlm (Nachtrag 22, 2026-08-27): auch er traegt einen
# --draft-model (denselben Schalternamen wie das nie benutzte mlx_lm.server-
# Feld), der Pfadvergleich allein koennte die beiden Motoren also
# verwechseln.
laufender_motor() {
  local pid="$1" cmd
  cmd="$(ps -o command= -p "$pid" 2>/dev/null)"
  case "$cmd" in
    *mlx-dspark*) printf 'mlx-dspark' ;;
    *mtplx*)      printf 'mtplx' ;;
    *vllm*)       printf 'vllm-metal' ;;
    *mlx_vlm*)    printf 'mlx-vlm' ;;
    *mlx_lm*)     printf 'mlx-lm' ;;
    *)            printf '' ;;
  esac
}

wait_health() {
  local deadline_s="$1" waited=0
  while [ "$waited" -lt "$deadline_s" ]; do
    curl -fsS --max-time 2 "$BASEURL/health" >/dev/null 2>&1 && return 0
    sleep 2; waited=$((waited + 2))
  done
  return 1
}

probe_request() {
  local body
  body=$(printf '{"model":"%s","messages":[{"role":"user","content":"Antworte nur mit OK."}],"max_tokens":8}' "$1")
  curl -fsS --max-time 60 "$BASEURL/v1/chat/completions" -H 'Content-Type: application/json' -d "$body"
}

# ── Registry-Aufloesung ──────────────────────────────────────────────────────
# Setzt bei Erfolg RES_ID, RES_ALIAS, RES_PATH, RES_KONTEXT_VORGABE,
# RES_GEWICHTE_GB, RES_CHAT_TEMPLATE_ARGS (leer, was die Registry nicht
# hergibt). Rueckgabe 1 bei einem Namen, der weder Kennung noch Alias noch
# Pfad ist.
#
# KEIN eigenes Feld fuer die Vorhersage-Bauart mehr (Nachtrag 7, siehe
# Kopfkommentar): das eigene Registry-Feld `speculativeDecoding` dieser
# Datei ist retired (Null-Resultat -- mlx_lm.server kann fuer diese
# Architektur grundsaetzlich kein spekulatives Decoding, egal welcher
# Entwerfer). Das JETZT gueltige Feld `vorhersage` (Schema von Worker
# "ktxwerk") liest DIESES Skript bewusst NICHT selbst aus der Registry --
# siehe VORHERSAGE_BAUART_VORGABE weiter oben und den Motorwahl-Block in
# cmd_ensure.
RES_ID=""; RES_ALIAS=""; RES_PATH=""; RES_KONTEXT_VORGABE=""; RES_GEWICHTE_GB=""; RES_CHAT_TEMPLATE_ARGS=""; RES_BUENDELUNG=""; RES_VORHERSAGE=""

resolve_modell() {
  local eingabe="$1"
  RES_ID=""; RES_ALIAS=""; RES_PATH=""; RES_KONTEXT_VORGABE=""; RES_GEWICHTE_GB=""; RES_CHAT_TEMPLATE_ARGS=""; RES_BUENDELUNG=""; RES_VORHERSAGE=""
  if [ -z "$eingabe" ]; then
    err "kein Modell angegeben."
    return 1
  fi

  local id=""
  case "$eingabe" in
    /*)
      # Absoluter Pfad: unveraendert genommen (siehe Kopfkommentar,
      # gardener/GRUG_MODEL_PATH haengt daran). Trotzdem versuchen, ihn in der
      # Registry wiederzuerkennen (modelRef-Treffer) -- dann gibt es
      # gewichteGb/contextWindow gratis dazu, ohne dass der Aufrufer die
      # Kennung kennen muesste.
      RES_PATH="$eingabe"
      id="$(python3 - "$eingabe" "$MODELSFILE" <<'PY'
import json, sys
pfad, registry = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(registry))
except Exception:
    sys.exit(0)
for m in d.get("models", []):
    if isinstance(m, dict) and m.get("provider") == "mlx-lokal" and m.get("modelRef") == pfad:
        print(m.get("id", ""))
        break
PY
)"
      ;;
    *)
      # Die kanonische Kennung direkt erfragen -- `--field id` antwortet fuer
      # eine Kennung wie fuer einen Alias mit derselben Kennung.
      #
      # Bis zum 2026-08-29 stand hier stattdessen die Frage, OB `wb-state models
      # get "$eingabe"` gelingt, und aus dem Scheitern wurde geschlossen, die
      # Eingabe sei ein Alias. Seit wb-state Aliase aufloest, gelingt der Aufruf
      # auch fuer einen Alias -- und dann wurde der Alias selbst zur Kennung.
      # Sichtbar wurde das an `--served-model-name … qwen38` statt `… qwen38-27b`,
      # was vLLM zurueckweist, weil es den Modellnamen im Gegensatz zu
      # mlx_lm.server tatsaechlich prueft. Aus einem Fehlschlag zu schliessen ist
      # bruechig; gefragt wird jetzt nach dem Wert, um den es geht.
      id="$(wb-state models get "$eingabe" --field id 2>/dev/null)"
      if [ -z "$id" ]; then
        # Rueckfall fuer eine wb-state-Fassung ohne Alias-Aufloesung: als ALIAS
        # direkt in der Registry-Datei suchen.
        id="$(python3 - "$eingabe" "$MODELSFILE" <<'PY'
import json, sys
alias, registry = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(registry))
except Exception:
    sys.exit(0)
for m in d.get("models", []):
    if isinstance(m, dict) and m.get("alias") == alias and m.get("provider") == "mlx-lokal":
        print(m.get("id", ""))
        break
PY
)"
      fi
      if [ -z "$id" ]; then
        err "Modell '$eingabe' ist weder eine Registry-Kennung noch ein Alias eines MLX-Modells (Provider mlx-lokal)."
        return 1
      fi
      ;;
  esac

  if [ -n "$id" ]; then
    local provider
    provider="$(wb-state models get "$id" --field provider 2>/dev/null)"
    if [ "$provider" != "mlx-lokal" ]; then
      err "Modell '$id' hat Provider '${provider:-?}', nicht 'mlx-lokal' — wb-mlx-server startet nur MLX-Modelle."
      return 1
    fi
    RES_ID="$id"
    RES_ALIAS="$(wb-state models get "$id" --field alias 2>/dev/null)"
    RES_PATH="$(wb-state models get "$id" --field modelRef 2>/dev/null)"
    RES_KONTEXT_VORGABE="$(wb-state models get "$id" --field contextWindow 2>/dev/null)"
    RES_GEWICHTE_GB="$(wb-state models get "$id" --field gewichteGb 2>/dev/null)"
    # chatTemplateArgs: JSON-Objekt, das mlx_lm.server als serverseitige
    # Vorgabe fuer apply_chat_template benutzt (--chat-template-args). Fuer
    # qwen38-27b traegt es reasoning_effort=low -- siehe die Denkstufen-Falle
    # im Kopfkommentar. "null"/leer heisst: die Registry hat kein Feld.
    RES_CHAT_TEMPLATE_ARGS="$(wb-state models get "$id" --field chatTemplateArgs 2>/dev/null)"
    # buendelung (Nachtrag 10): das Gegenstueck zu `vorhersage`, aber fuer die
    # andere Betriebsart -- welcher Motor dieses Modell buendelt, wenn mehrere
    # Stroeme gleichzeitig laufen. Anders als `vorhersage` liest dieses Skript
    # das Feld SELBST aus der Registry, ohne Umweg ueber Umgebungsvariablen von
    # wb-code/pi-worker. Der Grund ist die Sache selbst: `vorhersage` haengt
    # zusaetzlich an einer Sitzungs-Einstellung (orchestratorVorhersage/
    # workerVorhersage), die dieses Skript nicht sehen kann -- `buendelung`
    # haengt an nichts ausser der Stromzahl, und die kommt ohnehin schon als
    # --parallel hier an. Ein Umweg haette hier nur eine dritte Stelle
    # geschaffen, an der die Angabe haette veralten koennen; siehe den
    # Motorwahl-Block in cmd_ensure, warum das Feld am MODELL sitzt und nicht
    # als Schalter am Aufruf.
    RES_BUENDELUNG="$(wb-state models get "$id" --field buendelung 2>/dev/null)"
    # `vorhersage` ebenso (Nachtrag 15, 2026-08-21) -- der Kommentar darueber
    # erklaert, warum es das bis heute NICHT tat, und der Motorwahl-Block in
    # cmd_ensure, was daran falsch war: die Sitzungs-Einstellung bleibt
    # vorrangig, aber wer gar nichts sagt, soll dieselbe Antwort bekommen wie
    # eine Sitzung, statt stillschweigend auf einem anderen Motor zu landen.
    RES_VORHERSAGE="$(wb-state models get "$id" --field vorhersage 2>/dev/null)"
    if [ -z "$RES_PATH" ]; then
      err "Modell '$id' hat kein modelRef in der Registry."
      return 1
    fi
  fi

  if [ -z "$RES_PATH" ]; then
    err "kein Pfad fuer '$eingabe' auflösbar."
    return 1
  fi
  return 0
}

# Die Gewichtsdateien auf der Platte, in GiB -- binaer, wie alles andere in dieser
# Rechnung. Leer, wenn nichts messbar ist.
gewichte_gemessen_gib() {
  local pfad="$1"
  python3 - "$pfad" <<'PY' 2>/dev/null
import glob, os, sys
p = sys.argv[1]
b = sum(os.path.getsize(f) for f in glob.glob(os.path.join(p, "*.safetensors")))
if not b:
    for wurzel, _, dateien in os.walk(p):
        for d in dateien:
            try:
                b += os.path.getsize(os.path.join(wurzel, d))
            except OSError:
                pass
if b:
    print("%.2f" % (b / 1024 ** 3))
PY
}

# GEMESSEN SCHLAEGT EINGETRAGEN (Nachtrag 14, 2026-08-21). Bis heute galt der
# Registry-Wert `gewichteGb` unbesehen, und die Plattenbelegung war nur der
# Rueckfall fuer Pfade ohne Eintrag. Der Registry-Wert ist aber von Hand gepflegt
# und traegt an mehreren Stellen DEZIMALE Gigabyte, waehrend diese ganze Rechnung
# binaer rechnet: qwen38-27b steht mit 16,05 im Register, seine safetensors messen
# 16,05 GB = 14,95 GiB; der MTPLX-Koerper steht mit 21,6, gemessen sind 19,83 GiB.
# Das sind 1,1 bzw. 1,8 GiB, die bei jedem Start zu viel gebucht werden -- genau die
# Groessenordnung, an der die 256k-Stufe am 21.08. gescheitert ist. Denselben Fehler
# hat wb-kontext im Juli an seiner eigenen Stelle schon behoben (Pruefer-Befund B13a).
#
# WARUM DER GEMESSENE WERT AUCH NACH UNTEN GILT: Die Dateigroesse ist bereits eine
# OBERGRENZE fuer das, was wirklich im Speicher landet -- fuer qwen38-27b-mlx-4bit
# wurden am 21.08. nach dem Laden 14,09 GiB aktiver MLX-Speicher gemessen, gegen
# 14,95 GiB auf der Platte (der Bildturm des VL-Modells wird von mlx_lm gar nicht
# geladen). Ein Registry-Wert OBERHALB der Dateigroesse bucht also sicher zu viel.
#
# Abweichungen werden LAUT genannt, nie still zurechtgebogen, und wenn gar nichts
# messbar ist, bleibt es beim Registry-Wert.
gewichte_gb_ermitteln() {
  local pfad="$1" registry_wert="$2"
  local gemessen; gemessen="$(gewichte_gemessen_gib "$pfad")"
  if [ -z "$gemessen" ]; then
    if [ -n "$registry_wert" ]; then
      err "WARNUNG: Gewichte von '$pfad' nicht messbar — es bleibt beim Registry-Wert $registry_wert GiB."
      printf '%s' "$registry_wert"
      return 0
    fi
    err "Gewichte von '$pfad' nicht messbar und kein gewichteGb in der Registry — kein Start ohne eine Gewichtsangabe."
    return 1
  fi
  if [ -z "$registry_wert" ]; then
    err "WARNUNG: '$pfad' hat kein gewichteGb in der Registry — gemessen wurden $gemessen GiB auf der Platte."
    printf '%s' "$gemessen"
    return 0
  fi
  # WEIT UNTER DEM EINGETRAGENEN WERT HEISST NICHT "kleiner als gedacht", SONDERN
  # "da fehlt etwas" (Nachtrag 2026-08-21, gefunden in test-entwerfer.sh). Die
  # Dateigroesse ist eine Obergrenze fuer das, was geladen wird -- aber nur, wenn
  # die Dateien ueberhaupt da sind. Ein halb heruntergeladener Ordner, ein
  # Platzhalter, ein Ordner mit einer verschobenen Datei: dort misst diese
  # Funktion fast nichts, und eine Buchung ueber fast nichts ist genau der
  # gefaehrliche Fehler, gegen den das Buch gebaut ist.
  #
  # Der Fehler, den diese Messung beheben soll, ist dagegen KLEIN und bekannt:
  # dezimale GB statt binaerer GiB, also hoechstens 7,4 % zu hoch. Ein Band von
  # 25 % nach unten deckt ihn mit Reserve ab und faengt den unvollstaendigen
  # Ordner trotzdem. Ueber dem Registry-Wert gilt die Messung immer -- mehr
  # Gewicht als eingetragen ist eine Tatsache, keine Auffaelligkeit.
  local zu_klein
  zu_klein="$(LC_ALL=C awk -v r="$registry_wert" -v g="$gemessen" 'BEGIN { print (g < r * 0.75) ? "ja" : "nein" }')"
  if [ "$zu_klein" = "ja" ]; then
    err "Gewichte: gemessen wurden nur $gemessen GiB, eingetragen sind $registry_wert GiB — das ist zu wenig, um eine Messung zu sein. Der Ordner ist vermutlich unvollstaendig; gebucht wird der EINGETRAGENE Wert, damit die Buchung nicht zu klein ausfaellt."
    printf '%s' "$registry_wert"
    return 0
  fi
  local abw
  abw="$(LC_ALL=C awk -v r="$registry_wert" -v g="$gemessen" 'BEGIN { d = r - g; if (d < 0) d = -d; printf "%.0f", (g > 0 ? d / g * 100 : 0) }')"
  if [ "$abw" -ge 5 ]; then
    err "Gewichte: Registry sagt $registry_wert GiB, gemessen sind $gemessen GiB ($abw % Abweichung) — gebucht wird der GEMESSENE Wert. Der Registry-Eintrag gehoert korrigiert (haeufigste Ursache: dezimale GB statt GiB eingetragen)."
  fi
  printf '%s' "$gemessen"
}

# ── aktuell.json: Gedaechtnis fuer den Proxy-Fallback, KEINE Live-Anzeige ───
# Wird bei jedem erfolgreichen Start ueberschrieben, NIE von `stop` geloescht
# -- "das zuletzt gewaehlte Modell" bleibt gemerkt, auch wenn der Server
# gerade nicht laeuft (siehe "OHNE ANGABE" im Kopfkommentar).
aktuell_schreiben() {
  local id="$1" alias="$2" pfad="$3" kontext="$4" kennung="$5"
  mkdir -p "$STATEDIR" 2>/dev/null
  python3 - "$AKTUELL_DATEI" "$id" "$alias" "$pfad" "$kontext" "$kennung" <<'PY'
import json, sys, time
pfad_out, mid, alias, pfad, kontext, kennung = sys.argv[1:7]
daten = {
    "modell": pfad,
    "modellId": mid or None,
    "alias": alias or None,
    "kontext": int(kontext) if kontext.isdigit() else None,
    "belegungKennung": kennung or None,
    "startzeit": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
}
with open(pfad_out, "w", encoding="utf-8") as f:
    json.dump(daten, f, indent=2, ensure_ascii=False)
    f.write("\n")
PY
}

# DIE REGISTRY-KENNUNG HAT VORRANG VOR DEM KOERPERPFAD (Nachtrag 2026-08-21).
#
# Beides steht in der Datei: "modellId" ist die Kennung, unter der die Registry das
# Modell fuehrt (etwa qwen38-27b), "modell" der Pfad des Koerpers, der zuletzt wirklich
# geladen war. Bei einem Modell MIT Vorhersage sind das zwei verschiedene Dinge -- der
# geladene Koerper ist dann die MTPLX-Fassung, und unter DIESEM Pfad kennt die Registry
# nichts. Wer beim Wiederanlauf den Pfad nimmt, verliert damit die Registry-Zuordnung
# und mit ihr die Vorhersage: der Server kommt als gewoehnlicher mlx_lm.server hoch.
#
# GEMESSEN AM 21.08.2026, und es war Fehler des Nutzers im Betrieb: die Notbremse beendete
# unter Speicherdruck den laufenden mtplx-Server. Der Modell-Proxy startete bedarfsweise
# nach -- ohne Modellargument, also ueber genau diesen Weg --, bekam den Koerperpfad,
# fand dazu keinen Registry-Eintrag und startete mlx_lm.server. Der meldet unter
# /v1/models nicht "mtplx-qwen38-27b-optimized-speed", haelt den Namen fuer eine
# HuggingFace-Kennung und schlaegt ihn online nach. Die laufende pi-Sitzung bekam
# daraufhin auf jede Anfrage 404 -- zweimal an einem Nachmittag.
#
# Der Pfad bleibt der Rueckfall: eine aeltere Datei ohne "modellId" funktioniert weiter
# wie bisher, und ein Modell ohne Registry-Eintrag hat gar keine Kennung.
aktuell_modell_lesen() {
  [ -f "$AKTUELL_DATEI" ] || return 0
  python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
print(d.get("modellId") or d.get("modell") or "")
' "$AKTUELL_DATEI" 2>/dev/null
}

# ── Belegung ─────────────────────────────────────────────────────────────────
BELEGUNG_KENNUNG=""
# EINE KENNUNGSDATEI IST EINE BEHAUPTUNG, KEIN BELEG (Nachtrag 18, 2026-08-21).
#
# Sie sagt "zu diesem Server gehoert die Belegung X". Zwei Wege machen sie
# falsch, beide am 21.08. wirklich passiert:
#
#   KARTEILEICHE  Die Belegung steht nicht mehr im Buch (verfallen, von Hand
#                 freigegeben, von der Notbremse zurueckgegeben), die Datei aber
#                 schon. Gemessen: `wb-belegung wer` meldete null offene
#                 Belegungen, waehrend die Datei c451b8 trug (davor 54e463).
#   WAISE         Die Belegung steht im Buch, aber es laeuft kein Server mehr.
#                 Sie zaehlt dann gegen die naechste Anfrage -- und zwar gegen
#                 den NAECHSTEN START DESSELBEN SERVERS. Ergebnis: Selbstblockade
#                 bei 40 GiB freiem Speicher ("32,6 GiB belegt, aber noch nicht
#                 geladen"), und `stop` hatte vorher gemeldet: "Belegung liess
#                 sich NICHT freigeben (beide Versuche gescheitert) --
#                 Kennungsdatei bleibt bewusst stehen".
#
# Diese Funktion laeuft am ANFANG jedes ensure, bevor irgendetwas gerechnet
# wird, und raeumt beide Faelle weg. Die Reihenfolge ist Absicht: erst nachsehen,
# ob die Belegung ueberhaupt noch im Buch steht, dann, ob ein Server sie
# rechtfertigt. Was entfernt wird, wird GESAGT -- eine Buchung, die still
# verschwindet, ist so schlecht wie eine, die still bleibt.
#
# NICHTS WIRD ANGEFASST, SOLANGE EIN SERVER LAEUFT. Eine Belegung mit lebendem
# Server ist genau das, wofuer sie da ist.
# EINE VERWAISTE BELEGUNG GIBT ES AUCH OHNE KENNUNGSDATEI (Nachtrag 18b,
# 2026-08-21, im Betrieb gefunden). Wer den Server von Hand startet -- so ist der
# 256k-Nachweis entstanden --, legt keine Kennungsdatei an; stirbt der Server
# danach, bleibt die Belegung im Buch und niemand raeumt sie weg. Gemessen: 32,6
# GiB standen unter c451b8 im Buch, Port 8081 war frei, kein Modellprozess mehr
# da. `wb-belegung aufraeumen` hilft dort nicht -- es wartet auf den Tod des
# Halter-Panes, und der lebt weiter.
#
# WORAN SIE ERKANNT WIRD: am Zweck, den dieses Werkzeug selbst schreibt
# ("wb-mlx-server: MLX-Server fuer ... Port N"). Das ist kein Ratespiel, sondern
# unsere eigene Marke. Und es ist eindeutig: auf einem Port kann nur ein Server
# lauschen -- laeuft dort keiner, kann keine Belegung fuer diesen Port noch
# jemandem gehoeren.
# Gemeinsame Abfrage fuer belegungen_dieses_ports_freigeben() UND
# belegung_freigebens Rueckfall ohne Kennungsdatei (Nachtrag 2026-09-08,
# ZWEITE RUNDE, Auftrag "buchung", Befund 2) -- eine Quelle fuer "welche
# Belegungen gehoeren zu DIESEM Port", nicht zwei auseinanderlaufende Kopien
# derselben Abfrage.
_port_marke_kennungen() {   # <wbb> -> eine Kennung je Zeile
  local wbb="$1"
  "$wbb" wer --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
marke = "Port %s" % sys.argv[1]
for b in d.get("belegungen", []):
    z = b.get("zweck") or ""
    if z.startswith("wb-mlx-server:") and marke in z:
        print(b.get("id"))
' "$PORT" 2>/dev/null
}

belegungen_dieses_ports_freigeben() {
  local wbb="$1"
  local ids
  ids="$(_port_marke_kennungen "$wbb")"
  [ -n "$ids" ] || return 0
  local id
  for id in $ids; do
    err "Belegung '$id' gehoert einem Server auf Port $PORT, der nicht mehr laeuft — verwaist, wird freigegeben."
    if "$wbb" gib "$id" >/dev/null 2>&1 || "$wbb" gib "$id" --fremd >/dev/null 2>&1; then
      err "Belegung '$id' freigegeben."
    else
      err "WARNUNG: Belegung '$id' liess sich NICHT freigeben. Sie zaehlt weiter gegen den naechsten Start. Von Hand: wb-belegung gib $id --fremd"
    fi
  done
}

kennung_aufraeumen() {
  local wbb0; wbb0="$(belegung_bin)"
  if [ -n "$wbb0" ]; then
    local pid0; pid0="$(find_pid)"
    if [ -z "$pid0" ] || ! is_ours "$pid0"; then
      belegungen_dieses_ports_freigeben "$wbb0"
    fi
  fi
  [ -f "$KENNUNG_DATEI" ] || return 0
  local kennung; kennung="$(tr -d '[:space:]' < "$KENNUNG_DATEI" 2>/dev/null)"
  if [ -z "$kennung" ]; then
    rm -f "$KENNUNG_DATEI"
    return 0
  fi
  local wbb; wbb="$(belegung_bin)"
  if [ -z "$wbb" ]; then
    err "WARNUNG: Kennungsdatei traegt '$kennung', aber wb-belegung ist nicht aufrufbar — sie bleibt stehen, ungeprueft."
    return 0
  fi
  local im_buch
  im_buch="$("$wbb" wer --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for b in d.get("belegungen", []):
    if b.get("id") == sys.argv[1]:
        print("ja")
        break
' "$kennung" 2>/dev/null)"
  if [ "$im_buch" != "ja" ]; then
    err "Kennungsdatei trug '$kennung', diese Belegung steht aber nicht mehr im Buch — Karteileiche, verworfen."
    rm -f "$KENNUNG_DATEI"
    return 0
  fi
  # Sie steht im Buch. Rechtfertigt ein laufender Server sie noch?
  local pid; pid="$(find_pid)"
  if [ -n "$pid" ] && is_ours "$pid"; then
    return 0
  fi
  err "Belegung '$kennung' steht im Buch, aber auf Port $PORT laeuft kein Server von uns — verwaist, wird freigegeben."
  if "$wbb" gib "$kennung" >/dev/null 2>&1 || "$wbb" gib "$kennung" --fremd >/dev/null 2>&1; then
    err "Belegung '$kennung' freigegeben — das Buch stimmt wieder mit der Maschine ueberein."
    rm -f "$KENNUNG_DATEI"
  else
    err "WARNUNG: Belegung '$kennung' liess sich NICHT freigeben. Sie zaehlt weiter gegen den naechsten Start. Von Hand: wb-belegung gib $kennung --fremd"
  fi
}

belegung_nehmen() {
  local modell_basisname="$1" gewichte_gb="$2" kontext="$3" frist_min="$4" zweck="$5" parallel="$6" draft_gewichte_gb="$7" cache_gib="${8:-0}" metal_fraktion="${9:-}" kv_quant="${10:-}" auf_eigene_gefahr="${11:-0}" kv_modellname="${12:-}" cache_ist_exakt="${13:-0}"
  # cache_ist_exakt (Nachtrag 2026-09-08, Auftrag "buchung", Kleinkram-Befund "APC
  # ohne 2,2-Faktor"): mlx-vlms APC-Blockpool ist eine EXAKTE Zuteilung (Bloecke x
  # Blockgroesse x KV-Bedarf je Token), kein weicher Deckel, der wie bei
  # mlx_lm.server gemessen ueberschritten wird -- gebucht wird deshalb ueber
  # --prompt-cache-exakt-gb (kein PROMPT_CACHE_DECKEL_FAKTOR), nicht ueber
  # --prompt-cache-gb. Vorgabe 0 (Deckel wie bisher) aendert nichts am bestehenden
  # mlx_lm.server-Pfad.
  # kv_modellname (NACHTRAG 23, 2026-08-27): der Name, unter dem wb-belegung den
  # KV-Bedarf je Token NACHSCHLAEGT -- normalerweise derselbe Basisname, aber
  # nicht zwingend. wb-belegungs KV-Register rechnet ABSICHTLICH nichts um: ein
  # Faktor auf einen gemessenen Wert waere wieder eine Annahme. Derselbe Koerper
  # kostet aber je nach Motor verschieden viel, weil nur manche Motoren einen
  # Quantisierungsschalter haben -- unter mlx_lm.server 0,0625 MiB/Token, unter
  # mlx_vlm.server mit --kv-bits 8 nur 0,0332. Beide Zahlen sind gemessen, beide
  # stehen im Register, und dieser Parameter waehlt die richtige aus, statt eine
  # davon still auf den anderen Fall zu uebertragen.
  [ -n "$kv_modellname" ] || kv_modellname="$modell_basisname"
  # Die beiden zusaetzlichen Schalter, gemeinsam fuer beide Buchungsarten unten:
  # --kv-quant sagt der Buchung, womit der Motor gleich faehrt (NACHTRAG 11),
  # --auf-eigene-gefahr ist der Weg des Menschen an einer Ablehnung vorbei
  # (NACHTRAG 12). wb-belegung misst hinter dem zweiten selbst nach, ob wirklich
  # ein Mensch ruft -- hier wird nur durchgereicht, nicht entschieden.
  local zusatz=()
  [ -n "$kv_quant" ] && zusatz+=(--kv-quant "$kv_quant")
  [ "$auf_eigene_gefahr" = "1" ] && zusatz+=(--auf-eigene-gefahr)
  BELEGUNG_KENNUNG=""
  local wbb; wbb="$(belegung_bin)"
  if [ -z "$wbb" ]; then
    if [ "${WB_MLX_SERVER_OHNE_BELEGUNG:-0}" = "1" ]; then
      err "WARNUNG: wb-belegung nicht gefunden — WB_MLX_SERVER_OHNE_BELEGUNG=1 gesetzt, starte OHNE Cross-Sitzungs-Sperre."
      return 0
    fi
    err "wb-belegung nicht gefunden — kein Start ohne die Cross-Sitzungs-Sperre."
    err "Wer sicher ist, dass das in Ordnung geht: WB_MLX_SERVER_OHNE_BELEGUNG=1 wb-mlx-server ensure ..."
    return 1
  fi

  # Entwerfer-Gewichte (Nachtrag 2026-08-20, Auftrag "Vorhersage im Betrieb"):
  # eigenes, sichtbares Feld in der Buchung statt vorab in gewichte_gb
  # hineingerechnet -- wer `wb-belegung wer`/`darf` liest, sieht Ziel und
  # Entwerfer getrennt, nicht eine einzelne, unerklaerte groessere Zahl.
  #
  # DER MOTOR vllm-metal WIRD ANDERS GEBUCHT (Nachtrag 10): er teilt sich sein
  # Speicherbudget beim Start selbst zu (Fraktion mal Metals Arbeitssatz) und
  # haelt es unabhaengig von Stroemen und Kontext -- Gewichte + KV + Zuschlag
  # waeren fuer ihn eine zweite, konkurrierende Spitze. `--metal-fraktion`
  # rechnet die Spitze in wb-belegung aus derselben Fraktion, mit der der
  # Server gleich startet; die Herleitung und die wired_limit-Warnung stehen
  # dort bei METAL_ARBEITSSATZ_GIB. --kontext und --parallel gehen trotzdem
  # mit: sie gehen bei dieser Buchungsart NICHT in die Spitze ein, stehen aber
  # im Buch und sind damit das, was `status` als gebuchten Kontext anzeigt.
  if [ -n "$metal_fraktion" ]; then
    set -- nimm --metal-fraktion "$metal_fraktion" --modell "$kv_modellname" \
      --parallel "$parallel" --kontext "$kontext" \
      --zweck "$zweck" --frist "$frist_min" ${zusatz[@]+"${zusatz[@]}"}
    local mf_out mf_rc
    mf_out="$("$wbb" "$@" 2>&1)"
    mf_rc=$?
    printf '%s\n' "$mf_out" >&2
    if [ "$mf_rc" -eq 0 ]; then
      BELEGUNG_KENNUNG="$(printf '%s\n' "$mf_out" | sed -n 's/.*unter der Kennung \([0-9a-f]\{1,\}\).*/\1/p' | head -1)"
      if [ -z "$BELEGUNG_KENNUNG" ]; then
        err "wb-belegung nimm meldete Erfolg, aber keine lesbare Kennung in der Ausgabe — kein Start."
        return 1
      fi
      return 0
    fi
    if [ "$mf_rc" -eq 1 ]; then
      err "wb-belegung lehnt die Belegung ab (siehe oben, mit Halter) — kein Start."
      return 1
    fi
    if [ "${WB_MLX_SERVER_OHNE_BELEGUNG:-0}" = "1" ]; then
      err "WARNUNG: wb-belegung scheiterte (Exit $mf_rc, siehe oben) — WB_MLX_SERVER_OHNE_BELEGUNG=1 gesetzt, starte OHNE Cross-Sitzungs-Sperre."
      return 0
    fi
    err "wb-belegung scheiterte unerwartet (Exit $mf_rc) — kein Start ohne die Cross-Sitzungs-Sperre."
    return 1
  fi

  # BASISSTROM STATT --nur-gewichte (Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag
  # "buchung", Entwurfsentscheidung zu Risiko 10 -- loest damit auch Risiko 6):
  #
  # URSPRUENGLICHE FASSUNG (erste Runde -- --nur-gewichte bleibt in wb-belegung
  # implementiert und getestet, wird hier ab jetzt aber NICHT mehr benutzt):
  # "Der Serverstart bucht ab jetzt NUR NOCH Gewichte (+ Entwerfer + Cache), NIE
  # eine Strom-KV-Zahl fuer den Aufrufer stellvertretend mit -- jeder Strom wird
  # vom Worker, der ihn faehrt, einzeln gebucht." Das liess GENAU EINEN
  # Verbraucherkreis aus: jeden Aufrufer, der KEIN pi-Worker ist und deshalb nie
  # selbst bucht -- der grug-server-Weg, wb-modell-proxy, der
  # brain-contradict-Richter, ein blanker curl-Aufruf (Risiko 10). Deren
  # KV-Bedarf stand in KEINER Buchung -- Grenze A/B unterschaetzten die reale
  # Spitze um genau diesen Anteil, die gefaehrliche Richtung.
  #
  # KORREKTUR: der Serverstart bucht Gewichte + Entwerfer + Cache + EINEN
  # Basisstrom -- --parallel FEST AUF 1 (nicht $parallel: das ist die reale
  # --decode-concurrency und kann bei einem Kapazitaets-Neustart groesser
  # sein), gehalten vom PROZESS (siehe 'uebernehmen --pid'/--prozess-haelt
  # weiter unten). Dieser eine Strom deckt Richter/Proxy/curl, die selbst nie
  # buchen. Jeder pi-Worker bucht WEITERHIN seinen eigenen Strom obendrauf
  # (unveraendert, "Eigene Sequenz buchen" in pi-worker) -- der ERSTE Worker
  # gegen einen frischen Server ist damit rechnerisch um einen Strom
  # UEBERBUCHT (Basisstrom + sein eigener, obwohl nur einer wirklich laeuft).
  # Bewusst so: zu viel buchen ist die sichere Richtung, ein ungebuchter
  # Nicht-Worker-Verbraucher waere die gefaehrliche.
  #
  # KAPAZITAETSRECHNUNG (Risiko 10, dokumentiert wie verlangt): der Basisstrom
  # zaehlt NICHT in die reale --decode-concurrency-Sizing-Entscheidung
  # (gebuchte_sequenzen_summe() unten schliesst die Server-eigene Buchung ueber
  # ihren zweck aus, siehe dort und kapazitaet_pruefen()) -- er ist ein
  # WB-BELEGUNG-Speicherposten, kein Slot, der Workern weggenommen wird. Ein
  # Nicht-Worker-Request, der GLEICHZEITIG mit allen gebuchten Worker-Stroemen
  # eintrifft, wird vom echten Server QUEUED statt sofort bedient (dieselbe
  # "langsamer statt falsch"-Richtung wie bei 'neustart=abgelehnt', siehe
  # pi-worker) -- ein Durchsatz-, kein Speicherproblem: die reale Speicherspitze
  # bleibt innerhalb dessen, was --decode-concurrency ohnehin zulaesst, plus dem
  # einen zusaetzlich GEBUCHTEN (nicht real parallel laufenden) Basisstrom als
  # Sicherheitsmarge.
  set -- nimm --gewichte-gb "$gewichte_gb" --modell "$kv_modellname" \
    --parallel 1 --kontext "$kontext" \
    --zweck "$zweck" --frist "$frist_min" ${zusatz[@]+"${zusatz[@]}"}
  if [ -n "$draft_gewichte_gb" ]; then
    set -- "$@" --gewichte-entwerfer-gb "$draft_gewichte_gb"
  fi
  # Prompt-Cache (Nachtrag 8, auf den DECKEL umgestellt in Nachtrag 16) --
  # derselbe Grundsatz wie bei den Entwerfer-Gewichten oben: ein eigenes,
  # sichtbares Feld statt vorab in gewichte_gb hineingerechnet. cache_ist_exakt
  # (Nachtrag 2026-09-08, siehe oben): --prompt-cache-exakt-gb statt
  # --prompt-cache-gb, kein PROMPT_CACHE_DECKEL_FAKTOR fuer eine bereits exakt
  # berechnete Zuteilung (APC).
  if [ -n "$cache_gib" ] && [ "$cache_gib" != "0" ]; then
    if [ "$cache_ist_exakt" = "1" ]; then
      set -- "$@" --prompt-cache-exakt-gb "$cache_gib"
    else
      set -- "$@" --prompt-cache-gb "$cache_gib"
    fi
  fi
  local nimm_out nimm_rc
  nimm_out="$("$wbb" "$@" 2>&1)"
  nimm_rc=$?
  printf '%s\n' "$nimm_out" >&2

  if [ "$nimm_rc" -eq 0 ]; then
    BELEGUNG_KENNUNG="$(printf '%s\n' "$nimm_out" | sed -n 's/.*unter der Kennung \([0-9a-f]\{1,\}\).*/\1/p' | head -1)"
    if [ -z "$BELEGUNG_KENNUNG" ]; then
      err "wb-belegung nimm meldete Erfolg, aber keine lesbare Kennung in der Ausgabe — kein Start."
      return 1
    fi
    return 0
  fi
  if [ "$nimm_rc" -eq 1 ]; then
    err "wb-belegung lehnt die Belegung ab (siehe oben, mit Halter) — kein Start."
    return 1
  fi
  if [ "${WB_MLX_SERVER_OHNE_BELEGUNG:-0}" = "1" ]; then
    err "WARNUNG: wb-belegung scheiterte (Exit $nimm_rc, siehe oben) — WB_MLX_SERVER_OHNE_BELEGUNG=1 gesetzt, starte OHNE Cross-Sitzungs-Sperre."
    return 0
  fi
  err "wb-belegung scheiterte unerwartet (Exit $nimm_rc) — kein Start ohne die Cross-Sitzungs-Sperre."
  err "Wer sicher ist, dass das in Ordnung geht: WB_MLX_SERVER_OHNE_BELEGUNG=1 wb-mlx-server ensure ..."
  return 1
}

# NACHWEISEN statt annehmen (Pruefer-Befund B10, 2026-08-19): `wb-belegung gib`
# sagt ueber seinen EXIT-CODE ehrlich, ob es wirklich etwas aus dem Buch
# entfernt hat (0 = entfernt, 1 = "nichts freizugeben" -- gesehen in
# wb-belegung:1346-1354). Die alte Fassung hier ignorierte diesen Code,
# loeschte die Kennungsdatei so oder so und gab immer 0 zurueck -- schlugen
# BEIDE Versuche (eigen, dann --fremd) fehl, war die Datei weg, aber die
# Belegung stand weiter im Buch, und niemand konnte sie ueber die Kennung
# noch finden. Jetzt: die Datei bleibt stehen, wenn beide Versuche
# scheitern, und es kommt eine laute Warnung -- genau das, was `stop` beim
# Prozessende schon lange tut (Port/Prozess pruefen statt annehmen). Bewusst
# NICHT als harter Abbruch der aufrufenden Operation: der Prozess ist zu
# diesem Zeitpunkt bereits nachweislich weg und der Port frei -- der reale
# Speicher ist frei, nur das BUCH hinkt hinterher. Ein Modellwechsel deshalb
# ganz zu verweigern waere schlimmer als eine sichtbare Buchungsleiche.
belegung_freigeben() {
  local wbb; wbb="$(belegung_bin)"
  [ -n "$wbb" ] || return 0
  local kennung=""
  if [ -f "$KENNUNG_DATEI" ]; then
    kennung="$(tr -d '[:space:]' < "$KENNUNG_DATEI" 2>/dev/null)"
  fi
  if [ -n "$kennung" ]; then
    if "$wbb" gib "$kennung" 2>&1; then
      rm -f "$KENNUNG_DATEI"
      return 0
    fi
    if "$wbb" gib "$kennung" --fremd 2>&1; then
      rm -f "$KENNUNG_DATEI"
      return 0
    fi
    err "WARNUNG: Belegung $kennung liess sich NICHT freigeben (beide Versuche gescheitert) — sie steht weiter im Buch, bis ihre Frist verfaellt. Kennungsdatei bleibt bewusst stehen: $KENNUNG_DATEI. Von Hand pruefen: wb-belegung wer / wb-belegung gib $kennung --fremd"
    return 1
  fi
  # Rueckfall OHNE Kennungsdatei (Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag
  # "buchung", Befund 2): NIE MEHR 'wb-belegung gib --eigene' -- das traf
  # JEDE Belegung ohne Pane, egal wem oder welchem Port sie gehoert. GEMESSEN:
  # ein 'stop' ohne Kennungsdatei konnte so die Gewichtebuchung eines voellig
  # FREMDEN, Prozess-gehaltenen Servers treffen (der hat per Definition kein
  # Pane, siehe wb-belegungs Kopfkommentar "EIN PROZESS KANN AUCH DER HALTER
  # SEIN"). Stattdessen nur Belegungen, deren zweck die eigene Port-Marke
  # traegt -- dieselbe Abfrage wie belegungen_dieses_ports_freigeben() oben
  # (_port_marke_kennungen), eng genug, um garantiert nur DIESEN Port zu
  # treffen, nie einen anderen.
  local ids
  ids="$(_port_marke_kennungen "$wbb")"
  if [ -z "$ids" ]; then
    # Nichts da, war schon leer -- kein Fehler. Trotzdem als Zustand nach
    # aussen tragen (Rueckgabe 1), damit ein Aufrufer, der es pruefen will,
    # es auch kann; es warnt nur derjenige, der wirklich etwas freigeben
    # wollte (kennung war gesetzt, oben).
    return 1
  fi
  local id ok=1
  for id in $ids; do
    if "$wbb" gib "$id" 2>&1 || "$wbb" gib "$id" --fremd 2>&1; then
      :
    else
      err "WARNUNG: Belegung '$id' (Port $PORT) liess sich NICHT freigeben. Von Hand: wb-belegung gib $id --fremd"
      ok=0
    fi
  done
  [ "$ok" -eq 1 ]
}

# belegung_freigeben_gezielt (Nachtrag 2026-09-08, Auftrag "buchung", Befund 2):
# gibt GENAU die uebergebene Kennung frei, NIE einen Pane-weiten Fallback
# ("wb-belegung gib --eigene"). Fuer den einen Moment im Kapazitaets-Neustart,
# in dem im SELBEN Pane bereits eine neue, andere Buchung offen steht
# ($BELEGUNG_KENNUNG) -- ein Fallback auf --eigene wuerde genau diese neue
# Buchung mit abraeumen, weil beide demselben Pane gehoeren. Das war die
# Ursache des Befunds: fehlte die Kennungsdatei des ALTEN Servers (z.B. weil er
# ohne wb-belegung gestartet wurde, oder weil belegung_freigeben() ganz normal
# ohne Argument aufgerufen worden waere), fiel die alte Freigabe auf --eigene
# zurueck und loeschte die BRANDNEUE Buchung gleich mit -- N Worker ohne
# Buchung, waehrend der (fehlgeschlagene oder erfolgreiche) neue Start
# weiterlaeuft. Leere Kennung (der alte Server hatte gar keine eigene, im Buch
# nachweisbare Buchung): nichts zu tun, KEIN Fallback, das ist die sichere
# Richtung.
belegung_freigeben_gezielt() {   # <kennung>
  local kennung="$1" wbb
  [ -n "$kennung" ] || return 0
  wbb="$(belegung_bin)"
  [ -n "$wbb" ] || return 0
  if "$wbb" gib "$kennung" 2>&1 || "$wbb" gib "$kennung" --fremd 2>&1; then
    return 0
  fi
  err "WARNUNG: Belegung $kennung (alter Server) liess sich NICHT freigeben -- sie steht weiter im Buch, bis ihre Frist verfaellt. Von Hand pruefen: wb-belegung wer / wb-belegung gib $kennung --fremd"
  return 1
}

belegung_abbrechen() {   # [--pid <halb-gestartete-pid>] [--kennungsdatei-behalten]
  # Erweitert 2026-09-08, Auftrag "buchung", Befund 3/4, Risiko 12:
  #   --pid <n>                    ein wirklich exec'ter, aber nie gesund gewordener
  #                                 Prozess wird beendet statt als Karteileiche
  #                                 weiterzulaufen (Befund 3, zweite Haelfte: bisher
  #                                 blieb er unbeaufsichtigt stehen, unbebucht). Die
  #                                 ERSTE Fassung schickte dafuer ein blankes 'kill'
  #                                 OHNE jede Nachpruefung und gab die Buchung sofort
  #                                 frei -- ignorierte einen Prozess, der SIGTERM
  #                                 ignoriert (ZWEITE RUNDE, Risiko 12). Jetzt ueber
  #                                 dieselbe TERM-warten-KILL-nachweisen-Folge wie ein
  #                                 regulaerer Stopp (_prozess_beenden_verifiziert,
  #                                 siehe dort), und die Buchung wird ERST NACH
  #                                 bestaetigtem Tod freigegeben -- "Speicher-
  #                                 Untergrenze ist die gefaehrliche Richtung": bleibt
  #                                 der Tod unbestaetigt, bleibt auch die Buchung
  #                                 stehen, statt einen moeglicherweise noch
  #                                 verbrauchten Speicherposten verschwinden zu lassen.
  #   --kennungsdatei-behalten     $KENNUNG_DATEI NICHT loeschen -- fuer den einen
  #                                 Fall (Kapazitaets-Neustart, alter Server liess
  #                                 sich nicht stoppen), in dem die Datei noch
  #                                 korrekt auf den ALTEN, weiterhin laufenden
  #                                 Server zeigt (Befund 4: das unbedingte 'rm -f'
  #                                 loeschte bisher genau diesen gueltigen Verweis).
  local pid_beenden="" kennungsdatei_anfassen=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --pid) pid_beenden="${2:-}"; shift 2 ;;
      --kennungsdatei-behalten) kennungsdatei_anfassen=0; shift ;;
      *) shift ;;
    esac
  done
  local prozess_tot=1
  if [ -n "$pid_beenden" ]; then
    if _prozess_beenden_verifiziert "$pid_beenden"; then
      err "Halb gestarteter Server (PID $pid_beenden) beendet -- der Start ist gescheitert, kein unbeaufsichtigter Prozess bleibt zurueck."
    else
      err "WARNUNG: halb gestarteter Server (PID $pid_beenden) liess sich NICHT sicher beenden -- die Buchung bleibt STEHEN, weil er moeglicherweise noch Speicher verbraucht. Von Hand pruefen: ps -p $pid_beenden, wb-belegung wer."
      prozess_tot=0
    fi
  fi
  local wbb; wbb="$(belegung_bin)"
  if [ -n "$wbb" ] && [ -n "$BELEGUNG_KENNUNG" ] && [ "$prozess_tot" -eq 1 ]; then
    "$wbb" gib "$BELEGUNG_KENNUNG" 2>&1
    [ "$kennungsdatei_anfassen" -eq 1 ] && rm -f "$KENNUNG_DATEI"
  fi
  return 1
}

# ── status/liste ─────────────────────────────────────────────────────────────
cmd_status() {
  local kennung=""
  [ -f "$KENNUNG_DATEI" ] && kennung="$(tr -d '[:space:]' < "$KENNUNG_DATEI" 2>/dev/null)"

  local pid; pid="$(find_pid)"
  if [ -n "$pid" ] && is_ours "$pid"; then
    local since rss_kib rss_mib modell_pfad
    since="$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//')"
    rss_kib="$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ')"
    rss_mib=$(( ${rss_kib:-0} / 1024 ))
    modell_pfad="$(laufendes_modell "$pid")"
    echo "wb-mlx-server: laeuft (PID $pid, Port $PORT), seit: $since, Speicher: ${rss_mib} MiB"
    echo "  Modell: $modell_pfad"
    # Kennung/Alias UND Kontext kommen ab jetzt NICHT MEHR aus aktuell.json,
    # sondern live: die Identitaet frisch aus der Registry ueber den
    # tatsaechlich laufenden Pfad aufgeloest, der Kontext direkt aus
    # wb-belegungs eigenem Buch (der Nutzer, 2026-08-19, Fehler 2 -- "zwei
    # Zahlen fuer dieselbe Sache"). Ursache der Divergenz, gefunden ohne den
    # Server anzufassen: aktuell_schreiben() laeuft als LETZTER Schritt eines
    # erfolgreichen `ensure`, NACH wb-nohup/wait_health/Probeanfrage. Wird
    # GENAU DIESER Lauf danach unterbrochen (Ctrl-C, Pane zu, waehrend der
    # bis zu 90s dauernden Wartezeit) -- der Server selbst laeuft unabhaengig
    # weiter, ueber wb-nohup abgekoppelt (PPID 1, gemessen an PID 83488) --,
    # bleibt aktuell.json auf dem VORHERIGEN Lauf stehen. Live nachgemessen:
    # die Buchung von PID 83488/Kennung e87c69 trug ueber `wb-belegung wer
    # --json` durchgehend den korrekten Kontext 8192, waehrend aktuell.json
    # eine 21:08 Uhr alte 4096 aus einem frueheren Lauf zeigte -- "realisiert"
    # stand fuer dieselbe Kennung ebenfalls noch auf false, derselbe Beleg,
    # dass NUR die abschliessenden Schritte fehlten, nicht die Buchung
    # selbst. `aktuell.json`/`aktuell_schreiben()` bleiben fuer ihren
    # EINZIGEN anderen Zweck bestehen (aktuell_modell_lesen, die "OHNE
    # ANGABE"-Vorgabe fuer wb-modell-proxy) -- dort ist eine leicht veraltete
    # Erinnerung an das ZULETZT gewaehlte Modell unschaedlich, hier bei
    # `status` waere sie die falsche Zahl, die der Mensch als erstes sieht.
    if resolve_modell "$modell_pfad" >/dev/null 2>&1; then
      echo "  Kennung/Alias: ${RES_ID:-?} / ${RES_ALIAS:-?}"
    fi
    # Live aus der Kommandozeile, nicht aus der Registry-Aufloesung oben:
    # teilen sich zwei Eintraege denselben modelRef (Ziel mit und ohne
    # Entwerfer), waere die Kennung/Alias-Aufloesung mehrdeutig -- der
    # tatsaechliche Entwerferzustand des LAUFENDEN Prozesses ist es nicht.
    local laufender_draft laufender_mot; laufender_draft="$(laufender_draft_pfad "$pid")"
    laufender_mot="$(laufender_motor "$pid")"
    if [ -n "$laufender_draft" ] && [ "$laufender_mot" = "mlx-vlm" ]; then
      # motor=mlx-vlm (Nachtrag 22, 2026-08-27) -- eigener Motor, kennt
      # --draft-kind explizit (dflash/eagle3/mtp), --parallel meint hier
      # --max-num-seqs (gleichzeitige Dekodierung, ungemessen mit Entwerfer).
      echo "  Entwerfer: $laufender_draft (mlx_vlm.server, --draft-kind, spekulatives Decoding aktiv)"
    elif [ -n "$laufender_draft" ]; then
      # Ein lebender Entwerferpfad kommt sonst ausschliesslich vom
      # motor=mlx-dspark-Zweig (Nachtrag 7) -- mlx_lm.servers eigener
      # --draft-model-Weg ist retired (Null-Resultat). --parallel meint hier
      # "N gleichzeitig vorgehaltene Praefixe" (--prefix-cache-slots), nicht
      # gleichzeitige Dekodierung.
      echo "  Entwerfer: $laufender_draft (mlx-dspark, spekulatives Decoding aktiv, --parallel = Prompt-Cache-Plaetze)"
    elif [ "$laufender_mot" = "mtplx" ]; then
      # motor=mtplx (Nachtrag 8) -- kein SEPARATER Entwerferpfad, der
      # MTP-Kopf steckt im geladenen Modellkoerper selbst.
      echo "  Vorhersage: eingebaut (mtplx, natives MTP im Modellkoerper, --scheduler-mode serial -- Buendelung nicht verfuegbar)"
    elif [ "$(laufender_motor "$pid")" = "vllm-metal" ]; then
      # motor=vllm-metal (Nachtrag 10) -- rein buendelnd. Die Fraktion steht
      # NICHT in der Kommandozeile (sie ist eine Umgebungsvariable, und
      # `ps -E` zeigt sie unter heutigem macOS fuer eigene Prozesse nicht,
      # siehe Kopfkommentar) -- ihr nachlesbarer Ort ist die Buchung, auf die
      # die Zeile darunter ohnehin verweist.
      echo "  Motor: vllm-metal (Buendelung, keine Vorhersage -- fuer diese Architektur auf allen drei Wegen ausgeschlossen; Speicherbudget siehe Belegung)"
    else
      echo "  Entwerfer: keiner"
    fi
    if [ -n "$kennung" ]; then
      local wbb kontext_gebucht
      wbb="$(belegung_bin)"
      kontext_gebucht=""
      if [ -n "$wbb" ]; then
        kontext_gebucht="$("$wbb" wer --json 2>/dev/null | python3 -c '
import json, sys
kennung = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for b in d.get("belegungen", []):
    if b.get("id") == kennung:
        k = (b.get("rechnung") or {}).get("kontext")
        if k is not None:
            print(k)
        break
' "$kennung" 2>/dev/null)"
      fi
      echo "  Kontext gebucht: ${kontext_gebucht:-unbekannt (Kennung nicht im Buch von wb-belegung wer gefunden)}"
      echo "  Belegung: $kennung (Details: wb-belegung wer)"
    else
      echo "  Kontext gebucht: unbekannt (keine Belegung gehalten)"
      echo "  Belegung: keine gehalten"
    fi
    return 0
  fi
  echo "wb-mlx-server: nicht aktiv (Port $PORT frei)"
  if [ -n "$kennung" ]; then
    # Erst nachsehen, ob die Belegung ueberhaupt noch im Buch steht. Die
    # Kennungsdatei bleibt liegen, wenn der Server abgestuerzt ist oder jemand
    # die Belegung von Hand freigegeben hat -- dann ist der Rat 'wb-belegung gib
    # <kennung>' falsch und laeuft ins Leere (gemessen 2026-08-29, nach einem
    # Neustart des Rechners: Buch leer, Datei da, status riet trotzdem zum gib).
    # status aendert bewusst nichts; aufgeraeumt wird beim naechsten 'ensure'.
    kennung_im_buch=""
    wbb_status="$(belegung_bin 2>/dev/null)"
    if [ -n "$wbb_status" ]; then
      kennung_im_buch="$("$wbb_status" wer --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for b in d.get("belegungen", []):
    if b.get("id") == sys.argv[1]:
        print("ja")
        break
' "$kennung" 2>/dev/null)"
    fi
    if [ "$kennung_im_buch" = "ja" ]; then
      echo "  ACHTUNG: Belegung $kennung ist noch eingetragen, obwohl der Server nicht laeuft (wb-belegung wer / wb-belegung gib $kennung)."
    else
      echo "  Hinweis: Kennungsdatei traegt noch '$kennung', im Buch steht sie nicht mehr -- Karteileiche, der naechste 'ensure' verwirft sie."
    fi
  fi
  return 1
}

cmd_liste() {
  local laufend=""
  local pid; pid="$(find_pid)"
  if [ -n "$pid" ] && is_ours "$pid"; then
    laufend="$(laufendes_modell "$pid")"
  fi
  python3 - "$MODELSFILE" "$laufend" <<'PY'
import json, sys
registry, laufend = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(registry))
except Exception as e:
    print("wb-mlx-server: Registry nicht lesbar (%s): %s" % (registry, e))
    sys.exit(1)
zeilen = [m for m in d.get("models", []) if isinstance(m, dict) and m.get("provider") == "mlx-lokal"]
if not zeilen:
    print("wb-mlx-server: keine MLX-Modelle (Provider mlx-lokal) in der Registry.")
    sys.exit(0)
for m in zeilen:
    ref = m.get("modelRef", "")
    marker = "  <- laeuft" if laufend and ref == laufend else ""
    print("%s (Alias: %s)%s" % (m.get("id", "?"), m.get("alias") or "-", marker))
    print("  Pfad: %s" % ref)
    print("  Kontext-Vorgabe: %s   Gewichte: %s GB" % (m.get("contextWindow", "-"), m.get("gewichteGb", "-")))
PY
}

# ── ensure ───────────────────────────────────────────────────────────────────
# _prozess_beenden_verifiziert (Nachtrag 2026-09-08, ZWEITE RUNDE, Auftrag
# "buchung", Risiko 12): aus _stop_pruefen_und_beenden herausgezogen, damit
# belegung_abbrechen --pid dieselbe TERM-warten-KILL-nachweisen-Folge nutzt,
# statt eines blanken 'kill' ohne jede Nachpruefung (siehe dort). Prueft NUR
# den Prozess, nicht den Port -- _stop_pruefen_und_beenden macht die
# Port-Pruefung selbst, weil sie dort semantisch dazugehoert (ein anderer
# Prozess koennte den Port schon wieder belegt haben); fuer einen halb
# gestarteten, nie gesund gewordenen Prozess ist "lebt er noch" die einzige
# Frage, die belegung_abbrechen braucht.
_prozess_beenden_verifiziert() {   # <pid> -> 0 wenn nachweislich tot, 1 wenn er noch lebt
  local pid="$1"
  kill "$pid" 2>/dev/null
  local waited=0
  while ps -o pid= -p "$pid" >/dev/null 2>&1 && [ "$waited" -lt 30 ]; do
    sleep 0.5; waited=$((waited + 1))
  done
  if ps -o pid= -p "$pid" >/dev/null 2>&1; then
    err "PID $pid reagiert nach 15s nicht auf SIGTERM — sende SIGKILL."
    kill -9 "$pid" 2>/dev/null
    sleep 1
  fi
  if ps -o pid= -p "$pid" >/dev/null 2>&1; then
    err "PID $pid laeuft immer noch — Beenden fehlgeschlagen."
    return 1
  fi
  return 0
}

_stop_pruefen_und_beenden() {   # <pid> [<gezielte-kennung-des-halters, auch leer>]
  # Beendet, was auf $PORT laeuft, und PRUEFT das Ende (Prozess weg, Port
  # frei) statt es anzunehmen -- dieselbe Pruefung wie `stop` heute, geteilt
  # zwischen `cmd_stop` und dem Modellwechsel in `cmd_ensure`.
  #
  # <gezielte-kennung> (Nachtrag 2026-09-08, Auftrag "buchung", Befund 2, IN
  # DER ZWEITEN RUNDE KORRIGIERT -- Befund 3): wird ein ZWEITES Argument
  # UEBERGEBEN (auch eine LEERE Zeichenkette), gilt der gezielte Modus: NUR
  # diese eine Kennung wird freigegeben (belegung_freigeben_gezielt), NIE der
  # Datei/--eigene-Fallback von belegung_freigeben. Eine leere gezielte
  # Kennung heisst dort "nichts freizugeben", NIE "zurueckfallen" --
  # belegung_freigeben_gezielt("") ist selbst schon ein no-op. Die ERSTE
  # Fassung dieser Funktion pruefte stattdessen nur "$gezielte_kennung"
  # NICHT-LEER ist, und fiel bei einer leeren, aber ausdruecklich uebergebenen
  # Kennung (der Kapazitaets-Neustart hat GENAU diesen Fall: der alte Server
  # hatte keine eigene Buchung) auf belegung_freigeben() zurueck -- und DAS
  # landet, mangels Kennungsdatei, wieder beim selben --eigene/Port-Fallback,
  # der im selben Pane die brandneue Buchung ($BELEGUNG_KENNUNG) treffen kann.
  # Der Unterschied "Argument gegeben, aber leer" gegen "kein Argument
  # gegeben" ist deshalb absichtlich ueber die Argumentzahl geprueft, nicht
  # ueber den Inhalt. Ohne ein zweites Argument (cmd_stop, gewoehnlicher
  # Modellwechsel) bleibt das alte Verhalten unveraendert.
  local pid="$1"
  local gezielt_modus=0 gezielte_kennung=""
  if [ $# -ge 2 ]; then
    gezielt_modus=1
    gezielte_kennung="$2"
  fi
  if ! _prozess_beenden_verifiziert "$pid"; then
    return 1
  fi
  local stillpid; stillpid="$(find_pid)"
  if [ -n "$stillpid" ]; then
    err "Prozess $pid ist weg, aber Port $PORT ist weiterhin belegt (PID $stillpid) — pruefen."
    return 1
  fi
  echo "wb-mlx-server: beendet — Prozess $pid weg, Port $PORT frei." >&2
  if [ "$gezielt_modus" -eq 1 ]; then
    belegung_freigeben_gezielt "$gezielte_kennung"
  else
    belegung_freigeben
  fi
  return 0
}

cmd_ensure() {
  local eingabe="" kontext_arg="" frist_min="$BELEGUNG_FRIST_MIN_VORGABE" parallel_arg=""
  # Nachtrag 2026-09-08 (siehe kapazitaet_pruefen() oben): gesetzt, wenn dieser
  # Aufruf den laufenden Server NICHT wiederverwendet hat, weil er keinen
  # weiteren Strom mehr trug -- der Aufrufer (pi-worker) soll das melden
  # koennen, statt einen stillen Neustart fuer ein "kein Start noetig" zu halten.
  local KAPAZITAETS_NEUSTART=0
  # Nachtrag 2026-09-08, DRITTE RUNDE, Gegenleser-Befund Punkt 9/11: die PID
  # des ALTEN Servers, dessen Kapazitaet nicht mehr reicht -- aufgehoben, um
  # ihn ERST NACH einer erfolgreichen neuen Buchung zu stoppen (Rollback-
  # Sicherheit, siehe unten bei belegung_nehmen). Leer heisst "kein
  # Kapazitaets-Neustart im Gange".
  local KAPAZITAETS_ALTER_PID=""
  # KAPAZITAETS_ALTE_KENNUNG (Nachtrag 2026-09-08, Auftrag "buchung", Befund 2):
  # die Kennung, unter der der ALTE Server seine EIGENE Gewichtebuchung haelt --
  # aus $KENNUNG_DATEI gelesen, BEVOR irgendetwas sie anfasst. Damit laesst sich
  # der alte Server spaeter GEZIELT ueber diese eine Kennung freigeben
  # (belegung_freigeben_gezielt), statt auf 'wb-belegung gib --eigene'
  # zurueckzufallen, sobald die Datei aus irgendeinem Grund fehlt -- --eigene
  # gibt ALLE Buchungen dieses Panes frei, und genau in diesem Pane steht zu
  # diesem Zeitpunkt bereits die BRANDNEUE Buchung fuer den Neustart (siehe
  # cmd_ensure weiter unten). Leer heisst: der alte Server hatte gar keine
  # eigene, im Buch nachweisbare Buchung (z.B. mit WB_MLX_SERVER_OHNE_BELEGUNG
  # gestartet) -- dann gibt es dort auch nichts freizugeben.
  local KAPAZITAETS_ALTE_KENNUNG=""
  # Nachtrag 2026-09-08, VIERTE RUNDE, Auftrag (C), VORGABE GEAENDERT IN DER
  # FUENFTEN RUNDE: der Messlauf (Ergebnis motor-ab, 20260908-220231.md) hat
  # entschieden -- mlx-vlm 0.7.0 + mtp-kopf + APC wird Vorgabe fuer Worker.
  # "auto" (Vorgabe ohne --apc/WB_MLX_SERVER_APC) heisst: APC an, SOBALD die
  # Fassung >= 0.7.0 ist, sonst aus -- OHNE WARNUNG (die Fassung ist dann
  # einfach zu alt, das ist kein Fehler des Aufrufers, der nichts verlangt
  # hat). "1" (--apc oder WB_MLX_SERVER_APC=1) ist der ausdrueckliche Wunsch:
  # zu alt bedeutet dort weiterhin eine LAUTE Warnung (siehe apc_aktiv weiter
  # unten). "0" (WB_MLX_SERVER_APC=0) bleibt der ausdrueckliche Verzicht,
  # unabhaengig von der Fassung.
  local apc_gewuenscht="${WB_MLX_SERVER_APC:-auto}"
  # NACHTRAG 2026-09-08, Auftrag "buchung", Kleinkram-Befund "WB_MLX_SERVER_APC
  # schluckt true/yes/on als aus": die Pruefung weiter unten (apc_aktiv) kennt
  # NUR 'auto'/'1'/'0' -- jeder andere Wert (z.B. 'true', 'yes', 'on', ein
  # Tippfehler) traf bisher WEDER die "an"- noch die "Warnung, zu alt"-Bedingung
  # und blieb dadurch STILL auf AUS, ohne jede Fehlermeldung. Wer WB_MLX_SERVER_
  # APC=true setzt, in der (falschen) Annahme, das schalte APC ein, bekam keinen
  # Hinweis, dass APC gerade NICHT lief. Ab jetzt ein harter Fehler statt einer
  # stillen Fehldeutung.
  case "$apc_gewuenscht" in
    auto|1|0) ;;
    *)
      echo "wb-mlx-server: WB_MLX_SERVER_APC='$apc_gewuenscht' ist ungueltig -- erlaubt sind 'auto', '1' oder '0'. Andere Werte (z.B. 'true'/'yes'/'on') wuerden APC still als AUS behandeln, ohne Fehlermeldung -- genau das soll dieser Fehler verhindern." >&2
      exit 2 ;;
  esac
  # NACHTRAG 2026-09-10, Auftrag "apcspeicher": Speicher des APC bei langen
  # Gespraechen. qwen38-27b ist ein Hybridmodell, mlx_vlm haelt seinen Cache
  # deshalb als ganze Schnappschuesse (exact/checkpoint-Modus), und im
  # buendelnden Weg legt JEDE Anfrage zwei davon an (Wachpunkt bei N-1 und den
  # vollen Prompt), jede mit drei Kopien der Schluessel und Werte. Bei 60k Token
  # lag der Server damit bei 40-43 GB und starb am Metal-Speichermangel.
  # Die Knoepfe (alle werden in den Bloecken unten direkt aus der Umgebung
  # gelesen, nicht ueber Locals -- test-mlx-server-mlx-vlm-070.sh fuehrt die
  # Bloecke einzeln aus):
  #   WB_MLX_SERVER_APC_EINTRAEGE   Schnappschuesse im Speicher (APC_EXACT_CACHE_ENTRIES);
  #                                 Vorgabe: einer je Strom mit Patch, sonst 2
  #   WB_MLX_SERVER_APC_SCHLANK     Vorgabe 1 (seit 2026-09-10, Messreihe im Auftrag
  #                                 "apcspeicher"), 0 = Verhalten von mlx_vlm.
  #                                 ein Schnappschuss je Anfrage, eine Kopie, Platz
  #                                 vorher freigeraeumt; eine fertige Anfrage gibt
  #                                 ihren Cache sofort frei statt erst nach dem
  #                                 naechsten Prefill -- braucht den Patch
  #                                 shell/messungen/apc-speicher/patch-apc-speicher.py
  #   WB_MLX_SERVER_APC_SNAPSHOT_BITS=8  Schnappschuss 8-bittig ablegen (nie weniger)
  #   WB_MLX_SERVER_APC_MEMLOG=1    Speicherzeilen "APC-WB" ins Serverprotokoll
  #   WB_MLX_SERVER_APC_DISK=<pfad> Schnappschuesse zusaetzlich auf die SSD
  #                                 (WB_MLX_SERVER_APC_DISK_GB, Vorgabe 64)
  # Hier nur die Pruefung, damit ein Tippfehler vor dem Laden scheitert und nicht
  # still als Vorgabe gilt (derselbe Grund wie bei WB_MLX_SERVER_APC oben).
  case "${WB_MLX_SERVER_APC_EINTRAEGE:-2}" in
    ''|*[!0-9]*)
      echo "wb-mlx-server: WB_MLX_SERVER_APC_EINTRAEGE='${WB_MLX_SERVER_APC_EINTRAEGE:-}' ist ungueltig -- erlaubt ist eine ganze Zahl ab 0." >&2
      exit 2 ;;
  esac
  case "${WB_MLX_SERVER_APC_SCHLANK:-1}" in
    0|1) ;;
    *)
      echo "wb-mlx-server: WB_MLX_SERVER_APC_SCHLANK='${WB_MLX_SERVER_APC_SCHLANK:-}' ist ungueltig -- erlaubt sind '0' oder '1'." >&2
      exit 2 ;;
  esac
  case "${WB_MLX_SERVER_APC_SNAPSHOT_BITS:-}" in
    ''|8) ;;
    *)
      echo "wb-mlx-server: WB_MLX_SERVER_APC_SNAPSHOT_BITS='${WB_MLX_SERVER_APC_SNAPSHOT_BITS:-}' ist ungueltig -- erlaubt ist nur 8 (unter 8 Bit wird nie quantisiert, Hausregel)." >&2
      exit 2 ;;
  esac
  # WB_MLX_SERVER_APC_POOL_GB: Deckel fuer MLXs Vorrat freigegebener Puffer in GiB
  # (Vorgabe 0 = kein Deckel; ein Deckel kostet Dekodierrate), siehe den exec-Zweig.
  case "${WB_MLX_SERVER_APC_POOL_GB:-0}" in
    ''|*[!0-9.]*|.*|*.*.*)
      echo "wb-mlx-server: WB_MLX_SERVER_APC_POOL_GB='${WB_MLX_SERVER_APC_POOL_GB:-}' ist ungueltig -- erlaubt ist eine Zahl in GiB, 0 schaltet den Deckel ab." >&2
      exit 2 ;;
  esac
  # apc_aktiv/model_discovery_ok/MLX_VLM_BIN/MLX_VLM_VERSION/MLX_VLM_AB_070:
  # von der mlx-vlm-Ausfuehrbarkeitspruefung weiter unten gesetzt, hier nur
  # vorab deklariert (lokal, wie der Rest dieser Funktion).
  local apc_aktiv=0 model_discovery_ok=0
  local MLX_VLM_BIN="" MLX_VLM_VERSION="" MLX_VLM_AB_070=0
  # NACHTRAG 12 (2026-08-21): der Weg des MENSCHEN an der Buchung vorbei. Er ist
  # bewusst NUR eine Befehlszeilenoption und ausdruecklich KEINE Umgebungsvariable
  # (anders als WB_MLX_SERVER_OHNE_BELEGUNG daneben, das jeder Agent beilaeufig
  # setzen kann): wb-belegung misst hinter dieser Option mit `wb-mensch`, wer
  # wirklich ruft, und lehnt einen Agenten ab. Weitergereicht wird sie unveraendert,
  # entschieden wird dort.
  local auf_eigene_gefahr=0
  # --vorhersage-weg (Nachtrag 19, 2026-08-21): WELCHEN der in der Registry
  # hinterlegten Vorhersage-Wege dieser Start nehmen soll. Wirkt nur dort, wo
  # dieses Skript die Registry ohnehin selbst befragt -- also wenn der Aufrufer
  # KEINE WB_MLX_SERVER_VORHERSAGE_BAUART gesetzt hat. Die Sitzungen gehen
  # weiterhin ueber die Umgebungsvariablen (wb-code hat den Weg dort schon
  # gewaehlt); diese Option ist der Weg fuer einen Menschen am Terminal und
  # fuer ein Skript, das denselben Start nachstellen will.
  local vorhersage_weg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --auf-eigene-gefahr) auf_eigene_gefahr=1; shift ;;
      --vorhersage-weg)
        if [ -z "${2:-}" ]; then echo "wb-mlx-server: --vorhersage-weg braucht die id eines Weges" >&2; exit 2; fi
        vorhersage_weg="$2"; shift 2 ;;
      --kontext)
        case "${2:-}" in
          ''|*[!0-9]*) echo "wb-mlx-server: --kontext braucht Token als Zahl" >&2; exit 2 ;;
        esac
        kontext_arg="$2"; shift 2 ;;
      --frist)
        case "${2:-}" in
          ''|*[!0-9]*) echo "wb-mlx-server: --frist braucht Minuten als Zahl" >&2; exit 2 ;;
        esac
        frist_min="$2"; shift 2 ;;
      --parallel)
        case "${2:-}" in
          ''|*[!0-9]*|0) echo "wb-mlx-server: --parallel braucht eine Zahl ab 1" >&2; exit 2 ;;
        esac
        parallel_arg="$2"; shift 2 ;;
      --apc)
        # Nachtrag 2026-09-08, VIERTE RUNDE, Auftrag (C): APC (Automatic
        # Prefix Cache) existiert erst ab mlx-vlm 0.7.0 und wirkt NUR auf den
        # Motor mlx-vlm -- ausserhalb davon wirkungslos, siehe apc_aktiv weiter
        # unten fuer die Versionspruefung. WB_MLX_SERVER_APC=1 ist derselbe
        # Schalter fuer wb-code/pi-worker, die keine eigene Befehlszeilenoption
        # an 'ensure' durchreichen (Muster wie WB_MLX_SERVER_DECODE_PARALLEL).
        apc_gewuenscht=1; shift ;;
      --*) echo "wb-mlx-server: unbekannte Option '$1'" >&2; exit 2 ;;
      *)
        if [ -n "$eingabe" ]; then echo "wb-mlx-server: nur ein Modell je Aufruf" >&2; exit 2; fi
        eingabe="$1"; shift ;;
    esac
  done
  # Nachtrag 6: Nebenlaeufigkeit ist die Entscheidung des Aufrufers, Vorgabe
  # 1 -- siehe Kopfkommentar "NACHTRAG 6" fuer das eigene A/B, das diese
  # Vorgabe traegt. Ein gegebenes --parallel setzt Decode- UND
  # Prompt-Concurrency gleichermassen (der Regelfall); ohne den Schalter
  # bleibt der tiefere Notausgang ueber die beiden separaten
  # Umgebungsvariablen erhalten, fuer den seltenen Fall asymmetrischen
  # Tunens. $parallel (= decode_conc) ist die Zahl, die an Kontextempfehlung
  # UND Buchung weitergeht -- Decode-Concurrency, nicht Prompt-Concurrency,
  # weil sie die tatsaechlich gleichzeitig DEKODIERENDEN Sequenzen zaehlt.
  local decode_conc="${parallel_arg:-$DECODE_PARALLEL_VORGABE}"
  local prompt_conc="${parallel_arg:-$PROMPT_PARALLEL_VORGABE}"
  local parallel="$decode_conc"

  # OHNE ANGABE: zuletzt gewaehltes Modell, ersatzweise die Werkbank-Vorgabe
  # (siehe Kopfkommentar "OHNE ANGABE" -- das ist der Weg fuer
  # wb-modell-proxy, dessen ensureCmd keine Datei lesen kann).
  if [ -z "$eingabe" ]; then
    eingabe="$(aktuell_modell_lesen)"
    if [ -z "$eingabe" ]; then
      eingabe="$WB_MLX_SERVER_VORGABE"
      err "kein Modell angegeben und keine vorherige Wahl gemerkt — verwende die Werkbank-Vorgabe '$eingabe'."
    else
      err "kein Modell angegeben — verwende das zuletzt gewaehlte ($eingabe)."
    fi
  fi

  # ZUERST aufraeumen, dann rechnen (Nachtrag 18): eine Karteileiche oder eine
  # verwaiste Belegung wuerde sonst in jede Zahl weiter unten eingehen und den
  # Start gegen sich selbst blockieren.
  kennung_aufraeumen

  resolve_modell "$eingabe" || return 1
  local MODEL_PATH="$RES_PATH"
  # NACHTRAG 2026-09-08, Auftrag "buchung", Kleinkram-Befund "HF_HUB_CACHE mkdir
  # ohne Erfolgspruefung, Leerheit ungeprueft": die ganze Isolation gegen einen
  # ECHTEN, moeglicherweise fremdbelegten HF-Cache (siehe HF_HUB_CACHE_LEER oben)
  # setzt voraus, dass dieses Verzeichnis wirklich existiert UND leer ist -- ein
  # stillschweigend gescheitertes mkdir oder ein Verzeichnis, in das zwischenzeitlich
  # doch etwas geschrieben wurde, hebelt die Isolation lautlos aus. Beides bricht
  # den Start NICHT ab (dieselbe Haltung wie ueberall in dieser Datei: eine
  # fehlende Bremse ist schlechter als keine, aber ein verhinderter Start ist es
  # auch), meldet sich aber laut.
  if ! mkdir -p "$HF_HUB_CACHE_LEER" 2>/dev/null; then
    err "WARNUNG: HF_HUB_CACHE-Verzeichnis liess sich nicht anlegen ($HF_HUB_CACHE_LEER) -- der Start laeuft trotzdem, aber OHNE die Isolation gegen einen fremdbelegten HF-Cache (siehe Kopfkommentar HF_HUB_CACHE)."
  elif [ -n "$(ls -A "$HF_HUB_CACHE_LEER" 2>/dev/null)" ]; then
    err "WARNUNG: HF_HUB_CACHE-Verzeichnis ist NICHT leer ($HF_HUB_CACHE_LEER) -- die Isolation gegen einen fremdbelegten HF-Cache gilt nur, solange es leer bleibt. Von Hand pruefen, was dort liegt."
  fi

  # MOTORWAHL (Nachtrag 7, siehe Kopfkommentar): der Aufrufer (wb-code/
  # pi-worker) hat die Registry (Feld `vorhersage`) UND seine eigene
  # Sitzungs-Einstellung bereits geprueft und reicht das Ergebnis als drei
  # Umgebungsvariablen durch -- dieses Skript verzweigt hier NACH BAUART,
  # nicht nach Modellname.
  local vorh_bauart="$VORHERSAGE_BAUART_VORGABE"
  local vorh_modell="$VORHERSAGE_MODELL_VORGABE"
  local vorh_gewichte_gb="$VORHERSAGE_GEWICHTE_GB_VORGABE"
  # draftKind/draftBlockSize (Nachtrag 22, siehe Kopfkommentar FUENFTER MOTOR):
  # nur gesetzt, wenn ein Aufrufer sie kennt (kuenftige wb-code/pi-worker-
  # Fassungen) ODER die Registry-Suche gleich unten sie liefert. Ein AELTERER
  # Aufrufer, der WB_MLX_SERVER_VORHERSAGE_BAUART/_MODELL schon selbst gesetzt
  # hat (VORHERSAGE_GENANNT=1) aber das neue Feld noch nicht kennt, bekommt
  # hier bewusst NICHTS nachgereicht -- er hat den Weg bereits gewaehlt, siehe
  # der Vorrang-Grundsatz oben ("die Umgebungsvariable behaelt den Vorrang").
  # Leer heisst dann: derselbe alte mlx-dspark-Weg wie vor diesem Nachtrag.
  local vorh_draftkind="$VORHERSAGE_DRAFTKIND_VORGABE"
  local vorh_draftblocksize="$VORHERSAGE_DRAFTBLOCKSIZE_VORGABE"
  # DIE REGISTRY ANTWORTET, WENN NIEMAND GEFRAGT WURDE (Nachtrag 15, 2026-08-21).
  # Bis heute las dieses Skript `vorhersage` gar nicht; es verliess sich darauf,
  # dass wb-code/pi-worker es tun. Fuer JEDEN anderen Aufrufer -- ein Mensch am
  # Terminal, der Orchestrator, ein Skript -- lief damit ein ANDERER Motor als in
  # einer Sitzung: `wb-mlx-server ensure qwen38 --kontext 262144` startete
  # mlx_lm.server statt mtplx, buchte dessen bf16-KV (16,0 statt 8,5 GiB) und
  # dessen Prompt-Cache (4,7 GiB) und wurde mit 40,0 GiB abgelehnt, waehrend
  # dasselbe Modell ueber eine Sitzung mit 32,5 GiB durchgekommen waere -- zwei
  # Antworten auf dieselbe Frage, je nachdem wer fragt (gemeldet vom Orchestrator
  # am 21.08.). Dasselbe Argument, mit dem `buendelung` schon aus der Registry
  # gelesen wird: WELCHER Motor ein Modell fahren kann, ist eine Eigenschaft des
  # Modells; OB er gewaehlt wird, bleibt Sache des Aufrufs. Die Umgebungsvariable
  # behaelt deshalb den Vorrang -- nachgeschlagen wird nur, wenn sie GAR NICHT
  # gesetzt ist.
  #
  # MEHRERE WEGE ZUR WAHL (Nachtrag 19, 2026-08-21): die Registry fuehrt seit
  # heute unter `vorhersage.wege` mehrere gemessene Moeglichkeiten je Modell
  # (fuer qwen38-27b: der eingebaute MTPLX-Kopf und zwei externe Entwerfer).
  # Ohne --vorhersage-weg gilt weiter der Vorgabeweg, und der ist derselbe wie
  # die Felder auf oberster Ebene -- der Aufruf ohne Option verhaelt sich also
  # genau wie vor dem 21.08.
  if [ "$VORHERSAGE_GENANNT" -eq 0 ]; then
    local reg_bauart reg_modell reg_gewichte reg_label reg_warnung reg_felder reg_draftkind reg_draftblocksize
    reg_felder="$(vorhersage_weg_waehlen "$vorhersage_weg")"
    reg_bauart="$(printf '%s' "$reg_felder" | cut -f1)"
    reg_modell="$(printf '%s' "$reg_felder" | cut -f2)"
    reg_gewichte="$(printf '%s' "$reg_felder" | cut -f3)"
    reg_label="$(printf '%s' "$reg_felder" | cut -f4)"
    reg_warnung="$(printf '%s' "$reg_felder" | cut -f5)"
    reg_draftkind="$(printf '%s' "$reg_felder" | cut -f6)"
    reg_draftblocksize="$(printf '%s' "$reg_felder" | cut -f7)"
    [ -n "$reg_warnung" ] && err "$reg_warnung"
    if [ -n "$reg_bauart" ] && [ -n "$reg_modell" ]; then
      vorh_bauart="$reg_bauart"; vorh_modell="$reg_modell"; vorh_gewichte_gb="$reg_gewichte"
      vorh_draftkind="$reg_draftkind"; vorh_draftblocksize="$reg_draftblocksize"
      err "Vorhersage aus der Registry uebernommen (bauart=$reg_bauart, Koerper '$reg_modell'${reg_label:+, Weg '$reg_label'}${reg_draftkind:+, draftKind=$reg_draftkind}) -- der Aufrufer hat WB_MLX_SERVER_VORHERSAGE_BAUART nicht gesetzt. Wer sie ausdruecklich NICHT will, setzt die Variable leer."
    elif [ -n "$vorhersage_weg" ]; then
      err "--vorhersage-weg '$vorhersage_weg' laeuft ins Leere: fuer '${RES_ID:-$MODEL_PATH}' fuehrt die Registry ueberhaupt keine Vorhersage. Der Server startet ohne."
    fi
  elif [ -n "$vorhersage_weg" ]; then
    err "--vorhersage-weg '$vorhersage_weg' wird nicht beachtet: der Aufrufer hat WB_MLX_SERVER_VORHERSAGE_BAUART schon gesetzt und damit den Weg bereits gewaehlt."
  fi
  local motor="mlx-lm"

  # BUENDELUNGSMOTOR (Nachtrag 10, siehe Kopfkommentar): welcher Motor dieses
  # Modell buendelt, sobald mehrere Stroeme verlangt sind. Die Angabe kommt
  # aus der Registry (Feld `buendelung`, von resolve_modell gelesen), nicht
  # aus einem Schalter -- WARUM, weil die Frage danach zerfaellt:
  #
  #   Ob ein Modell ueberhaupt unter vllm-metal laufen KANN, ist eine
  #   Eigenschaft des MODELLS: sein Ordner muss vom Metal-Plugin ladbar sein,
  #   sein Speicherbudget muss zu einer Fraktion passen, seine Kurve
  #   bestimmt, ab wann sich der Wechsel lohnt. Genau solche Aussagen stehen
  #   in der Registry, neben gewichteGb und chatTemplateArgs.
  #
  #   OB er jetzt gewaehlt wird, ist eine Eigenschaft des AUFRUFS: wie viele
  #   Stroeme laufen gleich? Diese Zahl kommt seit NACHTRAG 6 als --parallel
  #   hier an und braucht keinen zweiten Schalter.
  #
  # Damit erreicht der Orchestrator den zweiten Motor OHNE Handarbeit: er
  # sagt weiterhin nur, wie viele Worker er fahren will, und dieses Skript
  # waehlt. Ein eigener Schalter haette ihn gezwungen, die Messkurve im Kopf
  # zu haben; ein weiteres Feld unter `vorhersage` waere schlicht falsch --
  # vllm-metal kann fuer dieses Modell nachweislich KEINE Vorhersage (siehe
  # Kopfkommentar), ein Motor ohne Vorhersage unter einem Feld namens
  # `vorhersage` waere eine Unwahrheit in den Daten, kein Kompromiss.
  local buendel_motor="" buendel_fraktion="" buendel_venv="" buendel_bin=""
  local vllm_umschlagpunkt="$VLLM_UMSCHLAGPUNKT_STROEME"
  if [ "$(buendelung_feld motor)" = "vllm-metal" ]; then
    buendel_venv="$(buendelung_feld venv)"
    buendel_fraktion="$(buendelung_feld metalFraktion)"
    local reg_umschlag; reg_umschlag="$(buendelung_feld umschlagpunktStroeme)"
    case "$reg_umschlag" in ''|*[!0-9]*) : ;; *) vllm_umschlagpunkt="$reg_umschlag" ;; esac
    if [ -z "$buendel_fraktion" ]; then
      err "Registry-Feld buendelung.motor=vllm-metal ohne metalFraktion -- ohne Fraktion gibt es keine Buchung (siehe METAL_ARBEITSSATZ_GIB in wb-belegung), also auch keinen Start ueber diesen Motor. Bleibt beim bisherigen Weg."
    elif [ -n "$buendel_venv" ] && [ -x "$buendel_venv/bin/vllm" ]; then
      buendel_bin="$buendel_venv/bin/vllm"
      buendel_motor="vllm-metal"
    elif command -v vllm >/dev/null 2>&1; then
      # Kein venv in der Registry oder das genannte fehlt: ein vllm im PATH
      # zaehlt weiterhin. Laut gesagt, nicht stillschweigend -- welches
      # Werkzeug wirklich startet, soll nachlesbar sein.
      buendel_bin="$(command -v vllm)"
      buendel_motor="vllm-metal"
      err "Registry nennt fuer den Buendelungsmotor kein brauchbares venv (buendelung.venv='${buendel_venv:-fehlt}') -- verwende stattdessen '$buendel_bin' aus dem PATH."
    else
      err "Registry weist fuer '${RES_ID:-$MODEL_PATH}' den Buendelungsmotor vllm-metal aus, aber weder '${buendel_venv:-<kein venv genannt>}/bin/vllm' noch ein vllm im PATH ist ausfuehrbar -- bleibt beim bisherigen Weg (MTPLX bzw. mlx_lm.server)."
    fi
  fi

  # Der WIRKSAME Umschlagpunkt fuer die Vorhersage-Weiche weiter unten. Steht
  # vllm-metal bereit, gilt dessen gemessene Schwelle (zwei), sonst die alte
  # gegen mlx_lm.server (drei) -- die Herleitung beider Zahlen steht bei
  # VLLM_UMSCHLAGPUNKT_STROEME.
  local umschlagpunkt="$MTPLX_UMSCHLAGPUNKT_STROEME"
  if [ -n "$buendel_motor" ]; then
    umschlagpunkt="$vllm_umschlagpunkt"
  fi

  # vergleich_entwerfer: der Pfad, gegen den der "laeuft schon dasselbe"-
  # Vergleich weiter unten den LEBENDEN --draft-model/--drafter-Wert haelt
  # (siehe laufender_draft_pfad). NUR beim Entwerfer-Motor gesetzt -- beim
  # eingebauten MTP-Kopf (Nachtrag 8) IST vorh_modell der --model-Pfad selbst
  # (MODEL_PATH wird unten darauf umgebogen), kein separater Prozess-Schalter
  # traegt ihn also je, ein Vergleich dagegen waere immer falsch negativ.
  local vergleich_entwerfer=""
  if [ "$vorh_bauart" = "entwerfer" ]; then
    if [ -z "$vorh_modell" ]; then
      err "WB_MLX_SERVER_VORHERSAGE_BAUART=entwerfer gesetzt, aber WB_MLX_SERVER_VORHERSAGE_MODELL fehlt -- kein Entwerferpfad, kein Start mit Vorhersage. Laeuft als gewoehnliches Modell weiter."
      vorh_bauart=""
    elif [ -n "$vorh_draftkind" ]; then
      # FUENFTER MOTOR (Nachtrag 22, 2026-08-27) -- mlx_vlm.server. Waehlt sich
      # NUR fuer einen Entwerfer-Weg, der eine Bauart nennt (draftKind aus der
      # Registry): mlx_vlm kennt `--draft-kind {dflash,eagle3,mtp}` ausdruecklich
      # -- unterscheidet also die Bauart des Entwerfers, was mlx-dspark nicht
      # tut (dort nur "auto" gegen "--mode dflash", siehe dspark_ist_dflash_
      # entwerfer). Ein Weg OHNE draftKind (dspark-diminfer, Modelltyp
      # Qwen3DSparkModel, den mlx_vlm nicht kennt) bleibt beim mlx-dspark-Zweig
      # oben.
      #
      # GEMESSEN, und zwar zweimal. Zuerst am Server allein (gleicher Prompt,
      # ruhige Maschine, Tok/s kalt/warm): MTP-Kopf 24,19/21,70, MTPLX
      # 22,92/18,69, DFlash2 21,83/20,55, DSpark 18,98 kalt. Diese Zahlen sind
      # die Obergrenze, nicht der Alltag -- ein Worker erreicht sie nicht.
      #
      # Danach ueber ECHTE Worker, jeder frisch gespawnt, zwei gleich grosse
      # Schreibauftraege (der erste kalt, der zweite warm im selben Gespraech),
      # 2026-08-27:
      #
      #   Weg              Zusatz    Tok/s kalt/warm   Wanduhr kalt/warm
      #   mtp-kopf         0,25 GB   19,1 / 20,3       256 s / 245 s
      #   mtplx           19,83 GB   22,3 / 22,8       394 s / 315 s
      #   dflash2          3,58 GB   17,6 / --          306 s / --
      #   dspark-diminfer  3,46 GB   -- (kein Zaehler) 381 s / 345 s
      #
      # Der Sieger ist der MTP-Kopf, aber NICHT wegen der hoechsten Tok/s --
      # die hat MTPLX. MTPLX braucht fuer dieselbe Aufgabe rund doppelt so
      # viele Token (7438 statt 3487 im kalten, 6065 statt 3291 im warmen Lauf)
      # und ist damit trotz hoeherer Rate in der WANDUHR langsamer, bei
      # 19,83 statt 0,25 GB Zusatzgewicht. Wer Worker vergleicht, misst die
      # Zeit bis zum fertigen Ergebnis, nicht die Token pro Sekunde.
      #
      # Zwei Luecken, offen: dflash2 hat keinen warmen Wert (der zweite Auftrag
      # lief zweimal in "Error: 400 status code (no body)"), und mlx-dspark
      # protokolliert ueberhaupt keine Rate, dort steht nur die Wanduhr.
      motor="mlx-vlm"
      vergleich_entwerfer="$vorh_modell"
      err "Vorhersage aktiv: '${RES_ID:-$MODEL_PATH}' startet ueber mlx_vlm.server mit Entwerfer '$vorh_modell' (--draft-kind $vorh_draftkind${vorh_draftblocksize:+, --draft-block-size $vorh_draftblocksize}) -- UEBER ECHTE WORKER GEMESSEN 19,1/20,3 Tok/s kalt/warm fuer den MTP-Kopf. MTPLX erreicht zwar 22,3/22,8 Tok/s, braucht aber rund doppelt so viele Token fuer dieselbe Aufgabe und ist in der Wanduhr langsamer (315 s statt 245 s warm), bei 19,83 statt 0,25 GB Zusatzgewicht."
      err "LUECKE, ungelöst: mlx_vlm.server hat KEIN Gegenstueck zu --chat-template-args/--reasoning-effort (siehe --help) -- die Denkstufen-Falle (Qwen3.8 ohne gesetzten reasoning_effort waehlt xhigh, siehe Kopfkommentar 'DENKSTUFEN-FALLE') ist auf diesem Motor NICHT geschlossen. --enable-thinking/--thinking-budget sind ein anderer Mechanismus (Ein/Aus plus Token-Deckel, keine Stufe 'low'/'xhigh')."
      if [ "$parallel" -gt 1 ]; then
        err "Vorhersage mit --parallel $parallel ueber mlx_vlm.server: GEMESSEN am 01.09.2026 (300 Token je Strom, gleiche Laenge erzwungen, Tok/s gesamt / je Strom) -- 1: 20,2/20,2  2: 32,1/16,0  3: 31,2/10,5  4: 30,8/7,7. Der Gewinn sitzt bei ZWEI Stroemen (+59 % gesamt), darueber bleibt die Gesamtrate stehen. Dafuer faellt --kv-bits weg (siehe Meldung beim Start), der KV-Cache kostet also das Doppelte."
      fi
    else
      motor="mlx-dspark"
      vergleich_entwerfer="$vorh_modell"
      err "Vorhersage aktiv: '${RES_ID:-$MODEL_PATH}' startet ueber mlx-dspark mit Entwerfer '$vorh_modell' -- NICHT ueber mlx_lm.server/--draft-model, das ist fuer diese Architektur (qwen3_5-Hybrid, ArraysCache in den rekurrenten Lagen) nachweislich unmoeglich (speculative_generate_step() verlangt einen trimmbaren Cache, siehe mlx_lm/generate.py:530-532 und Ergebnis 20260820-010951.md). mlx-dspark bedient dieselbe Architektur mit einer eigenen, mlx_lm-unabhaengigen Implementierung."
      if [ "$parallel" -gt 1 ]; then
        # --parallel bedeutet fuer mlx-dspark "N gleichzeitig vorgehaltene
        # Worker-Praefixe" (--prefix-cache-slots), NICHT gleichzeitige
        # Dekodierung -- siehe Kopfkommentar Nachtrag 7. Reine Information,
        # KEIN Klemmen: anders als beim alten mlx_lm-Weg gibt es hier keinen
        # Grund, die Zahl kleinzurechnen.
        err "Vorhersage mit --parallel $parallel: mlx-dspark haelt $parallel Worker-Praefixe gleichzeitig vor (--prefix-cache-slots), dekodiert dabei weiterhin NUR EINEN nach dem anderen -- keine gleichzeitige Stapelverarbeitung fuer diese Architektur, mit oder ohne Entwerfer."
      fi
    fi
  elif [ "$vorh_bauart" = "eingebaut" ]; then
    if [ -z "$vorh_modell" ]; then
      err "WB_MLX_SERVER_VORHERSAGE_BAUART=eingebaut gesetzt, aber WB_MLX_SERVER_VORHERSAGE_MODELL fehlt -- kein Modellkoerper-Pfad, kein Start mit Vorhersage. Laeuft als gewoehnliches Modell weiter."
      vorh_bauart=""
    elif [ "$parallel" -ge "$umschlagpunkt" ]; then
      # MOTORWAHL (NACHTRAG 9, siehe Kopfkommentar bei
      # MTPLX_UMSCHLAGPUNKT_STROEME oben) -- ab der Schwelle faehrt der
      # Server die Buendelung OHNE Vorhersage: MODEL_PATH bleibt der
      # gewoehnliche Koerper (RES_PATH, unveraendert), motor bleibt "mlx-lm",
      # vorh_bauart wird geleert (kein vorh_gewichte_gb-Buchungsposten fuer
      # einen Koerper, der gar nicht startet). decode_conc/prompt_conc/
      # parallel bleiben die vom Aufrufer verlangte Zahl -- genau das ist der
      # Sinn: echte Buendelung mit voller Stromzahl.
      err "Motorwahl: $parallel Stroeme angefordert, Umschlagpunkt liegt bei $umschlagpunkt -- Server faehrt Buendelung OHNE Vorhersage. GEMESSEN bei 4 Stroemen: Buendelung 51,5 Tok/s gesamt / 12,9 je Worker gegen MTPLX 30,2 / 7,6 -- Buendelung klar vorn, MTPLX waechst mit der Stromzahl praktisch nicht. Welcher Buendelungsmotor das wird, entscheidet der Block gleich darunter."
      vorh_bauart=""
    else
      motor="mtplx"
      # Der Modellkoerper TRAEGT den MTP-Kopf schon (eine Datei, ein --model,
      # kein zweiter --drafter-Pfad wie beim Entwerfer-Motor) -- siehe
      # Kopfkommentar NACHTRAG 8. MODEL_PATH wird deshalb hier ERSETZT, nicht
      # ergaenzt; alles darunter (Speicherpruefung, Verzeichnis-Check,
      # Gewichts-Ermittlung, Buchung, Start) sieht danach nur noch den
      # MTPLX-Pfad.
      MODEL_PATH="$vorh_modell"
      if [ "$parallel" -gt 1 ]; then
        # Bündelung UND Vorhersage gibt es fuer diese Architektur endgueltig
        # nicht (GEMESSEN, Worker "nebenlauf", 2026-08-20): mtplx serve
        # --scheduler-mode mtp_batch stellt sieben Bedingungen nacheinander
        # (depth=1, max-active-requests=8, decode-batch-max=8,
        # context-window=131072, ...) und scheitert nach ALLEN sieben
        # erfuellten immer noch architekturbedingt an
        # "QwenRowOwnedRouterConfigError: A3B row-owned router config
        # requires the exact A3B model topology" -- kein weiterer Schalter
        # behebt das. Anders als beim mlx-dspark-Entwerfer oben ist das
        # deshalb KEIN informativer Hinweis, sondern ein echtes Klemmen: der
        # Server WAEHLT MTPLX hier trotzdem (unter dem Umschlagpunkt, siehe
        # oben, gemessen noch vorn), klemmt aber die fuer Buchung/Kontext
        # gezaehlte Stromzahl auf 1, weil mtplx bietet fuer diese Architektur
        # keine mit --prefix-cache-slots vergleichbare, GEMESSENE Zahl
        # gleichzeitig vorgehaltener Praefixe.
        err "Motorwahl: $parallel Stroeme angefordert, Umschlagpunkt liegt bei $umschlagpunkt -- Server bleibt bei MTPLX (GEMESSEN: bei $parallel Stroemen noch vorn oder gleichauf gegen Buendelung). mtplx bleibt bei --scheduler-mode serial (mtp_batch scheitert architekturbedingt, siehe Kommentar) -- $parallel wird fuer Buchung/Kontext auf 1 geklemmt."
        parallel=1; decode_conc=1; prompt_conc=1
      fi
      err "Vorhersage aktiv (eingebaut): '${RES_ID:-$MODEL_PATH}' startet ueber mtplx serve (natives MTP, eigener Motor -- kein mlx_lm.server/mlx-dspark im Spiel) mit dem Modellkoerper '$vorh_modell', --scheduler-mode fest 'serial'. GEMESSEN (Worker 'nebenlauf', 2026-08-20, qwen38-27b/MTPLX Speed 4bit): 31,5 Tok/s kurz, 35,8 Tok/s warm bei 4737 Prompt-Token, 48/50 auf pruef3 in 392s gegen 718s ohne alles -- schneller UND gleiche Guete wie der Hausgrundwert."
    fi
  fi
  # VIERTER MOTOR (Nachtrag 10): steht vllm-metal fuer dieses Modell bereit und
  # ist nach der Weiche oben KEIN Vorhersage-Motor mehr im Spiel (motor noch
  # "mlx-lm"), dann uebernimmt es die Buendelung ab dem Umschlagpunkt. Es
  # loest damit mlx_lm.server als Buendelungsmotor ab, nicht MTPLX: MTPLX
  # bleibt unangetastet der Motor UNTER dem Umschlagpunkt (dort ist es mit
  # 31,5 gegen 17,22 Tok/s fast doppelt so schnell), und es ist der Standard.
  local deckel=""
  if [ "$motor" = "mlx-lm" ] && [ -n "$buendel_motor" ] && [ "$parallel" -ge "$vllm_umschlagpunkt" ]; then
    motor="vllm-metal"
    deckel="$(deckel_waehlen "$parallel")"
    err "Motorwahl: $parallel Stroeme -- Server buendelt ueber vllm-metal ('$buendel_bin'), nicht ueber mlx_lm.server. GEMESSEN (Worker 'nebenlauf', 2026-08-20, qwen38-27b, Gesamtdurchsatz): vllm-metal liegt auf JEDER Stufe vorn -- 17,22/32,63/53,81/59,44/66,68 Tok/s bei 1/2/4/8/16 Stroemen gegen 16,44/30,49/51,99/54,56/63,52 bei mlx_lm.server. Rein buendelnd, ohne Vorhersage: die ist bei diesem Motor fuer dieses Modell auf allen drei Wegen ausgeschlossen (siehe Kopfkommentar NACHTRAG 10)."
    if [ "$deckel" != "$parallel" ]; then
      err "Deckel: --max-num-seqs $deckel statt $parallel -- gemessen sind nur acht und sechzehn, dazwischen ist nichts belegt (siehe VLLM_DECKEL_UNTEN)."
    fi
    if [ "$parallel" -gt "$VLLM_DECKEL_UNTEN" ] && [ "$parallel" -lt "$VLLM_DECKEL_OBEN" ]; then
      # Die verlangte Stromzahl bleibt unangetastet (siehe VLLM_DECKEL_UNTEN,
      # Folgerung 2) -- aber wer in dieses Tal faehrt, soll wissen, dass er
      # drin ist.
      err "WARNUNG: $parallel Stroeme liegen im gemessenen Tal zwischen acht und sechzehn -- bei ZWOELF fiel der Gesamtdurchsatz auf 52,89 Tok/s zurueck, gegen 59,44 bei ACHT und 66,68 bei SECHZEHN. Derselbe Knick stand schon in der mlx-Tabelle (50,51 bei zwoelf). Acht Stroeme schaffen gemessen MEHR Arbeit als zwoelf; die verlangte Zahl wird trotzdem gefahren und gebucht, weil das die Entscheidung des Aufrufers ist."
    fi
  fi

  # vorh_gewichte_gb wird gebraucht: beim Entwerfer-Motor fuer den
  # SEPARATEN Entwerfer-Gewichtsposten (siehe Gewichts-Ermittlung unten),
  # beim eingebauten Motor (mtplx) als registry_wert fuer den KOERPER selbst
  # (MODEL_PATH == vorh_modell) -- NUR ohne jede Vorhersage (bauart weder
  # entwerfer noch eingebaut) ist der Wert bedeutungslos und wird geleert.
  if [ "$vorh_bauart" != "entwerfer" ] && [ "$vorh_bauart" != "eingebaut" ]; then
    vorh_gewichte_gb=""
  fi

  local kontext="$kontext_arg" kontext_automatisch=0
  if [ -z "$kontext" ]; then
    # NIE das Modell-Maximum stillschweigend nehmen (Kopfkommentar "OHNE
    # --kontext") -- wb-kontext empfehlung, sonst der alte Festwert 18432.
    kontext="$(kontext_vorgabe_ermitteln "${RES_ID:-$MODEL_PATH}" "$parallel")"
    kontext_automatisch=1
  fi

  local pid; pid="$(find_pid)"
  if [ -n "$pid" ] && is_ours "$pid"; then
    local laufend laufender_draft; laufend="$(laufendes_modell "$pid")"
    laufender_draft="$(laufender_draft_pfad "$pid")"
    # Gleichheit heisst SELBER Zielpfad UND selber Entwerferzustand -- zwei
    # Registry-Eintraege koennen denselben modelRef mit und ohne Entwerfer
    # tragen (z.B. qwen38-27b und qwen38-27b-dflash2); ein reiner Pfad-
    # vergleich haette diese beiden faelschlich fuer dasselbe gehalten.
    #
    # UND SELBE KONTEXTSTUFE (Nachtrag 21.08.2026, GEMESSEN am echten
    # Doppelstart): bis hierher fehlte dieser vierte Vergleich komplett --
    # ein Aufruf mit demselben Modell, aber anderem --kontext, nahm den
    # Kurzschluss und verlaengerte nur die Frist der ALTEN Buchung, ohne den
    # neuen, groesseren Kontext je zu buchen oder (bei mtplx/vllm-metal, die
    # ihn als echten Serverschalter kennen) den Server je neu zu starten --
    # "dieselbe Bauart, anderes Fenster, ein Wechsel ist dafuer noetig und
    # richtig" (Auftrag), aber der Kurzschluss verhinderte genau das. Siehe
    # laufender_kontext() fuer die Herleitung je Motor.
    if [ "$laufend" = "$MODEL_PATH" ] && [ "$laufender_draft" = "$vergleich_entwerfer" ] \
       && [ "$(laufender_motor "$pid")" = "$motor" ] \
       && [ "$(laufender_kontext "$pid" "$laufend")" = "$kontext" ]; then
      # KAPAZITAET, NICHT NUR IDENTITAET (Nachtrag 2026-09-08, siehe
      # kapazitaet_pruefen() weiter oben fuer den gemessenen Anlass): dieselbe
      # Bauart, derselbe Pfad, derselbe Kontext heisst noch nicht, dass noch
      # PLATZ fuer einen weiteren gleichzeitigen Strom ist. Traegt der
      # Server nicht mehr, faellt dieser Zweig NICHT in "kein Start noetig",
      # sondern faellt durch in den Neustart-Pfad weiter unten -- mit
      # decode_conc/prompt_conc/parallel schon auf die noetige Zahl angehoben.
      local kap_basisname; kap_basisname="$(basename "$MODEL_PATH")"
      local kap_zeile kap_ausreichend kap_benoetigt kap_laufend
      kap_zeile="$(kapazitaet_pruefen "$pid" "$kap_basisname" "$parallel_arg")"
      kap_ausreichend="${kap_zeile%% *}"
      kap_zeile="${kap_zeile#* }"
      kap_benoetigt="${kap_zeile%% *}"
      kap_laufend="${kap_zeile#* }"
      if [ "$kap_ausreichend" != ja ]; then
        # EIGENER ZWEIG, NICHT DER "ANDERES MODELL LAEUFT"-PFAD (Gegenleser-
        # Befund Punkt 9): derselbe Pfad haette B4 gegen ein Modell geprueft,
        # das mit dem angeforderten IDENTISCH ist ("es laeuft 'X', angefordert
        # 'X'"), und im Erfolgsfall den ALTEN Server VOR jeder neuen Buchung
        # gestoppt (Punkt 11: kein Rollback, wenn die groessere Buchung dann
        # abgelehnt wird). Stattdessen: KAPAZITAETS_NEUSTART=1 setzt den
        # ganzen "Anderes Modell laeuft"-Block (B4, frueher Stopp) weiter unten
        # ausdruecklich AUSSER KRAFT (siehe die Bedingung dort) -- der Ablauf
        # geht direkt in die normale Motor-/Gewichte-Berechnung weiter, GENAU
        # WIE BEI EINEM KALTSTART fuer dieses Modell, nur mit hoeherem
        # --parallel. Gestoppt wird der alte Server ($pid, gemerkt als
        # KAPAZITAETS_ALTER_PID) ERST NACH einer erfolgreichen neuen Buchung
        # (siehe dort, direkt nach belegung_nehmen()) -- schlaegt die Buchung
        # fehl, bleibt der alte Server unangetastet stehen, kein Rollback
        # noetig, weil nie etwas zerstoert wurde.
        err "'$eingabe' laeuft (PID $pid, --parallel $kap_laufend), traegt aber keinen weiteren Strom mehr -- $kap_benoetigt Stroeme sind jetzt noetig (gebuchte Sequenzen + diese neue). Kapazitaets-Neustart versucht (der alte Server bleibt bis zu einer bestaetigten neuen Buchung unangetastet), rund eine Minute."
        decode_conc="$kap_benoetigt"; prompt_conc="$kap_benoetigt"; parallel="$kap_benoetigt"
        KAPAZITAETS_NEUSTART=1
        KAPAZITAETS_ALTER_PID="$pid"
        # Befund 2: jetzt einfangen, VOR jeder weiteren Buchung -- siehe die
        # Deklaration oben.
        [ -f "$KENNUNG_DATEI" ] && KAPAZITAETS_ALTE_KENNUNG="$(tr -d '[:space:]' < "$KENNUNG_DATEI" 2>/dev/null)"
      else
      echo "wb-mlx-server: '$eingabe' laeuft bereits (PID $pid) — kein Start noetig." >&2
      # Auf stdout, nicht stderr: das ist die Auskunft an den Aufrufer, nicht eine
      # Meldung an den Menschen. Dieselbe Bauart wie `wb-kontext ensure` mit
      # seiner provider=-Zeile. Sie kommt auf BEIDEN Wegen -- auch wenn nichts
      # gestartet wurde, braucht der Aufrufer den Namen.
      printf 'modell=%s\n' "$(bedienter_modellname "$motor" "$MODEL_PATH")"
      # Die PID des Servers, aus demselben Grund auf stdout: der Aufrufer
      # braucht sie, um den EIGENTUEMER dieses abgeloesten Prozesses spaeter
      # umzuschreiben (wb-nohup umschreiben, 2026-08-21). Ohne sie muesste
      # `wb-code` den Prozessbaum raten.
      printf 'pid=%s\n' "$pid"
      # Frist der bestehenden Belegung nachziehen (Befund B2, 16.08.2026 --
      # siehe Kopfkommentar): ohne das bliebe eine kuerzere alte Frist stehen,
      # waehrend ein laengerer Lauf sie laengst haette verlaengern wollen.
      local wbb kennung
      wbb="$(belegung_bin)"
      if [ -n "$wbb" ] && [ -f "$KENNUNG_DATEI" ]; then
        kennung="$(tr -d '[:space:]' < "$KENNUNG_DATEI" 2>/dev/null)"
        if [ -n "$kennung" ]; then
          if "$wbb" verlaengern "$kennung" --frist "$frist_min" >/dev/null 2>&1; then
            err "Belegung $kennung auf $frist_min Minuten verlaengert."
          else
            err "WARNUNG: Belegung $kennung liess sich nicht verlaengern — bei einem langen Lauf kann sie verfallen."
          fi
        fi
      fi
      return 0
      fi
    fi
    # NUR fuer den EIGENTLICHEN Modellwechsel, NICHT fuer einen Kapazitaets-
    # Neustart (Gegenleser-Befund Punkt 9): KAPAZITAETS_NEUSTART=1 wurde oben
    # bereits gesetzt und ueberspringt B4 samt dem fruehen Stopp hier ganz --
    # der eigentliche Stopp fuer diesen Fall folgt weiter unten, ERST nach
    # einer erfolgreichen neuen Buchung (Punkt 11, Rollback-Sicherheit).
    if [ "$KAPAZITAETS_NEUSTART" -ne 1 ]; then
    # Anderes Modell laeuft: BEVOR es beendet wird, EINE Sperre pruefen
    # (Pruefer-Befund B4, 19.08.2026) -- die zweite, B11, stand hier bis zum
    # 21.08.2026 und ist jetzt entfernt; die Begruendung steht im naechsten
    # Kommentarblock, gleich nach B4.
    #
    # B4 -- haelt gerade ein lebender Worker dieses laufende Modell? Einzige
    # verfuegbare Quelle: der tmux-Tag @wb_lokal_provider, den pi-worker NUR
    # setzt, wenn $PIPROVIDER EXAKT "mlx-lokal" war (nicht "mlx-lokal-64k"
    # o.ae. -- fuer qwen3.8 mit explizitem --kontext, dem heutigen Regelfall,
    # meist NICHT der Fall). Bewusste Entscheidung fuer die einfachere von
    # zwei recherchierten Varianten (die andere: zusaetzlich wb-states
    # sessions/*.json kreuzpruefen -- robuster, aber deutlich mehr neuer,
    # unter Zeitdruck ungetesteter Code): diese Pruefung erkennt NICHT jeden
    # aktiven Worker. Bekannte Luecken, offen benannt statt verschwiegen: kein
    # Tag bei einer Kontextstufen-Variante des Providernamens, kein Tag bei
    # wb-code-Orchestrator-Panes, kein Tag bei nackten curl/API-Aufrufen oder
    # Remote/SSH-Panes, kein Loeschpfad bei abgestuerzten Panes (bleibt bis
    # das Pane selbst weg ist), keine Aussage ueber eine Anfrage GERADE in
    # Flug. Der Tag traegt zudem nur das Literal "mlx-lokal", NIE einen Namen
    # oder Pfad -- eine Nennung "wer genau es haelt" ist damit technisch nicht
    # moeglich, nur eine Anzahl.
    local aktive_panes
    aktive_panes="$(tmux list-panes -a -F '#{@wb_lokal_provider} #{pane_dead}' 2>/dev/null \
      | awk '$1=="mlx-lokal" && $2=="0"' | wc -l | tr -d ' ')"
    if [ -n "$aktive_panes" ] && [ "$aktive_panes" -gt 0 ] 2>/dev/null; then
      err "Modellwechsel ABGELEHNT: $aktive_panes lebende(s) Pane(s) mit @wb_lokal_provider=mlx-lokal gefunden — es laeuft '$laufend', angefordert ist '$MODEL_PATH'. Ein Wechsel wuerde diesem/diesen Worker(n) den Server unter den Fuessen wegziehen (Pruefer-Befund B4). Bekannte Grenze dieser Pruefung: der Tag traegt kein Sitzungsname und keine Kontextstufen-Variante — welche(s) Pane(s) genau, laesst sich damit nicht sagen, nur die Anzahl."
      return 1
    fi

    # B11 STAND HIER (19.08.2026), ENTFERNT AM 21.08.2026 -- GEMESSENER
    # Riegel, kein Schoenheitsfehler (Orchestrator, 05:07 Uhr): eine
    # Speicherpruefung VOR dem Beenden fragt "ist genug frei, WAEHREND das
    # Alte noch resident ist" -- eine Frage, die bei jedem grossen Modell
    # IMMER mit "nein" beantwortet wird, weil genau der Speicher, der gleich
    # freiwerden wuerde, hier noch als belegt zaehlt. Gemessen: ein Wechsel
    # von Kontext 18432 auf 131072 DESSELBEN Koerpers
    # (Qwen3.8-27B-MTPLX-Optimized-Speed, ~21 GiB resident) scheiterte damit
    # zweimal hintereinander, identisch -- "nur 15122 MiB frei ... Wechsel
    # abgebrochen, '...' bleibt UNVERAENDERT stehen" -- OHNE je zu versuchen,
    # das Alte zu beenden. Ein Wechsel konnte damit nie stattfinden, sobald
    # einmal ein grosses Modell lief; der einzige Ausweg war, von Hand zu
    # beenden.
    #
    # DIE VORSICHT SELBST BLEIBT, NUR DIE REIHENFOLGE WAR FALSCH (Kernel-
    # Panik 2026-08-11, siehe
    # ~/Knowledge/10-global/incident-2026-08-11-kernel-panik-durch-gpu-speichermangel.md).
    # Statt einer zweiten, vorzeitigen Pruefung hier gilt jetzt: erst
    # beenden (B4 ist schon geprueft), DANACH real MESSEN, ob der Speicher
    # wirklich zurueckkam -- keine Schaetzung aus RSS + aktuell-frei. Eine
    # Schaetzung waere selbst wieder eine Annahme, und genau davor warnt
    # derselbe Vorfallsbericht: "Der freie Speicher unmittelbar nach einer
    # Stufe ist unbrauchbar, weil MLX seine Puffer verzoegert zurueckgibt.
    # Eine Stufe wurde mit 735 MiB frei uebersprungen, waehrend eine Minute
    # spaeter wieder 14,2 GiB frei waren." Die schon vorhandene Pruefung
    # weiter unten (bisher nur fuer den reinen Kaltstart gedacht) leistet
    # das bereits: sie laeuft nach dem Beenden, gegen den echten, gerade
    # gemessenen Wert, und deckt damit BEIDE Faelle aus dem Vorfall vom
    # 11.08. ab, an derselben Stelle, mit derselben Schwelle
    # (MIN_FREE_MIB):
    #   1) ein Wechsel, bei dem der neue Koerper nach dem Freiwerden des
    #      alten immer noch nicht hineinpasst -- der hier gemessene, akute
    #      Fall.
    #   2) ein ZUSAETZLICHES grosses Modell NEBEN dem gerade laufenden bzw.
    #      neben einem anderen Speicherverbraucher -- der urspruengliche
    #      Vorfall vom 11.08.: kein Wechsel hier im Spiel, aber der Speicher
    #      reicht trotzdem nicht fuer einen sauberen Start.
    # Scheitert diese Pruefung, weil der Speicher trotz beendetem Alten immer
    # noch nicht reicht (Fall 4 aus dem Testauftrag: Beenden gelingt, aber
    # der Speicher kommt nicht zurueck), bricht der Start ab wie bisher --
    # optimistisch weitermachen waere genau die Annahme, die hier vermieden
    # werden soll.
    #
    # DAS FENSTER, DAS DADURCH ENTSTEHT: zwischen dem erfolgreichen Beenden
    # und einem erfolgreichen Neustart laeuft kurzzeitig GAR KEIN Server.
    # Das war schon VOR diesem Fix so -- ein Wechsel beendet immer erst und
    # startet dann, sequenziell, und keine Sperre umschliesst den ganzen
    # `ensure`-Aufruf gegen einen zweiten, gleichzeitigen Aufruf (weder vorher
    # noch jetzt). Dieser Fix oeffnet das Fenster also nicht neu; er macht es
    # sogar eher kleiner, weil der alte, fehlerhafte Riegel den Wechsel bisher
    # oft ganz verhinderte und zum manuellen Beenden-dann-neu-Anfordern
    # zwang -- mit demselben Fenster, nur unkoordiniert statt in einem
    # Aufruf. Eine echte Sperre um den gesamten Ablauf gibt es fuer
    # `wb-mlx-server ensure` weiterhin nicht; das ist ein bestehendes, von
    # diesem Fix unabhaengiges Thema (siehe OPEN im Ergebnisprotokoll
    # 20260821-050634.md).
    #
    # SCHEITERT DER NEUSTART NACH DEM BEENDEN -- an dieser Pruefung oder an
    # einem der Schritte danach (Motor fehlt, Verzeichnis fehlt, der Prozess
    # startet nicht, die Probeanfrage schlaegt fehl) -- hat die Maschine
    # DANACH KEINEN mlx-lokal-Server mehr, wo eben noch einer lief. Das darf
    # nicht still passieren: die Zeile gleich nach dem Beenden macht das
    # BEVOR irgendein Startschritt versucht wird sichtbar, einmalig und
    # unabhaengig davon, WELCHER der folgenden Schritte am Ende scheitert --
    # jeder von ihnen druckt ohnehin schon seine eigene Fehlermeldung
    # (`err "wb-nohup konnte ... nicht starten"`, `"Server antwortet ...
    # nicht auf /health"` usw.), nur den Verlust des vorherigen Servers
    # nannte bisher keine von ihnen.
    echo "wb-mlx-server: es laeuft '$laufend', angefordert ist '$MODEL_PATH' — beende das laufende Modell zuerst." >&2
    _stop_pruefen_und_beenden "$pid" || return 1
    err "WICHTIG: '$laufend' ist jetzt beendet — bis der angeforderte Start ('$MODEL_PATH') gelingt, laeuft KEIN mlx-lokal-Server mehr. Scheitert der Start, bleibt das so; die naechste Fehlermeldung nennt den Grund."
    fi
  elif [ -n "$pid" ]; then
    err "Port $PORT ist belegt, aber von keinem der fuenf bekannten Motoren (mlx_lm.server, mlx-dspark, mtplx, vllm, mlx_vlm.server) -- PID $pid. Kein Start."
