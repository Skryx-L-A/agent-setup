# Speicher anders nimmt: es rechnet sich beim Start EIN Budget aus
# (VLLM_METAL_MEMORY_FRACTION mal Metals max_recommended_working_set_size, auf
# diesem Geraet 42,0 GiB) und haelt es fuer die ganze Laufzeit, unabhaengig von
# Stroemen und Kontext. Gebucht wird deshalb genau dieses Budget, ueber
# `wb-belegung nimm --metal-fraktion <f>` statt ueber Gewichte + KV + Zuschlag
# -- die Herleitung, der Messbeleg (Fraktion 0,5 hielt den ganzen Prozess unter
# 21 GiB) und die wired_limit-Warnung stehen bei METAL_ARBEITSSATZ_GIB in
# wb-belegung.
#
# WARUM DIE FRAKTION UEBER DIE UMGEBUNGSVARIABLE UND NICHT UEBER
# `--gpu-memory-utilization` GESETZT WIRD, obwohl der Schalter auf der
# Kommandozeile sichtbar waere und die Variable nicht (`ps -E` zeigt sie unter
# heutigem macOS fuer eigene Prozesse nicht): beides ist NICHT dasselbe.
# `VLLM_METAL_MEMORY_FRACTION=auto` plus `--gpu-memory-utilization 0.5` ergibt
# im KV-Budget zwar denselben Wert (cache_policy.py:1314-1342, Vorrangregel 2),
# schaltet aber `MetalConfig.is_auto_memory` um -- und in diesem Zustand meldet
# `platform.py:88-109` dem Motor den VOLLEN Speicher der Maschine statt des
# Anteils. Das waere ein anderer Lauf als der gemessene. Die gemessene Fassung
# gilt; wo die Zahl trotzdem nachlesbar bleiben muss, steht sie in der Buchung
# (`wb-belegung wer` nennt Fraktion und Budget im Klartext).
#
# `--kontext` ERREICHT BEI DIESEM MOTOR ZUM ERSTEN MAL EINEN ECHTEN
# SERVERSCHALTER: vllm-metal kennt `--max-model-len`, mlx_lm.server kennt
# nichts Vergleichbares (siehe "WARUM ES KEINEN --context-SCHALTER GIBT" oben).
# Der Wert, der bisher nur die Buchung gepraegt hat, begrenzt hier also
# wirklich das Fenster. Reicht vllms eigenes KV-Budget nicht fuer alle Stroeme
# gleichzeitig, stellt es Anfragen in die Warteschlange, statt zu scheitern --
# solange EINE Sequenz voller Laenge hineinpasst.
#
# DIE DENKSTUFEN-FALLE GILT HIER GENAUSO, und sie ist genauso geschlossen:
# vllm-metal nimmt `--default-chat-template-kwargs` als serverseitige Vorgabe
# und verschmilzt sie mit dem, was eine Anfrage selbst mitbringt
# (cli_args.py:93-95) -- dieselbe Rolle wie `--chat-template-args` bei
# mlx_lm.server. Dasselbe Registry-Feld `chatTemplateArgs` wird deshalb auch
# hier durchgereicht. Ohne das stuende Qwen3.8s eigene Vorlage auf xhigh, und
# eine einzelne Anfrage kann dann ueber 28 Minuten brauchen.

set -uo pipefail

PORT=8081
BASEURL="http://127.0.0.1:$PORT"
NAME="wb-mlx-server"
LOG="$HOME/.local/state/wb-nohup/logs/$NAME.log"
MODELSFILE="${WB_MODELS_FILE:-$HOME/.claude/workbench/models.json}"
STATEDIR="$HOME/.local/state/wb-mlx-server"
KENNUNG_DATEI="$STATEDIR/belegung-kennung"
AKTUELL_DATEI="$STATEDIR/aktuell.json"

# Nebenlaeufigkeit — seit NACHTRAG 6 (siehe Kopfkommentar) die ENTSCHEIDUNG
# des Aufrufers, nicht mehr eine feste Serverkonstante. Vorgabe 1 -- ein
# einzelner Orchestrator fragt einzeln, nicht zu viert (eigenes A/B siehe
# Kopfkommentar). `ensure --parallel <n>` (siehe cmd_ensure) ueberschreibt
# diese Vorgabe je Aufruf; ohne den Schalter gelten die Umgebungsvariablen
# als tieferliegender Notausgang, mit demselben alten Vorgabewert nur, wenn
# EXPLIZIT gesetzt (kein stiller Rueckfall auf 4 mehr).
DECODE_PARALLEL_VORGABE=${WB_MLX_SERVER_DECODE_PARALLEL:-1}
PROMPT_PARALLEL_VORGABE=${WB_MLX_SERVER_PROMPT_PARALLEL:-$DECODE_PARALLEL_VORGABE}

# Vorhersage (NACHTRAG 7, siehe Kopfkommentar) -- die ENTSCHEIDUNG, ob dieser
# Start einen Entwerfer/Motorwechsel bekommt, ist Sache des AUFRUFERS
# (`wb-code`/`pi-worker`, andere Spuren): sie lesen die Registry (Feld
# `vorhersage`) UND die Sitzungs-Einstellung selbst und reichen das Ergebnis
# hier durch. Leer heisst: gewoehnlicher Start, wie schon immer.
VORHERSAGE_BAUART_VORGABE="${WB_MLX_SERVER_VORHERSAGE_BAUART:-}"
VORHERSAGE_MODELL_VORGABE="${WB_MLX_SERVER_VORHERSAGE_MODELL:-}"
VORHERSAGE_GEWICHTE_GB_VORGABE="${WB_MLX_SERVER_VORHERSAGE_GEWICHTE_GB:-}"
# GESETZT-UND-LEER ist etwas anderes als GAR NICHT GESETZT (Nachtrag 15,
# 2026-08-21). wb-code und pi-worker setzen die Variable IMMER -- leer, wenn die
# Sitzungs-Einstellung die Vorhersage ausdruecklich abschaltet. Wer sie gar nicht
# setzt, hat nichts dazu gesagt; fuer den darf die Registry antworten (siehe den
# Motorwahl-Block in cmd_ensure). Ohne diese Unterscheidung gaebe es nur die Wahl
# zwischen "eine abgeschaltete Vorhersage wieder anschalten" und "einen direkten
# Aufruf anders fahren lassen als eine Sitzung", und beides ist falsch.
VORHERSAGE_GENANNT=0
[ -n "${WB_MLX_SERVER_VORHERSAGE_BAUART+gesetzt}" ] && VORHERSAGE_GENANNT=1

# MOTORWAHL nach Stromzahl (NACHTRAG 9, siehe Kopfkommentar) -- GEMESSEN,
# Worker "nebenlauf", 2026-08-20, qwen38-27b, Gesamtdurchsatz Tok/s je
# angeforderter Stromzahl (Motorwahl-Kandidaten: MTPLX = eingebaute
# Vorhersage, serial; Buendelung = mlx_lm.server ohne Vorhersage):
#   1 Strom:  MTPLX 31,5  vs. Buendelung 16,3   (je Worker: 31,5 vs. 16,3)
#   2 Stroeme: MTPLX 31,3  vs. Buendelung 30,6  (je Worker: 15,7 vs. 15,3)
#   4 Stroeme: MTPLX 30,2  vs. Buendelung 51,5  (je Worker: 7,6 vs. 12,9)
# MTPLX bleibt intern seriell (siehe unten) -- Gesamtdurchsatz waechst mit
# der Stromzahl praktisch nicht (31,5 -> 31,3 -> 30,2), Buendelung dagegen
# naeherungsweise linear. Bei zwei Stroemen liegt MTPLX sowohl gesamt
# (31,3>30,6) als auch je Worker (15,7>15,3) noch knapp vorn, wenn auch nur
# noch knapp -- der Umschlagpunkt liegt zwischen zwei und drei. Schwelle
# deshalb bei drei gezogen: WB_MLX_SERVER_MTPLX_UMSCHLAGPUNKT Stroeme oder
# mehr fahren die Buendelung OHNE Vorhersage, darunter bleibt es MTPLX.
MTPLX_UMSCHLAGPUNKT_STROEME=${WB_MLX_SERVER_MTPLX_UMSCHLAGPUNKT:-3}

# UMSCHLAGPUNKT FUER DEN VIERTEN MOTOR (Nachtrag 10) -- AUSGERECHNET, nicht
# gewaehlt. Die Frage lautet: ab wie vielen Stroemen schlaegt vllm-metals
# Buendelung MTPLXs Vorhersage? Beide Kurven stehen im Kopfkommentar; hier die
# Rechnung.
#
# MTPLX bleibt intern seriell -- sein GESAMTdurchsatz waechst mit der
# Stromzahl praktisch nicht (31,5 / 31,3 / 30,2 Tok/s bei 1 / 2 / 4 Stroemen,
# NACHTRAG 9). Fuer die Rechnung ist er also eine waagerechte Linie bei rund
# 31 Tok/s. vllm-metal waechst dagegen naeherungsweise linear: 17,22 bei einem
# Strom, 32,63 bei zweien, also +15,41 Tok/s je zusaetzlichem Strom in genau
# diesem Abschnitt. Die beiden Linien schneiden sich bei
#
#   n = 1 + (31 - 17,22) / 15,41 = 1,89 Stroeme
#
# Der erste GANZZAHLIGE Wert darueber ist zwei -- und bei zwei ist es keine
# Rechnung mehr, sondern gemessen: 32,63 gegen 31,3 Tok/s gesamt (+4,3 %) und
# 16,32 gegen 15,65 Tok/s je Worker (ebenfalls +4,3 %). vllm-metal liegt bei
# zwei Stroemen also auf BEIDEN Achsen vorn, wenn auch knapp. Schwelle deshalb
# bei zwei.
#
# WARUM MTPLX_UMSCHLAGPUNKT_STROEME trotzdem bei DREI bleibt und nicht
# mitgezogen wird: das ist die Schwelle gegen mlx_lm.server, und die ist eine
# andere Rechnung. mlx_lm.server erreicht bei zwei Stroemen nur 30,49 Tok/s
# gesamt und 15,25 je Worker -- beides UNTER MTPLX. Wo vllm-metal fehlt (kein
# Registry-Eintrag `buendelung`, kein venv), bleibt MTPLX bei zwei Stroemen
# also weiterhin die bessere Wahl, und erst ab drei lohnt der Wechsel. Zwei
# Motoren, zwei Messungen, zwei Schwellen -- eine gemeinsame Zahl waere fuer
# einen der beiden Faelle falsch.
#
# NACHGEMESSEN AM 21.08.2026, beide Motoren selbst gefahren (Worker "motor",
# derselbe Ablauf mess-nebenlauf.py, 200 Token je Anfrage, temperature 0,
# --kontext 2048, je ein frisch gestarteter Server ueber `wb-mlx-server ensure`,
# Gesamtdurchsatz Tok/s):
#   Stroeme        1       2       4
#   MTPLX      28,63   30,57   29,65
#   vllm-metal 17,25   32,59   54,47
# Dieselbe Aussage wie oben, aus eigenen Zahlen: MTPLX bleibt waagerecht,
# vllm-metal steigt, und der Wechsel faellt zwischen einen und zwei Stroeme.
# Derselbe Schnittpunkt, unabhaengig nachgerechnet: 1 + (30,57 - 17,25) / 15,34
# = 1,87 -- ganzzahlig also wieder zwei, wo vllm-metal mit 32,59 gegen 30,57
# gesamt und 16,30 gegen 15,29 je Worker vorn liegt. Bei vier Stroemen ist der
# Abstand kein Feinschliff mehr: 54,47 gegen 29,65, also fast das Doppelte.
#
# Ueberschreibbar je Aufruf (WB_MLX_SERVER_VLLM_UMSCHLAGPUNKT) und je Modell
# (Registry-Feld buendelung.umschlagpunktStroeme) -- die Zahl oben ist an
# qwen38-27b gemessen, ein anderes Modell kann eine andere Kurve haben.
VLLM_UMSCHLAGPUNKT_STROEME=${WB_MLX_SERVER_VLLM_UMSCHLAGPUNKT:-2}

# DIE FALLE, DIE IN DERSELBEN TABELLE STEHT (Nachtrag 10): bei ZWOELF Stroemen
# faellt vllm-metal auf 52,89 Tok/s zurueck -- unter die 59,44 bei ACHT und
# sogar unter die 53,81 bei VIER --, bevor es bei sechzehn auf 66,68 springt.
# Derselbe Knick stand schon in der mlx-Tabelle (50,51 bei zwoelf gegen 54,56
# bei acht). Er haengt an der STROMZAHL, nicht am Deckel: die 52,89 wurden mit
# Deckel 16 gemessen, ein groesserer Deckel heilt ihn also nicht.
#
# Zwei getrennte Folgerungen daraus, die nicht verwechselt werden duerfen:
#   1. DER DECKEL (--max-num-seqs) gehoert NICHT zwischen acht und sechzehn --
#      gemessen sind nur diese beiden Werte, dazwischen ist nichts belegt.
#      deckel_waehlen() unten rastet deshalb auf acht bzw. sechzehn ein.
#   2. DIE STROMZAHL SELBST bleibt die Entscheidung des Aufrufers. Wer neun bis
#      fuenfzehn Stroeme verlangt, bekommt sie -- aber mit einer lauten
#      Warnung, dass acht Stroeme gemessen MEHR Gesamtdurchsatz liefern als
#      zwoelf. Ein stilles Zurechtbiegen der verlangten Stromzahl waere
#      schlimmer als der Verlust: der Aufrufer bucht und faehrt N Stroeme, und
#      dieses Werkzeug bucht seit NACHTRAG 6 genau, was ankommt.
VLLM_DECKEL_UNTEN=8
VLLM_DECKEL_OBEN=16

# Prompt-Cache-Plaetze fuer den motor=mlx-lm-Weg (Nachtrag 8, siehe
# Kopfkommentar "PROMPT-CACHE" und wb-belegungs eigener PROMPT_CACHE_GB_JE_PLATZ):
# mlx_lm.servers eigene LRUPromptCache haelt bis zu 10 Sequenzen vor, OHNE
# Byte-Grenze und OHNE dass irgendein bisheriger Aufrufer das gebucht haette
# -- Worker "nebenlauf" hat 10 volle Plaetze zu 0,47 GiB gemessen (siehe
# dort). 10 ist bewusst NICHT kleiner gewaehlt: es ist mlx_lm.servers eigene
# Vorgabe, --prompt-cache-size setzt sie hier nur explizit statt sie einer
# internen Konstante zu ueberlassen, die eine spaetere mlx-lm-Fassung
# stillschweigend aendern koennte -- die gebuchte Zahl bleibt so garantiert
# dieselbe wie die tatsaechlich laufende.
PROMPT_CACHE_PLAETZE=${WB_MLX_SERVER_PROMPT_CACHE_PLAETZE:-10}

# DER PROMPT-CACHE WIRD GEDECKELT, UND GEBUCHT WIRD DER DECKEL (Nachtrag 16,
# 2026-08-21). Bisher stand er mit 10 Plaetzen x 0,47 GiB = 4,7 GiB in jeder
# Buchung -- eine Hochrechnung aus einer Messung bei rund 1100 gecachten
# Prompt-Token je Sequenz, also eine ANNAHME darueber, wie gross die Plaetze im
# Betrieb werden. Ein Platz hat aber keine feste Groesse: er waechst mit der
# Laenge des Prompts, den er haelt. Gemessen am 21.08. an einem echten Lauf
# (mlx_lm.server, --log-level INFO): nach zwei Anfragen mit 6048 und 18048
# Prompt-Token meldete der Server "Prompt Cache: 6 sequences, 2.12 GB" -- bei
# 4,7 gebuchten. Vier Anfragen weiter waere er darueber gewesen.
#
# mlx_lm.server kennt `--prompt-cache-bytes` ("Maximum size in bytes of the KV
# caches"). Damit hoert der Posten auf, eine Schaetzung zu sein: der Deckel wird
# gesetzt UND in seiner Hoehe gebucht. Das ist in beide Richtungen ehrlicher --
# es bucht nicht mehr Luft, als der Cache nehmen darf, und nicht weniger, als er
# nehmen kann.
#
# 1 GiB als Deckel, gebucht mit 2,2 GiB: der Deckel wird gemessen um rund das
# Doppelte ueberschritten (bei 1 GiB Deckel meldete der Server "4 sequences,
# 2.28 GB", bei 2 GiB "6 sequences, 3.42 GB" -- die Herleitung des Faktors steht
# bei PROMPT_CACHE_DECKEL_FAKTOR in wb-belegung). Gegen die bisherigen 4,7 GiB
# aus zehn Plaetzen mal angenommener Platzgroesse spart das 2,5 GiB, und der Cache
# haelt dabei immer noch vier Praefixe zu je rund 6000 Token -- fuer eine Sitzung
# mit einem Aufrufer reichlich. Wer mehr will, setzt
# WB_MLX_SERVER_PROMPT_CACHE_GIB; gebucht wird dann eben der groessere Deckel.
#
# NUR FUER motor=mlx-lm. mtplx hat keine Entsprechung (`mtplx serve --help`,
# 2026-08-21: es gibt nur den SSD-Sitzungscache --ssd-session-cache*, der auf
# der Platte liegt und nicht im Speicher), mlx-dspark deckelt seinen Praefixcache
# ueber --prefix-cache-max-ram-mb, was hier bislang niemand setzt. Fuer beide
# bleibt der Posten wie bisher 0 -- eine ungemessene Zahl waere dort schlechter
# als keine.
PROMPT_CACHE_GIB=${WB_MLX_SERVER_PROMPT_CACHE_GIB:-1}

# QUANTISIERTER KV-CACHE (NACHTRAG 11, 2026-08-21) — die Hausregel stand schon,
# der Code hielt sie nicht ein.
#
# ~/.claude/regeln/lokale-modelle.md sagt seit dem 19.08.2026: "Der KV-Cache
# laeuft IMMER auf 8 Bit — bei jedem lokalen Modell, fuer Worker wie fuer den
# Orchestrator, GLEICH WELCHER WEG (MLX oder Ollama), mit der besten auf dem Mac
# verfuegbaren Quantisierung." der Nutzer hat das am 21.08. noch einmal
# ausdruecklich bestaetigt ("ok immer 8bit quantized kv cache fuer alle lokalen
# modelle, keine wiederrede so uebernehmen") -- es ist keine Abwaegung mehr.
#
# WELCHER MOTOR DEN SCHALTER HAT, gemessen an `--help` der installierten
# Fassungen, damit niemand die Regel fuer erfuellt haelt, wo sie es nicht ist:
#   mtplx           JA   `--paged-kv-quantization {off,q8,q4}`. Wird hier gesetzt.
#   mlx_lm.server   NEIN Die Fassung 0.31.3 kennt keinen KV-Quantisierungsschalter
#                        in `mlx_lm.server --help`. Wer diesen Motor faehrt, faehrt
#                        den Cache in der Modell-dtype (bf16) -- die Regel ist auf
#                        diesem Weg NICHT erfuellt, und die Buchung muss das wissen
#                        (deshalb geht KV_QUANT als --kv-quant an wb-belegung, siehe
#                        belegung_nehmen).
#   mlx-dspark      JA, ABER NICHT FUER DIESEN KOERPER. Der Schalter existiert
#                        (`--kv-bits {0,4,8}`, nachgesehen in `mlx-dspark serve --help`,
#                        2026-08-21) -- fuer die Hybridarchitektur von qwen3.8 lehnt der
#                        Motor ihn jedoch ab. AB DEM 21.08.2026 IST DAS GEMESSEN, nicht
#                        mehr eine Vermutung: der erste echte Start ueber diesen Motor
#                        brach ab mit "--kv-bits is unsupported for hybrid
#                        linear-attention targets (their recurrent-state caches are not
#                        KV caches; only 16 of 64 layers even hold KV). Run without
#                        --kv-bits." Bis dahin stand hier, ein lautes Nein sei die
#                        richtige Richtung -- das galt, solange der Zweig gar nicht lief.
#                        Seit die drei Vorhersage-Wege waehlbar sind, laeuft er, und ein
#                        lautes Nein hiesse: der gewaehlte Weg startet nie. Der Schalter
#                        wird fuer solche Koerper deshalb weggelassen (siehe
#                        dspark_ziel_ist_hybrid), der Cache laeuft dort unquantisiert,
#                        und die BUCHUNG bekommt genau diesen Wert (kv_quant_buchung
#                        "off") -- die Hausregel ist auf diesem Weg nicht erfuellt, aber
#                        nichts wird kleiner gebucht als gefahren, und gesagt wird es
#                        bei jedem Start.
#   vllm-metal      ENTFAELLT Der Motor teilt sich sein Speicherbudget vorab selbst
#                        zu (--metal-fraktion, siehe NACHTRAG 10); der KV-Cache liegt
#                        INNERHALB dieses Budgets. Eine KV-Quantisierung aendert dort
#                        nicht die gebuchte Zahl, sondern nur, wieviel Kontext in
#                        dasselbe Budget passt.
#
# Der SATZ, DER DIE REGEL ZWEI TAGE AUSSER KRAFT GESETZT HAT, steht in
# SESSION-STATE.md: "8-Bit-KV ist auf dem MLX-Weg nicht aktiv und waere ein
# Nullposten". Gemessen wurde er an mlx_lm.server und mlx-dspark — fuer mtplx galt
# er nie, und mtplx ist der Betriebsmotor fuer qwen38-27b.
KV_QUANT=${WB_MLX_SERVER_KV_QUANT:-q8}

# DIE PREFILL-SPITZE IST DER GROESSTE POSTEN BEI LANGEM KONTEXT (Nachtrag 17,
# 2026-08-21, gemessen). Ein mtplx-Server mit 19,83 GiB Gewichten erreichte je
# nach Prompt-Laenge diese Spitzen (phys_footprint_peak, je frischer Server, ein
# Strom, q8):
#
#   8147 Token   25,1 GiB      16247 Token  29,8 GiB
#  30647 Token   31,7 GiB      61263 Token  40,0 GiB
#
# Ueber alle vier Punkte rund 3,1 GiB Sockel plus 0,25 MiB je Prompt-Token --
# also ACHTMAL soviel wie der KV-Cache selbst (0,033 MiB/Token). Beim 61k-Lauf
# fiel der freie Speicher der ganzen Maschine auf 1815 MiB, keine 800 MiB ueber
# der Schwelle der Notbremse. Fortgeschrieben waere ein voller 256k-Prompt
# jenseits von allem, was diese Maschine hat.
#
# Das ist KEIN KV-Cache und kein Modellgewicht, sondern Zwischenergebnis: der
# Server rechnet den Prompt in Stuecken durch, und je groesser das Stueck, desto
# groesser die Zwischentensoren. `--prefill-chunk-tokens` begrenzt genau das.
# Kleiner heisst weniger Spitze und etwas langsamer; die Zahl unten ist die,
# die gemessen wurde (siehe Ergebnisbericht 20260821-031610).
#
# NUR mtplx kennt den Schalter. mlx_lm.server rechnet in festen 2048er-Stuecken
# (im Protokoll als "Prompt processing progress: 2048/6048" zu sehen) und hat
# keinen Schalter dafuer.
PREFILL_CHUNK_TOKENS=${WB_MLX_SERVER_PREFILL_CHUNK:-2048}

# Frist der Belegung in Minuten (Vorgabe wie grug-server: drei Stunden reichen
# fuer eine interaktive Sitzung, nicht fuer einen langen Lauf — siehe
# GRUG_SERVER_FRIST_MIN / lauf-fenster.sh).
BELEGUNG_FRIST_MIN_VORGABE=${WB_MLX_SERVER_FRIST_MIN:-180}

# Mindestfreier Speicher vor dem Start, in MiB (20 GB) — unveraendert scharf,
# siehe Kopfkommentar und
# ~/Knowledge/10-global/incident-2026-08-11-kernel-panik-durch-gpu-speichermangel.md.
# Eine abgelehnte Stufe wird NIE von Hand nachgefordert.
MIN_FREE_MIB=20480

# Werkbank-Vorgabe fuer lokale Arbeit, wenn `ensure` ohne <modell> aufgerufen
# wird UND kein zuletzt gewaehltes Modell in aktuell.json steht (siehe
# "OHNE ANGABE" oben). Stand 2026-08-19: qwen38 (Entscheidung des Nutzers,
# GEMEINSAME-FAKTEN.md Nachtrag). Ueberschreibbar, falls diese Vorgabe je
# wieder wechselt, ohne das Skript anzufassen.
WB_MLX_SERVER_VORGABE="${WB_MLX_SERVER_VORGABE:-qwen38}"

err() { printf 'wb-mlx-server: %s\n' "$*" >&2; }

# Alter, in grug-server bis 2026-08-19 erprobter Festwert (siehe Kopfkommentar
# "OHNE --kontext"). Letzter Rueckfall, wenn wb-kontext fehlt oder scheitert.
VORGABE_KONTEXT_ALT=18432

# Ermittelt den Kontext fuer 'ensure', wenn --kontext NICHT explizit gegeben
# wurde. NIE das Modell-Maximum als stille Vorgabe (Kopfkommentar). Gibt den
# gewaehlten Wert auf stdout aus, die Herkunft IMMER auf stderr -- auch im
# Fehlerfall, denn `$(...)` faengt nur stdout, wb-kontexts eigener HINWEIS
# (etwa "Sicherheitsboden nicht erreicht, kleinste Stufe trotzdem gewaehlt")
# laeuft unveraendert durch, weil hier NICHTS von wb-kontexts stderr
# umgeleitet wird.
kontext_vorgabe_ermitteln() {
  local kennung_oder_pfad="$1" parallel="$2"
  # --parallel <n> (Nachtrag 6): dieselbe Zahl, die auch gebucht und an
  # mlx_lm.server gereicht wird (siehe cmd_ensure) -- die Empfehlung soll
  # dieselbe Sequenzzahl meinen wie die tatsaechliche Buchung, sonst
  # empfiehlt wb-kontext einen anderen Kontext als der, fuer den tatsaechlich
  # gebucht wird.
  #
  # --denken (Pruefer-Befund B12): aus RES_CHAT_TEMPLATE_ARGS abgeleitet, der
  # Registry-Vorgabe fuer DIESES Modell (siehe resolve_modell, global gesetzt,
  # bevor diese Funktion aufgerufen wird). Fuer qwen38 steht dort fest
  # reasoning_effort=low -- das Modell denkt IMMER, die Empfehlung muss also
  # die zusaetzlichen Ausgabe-Token einrechnen. Kein Wert ableitbar (kein
  # chatTemplateArgs, z.B. grug) heisst KEIN --denken-Schalter -- dann
  # entscheidet wb-kontexts eigene Vorgabe (denken_vorgabe() dort), nicht
  # eine geratene Annahme hier.
  local denken; denken="$(chat_template_denken_wert)"
  if command -v wb-kontext >/dev/null 2>&1; then
    local wert rc
    set -- empfehlung "$kennung_oder_pfad" --parallel "$parallel"
    if [ -n "$denken" ]; then set -- "$@" --denken "$denken"; fi
    wert="$(wb-kontext "$@")"
    rc=$?
    case "$wert" in ''|*[!0-9]*) wert="" ;; esac
    if [ "$rc" -eq 0 ] && [ -n "$wert" ]; then
      err "Kontext: $wert Token (wb-kontext $*)."
      printf '%s' "$wert"
      return 0
    fi
    err "wb-kontext lieferte keinen brauchbaren Wert (Exit $rc) fuer '$kennung_oder_pfad' — falle auf den alten Festwert $VORGABE_KONTEXT_ALT zurueck."
  else
    err "wb-kontext nicht installiert — falle auf den alten Festwert $VORGABE_KONTEXT_ALT zurueck."
  fi
  err "Kontext: $VORGABE_KONTEXT_ALT Token (Vorgabe, wie bisher grug-servers BELEGUNG_KONTEXT bis 2026-08-19)."
  printf '%s' "$VORGABE_KONTEXT_ALT"
}

