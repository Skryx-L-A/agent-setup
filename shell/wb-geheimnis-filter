# Latenzverteilung (Dienstbetrieb, Auftrag filter-live 2026-10-10): je Groessenklasse der
# Anfrage ein Histogramm mit geometrischen Eimern (Faktor 1.25, 0.1 ms bis 30 min). Median
# und p90 werden als OBERE Eimergrenze gemeldet, also hoechstens 25 % zu hoch, nie zu niedrig.
GROESSENKLASSEN = ((32 * 1024, 'bis_32k'), (256 * 1024, 'bis_256k'), (1024 * 1024, 'bis_1m'),
                   (None, 'ueber_1m'))
EIMER_MS = []
_g = 0.1
while _g < 1800000:
    EIMER_MS.append(round(_g, 3))
    _g *= 1.25
EIMER_MS.append(float('inf'))
# Latenzarten: filter = Hinweg im Proxy (Koerper lesen, pruefen, ersetzen) bis zum Absenden;
# rueckweg = Rechenzeit des Rueckwegs ohne Warten auf den Anbieter; erstes_byte = bis die
# Antwortkoepfe des Anbieters da sind (enthaelt die Modellzeit, nur zur Einordnung).
LATENZARTEN = ('filter', 'rueckweg', 'erstes_byte')


def groessenklasse(n):
    for grenze, name in GROESSENKLASSEN:
        if grenze is None or n <= grenze:
            return name


def _eimer(ms):
    lo, hi = 0, len(EIMER_MS) - 1
    while lo < hi:
        mid = (lo + hi) // 2
        if ms <= EIMER_MS[mid]:
            hi = mid
        else:
            lo = mid + 1
    return lo


def quantil(eimer, q):
    n = sum(eimer)
    if not n:
        return None
    ziel, summe = q * n, 0
    for i, c in enumerate(eimer):
        summe += c
        if summe >= ziel:
            return EIMER_MS[i] if EIMER_MS[i] != float('inf') else None
    return None


def latenz_bild(latenz):
    """{klasse: {art: [eimer]}} -> {klasse: {art: {n, median_ms, p90_ms}}}"""
    aus = {}
    for klasse, arten in sorted(latenz.items()):
        for art, eimer in sorted(arten.items()):
            aus.setdefault(klasse, {})[art] = {'n': sum(eimer), 'median_ms': quantil(eimer, 0.5),
                                               'p90_ms': quantil(eimer, 0.9)}
    return aus


class Zaehler:
    def __init__(self):
        self._l = threading.Lock()
        self.werte = {}
        self.latenz = {}

    def plus(self, name, n=1):
        with self._l:
            self.werte[name] = self.werte.get(name, 0) + n

    def zeit(self, name, sek):
        with self._l:
            self.werte[name + '_ms_summe'] = round(self.werte.get(name + '_ms_summe', 0) + sek * 1000, 3)
            self.werte[name + '_ms_max'] = round(max(self.werte.get(name + '_ms_max', 0), sek * 1000), 3)

    def latenz_plus(self, klasse, art, sek):
        with self._l:
            eimer = self.latenz.setdefault(klasse, {}).setdefault(art, [0] * len(EIMER_MS))
            eimer[_eimer(sek * 1000)] += 1

    def bild(self):
        with self._l:
            return dict(self.werte)

    def roh(self):
        with self._l:
            return dict(self.werte), {k: {a: list(e) for a, e in v.items()} for k, v in self.latenz.items()}


# Zaehler, die nur einem Beleg gelten und nie in den Dauerbestand gehoeren.
NUR_LAUF = ('hinweg_wert', 'rueckweg_wert', 'sonde_vor_filter')


class Bestand:
    """Dauerhafte Zaehler seit einem festen Zeitpunkt (Datei zaehler.json im Zustandsordner,
    nur Zahlen). Der Prozess startet bei Zugriff und kann enden; die Summe ueber alle Laeufe
    bleibt. Geschrieben wird nach einer Anfrage hoechstens alle SPEICHERABSTAND Sekunden und
    beim Beenden -- kein eigener Zeitgeber. Ein Absturz verliert hoechstens dieses Fenster."""

    SPEICHERABSTAND = 30.0

    def __init__(self, ordner):
        self.pfad = os.path.join(ordner, 'zaehler.json') if ordner else None
        self._l = threading.Lock()
        self._zuletzt = 0.0
        self.seit = time.strftime('%Y-%m-%dT%H:%M:%S%z')
        self.zaehler, self.latenz = {}, {}
        if not self.pfad:
            return
        os.makedirs(ordner, mode=0o700, exist_ok=True)
        try:
            with open(self.pfad, encoding='utf-8') as f:
                d = json.load(f)
            if isinstance(d.get('seit'), str):
                self.seit = d['seit']
            self.zaehler = {k: v for k, v in (d.get('zaehler') or {}).items()
                            if isinstance(v, (int, float)) and k not in NUR_LAUF}
            for klasse, arten in (d.get('latenz') or {}).items():
                for art, eimer in (arten or {}).items():
                    if isinstance(eimer, list) and len(eimer) == len(EIMER_MS):
                        self.latenz.setdefault(klasse, {})[art] = [int(x) for x in eimer]
        except FileNotFoundError:
            pass
        except Exception:
            # Unlesbar: neu beginnen statt abstuerzen, die alte Datei bleibt daneben liegen.
            try:
                os.replace(self.pfad, self.pfad + '.unlesbar')
            except OSError:
                pass

    def summe(self, z):
        werte, latenz = z.roh()
        zs = dict(self.zaehler)
        for k, v in werte.items():
            if k in NUR_LAUF:
                continue
            zs[k] = max(zs.get(k, 0), v) if k.endswith('_ms_max') else round(zs.get(k, 0) + v, 3)
        ls = {k: {a: list(e) for a, e in v.items()} for k, v in self.latenz.items()}
        for klasse, arten in latenz.items():
            for art, eimer in arten.items():
                ziel = ls.setdefault(klasse, {}).setdefault(art, [0] * len(EIMER_MS))
                for i, c in enumerate(eimer):
                    ziel[i] += c
        return zs, ls

    def speichern(self, z, erzwingen=False):
        if not self.pfad:
            return
        jetzt = time.monotonic()
        with self._l:
            if not erzwingen and jetzt - self._zuletzt < self.SPEICHERABSTAND:
                return
            self._zuletzt = jetzt
            zs, ls = self.summe(z)
            tmp = '%s.%d.tmp' % (self.pfad, os.getpid())
            try:
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, 'w', encoding='utf-8') as f:
                    json.dump({'seit': self.seit, 'zaehler': zs, 'latenz': ls}, f, sort_keys=True)
                os.replace(tmp, self.pfad)
            except OSError:
                z.plus('zustand_schreibfehler')


