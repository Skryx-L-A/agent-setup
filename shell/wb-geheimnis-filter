def _lesbar(titel, werte, latenz):
    zeilen = ['%s' % titel,
              '  Anfragen %d, gefiltert %d, Ersetzungen %d, Aufloesungen %d'
              % (werte.get('anfragen', 0), werte.get('anfragen_gefiltert', 0),
                 werte.get('ersetzt', 0), werte.get('aufgeloest', 0))]
    fehler = {k: v for k, v in werte.items() if v and
              (k in FEHLERZAEHLER or k in ('client_abbruch', 'anfrage_ungueltig', 'upstream_stream_fehler',
                                         'dns_wiederholt', 'dns_aufgegeben') or
               k.startswith(('upstream_fehler_', 'upstream_versuch_', 'upstream_stream_fehler_',
                             'fehler_intern_', 'verbindungsfehler_', 'client_abbruch_')))}
    zeilen.append('  Fehler/Abweisungen: %s' % (', '.join('%s %d' % kv for kv in sorted(fehler.items()))
                                                if fehler else 'keine'))
    regeln = {k[len('neu_regel_'):]: v for k, v in werte.items() if k.startswith('neu_regel_')}
    if regeln:
        zeilen.append('  neu erkannte Werte je Regel: %s' % ', '.join('%s %d' % kv for kv in sorted(regeln.items())))
    for klasse in [k for _g, k in GROESSENKLASSEN if k in latenz]:
        teile = []
        for art in LATENZARTEN:
            q = latenz[klasse].get(art)
            if q and q['n']:
                teile.append('%s n=%d Median<=%s p90<=%s ms' % (art, q['n'], q['median_ms'], q['p90_ms']))
        zeilen.append('  %-9s %s' % (klasse, '; '.join(teile)))
    return '\n'.join(zeilen)


