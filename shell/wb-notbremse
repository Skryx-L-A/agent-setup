def prozessliste():
    try:
        p = subprocess.run(["/bin/ps", "-Ao", "pid=,rss=,command="],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return []
    zeilen = []
    for z in p.stdout.splitlines():
        teile = z.strip().split(None, 2)
        if len(teile) < 3:
            continue
        try:
            zeilen.append((int(teile[0]), int(teile[1]), teile[2]))
        except ValueError:
            continue
    return zeilen


def ps_fuer_pid(pid):
    """RSS und Kommandozeile fuer GENAU eine PID, oder None, wenn sie nicht
    (mehr) lebt oder nicht lesbar ist. Nachtrag 27.08.2026, fuer den
    --pid-Weg unten: ein gezielter Aufruf statt eines Scans der ganzen
    Prozesstabelle, O(1) statt O(alle Prozesse) -- gemessen rund 1,6 ms
    gegen rund 25 ms fuer prozessliste() auf dieser Maschine."""
    try:
        p = subprocess.run(["/bin/ps", "-o", "rss=,command=", "-p", str(pid)],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    zeile = p.stdout.strip("\n").strip()
    if not zeile:
        return None
    teile = zeile.split(None, 1)
    if len(teile) < 2:
        return None
    try:
        return int(teile[0]), teile[1]
    except ValueError:
        return None


def modelle(eigene_pid=None, ziel_pid=None):
    """Die lokalen Modellprozesse.

    MIT ziel_pid (Nachtrag 27.08.2026, der --pid-Weg): KEINE Musterjagd
    ueber die Maschine. Der Aufrufer (wb-mlx-server) kennt seine PID aus der
    eigenen Rueckgabe von `wb-nohup` und diese Funktion prueft nur, ob genau
    sie noch lebt -- die Lehre aus dem Haus: `pgrep -f` trifft auch den
    Agenten-Prompt, in dem der Suchbegriff zufaellig vorkommt; eine bekannte
    PID braucht dieses Risiko gar nicht erst einzugehen. Das TABU bleibt als
    Gegenprobe bestehen (schuetzt gegen eine PID, die seit dem Start durch
    einen Prozess-Neuvergabe-Zufall zu etwas anderem wurde); das MUSTER wird
    nur noch als Warnung protokolliert, wenn es NICHT passt -- ein Hinweis
    auf eine falsche PID beim Aufrufer -- verhindert das Beenden aber nicht:
    der Auftrag ist ausdruecklich, der PID zu vertrauen, nicht dem Muster.

    OHNE ziel_pid (Vorgabe, unveraendert): die weisse Liste ueber die ganze
    Prozesstabelle, fuer den musterbasierten Ernstfall (ein Modell, das am
    Buch vorbei gestartet wurde, siehe 'WOZU' im Kopfkommentar) und fuer
    'jetzt'/'pruefen'/'status' von Hand. Der eigene Prozess und die eigene
    Prozesskette bleiben aussen vor -- eine Bremse, die sich selbst beendet,
    waere zwar folgerichtig, aber unbrauchbar."""
    if ziel_pid:
        gefunden = ps_fuer_pid(ziel_pid)
        if gefunden is None:
            return []
        rss, cmd = gefunden
        if any(t.search(cmd) for t in TABU):
            protokollieren("Ziel-PID %d ist per TABU geschuetzt (%s) -- KEIN Eingriff, "
                           "auch nicht unter der Schwelle." % (ziel_pid, cmd[:160]))
            return []
        art = next((a for muster, a in MUSTER if muster.search(cmd)), None)
        if art is None:
            protokollieren("WARNUNG: Ziel-PID %d passt auf KEIN bekanntes Modell-Muster (%s) "
                           "-- wird trotzdem als Ziel behandelt, die PID gewinnt vor dem Muster."
                           % (ziel_pid, cmd[:160]))
            art = "ziel-pid (unbekanntes Muster)"
        return [{"pid": ziel_pid, "rss_mib": round(rss / 1024.0, 1),
                 "art": art, "kommando": cmd}]
    aus = []
    selbst = {os.getpid(), os.getppid()}
    if eigene_pid:
        selbst.add(eigene_pid)
    for pid, rss, cmd in prozessliste():
        if pid in selbst:
            continue
        # Der Zaun zuerst: was ausserhalb liegt, wird gar nicht erst betrachtet
        # (siehe ZAUN oben). Im Betrieb ist er nicht gesetzt und diese Zeile
        # folgenlos.
        if ZAUN is not None and not ZAUN.search(cmd):
            continue
        if any(t.search(cmd) for t in TABU):
            continue
        for muster, art in MUSTER:
            if muster.search(cmd):
                aus.append({"pid": pid, "rss_mib": round(rss / 1024.0, 1),
                            "art": art, "kommando": cmd})
                break
    return aus


def lebt(pid):
    try:
        os.kill(pid, 0)
    except OSError as e:
        return e.errno != errno.ESRCH
    return True


def beenden(procs):
    """SIGTERM, Frist, SIGKILL — und danach NACHSEHEN, nicht annehmen.
    Rueckgabe: Liste von (eintrag, weg_ja_nein, wie)."""
    ergebnis = []
    for e in procs:
        try:
            os.kill(e["pid"], signal.SIGTERM)
        except OSError:
            ergebnis.append((e, not lebt(e["pid"]), "war schon weg"))
            continue
        ende = time.time() + TERM_FRIST_S
        while time.time() < ende and lebt(e["pid"]):
            time.sleep(0.2)
        if not lebt(e["pid"]):
            ergebnis.append((e, True, "SIGTERM"))
            continue
        try:
            os.kill(e["pid"], signal.SIGKILL)
        except OSError:
            pass
        ende = time.time() + TERM_FRIST_S
        while time.time() < ende and lebt(e["pid"]):
            time.sleep(0.2)
        ergebnis.append((e, not lebt(e["pid"]), "SIGKILL" if not lebt(e["pid"]) else "UEBERLEBT"))
    return ergebnis


