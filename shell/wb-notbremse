# --------------------------------------------------------- freier Speicher

def frei_mib_streng():
    """Die STRENGE, konservative Formel -- der Rueckfall, wenn check-resources
    nicht erreichbar ist, siehe frei_mib_quelle() unten. Auf macOS: frei +
    inaktiv + spekulativ + freigebbar (dieselbe Formel, die check-resources
    selbst als `ram.free_strict_mib` fuehrt). Auf Linux gibt es keine zweite,
    grosszuegigere Fassung -- check-resources rechnet dort schon immer
    MemAvailable, direkt aus dem Kernel, und das ist zugleich die strengste
    verfuegbare Zahl; dieselbe Quelle wird hier nur ein zweites Mal gelesen.
    Gibt None zurueck, wenn nicht messbar -- und NICHT MESSBAR IST KEIN
    EINGRIFF: eine Bremse, die bei fehlender Messung zieht, wuerde beim ersten
    kaputten PATH alle Modelle beenden."""
    if sys.platform == "darwin":
        try:
            seite = int(subprocess.run(["/usr/sbin/sysctl", "-n", "hw.pagesize"],
                                       capture_output=True, text=True, timeout=5).stdout.strip())
            vms = subprocess.run(["/usr/bin/vm_stat"], capture_output=True,
                                 text=True, timeout=5).stdout
        except (OSError, ValueError, subprocess.SubprocessError):
            return None
        seiten = 0
        gefunden = 0
        for name in ("Pages free", "Pages inactive", "Pages speculative", "Pages purgeable"):
            m = re.search(re.escape(name) + r":\s*(\d+)", vms)
            if m:
                seiten += int(m.group(1))
                gefunden += 1
        if not gefunden:
            return None
        return seiten * seite / 1048576.0
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for zeile in f:
                if zeile.startswith("MemAvailable:"):
                    return float(zeile.split()[1]) / 1024.0
    except OSError:
        pass
    return None


def frei_mib_schnell():
    """(frei_mib oder None, quelle) -- dieselbe GROSSZUEGIGE Formel, die
    check-resources als `ram.free_mib` fuehrt (total - anonym - gewired -
    Kompressor), lokal nachgerechnet statt ueber den externen Aufruf.
    NEUER Nachtrag 27.08.2026, siehe Kopfkommentar fuer die volle Messung:
    diese Formel ist unter wachsendem anonymem Speicher (ein ladendes oder
    rechnendes Modell) NICHT nur schneller zu berechnen als
    frei_mib_streng(), sie liegt in genau diesem Fall auch NAEHER an der
    Wirklichkeit -- die strenge Formel zaehlt frisch belegten anonymen
    Speicher weder als frei noch als inaktiv und faellt deshalb sichtbar
    langsamer, als der Speicher wirklich schwindet (gemessen: -13829 MiB vs.
    -4270 MiB im selben 15,7-Sekunden-Fenster unter dem gleichen Test).

    Auf Linux identisch mit frei_mib_streng() (dort gibt es nur MemAvailable,
    keine zweite Formel) -- diese Funktion existiert dort nur, damit
    frei_mib_quelle() plattformunabhaengig eine Quelle zurueckbekommt.

    Scheitert die Messung selbst (vm_stat/sysctl fehlen, eine erwartete Zeile
    fehlt, oder das Ergebnis ist unsinnig -- negativ oder groesser als der
    Gesamtspeicher, ein Zeichen, dass macOS eine Zeile umbenannt hat), faellt
    diese Funktion auf frei_mib_streng() zurueck und sagt das in der Quelle
    dazu. None heisst 'nicht messbar', wie ueberall hier NIE 'unbegrenzt
    frei'."""
    if sys.platform != "darwin":
        wert = frei_mib_streng()
        return wert, ("streng (lokal, MemAvailable)" if wert is not None else None)
    try:
        seite = int(subprocess.run(["/usr/sbin/sysctl", "-n", "hw.pagesize"],
                                   capture_output=True, text=True, timeout=5).stdout.strip())
        gesamt = int(subprocess.run(["/usr/sbin/sysctl", "-n", "hw.memsize"],
                                    capture_output=True, text=True, timeout=5).stdout.strip())
        vms = subprocess.run(["/usr/bin/vm_stat"], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, ValueError, subprocess.SubprocessError):
        return frei_mib_streng(), "streng (lokal, Rueckfall -- vm_stat/sysctl fuer die schnelle Formel nicht lesbar)"
    anon = wired = kompr = 0
    gefunden = {"anon": False, "wired": False}
    for name, feld in (("Anonymous pages", "anon"), ("Pages wired down", "wired"),
                       ("Pages occupied by compressor", "kompr")):
        m = re.search(re.escape(name) + r":\s*(\d+)", vms)
        if not m:
            continue
        wert_seiten = int(m.group(1))
        if feld == "anon":
            anon = wert_seiten; gefunden["anon"] = True
        elif feld == "wired":
            wired = wert_seiten; gefunden["wired"] = True
        else:
            kompr = wert_seiten
    if not gefunden["anon"] or not gefunden["wired"]:
        return frei_mib_streng(), "streng (lokal, Rueckfall -- vm_stat lieferte keine Anonymous/Wired-Zeile)"
    gesamt_mib = gesamt / 1048576.0
    frei = gesamt_mib - (anon + wired + kompr) * seite / 1048576.0
    if frei < 0 or frei > gesamt_mib:
        return frei_mib_streng(), "streng (lokal, Rueckfall -- die schnelle Formel ergab einen unsinnigen Wert)"
    return frei, "schnell (lokal, grosszuegige Formel wie check-resources' ram.free_mib)"


