import errno
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".local", "state", "wb-notbremse")
PROTOKOLL = os.path.join(STATE_DIR, "protokoll.log")
PIDDATEI = os.path.join(STATE_DIR, "wache.pid")
EINGRIFF = os.path.join(STATE_DIR, "letzter-eingriff.json")

