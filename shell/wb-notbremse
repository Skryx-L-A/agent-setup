# --------------------------------------------------------- freier Speicher

def frei_mib_streng():
    """Die STRENGE, konservative Formel -- der Rueckfall, wenn check-resources
    nicht erreichbar ist, siehe frei_mib_quelle() unten. Auf macOS: frei +
    inaktiv + spekulativ + freigebbar (dieselbe Formel, die check-resources
    selbst als `ram.free_strict_mib` fuehrt). Auf Linux gibt es keine zweite,
    grosszuegigere Fassung -- check-resources rechnet dort schon immer
    MemAvailable, direkt aus dem Kernel, und das ist zugleich die strengste
    verfuegbare Zahl; dieselbe Quelle wird hier nur ein zweites Mal gelesen.
    Gibt None zurueck, wenn nicht messbar -- und NICHT MESSBAR IST KEIN
    EINGRIFF: eine Bremse, die bei fehlender Messung zieht, wuerde beim ersten
    kaputten PATH alle Modelle beenden."""
    if sys.platform == "darwin":
        try:
            seite = int(subprocess.run(["/usr/sbin/sysctl", "-n", "hw.pagesize"],
                                       capture_output=True, text=True, timeout=5).stdout.strip())
            vms = subprocess.run(["/usr/bin/vm_stat"], capture_output=True,
                                 text=True, timeout=5).stdout
        except (OSError, ValueError, subprocess.SubprocessError):
            return None
        seiten = 0
        gefunden = 0
        for name in ("Pages free", "Pages inactive", "Pages speculative", "Pages purgeable"):
            m = re.search(re.escape(name) + r":\s*(\d+)", vms)
            if m:
                seiten += int(m.group(1))
                gefunden += 1
        if not gefunden:
            return None
        return seiten * seite / 1048576.0
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for zeile in f:
                if zeile.startswith("MemAvailable:"):
                    return float(zeile.split()[1]) / 1024.0
    except OSError:
        pass
    return None


# GEMESSEN 2026-08-21 auf dieser Maschine: drei Aufrufe von 'check-resources'
# hintereinander, 0,14 / 0,15 / 0,15 s -- der uebliche Fall bleibt weit unter
# einer Zehntelsekunde Streuung. Die Frist unten ist grosszuegiger als dieser
# Normalfall (gut das Dreifache), aber bewusst kuerzer als TAKT_S: schlaegt
# der Aufruf fehl (haengender 'ollama ps' o.ae. -- check-resources selbst hat
# dafuer keine harte Frist), soll EIN Takt der Wache trotzdem nicht laenger
# als etwa TAKT_S + CHECK_RESOURCES_FRIST_S dauern, nicht das Doppelte davon.
# Ueberschreibbar fuer Tests (WB_NOTBREMSE_CHECK_FRIST_S), damit eine
# Attrappe, die absichtlich zu langsam antwortet, keine Suite ausbremst.
CHECK_RESOURCES_FRIST_S = float(os.environ.get("WB_NOTBREMSE_CHECK_FRIST_S", "0.5"))


def check_resources_pfad():
    """Woher 'check-resources' kommt -- dieselbe Reihenfolge wie in
    wb-belegungs eigenem check_resources_pfad(), aus demselben Grund
    (Nachbarn NIE vor $HOME/.local/bin, siehe dort): eigenes $HOME/.local/bin
    zuerst, dann der Nachbar neben dieser Datei (ein Arbeitsbaum misst gegen
    seinen eigenen Stand), dann PATH. WB_NOTBREMSE_CHECK ist der ausdrueckliche
    Test-Umweg -- anders als wb-belegungs WB_BELEGUNG_CHECK loest ein
    ungueltiger Pfad hier aber KEINEN Fehler aus, sondern zaehlt einfach als
    'check-resources nicht verfuegbar' und damit als Fall fuer den strengen
    Rueckfall: diese Datei darf nie hart abbrechen, das ist ihr ganzer Zweck."""
    p = os.environ.get("WB_NOTBREMSE_CHECK", "")
    if p:
        return p if os.access(p, os.X_OK) else None
    eigen = os.path.join(HOME, ".local", "bin", "check-resources")
    if os.access(eigen, os.X_OK):
        return eigen
    nebenan = os.path.join(os.path.dirname(os.path.abspath(__file__)), "check-resources")
    if os.access(nebenan, os.X_OK):
        return nebenan
    return shutil.which("check-resources") or None


def frei_mib_quelle():
    """(frei_mib oder None, quelle) -- die EINE Zahl fuer freien Speicher, samt
    Angabe, woher sie kommt. ERSTE WAHL ist immer check-resources: es ist seit
    dem Umbau vom 21.08.2026 die einzige Stelle, die die Formel fuehrt (siehe
    Kopfkommentar). Nur wenn der Aufruf ausfaellt -- Werkzeug fehlt, Frist
    ueberschritten (CHECK_RESOURCES_FRIST_S), kein gueltiges JSON, das Feld
    fehlt oder ist keine sinnvolle Zahl (negativ, Text, 'null') -- rechnet
    diese Funktion selbst nach, streng (frei_mib_streng()). Beide Zweige
    koennen None liefern (nicht messbar); der Aufrufer behandelt das wie
    bisher als 'kein Eingriff', nie als 'unbegrenzt frei'."""
    pfad = check_resources_pfad()
    if pfad:
        try:
            p = subprocess.run([pfad, "--json"], capture_output=True, text=True,
                               timeout=CHECK_RESOURCES_FRIST_S)
            if p.returncode == 0:
                d = json.loads(p.stdout)
                wert = d.get("ram", {}).get("free_mib")
                # bool ist in Python eine int-Unterklasse -- ein JSON 'true'/
                # 'false' waere sonst eine (unsinnige) gueltige Zahl.
                if (isinstance(wert, (int, float)) and not isinstance(wert, bool)
                        and wert >= 0):
                    return float(wert), "check-resources"
        except (subprocess.TimeoutExpired, OSError, ValueError,
                json.JSONDecodeError, AttributeError, TypeError):
            pass
    return frei_mib_streng(), "streng (lokal, Rueckfall -- check-resources war nicht nutzbar)"


# ------------------------------------------------------------- Modellsuche

def prozessliste():
    try:
        p = subprocess.run(["/bin/ps", "-Ao", "pid=,rss=,command="],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return []
    zeilen = []
    for z in p.stdout.splitlines():
        teile = z.strip().split(None, 2)
        if len(teile) < 3:
            continue
        try:
            zeilen.append((int(teile[0]), int(teile[1]), teile[2]))
        except ValueError:
            continue
    return zeilen


def modelle(eigene_pid=None):
    """Die lokalen Modellprozesse, weisse Liste. Der eigene Prozess und die
    eigene Prozesskette bleiben aussen vor -- eine Bremse, die sich selbst
    beendet, waere zwar folgerichtig, aber unbrauchbar."""
    aus = []
    selbst = {os.getpid(), os.getppid()}
    if eigene_pid:
        selbst.add(eigene_pid)
    for pid, rss, cmd in prozessliste():
        if pid in selbst:
            continue
        # Der Zaun zuerst: was ausserhalb liegt, wird gar nicht erst betrachtet
        # (siehe ZAUN oben). Im Betrieb ist er nicht gesetzt und diese Zeile
        # folgenlos.
        if ZAUN is not None and not ZAUN.search(cmd):
            continue
        if any(t.search(cmd) for t in TABU):
            continue
        for muster, art in MUSTER:
            if muster.search(cmd):
                aus.append({"pid": pid, "rss_mib": round(rss / 1024.0, 1),
                            "art": art, "kommando": cmd})
                break
    return aus


def lebt(pid):
    try:
        os.kill(pid, 0)
    except OSError as e:
        return e.errno != errno.ESRCH
    return True


def beenden(procs):
    """SIGTERM, Frist, SIGKILL — und danach NACHSEHEN, nicht annehmen.
    Rueckgabe: Liste von (eintrag, weg_ja_nein, wie)."""
    ergebnis = []
    for e in procs:
        try:
            os.kill(e["pid"], signal.SIGTERM)
        except OSError:
            ergebnis.append((e, not lebt(e["pid"]), "war schon weg"))
            continue
        ende = time.time() + TERM_FRIST_S
        while time.time() < ende and lebt(e["pid"]):
            time.sleep(0.2)
        if not lebt(e["pid"]):
            ergebnis.append((e, True, "SIGTERM"))
            continue
        try:
            os.kill(e["pid"], signal.SIGKILL)
        except OSError:
            pass
        ende = time.time() + TERM_FRIST_S
        while time.time() < ende and lebt(e["pid"]):
            time.sleep(0.2)
        ergebnis.append((e, not lebt(e["pid"]), "SIGKILL" if not lebt(e["pid"]) else "UEBERLEBT"))
    return ergebnis


# ------------------------------------------------------------- laut werden

def tmux_pfad():
    for p in ("/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux"):
        if os.access(p, os.X_OK):
            return p
    return ""


def in_die_sitzungen(text):
    """`display-message` in jede Sitzung des Werkbank-Servers. Das ist die
    Statuszeile, nicht der Chat -- in einen Pane TIPPEN darf hier niemand
    (wb-pane-write ist die einzige Stelle dafuer)."""
    tm = tmux_pfad()
    if not tm:
        return 0
    socket = os.environ.get("WB_TMUX_SOCKET", "")
    vorn = [tm] + (["-L", socket] if socket else [])
    try:
        p = subprocess.run(vorn + ["list-sessions", "-F", "#{session_name}"],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return 0
    if p.returncode != 0:
        return 0
    n = 0
    for name in p.stdout.split():
        try:
            subprocess.run(vorn + ["display-message", "-t", "=" + name, "-d", "20000", text],
                           capture_output=True, timeout=5)
            n += 1
        except (OSError, subprocess.SubprocessError):
            pass
    return n


def eingriff_merken(daten):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = EINGRIFF + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(daten, f, indent=2, ensure_ascii=False)
        os.replace(tmp, EINGRIFF)
    except OSError:
        pass


MLX_KENNUNG_DATEI = os.path.join(HOME, ".local", "state", "wb-mlx-server", "belegung-kennung")


def belegung_zurueckgeben():
    """Die Belegung des Servers, den dieses Werkzeug gerade beendet hat, aus dem
    Buch nehmen (Nachtrag nach dem echten Lauf, 2026-08-21).

    Im Verifikationslauf blieben 25,2 GiB im Buch stehen, nachdem die Bremse den
    mtplx-Server beendet hatte -- der Speicher war frei, das Buch sagte das
    Gegenteil, und die naechste Anfrage waere an einer Belegung gescheitert, die
    niemand mehr haelt. `wb-belegung aufraeumen` hilft dort nicht: es entfernt
    eine Belegung erst, wenn ihr HALTER-Pane stirbt, und der lebt weiter.

    NUR WENN GAR KEIN MODELLPROZESS MEHR LAEUFT. Die Kennungsdatei gehoert dem
    Server auf Port 8081; solange noch irgendein Modell laeuft, koennte es
    dieses eine sein, und dann waere die Freigabe eine Luege ueber laufenden
    Speicher. Ist keines mehr da, kann die Belegung niemandem mehr gehoeren.

    Fehlt die Datei oder scheitert die Freigabe, wird das gesagt und nicht
    stillschweigend uebergangen -- eine Belegung zu viel im Buch kostet einen
    Start, eine zu wenig kostet die Maschine."""
    if modelle():
        protokollieren("  Belegung NICHT freigegeben: es laeuft noch ein Modellprozess, die "
                       "Buchung koennte ihm gehoeren. Von Hand pruefen: wb-belegung wer")
        return
    try:
        kennung = open(MLX_KENNUNG_DATEI, encoding="utf-8").read().strip()
    except OSError:
        return
    if not kennung:
        return
    wbb = os.path.join(HOME, ".local", "bin", "wb-belegung")
    if not os.access(wbb, os.X_OK):
        wbb = shutil.which("wb-belegung") or ""
    if not wbb:
        protokollieren("  Belegung %s steht weiter im Buch: wb-belegung ist nicht aufrufbar. "
                       "Von Hand: wb-belegung gib %s --fremd" % (kennung, kennung))
        return
    try:
        p = subprocess.run([wbb, "gib", kennung, "--fremd"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        protokollieren("  Belegung %s liess sich nicht freigeben (%s) -- von Hand: "
                       "wb-belegung gib %s --fremd" % (kennung, e, kennung))
        return
    if p.returncode == 0:
        protokollieren("  Belegung %s freigegeben -- das Buch stimmt wieder mit der Maschine "
                       "ueberein." % kennung)
        try:
            os.unlink(MLX_KENNUNG_DATEI)
        except OSError:
            pass
    else:
        protokollieren("  Belegung %s liess sich nicht freigeben (Exit %d: %s) -- von Hand: "
                       "wb-belegung gib %s --fremd"
                       % (kennung, p.returncode, (p.stderr or p.stdout or "").strip()[:200], kennung))


def zuschlagen(frei, schwelle, procs, quelle):
    """Der Eingriff selbst: beenden, verifizieren, dreifach laut werden."""
    protokollieren("NOTBREMSE — frei %.0f MiB (Quelle: %s) unter Schwelle %.0f MiB, "
                   "%d Modellprozess(e)%s"
                   % (frei, quelle, schwelle, len(procs), zaun_zusatz()))
    for e in procs:
        protokollieren("  beende %s pid %d (%s)" % (e["art"], e["pid"], e["kommando"][:160]))
    ergebnis = beenden(procs)
    frei_danach, quelle_danach = frei_mib_quelle()
    beendet = [e for e, weg, _ in ergebnis if weg]
    ueberlebt = [e for e, weg, _ in ergebnis if not weg]
    for e, weg, wie in ergebnis:
        protokollieren("  %s pid %d: %s" % (e["art"], e["pid"], wie if weg else "UEBERLEBT — von Hand nachsehen"))
    protokollieren("  frei danach: %s (Quelle: %s)"
                   % ("nicht messbar" if frei_danach is None else "%.0f MiB" % frei_danach, quelle_danach))
    text = ("wb-notbremse: %d lokale Modelle beendet — nur noch %.0f MiB frei (Schwelle %.0f, "
            "Quelle: %s)%s. Protokoll: %s"
            % (len(beendet), frei, schwelle, quelle, zaun_zusatz(), PROTOKOLL))
    if ueberlebt:
        text += " ACHTUNG: %d Prozess(e) haben UEBERLEBT." % len(ueberlebt)
    erreicht = in_die_sitzungen(text)
    eingriff_merken({
        "zeit": jetzt_iso(),
        "frei_mib_vorher": round(frei, 1),
        "quelle_vorher": quelle,
        "frei_mib_nachher": None if frei_danach is None else round(frei_danach, 1),
        "quelle_nachher": quelle_danach,
        "schwelle_mib": schwelle,
        "beendet": [{"pid": e["pid"], "art": e["art"], "kommando": e["kommando"][:400]} for e in beendet],
        "ueberlebt": [{"pid": e["pid"], "art": e["art"], "kommando": e["kommando"][:400]} for e in ueberlebt],
        "sitzungen_benachrichtigt": erreicht,
    })
    sys.stderr.write(text + "\n")
    belegung_zurueckgeben()
    return ergebnis


# ------------------------------------------------------------- Unterbefehle

def zeige_lage(frei, procs, schwelle, quelle):
    gib_aus("frei        %s MiB (Schwelle %s MiB, Quelle: %s)"
            % ("NICHT MESSBAR" if frei is None else "%.0f" % frei, "%.0f" % schwelle, quelle))
    if ZAUN is not None:
        gib_aus("Zaun        nur Prozesse, deren Startzeile auf '%s' passt "
                "(WB_NOTBREMSE_NUR_MUSTER) -- Testbetrieb, nicht der Ernstfall." % _ZAUN)
    if not procs:
        gib_aus("Modelle     keine gefunden.")
        return
    gib_aus("Modelle     %d gefunden:" % len(procs))
    for e in procs:
        gib_aus("  %-14s pid %-7d rss %7.1f MiB  %s" % (e["art"], e["pid"], e["rss_mib"], e["kommando"][:100]))


def cmd_pruefen(a, wirklich=False):
    frei, quelle = frei_mib_quelle()
    procs = modelle()
    zeige_lage(frei, procs, a.schwelle_mib, quelle)
    if frei is None:
        gib_aus()
        gib_aus("Kein Eingriff: der freie Speicher ist nicht messbar. Eine Bremse, die")
        gib_aus("ohne Messung zieht, wuerde beim ersten kaputten PATH alles beenden.")
        return 0
    if frei >= a.schwelle_mib:
        gib_aus()
        gib_aus("Kein Eingriff noetig.")
        return 0
    if not procs:
        gib_aus()
        gib_aus("Unter der Schwelle, aber KEIN lokales Modell laeuft — hier ist nichts")
        gib_aus("zu beenden, was dieses Werkzeug beenden duerfte. Der Speicher gehoert")
        gib_aus("jemand anderem; siehe 'wb-belegung wer'.")
        return 1
    if not wirklich:
        gib_aus()
        gib_aus("WUERDE ZUSCHLAGEN: %d Modellprozess(e) beenden." % len(procs))
        return 1
    zuschlagen(frei, a.schwelle_mib, procs, quelle)
    return 1


def cmd_wache(a):
    os.makedirs(STATE_DIR, exist_ok=True)
    start = time.time()
    protokollieren("Wache an (pid %d, Schwelle %.0f MiB, Takt %.1f s, Anlauf %.0f s, "
                   "%d Abtastungen zur Bestaetigung)%s"
                   % (os.getpid(), a.schwelle_mib, a.takt, a.anlauf, a.bestaetigungen,
                      zaun_zusatz()))
    eingegriffen = False
    unter = 0
    try:
        while True:
            procs = modelle()
            if not procs:
                if time.time() - start > a.anlauf:
                    protokollieren("Wache aus: kein lokales Modell mehr — sie wird nicht auf Vorrat gehalten.")
                    return 1 if eingegriffen else 0
            else:
                frei, quelle = frei_mib_quelle()
                if frei is not None and frei < a.schwelle_mib:
                    unter += 1
                    if unter < a.bestaetigungen:
                        protokollieren("unter der Schwelle (%d von %d): frei %.0f MiB "
                                       "(Quelle: %s), Schwelle %.0f MiB"
                                       % (unter, a.bestaetigungen, frei, quelle, a.schwelle_mib))
                    else:
                        zuschlagen(frei, a.schwelle_mib, procs, quelle)
                        eingegriffen = True
                        unter = 0
                else:
                    # Eine einzelne Unterschreitung, der eine normale Messung folgt,
                    # war ein Ausreisser und keine Lage -- der Zaehler faengt neu an.
                    if unter:
                        protokollieren("wieder ueber der Schwelle (frei %s, Quelle: %s) -- die "
                                       "Unterschreitung war ein Ausreisser, nichts beendet."
                                       % ("nicht messbar" if frei is None else "%.0f MiB" % frei,
                                          quelle))
                    unter = 0
            time.sleep(a.takt)
    except KeyboardInterrupt:
        protokollieren("Wache aus (Abbruch von Hand).")
        return 1 if eingegriffen else 0
    finally:
        try:
            if os.path.exists(PIDDATEI) and int(open(PIDDATEI).read().strip() or 0) == os.getpid():
                os.unlink(PIDDATEI)
        except (OSError, ValueError):
            pass


def wache_pid():
    try:
        pid = int(open(PIDDATEI, encoding="utf-8").read().strip())
    except (OSError, ValueError):
        return 0
    return pid if lebt(pid) else 0


def cmd_start(a):
    os.makedirs(STATE_DIR, exist_ok=True)
    alt = wache_pid()
    if alt:
        gib_aus("wb-notbremse: laeuft bereits (pid %d)." % alt)
        return 0
    log = os.path.join(STATE_DIR, "wache.log")
    argumente = [sys.executable, os.path.abspath(__file__), "wache",
                 "--schwelle-mib", str(int(a.schwelle_mib)),
                 "--takt", str(a.takt), "--anlauf", str(a.anlauf),
                 "--bestaetigungen", str(int(a.bestaetigungen))]
    with open(log, "a", encoding="utf-8") as f:
        kind = subprocess.Popen(argumente, stdout=f, stderr=f,
                                stdin=subprocess.DEVNULL, start_new_session=True)
    with open(PIDDATEI, "w", encoding="utf-8") as f:
        f.write(str(kind.pid))
    gib_aus("wb-notbremse: Wache an (pid %d, Schwelle %d MiB)%s. Protokoll: %s"
            % (kind.pid, int(a.schwelle_mib), zaun_zusatz(), PROTOKOLL))
    return 0


def cmd_stopp(_a):
    pid = wache_pid()
    if not pid:
        gib_aus("wb-notbremse: keine Wache aktiv.")
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    ende = time.time() + 5.0
    while time.time() < ende and lebt(pid):
        time.sleep(0.2)
    if lebt(pid):
        gib_aus("wb-notbremse: Wache %d liess sich nicht beenden." % pid)
        return 1
    try:
        os.unlink(PIDDATEI)
    except OSError:
        pass
    gib_aus("wb-notbremse: Wache %d beendet." % pid)
    return 0


def cmd_status(a):
    pid = wache_pid()
    gib_aus("Wache       %s" % ("laeuft (pid %d)" % pid if pid else "aus"))
    frei, quelle = frei_mib_quelle()
    zeige_lage(frei, modelle(), a.schwelle_mib, quelle)
    if os.path.exists(EINGRIFF):
        try:
            d = json.load(open(EINGRIFF, encoding="utf-8"))
            gib_aus("Letzter Eingriff  %s — %d beendet, %d ueberlebt, frei %s -> %s MiB (Quelle: %s -> %s)"
                    % (d.get("zeit"), len(d.get("beendet") or []), len(d.get("ueberlebt") or []),
                       d.get("frei_mib_vorher"), d.get("frei_mib_nachher"),
                       d.get("quelle_vorher", "?"), d.get("quelle_nachher", "?")))
        except (OSError, ValueError):
            pass
    return 0


def main(argv):
    p = argparse.ArgumentParser(
        prog="wb-notbremse",
        description="Notaus fuer lokale Modelle, wenn der freie Speicher unter die Schwelle faellt.")
    sub = p.add_subparsers(dest="befehl")

    def gemeinsam(sp):
        sp.add_argument("--schwelle-mib", type=float, default=SCHWELLE_MIB,
                        help="freier Speicher in MiB, unter dem beendet wird (Vorgabe %d)" % SCHWELLE_MIB)
        sp.add_argument("--takt", type=float, default=TAKT_S,
                        help="Sekunden zwischen zwei Messungen (Vorgabe %s)" % TAKT_S)
        sp.add_argument("--bestaetigungen", type=int, default=BESTAETIGUNGEN,
                        help="wie viele aufeinanderfolgende Abtastungen unter der Schwelle "
                             "liegen muessen, bevor beendet wird (Vorgabe %d -- eine einzelne "
                             "Abtastung ist gemessen bis zu 7 GiB danebengelegen, siehe "
                             "BESTAETIGUNGEN im Quelltext)" % BESTAETIGUNGEN)
        sp.add_argument("--anlauf", type=float, default=ANLAUF_S,
                        help="Sekunden, in denen 'noch kein Modell da' die Wache NICHT beendet "
                             "(Vorgabe %d -- ein Server braucht zum Laden laenger als einen Takt)" % ANLAUF_S)

    for name in ("wache", "start", "stopp", "status", "pruefen", "jetzt"):
        sp = sub.add_parser(name)
        gemeinsam(sp)

    a = p.parse_args(argv)
    if not a.befehl:
        p.print_help()
        return 2
    if a.schwelle_mib <= 0 or a.takt <= 0:
        sys.stderr.write("wb-notbremse: --schwelle-mib und --takt muessen groesser als null sein.\n")
        return 2
    if a.bestaetigungen < 1:
        sys.stderr.write("wb-notbremse: --bestaetigungen muss mindestens 1 sein.\n")
        return 2
    if a.befehl == "wache":
        return cmd_wache(a)
    if a.befehl == "start":
        return cmd_start(a)
    if a.befehl == "stopp":
        return cmd_stopp(a)
    if a.befehl == "status":
        return cmd_status(a)
    if a.befehl == "pruefen":
        return cmd_pruefen(a, wirklich=False)
    if a.befehl == "jetzt":
        return cmd_pruefen(a, wirklich=True)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
