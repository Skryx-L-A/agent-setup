#!/usr/bin/env python3
# wb-notbremse — die letzte Sicherung vor dem Stillstand: faellt der freie
# Speicher unter eine Schwelle, werden die LOKALEN MODELLE beendet, sonst nichts.
#
#   wb-notbremse wache [--schwelle-mib 1024] [--takt 1] [--anlauf 120]
#                                Die Schleife selbst. Laeuft im Vordergrund und
#                                endet von selbst, sobald kein Modell mehr laeuft.
#   wb-notbremse start [...]     Dieselbe Schleife abgeloest im Hintergrund,
#                                genau einmal (Pid-Datei). Der Weg fuer wb-mlx-server.
#   wb-notbremse stopp           Die laufende Wache beenden.
#   wb-notbremse status          Laeuft eine? Was sieht sie gerade?
#   wb-notbremse pruefen         EIN Durchgang, ohne irgendetwas zu beenden.
#   wb-notbremse jetzt           EIN Durchgang, der wirklich beendet (Notgriff von Hand).
#
# WOZU (Auftrag des Nutzers, 2026-08-21, woertlich): "baue ein sicherheitsmechanismus
# ein das bei solchen tests die lokalen modelle automatisch beendet werden wenn
# unter 1gb freier speicher insgesammt verfuegbar ist." Anlass war ein Worker, der
# einen MLX-Server OHNE `wb-belegung` gestartet und dabei versehentlich ein ZWEITES
# Modell nachgeladen hat; der Speicher stieg auf 47 von 48 GiB, und niemand ausser
# der Nutzer selbst konnte das noch anhalten.
#
# WARUM SIE NICHT INS BUCH SCHAUT. `wb-belegung` ist die Planung: es entscheidet
# VORHER, ob etwas passen wird. Dieses Werkzeug ist die Wirklichkeit: es sieht, was
# TATSAECHLICH laeuft. Genau der Fall, gegen den es gebaut ist, war ein Start am
# Buch VORBEI — eine Bremse, die das Buch liest, haette dort nichts gesehen und
# nichts getan. Gesucht wird deshalb in der Prozessliste, nach den Startzeilen der
# Modellserver selbst.
#
# WEISSE LISTE, KEINE SCHWARZE. Beendet wird ausschliesslich, was auf MUSTER unten
# passt — Modellserver, die wir selbst starten. Alles andere bleibt unangetastet,
# auch wenn es viel Speicher haelt: die Werkbank, Sitzungen des Nutzers, der Browser,
# der Diktierdienst. Eine schwarze Liste waere hier der falsche Weg: sie muesste
# jeden neuen fremden Prozess kennen, um ihn NICHT zu toeten, und ein Vergessen
# haette die teure Richtung.
#
# AUSDRUECKLICH NICHT BEENDET (auch wenn ein Muster zufaellig passte, siehe TABU):
#   ollama serve        der Dienst selbst -- beendet wird nur sein 'runner', der die
#                       Gewichte haelt; der Dienst nimmt danach sofort wieder Anfragen.
#   whisper-server      das Diktat-Werkzeug. Es haengt an der Tastatur des
#                       Menschen, nicht an einem Modelllauf, und es ist mit
#                       gemessenen 0,6 GiB nie der Grund fuer einen Engpass.
#   a protected service            geschuetzter Dienst auf peer (globale Regel).
#
# DIE SCHWELLE IST EIN NOTAUS, KEINE VERWALTUNG. 1 GiB frei heisst: die Maschine
# steht kurz vor dem Anhalten, und ein sauberes Beenden ist ab hier besser als jeder
# weitere Versuch, richtig zu rechnen. Wer den Speicher VERTEILEN will, ist bei
# `wb-belegung` richtig; hier wird nur noch abgeraeumt.
#
# SIE LAEUFT NUR, SOLANGE SIE GEBRAUCHT WIRD (stehende des Nutzers Regel vom 20.08.:
# kein Prozess laeuft auf Vorrat). Die Schleife endet von selbst, sobald kein
# Modellprozess mehr da ist — nach einer Anlauffrist, damit sie einen gerade
# startenden Server nicht fuer "nichts mehr da" haelt. `wb-mlx-server` startet sie
# bei jedem Serverstart neu; ein zweiter Start ist wirkungslos (Pid-Datei).
#
# SIE BEENDET AUCH DIE BUCHUNG, NICHT NUR DEN PROZESS (Nachtrag nach dem echten
# Lauf, 2026-08-21). Nach dem ersten Verifikationslauf standen 25,2 GiB weiter im
# Belegungsbuch, obwohl der Server tot war: der Speicher war frei, das Buch sagte
# das Gegenteil, und die naechste Anfrage waere an einer Belegung gescheitert, die
# niemand mehr haelt. Siehe belegung_zurueckgeben() -- freigegeben wird nur, wenn
# danach gar kein Modellprozess mehr laeuft.
#
# SIE SAGT LAUT, WAS SIE GETAN HAT. Ein Modell, das stillschweigend verschwindet,
# ist schlimmer als eines, das abstuerzt: drei Wege gleichzeitig — die Protokolldatei,
# eine Merkdatei mit dem letzten Eingriff, und `tmux display-message` in jede Sitzung
# des Werkbank-Servers. Keiner davon tippt in einen Chat (wb-pane-write bleibt die
# einzige Stelle, die das duerfte).
#
# DER FREIE SPEICHER HAT GENAU EINE WAHRHEIT, UND SIE STEHT IN `check-resources`
# (Umbau 21.08.2026, Entscheidung des Nutzers nach Befund 2 aus dem Pruefpass
# ~/.pi-workers/results/hafenmeister/20260821-045339.md). Bis zu diesem Umbau
# rechnete diese Datei dieselbe Formel EIGENSTAENDIG nach ("dieselbe Formel wie
# check-resources, siehe dort") -- und genau das war der Fehler: als
# check-resources am 21.08. auf eine grosszuegigere, genauere Formel umstellte
# (Commit b89093e), blieb diese Datei bei der alten stehen, ohne dass es
# irgendjemand merkte, weil beide plausible Zahlen lieferten. Zwei Waechter mit
# zwei Meinungen, und lautlos gewonnen hat der grosszuegigere: bei geladenem
# Modell zeigte die alte, hier nachgerechnete Formel 20707 MiB, wo
# check-resources zur selben Zeit schon 18404 MiB sah -- die naehere Zahl,
# weil das Modell anonymen, nicht wiederbeschaffbaren Speicher haelt, den die
# alte Formel faelschlich als "inaktiv" (also frei) mitzaehlte.
#
# Diese Datei FRAGT check-resources jetzt, statt selbst zu rechnen (siehe
# frei_mib_quelle() unten, "ERSTE WAHL"). Nur wenn dieser Aufruf ausfaellt --
# Werkzeug fehlt, Frist ueberschritten, kaputte oder unsinnige Antwort --
# rechnet sie noch selbst nach, und zwar NICHT mehr mit der grosszuegigen
# Formel, sondern mit der STRENGEN (`frei_mib_streng()`, vormals `frei_mib()`):
# lieber einmal zu frueh gebremst als einmal zu spaet. check-resources fuehrt
# genau diese Zahl selbst als `ram.free_strict_mib` -- dieselbe
# Bedeutung, hier lokal nachgerechnet fuer den Fall, dass check-resources
# selbst nicht mehr da ist, um sie zu liefern. Jede Meldung sagt dazu, welche
# der beiden Quellen gerade galt -- eine Sicherung, die still auf den
# Rueckfall wechselt, waere nur eine halbe Sicherung.
#
# Zustand:  ~/.local/state/wb-notbremse/protokoll.log     jede Messung mit Eingriff
#           ~/.local/state/wb-notbremse/wache.pid         die laufende Wache
#           ~/.local/state/wb-notbremse/letzter-eingriff.json
#
# EXIT-CODES: 0 = in Ordnung / nichts zu tun, 1 = es wurde eingegriffen (bei
#             'jetzt'/'pruefen': es waere eingegriffen worden), 2 = Benutzungsfehler.
import argparse
import errno
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(HOME, ".local", "state", "wb-notbremse")
PROTOKOLL = os.path.join(STATE_DIR, "protokoll.log")
PIDDATEI = os.path.join(STATE_DIR, "wache.pid")
EINGRIFF = os.path.join(STATE_DIR, "letzter-eingriff.json")

SCHWELLE_MIB = 1024      # Zahl des Nutzers: "unter 1gb freier speicher insgesammt".
TAKT_S = 1.0
ANLAUF_S = 120.0         # solange gilt "noch kein Modell da" NICHT als "fertig".
TERM_FRIST_S = 5.0       # zwischen SIGTERM und SIGKILL.
# ZWEI ABTASTUNGEN, NICHT EINE (Nachtrag nach dem echten Lauf, 2026-08-21).
# Im Verifikationslauf gegen einen wirklich geladenen mtplx-Server standen zwei
# Messungen DERSELBEN Sekunde 7 GiB auseinander: der Mitschreiber las 21808 MiB
# frei, die Wache 14477 MiB, und die Wache hatte recht (nach dem Beenden waren
# 36554 MiB frei, der Server hielt 21029 MiB davon). Dass hier die EINZELMESSUNG
# des Mitschreibers der Ausreisser war und nicht die der Wache, ist Glueck und
# kein Verlass: dieselbe Schwankung kann in die andere Richtung zeigen, und dann
# beendet eine einzelne Abtastung ein gesundes Modell. wb-belegung nimmt aus
# genau diesem Grund den Median aus drei Abtastungen (siehe der Abschnitt "DER
# FREIE SPEICHER WIRD NIE AUS EINER EINZIGEN ABTASTUNG GENOMMEN" dort; dort
# wurde eine Messung mit 735 MiB frei abgelehnt, waehrend eine Minute spaeter
# 14,2 GiB frei waren).
#
# Ein Median waere hier falsch -- er kostet drei Takte, bevor ueberhaupt eine
# Entscheidung faellt. Verlangt wird stattdessen, dass die Schwelle in ZWEI
# aufeinanderfolgenden Abtastungen unterschritten ist. Bei einem Takt von 0,5 s
# kostet das eine halbe Sekunde und faengt den einzelnen Ausreisser. Die
# Zwischenmessung steht im Protokoll, damit ein knapper Fall nachlesbar bleibt.
BESTAETIGUNGEN = 2

# Die weisse Liste. Jedes Muster wird gegen die GANZE Startzeile gehalten.
# Bewusst an den Startzeilen der Server festgemacht, nicht an Verbrauchszahlen:
# ein MLX-Prozess haelt seinen Speicher als Metal-Puffer und zeigt dabei eine
# winzige RSS (gemessen 2026-08-21: 170 MiB RSS bei 14,1 GiB gehaltenen Gewichten).
# Eine Schwelle auf RSS haette genau die groessten Halter uebersehen.
MUSTER = [
    (re.compile(r"\bmlx_lm\.(server|generate|chat|benchmark|evaluate)\b"), "mlx-lm"),
    (re.compile(r"\bmlx[-_]dspark\b"), "mlx-dspark"),
    (re.compile(r"\bmtplx\b"), "mtplx"),
    (re.compile(r"\bvllm\b.*\b(serve|entrypoints)\b"), "vllm"),
    (re.compile(r"\bllama-(server|cli)\b"), "llama.cpp"),
    (re.compile(r"\bollama\s+runner\b"), "ollama-runner"),
]

# TABU: trifft eines davon, wird der Prozess NIE angefasst, auch wenn ein Muster
# oben passte. Die Reihenfolge ist Absicht -- das Tabu wird zuerst geprueft.
TABU = [
    re.compile(r"\bollama\s+serve\b"),
    re.compile(r"\bwhisper-server\b"),
    re.compile(r"\bnews-clf\b"),
]

# DER ZAUN (Nachtrag 21.08.2026). Diese Bremse ist maschinenweit -- im Betrieb ist
# das genau ihr Zweck, im Testlauf war es ihr Fehler. test-notbremse.sh isoliert
# sich ueber ein eigenes HOME und einen eigenen tmux-Socket, aber ihr eigentlicher
# Handgriff, das Beenden, ging an beidem vorbei: sie beendet, was in der
# Prozessliste der ganzen Maschine auf MUSTER passt. Im parallelen Testlauf war
# das der Motor-Stellvertreter der Nachbarsuite -- gemessen an diesem Tag:
# test-mlx-wechsel-speicher.sh fiel mit "wb-nohup konnte den Server nicht starten"
# aus, weil test-notbremse.sh ihm den Prozess unter den Haenden weggenommen hatte,
# und test-notbremse.sh fiel umgekehrt aus, weil der fremde Stellvertreter seine
# Wache nicht von selbst enden liess. Beide Suiten bestanden allein und fielen
# gemeinsam.
#
# WB_NOTBREMSE_NUR_MUSTER ist deshalb ein ZUSAETZLICHER Filter, kein Ersatz: die
# weisse Liste sucht weiter wie im Ernstfall, aber betrachtet wird nur, wessen
# Startzeile auch auf dieses Muster passt. Gesetzt wird es ausschliesslich von der
# eigenen Testsuite (dieselbe Bauart wie WB_NOTBREMSE_CHECK darunter), nie im
# Betrieb -- ist es leer, aendert sich nichts. Und der Zaun wird in jeder Meldung
# genannt: eine Bremse, die still nur die Haelfte der Maschine sieht, waere nur
# eine halbe Bremse.
_ZAUN = os.environ.get("WB_NOTBREMSE_NUR_MUSTER", "")
try:
    ZAUN = re.compile(_ZAUN) if _ZAUN else None
except re.error:
    # Ein kaputtes Muster darf nie zu "dann eben alles" werden -- die teure
    # Richtung waere hier, den Zaun fallen zu lassen. Er bleibt stehen und laesst
    # nichts durch.
    ZAUN = re.compile(r"(?!)")


def zaun_zusatz():
    """Ein Satz ueber den Zaun, oder nichts. Er gehoert in JEDE Meldung: wer
    diese Ausgabe liest, muss sehen, dass gerade nicht die ganze Maschine
    betrachtet wird (siehe ZAUN oben)."""
    return "" if ZAUN is None else " [Zaun: nur Startzeilen auf '%s']" % _ZAUN


