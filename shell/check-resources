#!/usr/bin/env bash
# check-resources — machine-aware compute/resource snapshot for cross-machine orchestration.
#
# Modes:
#   check-resources            JSON (machine-readable, default)
#   check-resources --human    human-readable summary
#   check-resources --guard    KEY=VALUE lines for run-on (shell-parseable, no jq needed)
#
# Machine-detecting (Darwin vs Linux). Reports free VRAM, free RAM, running GPU
# processes, loaded ollama models, and a PROTECTED list of services/processes that
# must NEVER be stopped (peer: a protected service — RoBERTa Polarschern veto).
#
# Test hook: CR_ASSUME_NEWS_CLF_ACTIVE=1 forces a protected service into the protected list
# (for reproducibly exercising run-on's refusal path outside market hours).
#
# NACHTRAG 16.08.2026 (siehe shell/wb-belegung, Konstante OLLAMA_STABIL_SCHWELLE_S):
# das Buch von wb-belegung sah Ollama-Ladungen nicht, weil diese Datei zwar schon
# `ollama_loaded` mit ECHTER Groesse aus `/api/ps` lieferte, aber wb-belegung diese
# Antwort nie las. Beim Nachziehen dort fiel eine zweite Luecke auf, HIER: `ollama
# ps` (die Namensliste) und der Aufruf gegen `/api/ps` (die Groessen) sind zwei
# getrennte Befehle gegen denselben Daemon. Scheitert nur der zweite -- der Server
# antwortet auf `ollama ps`, aber `/api/ps` nicht -- blieb OLLAMA_LOADED_JSON
# stillschweigend leer, ununterscheidbar von "wirklich nichts geladen". Genau das
# ist der Fehler, vor dem die Kontextwache warnt: unbekannt wird zu frei. Deshalb
# jetzt OLLAMA_LOADED_NOTE, nur in diesem einen Fall gesetzt -- nicht, wenn der
# Server schlicht nicht laeuft (dann ist "nichts geladen" keine Vermutung, sondern
# so sicher wie ein Server ohne Prozess).
#
# STAND DIESER DATEI: bislang nur nach ~/.local/bin ausgerollt, nie im Repo verfolgt
# (im Unterschied zu wb-belegung, das seit dem 11.08. hier UND dort liegt). Diese
# Fassung liegt jetzt zusaetzlich hier, mit dem Nachtrag; das Ausrollen der neuen
# Fassung nach ~/.local/bin bleibt Entscheidung des Orchestrators (dieselbe Trennung
# wie im Kopf von wb-belegung: bauen tut ein Worker, ausrollen der Orchestrator).
set -euo pipefail

MODE=json
case "${1:-}" in
  --human|-h) MODE=human ;;
  --guard)    MODE=guard ;;
  --json|"")  MODE=json ;;
  *) echo "check-resources: unknown arg '$1' (use --human|--guard)" >&2; exit 2 ;;
esac

OS="$(uname -s)"
HOST="$(hostname -s 2>/dev/null || hostname)"

MACHINE=""
GPU_KIND=""
# GPU_UTIL leer = nicht gemessen. Wird als JSON-null ausgegeben, nie als 0 —
# eine 0 waere von "GPU ist im Leerlauf" nicht zu unterscheiden (2026-08-07).
VRAM_FREE=0; VRAM_TOTAL=0; GPU_UTIL=""; VRAM_NOTE=""
RAM_FREE=0;  RAM_TOTAL=0
GPU_PROCS_JSON="[]"
OLLAMA_JSON="[]"; OLLAMA_LOADED_JSON="[]"; OLLAMA_NOTE=""; OLLAMA_LOADED_NOTE=""
OLLAMA_LOCAL=null
PROTECTED_JSON="[]"; PROTECTED_ACTIVE=0; PROTECTED_NAMES=""

# ---- ollama (both platforms) ----
# Wer bedient Port 11434 auf DIESER Maschine? Antwort: der Befehlsname des
# lauschenden Prozesses, oder leer, wenn er sich nicht ermitteln laesst.
#
# Anlass (16.08.2026, gemessen): auf peer lauscht dort ein `ssh` -- ein
# Portforward zum Mac, aufgebaut, damit die Scout-Agenten das Embedding-Modell
# erreichen. `ollama ps` und /api/ps antworten also, aber sie beschreiben die
# GPU einer ANDEREN Maschine. Ohne diese Pruefung haette wb-belegung auf peer
# die Ladungen des Macs als lokale Belegung verrechnet und Auftraege abgelehnt,
# die dort problemlos gepasst haetten -- und eine echte peer-Ladung waere
# unsichtbar geblieben, weil der Port schon belegt ist. Es ist derselbe
# Fehlertyp wie "unbekannt wird zu frei", nur andersherum: fremd wird zu eigen.
ollama_listener() {
  local out=""
  if [ "$OS" = "Linux" ]; then
    # -H unterdrueckt die Kopfzeile; das Prozessfeld sieht aus wie
    # users:(("ssh",pid=123,fd=4)) -- daraus der Name in den Anfuehrungen.
    out="$(ss -lntpH 'sport = :11434' 2>/dev/null \
      | sed -n 's/.*users:((\"\([^\"]*\)\".*/\1/p' | head -1)"
  else
    # -F c gibt je Prozess eine Zeile "c<befehlsname>".
    out="$(lsof -nP -iTCP:11434 -sTCP:LISTEN -F c 2>/dev/null \
      | sed -n 's/^c//p' | head -1)"
  fi
  printf '%s' "$out"
}

# Laufen auf DIESER Maschine echte Ollama-Modell-Laeufer? Gibt 'ja', 'nein'
# oder 'unbekannt' aus (Messung selbst gescheitert). Dieselbe Frage, mit
# denselben Mustern, die wb-notbremse schon fuer die Notbremse beantwortet
# (siehe dort, MUSTER) -- gebraucht hier, wenn der Portname allein nicht mehr
# reicht (siehe NACHTRAG 21.08.2026 unten bei OLLAMA_LOCAL). Erst der ganze
# `ps`-Schnappschuss in eine Variable, dann grep DARAUF: ein direktes
# `ps | grep <Muster>` faende unter Umstaenden sein eigenes Kommando, weil
# `ps` den schon gestarteten `grep`-Prozess samt Suchtext im Aufruf mit
# einfaengt. Die eckigen Klammern um je einen Buchstaben sind derselbe
# Trick nochmal, zur Sicherheit -- ein woertlich passendes Suchmuster im
# eigenen Aufruf (etwa durch einen umschliessenden Wrapper) matcht dann
# trotzdem nicht sich selbst.
#
# Zweistufig, nicht ein einzelnes Muster: 'llama-server'/'llama-cli' allein
# heisst nur "irgendein llama.cpp-Prozess", nicht "Ollamas eigener". Gemessen
# beim Bau dieser Funktion, live auf dieser Maschine: mehrere FREMDE, voellig
# ollama-lose Test-Stubs namens 'llama-server' liefen gerade gleichzeitig aus
# fremden Test-HOMEs (/var/folders/.../tmp.*/home?/bin/llama-server, aus
# einem anderen, parallel laufenden Testlauf). Ein einstufiges Muster haette
# die als "lokaler Ollama-Laeufer" durchgehen lassen. Deshalb: erst die
# Kandidaten sammeln (Laeufer-Namensmuster), dann verlangen, dass MINDESTENS
# EINER davon tatsaechlich 'ollama' im eigenen Kommando traegt (Installations-
# pfad oder das explizite 'ollama runner' aelterer Fassungen) -- ein fremder
# Stub ohne das Wort 'ollama' irgendwo im Kommando besteht das nicht.
ollama_lokale_laeufer_lage() {
  local ps_out kandidaten
  if ! ps_out="$(ps -Ao command= 2>/dev/null)"; then
    printf 'unbekannt'
    return
  fi
  kandidaten="$(printf '%s\n' "$ps_out" | grep -E '\bollama runne[r]\b|\bllama[-_](serve[r]|cl[i])\b')"
  if printf '%s\n' "$kandidaten" | grep -qi 'ollama'; then
    printf 'ja'
  else
    printf 'nein'
  fi
}

# Hinweise sammeln statt ueberschreiben: die Herkunft des Ports und ein
# Lesefehler auf /api/ps sind zwei verschiedene Aussagen, und die zweite darf
# die erste nicht verschlucken.
note_add() {
  if [ -z "$OLLAMA_LOADED_NOTE" ]; then OLLAMA_LOADED_NOTE="$1"
  else OLLAMA_LOADED_NOTE="$OLLAMA_LOADED_NOTE; $1"; fi
}

collect_ollama() {
  if ! command -v ollama >/dev/null 2>&1; then OLLAMA_NOTE="ollama not installed"; return; fi
  local ops
  if ! ops="$(ollama ps 2>/dev/null)" || printf '%s' "$ops" | grep -qi "could not connect"; then
    # Der Server ist bestaetigt NICHT erreichbar -- dann ist "nichts geladen"
    # keine Vermutung, sondern so sicher wie ein Prozess, der nicht laeuft. Kein
    # Versuch gegen :11434, der nur eine zweite Art desselben Nein waere.
    OLLAMA_NOTE="ollama server not running"
    return
  fi
  OLLAMA_JSON="$(printf '%s\n' "$ops" | awk 'NR>1 && NF>0{print $1}' \
    | jq -R -s 'split("\n")|map(select(length>0))' 2>/dev/null || echo "[]")"
  [ -n "$OLLAMA_JSON" ] || OLLAMA_JSON="[]"
  # Namen allein reichen nicht: wer entscheiden will, ob ein geladenes Modell
  # die GPU wirklich belegt, braucht seine Groesse. Ohne sie bleibt nur eine
  # gepflegte Ausnahmeliste, und eine Sauberkeitspruefung mit Ausnahmeliste ist
  # die falsche Konstruktion (Standing Rule 2026-07-29). q8_0-Embedder wiegen
  # unter 1 GiB, ein 35B-Coder ueber 20 -- ein Schwellwert trennt das sauber
  # und braucht keine Pflege (2026-08-08). expires_at (Nachtrag 16.08.) ist die
  # maschinenlesbare UNTIL-Spalte: wb-belegung braucht sie, um eine Ladung, die
  # gleich von selbst ablaeuft, nicht wie einen Dauerhalter zu behandeln.
  # Bedient ein lokaler ollama den Port, oder zeigt er woandershin? Die Antwort
  # entscheidet nicht ueber die SICHTBARKEIT der Ladungen (die bleibt, sie ist
  # nuetzlich), sondern darueber, ob sie fuer die Vergabe auf DIESER Maschine
  # zaehlen duerfen. Drei Faelle, wie ueberall in dieser Datei: bestaetigt
  # lokal, bestaetigt fremd, nicht ermittelbar -- und der dritte wird nie
  # stillschweigend zum ersten.
  local listener
  listener="$(ollama_listener)"
  case "$listener" in
    ollama)      OLLAMA_LOCAL=true ;;
    "")          OLLAMA_LOCAL=null
                 OLLAMA_LOADED_NOTE="wer Port 11434 bedient, war nicht zu ermitteln — die Ladungen zaehlen nicht als lokal" ;;
    *)
      # NACHTRAG 21.08.2026 (Auftrag, gemessen auf dieser Maschine): der Name
      # allein traegt die Entscheidung seit der Bedarfsschaltung nicht mehr.
      # `wb-modell-proxy` (Python) ist dort die VORGESEHENE Vordertuer auf
      # :11434 und heisst nie 'ollama' -- damit fiel jede Bedarfsschaltungs-
      # Ladung in denselben Zweig wie der ssh-Portforward vom 16.08., obwohl
      # die Modelle sehr wohl HIER liegen. Befund: 'ollama ps' meldete
      # ornith:9b (6,1 GiB) und embeddinggemma, `ps` zeigte gleichzeitig zwei
      # echte llama-server-Prozesse aus dem ollama-Verzeichnis (einer mit
      # 6321 MiB RSS) -- und OLLAMA_LOCAL wurde trotzdem false, macht rund
      # 7 GiB wirklich belegten Speicher unsichtbar fuer die Vergabe.
      #
      # Der Portname beantwortet nur noch "wer nimmt Anfragen entgegen",
      # nicht "wo liegen die Gewichte". Letzteres beantwortet wb-notbremse
      # schon fuer die Notbremse (siehe dort, MUSTER): Ollamas Modell-Laeufer
      # heissen 'ollama runner' (aeltere Fassungen) oder 'llama-server' /
      # 'llama-cli' (llama.cpp-Unterbau neuerer Fassungen). Dieselbe Frage,
      # dieselbe Suche hier -- misst, ob so ein Laeufer auf DIESER Maschine
      # lebt, statt am Namen des Port-Lauschers zu raten. Findet sich einer,
      # gehoert die Ladung dieser Maschine (Bedarfsschaltung). Findet sich
      # keiner, bleibt es beim Fremd-Urteil von oben (ssh-Portforward, 16.08.).
      # Scheitert die Messung selbst (ps nicht aufrufbar), bleibt es beim
      # dritten Fall -- UNBEKANNT, nie stillschweigend LOKAL oder FREMD.
      local laeufer
      laeufer="$(ollama_lokale_laeufer_lage)"
      case "$laeufer" in
        ja)    OLLAMA_LOCAL=true
               OLLAMA_LOADED_NOTE="Port 11434 wird von '$listener' bedient, nicht von ollama selbst — aber auf dieser Maschine laufen echte Ollama-Modell-Laeufer (Bedarfsschaltung, z. B. wb-modell-proxy als Vordertuer) — die Ladungen zaehlen als lokal" ;;
        nein)  OLLAMA_LOCAL=false
               OLLAMA_LOADED_NOTE="Port 11434 wird von '$listener' bedient, nicht von ollama, und auf dieser Maschine laeuft kein Ollama-Modell-Laeufer — die Ladungen liegen auf einer ANDEREN Maschine" ;;
        *)     OLLAMA_LOCAL=null
               OLLAMA_LOADED_NOTE="Port 11434 wird von '$listener' bedient, nicht von ollama, und ob hier ein lokaler Modell-Laeufer laeuft, war nicht zu ermitteln — die Ladungen zaehlen nicht als lokal" ;;
      esac
      ;;
  esac
  local roh
  if roh="$(curl -sf --max-time 2 http://localhost:11434/api/ps 2>/dev/null)"; then
    OLLAMA_LOADED_JSON="$(printf '%s' "$roh" \
      | jq -c '[.models[]? | {name: .name, size_mib: ((.size // 0) / 1048576 | floor), expires_at: (.expires_at // null)}]' \
      2>/dev/null || echo "")"
    if [ -z "$OLLAMA_LOADED_JSON" ] || [ "$OLLAMA_LOADED_JSON" = "null" ]; then
      OLLAMA_LOADED_JSON="[]"
      note_add "/api/ps antwortete, aber nicht als lesbares JSON"
    fi
  else
    # Der Server hat gerade noch auf 'ollama ps' geantwortet -- hier koennte
    # also etwas geladen sein, das diese Antwort nicht zeigt. UNBEKANNT, nicht
    # "nichts geladen": genau die Unterscheidung, die dieser Nachtrag bringt.
    OLLAMA_LOADED_JSON="[]"
    note_add "der Server antwortet auf 'ollama ps', /api/ps aber nicht (in 2s)"
  fi
}

if [ "$OS" = "Linux" ]; then
  MACHINE="peer"; [ "$HOST" = "Peer-Rechner" ] || MACHINE="$(printf '%s' "$HOST" | tr 'A-Z' 'a-z')"
  GPU_KIND="cuda"

  RAM_TOTAL=$(( $(awk '/^MemTotal:/{print $2}' /proc/meminfo) / 1024 ))
  RAM_FREE=$(( $(awk '/^MemAvailable:/{print $2}' /proc/meminfo) / 1024 ))

  if command -v nvidia-smi >/dev/null 2>&1; then
    read -r VRAM_FREE VRAM_TOTAL GPU_UTIL < <(
      nvidia-smi --query-gpu=memory.free,memory.total,utilization.gpu \
        --format=csv,noheader,nounits 2>/dev/null | head -1 | awk -F', ' '{print $1, $2, $3}')
    : "${VRAM_FREE:=0}" "${VRAM_TOTAL:=0}" "${GPU_UTIL:=0}"
    GPU_PROCS_JSON="$(nvidia-smi --query-compute-apps=pid,process_name,used_memory \
        --format=csv,noheader,nounits 2>/dev/null \
      | jq -R -s 'split("\n")|map(select(length>0))
                  |map(split(", ")|{pid:(.[0]|tonumber?),name:.[1],used_mib:(.[2]|tonumber?)})' 2>/dev/null || echo "[]")"
    [ -n "$GPU_PROCS_JSON" ] || GPU_PROCS_JSON="[]"
  fi

  # PROTECTED: a protected service (RoBERTa Polarschern veto for a machine-bound project)
  news_act=""
  if command -v systemctl >/dev/null 2>&1; then
    news_act="$(systemctl --user is-active a protected service 2>/dev/null || true)"
  fi
  [ "${CR_ASSUME_NEWS_CLF_ACTIVE:-0}" = "1" ] && news_act="active"
  if [ "$news_act" = "active" ]; then
    PROTECTED_ACTIVE=1; PROTECTED_NAMES="a protected service"
    news_pids="$(nvidia-smi --query-compute-apps=pid,process_name,used_memory \
        --format=csv,noheader,nounits 2>/dev/null | awk -F', ' '/news-llm/{print $1}' | paste -sd, - 2>/dev/null || true)"
    PROTECTED_JSON="$(jq -n --arg n a protected service --arg pids "${news_pids:-}" \
      --arg d "systemd user service a protected service — RoBERTa Polarschern veto for a machine-bound project; ~5.6 GB VRAM resident at market-open; NEVER stop it" \
      '[{name:$n, active:true, detail:$d, pids:($pids|split(",")|map(select(length>0)|tonumber?))}]')"
  fi

  collect_ollama

elif [ "$OS" = "Darwin" ]; then
  MACHINE="mac"
  GPU_KIND="unified"
  VRAM_NOTE="unified memory — MLX/Metal share system RAM; free RAM is the VRAM proxy"

  # WAS "FREI" AUF EINEM MAC HEISST (korrigiert 2026-08-21).
  #
  # Bis heute stand hier frei + inaktiv + spekulativ + freigebbar. Diese Summe
  # laesst einen ganzen Posten aus: DATEI-GESTUETZTE SEITEN, die gerade AKTIV
  # sind. Das sind Kopien von Dateien -- Programmcode, gelesene Modelldateien,
  # Caches --, und macOS wirft sie unter Druck weg, ohne dass irgendjemand etwas
  # verliert; ihr Inhalt steht auf der Platte. Sie als belegt zu zaehlen, macht
  # die Maschine auf dem Papier voller, als sie ist.
  #
  # Befund des Nutzers, der das ausgeloest hat: "der verfuegbare speicher ist immer
  # zu niedrig angesetzt ... da sind die ganze zeit fast 40gb frei wenn gerade
  # kein modell geladen ist". Gemessen im Ruhezustand am 21.08., ohne geladenes
  # Modell, auf dieser Maschine mit 48 GiB:
  #
  #   alte Formel  38279 MiB      frei 30420 + inaktiv 5101 + spekulativ 2642
  #   neue Formel  40819 MiB      gesamt - anonym 4166 - wired 3781 - Kompressor 386
  #   memory_pressure sagte gleichzeitig "System-wide memory free percentage: 90"
  #   iogpu.wired_limit_mb = 43008, davon 39227 MiB noch nicht gewired
  #
  # Drei unabhaengige Quellen nennen also rund 39 bis 43 GiB, die alte Formel
  # 37,4 GiB. Die neue trifft zusaetzlich des Nutzers "fast 40 GB" auf den Punkt.
  #
  # DAS IST KEINE NEUE ERFINDUNG, SONDERN DIE ANGLEICHUNG AN DEN LINUX-ZWEIG
  # DIESER DATEI. Dort steht seit jeher MemAvailable, und genau das rechnet der
  # Kernel so: verfuegbar ist, was ohne Verlust wiederbeschafft werden kann.
  # macOS war der Sonderfall, nicht Linux.
  #
  # UNVERZICHTBAR sind nur drei Posten: anonymer Speicher (Heap, Stack,
  # Metal-Puffer -- steht nirgends sonst), Gewired und der Kompressor. Alles
  # andere ist Kopie.
  #
  # Die alte Zahl geht nicht verloren: sie steht weiter im JSON, als
  # `ram.free_strict_mib`, zusammen mit den Bestandteilen. Wer die vorsichtigere
  # Rechnung braucht, findet sie dort -- niemand muss sie nachbauen.
  PAGE="$(sysctl -n hw.pagesize)"; MEMSIZE="$(sysctl -n hw.memsize)"
  vms="$(vm_stat)"
  getp() { printf '%s\n' "$vms" | awk -v k="$1" '$0 ~ k {gsub("[^0-9]","",$NF); print $NF; exit}'; }
  FREEP="$(getp 'Pages free')";        : "${FREEP:=0}"
  INACT="$(getp 'Pages inactive')";    : "${INACT:=0}"
  SPEC="$(getp 'Pages speculative')";  : "${SPEC:=0}"
  PURGE="$(getp 'Pages purgeable')";   : "${PURGE:=0}"
  ANON="$(getp 'Anonymous pages')";    : "${ANON:=0}"
  FILEP="$(getp 'File-backed pages')"; : "${FILEP:=0}"
  WIRED="$(getp 'Pages wired down')";  : "${WIRED:=0}"
  COMPR="$(getp 'Pages occupied by compressor')"; : "${COMPR:=0}"
  RAM_TOTAL=$(( MEMSIZE / 1048576 ))
  STRICT_PAGES=$(( FREEP + INACT + SPEC + PURGE ))
  RAM_FREE_STRICT=$(( STRICT_PAGES * PAGE / 1048576 ))
  RAM_FREE=$(( RAM_TOTAL - (ANON + WIRED + COMPR) * PAGE / 1048576 ))
  # Faellt eines der neuen Felder aus (eine kuenftige macOS-Fassung koennte eine
  # Zeile umbenennen), waere RAM_FREE ploetzlich fast der ganze Speicher -- die
  # gefaehrliche Richtung. Dann gilt wieder die alte, vorsichtige Zahl.
  if [ "$ANON" -eq 0 ] || [ "$WIRED" -eq 0 ] || [ "$RAM_FREE" -gt "$RAM_TOTAL" ]; then
    RAM_FREE="$RAM_FREE_STRICT"
    RAM_NOTE_FREI="vm_stat lieferte keine brauchbaren Anonymous/Wired-Zeilen — zurueck auf die vorsichtige Formel"
  fi
  [ "$RAM_FREE" -lt 0 ] && RAM_FREE=0
  RAM_FILEBACKED=$(( FILEP * PAGE / 1048576 ))
  RAM_ANON=$(( ANON * PAGE / 1048576 ))
  RAM_WIRED=$(( WIRED * PAGE / 1048576 ))
  RAM_COMPRESSOR=$(( COMPR * PAGE / 1048576 ))
  # Der Deckel, den der Treiber selbst fuer gewired GPU-Speicher nennt. Auf
  # diesem Geraet 43008 MiB = 42,0 GiB, dieselbe Zahl, die vllm-metal als
  # max_recommended_working_set_size meldet. 0 heisst "kein eigener Deckel
  # gesetzt"; dann bleibt das Feld leer statt eine Null zu behaupten.
  GPU_WIRED_LIMIT="$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || true)"
  case "$GPU_WIRED_LIMIT" in ''|0|*[!0-9]*) GPU_WIRED_LIMIT="" ;; esac
  VRAM_TOTAL="$RAM_TOTAL"; VRAM_FREE="$RAM_FREE"

  # Echte GPU-Auslastung, rund 18 ms. Bis 2026-08-07 stand hier nichts und das
  # Feld meldete konstant 0 — ein Sweep, der darauf abbricht, bricht immer ab.
  # `|| true` ist Pflicht: unter `set -euo pipefail` reisst ein fehlendes ioreg
  # (oder das SIGPIPE von `head -1`) sonst den ganzen Befehl mit.
  GPU_UTIL="$(ioreg -r -d 1 -w 0 -c AGXAccelerator 2>/dev/null \
    | sed -n 's/.*"Device Utilization %"=\([0-9][0-9]*\).*/\1/p' | head -1 || true)"

  # Test hook works cross-platform even though a protected service lives on peer.
  if [ "${CR_ASSUME_NEWS_CLF_ACTIVE:-0}" = "1" ]; then
    PROTECTED_ACTIVE=1; PROTECTED_NAMES="a protected service"
    PROTECTED_JSON='[{"name":"a protected service","active":true,"detail":"forced active via CR_ASSUME_NEWS_CLF_ACTIVE (test hook)","pids":[]}]'
  fi

  collect_ollama
else
  MACHINE="$(printf '%s' "$HOST" | tr 'A-Z' 'a-z')"
  GPU_KIND="unknown"
fi

emit_json() {
  jq -n \
    --arg machine "$MACHINE" --arg os "$(printf '%s' "$OS" | tr 'A-Z' 'a-z')" \
    --arg host "$HOST" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg gpukind "$GPU_KIND" --arg vnote "$VRAM_NOTE" --arg ollnote "$OLLAMA_NOTE" \
    --arg ollloadednote "$OLLAMA_LOADED_NOTE" --argjson olllocal "${OLLAMA_LOCAL:-null}" \
    --argjson vfree "${VRAM_FREE:-0}" --argjson vtotal "${VRAM_TOTAL:-0}" --argjson gutil "${GPU_UTIL:-null}" \
    --argjson rfree "${RAM_FREE:-0}" --argjson rtotal "${RAM_TOTAL:-0}" \
    --argjson rstrict "${RAM_FREE_STRICT:-null}" --argjson rfile "${RAM_FILEBACKED:-null}" \
    --argjson ranon "${RAM_ANON:-null}" --argjson rwired "${RAM_WIRED:-null}" \
    --argjson rcompr "${RAM_COMPRESSOR:-null}" \
    --argjson gpulimit "${GPU_WIRED_LIMIT:-null}" --arg rfreenote "${RAM_NOTE_FREI:-}" \
    --argjson gpuprocs "$GPU_PROCS_JSON" --argjson ollama "$OLLAMA_JSON" --argjson ollamaloaded "${OLLAMA_LOADED_JSON:-[]}" \
    --argjson protected "$PROTECTED_JSON" \
    '{machine:$machine, os:$os, hostname:$host, timestamp:$ts,
      vram:{kind:$gpukind, free_mib:$vfree, total_mib:$vtotal, gpu_util_pct:$gutil, note:$vnote},
      ram:{free_mib:$rfree, total_mib:$rtotal,
           free_strict_mib:$rstrict, filebacked_mib:$rfile, anon_mib:$ranon,
           wired_mib:$rwired, compressor_mib:$rcompr,
           gpu_wired_limit_mib:$gpulimit, free_note:$rfreenote},
      gpu_procs:$gpuprocs,
      ollama_models:$ollama, ollama_loaded:$ollamaloaded, ollama_note:$ollnote,
      ollama_loaded_note:$ollloadednote, ollama_local:$olllocal,
      protected:$protected}'
}

case "$MODE" in
  json) emit_json ;;
  guard)
    printf 'MACHINE=%s\n' "$MACHINE"
    printf 'GPU_KIND=%s\n' "$GPU_KIND"
    printf 'VRAM_FREE_MIB=%s\n' "${VRAM_FREE:-0}"
    printf 'VRAM_TOTAL_MIB=%s\n' "${VRAM_TOTAL:-0}"
    printf 'RAM_FREE_MIB=%s\n' "${RAM_FREE:-0}"
    printf 'RAM_TOTAL_MIB=%s\n' "${RAM_TOTAL:-0}"
    printf 'PROTECTED_ACTIVE=%s\n' "$PROTECTED_ACTIVE"
    printf 'PROTECTED_NAMES=%s\n' "$PROTECTED_NAMES"
    ;;
  human)
    echo "machine : $MACHINE ($HOST, $(printf '%s' "$OS" | tr 'A-Z' 'a-z'))"
    if [ -n "$GPU_UTIL" ]; then UTIL_TXT="util ${GPU_UTIL}%"; else UTIL_TXT="util nicht gemessen"; fi
    if [ "$GPU_KIND" = "unified" ]; then
      echo "GPU     : unified memory (MLX/Metal share RAM), $UTIL_TXT"
      echo "  free  : ${VRAM_FREE} MiB / ${VRAM_TOTAL} MiB total"
    else
      echo "GPU     : $GPU_KIND, $UTIL_TXT"
      echo "  VRAM  : ${VRAM_FREE} MiB free / ${VRAM_TOTAL} MiB total"
    fi
    echo "RAM     : ${RAM_FREE} MiB free / ${RAM_TOTAL} MiB total"
    if [ -n "${RAM_FREE_STRICT:-}" ]; then
      echo "  streng: ${RAM_FREE_STRICT} MiB (frei+inaktiv+spekulativ+freigebbar) — die Differenz sind"
      echo "          datei-gestuetzte Seiten, die macOS jederzeit verwirft"
    fi
    [ -n "${GPU_WIRED_LIMIT:-}" ] && echo "  GPU     : Deckel ${GPU_WIRED_LIMIT} MiB (iogpu.wired_limit_mb), davon ${RAM_WIRED:-0} MiB gewired"
    echo "ollama  : $(printf '%s' "$OLLAMA_JSON" | jq -r 'if length>0 then join(", ") else "-" end') ${OLLAMA_NOTE:+($OLLAMA_NOTE)}"
    if [ -n "$OLLAMA_LOADED_NOTE" ]; then
      echo "  Groessen nicht lesbar: $OLLAMA_LOADED_NOTE"
    fi
    echo "gpuproc : $(printf '%s' "$GPU_PROCS_JSON" | jq -r 'if length>0 then map("\(.name|split("/")|last) pid=\(.pid) \(.used_mib)MiB")|join(", ") else "-" end')"
    if [ "$PROTECTED_ACTIVE" = 1 ]; then
      echo "PROTECT : $PROTECTED_NAMES ACTIVE — never stop (ask the user before any displacement)"
    else
      echo "PROTECT : none active"
    fi
    ;;
esac
