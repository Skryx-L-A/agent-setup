# auseinander, und dieses Werkzeug meldete "Nichts zu tun".
# Beide Seiten liefern "<datei>  <hash>", je Zeile eine Datei, gleich sortiert.
# Kein Shell-Loop ueber ssh: `ssh host 'skript' arg` haengt das Argument einfach
# an die Kommandozeile an, es wird NICHT zu $0/$1 wie bei `sh -c` (gemessen —
# der erste Anlauf meldete deshalb "FEHLT dort" fuer ein Verzeichnis, das dort
# vollstaendig vorhanden war).
manifest_local()  { # $1 = relativer Pfad
  ( cd "$HOME/$1" 2>/dev/null || exit 0; find . -type f ! -path './__pycache__/*' ! -name '*.pyc' -exec shasum -a 256 {} + 2>/dev/null ) \
    | awk '{h=$1; sub(/^\.\//,"",$2); print $2"  "h}' | LC_ALL=C sort
}
manifest_remote() { # $1 = relativer Pfad
  ssh_other "cd \$HOME/$1 2>/dev/null && find . -type f ! -path './__pycache__/*' ! -name '*.pyc' -exec sha256sum {} + 2>/dev/null" 2>/dev/null \
    | awk '{h=$1; sub(/^\.\//,"",$2); print $2"  "h}' | LC_ALL=C sort
}

# Eintraege eines Link-Verzeichnisses, je Zeile "<name> L <ziel>" (Symlink) oder
# "<name> F <hash> <x|->" (Datei, x = ausfuehrbar), sortiert. Dasselbe POSIX-sh-Skript laeuft
# hier und per ssh drueben (Linux sha256sum bzw. macOS shasum). `._*` (AppleDouble-Reste)
# zaehlt nicht.
linkdir_script() { # $1 = relativer Pfad
  cat <<EOS
cd "\$HOME/$1" 2>/dev/null || exit 0
for e in ./* ./.[!.]*; do
  { [ -e "\$e" ] || [ -L "\$e" ]; } || continue
  n=\${e#./}
  case "\$n" in ._*) continue ;; esac
  if [ -L "\$e" ]; then echo "\$n L \$(readlink "\$e")"
  elif [ -f "\$e" ]; then
    h=\$( (sha256sum "\$e" 2>/dev/null || shasum -a 256 "\$e") | cut -d' ' -f1 )
    if [ -x "\$e" ]; then x=x; else x=-; fi
    echo "\$n F \$h \$x"
  fi
done | LC_ALL=C sort
EOS
}
linkdir_local()  { sh -c "$(linkdir_script "$1")"; }
linkdir_remote() { ssh_other "$(linkdir_script "$1")" 2>/dev/null; }

for d in "${DIRS[@]}"; do
  [ -d "$HOME/$d" ] || continue
  lman="$(manifest_local "$d")"
  rman="$(manifest_remote "$d")"
  ln=$(printf '%s\n' "$lman" | grep -c .)
  if [ -z "$rman" ]; then
    echo "  FEHLT dort   $d/  ($ln Dateien hier)"; missing+=("$d")
  elif [ "$lman" != "$rman" ]; then
    # Welche Dateien genau — sonst steht da nur "irgendwas ist anders".
    abw="$(diff <(printf '%s\n' "$lman") <(printf '%s\n' "$rman") 2>/dev/null \
           | awk '/^</{print $2}' | LC_ALL=C sort -u | tr '\n' ' ')"
    echo "  ABWEICHEND   $d/  — ${abw:-Inhalt weicht ab}"; diffs+=("$d")
  fi
done

# Link-Verzeichnisse: je Eintrag der Quellseite vergleichen (Name, Art, Hash/Ziel, +x).
linkdir_todo=()    # "<verzeichnis>|<name>|<art>|<ziel oder x|->" -- was zu uebertragen ist
for d in "${LINKDIRS[@]}"; do
  [ -d "$HOME/$d" ] || continue
  lman="$(linkdir_local "$d")"
  rman="$(linkdir_remote "$d")"
  if [ -z "$rman" ]; then
    echo "  FEHLT dort   $d/  ($(printf '%s\n' "$lman" | grep -c .) Eintraege hier)"
    missing+=("$d")
  fi
  abw=()
  while IFS= read -r zeile; do
    [ -n "$zeile" ] || continue
    name="${zeile%% *}"
    grep -qxF -- "$zeile" <<<"$rman" && continue
    abw+=("$name")
    linkdir_todo+=("$d|$zeile")
  done <<<"$lman"
  if [ -n "$rman" ] && [ "${#abw[@]}" -gt 0 ]; then
    echo "  ABWEICHEND   $d/  — ${abw[*]}"; diffs+=("$d")
  fi
done

# Nur-dorthin-Dateien: Quelle ist das Repo, Ziel ist eine bestimmte Maschine. Sie
# stehen in einer EIGENEN Liste, weil der Vergleich oben zwei Annahmen macht, die hier
# beide nicht gelten: dass die Quelle unter $HOME liegt und dass beide Maschinen
# dieselbe Datei haben wollen.
remote_only_todo=()
for e in ${REMOTE_ONLY[@]+"${REMOTE_ONLY[@]}"}; do
  ziel="${e%%|*}"; rest="${e#*|}"; quelle="${rest%%|*}"; zielpfad="${rest#*|}"
  [ "$ziel" = "$OTHER" ] || continue
  # Kein Repo gefunden: dann gibt es hier nichts zu sagen. Eine Meldung waere reines
  # Rauschen in jedem Lauf, der ausserhalb eines Arbeitsbaums stattfindet, und der
  # Zustand ist genau der von vorher — nur-dorthin-Dateien wandern dann nicht mit.
  [ -d "$WB_REPO" ] || continue
  if [ ! -f "$WB_REPO/$quelle" ]; then
    echo "  FEHLT hier   $quelle (im Repo $WB_REPO) — nichts zu uebertragen"
    continue
  fi
  l=$(shasum -a 256 "$WB_REPO/$quelle" 2>/dev/null | cut -d' ' -f1)
  r=$(hash_remote "$zielpfad")
  if [ "$r" = MISSING ]; then
    echo "  FEHLT dort   $zielpfad  (nur dorthin, aus $quelle)"; remote_only_todo+=("$e")
  elif [ "$l" != "$r" ]; then
    echo "  ABWEICHEND   $zielpfad  (nur dorthin, aus $quelle)"; remote_only_todo+=("$e")
  fi
done

echo
echo "Nur gemeldet, nie kopiert (maschinenabhaengig):"
for f in "${REPORT_ONLY[@]}"; do
  l=$(hash_local "$f"); r=$(hash_remote "$f")
  [ "$l" = MISSING ] && continue
  if [ "$r" = MISSING ]; then echo "  FEHLT dort   $f"
  elif [ "$l" != "$r" ]; then echo "  ABWEICHEND   $f  — von Hand angleichen"
  fi
done

# Werkbank-Skills (skills.<name>.quelle in werkzeuge.default.json, Review wz-integ2 M1): auf dem
# Ziel muss ~/.claude/skills/<name> ein Link auf den Skill-Ordner neben der installierten Quelle
# sein. Der Schreiber ist dort `wb-werkzeuge skills-anlegen` (dieselbe Logik wie wb-ausrollen hier);
# eine fremde Fassung (auf peer lag eine lange) kommt dabei in dessen Snapshot und wird ersetzt
# (Entscheidung WorkbenchOrchestrator 13.10.; nie ohne Snapshot, der Ersatz wird mit Snapshot-Pfad
# gemeldet). Ein Ziel ohne diesen Befehl (alte Fassung) liefert nichts; nach dem Uebertragen der neuen
# Fassung laeuft er unten trotzdem. Fehler und unerwartete Ausgabe (etwa ein Traceback) bleiben
# sichtbar (Review wz-integ3, Fund 5): stderr wird mitgelesen, nur GLEICH-Zeilen entfallen.
skill_plan="$(ssh_other '[ ! -x "$HOME/.local/bin/wb-werkzeuge" ] || "$HOME/.local/bin/wb-werkzeuge" skills-anlegen --dry-run' 2>&1 \
  | grep -vE '^(GLEICH  |keine Werkbank-Skills)' || true)"
skill_todo=0
if [ -n "$skill_plan" ]; then
  echo
  echo "Werkbank-Skills dort (Link in ~/.claude/skills; Stand vor dem Uebertragen):"
  while IFS= read -r zeile; do echo "  SKILL dort   ${zeile#WUERDE ANGELEGT  }"; done <<<"$skill_plan"
  skill_todo=1
fi

n=$(( ${#diffs[@]} + ${#missing[@]} + ${#remote_only_todo[@]} + skill_todo ))
echo
if [ "$n" -eq 0 ]; then
  echo "Nichts zu tun."
  exit 0
fi
if [ "$APPLY" != 1 ]; then
  echo "$n Posten. Zum Uebertragen: wb-sync-setup --apply"
  exit 1
fi

echo "Uebertrage $n Posten nach $OTHER ..."

# Snapshot VOR dem Ueberschreiben (Haus-Regel): die alte Fassung jedes Postens, den es auf
# dem Ziel schon gibt, kommt nach ~/.local/trash-snapshots/<Datum>-sync-setup/ AUF DEM ZIEL.
# Gibt es dort heute schon einen Snapshot (zweiter Lauf am selben Tag), bekommt dieser
# Lauf einen eigenen Ordner mit Uhrzeit -- der erste bleibt unveraendert.
SNAP=""
snap_init() {
  [ -n "$SNAP" ] && return 0
  SNAP="$(ssh_other 'd="$HOME/.local/trash-snapshots/$(date +%F)-sync-setup"; [ -e "$d" ] && d="$d-$(date +%H%M%S)"; mkdir -p "$d" && echo "$d"' 2>/dev/null)"
  [ -n "$SNAP" ]
}
# $1 = Pfad relativ zu $HOME; sichert ihn (Datei, Link oder Ordner), falls er drueben existiert.
snap_item() {
  snap_init || return 1
  ssh_other "src=\$HOME/$1; if [ -e \"\$src\" ] || [ -L \"\$src\" ]; then mkdir -p \"$SNAP/\$(dirname $1)\" && cp -a \"\$src\" \"$SNAP/$1\"; fi" 2>/dev/null
}

# bash 3.2 (macOS) behandelt ein LEERES Array unter `set -u` als ungesetzt und
# bricht ab — deshalb die +-Ersetzung, die bei leerem Array gar nichts einsetzt.
for p in ${missing[@]+"${missing[@]}"} ${diffs[@]+"${diffs[@]}"}; do
  case " ${LINKDIRS[*]} " in *" $p "*) continue ;; esac   # Link-Verzeichnisse: unten
  if [ -d "$HOME/$p" ]; then
    snap_item "$p" || { echo "  FEHLER  $p/  (Snapshot auf $OTHER fehlgeschlagen — nicht uebertragen)"; continue; }
    ssh_other "mkdir -p \$HOME/$p" 2>/dev/null
    scp -q -r "$HOME/$p/." "$OTHER:~/$p/" && echo "  ok  $p/"
  else
    snap_item "$p" || { echo "  FEHLER  $p  (Snapshot auf $OTHER fehlgeschlagen — nicht uebertragen)"; continue; }
    ssh_other "mkdir -p \$(dirname \$HOME/$p)" 2>/dev/null
    scp -q "$HOME/$p" "$OTHER:~/$p" && echo "  ok  $p"
    case "$p" in .local/bin/*|*.sh) ssh_other "chmod +x \$HOME/$p" 2>/dev/null ;; esac
  fi
done

# Link-Verzeichnisse: Links als Links, Dateien mit ihrem +x. Vorher wird der Zieleintrag
# entfernt: scp auf einen vorhandenen Symlink schriebe sonst DURCH den Link in dessen Ziel
# (ein Hook-Name, der noch auf _verteiler zeigt, wuerde den Verteiler ueberschreiben).
for e in ${linkdir_todo[@]+"${linkdir_todo[@]}"}; do
  d="${e%%|*}"; zeile="${e#*|}"
  name="${zeile%% *}"; rest="${zeile#* }"; art="${rest%% *}"; wert="${rest#* }"
  snap_item "$d/$name" || { echo "  FEHLER  $d/$name  (Snapshot auf $OTHER fehlgeschlagen — nicht uebertragen)"; continue; }
  ssh_other "mkdir -p \$HOME/$d" 2>/dev/null
  if [ "$art" = L ]; then
    ssh_other "rm -f \$HOME/$d/$name && ln -s '$wert' \$HOME/$d/$name" 2>/dev/null \
      && echo "  ok  $d/$name  (Link -> $wert)" || echo "  FEHLER  $d/$name"
  else
    modus=644; [ "${wert#* }" = x ] && modus=755
    ssh_other "rm -f \$HOME/$d/$name" 2>/dev/null
    if scp -q "$HOME/$d/$name" "$OTHER:~/$d/$name" && ssh_other "chmod $modus \$HOME/$d/$name" 2>/dev/null; then
      echo "  ok  $d/$name  (Datei, $modus)"
    else
      echo "  FEHLER  $d/$name"
    fi
  fi
done

for e in ${remote_only_todo[@]+"${remote_only_todo[@]}"}; do
  rest="${e#*|}"; quelle="${rest%%|*}"; zielpfad="${rest#*|}"
  snap_item "$zielpfad" || { echo "  FEHLER  $zielpfad  (Snapshot auf $OTHER fehlgeschlagen — nicht uebertragen)"; continue; }
  ssh_other "mkdir -p \$(dirname \$HOME/$zielpfad)" 2>/dev/null
  scp -q "$WB_REPO/$quelle" "$OTHER:~/$zielpfad" || { echo "  FEHLER  $zielpfad"; continue; }
  # Ausfuehrungsrecht ausdruecklich setzen: scp uebertraegt den Modus nicht zuverlassig,
  # und eine Datei in ~/.local/bin ohne +x ist ein stiller Ausfall.
  ssh_other "chmod 755 \$HOME/$zielpfad" 2>/dev/null
  echo "  ok  $zielpfad  (nur dorthin, aus $quelle)"
done
# Skill-Links zuletzt: erst jetzt liegen Quelle und Skill-Ordner in ihrer neuen Fassung drueben.
skill_aus="$(ssh_other '[ ! -x "$HOME/.local/bin/wb-werkzeuge" ] || "$HOME/.local/bin/wb-werkzeuge" skills-anlegen' 2>&1)"
skill_rc=$?
skill_aus="$(printf '%s\n' "$skill_aus" | grep -vE '^(GLEICH  |keine Werkbank-Skills|$)' || true)"
[ -n "$skill_aus" ] && while IFS= read -r zeile; do echo "  skill  $zeile"; done <<<"$skill_aus"
[ "$skill_rc" -eq 0 ] || echo "  FEHLER  Werkbank-Skills auf $OTHER: skills-anlegen Exit $skill_rc (Zeilen oben)"
echo
[ -n "$SNAP" ] && echo "Alte Fassungen gesichert nach $OTHER:$SNAP"
echo "Uebertragen. NICHT automatisch angeglichen: settings.json, AGENTS.md und CLAUDE.md —"
echo "die tragen maschinenabhaengige Teile und wollen von Hand nachgezogen werden."
echo "Haben sich die Rollen geaendert: auf $OTHER danach 'wb-instructions sync' laufen lassen"
echo "(die Rollen sind seine Quelle; er erzeugt daraus die Einstiegsdateien der Harnesses);"
echo "wb-ausrollen auf $OTHER erledigt das als festen Schritt."
[ "$skill_rc" -eq 0 ] || exit 1
