#!/bin/bash
# wb-sync-setup — gleicht das Claude-Setup zwischen Mac und peer ab.
#
# Anlass (2026-08-03): Ein Audit auf peer fand, dass die Maschine beim Setup weit
# zurueckhing — `~/.claude/regeln/` gab es dort gar nicht, drei neue Werkzeuge fehlten,
# `context-guard` war die Fassung vom 25.07., zwei Hooks fehlten. Der Vault wird per git
# und Syncthing abgeglichen, das Setup dagegen von Hand, also gar nicht. Das hier macht
# den Abgleich wiederholbar statt einmalig.
#
#   wb-sync-setup            zeigt, was auseinanderlaeuft (aendert NICHTS)
#   wb-sync-setup --apply    kopiert die Unterschiede zur anderen Maschine
#   wb-sync-setup --to peer  Ziel erzwingen (Default: die jeweils ANDERE Maschine)
#
# WAS ABGEGLICHEN WIRD: Werkzeuge (~/.local/bin), Hooks, Regeldateien (~/.claude/regeln),
# die Rollen (~/.claude/roles/orchestrator.md und agent.md) und ~/.claude/git-hooks.
#   - Die Rollen sind QUELLEN, keine erzeugte Ausgabe: `wb-instructions sync` liest sie nur
#     (siehe dessen Kopf) und leitet daraus die Einstiegsdateien der Harnesses ab. Sie
#     tragen keine Maschinenangabe, deshalb werden sie kopiert; auf dem Ziel erzeugen liesse
#     sich nichts, es gibt auf der Zielmaschine keine andere Quelle. Danach gehoert
#     `wb-instructions sync` auf dem Ziel (erzeugt dessen abgeleitete Dateien neu).
#   - ~/.claude/git-hooks ist ein Verzeichnis aus EINER Datei (`_verteiler`) und je Git-Hook-
#     Name einem Symlink darauf. Verglichen werden Name, Art (Datei/Link), Hash bzw.
#     Link-Ziel und das Ausfuehrungsrecht; uebertragen werden Links als Links und Dateien
#     mit demselben +x. Fremde Ablage auf dem Ziel (`._*`-Reste von macOS-Archiven) wird
#     weder verglichen noch angefasst.
#   - Bevor --apply auf dem Ziel etwas ueberschreibt, kommt die alte Fassung nach
#     ~/.local/trash-snapshots/<Datum>-sync-setup/ (dort, auf dem Ziel). Schlaegt der
#     Snapshot fehl, wird dieser Posten NICHT uebertragen.
#
# WAS NICHT SYNCHRONISIERT WIRD, und warum:
#   - `~/.claude/settings.json`: enthaelt maschinenabhaengige Pfade und Hook-Listen.
#     Der Abgleich zeigt Unterschiede an, kopiert die Datei aber nie — ein blind
#     ueberschriebenes settings.json kann die Zielmaschine handlungsunfaehig machen.
#   - `CLAUDE.md` und `AGENTS.md`: `CLAUDE.md` traegt oben die Maschinenbeschreibung
#     ("Machine: MacBook Pro ..." bzw. "Machine: Peer-Rechner ..."); beide stehen in der Umstellung
#     (AGENTS.md ist die kuenftige Regelquelle). Werden nur GEMELDET, nie kopiert.
#   - `IDENTITY.md`, alles unter `secrets/`: per Definition maschinenlokal.
set -uo pipefail

case "$(uname -s)" in Darwin) SELF=mac; OTHER=peer ;; *) SELF=peer; OTHER=mac ;; esac
APPLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1 ;;
    --to) OTHER="${2:?Ziel}"; shift ;;
    *) echo "unbekannt: $1" >&2; exit 1 ;;
  esac
  shift
done
[ "$OTHER" = "$SELF" ] && { echo "Ziel ist diese Maschine selbst." >&2; exit 1; }

