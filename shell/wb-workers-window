#!/bin/bash
# wb-workers-window <session> [window-name] — make sure a worker-tab window of
# a workbench session exists, with a placeholder pane while no worker runs yet.
# [window-name] defaults to `workers` (the first window, unchanged behaviour for
# every existing caller that omits it). Pass `workers-2`, `workers-3`, ... for a
# further one (2026-08-04) -- same mechanism, same placeholder contract, a
# different window name. Seit dem 03.09.2026 ist das der Normalfall und nicht
# mehr der Ueberlauf: im Layout 'window' bekommt JEDER Worker sein eigenes
# Fenster, wb-grid ruft dieses Werkzeug also einmal je Worker (siehe den Kopf
# von shell/wb-grid fuer den Grund).
#
# Why this exists (measured 2026-07-25, isolated socket): the worker tab attaches
# to the GROUPED session `<sess>-view`, and sessions of a group share their
# windows — including their destruction. Killing the last shared window destroys
# BOTH sessions and, with the last session, the tmux server. Before the first
# worker is spawned there is no `workers` window, so the group consists of the
# ONE orchestrator window: the worker tab then shows the orchestrator's Claude
# pane, and closing "its" window takes the orchestrator down with it.
#
# A permanent `workers` window fixes both halves: the group never has just one
# window, and the tab shows what it promises instead of a second copy of the
# orchestrator. An overflow window (`workers-2`, ...) does NOT need the same
# danger fixed a second time -- the group already has >= 2 windows once one
# exists, so it only needs the placeholder/existence contract, not its own
# view-session-active-window handling (see point_view_at_workers below: only
# ever steers the view session at the PRIMARY `workers` tab, never an overflow
# one, so it does not fight over which window the tab currently shows).
#
# The placeholder pane is marked @wb_role placeholder. wb-grid never treats it as
# a worker and removes it as soon as a real worker joins the window; wb-close only
# ever closes @wb_role=worker panes, so it cannot hit it either.
set -euo pipefail

S="${1:?usage: wb-workers-window <tmux-session> [window-name]}"
WNAME="${2:-workers}"

# DER FENSTERNAME IST EIN VERTRAG, KEIN FREITEXT (2026-09-05, gemessener Vorfall).
# Am 05.09. um 08:39 lief `wb-workers-window wb-companion-299862 --no-attach` --
# eine Verwechslung mit `wb-worker-tab`, das diese Option kennt. Das Werkzeug hat
# den Namen damals ungeprueft weitergereicht, und die Folgen trafen NICHT das neue
# Fenster, sondern den Orchestrator:
#
#   1. `grep -qx "$WNAME"` las '--no-attach' als eigene Optionen und endete mit
#      einem Usage-Fehler statt mit einer Antwort -- die Existenzpruefung sagte
#      also "Fenster fehlt", ganz gleich, was da war.
#   2. `new-window -n --no-attach` legte das Fenster an, richtig benannt.
#   3. `list-panes -t "=$S:--no-attach"` fand es NICHT wieder. Ein Fenstername mit
#      fuehrendem '-' ist in tmux' Zielsyntax ein VERSATZ zum aktuellen Fenster;
#      der Rest laesst sich nicht als Zahl lesen, der Versatz wird 0, und 0
#      Fenster vom aktuellen aus ist das aktuelle -- das Orchestrator-Fenster.
#      Gemessen auf tmux 3.7c, eigener Socket: `list-panes -t '=probe:--no-attach'`
#      liefert den Pane des Fensters 'orch'.
#   4. Damit landeten `@wb_role placeholder`, der Pane-Titel 'noch keine Worker'
#      und `automatic-rename off` auf dem Claude-Pane des Orchestrators. Die
#      Werkbank fand danach kein Pane mit der Rolle 'orchestrator' mehr, ihr
#      Umschalter zeigte ins Leere, und der echte Platzhalter blieb ohne Rolle.
#
# Deshalb hier dieselbe Pruefung wie in `wb-worker-tab`: 'workers' oder
# 'workers-<N>', sonst gar nichts. Jeder echte Aufrufer (wb-grid, wb-doctor,
# wb-worker-tab, wb-revive, wb-remote-view) haelt sich ohnehin daran.
case "$WNAME" in
  workers|workers-[0-9]*) ;;
  *) echo "wb-workers-window: unerwarteter Fenstername '$WNAME' (erwartet 'workers' oder 'workers-<N>')." >&2
     exit 2 ;;
esac

# Mindesthoehe des Worker-Fensters (Betriebsbefund 19.08.2026 abends, der Nutzer,
# gemessen: alle vier Worker-Panes der Sitzung wb-AI standen auf 184x1). Ursache
# gemessen, nicht angenommen (isolierter Testsocket, Gruppensitzung mit einer
# '-view'-Schwester, ein Steuerclient haengt sich MIT WINZIGER GROESSE an --
# egal an welche der beiden Sitzungen der Gruppe, da sie dasselbe Fenster
# teilen -- und loest sich wieder): das Fenster faellt SOFORT auf die Groesse
# dieses Clients (200x50 -> 20x2 im Test) und bleibt DAUERHAFT dort stehen,
# auch wenn danach ueberhaupt kein Client mehr angehaengt ist. `window-size
# latest` (die tmux-Vorgabe, siehe show-options -g) verfolgt den zuletzt
# gesehenen Client, nicht den GROESSTEN -- ein Fenster ohne eigene Vorgabe hat
# also keinen Boden nach unten. 12 Zeilen, dieselbe Zahl wie
# app/src/main/config.ts:184 (minPaneRows, Default 12) -- dieselbe
# Entscheidung, wiederverwendet statt neu erfunden: genug fuer piIs Status-
# und Eingabezeile plus ein paar Zeilen sichtbaren Verlauf, die
# Absendepruefung braucht genau das.
MIN_ZEILEN=12

# Wird auf JEDEM Aufruf durchgesetzt, nicht nur beim Anlegen (des Nutzers
# Auftrag: "unabhaengig davon, ob ein Client es gerade anzeigt") -- ein
# bereits bestehendes Fenster, das zwischenzeitlich durch genau den oben
# gemessenen Mechanismus geschrumpft ist, wird hier wieder hochgesetzt.
# `window-size manual` MUSS vor `resize-window` stehen, sonst ueberschreibt
# der naechste "latest"-Client die gesetzte Groesse sofort wieder (gemessen,
# siehe app/src/main/tmux.ts applySizePolicy fuer dasselbe Muster). Eine
# gruppierte '-view'-Schwester braucht KEINEN eigenen Aufruf: sie teilt
# dasselbe Fenster-Objekt, eine Fenster-Option gilt fuer beide Sitzungen der
# Gruppe gleichermassen.
sichere_mindesthoehe() {   # <fenster-ziel, am besten eine window_id>
  local ziel="$1"
  tmux set-option -w -t "$ziel" window-size manual 2>/dev/null || return 0
  local hoehe
  hoehe="$(tmux display -p -t "$ziel" '#{window_height}' 2>/dev/null || true)"
  case "$hoehe" in
    ''|*[!0-9]*) return 0 ;;   # Fenster gerade nicht ansprechbar -- kein Rateversuch
  esac
  [ "$hoehe" -lt "$MIN_ZEILEN" ] && tmux resize-window -t "$ziel" -y "$MIN_ZEILEN" 2>/dev/null || true
}

# Eine SICHT-Session bekommt niemals eine eigene Sicht. Wird dieses Werkzeug mit
# '<name>-view' aufgerufen, arbeitet es auf der BASIS weiter — sonst entstehen
# Ketten wie 'wb-a project-view-view-view' (gemessen 2026-08-04: drei Glieder, alle
# mit denselben Fenstern). Die Basis ist der Gruppenname; ohne Gruppe der Name
# selbst ohne das Suffix, und zwar so oft, wie das Suffix vorkommt.
#
# Die Normalisierung ist BEDINGUNGSLOS (2026-08-04, zweiter Durchgang). Sie vorher
# nur dann anzuwenden, wenn die Basis noch existiert, liess genau den gemessenen
# Fall offen: die Basis war weg, der uebergebene Name blieb 'wb-X-view', die
# Streu-Sicht selbst existierte aber — und der naechste Schritt haette 'wb-X-view'
# als Basis fuer 'wb-X-view-view' benutzt. Ohne Basis gibt es hier nichts zu tun.
case "$S" in
  *-view)
    base="$(tmux display -p -t "=$S" '#{session_group}' 2>/dev/null)"
    case "${base:-}" in ''|=*) base="$S" ;; esac    # '=…' ist eine Streu-Sicht, keine Basis
    while [ "${base%-view}" != "$base" ]; do base="${base%-view}"; done
    [ "$base" != "$S" ] && echo "wb-workers-window: '$S' ist eine Sicht — arbeite auf '$base'." >&2
    S="$base"
    ;;
esac

# '=' anchors the target: tmux would otherwise prefix-match a foreign session.
tmux has-session -t "=$S" 2>/dev/null || exit 0

# Die GRUPPIERTE View-Session (der Worker-Tab) hat ihr EIGENES aktuelles Fenster.
# Nach einem tmux-Neustart steht sie auf dem Orchestrator-Fenster, und jeder Client,
# der sich neu anhaengt, uebernimmt das — der Worker-Tab zeigt dann den Orchestrator,
# obwohl das workers-Fenster existiert. Am 2026-07-28/29 ist der Nutzer genau darueber
# dreimal gestolpert. Deshalb wird die View-Session hier immer mitgezogen; das ist
# idempotent und beruehrt seinen ORCHESTRATOR-Tab nicht (andere Session, anderes
# aktuelles Fenster).
#
# Fehlt die View-Session ganz, wird sie hier ANGELEGT statt uebersprungen
# (2026-08-04, nach des Nutzers „Ich habe keinen Worker-Tab, den ich sehe"): sie
# entsteht sonst erst, wenn die Extension den Worker-Tab oeffnet — und nach einem
# tmux-Neustart, wie ihn der Selbstabschuss vom 03.08. erzwungen hat, existiert sie
# nicht mehr. Wer dann den Tab oeffnet, haengt an nichts. Eine losgeloeste,
# gruppierte Session kostet nichts, teilt die Fenster der Basis und ist genau das,
# woran der Tab sich anhaengt.
point_view_at_workers() {
  # Only the PRIMARY tab steers the view session's active window -- an overflow
  # tab (workers-2, ...) must not fight the primary one over which window the
  # worker tab currently shows (see header note).
  [ "$WNAME" = "workers" ] || return 0
  tmux list-windows -t "=$S" -F '#{window_name}' 2>/dev/null | grep -qx workers || return 0
  tmux has-session -t "=$S-view" 2>/dev/null || {
    # Die Existenzpruefung direkt davor ist der Kern der Sache: `new-session -t`
    # auf eine FEHLENDE Basis scheitert nicht, sondern legt eine leere Session an,
    # deren Gruppe die Zeichenkette '=<name>' ist (gemessen 2026-08-04).
    tmux has-session -t "=$S" 2>/dev/null || return 0
    tmux new-session -d -t "=$S" -s "$S-view" 2>/dev/null || return 0
    # HIER STAND BIS ZUM 16.08. `tmux set -t "=$S-view" window-size latest`. Die Zeile
    # hat nie gewirkt: `window-size` ist eine FENSTER-Option, und mit einer Session als
    # Ziel scheitert der Aufruf ("no such window") -- `2>/dev/null || true` hat es
    # verschluckt. Sie waere auch als korrekt geschriebene Zeile falsch: eine Sicht teilt
    # die FENSTER ihrer Basis, die Option ist also dieselbe wie drueben.
    #
    # Wer eine Session spiegelt, darf ihre Fenstergroesse nicht diktieren -- geschuetzt
    # wird das beim Anhaengen (`attach -f ignore-size` in wb-remote-view), nicht ueber
    # eine Option, die in das gespiegelte Fenster hineingreift.

    # Nachkontrolle: ist die Gruppe doch eine Zeichenkette geworden, war es eine
    # Streu-Session — die wird sofort wieder entfernt, statt im Grid stehenzubleiben.
    grp="$(tmux list-sessions -F '#{session_name}|#{session_group}' 2>/dev/null \
           | awk -F'|' -v v="$S-view" '$1==v{print $2; exit}')"
    case "${grp:-}" in
      =*) tmux kill-session -t "=$S-view" 2>/dev/null; return 0 ;;
    esac
  }
  tmux select-window -t "=$S-view:workers" 2>/dev/null || true
}

# Ein Fenster wird ab hier ueber seine ID angesprochen, nie ueber '<session>:<name>'
# (derselbe Vorfall wie oben): eine window_id ist in tmux' Zielsyntax eindeutig und
# kann weder als Versatz noch als Muster gelesen werden. Der Name wird nur EINMAL
# nachgeschlagen, und zwar mit einem exakten Vergleich in awk statt mit tmux'
# Namensaufloesung.
fenster_id() {   # <fenstername> -> window_id oder leer
  tmux list-windows -t "=$S" -F '#{window_id}	#{window_name}' 2>/dev/null \
    | awk -F'\t' -v n="$1" '$2==n{print $1; exit}'
}

WID="$(fenster_id "$WNAME")"
if [ -n "$WID" ]; then
  sichere_mindesthoehe "$WID"
  point_view_at_workers
  exit 0
fi

# -d: do not steal the focus of whoever runs this. The pane idles instead of
# exiting, because an exiting pane would close the window again — and an
# immediately closing window is exactly the state this script exists to prevent.
# tmux runs the command through /bin/sh: no bashisms here. `printf %q` would
# produce $'…' for the multi-line hint, which sh does not understand — the pane
# died instantly and the window vanished (seen while writing this).
HINT='\n  Noch kein Worker in dieser Session.\n\n'
HINT="$HINT"'  Der Orchestrator startet sie mit claude-worker / pi-worker,\n'
HINT="$HINT"'  sie erscheinen dann hier und dieser Hinweis verschwindet.\n\n'
#
# `-P -F '#{pane_id}'` gibt den Pane des NEUEN Fensters direkt zurueck. Ihn
# hinterher ueber den Namen zu suchen war der zweite Teil des Vorfalls vom 05.09.
# (siehe Kopf): die Suche kann auf ein anderes Fenster zeigen, und dann bekommt
# ein fremder Pane die Platzhalter-Rolle.
pane="$(tmux new-window -d -t "=$S:" -n "$WNAME" -P -F '#{pane_id}' \
  "printf '$HINT'; while :; do sleep 3600; done" 2>/dev/null || true)"
[ -n "$pane" ] || exit 0
WID="$(tmux display -p -t "$pane" '#{window_id}' 2>/dev/null || true)"
tmux set -p -t "$pane" @wb_role placeholder
tmux select-pane -t "$pane" -T 'noch keine Worker'
# global automatic-rename is on; the window must keep the contract name.
[ -n "$WID" ] && tmux set-option -w -t "$WID" automatic-rename off 2>/dev/null || true
[ -n "$WID" ] && sichere_mindesthoehe "$WID" || true
point_view_at_workers
