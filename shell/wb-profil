# ----------------------------------------------------------- spawn-argumente
def _vorbelegung_teilen(roh):
    """roh ist entweder 'model[:effort]' oder None (nichts vorbelegt) oder
    'keins' -- gibt {model, effort} oder None zurueck."""
    if not roh or roh == "keins":
        return None
    modell, effort = modell_effort_teilen(roh, "medium")
    return {"model": modell, "effort": effort}


def cmd_spawn_argumente(args):
    if args.harness not in ("claude", "pi"):
        fehler("--harness kennt '%s' nicht (erlaubt: claude, pi)" % args.harness)

    # Modell-/Fallback-Vorbelegung (docs/AGENTS-PLAN.md, "Das Fallback-Modell";
    # AUFTRAG-agents1-nr3.md Punkt 2): je Rolle aus den Einstellungen, sonst
    # (nur beim Fallback) global; --modell/--fallback am Aufruf ueberschreiben
    # beides. Ein Profil selbst traegt weder model noch fallback.
    modell_roh = args.modell or einstellung("agents.rollen.%s.modell" % args.name, None, args.base)
    fallback_roh = args.fallback or einstellung(
        "agents.rollen.%s.fallback" % args.name, None, args.base)
    if not fallback_roh:
        fallback_roh = einstellung("agents.fallbackModell", FALLBACK_VORGABE, args.base)
    modell_vorbelegung = _vorbelegung_teilen(modell_roh)
    fallback_vorbelegung = _vorbelegung_teilen(fallback_roh)
    if fallback_vorbelegung and ist_fable(fallback_vorbelegung["model"]):
        fehler("Fable ist nie ein Fallback ('%s')." % fallback_vorbelegung["model"])

    pfad = rolle_datei_finden(args.name, args, aufgabe_id=args.aufgabe)
    if not pfad:
        fehler("Rolle '%s' nicht gefunden." % args.name)
    daten, _ = frontmatter_lesen(pfad)

    # Reviewer-Befund 8: erst pruefen, sonst ist die anlegen-Pruefung (die ein
    # von Hand veraendertes Profil nicht ein zweites Mal sieht) die einzige
    # Sperre -- Exit 2, NICHTS auf stdout.
    aufgabe_freigaben = None
    if args.aufgabe:
        _, auftrag, _, _ = aufgabe_lesen(args, args.aufgabe)
        aufgabe_freigaben = auftrag.get("freigaben", {})
    verstoesse = profil_pruefen(daten, aufgabe_freigaben=aufgabe_freigaben)
    if verstoesse:
        for v in verstoesse:
            sys.stderr.write("wb-profil: %s\n" % v)
        sys.exit(2)

    tools = list(daten.get("tools") or [])
    disallowed = list(daten.get("disallowedTools") or [])
    bash_muster = list(daten.get("bash") or [])
    skills = list(daten.get("skills") or [])

    if args.harness == "claude":
        ergebnis = {
            "tools": tools, "disallowedTools": disallowed,
            "prompt_datei": pfad, "bash_muster": bash_muster,
        }
    else:
        ergebnis = {
            "tools": tools, "no_skills": True,
            "skill": [os.path.expanduser("~/.claude/skills/%s/SKILL.md" % s) for s in skills],
            "prompt_datei": pfad, "bash_muster": bash_muster,
        }
    ergebnis["modell_vorbelegung"] = modell_vorbelegung
    ergebnis["fallback_vorbelegung"] = fallback_vorbelegung
    print(json.dumps(ergebnis, ensure_ascii=False))
    return 0


# ------------------------------------------------------------------ CLI --
def main():
    gemeinsam = argparse.ArgumentParser(add_help=False)
    gemeinsam.add_argument("--base", default=os.path.expanduser("~"))
    gemeinsam.add_argument("--vorrat", default=None)
    gemeinsam.add_argument("--json", action="store_true")

    ap = argparse.ArgumentParser(prog="wb-profil")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("anlegen", parents=[gemeinsam])
    p.add_argument("name")
    p.add_argument("--bereich", required=True)
    # Kein choices= (Reviewer-Hinweis 9): siehe fehler()-Weg unten statt der
    # englischen argparse-Meldung.
    p.add_argument("--stufe", required=True)
    p.add_argument("--tools", required=True)
    p.add_argument("--bash", action="append")
    p.add_argument("--skills")
    p.add_argument("--kontextgrenze")
    p.add_argument("--absender", required=True)
    p.add_argument("--aufgabe")
    p.add_argument("--begruendung")
    p.add_argument("--projekt")
    p.add_argument("--prompt-datei", dest="prompt_datei")
    p.add_argument("--mensch-beleg", dest="mensch_beleg")
    p.set_defaults(func=cmd_anlegen)

    p = sub.add_parser("pruefen", parents=[gemeinsam])
    p.add_argument("ziel")
    p.add_argument("--aufgabe")
    p.set_defaults(func=cmd_pruefen)

    p = sub.add_parser("liste", parents=[gemeinsam])
    p.add_argument("--projekt")
    p.add_argument("--aufgabe")
