# ----------------------------------------------------- behalten/verwerfen --
def schnappschuss(datei, base):
    """Kopie der ALTEN Datei nach <base>/.local/trash-snapshots/<datum>-wb-profil/
    VOR dem Ueberschreiben (Hausregel, Auftrag Nr. 2 Punkt 4). Ein Namenskonflikt
    innerhalb desselben Tages haengt einen Zaehler an, statt den vorigen
    Schnappschuss stillschweigend zu ersetzen."""
    ziel_dir = os.path.join(base, ".local", "trash-snapshots",
                             "%s-wb-profil" % datetime.date.today().strftime("%Y%m%d"))
    os.makedirs(ziel_dir, exist_ok=True)
    basisname = os.path.basename(datei)
    kandidat = os.path.join(ziel_dir, basisname)
    n = 2
    while os.path.exists(kandidat):
        kandidat = os.path.join(ziel_dir, "%s.%d" % (basisname, n))
        n += 1
    shutil.copy2(datei, kandidat)
    return kandidat


def cmd_behalten(args):
    mensch_verlangen(args, "eine vorlaeufige Rolle behalten")
    quelle = os.path.join(vorlaeufig_verzeichnis(args, args.aufgabe), "%s.md" % args.name)
    if not os.path.isfile(quelle):
        fehler("Vorlaeufige Rolle '%s' fuer Aufgabe '%s' nicht gefunden (%s)."
               % (args.name, args.aufgabe, quelle))
    daten, rumpf = frontmatter_lesen(quelle)

    # Reviewer-Befund 4: erst pruefen, dann schreiben -- eine von Hand
    # manipulierte vorlaeufige Datei (z.B. mit einem gesperrten Werkzeug)
    # durfte bisher trotzdem global uebernommen werden.
    _, auftrag, _, _ = aufgabe_lesen(args, args.aufgabe)
    verstoesse = profil_pruefen(daten, aufgabe_freigaben=auftrag.get("freigaben", {}))
    if verstoesse:
        for v in verstoesse:
            sys.stderr.write("wb-profil: %s\n" % v)
        sys.exit(2)

    daten["stand"] = "behalten"
    g_rollen, _ = globale_wurzeln(args.base)
    ziel = os.path.join(g_rollen, "%s.md" % args.name)
    if os.path.isfile(ziel) and not args.ersetzen:
        fehler("Ziel '%s' liegt schon vor -- '--ersetzen' erzwingt das Ueberschreiben "
               "(mit Schnappschuss der alten Datei)." % ziel)
    if os.path.isfile(ziel):
        schnappschuss(ziel, args.base)
    datei_atomar_schreiben(ziel, frontmatter_schreiben(daten, rumpf))
    ausgabe(args, "wb-profil: Rolle '%s' ins globale Team uebernommen (%s)." % (args.name, ziel),
            daten={"name": args.name, "pfad": ziel})
    return 0


def cmd_verwerfen(args):
    mensch_verlangen(args, "eine vorlaeufige Rolle verwerfen")
    _, _, verlauf, _ = aufgabe_lesen(args, args.aufgabe)
    if verlauf:
        for w in verlauf.get("worker", []):
            if w.get("rolle") == args.name and w.get("zustand") == "arbeitet":
                fehler("Rolle '%s' hat noch einen arbeitenden Worker ('%s') bei Aufgabe '%s'."
                       % (args.name, w.get("name"), args.aufgabe))
    quelle = os.path.join(vorlaeufig_verzeichnis(args, args.aufgabe), "%s.md" % args.name)
    if not os.path.isfile(quelle):
        fehler("Vorlaeufige Rolle '%s' fuer Aufgabe '%s' nicht gefunden (%s)."
               % (args.name, args.aufgabe, quelle))
    os.remove(quelle)
    ausgabe(args, "wb-profil: vorlaeufige Rolle '%s' verworfen." % args.name, daten={"name": args.name})
    return 0


# ------------------------------------------------------------ hinzufuegen --
def cmd_hinzufuegen(args):
    if args.projekt:
        ziel_rollen, ziel_teams = projekt_wurzeln(args.projekt)
    else:
        ziel_rollen, ziel_teams = globale_wurzeln(args.base)

    kopiert = []

    def _kopiere(quelle, ziel):
        if os.path.isfile(ziel) and not args.ersetzen:
            print("wb-profil: '%s' liegt schon vor -- uebersprungen (--ersetzen erzwingt)." % ziel)
            return
        os.makedirs(os.path.dirname(ziel), exist_ok=True)
        shutil.copy2(quelle, ziel)
        kopiert.append(ziel)

    team_quelle = os.path.join(BIBLIOTHEK, "teams", "%s.md" % args.bibliotheksname)
    if os.path.isfile(team_quelle):
        _kopiere(team_quelle, os.path.join(ziel_teams, "%s.md" % args.bibliotheksname))
        daten, _ = frontmatter_lesen(team_quelle)
        rollen = [daten.get("leiter")] + list(daten.get("mitglieder") or [])
        for rolle in rollen:
            if not rolle:
                continue
            rolle_quelle = os.path.join(BIBLIOTHEK, "rollen", "%s.md" % rolle)
            if os.path.isfile(rolle_quelle):
                _kopiere(rolle_quelle, os.path.join(ziel_rollen, "%s.md" % rolle))
        ausgabe(args, "wb-profil: Team '%s' hinzugefuegt (%d Datei(en) kopiert)."
                % (args.bibliotheksname, len(kopiert)),
                daten={"team": args.bibliotheksname, "kopiert": kopiert})
        return 0

    rolle_quelle = os.path.join(BIBLIOTHEK, "rollen", "%s.md" % args.bibliotheksname)
    if os.path.isfile(rolle_quelle):
        _kopiere(rolle_quelle, os.path.join(ziel_rollen, "%s.md" % args.bibliotheksname))
        ausgabe(args, "wb-profil: Rolle '%s' hinzugefuegt." % args.bibliotheksname,
                daten={"rolle": args.bibliotheksname, "kopiert": kopiert})
        return 0

    fehler("'%s' steht weder unter profile/rollen/ noch unter profile/teams/." % args.bibliotheksname)


