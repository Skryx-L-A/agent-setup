# -------------------------------------------------------- Frontmatter I/O --
def _entquoten(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        return s[1:-1].replace('\\"', '"')
    return s


def _quoten_falls_noetig(s):
    s = str(s)
    if s == "" or any(c in s for c in [":", "#", '"']) or s != s.strip():
        return '"%s"' % s.replace('"', '\\"')
    return s


def frontmatter_lesen(pfad):
    with open(pfad, "r", encoding="utf-8") as f:
        inhalt = f.read()
    if not inhalt.startswith("---"):
        return {}, inhalt
    zeilen = inhalt.split("\n")
    ende = None
    for i in range(1, len(zeilen)):
        if zeilen[i].strip() == "---":
            ende = i
            break
    if ende is None:
        return {}, inhalt
    kopf = zeilen[1:ende]
    rumpf = "\n".join(zeilen[ende + 1:]).lstrip("\n")
    daten = {}
    i = 0
    while i < len(kopf):
        zeile = kopf[i]
        if not zeile.strip() or zeile.strip().startswith("#"):
            i += 1
            continue
        m = re.match(r"^([A-Za-z0-9_]+):\s*(.*)$", zeile)
        if not m:
            i += 1
            continue
        schluessel, wert = m.group(1), m.group(2)
        if wert.strip() == "":
            werte, j = [], i + 1
            while j < len(kopf) and re.match(r"^\s*-\s+", kopf[j]):
                werte.append(_entquoten(re.sub(r"^\s*-\s+", "", kopf[j])))
                j += 1
            if werte:
                daten[schluessel] = werte
                i = j
                continue
            daten[schluessel] = None
            i += 1
            continue
        daten[schluessel] = _entquoten(wert)
        i += 1
    if "maxTurns" in daten and daten["maxTurns"] is not None:
        try:
            daten["maxTurns"] = int(daten["maxTurns"])
        except (TypeError, ValueError):
            pass
    if "schreibsperre" in daten and daten["schreibsperre"] is not None:
        # Ein neues Feld, kein Text: "true"/"false" (auch grossgeschrieben)
        # werden zu einem echten bool, damit die Ausgabe (--json) und jeder
        # Aufrufer (reviewer-sperre.sh) nicht selbst raten muessen.
        daten["schreibsperre"] = str(daten["schreibsperre"]).strip().lower() == "true"
    return daten, rumpf


def frontmatter_schreiben(daten, rumpf, reihenfolge=POSITIVLISTE):
    zeilen = ["---"]
    for schluessel in reihenfolge:
        if schluessel not in daten or daten[schluessel] in (None, [], ""):
            continue
        wert = daten[schluessel]
        if isinstance(wert, list):
            zeilen.append("%s:" % schluessel)
            for element in wert:
                # Reviewer-Hinweis 12: ohne Quoting rundet ein Element mit
                # ':', '"', '#' oder Randleerzeichen (z.B. ein Skill-Name wie
                # 'caveman:caveman-review') beim naechsten Lesen nicht zurueck.
                zeilen.append("  - %s" % _quoten_falls_noetig(element))
        elif isinstance(wert, bool):
            # bool ist in Python eine int-Unterklasse -- ohne diesen Zweig
            # zuerst wuerde er in den int-Zweig fallen und "1"/"0" statt
            # "true"/"false" schreiben.
            zeilen.append("%s: %s" % (schluessel, "true" if wert else "false"))
        elif isinstance(wert, int):
            zeilen.append("%s: %d" % (schluessel, wert))
        else:
            zeilen.append("%s: %s" % (schluessel, _quoten_falls_noetig(wert)))
    zeilen.append("---")
    kopf = "\n".join(zeilen) + "\n"
    return kopf + (rumpf or "")


def datei_atomar_schreiben(pfad, inhalt):
    os.makedirs(os.path.dirname(pfad), exist_ok=True)
    tmp = "%s.tmp-%d" % (pfad, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(inhalt)
    os.replace(tmp, pfad)


# ------------------------------------------------------------ Pruefung --
def gesperrt_laden():
    try:
        with open(GESPERRT_DATEI, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {"programme": [], "muster": []}


_GRENZE = r"(?<![A-Za-z0-9_-])%s(?![A-Za-z0-9_-])"


def _programm_in_text(programm, text):
    """Wort-/Tokengrenzen um den Programmnamen, sonst faellt z.B. 'kill' auch
    innerhalb 'Skill' (dem Claude-Tool-Namen) hin -- ein Werkzeugname ist
    kein Fragment eines anderen (gefunden beim Pruefen der eigenen
    Profil-Bibliothek: 'Skill' wurde faelschlich als 'kill' gesperrt).
    Beide Seiten kommen bereits NFKC-normalisiert und kleingeschrieben herein
    (siehe gesperrt_verstoss) -- hier nur noch die Grenzpruefung."""
    return re.search(_GRENZE % re.escape(programm), text) is not None


def _erstes_wort(text):
    text = text.strip()
    return text.split()[0] if text else ""


def nicht_lateinischer_name(text):
    """True, wenn das ERSTE WORT eines tools/bash-Eintrags ein Zeichen
    ausserhalb von ASCII traegt (Reviewer-Befund 6: 'Кill' mit kyrillischem
    К faellt durch jede NFKC-Normalisierung, weil es kein Kompatibilitaets-
    zeichen fuer lateinisches 'K' ist, sondern ein eigener Buchstabe --
    NFKC vereinheitlicht nur INNERHALB eines Skripts, nie ueber Skripte
    hinweg). Ein pauschales Verbot statt einer Ausnahmeliste: jeder
    Programmname, der nicht in der Hausliste steht, waere sonst derselbe
    blinde Fleck."""
    wort = _erstes_wort(text)
    return any(ord(c) > 127 for c in wort)


def gesperrt_verstoss(text, gesperrt):
    """Case-unabhaengig und NFKC-normalisiert (Reviewer-Befund 6: 'Kill',
    'PKill', 'Git push' und Fullwidth-Aequivalente sollen genauso treffen wie
    die Kleinschreibung aus der Liste). Zusaetzlich zur Textsuche wird der
    BASISNAME des ersten Worts explizit gegen jeden Programmnamen geprueft --
    'Bash-Muster, deren erstes Wort ein Pfad ist (/bin/kill, ./kill), werden
    am Basisnamen geprueft' (Auftrag Nr. 2, Punkt 6) --, nicht nur ueber die
    zufaellige Randeigenschaft, dass '/' schon eine Wortgrenze ist."""
    text_norm = unicodedata.normalize("NFKC", text).lower()
    erstes = _erstes_wort(text)
    basisname_norm = unicodedata.normalize("NFKC", os.path.basename(erstes)).lower() if erstes else ""
    for regel in gesperrt.get("programme", []):
        programm_norm = unicodedata.normalize("NFKC", regel["programm"]).lower()
        treffer = _programm_in_text(programm_norm, text_norm) or basisname_norm == programm_norm
        if not treffer:
            continue
        erfordert_norm = [unicodedata.normalize("NFKC", t).lower() for t in regel.get("erfordert", [])]
        if all(teil in text_norm for teil in erfordert_norm):
            return regel["grund"]
    for regel in gesperrt.get("muster", []):
        enthaelt_norm = unicodedata.normalize("NFKC", regel["enthaelt"]).lower()
        if enthaelt_norm in text_norm:
            return regel["grund"]
    return None


# Reviewer-Befund 1: ein Skalar in einem dieser Felder ("tools: Bash, <ein eigenes Mailwerkzeug>,
# kill" statt einer YAML-Liste) landete bisher ungeprueft als String und wurde
# von list(...) in EINZELZEICHEN zerlegt -- jede Pruefung darueber lief ins
# Leere (Exit 0 trotz gesperrtem Werkzeug), und spawn-argumente haette
# "B","a","s","h" ausgegeben.
LISTENFELDER = ["tools", "disallowedTools", "bash", "skills"]


def profil_pruefen(daten, aufgabe_freigaben=None, max_stufe=None):
    verstoesse = []
    unbekannt = sorted(set(daten.keys()) - set(POSITIVLISTE))
    for u in unbekannt:
        verstoesse.append("Feld '%s' steht nicht auf der Positivliste" % u)
    for pflicht in PFLICHTFELDER:
        if not daten.get(pflicht):
            verstoesse.append("Pflichtfeld '%s' fehlt oder ist leer" % pflicht)
    stufe = daten.get("stufe")
    if stufe is not None and stufe not in STUFEN:
        verstoesse.append("Feld 'stufe' ist ungueltig ('%s', erlaubt: %s)" % (stufe, ", ".join(STUFEN)))
    if max_stufe is not None and stufe in STUFEN:
        if STUFEN.index(stufe) > STUFEN.index(max_stufe):
            verstoesse.append(
                "Stufe '%s' ueberschreitet die erlaubte Hoechststufe '%s' fuer eine "
                "vom Hauptagenten angelegte Rolle" % (stufe, max_stufe))

    for feld in LISTENFELDER:
        wert = daten.get(feld)
        if wert is not None and not isinstance(wert, list):
            verstoesse.append(
                "Feld '%s' muss eine YAML-Liste sein, kein Text ('%s')" % (feld, wert))

    gesperrt = gesperrt_laden()
    tools_liste = daten.get("tools") if isinstance(daten.get("tools"), list) else []
    bash_liste = daten.get("bash") if isinstance(daten.get("bash"), list) else []
    text_werte = list(tools_liste) + list(bash_liste)
    for text in text_werte:
        if nicht_lateinischer_name(text):
            verstoesse.append(
                "'%s': nicht-lateinischer Programmname ('%s')" % (text, _erstes_wort(text)))
            continue
        grund = gesperrt_verstoss(text, gesperrt)
        if grund:
            verstoesse.append("'%s' ist gesperrt: %s" % (text, grund))
    if aufgabe_freigaben is not None:
        for text in text_werte:
            for zuordnung in FREIGABE_ZUORDNUNG:
                if any(s.lower() in text.lower() for s in zuordnung["stichwoerter"]):
                    if not aufgabe_freigaben.get(zuordnung["freigabe"]):
                        verstoesse.append(
                            "'%s' braucht die Freigabe '%s', die die Aufgabe nicht traegt"
                            % (text, zuordnung["freigabe"]))
    return verstoesse


def ist_team(pfad, daten):
    """Erkannt am Pfad (irgendwo ein Ordner 'teams') oder am Feld 'leiter'
    (Reviewer-Befund 5, Auftrag Nr. 2 Punkt 5)."""
    teile = os.path.normpath(pfad).split(os.sep)
    return "teams" in teile or "leiter" in daten


def _team_rollen_wurzel(team_pfad):
    """'teams' und 'rollen' liegen in jeder der drei Lagen (global, Projekt,
    Bibliothek) als Geschwister unter derselben Wurzel -- rein strukturell,
    ohne dass dieser Aufruf wissen muss, in welcher Lage er gerade steht."""
    eltern = os.path.dirname(os.path.dirname(os.path.abspath(team_pfad)))
    return os.path.join(eltern, "rollen")


def team_pruefen(daten, team_pfad):
    verstoesse = []
    unbekannt = sorted(set(daten.keys()) - set(POSITIVLISTE_TEAM))
    for u in unbekannt:
        verstoesse.append("Feld '%s' steht nicht auf der Team-Positivliste" % u)
    for pflicht in PFLICHTFELDER_TEAM:
        if not daten.get(pflicht):
            verstoesse.append("Pflichtfeld '%s' fehlt oder ist leer" % pflicht)

    mitglieder = daten.get("mitglieder")
    if mitglieder is not None and not isinstance(mitglieder, list):
        verstoesse.append("Feld 'mitglieder' muss eine YAML-Liste sein, kein Text ('%s')" % mitglieder)
        mitglieder = []
    mitglieder = mitglieder or []

    rollen_wurzel = _team_rollen_wurzel(team_pfad)
    leiter = daten.get("leiter")
    if leiter:
        leiter_pfad = os.path.join(rollen_wurzel, "%s.md" % leiter)
        if not os.path.isfile(leiter_pfad):
            verstoesse.append("Leiter-Rolle '%s' existiert nicht (%s)" % (leiter, leiter_pfad))
        else:
            leiter_daten, _ = frontmatter_lesen(leiter_pfad)
            if leiter_daten.get("stufe") != "teamleiter" and not (daten.get("begruendung") or "").strip():
                verstoesse.append(
                    "Leiter-Rolle '%s' hat nicht die Stufe 'teamleiter' (hat '%s') und die "
                    "Teamdatei begruendet die Ausnahme nicht (Feld 'begruendung')"
                    % (leiter, leiter_daten.get("stufe")))

    for mitglied in mitglieder:
        mitglied_pfad = os.path.join(rollen_wurzel, "%s.md" % mitglied)
        if not os.path.isfile(mitglied_pfad):
            verstoesse.append("Mitglied-Rolle '%s' existiert nicht (%s)" % (mitglied, mitglied_pfad))

    return verstoesse


def rolle_datei_finden(name_oder_pfad, args, aufgabe_id=None):
    """Sucht eine Rollendatei: direkter Pfad zuerst, sonst nach Namen —
    vorläufig (wenn aufgabe_id gegeben) vor Projekt vor global."""
    if os.sep in name_oder_pfad or name_oder_pfad.endswith(".md"):
        if os.path.isfile(name_oder_pfad):
            return name_oder_pfad
        return None
    if aufgabe_id:
        kandidat = os.path.join(vorlaeufig_verzeichnis(args, aufgabe_id), "%s.md" % name_oder_pfad)
        if os.path.isfile(kandidat):
            return kandidat
    projekt = getattr(args, "projekt", None)
    if projekt:
        p_rollen, _ = projekt_wurzeln(projekt)
        kandidat = os.path.join(p_rollen, "%s.md" % name_oder_pfad)
        if os.path.isfile(kandidat):
            return kandidat
    g_rollen, _ = globale_wurzeln(args.base)
    kandidat = os.path.join(g_rollen, "%s.md" % name_oder_pfad)
    if os.path.isfile(kandidat):
        return kandidat
    return None


# -------------------------------------------------------------- anlegen --
def cmd_anlegen(args):
    if args.stufe not in STUFEN:
        fehler("--stufe kennt '%s' nicht (erlaubt: %s)" % (args.stufe, ", ".join(STUFEN)))

    if args.absender == "person-1":
        # Reviewer-Befund 2: ohne diese Pruefung konnte sich ein AGENT als
        # "person-1" ausgeben und damit sowohl den Stufen-Deckel als auch die
        # Freigabe-Pruefung umgehen (Exit 0 fuer eine globale hauptagent-Rolle
        # mit wb-shot/Fable, ohne dass je ein Mensch beteiligt war).
        mensch_verlangen(args, "eine Rolle als der Nutzer anlegen")
        absender = "person-1"
        aufgabe_id = args.aufgabe
    elif args.absender.startswith("hauptagent"):
        teile = args.absender.split(":")
        if len(teile) == 3:
            aufgabe_id = args.aufgabe or teile[1]
            if args.aufgabe and args.aufgabe != teile[1]:
                fehler("--aufgabe '%s' widerspricht der Aufgabe in --absender ('%s')"
                       % (args.aufgabe, teile[1]))
            absender = args.absender
        elif len(teile) == 1:
            if not args.aufgabe:
                fehler("--absender hauptagent braucht --aufgabe <id>")
            aufgabe_id = args.aufgabe
            absender = "hauptagent:%s:%s" % (aufgabe_id, datetime.date.today().isoformat())
        else:
            fehler("--absender 'hauptagent:<aufgabe_id>:<datum>' erwartet genau zwei Doppelpunkte")
    else:
        fehler("--absender muss 'person-1' oder 'hauptagent[:<aufgabe_id>:<datum>]' sein")

    tools = [t.strip() for t in args.tools.split(",") if t.strip()]
    skills = [s.strip() for s in (args.skills or "").split(",") if s.strip()]

    daten = {
        "name": args.name,
        "description": args.bereich,
        "tools": tools,
        "disallowedTools": [],
        "bash": list(args.bash or []),
        "skills": skills,
        "maxTurns": None,
        "stufe": args.stufe,
        "kontextgrenze": args.kontextgrenze,
        "absender": absender,
        "stand": "vorlaeufig" if absender != "person-1" else "behalten",
        "begruendung": args.begruendung,
    }

    # Der Stufen-Deckel gilt nur fuer den hauptagent-Weg (der Nutzer darf
    # weiterhin Stufe "hauptagent" anlegen, jetzt aber nur noch MIT Beleg,
    # siehe oben). Die Freigabe-Pruefung dagegen laeuft fuer JEDEN Absender,
    # sobald eine Aufgabe genannt ist (Reviewer-Befund 2, Auftrag Nr. 2
    # Punkt 2: "Freigabe-Pruefung (wb-shot, Fable) laeuft fuer jeden
    # Absender") -- eine globale Rolle ohne --aufgabe hat nichts, wogegen sie
    # geprueft werden koennte, und bleibt wie zuvor ungeprueft.
    max_stufe = "teamleiter" if absender != "person-1" else None
    aufgabe_freigaben = None
    if aufgabe_id:
        _, auftrag, _, _ = aufgabe_lesen(args, aufgabe_id)
        aufgabe_freigaben = auftrag.get("freigaben", {})

    verstoesse = profil_pruefen(daten, aufgabe_freigaben=aufgabe_freigaben, max_stufe=max_stufe)
    if verstoesse:
        for v in verstoesse:
            sys.stderr.write("wb-profil: %s\n" % v)
        sys.exit(2)

    if absender == "person-1":
        if args.projekt:
            ziel_dir, _ = projekt_wurzeln(args.projekt)
        else:
            ziel_dir, _ = globale_wurzeln(args.base)
    else:
        ziel_dir = vorlaeufig_verzeichnis(args, aufgabe_id)

    ziel_pfad = os.path.join(ziel_dir, "%s.md" % args.name)
    rumpf = ""
    if args.prompt_datei:
        with open(args.prompt_datei, "r", encoding="utf-8") as f:
            rumpf = f.read()
    inhalt = frontmatter_schreiben(daten, rumpf)
    datei_atomar_schreiben(ziel_pfad, inhalt)
    ausgabe(args, "wb-profil: Rolle '%s' angelegt (%s, Stand %s)." % (args.name, ziel_pfad, daten["stand"]),
            daten={"name": args.name, "pfad": ziel_pfad, "stand": daten["stand"]})
    return 0


# -------------------------------------------------------------- pruefen --
def cmd_pruefen(args):
    # Der direkte Pfad zuerst (Bibliotheksdateien, Teams eingeschlossen);
    # rolle_datei_finden kennt nur die drei Rollen-Lagen, ein Team ueber
    # seinen Namen zu finden ist hier nicht vorgesehen.
    if os.sep in args.ziel or args.ziel.endswith(".md"):
        pfad = args.ziel if os.path.isfile(args.ziel) else None
    else:
        pfad = rolle_datei_finden(args.ziel, args, aufgabe_id=args.aufgabe)
    if not pfad:
        fehler("Rolle oder Team '%s' nicht gefunden." % args.ziel)
    daten, _ = frontmatter_lesen(pfad)

    if ist_team(pfad, daten):
        verstoesse = team_pruefen(daten, pfad)
    else:
        aufgabe_freigaben = None
        if args.aufgabe:
            _, auftrag, _, _ = aufgabe_lesen(args, args.aufgabe)
            aufgabe_freigaben = auftrag.get("freigaben", {})
        verstoesse = profil_pruefen(daten, aufgabe_freigaben=aufgabe_freigaben)

    # Meldungsweg (Reviewer-Hinweis 9): Verstoesse nach stderr, stdout nur bei
    # --json oder im Erfolgsfall.
    if args.json:
        print(json.dumps({"pfad": pfad, "verstoesse": verstoesse}, ensure_ascii=False))
    else:
        if verstoesse:
            for v in verstoesse:
                sys.stderr.write(v + "\n")
        else:
            print("wb-profil pruefen %s: keine Verstoesse" % pfad)
    return 2 if verstoesse else 0


