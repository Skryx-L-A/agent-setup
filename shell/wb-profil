# --------------------------------------------------- Einstellungen/Modelle --
def einstellung(schluessel, vorgabe, base):
    """Dieselbe Bauart wie in shell/wb-aufgabe (siehe dortige Begruendung):
    `wb-state settings get <schluessel>`, wenn das eine nicht-leere Ausgabe
    liefert, sonst punktweise direkt aus <base>/.claude/workbench/settings.json
    gelesen."""
    try:
        r = subprocess.run(["wb-state", "settings", "get", schluessel],
                            capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    pfad = os.path.join(base, ".claude", "workbench", "settings.json")
    try:
        with open(pfad, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, json.JSONDecodeError):
        return vorgabe
    node = cfg
    for teil in schluessel.split("."):
        if not isinstance(node, dict) or teil not in node:
            return vorgabe
        node = node[teil]
    if node is None:
        return vorgabe
    return node


