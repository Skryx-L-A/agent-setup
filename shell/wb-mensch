    eltern = set()
    for e in listen.get("app", []):
        eltern |= pfad(e)
    if p_exe not in eltern:
        nein("Elternprozess %d des Kerns ist %r, nicht die installierte Werkbank-App." % (p, p_exe))
    try:
        if os.stat(p_exe).st_nlink != 1:
            nein("Die App %r hat mehrere Namen (Hardlink)." % p_exe)
    except OSError:
        nein("Die App %r ist nicht lesbar." % p_exe)
    gebunden(p, p_exe, "Die App")
    pi = info(p)
    if pi is None:
        nein("Prozessdaten des Elternprozesses %d nicht lesbar." % p)
elif sys.platform.startswith("linux"):
    def lies(pid, was):
        try:
            with open("/proc/%d/%s" % (pid, was), "rb") as f:
                return f.read()
        except OSError:
            return None
    def link(pid, was):
        try:
            return os.readlink("/proc/%d/%s" % (pid, was))
        except OSError:
            return None
    def info(pid):
        st, stat = lies(pid, "status"), lies(pid, "stat")
        if st is None or stat is None:
            return None
        werte = dict(z.split(":", 1) for z in st.decode(errors="replace").splitlines() if ":" in z)
        try:
            ppid = int(werte["PPid"].strip())
            uid = int(werte["Uid"].split()[0])
            start = int(stat.decode(errors="replace").rsplit(")", 1)[1].split()[19])
        except (KeyError, ValueError, IndexError):
            return None
        return ppid, start, uid
    x_exe, x_cwd = link(app, "exe"), link(app, "cwd")
    argv = (lies(app, "cmdline") or b"").split(b"\0")
    if argv and argv[-1] == b"":
        argv.pop()
    treffer = None
    for k in listen.get("kern", []):
        if x_exe in pfad(k + "/kern-electron/electron"):
            treffer = k
    if treffer is None:
        nein("WB_APP_PID=%d fuehrt %r aus, nicht das Kern-Electron der Werkbank." % (app, x_exe))
    # /proc/X/exe nennt den Namen beim Start; Geraet/Inode und ein einziger Name
    # schliessen zusaetzlich einen Hardlink aus.
    try:
        st, sx = os.stat(x_exe), os.stat("/proc/%d/exe" % app)
    except OSError:
        nein("Programmdatei von WB_APP_PID=%d nicht messbar." % app)
    if (st.st_dev, st.st_ino) != (sx.st_dev, sx.st_ino):
        nein("WB_APP_PID=%d fuehrt eine andere Datei aus als %r (Geraet/Inode)." % (app, x_exe))
    if st.st_nlink != 1:
        nein("Das Kern-Electron %r hat %d Namen (Hardlink)." % (x_exe, st.st_nlink))
    if x_cwd not in pfad(treffer):
        nein("Arbeitsordner von WB_APP_PID=%d ist %r, nicht der Kernordner." % (app, x_cwd))
    # Electron/Chromium 42 schreibt die Befehlszeile unter Linux um (setproctitle): Schalter
    # zuerst, und alles als EINE Zeile mit Leerzeichen und nur einem NUL am Ende, also
    # "<kern-electron> --show .\0" statt "<kern-electron>\0.\0--show\0" (gemessen auf peer,
    # 2026-10-16, od -c /proc/X/cmdline). Erlaubt sind genau die getrennte Form `. --show`
    # bzw. `--show .` und genau diese Zeilenform mit dem Pfad des Kern-Electron davor,
    # sonst nichts. Chromium schreibt die Zeile aus den tatsaechlichen Schaltern und
    # Argumenten; ein gefaelschtes argv[0] ("<kern> --show ." ohne echte Argumente) laesst
    # den Kern ohne Kernordner starten, Programm, Inode, Arbeitsordner, Umgebung und
    # systemd-Elternteil prueft der Rest dieser Pruefung trotzdem.
    if len(argv) == 1 and b" " in argv[0]:
        zeilen = {(p + rest).encode() for p in pfad(treffer + "/kern-electron/electron")
                  for rest in (" --show .", " . --show")}
        if argv[0] not in zeilen:
            nein("WB_APP_PID=%d hat nicht die Argumente des Desktop-Starts (. --show) "
                 "in der Zeilenform von Electron." % app)
        argv = [argv[0], b".", b"--show"]
    if b"." not in argv[1:3]:
        nein("WB_APP_PID=%d wurde nicht mit \".\" als erstem Argument (oder nach --show) gestartet." % app)
    if argv[1:] not in ([b".", b"--show"], [b"--show", b"."]):
        nein("WB_APP_PID=%d hat nicht die Argumente des Desktop-Starts (. --show)." % app)
    # systemd-run --user gibt jedem Programm dieses Elternteil; die Umgebung des
    # Kerns ist deshalb Teil der Pruefung (LD_PRELOAD, NODE_OPTIONS, GTK_MODULES ...).
    erlaubt = set(listen.get("umgebung", [])) | {"HOME", "USER", "LOGNAME", "SHELL", "PATH"}
    roh = lies(app, "environ")
    if roh is None:
        nein("Umgebung von WB_APP_PID=%d nicht lesbar." % app)
    if roh and not roh.strip(b"\0"):
        # Electron 42 (Chromium setproctitle) nullt den Umgebungsbereich: /proc/X/environ
        # ist dann nur NUL (gemessen peer 2026-10-16, 374 Bytes). Ersatz NUR in diesem Fall
        # (Entscheidung WorkbenchOrchestrator 16.10.): jede ausfuehrbare Abbildung in
        # /proc/X/maps liegt im Kern-Electron-Ordner oder ist eine root-eigene Datei, deren
        # Ordnerkette bis / root-eigen und weder gruppen- noch weltschreibbar ist. Das faengt
        # eigenen Code ueber LD_PRELOAD, LD_LIBRARY_PATH, GTK_MODULES, GIO_EXTRA_MODULES.
        # HOME und PATH sind so von aussen nicht pruefbar (Restgrenze, dokumentiert).
        kordner = {os.path.realpath(p) + "/" for p in pfad(treffer + "/kern-electron")}
        # Im Kernordner zaehlen nur die Dateien der Electron-dist (gemessen peer 16.10.,
        # Electron 42), direkt im Ordner und mit genau einem Namen. Der Ordner ist vom
        # Benutzer beschreibbar; ohne Liste ginge ein LD_PRELOAD auf eine dort abgelegte
        # .so durch (Befund WorkbenchOrchestrator 16.10.). app/tools/kern-electron.mjs
        # liest diese Zeile und bricht den Bau laut ab, wenn die dist eine Bibliothek
        # mitbringt, die hier fehlt (Electron-Update).
        KERN_DATEIEN_LINUX = ("electron", "libEGL.so", "libGLESv2.so", "libffmpeg.so", "libvk_swiftshader.so", "libvulkan.so.1")
        def root_sicher(d):
            while True:
                try:
                    s = os.stat(d)
                except OSError:
                    return False
                if s.st_uid != 0 or s.st_mode & 0o022:
                    return False
                if d == "/":
                    return True
                d = os.path.dirname(d)
        karte = lies(app, "maps")
        if not karte:
            nein("Abbildungen von WB_APP_PID=%d nicht lesbar (Umgebung geloescht)." % app)
        for zeile in karte.decode(errors="replace").splitlines():
            teile_ = zeile.split(None, 5)
            if len(teile_) < 5 or "x" not in teile_[1]:
                continue
            ziel = teile_[5] if len(teile_) == 6 else ""
            if ziel in ("", "[vdso]", "[vsyscall]", "[anon:v8]"):
                continue
            if ziel.endswith(" (deleted)") or not ziel.startswith("/"):
                nein("WB_APP_PID=%d hat ausfuehrbaren Speicher %r (geloescht oder ohne Datei)." % (app, ziel[:120]))
            echt = os.path.realpath(ziel)
            im_kern = [echt[len(k):] for k in kordner if echt.startswith(k)]
            if im_kern:
                try:
                    sk = os.stat(echt)
                except OSError:
                    sk = None
                if im_kern[0] not in KERN_DATEIEN_LINUX or sk is None or sk.st_nlink != 1:
                    nein("WB_APP_PID=%d laedt %r aus dem Kern-Electron-Ordner; das ist keine Datei "
                         "der Electron-dist mit genau einem Namen (Umgebung geloescht)." % (app, ziel[:120]))
                continue
            if not root_sicher(echt):
                nein("WB_APP_PID=%d laedt %r, nicht root-eigen oder beschreibbar (Umgebung geloescht)." % (app, ziel[:120]))
    else:
        umg = {}
        for z in roh.split(b"\0"):
            if b"=" in z:
                k, v = z.split(b"=", 1)
                umg[k.decode(errors="replace")] = v.decode(errors="replace")
        fremd = sorted(set(umg) - erlaubt)
        if fremd:
            nein("Umgebung von WB_APP_PID=%d enthaelt %s (nicht in der Positivliste)." % (app, ", ".join(fremd)[:200]))
        if umg.get("HOME") != heim or umg.get("PATH") != "/usr/local/bin:/usr/bin:/bin":
            nein("HOME oder PATH von WB_APP_PID=%d weichen vom Desktop-Start ab." % app)
    xi = info(app)
    if xi is None:
        nein("Prozessdaten von WB_APP_PID=%d nicht lesbar." % app)
    p = xi[0]
    pi = info(p)
    if pi is None:
        nein("Prozessdaten des Elternprozesses %d nicht lesbar." % p)
    eltern = set()
    for e in listen.get("eltern", []):
        eltern |= pfad(e)
    p_argv = (lies(p, "cmdline") or b"").split(b"\0")
    p_exe = link(p, "exe")
    # systemd --user ist nicht dumpbar: exe ist fuer den Benutzer nicht lesbar
    # (peer, gemessen 2026-10-14). Dann zaehlen Kommandozeile und UID.
    p_bild = p_exe if p_exe is not None else p_argv[0].decode(errors="replace")
    if p_bild not in eltern or b"--user" not in p_argv[1:] or pi[2] != os.getuid():
        nein("Elternprozess %d des Kerns ist %r, nicht systemd --user dieses Benutzers." % (p, p_bild))
else:
    nein("Plattform ohne M2-Messung.")
if pi[0] != 1:
    nein("Elternprozess %d des Kerns ist kein Kind von PID 1 (ppid %d)." % (p, pi[0]))
if pi[1] > xi[1]:
    nein("Elternprozess %d ist spaeter gestartet als der Kern %d." % (p, app))
print("JA")
' "$app" --kern "${M2_KERN_ORDNER[@]}" --app "${M2_APP_MAC[@]}" --eltern "${M2_ELTERN_LINUX[@]}" \
        --anforderung "${M2_ANFORDERUNG_MAC[@]}" --umgebung "${M2_UMGEBUNG_LINUX[@]}" 2>/dev/null)
    case "$befund" in
        JA) return 0 ;;
        "NEIN "*) GRUND_M2="${befund#NEIN }" ;;
        *) GRUND_M2="Die Pruefung des Kerns lieferte kein Ergebnis." ;;
    esac
    return 1
}

klassifizieren() {   # setzt ART und GRUND
    local kom
    for v in CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID PI_AGENT WB_AGENT; do
        if [ -n "${!v:-}" ]; then
            ART=agent; GRUND="Agenten-Umgebungsvariable $v ist gesetzt (A1)."; return
        fi
    done
    kom=$(harness_kommandos | sort -u)
    ahnen_lesen
    local pid name
    while read -r pid name; do
        [ -n "$name" ] || continue
        if printf '%s\n' "$kom" | grep -qxF -e "$name"; then
            ART=agent; GRUND="Harness '$name' (PID $pid) steht in der Ahnenreihe (A2)."; return
        fi
    done <<<"$AHNEN"
    if agenten_pane; then
        ART=agent; GRUND="Ein Ahne dieses Prozesses ist der Prozess eines tmux-Panes mit @wb_role=worker|orchestrator (A3)."; return
    fi
    # VOR A5, M1 und M2: was A2 und A3 ueber der Bruchstelle nicht sehen konnten, ist
    # nicht abwesend, sondern ungeprueft.
    if [ -n "$AHNEN_LUECKE" ]; then
        ART=agent; GRUND="Ahnenreihe nicht vollstaendig messbar ($AHNEN_LUECKE) -- ob ein Agent darueber steht, bleibt offen (A2b)."; return
    fi
    # VOR A4, M1 und M2: in einem fremden Namensraum sieht ps weder sshd noch Harness.
    if fremder_namensraum; then
        ART=agent; GRUND="$GRUND_NS"; return
    fi
    # VOR M1, und genau deshalb wirksam: die Schleife ueber die eigene Maschine liefert
    # ja gerade das steuernde Terminal, an dem M1 sonst einen Menschen erkennt.
    if ssh_auf_sich_selbst; then
        ART=agent; GRUND="$GRUND_SSH"; return
    fi
    if hat_terminal; then
        ART=mensch; GRUND="Steuerndes Terminal vorhanden, kein Agent in der Ahnenreihe (M1)."; return
    fi
    if oberflaeche_ist_ahne; then
        ART=mensch; GRUND="Oberflaeche als geprueften Ahnen nachgewiesen (WB_APP_PID=$WB_APP_PID, M2)."; return
    fi
    ART=agent
    GRUND="Kein Nachweis fuer einen Menschen: weder ein steuerndes Terminal (M1) noch die Oberflaeche als Ahne (M2)."
    # Die Oberflaeche zeigt diesen Text ("Freigabe nicht als Mensch erkannt: ..."); ohne
    # den Grund von M2 saehe der Mensch nicht, WARUM sein Klick nicht zaehlte.
    [ -n "$GRUND_M2" ] && GRUND="$GRUND M2 scheiterte: $GRUND_M2"
}

case "$CMD" in
    pruefen)
        klassifizieren
        [ "$ART" = mensch ] && exit 0
        exit 1 ;;
    beleg)
        klassifizieren
        printf '%s\t%s\n' "$ART" "$GRUND"
        exit 0 ;;
    ahnen)
        ahnen
        exit 0 ;;
    *)
        echo "wb-mensch: unbekanntes Kommando '$CMD' (pruefen|beleg|ahnen)" >&2
        exit 2 ;;
esac
