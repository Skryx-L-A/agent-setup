#!/bin/bash
# wb-mensch — beantwortet EINE Frage: ruft hier ein MENSCH oder ein AGENT?
#
#   wb-mensch pruefen         Exit 0 = Mensch, 1 = Agent. Ohne Ausgabe.
#   wb-mensch beleg           <mensch|agent> TAB <Begruendung>   (immer Exit 0)
#   wb-mensch ahnen           Die geprueften Ahnen, eine Zeile je Prozess (Diagnose);
#                             reisst die Lese ab, lautet die letzte Zeile
#                             "UNVOLLSTAENDIG <grund>" (Exit bleibt 0)
#
# WARUM ES DIESES WERKZEUG GIBT
# Drei Sicherungen in dieser Werkbank duerfen nur von einem Menschen gelockert
# werden: der Effort-Deckel (pi-worker), die einzelnen Guards (bash-guard.py) und
# die Kontextwache je Rolle (context-guard). Das ist dreimal dieselbe Frage, also
# steht die Antwort einmal hier und wird dreimal benutzt.
#
# DAS MERKMAL WIRD GEMESSEN, NICHT BEHAUPTET
# Das Vorbild ist `isTrusted` im Browser: ein Klick traegt die Echtheit, WEIL die
# vertrauenswuerdige Schicht sie aufgepraegt hat -- kein Skript kann sie an ein
# selbstgebautes Ereignis anhaengen. Genauso hier: der Aufrufer sagt zwar
# `--mensch`, aber ob das gilt, entscheidet NICHT er, sondern was dieses Werkzeug
# an seinem Prozess ablesen kann. Ein Agent, der `--mensch` errät und mitschickt,
# kommt damit nicht durch, weil er sich seine eigene Herkunft nicht wegschreiben
# kann.
#
# NEGATIVPRUEFUNG (irgendeine trifft zu -> Agent):
#   A1  Agenten-Umgebungsvariablen (CLAUDECODE, CLAUDE_CODE_ENTRYPOINT, …).
#       Gemessen 2026-08-06 im Bash-Werkzeug eines laufenden Claude-Workers:
#       CLAUDECODE, CLAUDE_CODE_ENTRYPOINT, CLAUDE_CODE_SESSION_ID und
#       CLAUDE_PID sind gesetzt.
#   A2  Ein HARNESS-BINARY in der Ahnenreihe. Gemessen in derselben Messung:
#       die Elternkette der Bash-Werkzeug-Shell lautet
#       /bin/zsh -> ~/.local/bin/claude -> tmux. Das Harness ist also ein
#       direkter Ahne, und ein Agent kann seinen eigenen Elternprozess nicht
#       austauschen.
#   A3  Ein Ahnen-PID ist die pane_pid eines tmux-Panes mit
#       @wb_role=worker|orchestrator. Die lokalen tmux-Sockets werden aus den
#       eigenen Socketverzeichnissen ermittelt; TMUX/TMUX_PANE sind dafuer
#       nicht noetig und koennen A3 durch `env -u` nicht ausschalten.
#   A2b Die Ahnenreihe, auf der A2, A3 und M2 stehen, ist nicht vollstaendig
#       messbar. Regulaer endet sie an PID <= 1 (launchd, systemd, init; auch
#       wenn dieser Prozess selbst PID 1 eines PID-Namensraums ist, den A5 auf
#       Linux ohnehin ablehnt) oder an ppid 0. Scheitert `ps` vorher an einem
#       Ahnen, liefert es nichts oder keine numerische ppid, bleibt offen, ob
#       weiter oben ein Harness, ein Agenten-Pane oder ueber der Oberflaeche ein
#       Agent steht -- vorher brach die Lese still ab, und M1 oder M2 meldeten
#       einen Menschen. Die Antwort ist dann Nein, vor M1 und M2, ohne Schalter.
#   A4  Eine SSH-Sitzung, deren Gegenstelle DIESE MASCHINE SELBST ist. Gemessen
#       2026-08-06 vom Nutzer, und es war ein Loch: ein Agent verbindet sich per
#       `ssh -tt $(tailscale ip -4)` mit dem eigenen Rechner, sshd gibt ihm einen
#       frischen Prozessbaum mit Pseudoterminal, und damit sind A1 bis A3 alle
#       wirkungslos -- keine Agenten-Variablen mehr, kein Harness in der Ahnenreihe,
#       kein Pane darueber. M1 sah daraufhin einen Menschen und sagte es woertlich:
#       "mensch  Steuerndes Terminal vorhanden, kein Agent in der Ahnenreihe (M1)".
#       Eine Schleife ueber die eigene Maschine ist aber nie ein Mensch, sondern nur
#       ein Umweg. Die Gegenstelle wird GEMESSEN (seit 2026-10-09): aus dem utmp-Eintrag,
#       den der SSH-Server fuer das steuernde Terminal schreibt, und nur wenn dessen PID
#       ein root-eigener Server-Ahne ist oder dessen Kind (Einzelheiten und Messungen an
#       ssh_auf_sich_selbst). SSH_CONNECTION aus der Umgebung zaehlt nicht mehr, in keine
#       Richtung: vorher kam ein Agent mit `exec env SSH_CONNECTION=<fremd> …` in der
#       Schleife als Mensch durch (gemessen auf peer). Die Adresse wird gegen die
#       GEMESSENEN eigenen Adressen gehalten -- ifconfig/ip, dazu `tailscale ip` aus
#       festem Pfad und ausdruecklich die Rueckschleife. Nichts davon ist fest verdrahtet: eine
#       Adressliste im Quelltext waere an dem Tag falsch, an dem sich eine Adresse
#       aendert, und zwar still und in die gefaehrliche Richtung.
#
#       Eine SSH-Sitzung von einer ANDEREN Maschine mit Pseudoterminal gilt weiter als
#       Mensch (M1), auf peer ueber sshd ebenso wie auf dem Mac ueber Tailscale SSH. Das
#       ist eine Vertrauensfrage, die der Nutzer noch entscheidet; sie steht als offener
#       Punkt 2 in IPHONE-FERNBEDIENUNG-PLAN.md. Ein Agent mit Schluessel fuer die andere
#       Maschine kommt auf diesem Weg ebenfalls durch (auch als Umweg ueber `ssh -L`).
#   A5  (nur Linux) Der pruefende Prozess laeuft NICHT im Anfangs-Benutzer- oder
#       -PID-Namensraum des Kernels. Gemessen 2026-10-10 auf peer in einer echten
#       SSH-Schleife: `unshare --user --map-root-user --pid --fork --mount-proc
#       wb-mensch beleg` ergab M1 -- im neuen PID-Namensraum ist wb-mensch selbst PID 1,
#       sshd, Harness und Pane sind unsichtbar, das Terminal bleibt. Verglichen wird
#       /proc/self/ns/{user,pid} gegen die festen Anfangs-Inodes des Kernels
#       (PROC_USER_INIT_INO 4026531837, PROC_PID_INIT_INO 4026531836), nicht gegen
#       PID 1: /proc/1/ns/* ist fuer normale Benutzer nicht lesbar (peer: "Permission
#       denied", gemessen 2026-10-10). Laesst sich die Lage nicht messen, ist die
#       Antwort ebenfalls Nein. Nur auf macOS (`uname -s` = Darwin, dort gibt es keine
#       solchen Namensraeume) entfaellt die Pruefung; entschieden wird ueber die
#       Plattform, nicht ueber ein fehlendes /proc, das sich verbergen liesse.
#       Die echten Menschenwege laufen im Anfangsraum (peer, gemessen 2026-10-10):
#       SSH-Login, tmux-Panes, der Electron-Hauptprozess der Werkbank und seine
#       Kinder. Einen eigenen Namensraum hat dort nur der Renderer-Sandkasten, der
#       wb-mensch nie aufruft.
#
# POSITIVPRUEFUNG (eine muss zutreffen -> Mensch):
#   M1  Ein steuerndes Terminal. Gemessen: die Shell des Bash-Werkzeugs hat
#       KEINES (`tty` sagt "not a tty", `ps -o tty=` zeigt "??"). Ein Mensch am
#       Terminal hat immer eines.
#   M2  Die Oberflaeche: WB_MENSCH_QUELLE=oberflaeche zusammen mit WB_APP_PID.
#       Die Variablen allein zaehlen NICHT. Die PID X muss ein echter Ahne dieses
#       Prozesses sein, und X muss der Kern der ECHTEN Werkbank sein:
#         - das ausgefuehrte Programm von X (Mac: proc_pidpath, Linux:
#           /proc/X/exe) ist genau das KERN-ELECTRON <kernordner>/kern-electron/
#           Electron.app/Contents/MacOS/Electron bzw. .../kern-electron/electron,
#           mit <kernordner> aus der festen Liste M2_KERN_ORDNER. Das Kern-Electron
#           ist eine Kopie von node_modules/electron mit abgeschalteten Fuses
#           (RunAsNode, NODE_OPTIONS, --inspect; app/tools/kern-electron.mjs). Es
#           laedt den Ordner aus seinem ersten Argument; dass es der Kern ist,
#           bindet die Argumentpruefung unten (ein Verweis resources/app im
#           Buendel bestand `codesign --verify --strict` nicht, Ausrollfund
#           2026-10-14);
#         - X lief von genau diesem Pfad an (Mac: exec-Pfad aus KERN_PROCARGS2,
#           Linux: /proc/X/exe), fuehrt dieselbe Datei aus (Geraet/Inode: Mac
#           apple[] executable_file, Linux stat /proc/X/exe), und die Datei hat
#           genau einen Namen. Ein Hardlink ist sonst nicht zu erkennen:
#           proc_pidpath meldet den zuletzt aufgeloesten Namen einer Datei, ein
#           ueber einen Link gestarteter Prozess heisst nach `cat <echter Pfad>`
#           wie das Original (gemessen 2026-10-14);
#         - Argumente und Arbeitsordner des Kernstarts: Mac `<kernordner>
#           --headless` und cwd = <kernordner> (Kernstart.swift), Linux `. --show`
#           (seit Electron 42 in /proc auch `--show .`, beide genau so) und cwd =
#           <kernordner> (shell/linux/agent-workbench);
#         - Linux zusaetzlich: die Umgebung von X (/proc/X/environ) enthaelt nur
#           HOME (= Benutzerdatenbank), USER, LOGNAME, SHELL, PATH (fest) und die
#           Liste M2_UMGEBUNG_LINUX. `systemd-run --user` gibt jedem Programm
#           dasselbe Elternteil; LD_PRELOAD, GTK_MODULES & Co. faengt erst das.
#           Ist /proc/X/environ ganz NUL (Electron 42, setproctitle), pruefen
#           stattdessen die ausfuehrbaren Abbildungen in /proc/X/maps (im Kernordner
#           nur die Dateien der Electron-dist aus KERN_DATEIEN_LINUX mit einem Namen,
#           sonst root-eigen, Ordnerkette nicht schreibbar; docs/AGENTS-RECHTE.md);
#         - Mac zusaetzlich, fuer App UND Kern-Electron: die Datei ist samt aller
#           Ordner darueber nicht vom Benutzer beschreibbar ODER der laufende
#           Prozess erfuellt die Code-Anforderung M2_ANFORDERUNG_MAC (`codesign
#           --verify -R=<anforderung> <pid>`, Signierzertifikat mit Blatt e3b67e...).
#           Heute traegt nur die Signatur: /Applications ist root:admin 775, und
#           <user> ist admin. Die Umgebung von X prueft der Mac nicht: die
#           geprueft echte App startet den Kern nur mit der Positivliste
#           (Kernstart.swift, installierter Betrieb);
#         - Den Kern aus node_modules/electron (die App vor dem 14.10.) nimmt
#           M2 nicht mehr an, unter keiner App. Ein Uebergang dafuer stand vom
#           14.10. abends bis zum Ausrollen hier; er hatte kein zeitliches Ende,
#           und ein Downgrade auf eine signierte alte App hielt ihn offen
#           (review-fusesfix F1). Nach einem erneuten mac/bin/installieren ist
#           M2 bis zum Neustart der App nein: codesign lehnt laufende Prozesse
#           ab, deren Datei ersetzt ist (gemessen 14.10.);
#         - der Elternprozess P von X ist auf dem Mac die installierte App
#           (M2_APP_MAC), auf Linux `systemd --user` (M2_ELTERN_LINUX); P ist
#           Kind von PID 1 und nicht spaeter gestartet als X.
#       "~/" in diesen Listen ist das Heimatverzeichnis aus der Benutzerdatenbank,
#       nie $HOME: das setzt der Aufrufer.
#       Bis 2026-10-14 reichte ein Ahne, dessen Kommandoname wie "electron"
#       aussah. Ein abgekoppelter Agent unter einem selbst gebauten Programm
#       namens "Electron" bekam damit M2 (Review mensch-review, Fund 2, gemessen).
#       Auch der volle Pfad aus `ps -o comm=` taugt auf dem Mac nicht: er ist
#       argv[0], frei waehlbar per `exec -a` oder Symlink (gemessen 2026-10-14:
#       comm "/fake/argv0/Electron", proc_pidpath "/bin/sleep").
#       Dev-Buendel (mac/build/Werkbank.app), Worktree- und Test-Kerne sind
#       damit bewusst KEIN Menschen-Nachweis. Die Tests pruefen eine Kopie, in der
#       nur diese Konstanten auf Attrappen umgeschrieben sind; es gibt keinen
#       Schalter und keine Datei, die das installierte Werkzeug lockert.
#       Auf peer ist das ausgefuehrte Programm von `systemd --user` fuer den
#       Benutzer nicht lesbar (Permission denied, gemessen 2026-10-14); dort
#       zaehlt ersatzweise dessen Kommandozeile mit derselben UID. Das schwaecht
#       nichts: `systemd-run --user` startet ohnehin jedes Programm unter dem
#       echten `systemd --user`, die Last liegt auf der Pruefung von X.
#       Startet der Nutzer die App auf peer aus einem eigenen Terminal, ist P die
#       Shell und M2 greift NICHT; dort traegt M1, solange der Kern das
#       steuernde Terminal an wb-mensch vererbt. Eine Elternkette bis zu einem
#       Terminal-Emulator oder login als Ersatz waere so faelschbar wie M1
#       selbst (siehe GRENZE) und ist deshalb bewusst nicht eingebaut.
#
# GRENZE, offen benannt: gegen einen Agenten, der seine Herkunft AKTIV verwischt
# (Umgebung leeren, `setsid`, ein eigenes Pseudoterminal aufmachen), schuetzt das
# nicht -- als derselbe Benutzer gibt es dagegen in einer Shell kein Mittel.
# Abgewehrt wird der reale Fall: ein Agent, der das Merkmal in der Dokumentation
# oder im Code liest und es einfach mitschickt.
#
# Fuer M2 gilt dieselbe Grenze in anderer Form: M2 bindet an die echten
# Programmdateien, nicht an alles, was darin laeuft. Seit 2026-10-14 nimmt das
# Kern-Electron keinen fremden Code ueber ELECTRON_RUN_AS_NODE, NODE_OPTIONS,
# --inspect oder einen fremden App-Ordner mehr an, die installierte Mac-App
# startet es mit geleerter Umgebung (ein `open --env` erreicht den Kern nicht
# mehr), und auf Linux prueft M2 Umgebung und Argumente des Kerns selbst.
# Offen bleibt, was derselbe Benutzer an DATEIEN aendern kann: den Kernordner
# (dist/, node_modules, Einstellungen, ~/.local/bin, aus dem der Kern Werkzeuge
# startet), das Kern-Electron selbst und auf dem Mac auch die App. Eine
# Signatur bindet App und Kern-Electron an das Signierzertifikat (Blatt e3b67e...,
# laut codesign "Local Dev"); dessen
# Schluessel liegt aber im Schluesselbund desselben Benutzers, und mac/bin/
# signieren benutzt ihn ohne Rueckfrage. Wer also App oder Kern-Electron
# austauscht UND neu signiert, besteht M2 weiter. Schliessen liesse sich das nur
# mit einer App, die root gehoert und in einem nicht vom Benutzer beschreibbaren
# Ordner liegt (/Applications ist root:admin 775, <user> ist admin, gemessen
# 2026-10-14), oder mit einem Schluessel ausserhalb seiner Reichweite. Ein Eintrag
# unter ~/Applications stand bis 2026-10-14 in der Liste und ist gestrichen: die
# App liegt dort nicht, und der Ordner ist ohne jedes Recht anlegbar.
#
# Fuer A4 ist eine Ecke dieser Grenze allerdings geschlossen (A4b): steht ein
# Fernzugangs-Server (sshd, tailscaled, mosh-server) in der Ahnenreihe und laesst sich
# die Gegenstelle NICHT messen, ist die Antwort Nein. Dasselbe gilt, wenn die Ahnenreihe
# vor ihrem regulaeren Ende abreisst oder die eigenen Adressen nur die Rueckschleife
# ergeben: eine halbe Messung ist keine Messung. Ein Agent kann seine Umgebung
# leeren oder faelschen und ein eigenes Pseudoterminal samt utmp-Eintrag anlegen, aber
# er kann in die echte utmp-Datei keinen Eintrag unter der PID eines root-Prozesses
# schreiben (auch utempter traegt immer seine eigene PID ein).
#
# Den Server aus der Elternkette entfernen kann er dagegen auf Linux, sobald
# unprivilegierte Benutzer-Namensraeume erlaubt sind (kernel.unprivileged_userns_clone=1).
# Gemessen 2026-10-10 auf peer in einer echten SSH-Schleife auf die eigene Maschine:
# `unshare --user --map-root-user --pid --fork --mount-proc wb-mensch beleg` ergab
# "mensch ... (M1)". Im neuen PID-Namensraum ist wb-mensch selbst PID 1, sshd ist nicht
# mehr zu sehen, das Terminal bleibt. Mit eigenem Mount-Namensraum lassen sich ausserdem
# /proc, die utmp-Datei und ps ueberblenden. Das ist AKTIVES Verwischen und gehoert zur
# GRENZE oben; SSH braucht es dafuer nicht einmal. Auf macOS gibt es keine solchen
# Namensraeume. Seit A5 (2026-10-10) ergibt der Namensraum selbst Nein; offen bleibt nur
# die aufwendigere Form, die in einem eigenen Mount-Namensraum auch /proc ueberblendet.
set -uo pipefail

# Fester Suchpfad VOR dem ersten Kommando. Die Aufrufer reichen einen PATH mit
# /opt/homebrew/bin und /usr/local/bin durch, und beide gehoeren auf dem Mac dem
# Benutzer selbst (drwxrwxr-x <user> admin, gemessen 2026-10-10). Ein Agent legt dort
# ein eigenes `ps` ab, das Ahnen versteckt und ein Terminal meldet, und schon ist er
# ein Mensch. Alles, was dieses Werkzeug aufruft (ps, grep, awk, sort, tr, ifconfig,
# ip, env, id, stat, perl, python3, uname, readlink), liegt auf dem Mac und auf peer in diesen vier
# root-eigenen Verzeichnissen (gemessen 2026-10-10). tmux kommt aus tmux_fest,
# tailscale aus festen Pfaden (eigene_adressen).
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# M2: die ECHTE Werkbank (Kopf, M2). Feste Listen, keine Umgebung, keine Datei.
# "~/" ist das Heimatverzeichnis aus der Benutzerdatenbank (pwd), nicht $HOME.
# Die Tests schreiben genau diese Zeilen in einer KOPIE auf Attrappen um.
M2_KERN_ORDNER=('~/AI/claude-workbench/app')
M2_APP_MAC=('/Applications/Werkbank.app/Contents/MacOS/Werkbank')
M2_ELTERN_LINUX=('/usr/lib/systemd/systemd')
# Mac: Code-Anforderung an App und Kern-Electron, wenn deren Datei vom Benutzer
# beschreibbar ist (gemessen 14.10.: /Applications/Werkbank.app gehoert <user>). Das
# Blatt des Signierzertifikats (mac/bin/signieren; codesign meldet "Local Dev"),
# abgelesen an der installierten App.
M2_ANFORDERUNG_MAC=('certificate leaf = H"e3b67e6589a3cae7a97412b5625e3863a0c4a50e"')
# Linux: Variablen, die der Kern neben HOME, USER, LOGNAME, SHELL und PATH tragen darf
# (shell/linux/agent-workbench setzt genau diese Umgebung).
M2_UMGEBUNG_LINUX=(DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP XDG_SESSION_ID XDG_SEAT DESKTOP_SESSION DBUS_SESSION_BUS_ADDRESS LANG LANGUAGE LC_ALL LC_CTYPE LC_MESSAGES LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY SSH_AUTH_SOCK)

CMD="${1:-pruefen}"

# Kommandonamen der bekannten Harnesses. Die eingebaute Liste ist die Untergrenze;
# die Registry darf ERGAENZEN, nie wegnehmen -- eine kaputte oder fehlende
# models.json darf die Erkennung nicht schwaechen.
harness_kommandos() {
    printf '%s\n' claude pi codex aider opencode agy
    /usr/bin/python3 - "$HOME/.claude/workbench/models.json" <<'PY' 2>/dev/null || true
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for h in (d.get("harnesses") or []):
    c = h.get("command")
    if isinstance(c, str) and c:
        print(os.path.basename(c.rstrip("/")))
PY
}

# Ahnenreihe, innerster Prozess zuerst: "<pid> <kommando-basename>". Reisst die
# Lese vor ihrem regulaeren Ende (PID <= 1 oder ppid 0) ab, ist die letzte Zeile
# "UNVOLLSTAENDIG <grund>" (A2b). Eine Markierung im Strom statt eines Status:
# die Aufrufer lesen ueber `$(…)`, und eine dort gesetzte Variable kaeme nie an.
ahnen() {
    local pid=${1:-$$} zeile ppid comm
    # `read` statt Parameter-Expansion: `ps -o ppid=` polstert die Spalte LINKS
    # mit Leerzeichen, wodurch `${zeile%% *}` leer wird und die Kette nach zwei
    # Prozessen abbrach (gemessen 2026-08-06 -- die Harness-Pruefung A2 fiel
    # dadurch still aus und nur die Rueckfallzeile griff noch). `read` frisst
    # fuehrende Trenner und laesst den REST der Zeile im zweiten Feld, also
    # bleiben Kommandonamen mit Leerzeichen ganz.
    while [ "$pid" -gt 1 ] 2>/dev/null; do
        zeile=$(ps -o ppid=,comm= -p "$pid" 2>/dev/null) \
            || { printf 'UNVOLLSTAENDIG ps scheiterte an PID %s\n' "$pid"; return 0; }
        [ -n "$zeile" ] \
            || { printf 'UNVOLLSTAENDIG ps lieferte nichts fuer PID %s\n' "$pid"; return 0; }
        read -r ppid comm <<<"$zeile"
        printf '%s %s\n' "$pid" "${comm##*/}"
        case "${ppid:-}" in
            ''|*[!0-9]*) printf 'UNVOLLSTAENDIG keine ppid fuer PID %s\n' "$pid"; return 0 ;;
        esac
        pid=$ppid
    done
}

# Liest die Ahnenreihe EINMAL fuer A2, A3 und M2: AHNEN = die Zeilen "<pid> <name>",
# AHNEN_LUECKE = der Grund eines Abbruchs, leer bei regulaerem Ende.
AHNEN=""
AHNEN_LUECKE=""
ahnen_lesen() {
    local aus zeile
    aus=$(ahnen)
    AHNEN=""
    AHNEN_LUECKE=""
    while IFS= read -r zeile; do
        case "$zeile" in
            "UNVOLLSTAENDIG "*) AHNEN_LUECKE=${zeile#UNVOLLSTAENDIG } ;;
            ?*) AHNEN="$AHNEN$zeile"$'\n' ;;
        esac
    done <<<"$aus"
}

# Das tmux-Binary kommt aus einer festen Systemliste, nicht aus einem vom
# Aufrufer steuerbaren Suchpfad. Auf Apple Silicon liegt es regulaer in
# /opt/homebrew/bin, auf Intel-Macs und vielen Linux-Systemen unter /usr/local
# bzw. /usr/bin.
tmux_fest() {
    local kandidat
    for kandidat in /opt/homebrew/bin/tmux /usr/local/bin/tmux /usr/bin/tmux /bin/tmux; do
        [ -x "$kandidat" ] && { printf '%s\n' "$kandidat"; return 0; }
    done
    return 1
}

# Eigene lokale tmux-Sockets, auch wenn TMUX/TMUX_PANE absichtlich fehlen.
# Der TMUX-Wert ist nur ein zusaetzlicher Hinweis; jede gefundene Karte wird
# unten gegen die wirkliche Ahnenkette geprueft. Ein erfundener Socket oder
# Pane-Name ist deshalb kein Menschen- oder Agentenbeleg.
tmux_sockets() {
    local uid socket dir eigentuemer
    uid=$(/usr/bin/id -u 2>/dev/null) || return 1
    if [ -n "${TMUX:-}" ]; then
        socket=${TMUX%%,*}
        if [ -S "$socket" ]; then
            eigentuemer=$(/usr/bin/stat -c '%u' "$socket" 2>/dev/null \
                || /usr/bin/stat -f '%u' "$socket" 2>/dev/null || true)
            if [ "$eigentuemer" = "$uid" ]; then
                printf '%s\n' "$socket"
            fi
        fi
    fi
    # Auf macOS ist /tmp ein Verweis auf /private/tmp: ohne diesen Abgleich stand
    # jeder Socket zweimal in der Liste. Verglichen wird der physische Pfad; ein
    # Verzeichnis wird nur uebersprungen, wenn es DASSELBE ist wie ein schon
    # durchsuchtes, es geht also kein Socket verloren.
    # `stat -c` zuerst: GNU `stat -f '%u' DIR` liest '%u' als zweite DATEI, druckt die
    # Dateisystem-Angaben von DIR auf stdout und scheitert -- der Rueckfall haengte dann
    # "1000" an diesen Text, kein Eigentuemer passte, und A3 fand auf Linux nie einen
    # Socket (gemessen 2026-10-09 auf peer). BSD-stat kennt -c nicht und schweigt auf stdout.
    local physisch gesehen=" "
    for dir in "/private/tmp/tmux-$uid" "/tmp/tmux-$uid" "${TMPDIR:-/tmp}/tmux-$uid"; do
        [ -d "$dir" ] || continue
        eigentuemer=$(/usr/bin/stat -c '%u' "$dir" 2>/dev/null \
            || /usr/bin/stat -f '%u' "$dir" 2>/dev/null || true)
        [ "$eigentuemer" = "$uid" ] || continue
        physisch=$(CDPATH= cd -P "$dir" 2>/dev/null && pwd -P) || physisch=$dir
        case "$gesehen" in *" $physisch "*) continue ;; esac
        gesehen="$gesehen$physisch "
        for socket in "$dir"/*; do
            [ -S "$socket" ] || continue
            printf '%s\n' "$socket"
        done
    done
}

# Tote Sockets vorab aussortieren: EIN Prozess versucht je Socket ein connect().
# Vorher startete jeder Socket einen eigenen `tmux list-panes`, tote eingeschlossen;
# mit 152 liegengebliebenen Sockets dauerte ein `wb-pane-write` 4 bis 5 s
# (nacht-rot2, 2026-09-30, per Trace).
#
# Tot ist ein Socket NUR, wenn connect() mit ECONNREFUSED (niemand lauscht) oder
# ENOENT (Datei weg) scheitert. Genau dann scheitert auch der tmux-Client selbst
# ("no server running"), und die Schleife unten haette den Socket ohnehin
# uebersprungen -- die Pruefung wird dadurch fuer keinen lebenden Server milder.
# Jeder andere Ausgang (Verbindung steht, EAGAIN/EINPROGRESS bei vollem Rueckstau,
# EACCES, ein zu langer Pfad, ein Fehler von perl selbst) laesst den Socket drin:
# im Zweifel fragt tmux ihn ab wie bisher. Nicht blockierend, damit ein voller
# Rueckstau unter Linux diese Pruefung nicht anhaelt.
# perl mit festem Pfad und `env -i`: PERL5OPT/PERL5LIB des Aufrufers duerfen hier
# keinen Code einschleusen. Fehlt perl, bleiben alle Sockets drin.
lebende_sockets() {
    local sockets=() socket
    while IFS= read -r socket; do
        [ -n "$socket" ] && sockets+=("$socket")
    done
    [ "${#sockets[@]}" -gt 0 ] || return 0
    local lebend
    if [ -x /usr/bin/perl ] && lebend=$(/usr/bin/env -i /usr/bin/perl -e '
        use strict; use Socket; use Fcntl; use Errno;
        my $aus = "";
        for my $p (@ARGV) {
            if (length($p) > 100) { $aus .= "$p\n"; next }
            my $s;
            unless (socket($s, PF_UNIX, SOCK_STREAM, 0)) { $aus .= "$p\n"; next }
            my $f = fcntl($s, F_GETFL, 0);
            fcntl($s, F_SETFL, $f | O_NONBLOCK) if defined $f;
            my $ok = connect($s, pack_sockaddr_un($p));
            $aus .= "$p\n" if $ok || !($!{ECONNREFUSED} || $!{ENOENT});
            close($s);
        }
        print $aus;' -- "${sockets[@]}" 2>/dev/null); then
        [ -n "$lebend" ] && printf '%s\n' "$lebend"
        return 0
    fi
    printf '%s\n' "${sockets[@]}"
}

# Startet dieser Prozess unter einem Pane, der als Agent markiert ist? Geprueft
# wird ueber die pane_pid, nicht ueber $TMUX_PANE: die Variable ist eine
# Behauptung, die Prozesstabelle ist es nicht.
agenten_pane() {
    local tmux_bin socket karte alle_karten=""
    tmux_bin=$(tmux_fest) || return 1
    while IFS= read -r socket; do
        [ -n "$socket" ] || continue
        karte=$("$tmux_bin" -S "$socket" list-panes -a \
            -F '#{pane_pid} #{@wb_role}' 2>/dev/null) || continue
        [ -n "$karte" ] || continue
        alle_karten="${alle_karten}${alle_karten:+
}${karte}"
    done < <(tmux_sockets | lebende_sockets)
    karte=$alle_karten
    [ -n "$karte" ] || return 1
    local pid
    while read -r pid _; do
        [ -n "$pid" ] || continue
        printf '%s\n' "$karte" | awk -v p="$pid" '$1==p && ($2=="worker" || $2=="orchestrator"){f=1} END{exit !f}' \
            && return 0
    done <<<"$AHNEN"
    return 1
}

# Alle Adressen, unter denen DIESE Maschine erreichbar ist -- gemessen, nie verdrahtet.
# Zwei Schnittstellen-Quellen, weil keine allein reicht: `ifconfig` deckt macOS und BSD
# ab, `ip -o addr` Linux (peer). Ausgabe je Zeile "<schnittstelle> <adresse>". Die
# Rueckschleife steht ausserdem ausdruecklich drin und nicht nur, weil sie zufaellig in
# jeder Schnittstellenliste auftaucht: sie ist der Fall, den man zuerst probiert.
#
# `tailscale ip` nur ueber feste root-eigene Pfade (peer: /usr/bin/tailscale). Auf dem
# Mac liegt der Client allein in /opt/homebrew/bin und wird darum nicht gefragt; das
# kostet nichts, weil die Tailscale-Adresse auch an der Schnittstelle steht (gemessen
# 2026-10-10: Mac utun0 <mac-ip> in ifconfig, peer tailscale0 <peer-ip> in ip).
#
# Exit 1, wenn keine Schnittstellen-Quelle eine Adresse ausserhalb der Rueckschleife
# geliefert hat: dann ist die Liste unvollstaendig, und ein Selbst-SSH ueber die LAN-
# oder Tailscale-Adresse saehe wie eine fremde Gegenstelle aus.
eigene_adressen() {
    local schnitt
    schnitt=$(
        ifconfig 2>/dev/null | awk '/^[^ \t]/ { s = $1; sub(/:$/, "", s) }
                                    $1=="inet" || $1=="inet6" { print s, $2 }'
        ip -o addr show 2>/dev/null | awk '{ for (i=3;i<NF;i++) if ($i=="inet" || $i=="inet6") print $2, $(i+1) }'
    )
    printf 'lo 127.0.0.1\nlo ::1\n'
    [ -n "$schnitt" ] && printf '%s\n' "$schnitt"
    local ts
    for ts in /usr/bin/tailscale /usr/sbin/tailscale; do
        [ -x "$ts" ] || continue
        "$ts" ip 2>/dev/null | awk 'NF { print "tailscale", $1 }'
        break
    done
    printf '%s\n' "$schnitt" | awk '$1 !~ /^lo[0-9]*$/ && $2 != "" { f = 1 } END { exit !f }'
}

# Fernzugangs-Server in der Ahnenreihe. sshd heisst je nach Fassung `sshd`,
# `sshd-session` oder `sshd-auth`; `ps -o comm=` liefert dabei auf macOS den vollen
# Prozesstitel ("sshd-session: <user> [priv]", gemessen 2026-08-06), daher der Praefix.
# `tailscaled` ist der Server von Tailscale SSH: auf dem Mac kommt eine Anmeldung von
# peer als tailscaled (root) -> /usr/bin/login -h <gegenstelle> -> zsh, ganz ohne sshd
# (gemessen 2026-10-09). `mosh-server` loest sich nach dem Start von seinem sshd und
# haengt danach unter launchd/systemd (gemessen 2026-10-09 auf dem Mac); bis dahin
# fing nur die geerbte Umgebungsvariable die Schleife `mosh 127.0.0.1` ab.
fernzugang_name() {
    case "$1" in
        sshd|sshd:*|sshd\ *|sshd-session*|sshd-auth*|tailscaled|mosh-server|mosh-server\ *) return 0 ;;
    esac
    return 1
}

