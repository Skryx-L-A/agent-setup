# A5: laeuft dieser Prozess ausserhalb der Anfangs-Namensraeume? GRUND_NS traegt die
# Begruendung. Exit 0 = nicht Mensch.
GRUND_NS=""
fremder_namensraum() {
    local plattform user_ns pid_ns
    plattform=$(/usr/bin/uname -s 2>/dev/null) || plattform=""
    case "$plattform" in
        Darwin) return 1 ;;
        Linux)  ;;
        *)
            GRUND_NS="Plattform '${plattform:-unbekannt}' ohne Namensraum-Messung -- die Ahnenreihe ist nicht als vollstaendig belegt (A5)."
            return 0 ;;
    esac
    user_ns=$(readlink /proc/self/ns/user 2>/dev/null) || user_ns=""
    pid_ns=$(readlink /proc/self/ns/pid 2>/dev/null) || pid_ns=""
    if [ "$user_ns" = "user:[4026531837]" ] && [ "$pid_ns" = "pid:[4026531836]" ]; then
        return 1
    fi
    if [ -z "$user_ns" ] || [ -z "$pid_ns" ]; then
        GRUND_NS="Namensraum nicht messbar (/proc/self/ns fehlt oder ist nicht lesbar) -- die Ahnenreihe ist nicht als vollstaendig belegt (A5)."
    else
        GRUND_NS="Prozess laeuft in einem eigenen Benutzer- oder PID-Namensraum ($user_ns, $pid_ns) -- die Ahnenreihe ist nicht vollstaendig sichtbar (A5)."
    fi
    return 0
}

