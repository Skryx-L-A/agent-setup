#!/usr/bin/env bash
# Revive a DEAD workbench pane, resuming its conversation.
#
# A pane SIGKILLed by jetsam/OOM stays as a dead pane (remain-on-exit on). We
# respawn it with the same model/role/flags AND the resume flags of ITS harness.
#
# Welche Flags das sind, steht seit dem 2026-08-06 in der Registry (`resume` am
# Harness) und nicht mehr in diesem Skript. Vorher stand hier eine Textersetzung auf
# das Wort "claude " — die traf genau einen Harness, und der Registry-Block wirkte nur
# beim ersten Spawn. Kann ein Harness nicht fortsetzen, kommt der Pane trotzdem
# zurueck, aber leer, und die Meldung sagt warum.
#
# LIVENESS GUARD (2026-08-04). Until today this script respawned unconditionally,
# and `respawn-pane -k` kills whatever runs in the pane — including a Claude that
# was working. The way in is a single keystroke (prefix + R), so one misfire threw
# away a running conversation. Measured, reproducible, not a near miss. Now every
# path checks #{pane_dead} once, in guard_live(), immediately before the only
# respawn-pane call. A live pane is left alone, says so, and exits 3 (distinct
# from the 0 of a real revive) instead of doing nothing silently.
#
# Why --force exists anyway: the original trigger for this tool was a pane that
# LOOKED frozen. That case turned out to be a dead pane behind remain-on-exit
# (see the vault note of 2026-07-11), but a genuinely hung TUI — process alive,
# terminal unresponsive — is real and has no other way out than a respawn. So the
# case keeps a way in, just never the default one: --force plus a confirmation.
# Interactively the confirmation is a [j/N] prompt; without a terminal (tmux
# run-shell, hooks, scripts) --force additionally requires --yes. That way the
# prefix + R binding, which has no tty, can never force-kill a live pane no
# matter what a stray keypress does.
#
# Command source, in order of preference:
#   1. @wb_cmd — the clean, re-executable command stored at spawn time by the
#      workbench launchers. THIS is authoritative.
#   2. #{pane_start_command} — tmux's *escaped display* form. Fallback only, for
#      panes created before @wb_cmd existed. NOTE: this form does not round-trip
#      cleanly for commands containing "$(cat ...)" and nested quotes — feeding it
#      back to respawn-pane double-wraps the quoting and the respawn exits 1. That
#      historical bug is exactly why @wb_cmd is now preferred.
#
# DIE KENNUNG DER UNTERHALTUNG (2026-09-05). `{resumeId}` in `resume.args` loest
# dieses Skript je Harness auf: claude ueber die Zustandsdatei der Werkbank, jeder
# andere Harness ueber seinen Block `resume.kennung` (verfahren + ort) — heute
# cline-sessions, forge-sqlite und jcode-sessions. Gesucht wird immer die Unterhaltung
# DIESES Panes: gleiches Arbeitsverzeichnis (`--dir` der Startzeile) und entstanden
# zwischen Start (@wb_started) und Tod (pane_dead_time) des Panes, davon die aelteste.
# Ohne eindeutigen Treffer greift fallbackArgs, und die Meldung nennt den Grund.
# Einzelheiten am Aufloeser unten.
#
# EINE Wiederbelebung je Pane (2026-08-15). Es gibt zwei Wege hierher — den
# pane-died-Hook ueber wb-autorevive und den Tastendruck prefix + R — und beide sahen
# denselben toten Pane. Der zweite `respawn-pane -k` beendet dann die Unterhaltung, die
# der erste gerade fortgesetzt hat; die Drossel in wb-autorevive half nicht, sie entsteht
# erst nach dem Jitter-Schlaf und kennt den anderen Weg gar nicht. Deshalb liegt die
# Sperre HIER, an der einzigen Stelle, durch die beide Wege muessen: eine atomar
# angelegte Sperrmarke je Pane UND tmux-Server, und die Lebend-Pruefung findet INNERHALB
# der Sperre statt — wer als Zweiter kommt, sieht den bereits wiederbelebten Pane leben
# und laesst ihn in Ruhe.
#
# Usage: wb-revive [--force [--yes]] [--model <id>] [--effort <level>]
#                  [--tmux-socket <name>] [--trocken] [--resume-id <id>] [<pane-id>]
#
# --trocken (2026-09-25, fuer wb-schlaf): nichts neu starten, nur den Befehl
# berechnen, mit dem dieser Pane seine Unterhaltung fortsetzen wuerde. Ausgabe
# drei Zeilen "befehl\t...", "grund\t...", "harness\t...". Erlaubt auch fuer einen
# LEBENDEN Pane, weil nichts beendet wird. wb-schlaf legt eine Sitzung nur dann
# schlafen, wenn es diesen Befehl vorher kennt.
# --resume-id <id>: die Kennung ist schon bekannt (bei claude aus dem
# Sitzungsregister ~/.claude/sessions, genau DIESER Pane). Ein im Startbefehl
# stehendes --resume/--continue wird dann durch diese Kennung ersetzt, statt den
# Startbefehl unveraendert zu nehmen.
# Exit:  0 respawned   3 pane still alive, nothing done   2 usage/unknown pane
#        4 eine andere Wiederbelebung dieses Panes laeuft gerade
#
# Bound to: prefix + R   |   also called by wb-autorevive (pane-died hook)
set -euo pipefail

pane=""
force=0
confirmed=0
switch_model=""
switch_effort=""
tmux_socket=""
trocken=0
bind_only=0
resume_override=""
while [ $# -gt 0 ]; do
  case "$1" in
    --force)   force=1 ;;
    --yes|-y)  confirmed=1 ;;
    --model)   [ $# -ge 2 ] || { echo "wb-revive: --model braucht einen Wert" >&2; exit 2; }; switch_model="$2"; shift ;;
    --effort)  [ $# -ge 2 ] || { echo "wb-revive: --effort braucht einen Wert" >&2; exit 2; }; switch_effort="$2"; shift ;;
    --tmux-socket) [ $# -ge 2 ] || { echo "wb-revive: --tmux-socket braucht einen Wert" >&2; exit 2; }; tmux_socket="$2"; shift ;;
    --trocken) trocken=1 ;;
    --bind-only) bind_only=1 ;;
    --resume-id) [ $# -ge 2 ] || { echo "wb-revive: --resume-id braucht einen Wert" >&2; exit 2; }; resume_override="$2"; shift ;;
    -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
    -*)        printf 'wb-revive: unknown option %s\n' "$1" >&2; exit 2 ;;
    *)         [ -z "$pane" ] && pane="$1" ;;
  esac
  shift
done
pane="${pane:-${TMUX_PANE:?no pane}}"
tmux() {
  if [ -n "$tmux_socket" ]; then
    command tmux -L "$tmux_socket" "$@"
  else
    command tmux "$@"
  fi
}

# THE liveness guard — the one place that decides whether a respawn may happen.
# Called immediately before the single respawn-pane below; nothing respawns
# without passing through here.
guard_live() {
  local dead
  dead=$(tmux display-message -p -t "$pane" '#{pane_dead}' 2>/dev/null || true)
  if [ -z "$dead" ]; then
    printf 'wb-revive: pane %s not found\n' "$pane" >&2
    exit 2
  fi
  [ "$dead" = 1 ] && return 0   # dead pane: the normal, intended case

  if [ "$force" -ne 1 ]; then
    tmux display-message -t "$pane" "wb-revive: pane still running, nothing done (--force to override)" 2>/dev/null || true
    echo "wb-revive: $pane is still running (pane_dead=0), nothing done. Use --force --yes to restart it anyway."
    exit 3
  fi

  if [ "$confirmed" -ne 1 ]; then
    if [ -t 0 ]; then
      printf 'wb-revive: %s is still running. Kill the process and restart it? [j/N] ' "$pane" >&2
      local answer=""
      read -r answer || answer=""
      case "$answer" in
        j|J|ja|Ja|y|Y|yes|Yes) ;;
        *) echo "wb-revive: aborted, nothing done" >&2; exit 3 ;;
      esac
    else
      tmux display-message -t "$pane" "wb-revive: --force without a terminal also needs --yes" 2>/dev/null || true
      echo "wb-revive: $pane is still running and --force was given without a terminal to confirm on. Add --yes if that is really what you want."
      exit 3
    fi
  fi
  tmux display-message -t "$pane" "wb-revive: --force on a LIVE pane" 2>/dev/null || true
}

# Welcher Harness laeuft in diesem Pane? Abgeleitet aus dem Startbefehl, weil kein
# Spawner eine @wb_harness-Option setzt (nachgesehen 2026-08-06: wb-code, pi-worker,
# wb-ssh-worker und wb-agent setzen nur @wb_role, @wb_worker und @wb_cmd). Zwei Formen,
# mehr gibt es heute nicht:
#   1. Registry-Weg — "... wb-harness-run --model <id> ...": der Harness steht am Modell.
#   2. Eingebauter Weg — das Programm selbst in der Zeile: ".../claude " oder "exec pi ".
# Leer heisst UNBEKANNT, nicht "kaputt": dann verhaelt sich alles wie vor der Registry.
#
# ZWEITE STELLE: dieselbe Funktion steht in shell/context-guard. Sie ist bewusst
# doppelt und nicht in einer gemeinsamen Datei — ein drittes Skript waere ein
# weiteres Ausrollteil, und faellt es aus, ist der Guard still blind. Wer eine der
# beiden aendert, aendert beide; shell/tests/test-harness-wege.sh vergleicht sie
# Zeichen fuer Zeichen gegeneinander und schlaegt sonst fehl.
pane_harness() {   # <startbefehl> -> harness-id oder leer
  local c="$1" mid=""
  case "$c" in
    *wb-harness-run*)
      # Nur dieser Zweig braucht die Registry: der Harness haengt am Modell.
      [ -x "$HOME/.local/bin/wb-state" ] || { printf ''; return; }
      mid=$(printf '%s\n' "$c" | sed -nE 's/.*--model[= ]+([^ ]+).*/\1/p' | head -1)
      [ -n "$mid" ] && "$HOME/.local/bin/wb-state" models get "$mid" --field harness 2>/dev/null
      return ;;
  esac
  # Wortgrenze statt Teilzeichenkette: "--model claude-opus-5" ist KEIN claude-Aufruf,
  # "/Users/x/.local/bin/claude --model …" und "exec pi --provider …" sind welche.
  [[ "$c" =~ (^|[[:space:]/])claude([[:space:]]|$) ]] && { printf 'claude\n'; return; }
  [[ "$c" =~ (^|[[:space:]/])pi([[:space:]]|$) ]]     && { printf 'pi\n';     return; }
  printf ''
}

cmd=$(tmux show-options -pqv -t "$pane" @wb_cmd 2>/dev/null || true)
if [[ -z "$cmd" ]]; then
  cmd=$(tmux display-message -p -t "$pane" '#{pane_start_command}')
  # tmux (3.7c) gibt #{pane_start_command} in seiner eigenen Argument-Form aus: ein Pane,
  # der mit EINEM Befehlstext gestartet wurde, liefert ihn in Anfuehrungszeichen
  # ("exec claude --settings '{\"a\":1}' ..."). Unveraendert an respawn-pane gegeben,
  # sucht die Shell ein einziges Wort als Befehl und der Pane stirbt sofort mit
  # Status 127 (14.10.2026, wz-absturzbeleg Lauf 1 und 2: Pane ohne @wb_cmd). Ein
  # einzelnes Argument wird deshalb entpackt; mehrere bleiben in Shell-Form.
  cmd="$(/usr/bin/python3 - "$cmd" <<'PYQ'
import shlex, sys
c = sys.argv[1]
try:
    t = shlex.split(c)
except ValueError:
    t = []
print(t[0] if len(t) == 1 and t[0] != c else c)
PYQ
)"
fi

if [[ -z "$cmd" ]]; then
  tmux display-message -t "$pane" "wb-revive: kein Startbefehl am Pane, nichts zu tun"
  echo "wb-revive: $pane hat weder @wb_cmd noch ein pane_start_command — nichts getan."
  exit 0
fi

hid="$(pane_harness "$cmd")"
prole=$(tmux show-options -pqv -t "$pane" @wb_role 2>/dev/null || true)
if [[ -z "$hid" && -z "$prole" ]]; then
  # Weder ein bekannter Harness noch eine Workbench-Rolle: das ist ein fremder Pane.
  # Frueher stand hier "not a claude pane" — dieselbe Entscheidung, nur trifft sie
  # jetzt nur noch das, was wirklich nicht uns gehoert.
  tmux display-message -t "$pane" "wb-revive: kein Workbench-Pane, nichts zu tun"
  echo "wb-revive: $pane gehoert zu keinem registrierten Harness und traegt keine @wb_role — nichts getan."
  exit 0
fi

# The first prompt contains the unique result path for this worker. Match that
# marker in a Codex rollout, not a timestamp or the newest thread in a shared
# cwd. This also recovers a thread created just before pi-worker or the TUI died.
if [ "$hid" = codex ]; then
  bound="$(tmux show-options -pqv -t "$pane" @wb_thread 2>/dev/null || true)"
  bound_source="@wb_thread"
  bound_found=0
  initial="$(/usr/bin/python3 - "$cmd" <<'PY'
import shlex, sys
try:
    a = shlex.split(sys.argv[1])
    if '--initial-task-file' not in a:
        a = shlex.split(next(x for x in a if 'wb-harness-run' in x))
    i = a.index('--initial-task-file')
    print(a[i + 1])
except (ValueError, IndexError, StopIteration):
    pass
PY
)"
  if [ -z "$bound" ] && [ -n "$initial" ] && [ -f "$initial" ]; then
    bound_source="Codex-Zustandsspeicher"
    codex_home="$(tmux show-options -pqv -t "$pane" @wb_codex_home 2>/dev/null || true)"
    codex_home="${codex_home:-${CODEX_HOME:-$HOME/.codex}}"
    bound="$(/usr/bin/python3 - "$initial" "$codex_home" "$cmd" <<'PY'
import glob, os, re, shlex, sqlite3, sys
task, home, cmd = sys.argv[1:]
try:
    a = shlex.split(cmd)
    if '--dir' not in a:
        a = shlex.split(next(x for x in a if 'wb-harness-run' in x))
    cwd = a[a.index('--dir') + 1]
    marker = os.path.basename(task)[1:].removesuffix('.codex-start.txt') + '.md'
    if not marker.endswith('.md') or marker == '.md':
        raise ValueError('invalid marker')
    matches = set()
    for db in glob.glob(os.path.join(home, 'state_*.sqlite')):
        con = sqlite3.connect('file:%s?mode=ro' % db, uri=True, timeout=2)
        try:
            rows = con.execute('SELECT id, rollout_path FROM threads WHERE cwd IN (?, ?, ?)',
                               (cwd, os.path.normpath(cwd), os.path.realpath(cwd)))
            for thread, rollout in rows:
                if not re.fullmatch(r'[A-Za-z0-9._-]{1,128}', thread or '') or not rollout:
                    continue
                try:
                    with open(rollout, 'rb') as f:
                        if marker.encode() in f.read():
                            matches.add(thread)
                except OSError:
                    pass
        finally:
            con.close()
    if len(matches) == 1:
        print(matches.pop())
except (OSError, ValueError, IndexError, StopIteration, sqlite3.Error):
    pass
PY
)"
    if [ -n "$bound" ]; then bound_found=1; fi
  fi
  if [[ -n "$bound" && ! "$bound" =~ ^[A-Za-z0-9._-]{1,128}$ ]]; then
    echo "wb-revive: ${bound_source} ungültig, wird nicht benutzt." >&2
    tmux display-message -t "$pane" "wb-revive: ${bound_source} ungültig, wird nicht benutzt." 2>/dev/null || true
    bound=""
  fi
  if [ "$bound_found" -eq 1 ] && [ -n "$bound" ] && [ "$trocken" -eq 0 ]; then
    tmux set -p -t "$pane" @wb_thread "$bound"
  fi
  if [ -n "$bound" ] && [ "$trocken" -eq 0 ] && [ -n "$initial" ] && [ -f "$initial" ]; then
    rm -f "$initial" || { echo "wb-revive: gebundener Codex-Auftrag konnte nicht entfernt werden." >&2; exit 1; }
  fi
fi
if [ "$bind_only" -eq 1 ]; then
  [ -n "${bound:-}" ]
  exit $?
fi

# KEINE FREMDE LEBENDE UNTERHALTUNG (14.10.2026, Vorgabe des WorkbenchOrchestrators).
# Eine claude-Kennung, die laut Sitzungsregister (~/.claude/sessions/<pid>.json,
# Feld sessionId) einem LEBENDEN claude-Prozess gehoert, der nicht der Prozess dieses
# Panes ist, wird nie eingesetzt -- weder als --resume-id, noch aus der Zustandsdatei,
# noch als --resume im gespeicherten Startbefehl. Zwei Prozesse auf einer Unterhaltung
# schreiben beide in deren Transkript; am 14.10. uebernahmen die Kopien ausserdem die
# Remote-Control-Verbindung des Orchestrators. Ohne eigene Kennung startet ein
# claude-Pane FRISCH, ohne --resume und ohne das ratende fallbackArgs '--continue'
# (das nimmt die juengste Unterhaltung im Verzeichnis, also oft genau die fremde).
fremde_sitzung() {  # <kennung> -> PID des fremden lebenden Besitzers auf stdout, sonst nichts
  /usr/bin/python3 - "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions" "$1" "$2" <<'PYF'
import json, os, subprocess, sys
ordner, kennung, pane_pid = sys.argv[1], sys.argv[2], sys.argv[3]
def ps(feld, pid):
    r = subprocess.run(["ps", "-o", feld + "=", "-p", str(pid)], capture_output=True, text=True)
    return r.stdout.strip()
def lstart(pid):
    r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                       env=dict(os.environ, LC_ALL="C", TZ="UTC"))
    return " ".join(r.stdout.split())
def im_pane(pid):
    # Der Pane-Prozess selbst oder eines seiner Kinder darf die Kennung tragen.
    if not pane_pid.isdigit():
        return False
    for _ in range(64):
        if pid == int(pane_pid):
            return True
        eltern = ps("ppid", pid)
        if not eltern.isdigit() or int(eltern) <= 1:
            return False
        pid = int(eltern)
    return False
try:
    namen = sorted(os.listdir(ordner))
except OSError:
    namen = []
for n in namen:
    if not n.endswith(".json"):
        continue
    try:
        d = json.load(open(os.path.join(ordner, n)))
        pid = int(d.get("pid"))
    except Exception:
        continue
    if d.get("sessionId") != kennung:
        continue
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        continue
    except PermissionError:
        pass
    if ps("stat", pid).startswith("Z") or not ps("stat", pid):   # Zombie oder schon weg
        continue
    # Lebt GENAU der eingetragene Prozess? Mit procStart (Claude traegt es ein,
    # `LC_ALL=C TZ=UTC ps -o lstart=`, wie wb-inbox) entscheidet die Startzeit: eine
    # wiederverwendete PID ist kein Besitzer, ein node-gestarteter Besitzer ohne
    # "claude" in der Befehlszeile schon (Review-Fund F2, 14.10.). Nur ohne procStart
    # (aeltere Eintraege) bleibt der Rueckfall auf "claude" in der Befehlszeile.
    start = d.get("procStart")
    if isinstance(start, str) and start.strip():
        if " ".join(start.split()) != lstart(pid):
            continue
    elif "claude" not in ps("command", pid):
        continue
    if im_pane(pid):
        continue
    print(pid)
    break
PYF
}
# Resolve THIS pane's own conversation (2026-08-05). `--continue` resumes
# whichever conversation was last active in the pane's cwd -- with several
# sessions per folder (the normal case here, not the exception, see
# ~/.claude/workbench/sessions/*.json today) that can be a DIFFERENT pane's
# conversation. The state file whose `tmuxSession` matches THIS pane's tmux
# session carries the right `claudeSessionId` (written by wb-code at start;
# app/src/main/revive.ts uses the same field for the UI's own resume button).
# Same STATEDIR path as wb-state/wb-doctor/wb-session-delete -- one truth, not
# a second guess at the same folder. Anything short of a clean match (no
# state dir, no matching file, unreadable JSON, no id) fell back to --continue
# until 14.10.2026; a claude pane now starts fresh instead (see "KEINE FREMDE
# LEBENDE UNTERHALTUNG" below).
#
# NUR FUER DEN ORCHESTRATOR (14.10.2026). Die Zustandsdatei beschreibt die Unterhaltung
# des Orchestrator-Panes, nicht die der Session. Bis heute bekam JEDER Pane der Session
# deren claudeSessionId: am 14.10. 00:06 setzte wb-autorevive vier Agent-Panes in der
# IOS-Session mit `--resume 071f597e-…` neu auf -- der laufenden Unterhaltung des
# IOS-Orchestrators (Pane %35). Ein anderer Pane nimmt seine eigene Kennung
# (@wb_chat_session, vom Chat-Hook IM Harness-Prozess gesetzt, also diesem Pane
# eindeutig zugeordnet) oder keine.
sess="$(tmux display -p -t "$pane" '#{session_name}' 2>/dev/null || true)"
STATEDIR="$HOME/.claude/workbench/sessions"
#
# REIHENFOLGE FUER CLAUDE (14.10.2026, Review-Fund F1 des WorkbenchOrchestrators):
#   1. --resume-id (weiter unten, $resume_override)
#   2. Claudes Register der toten pane_pid (an genau diesen Prozess gebunden)
#   3. @wb_chat_session NUR, wenn sie mit der Zustandsdatei uebereinstimmt oder es
#      keine (eigene, nicht fremd belegte) Zustandsdatei-Kennung gibt
#   4. die Zustandsdatei (nur Orchestrator oder Pane ohne Rolle)
#   5. sonst frisch mit lauter Warnung
# Warum die Option nicht zuerst: Der Chat-Hook setzt sie bei JEDEM SessionStart im
# Pane, bis zum Hook-Filter "NUR DER HARNESS, DER DEN PANE BESITZT" auch fuer ein
# verschachteltes `claude -p`. Dessen Wegwerf-Kennung blieb an Orchestrator-Panes
# stehen; ein abgestuerzter Orchestrator kaeme damit in der falschen Unterhaltung zurueck.
resume_id=""
resume_eigen=""
resume_quelle=""
if [ "$hid" = claude ]; then
  resume_eigen="$(tmux show-options -pqv -t "$pane" @wb_chat_session 2>/dev/null || true)"
fi

# DAS REGISTER DER ALTEN PANE-PID (14.10.2026, Bedingung des WorkbenchOrchestrators:
# ein Orchestrator, der nach einem Absturz frisch zurueckkommt, verliert des Nutzers
# Gespraech). Claude legt je Prozess ~/.claude/sessions/<pid>.json an (pid, sessionId,
# cwd, tmux, ...). Nach SIGKILL bleibt die Datei einige Sekunden liegen (gemessen
# 14.10., wz-absturzbeleg: da nach 5 s, weg nach 30 s; vermutlich raeumt eine andere
# claude-Instanz sie ab). wb-autorevive laeuft im pane-died-Hook sofort und findet sie
# meist; spaeter (Taste, App) fehlt sie, dann greifen Option und Zustandsdatei. Die
# tote Pane-PID ist genau dieser Prozess: tmux behaelt #{pane_pid} eines toten Panes (remain-on-exit),
# und die Werkbank startet claude per exec im Pane (gemessen 14.10.: Register-PID ==
# pane_pid bei 27 von 27 lebenden claude-Panes). Genommen wird die Kennung NUR, wenn
#   (a) der Pane tot ist und diese PID nicht mehr lebt,
#   (b) das cwd der Registerdatei zum Pane passt (--dir, Start- oder letzter Pfad),
#       und ein gesetztes Feld tmux denselben Pane nennt,
#   (c) die Kennung keiner anderen lebenden claude-PID gehoert (fremde_sitzung).
register_grund=""
if [[ -z "$resume_id" && "$hid" = claude ]]; then
  r_pid="$(tmux display -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)"
  r_dead="$(tmux display -p -t "$pane" '#{pane_dead}' 2>/dev/null || true)"
  if [[ "$r_dead" = 1 && "$r_pid" =~ ^[0-9]+$ ]]; then
    r_out="$(/usr/bin/python3 - "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions" "$r_pid" "$pane" "$cmd" \
      "$(tmux display -p -t "$pane" '#{pane_start_path}' 2>/dev/null || true)" \
      "$(tmux display -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)" <<'PYR'
import json, os, re, shlex, subprocess, sys
ordner, pid, pane, cmd = sys.argv[1:5]
def lebt(pid, proc_start):
    # Lebt GENAU der Prozess, den die Registerdatei meint? Ein Zombie zaehlt als tot
    # (kill -0 trifft ihn noch), eine wiederverwendete PID auch: Claude traegt procStart
    # als `LC_ALL=C TZ=UTC ps -o lstart=` ein (gemessen 10.10., wie wb-inbox).
    try:
        os.kill(pid, 0)
