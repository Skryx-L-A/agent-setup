PYX
    then
      ohne_transkript="Kennung ${resume_id}${resume_quelle:+ (ueber ${resume_quelle})} hat kein Transkript im Verzeichnis des Panes -- --resume endete sofort mit 'No conversation found'"
      echo "wb-revive: WARNUNG $pane: ${ohne_transkript}." >&2
      resume_id=""
    fi
  fi
  cmd_id="$(/usr/bin/python3 - "$cmd" <<'PYI'
import re, sys
m = re.search(r"(?<!\S)(?:--resume|-r)(?:=|\s+)['\"]?([A-Za-z0-9._-]+)", sys.argv[1])
print(m.group(1) if m else "")
PYI
)"
  if [[ -n "$cmd_id" ]]; then
    besitzer="$(fremde_sitzung "$cmd_id" "$pane_pid")"
    if [[ -n "$besitzer" ]]; then
      fremd_grund="${fremd_grund:+$fremd_grund; }--resume ${cmd_id} im Startbefehl gehoert der lebenden Sitzung PID ${besitzer}"
      cmd="$(/usr/bin/python3 - "$cmd" <<'PYS'
import re, sys
c = re.sub(r"(?<!\S)(?:--resume|-r)(?:=|\s+)['\"]?[A-Za-z0-9._-]+['\"]?", "", sys.argv[1])
print(re.sub(r"  +", " ", c).strip())
PYS
)"
    fi
  fi
  if [[ -z "$resume_id" ]]; then
    claude_ohne_kennung="${fremd_grund:-${ohne_transkript:-keine eigene Kennung (weder @wb_chat_session noch Claude-Register der alten Pane-PID noch Orchestrator-Zustand)}}"
    [[ -n "$fremd_grund" && -n "$ohne_transkript" ]] && claude_ohne_kennung="${claude_ohne_kennung}; ${ohne_transkript}"
    [[ -n "$register_grund" ]] && claude_ohne_kennung="${claude_ohne_kennung}; Register: ${register_grund}"
  fi
  if [[ -n "$fremd_grund" ]]; then
    tmux display-message -t "$pane" "wb-revive: fremde Unterhaltung abgelehnt (${fremd_grund})" 2>/dev/null || true
    echo "wb-revive: WARNUNG $pane: fremde Unterhaltung nicht uebernommen -- ${fremd_grund}." >&2
  fi
fi

if [ "$hid" = codex ]; then
  resume_id="${bound:-}"
  # The installed registry may still say resume --last. Never use it for a
  # worker: a known thread gets its exact id; otherwise start without resume.
  if [ -n "$resume_id" ]; then
    resume_args="resume $resume_id"
    resume_why="Codex-Thread am Pane gebunden"
  else
    resume_args=""
    if [ -n "${initial:-}" ] && [ -f "$initial" ]; then
      resume_why="noch kein Codex-Thread; Erstauftrag wird erneut gestartet"
    else
      resume_why="kein Codex-Thread und kein Erstauftrag; frischer Start ohne Auftrag"
    fi
  fi
fi

if [[ -n "$resume_id" && ! "$resume_id" =~ ^[A-Za-z0-9._-]{1,128}$ ]]; then
  tmux display-message -t "$pane" "wb-revive: unplausible session id, falling back to --continue" 2>/dev/null || true
  resume_id=""
fi

if [[ "$cmd" == *"--continue"* || "$cmd" == *"--resume"* || "$cmd" == *"--restore-chat-history"* ]]; then
  # Der Startbefehl bringt sein Fortsetzen selbst mit (der eingebaute pi-Weg baut es
  # sich zur Laufzeit aus seinem Sitzungsordner). Nichts einfuegen, sonst steht es zweimal.
  newcmd="$cmd"
  resume_why="der Startbefehl setzt selbst fort"
elif [[ -z "$resume_args" ]]; then
  newcmd="$cmd"
  [ "$hid" = codex ] || resume_why="Harness '${hid:-unbekannt}' kennt kein Fortsetzen — der Pane kommt OHNE Unterhaltung zurueck"
else
  # {resumeId} aufloesen. Ohne plausible Kennung greift fallbackArgs; gibt es auch das
  # nicht, wird NICHT geraten — dann kommt der Pane leer zurueck und sagt es.
  if [[ "$resume_args" == *"{resumeId}"* ]]; then
    if [[ -n "$resume_id" ]]; then
      resume_args="${resume_args//\{resumeId\}/$resume_id}"
    else
      fb="$(printf '%s' "$hjson" | /usr/bin/python3 -c '
import json, shlex, sys
res = (json.load(sys.stdin).get("resume") or {}).get("fallbackArgs") or []
print(shlex.join(str(a) for a in res) if res else "")
')"
      # $resume_why traegt hier den Grund aus der Kennungssuche, wenn es einen gab.
      kgrund="${resume_why:+ (${resume_why})}"
      behalte_why=1   # der Grund ist die Kennungssuche, nicht das blosse Fortsetzen
      if [[ -n "$claude_ohne_kennung" ]]; then
        # Siehe "KEINE FREMDE LEBENDE UNTERHALTUNG": nicht raten, frisch starten.
        resume_args=""
        resume_why="frischer Start ohne Fortsetzen: ${claude_ohne_kennung}"
        frisch_laut=1
      elif [[ -n "$fb" ]]; then
        resume_args="$fb"
        resume_why="ohne Sitzungskennung${kgrund}, deshalb ${fb}"
      else
        resume_args=""
        resume_why="keine Sitzungskennung${kgrund} und kein Ersatz — der Pane kommt OHNE Unterhaltung zurueck"
      fi
    fi
  fi
  if [[ -z "$resume_args" ]]; then
    newcmd="$cmd"
  else
    # Zwei Wege, in dieser Reihenfolge:
    #   1. Der eingebaute Weg — das Programm des Harness steht selbst in der Zeile.
    #      Dann wird direkt dahinter eingefuegt, an einer Wortgrenze.
    #   2. Der Registry-Weg — in der Zeile steht `wb-harness-run`, das seine innere
    #      Befehlszeile selbst baut. Dorthin geht das Fortsetzen als `--resume-args`,
    #      und der Shim haelt es gegen den `resume`-Block, bevor er es benutzt
    #      (2026-08-06). Vorher endete dieser Fall damit, dass der Pane leer zurueckkam.
    newcmd="$(/usr/bin/python3 - "$cmd" "${hbase:-}" "$resume_args" <<'PY'
import re, shlex, sys
cmd, base, args = sys.argv[1], sys.argv[2], sys.argv[3]

def einfuegen(anker, text):
    if not anker:
        return None
    m = re.search(r'(?:^|[\s/])' + re.escape(anker) + r'(?=\s)', cmd)
    if not m:
        return None
    return cmd[:m.end()] + " " + text + cmd[m.end():]

neu = einfuegen(base, args)
if neu is None:
    neu = einfuegen("wb-harness-run", "--resume-args " + shlex.quote(args))
if neu is None:
    sys.exit(1)
print(neu)
PY
)" || newcmd=""
    if [[ -z "$newcmd" ]]; then
      newcmd="$cmd"
      resume_why="weder '${hbase:-?}' noch wb-harness-run stehen in der Startzeile — der Pane kommt OHNE Unterhaltung zurueck"
    elif [[ -z "${behalte_why:-}" ]]; then
      resume_why="fortgesetzt mit ${resume_args}${resume_quelle:+ (Kennung ueber ${resume_quelle})}"
    fi
  fi
fi

# Sperre zuerst, Lebend-Pruefung darin: siehe die Begruendung im Kopf.
if [ "$trocken" -eq 1 ]; then
  printf 'befehl\t%s\ngrund\t%s\nharness\t%s\n' "$newcmd" "$resume_why" "${hid:-}"
  exit 0
fi

SPERRE=""
sperre_frei() { [ -n "$SPERRE" ] && rmdir "$SPERRE" 2>/dev/null; SPERRE=""; }
SPERRE_MAX_S=120   # aelter heisst: der Halter ist gestorben, die Marke wird uebernommen
respawn_sperre() {
  local basis sockel schluessel stempel alter
  sockel="$(tmux display -p '#{socket_path}' 2>/dev/null || true)"
  basis="$HOME/.local/state/wb-revive-locks"
  mkdir -p "$basis" 2>/dev/null || return 0
  # Pane-Ids sind nur je tmux-SERVER eindeutig (%0 gibt es auf jedem frischen Socket).
  # Ohne den Socket im Schluessel wuerde eine Testsperre eine echte Wiederbelebung
  # blockieren — derselbe Fehler wie bei der Wachen-Erkennung ueber `pgrep`.
  schluessel="$basis/$(printf '%s%s' "${sockel:-default}" "$pane" | tr -c 'A-Za-z0-9' '_')"
  if ! mkdir "$schluessel" 2>/dev/null; then
    stempel="$(stat -c %Y "$schluessel" 2>/dev/null || stat -f %m "$schluessel" 2>/dev/null || echo 0)"
    alter=$(( $(date +%s) - stempel ))
    if [ "$alter" -lt "$SPERRE_MAX_S" ]; then
      tmux display-message -t "$pane" "wb-revive: eine andere Wiederbelebung laeuft gerade" 2>/dev/null || true
      echo "wb-revive: fuer $pane laeuft gerade eine andere Wiederbelebung (Sperre ${alter}s alt) — nichts getan."
      exit 4
    fi
    touch "$schluessel" 2>/dev/null || true
  fi
  SPERRE="$schluessel"
  trap sperre_frei EXIT
}

# LAUT, wenn ein claude-Pane frisch und damit OHNE seine Unterhaltung zurueckkommt
# (14.10.2026): stderr (wb-autorevive schreibt es ins Log), Statuszeile und eine rote
# Zeile im Pane selbst. Die Zeile kommt aus einem printf vor dem eigentlichen Befehl;
# `exec <shell> -c` danach haelt die PID-Kette wie ohne Warnung (die Shell ersetzt sich,
# der Befehl laeuft wie sonst), damit das Register der naechsten Wiederbelebung wieder
# unter #{pane_pid} liegt. Gespeichert wird weiter nur das saubere @wb_cmd.
startcmd="$newcmd"
if [[ -n "$frisch_laut" ]]; then
  warnung="WARNUNG wb-revive: ${pane} startet FRISCH, die bisherige Unterhaltung ist NICHT fortgesetzt -- ${claude_ohne_kennung}"
  echo "wb-revive: ${warnung}" >&2
  hshell="$(tmux show -gv default-shell 2>/dev/null || true)"
  [[ -x "$hshell" ]] || hshell=/bin/sh
  startcmd="printf '\\n\\033[1;37;41m %s \\033[0m\\n\\n' $(printf %q "$warnung"); exec $(printf %q "$hshell") -c $(printf %q "$newcmd")"
fi

respawn_sperre
guard_live
tmux respawn-pane -k -t "$pane" "$startcmd"
# Re-assert the CLEAN @wb_cmd so the next revive still has a good source
# (respawn-pane overwrites pane_start_command with the --continue variant).
tmux set -p -t "$pane" @wb_cmd "$cmd"
# Ein Respawn passiert nach Absturz oder tmux-Neustart — genau dann fehlt das
# dauerhafte `workers`-Fenster, weil es beim Sessionstart angelegt wird und einen
# Serverneustart nicht ueberlebt. Ohne es hat die Session nur EIN Fenster, und der
# Worker-Tab zeigt zwangslaeufig den Orchestrator (gemessen 2026-07-29).
# ($sess already resolved above for the resume-id lookup -- same tmux session.)
[ -n "$sess" ] && [ -x "$HOME/.local/bin/wb-workers-window" ] \
  && "$HOME/.local/bin/wb-workers-window" "$sess" >/dev/null 2>&1 || true

# Ein stiller Neuanfang, der aussieht wie eine Wiederbelebung, ist schlechter als ein
# ehrliches "dieser Harness kann es nicht". Deshalb steht in der Meldung IMMER, was mit
# der Unterhaltung passiert ist — in der Statuszeile und auf stdout.
if [[ -n "$frisch_laut" ]]; then
  tmux display-message -d 15000 -t "$pane" "!!! ${warnung} !!!" 2>/dev/null || tmux display-message -t "$pane" "!!! ${warnung} !!!"
else
  tmux display-message -t "$pane" "wb-revive [${hid:-?}]: ${resume_why}"
fi
echo "wb-revive: $pane neu gestartet (Harness ${hid:-unbekannt}) — ${resume_why}."
