def zeit_grenze(angabe):
    m = re.fullmatch(r"(\d+)([smhd])", angabe)
    if m:
        faktor = {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
        return jetzt() - _dt.timedelta(seconds=int(m.group(1)) * faktor)
    try:
        t = _dt.datetime.fromisoformat(angabe)
    except ValueError:
        raise Abbruch(EXIT_AUFRUF, "--seit erwartet eine Dauer (90s, 20m, 2h, 3d) oder eine ISO-Zeit.")
    return t if t.tzinfo else t.astimezone()


def zeigen(n):
    kopf = "#%d %s %s%s (%s) [%s]" % (n["nr"], n["zeit"], n["absender"],
                                      " [%s]" % n["absender_anzeige"] if n.get("absender_anzeige") else "",
                                      n["absender_rolle"], n["art"])
    if n.get("antwort_auf"):
        kopf += " Antwort auf %s" % n["antwort_auf"]
    if n.get("an"):
        kopf += " an %s" % ", ".join(n["an"])
    return kopf + " id " + n["id"] + "\n" + "\n".join("    " + z for z in n["text"].split("\n"))


def cmd_lies(argv):
    pos, werte, an = optionen(argv, ("--seit", "--letzte"), schalter=("--neu", "--json"))
    if len(pos) != 1:
        raise Abbruch(EXIT_AUFRUF, "Aufruf: wb-gruppe lies <name> [--neu] [--seit <zeit>] [--letzte n] [--json]")
    name = gueltiger_name(pos[0])
    daten = gruppe_lesen(name)
    liste = nachrichten(name)
    leser = None
    if "--neu" in an:
        wer = ich()
        leser = mitglied_schluessel(daten, wer) or wer["name"]
        stand = int(zeiger_lesen(name).get(leser, 0))
        liste = [m for m in liste if m["nr"] > stand]
    if "--seit" in werte:
        grenze = zeit_grenze(werte["--seit"])
        liste = [m for m in liste if _dt.datetime.fromisoformat(m["zeit"]) >= grenze]
    if "--letzte" in werte:
        if not werte["--letzte"].isdigit():
            raise Abbruch(EXIT_AUFRUF, "--letzte erwartet eine Zahl.")
        liste = liste[-int(werte["--letzte"]):] if int(werte["--letzte"]) else []
    if leser:
        with Sperre():
            zeiger_setzen(name, leser, int(gruppe_lesen(name).get("letzte_nr", 0)))
    if "--json" in an:
        print(json.dumps(liste, ensure_ascii=False, indent=1))
        return 0
    print("Gruppe %s — %s — Information, keine Befugnis" % (name, daten.get("zweck", "")))
    if not liste:
        print("(keine Nachrichten)")
    for m in liste:
        print(zeigen(m))
    return 0


def uebersicht(namen, wer, als_json):
    """`wer`: der gemessene Aufrufer (dict aus ich()) oder None."""
    zeilen = []
    for name in namen:
        daten = gruppe_lesen(name)
        leser = (mitglied_schluessel(daten, wer) or wer.get("name")) if wer and wer.get("name") else None
        stand = int(zeiger_lesen(name).get(leser, 0)) if leser else None
        ungelesen = None
        if leser:
            ungelesen = sum(1 for m in nachrichten(name) if m["nr"] > stand and m.get("absender") != leser)
        info = daten["mitglieder"].get(leser or "", {})
        zeilen.append({"gruppe": name, "zweck": daten.get("zweck", ""), "mitglieder": len(daten["mitglieder"]),
                       "nachrichten": daten.get("letzte_nr", 0), "ungelesen": ungelesen,
                       "modus": info.get("modus"), "mitglied": bool(info)})
    if als_json:
        print(json.dumps(zeilen, ensure_ascii=False, indent=1))
        return 0
    if not zeilen:
        print("(keine Gruppen)")
    for z in zeilen:
        teile = ["%-24s" % z["gruppe"], "%3d Mitgl." % z["mitglieder"], "%4d Nachr." % z["nachrichten"]]
        if z["ungelesen"] is not None:
            teile.append("%3d ungelesen" % z["ungelesen"])
        if z["modus"]:
            teile.append("Modus " + z["modus"])
