def nachricht_anlegen(name, wer, text, art, antwort_auf=None, an=(), recht=True):
    """Unter der Sperre aufrufen. Prueft Rechte (ausser recht=False), haengt an, rotiert."""
    t = jetzt()
    daten = gruppe_lesen(name)
    schluessel = None
    if recht and wer["name"] == TAFEL:
        if TAFEL not in daten.get("systemabsender", []):
            raise Abbruch(EXIT_RECHT, "Gruppe %s fuehrt den Systemabsender tafel nicht." % name)
    else:
        schluessel = mitglied_schluessel(daten, wer) if wer["name"] != TAFEL else None
        if recht and schluessel is None and wer["rolle"] != "mensch":
            raise Abbruch(EXIT_RECHT, "Schreiben duerfen nur Mitglieder von %s (%s%s ist keins)." % (
                name, wer["name"], (", " + wer["pane"]) if wer.get("pane") else ""))
    if antwort_auf and not any(m.get("id") == antwort_auf for m in nachrichten(name)):
        raise Abbruch(EXIT_FEHLER, "Nachricht %s gibt es in %s nicht." % (antwort_auf, name))
    for m in an:
        if m not in daten["mitglieder"]:
            raise Abbruch(EXIT_FEHLER, "--an %s: kein Mitglied von %s." % (m, name))
    daten["letzte_nr"] = int(daten.get("letzte_nr", 0)) + 1
    nachricht = {"id": "g-%s-%s" % (t.strftime("%Y%m%d%H%M%S"), secrets.token_hex(3)),
                 "nr": daten["letzte_nr"], "zeit": iso(t), "gruppe": name, "absender": schluessel or wer["name"],
                 "absender_rolle": wer["rolle"], "art": art, "text": text,
                 "erwaehnt": erwaehnungen(text)}
    if schluessel and schluessel != wer["name"]:
        nachricht["absender_anzeige"] = wer["name"]
    if wer["rolle"] == "mensch":
        nachricht["mensch_beleg"] = wer["grund"]
    if antwort_auf:
        nachricht["antwort_auf"] = antwort_auf
    if an:
        nachricht["an"] = sorted(set(an))
    anhaengen(name, nachricht, t)
    gruppe_schreiben(daten)
    if schluessel:
        zeiger_setzen(name, schluessel, nachricht["nr"])
    return daten, nachricht, rotieren(name, t)


def speichern_und_zustellen(name, wer, text, art, antwort_auf=None, an=()):
    pruefe_geheimnis(text, "Nachricht")
    with Sperre():
        daten, nachricht, geloescht = nachricht_anlegen(name, wer, text, art, antwort_auf, an)
    print("Nachricht %s (#%d) in %s gespeichert." % (nachricht["id"], nachricht["nr"], name))
    if geloescht:
        print("Rotation: %s geloescht (aelter als %d Tage)." % (", ".join(geloescht), AUFBEWAHRUNG_TAGE))
    ergebnisse = zustellen(daten, nachricht)
    for mitglied, was, _ in ergebnisse:
        print("  %s: %s" % (mitglied, was))
    return 0 if all(ok for _, _, ok in ergebnisse) else EXIT_ZUSTELLUNG


def cmd_schreib(argv):
