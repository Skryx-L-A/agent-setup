                    _ICH = {"name": name, "rolle": rolle, "pane": p["pane"], "pane_pid": p["pane_pid"],
                            "name_quelle": name_quelle,
                            "grund": "Pane %s in der Ahnenreihe; %s" % (p["pane"], rgrund)}
