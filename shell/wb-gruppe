_INTERPRETER = re.compile(r"^(python[0-9.]*|bash|sh|zsh|dash|ksh)$", re.IGNORECASE)


def ausgefuehrtes_programm(args):
    """Der Pfad des Programms, das diese Befehlszeile AUSFUEHRT, sonst None: argv[0],
    bei einem Interpreter (python3/bash/sh/...) das erste Nicht-Options-Argument, also der
    Skriptpfad. Ein Interpreter mit -c oder -m fuehrt Text bzw. ein Modul aus, kein Skript:
    ein Pfad im Befehlstext (`bash -c ': ~/.local/bin/wb-tafel; ...'`) zaehlt nicht.
    Auch `env [VAR=x] interpreter skript` wird aufgeloest."""
    teile = args.split()
    while teile and (os.path.basename(teile[0]) == "env" or "=" in teile[0].split("/")[0]):
        teile = teile[1:]
        while teile and (teile[0].startswith("-") or ("=" in teile[0] and "/" not in teile[0].split("=")[0])):
            teile = teile[1:]
    if not teile:
        return None
    programm = teile[0]
    if not _INTERPRETER.match(os.path.basename(programm)):
        return programm
    # Vor dem Skriptpfad nur harmlose Schalter ohne Wert. Alles andere (-c, -m, -o <x>,
    # --rcfile <datei>, ...) kann einen Text oder einen Wert vor den Pfad schieben, der dann
    # wie ein Skript aussaehe (`bash --rcfile .../wb-tafel -c '...'`): kein Programm, fail-closed.
    for token in teile[1:]:
        if token.startswith("-"):
            if re.fullmatch(r"-[xeuvBEsSIlfn]+", token):
                continue
            return None
        return token
    return None


def aus_tafel(tabelle):
    """Ist wb-tafel ein Ahne? Nur gewertet, wenn der Ahne wb-tafel AUSFUEHRT (siehe
    ausgefuehrtes_programm) und der realpath einer der erlaubten Orte ist: die Datei neben
    diesem Werkzeug oder ~/.local/bin/wb-tafel. Der Pfad nur als Wort in einer Befehlszeile
    genuegt nicht (gemessen: `bash -c ': .../wb-tafel; wb-gruppe meldung tafel ...'`)."""
    erlaubt = tafel_pfade()
    if not erlaubt:
        return False
    for pid in ahnen(tabelle)[1:]:
        programm = ausgefuehrtes_programm(tabelle.get(pid, (0, ""))[1])
        if programm and "/" in programm and os.path.realpath(programm) in erlaubt:
            return True
    return False


def mensch_beleg():
    """(ist_mensch, grund) aus ~/.local/bin/wb-mensch beleg, mit leerer Umgebung."""
    pfad = os.path.join(heim(), ".local", "bin", "wb-mensch")
    if not os.access(pfad, os.X_OK):
        return False, "wb-mensch am festen Pfad nicht gefunden — ohne Messung kein Mensch"
    umgebung = {"HOME": heim(), "TMPDIR": "/tmp", "PATH": PRUEF_PATH}
    if os.environ.get("WB_MENSCH_QUELLE") == "oberflaeche" and os.environ.get("WB_APP_PID", "").isdigit():
        umgebung["WB_MENSCH_QUELLE"] = "oberflaeche"
        umgebung["WB_APP_PID"] = os.environ["WB_APP_PID"]
    try:
        r = subprocess.run([pfad, "beleg"], env=umgebung, stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return False, "wb-mensch nicht ausfuehrbar"
    art, _, grund = r.stdout.strip().partition("\t")
    return art == "mensch", grund.strip()


_ICH = None


def ich(pflicht=True):
    """Der gemessene Aufrufer: {name, rolle, pane, pane_pid, grund}."""
    global _ICH
    if _ICH is None:
