                bester = None
                for p in panes():
                    if p["pane_pid"] in kette:
                        tiefe = kette.index(p["pane_pid"])
                        if bester is None or tiefe < bester[0]:
                            bester = (tiefe, p)
                if bester is None:
                    _ICH = {"name": None, "rolle": None,
                            "grund": "kein Pane in der eigenen Ahnenreihe und kein gemessener Mensch"}
                else:
