# ── Geheimnispruefung (Bestand des Hauses, nicht neu erfunden) ──────────────────

_SCANNER = None


def geheimnis_scanner():
    """Der Inhaltsscanner des Hauses: hooks/lib/geheimnis_inhalt.py (Provider-Muster plus
    Entropie fuer generische Zuweisungen), dieselbe Quelle wie der Guard bash-guard.py;
    nicht nachgebaut, sondern aus der Datei geladen. Repo-Fassung (hooks/lib neben shell/)
    zuerst, sonst die installierte unter ~/.claude/hooks/lib. Fehlt die Quelle oder traegt
    sie keine Muster: Abbruch, nie stilles Durchlassen."""
    global _SCANNER
    if _SCANNER is None:
        for kandidat in (os.path.join(HIER, "..", "hooks", "lib", "geheimnis_inhalt.py"),
                         os.path.join(heim(), ".claude", "hooks", "lib", "geheimnis_inhalt.py")):
            if not os.path.isfile(kandidat):
                continue
            try:
                spec = importlib.util.spec_from_file_location("wb_gruppe_geheimnis_inhalt", kandidat)
                modul = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(modul)
            except Exception:
                continue
            namensraum = {name: getattr(modul, name, None)
                          for name in ("PATTERNS", "GENERIC_ASSIGN", "shannon_entropy", "ENTROPY_THRESHOLD")}
            if namensraum["PATTERNS"] and namensraum["GENERIC_ASSIGN"] \
                    and callable(namensraum["shannon_entropy"]) and namensraum["ENTROPY_THRESHOLD"]:
                _SCANNER = namensraum
                break
        else:
            raise Abbruch(EXIT_FEHLER, "Geheimnispruefung nicht verfuegbar (hooks/lib/geheimnis_inhalt.py "
                          "fehlt oder traegt keine Muster). Ohne Pruefung wird nichts gespeichert.")
    return _SCANNER


def pruefe_geheimnis(text, was):
    scanner = geheimnis_scanner()
    for name, muster in scanner["PATTERNS"]:
        if muster.search(text):
            raise Abbruch(EXIT_GEHEIM, "%s abgelehnt: sieht nach einem Zugangsschluessel aus (Muster "
                          "'%s' der Hauspruefung geheimnis_inhalt). Nichts gespeichert. Geheimnisse "
                          "gehoeren nie in eine Gruppe." % (was, name))
    for treffer in scanner["GENERIC_ASSIGN"].finditer(text):
        if scanner["shannon_entropy"](treffer.group(2)) >= scanner["ENTROPY_THRESHOLD"]:
            raise Abbruch(EXIT_GEHEIM, "%s abgelehnt: generische Zuweisung '%s' mit hoher Entropie "
                          "(Hauspruefung geheimnis_inhalt). Nichts gespeichert." % (was, treffer.group(1)))


# ── tmux und Prozesse ───────────────────────────────────────────────────────────

def tmux(*args):
    befehl = ["tmux"] + (["-L", TMUX_SOCKET] if TMUX_SOCKET else []) + list(args)
    try:
        r = subprocess.run(befehl, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def prozesstabelle():
    """{pid: (ppid, args)} aus einem einzigen ps-Aufruf."""
    try:
        r = subprocess.run(["ps", "-A", "-o", "pid=", "-o", "ppid=", "-o", "args="],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return {}
    tabelle = {}
    for zeile in r.stdout.splitlines():
        teile = zeile.strip().split(None, 2)
        if len(teile) >= 2 and teile[0].isdigit() and teile[1].isdigit():
            tabelle[int(teile[0])] = (int(teile[1]), teile[2] if len(teile) > 2 else "")
    return tabelle


def ahnen(tabelle, pid=None):
    """Liste der PIDs von `pid` (Vorgabe: dieser Prozess) bis zur Wurzel, ohne 0/1."""
    pid = pid or os.getpid()
    kette = []
    for _ in range(64):
        if pid in (0, 1) or pid in kette:
            break
        kette.append(pid)
        eintrag = tabelle.get(pid)
        if not eintrag:
            break
        pid = eintrag[0]
    return kette


def lebt(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


PANE_FORMAT = "#{pane_id}\t#{pane_pid}\t#{@wb_worker}\t#{@wb_role}\t#{session_name}\t#{session_group}"


def sitzungsname(roh):
    return re.sub(r"[^A-Za-z0-9._-]", "-", roh)[:64].strip("-._")


def pane_aus_zeile(zeile):
    teile = zeile.split("\t")
    if len(teile) < 5 or not teile[1].isdigit():
        return None
    return {"pane": teile[0], "pane_pid": int(teile[1]), "worker": teile[2].strip(),
            "option": teile[3].strip(), "sitzung": teile[4].strip(),
            "gruppe": teile[5].strip() if len(teile) > 5 else ""}


def panes():
    """Ein Eintrag je Pane. Ein Pane in gruppierten tmux-Sitzungen steht je Sitzung einmal in der
    Liste: `sitzung` bleibt die erste, `sitzungen` und `gruppe` tragen alle Namen (unabhaengig von
    der Reihenfolge)."""
    aus = tmux("list-panes", "-a", "-F", PANE_FORMAT)
    ergebnis, nach_pane = [], {}
    for zeile in (aus or "").splitlines():
        p = pane_aus_zeile(zeile)
        if p is None:
            continue
        if p["pane"] in nach_pane:
            alt = nach_pane[p["pane"]]
            if p["sitzung"] not in alt["sitzungen"]:
                alt["sitzungen"].append(p["sitzung"])
            alt["gruppe"] = alt["gruppe"] or p["gruppe"]
            continue
        p["sitzungen"] = [p["sitzung"]]
        nach_pane[p["pane"]] = p
        ergebnis.append(p)
    return ergebnis


def claude_register():
    eintraege = []
    for f in glob.glob(os.path.join(heim(), ".claude", "sessions", "*.json")):
        try:
            with open(f, encoding="utf-8") as s:
                d = json.load(s)
        except (OSError, ValueError):
            continue
        if isinstance(d, dict) and isinstance(d.get("pid"), int) and lebt(d["pid"]):
            eintraege.append(d)
    return eintraege


def pane_name_quelle(p, tabelle, register):
    """(Name, Quelle) eines Panes. Quelle: 'worker' (@wb_worker), 'register' (Claude-Register), beide
    ausdruecklich vergeben; 'sitzung' (tmux-Sitzungsname) ist nur der Ersatz, wenn nichts vergeben wurde."""
    if p["worker"] and SITZUNG_RE.match(p["worker"]):
        return p["worker"], "worker"
    for d in register:
        adresse = str(d.get("tmux") or "")
        name = str(d.get("name") or "")
        if adresse.endswith("." + p["pane"]) and SITZUNG_RE.match(name) \
                and p["pane_pid"] in ahnen(tabelle, d["pid"]):
            return name, "register"
    return (sitzungsname(p["sitzung"]) or None), "sitzung"


def pane_name(p, tabelle, register):
    """Der Sitzungsname eines Panes: @wb_worker, sonst Claude-Register, sonst tmux-Sitzung."""
    return pane_name_quelle(p, tabelle, register)[0]


def pane_aliasse(p):
    """Weitere Namen, unter denen ein Mitglied in seinem Pane wiederzufinden ist: jede tmux-Sitzung
    des Panes und deren Gruppe. Nur fuer Zustellziele, nie fuer die Identitaet eines Absenders."""
    namen = set()
    for roh in list(p.get("sitzungen") or [p["sitzung"]]) + [p.get("gruppe", "")]:
        n = sitzungsname(roh)
        if n and SITZUNG_RE.match(n):
            namen.add(n)
    return namen


# ── Rollen (hooks/lib/rollen.py, dieselbe Datei wie die Hook-Kette) ───────────────

_ROLLEN = None


def rollen_modul():
    global _ROLLEN
    if _ROLLEN is None:
        import importlib.util
        _ROLLEN = False
        for kandidat in (os.path.join(HIER, "..", "hooks", "lib", "rollen.py"),
                         os.path.join(heim(), ".claude", "hooks", "lib", "rollen.py")):
            if os.path.isfile(kandidat):
                spec = importlib.util.spec_from_file_location("wb_gruppe_rollen", kandidat)
                modul = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(modul)
                modul.tmux_server_waehlen(["-L", TMUX_SOCKET] if TMUX_SOCKET else [])
                _ROLLEN = modul
                break
    return _ROLLEN or None


def ist_orchestrator_pane(pane):
    """Streng: keine Quelle sagt worker, mindestens eine sagt orchestrator."""
    modul = rollen_modul()
    if modul is None:
        return False, "rollen.py nicht gefunden — ohne Register kein Orchestrator"
    fakten = modul.pane_fakten(pane)
    if not fakten:
        return False, "Pane nicht messbar"
    eintrag = modul.eintrag(pane, fakten) or {}
    option, register = fakten.get("rolle", ""), eintrag.get("rolle", "")
    if "worker" in (option, register):
        return False, "Rolle worker (%s)" % ("Register" if register == "worker" else "@wb_role")
    if "orchestrator" in (option, register):
        return True, "Rolle orchestrator (%s)" % ("Register" if register == "orchestrator" else "@wb_role")
    return False, "Rolle %s" % (register or option or "unbestimmt")


