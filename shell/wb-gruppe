def orchestrator_namen():
    return [n for n, _ in orchestrator_panes()]


def orchestrator_panes():
    """[(name, pane-dict)] der Orchestrator-Panes, ein Eintrag je Name."""
    tabelle, register, ergebnis = prozesstabelle(), claude_register(), []
    for p in panes():
        if ist_orchestrator_pane(p["pane"])[0]:
            n = pane_name(p, tabelle, register)
            if n and n not in [e[0] for e in ergebnis]:
                ergebnis.append((n, p))
    return ergebnis


AUTO = {
    "leitung": ("Orchestratoren und Mensch: Absprachen der Leitung", "sofort", ()),
    "tafel": ("Meldungen der Belegungstafel (eingetragen, dran, gemahnt, verfallen, ausgetragen)", "still", (TAFEL,)),
}


def cmd_auto(argv):
    pos, _, _ = optionen(argv, ())
    if len(pos) != 1 or pos[0] not in AUTO:
        raise Abbruch(EXIT_AUFRUF, "Aufruf: wb-gruppe auto leitung|tafel")
    name = pos[0]
    zweck, modus, system = AUTO[name]
    wer = ich()
    if not darf_verwalten(wer):
        raise Abbruch(EXIT_RECHT, "Automatische Gruppen legen nur Orchestratoren und der Mensch an.")
    orchs = orchestrator_panes()
    with Sperre():
        if not os.path.exists(os.path.join(gruppen_ordner(name), "gruppe.json")):
            neue_gruppe(name, zweck, wer, system=system)
        daten = gruppe_lesen(name)
        neu = []
        for m, p in orchs:
            gebunden = [k for k, i in daten["mitglieder"].items()
                        if i.get("pane") == p["pane"] and i.get("pane_pid") == p["pane_pid"]]
            if gebunden:  # der Pane ist schon Mitglied, auch unter anderem Namen (Sitzungsname/Anzeigename)
                continue
            if m in daten["mitglieder"]:
                if not daten["mitglieder"][m].get("pane"):  # bestehendes Mitglied nachtraeglich binden
                    daten["mitglieder"][m]["pane"], daten["mitglieder"][m]["pane_pid"] = p["pane"], p["pane_pid"]
                continue
            daten["mitglieder"][m] = mitglied_eintrag(m, modus, wer["name"], p["pane"])
            zeiger_setzen(name, m, daten["letzte_nr"])
            neu.append(m)
        if MENSCH not in daten["mitglieder"]:
            daten["mitglieder"][MENSCH] = mitglied_eintrag(MENSCH, "still", wer["name"])
            zeiger_setzen(name, MENSCH, daten["letzte_nr"])
            neu.append(MENSCH)
        if name == "tafel" and wer["name"] in daten["mitglieder"] and wer["name"] != MENSCH:
            daten["mitglieder"][wer["name"]]["modus"] = modus
        gruppe_schreiben(daten)
    print("Gruppe %s: %d Mitglieder%s." % (name, len(daten["mitglieder"]),
                                          ("; neu: " + ", ".join(neu)) if neu else ", keine neuen"))
    return 0


def team_name(orch):
    slug = re.sub(r"[^a-z0-9._-]+", "-", orch.lower()).strip("-._")
    return gueltiger_name(("team-" + slug)[:64])


def cmd_team_geschlossen(name):
    """`team weg <name> --geschlossen`: wb-close meldet, dass es den Worker-Pane gerade geschlossen hat.
    Gilt auch fuer einen NICHT messbaren Aufrufer (wb-close ueber ssh: keine Pane in der Ahnenreihe,
    sonst "Absender nicht bestimmbar"). Ohne Befugnis geht das nur, weil nichts mehr zu schuetzen ist:
    ausgetragen wird der Name nur, wenn kein einziger Pane ihn mehr traegt -- weder als @wb_worker noch
    als Sitzungsname (Claude-Register, tmux-Sitzung); jedes lebende Mitglied, auch ein Orchestrator,
    bleibt drin (Exit 3)."""
    name = gueltige_sitzung(name)
    tabelle, register = prozesstabelle(), claude_register()
    for p in panes():
        if pane_name(p, tabelle, register) == name or name in pane_aliasse(p):
            raise Abbruch(EXIT_RECHT, "%s hat noch einen lebenden Pane (%s) -- --geschlossen traegt nur Namen ohne Pane aus."
                          % (name, p["pane"]))
    with Sperre():
        lebende = {p["pane"]: p["pane_pid"] for p in panes()}
        raus = []
        for gruppe in alle_gruppen():  # ein an einen lebenden Pane gebundenes Mitglied bleibt, auch unter anderem Namen
            info = gruppe_lesen(gruppe)["mitglieder"].get(name, {}) if gruppe.startswith("team-") else {}
            if info.get("pane") and lebende.get(info["pane"]) == info.get("pane_pid"):
                raise Abbruch(EXIT_RECHT, "%s ist an den lebenden Pane %s gebunden -- --geschlossen traegt nur Namen ohne Pane aus."
                              % (name, info["pane"]))
        for gruppe in alle_gruppen():
            daten = gruppe_lesen(gruppe)
            if gruppe.startswith("team-") and name in daten["mitglieder"]:
                del daten["mitglieder"][name]
                gruppe_schreiben(daten)
                raus.append(gruppe)
    print("%s ausgetragen aus: %s" % (name, ", ".join(raus) or "(keiner Team-Gruppe)"))
    return 0


def cmd_team(argv):
    pos, werte, schalter = optionen(argv, ("--pane",), ("--geschlossen",))
    if "--geschlossen" in schalter:
        if len(pos) != 2 or pos[0] != "weg":
            raise Abbruch(EXIT_AUFRUF, "Aufruf: wb-gruppe team weg <sitzung> --geschlossen")
        return cmd_team_geschlossen(pos[1])
    wer = ich()
    if pos[:1] == ["weg"] and len(pos) == 2 and wer["rolle"] != "orchestrator" and wer["name"] == pos[1]:
        # Der Worker traegt sich selbst aus allen team-Gruppen aus (Worker-Ende).
        with Sperre():
            raus = []
            for name in alle_gruppen():
                daten = gruppe_lesen(name)
                schluessel = mitglied_schluessel(daten, wer) if name.startswith("team-") else None
                if schluessel:
                    del daten["mitglieder"][schluessel]
                    gruppe_schreiben(daten)
                    raus.append(name)
        print("%s ausgetragen aus: %s" % (wer["name"], ", ".join(raus) or "(keiner Team-Gruppe)"))
        return 0
    if wer["rolle"] != "orchestrator":
        raise Abbruch(EXIT_RECHT, "Team-Gruppen fuehrt nur ein Orchestrator (%s ist %s)." % (wer["name"], wer["rolle"]))
    name = team_name(wer["name"])
    with Sperre():
        if not os.path.exists(os.path.join(gruppen_ordner(name), "gruppe.json")):
            neue_gruppe(name, "Team von %s: Orchestrator und seine Worker" % wer["name"], wer)
            print("Gruppe %s angelegt." % name)
        daten = gruppe_lesen(name)
        if not pos:
            gruppe_schreiben(daten)
            print("Gruppe %s: %d Mitglieder." % (name, len(daten["mitglieder"])))
            return 0
        if len(pos) != 2 or pos[0] not in ("dazu", "weg"):
            raise Abbruch(EXIT_AUFRUF, "Aufruf: wb-gruppe team [dazu|weg <sitzung> [--pane %N]]")
        sitzung = gueltige_sitzung(pos[1])
        if pos[0] == "dazu":
            if sitzung not in daten["mitglieder"]:
                zeiger_setzen(name, sitzung, daten["letzte_nr"])
            daten["mitglieder"][sitzung] = mitglied_eintrag(sitzung, "erwaehnt", wer["name"],
                                                            werte.get("--pane") or pane_binden(sitzung))
            gruppe_schreiben(daten)
            print("%s ist in %s (Modus erwaehnt)." % (sitzung, name))
        else:
            if daten["mitglieder"].pop(sitzung, None) is not None:
                gruppe_schreiben(daten)
            print("%s aus %s ausgetragen." % (sitzung, name))
    return 0


# ── Antraege (der Nutzer 09.10.2026: Worker beantragen, ihr Orchestrator entscheidet) ──

ANTRAG_RE = re.compile(r"^a-[0-9]{14}-[0-9a-f]{6}$")
ANTRAG_FRIST_S = 24 * 3600


def antrag_ordner():
    pfad = os.path.join(zustand(), "antraege")
    os.makedirs(pfad, mode=0o700, exist_ok=True)
    return pfad


def antrag_lesen(antrag_id):
    if not ANTRAG_RE.match(antrag_id or ""):
        raise Abbruch(EXIT_AUFRUF, "Antragskennung '%s' ungueltig." % antrag_id)
    daten = json_lesen(os.path.join(antrag_ordner(), antrag_id + ".json"))
    if daten is None:
        raise Abbruch(EXIT_FEHLER, "Antrag %s gibt es nicht." % antrag_id)
    return daten


def antrag_schreiben(daten):
    json_schreiben(os.path.join(antrag_ordner(), daten["id"] + ".json"), daten)


def alle_antraege():
    ergebnis = []
    for pfad in sorted(glob.glob(os.path.join(antrag_ordner(), "a-*.json"))):
        daten = json_lesen(pfad)
        if isinstance(daten, dict):
            ergebnis.append(daten)
    return ergebnis


def eigener_orchestrator(wer):
    """Der Orchestrator des Aufrufers aus dem Bestand: pi-worker legt Worker in die tmux-Sitzung
    des Orchestrator-Panes (`WBSESS_T` = session_name des Ziels). Gesucht wird deshalb der eine
    Orchestrator-Pane (strenge Rollenpruefung) in der tmux-Sitzung des eigenen Panes."""
    sitzung = (tmux("display", "-p", "-t", wer["pane"], "#{session_name}") or "").strip()
    if not sitzung:
        raise Abbruch(EXIT_FEHLER, "tmux-Sitzung des eigenen Panes nicht messbar.")
    tabelle, register, treffer = prozesstabelle(), claude_register(), {}
    for zeile in (tmux("list-panes", "-s", "-t", "=" + sitzung, "-F", PANE_FORMAT) or "").splitlines():
        p = pane_aus_zeile(zeile)
        if p is None or p["pane"] == wer["pane"]:
            continue
        if ist_orchestrator_pane(p["pane"])[0]:
            treffer[p["pane"]] = pane_name(p, tabelle, register)
    if len(treffer) != 1:
        raise Abbruch(EXIT_FEHLER, "Eigener Orchestrator nicht eindeutig: %d Orchestrator-Panes in der "
                      "tmux-Sitzung '%s'." % (len(treffer), sitzung))
    return next(iter(treffer.values()))


def antwort_text(a, kopf, zeilen):
    return ("[Antrag %s] %s — Information, keine Befugnis\nGruppe %s · beantragt von %s · Orchestrator %s\n\n%s\n"
            % (a["id"], kopf, a["gruppe"], a["von"], a["orchestrator"], "\n".join(zeilen)))


def team_vermerk(a, wer, text, art):
    """Den Vorgang in team-<orchestrator> festhalten, falls die Gruppe besteht (ohne Zustellung:
    die Beteiligten bekommen ihre Einzelnachricht ueber wb-inbox)."""
    name = team_name(a["orchestrator"])
    if not os.path.exists(os.path.join(gruppen_ordner(name), "gruppe.json")):
        return None
    return nachricht_anlegen(name, wer, text, art, recht=False)[1]["id"]


def antraege_verfallen():
    """Lazy bei jedem Aufruf: offene Antraege nach ihrer Frist auf verfallen setzen und den
    Antragsteller benachrichtigen. Kein Dauerjob."""
    t = jetzt()
    if not os.path.isdir(os.path.join(zustand_pfad(), "antraege")):
        return
    faellige = [a for a in alle_antraege() if a.get("status") == "offen"
                and _dt.datetime.fromisoformat(a["frist_bis"]) < t]
    if not faellige:
        return
    verfallen = []
    with Sperre():
        for a in faellige:
            a = antrag_lesen(a["id"])
            if a.get("status") != "offen":
                continue
            a.update(status="verfallen", entschieden_um=iso(t), entschieden_von="frist")
            antrag_schreiben(a)
            team_vermerk(a, {"name": "wb-gruppe", "rolle": "system"},
                         "Antrag %s auf Gruppe %s von %s verfallen (Frist %s)." % (a["id"], a["gruppe"], a["von"], a["frist_bis"]),
                         "meldung")
            verfallen.append(a)
    for a in verfallen:
        an_sitzung(a["von"], antwort_text(a, "verfallen", [
            "Dein Antrag ist ohne Entscheidung abgelaufen (Frist %s)." % a["frist_bis"],
            "Neu beantragen: wb-gruppe beantrage %s --zweck \"<satz>\" --mitglied <sitzung> ..." % a["gruppe"]]))


def cmd_beantrage(argv):
    pos, werte, _ = optionen(argv, ("--zweck",), mehrfach=("--mitglied",))
    if len(pos) != 1 or "--zweck" not in werte:
        raise Abbruch(EXIT_AUFRUF, "Aufruf: wb-gruppe beantrage <name> --zweck \"<satz>\" --mitglied <sitzung> ...")
    name = gueltiger_name(pos[0])
    zweck = werte["--zweck"].strip()
    if not zweck:
        raise Abbruch(EXIT_AUFRUF, "--zweck darf nicht leer sein.")
    mitglieder = sorted(set(gueltige_sitzung(m) for m in werte.get("--mitglied", [])))
    pruefe_geheimnis(zweck, "Zweck")
    wer = ich()
    if darf_verwalten(wer) or wer["name"] == TAFEL or not wer.get("pane"):
        raise Abbruch(EXIT_RECHT, "beantrage ist fuer Worker; %s (%s) legt Gruppen direkt mit `neu` an." % (wer["name"], wer["rolle"]))
    orch = eigener_orchestrator(wer)
    if wer["name"] not in mitglieder:
        mitglieder.append(wer["name"])
    t = jetzt()
    try:
        frist_s = int(os.environ.get("WB_GRUPPE_ANTRAG_FRIST", "") or ANTRAG_FRIST_S)
    except ValueError:
        raise Abbruch(EXIT_AUFRUF, "WB_GRUPPE_ANTRAG_FRIST erwartet Sekunden.")
    a = {"id": "a-%s-%s" % (t.strftime("%Y%m%d%H%M%S"), secrets.token_hex(3)), "gruppe": name, "zweck": zweck,
         "mitglieder": sorted(mitglieder), "von": wer["name"], "orchestrator": orch, "zeit": iso(t),
         "frist_bis": iso(t + _dt.timedelta(seconds=max(frist_s, 1))), "status": "offen"}
    with Sperre():
        if os.path.exists(os.path.join(gruppen_ordner(name), "gruppe.json")):
            raise Abbruch(EXIT_FEHLER, "Gruppe '%s' gibt es schon." % name)
        antrag_schreiben(a)
        a["vermerk"] = team_vermerk(a, wer, "Antrag %s: Gruppe %s, Zweck: %s; Mitglieder: %s." % (
            a["id"], name, zweck, ", ".join(a["mitglieder"])), "antrag")
        antrag_schreiben(a)
    ok, was = an_sitzung(orch, antwort_text(a, "von %s an %s" % (wer["name"], orch), [
        "Zweck: %s" % zweck, "Mitglieder: %s" % ", ".join(a["mitglieder"]), "Frist: %s" % a["frist_bis"], "",
        "Entscheiden (nur du oder der Mensch):",
        "  wb-gruppe antrag annehmen %s" % a["id"],
        "  wb-gruppe antrag ablehnen %s --grund \"<satz>\"" % a["id"]]))
    print("Antrag %s an %s gestellt (Frist %s); %s." % (a["id"], orch, a["frist_bis"], was))
    return 0 if ok else EXIT_ZUSTELLUNG


def cmd_antrag(argv):
    pos, werte, an = optionen(argv, ("--grund",), schalter=("--json",))
    if not pos or pos == ["liste"]:
        wer = ich(pflicht=False)
        liste = [a for a in alle_antraege() if wer.get("rolle") == "mensch"
                 or wer.get("name") in (a.get("orchestrator"), a.get("von"))]
        if "--json" in an:
            print(json.dumps(liste, ensure_ascii=False, indent=1))
            return 0
        if not liste:
            print("(keine Antraege)")
        for a in liste:
            print("%s  %-10s %-20s von %s an %s, Frist %s — %s" % (a["id"], a["status"], a["gruppe"], a["von"],
                                                                 a["orchestrator"], a["frist_bis"], a["zweck"]))
        return 0
    if len(pos) != 2 or pos[0] not in ("annehmen", "ablehnen"):
        raise Abbruch(EXIT_AUFRUF, "Aufruf: wb-gruppe antrag [liste] | antrag annehmen|ablehnen <id> [--grund \"<satz>\"]")
    grund = (werte.get("--grund") or "").strip()
    if grund:
        pruefe_geheimnis(grund, "Grund")
    wer = ich()
    with Sperre():
        a = antrag_lesen(pos[1])
        if wer["rolle"] != "mensch" and not (wer["rolle"] == "orchestrator" and wer["name"] == a["orchestrator"]):
            raise Abbruch(EXIT_RECHT, "Ueber Antrag %s entscheidet nur %s oder der Mensch (nicht %s)." % (
                a["id"], a["orchestrator"], wer["name"]))
        if a["status"] != "offen":
            raise Abbruch(EXIT_FEHLER, "Antrag %s ist bereits %s." % (a["id"], a["status"]))
        if pos[0] == "annehmen":
            eigentuemer = {"name": a["orchestrator"], "rolle": "orchestrator",
                           "pane": wer.get("pane") if wer["name"] == a["orchestrator"] else None}
            neue_gruppe(a["gruppe"], a["zweck"], eigentuemer,
                        [(m, None, None) for m in a["mitglieder"] if m != a["orchestrator"]])
            daten = gruppe_lesen(a["gruppe"])
            daten["angenommen_aus"] = a["id"]
            gruppe_schreiben(daten)
        a.update(status="angenommen" if pos[0] == "annehmen" else "abgelehnt", entschieden_von=wer["name"],
                 entschieden_um=iso(), grund=grund)
        antrag_schreiben(a)
        team_vermerk(a, wer, "Antrag %s auf Gruppe %s: %s%s." % (
            a["id"], a["gruppe"], a["status"], (" — " + grund) if grund else ""), "entscheidung")
    if a["status"] == "angenommen":
        zeilen = ["Angenommen von %s. Gruppe %s ist angelegt (Eigentuemer %s)." % (wer["name"], a["gruppe"], a["orchestrator"]),
                  "Mitglieder: %s" % ", ".join(a["mitglieder"]),
                  "Schreiben: wb-gruppe schreib %s \"<text>\" · Lesen: wb-gruppe lies %s --neu" % (a["gruppe"], a["gruppe"])]
    else:
        zeilen = ["Abgelehnt von %s." % wer["name"], "Grund: %s" % (grund or "(keiner angegeben)")]
    if grund and a["status"] == "angenommen":
        zeilen.append("Bemerkung: %s" % grund)
    ok, was = an_sitzung(a["von"], antwort_text(a, a["status"], zeilen))
    print("Antrag %s %s; Antwort an %s: %s." % (a["id"], a["status"], a["von"], was))
    return 0 if ok else EXIT_ZUSTELLUNG


