class Sperre:
    def __enter__(self):
        pfad = os.path.join(zustand(), ".sperre")
        self.datei = open(pfad, "a+")
        frist = time.monotonic() + SPERRFRIST_S
        while True:
            try:
                fcntl.flock(self.datei.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() > frist:
                    self.datei.close()
                    raise Abbruch(EXIT_SPERRE, "Sperre %s nicht innerhalb von %.0f s bekommen." % (pfad, SPERRFRIST_S))
                time.sleep(0.02)

    def __exit__(self, *_):
        fcntl.flock(self.datei.fileno(), fcntl.LOCK_UN)
        self.datei.close()


