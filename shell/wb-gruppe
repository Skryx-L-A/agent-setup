def mitglied_schluessel(daten, wer):
    """Unter welchem Schluessel ist der gemessene Aufrufer Mitglied dieser Gruppe? None: keiner.
    Mitgliedschaft und Schreibrecht haengen am PANE, nicht am Anzeigenamen (der Name, den eine Sitzung
    sich gibt, kann vom Mitgliedsnamen abweichen: 'another service' im Pane des Mitglieds
    'wb-a project-...'). Reihenfolge:
      1. ein Mitglied ist an diesen Pane gebunden (gleiche Pane-Nummer und pane_pid);
      2. der Anzeigename (@wb_worker oder Register, nicht der Sitzungsname als Ersatz) ist ein Mitglied,
         das nicht an einen ANDEREN lebenden Pane gebunden ist;
      3. ein Mitglied, dessen Zustellziel (zielpanes, also Name, Sitzung, Orchestrator-Vorrang) dieser
         Pane ist und das nicht an einen anderen lebenden Pane gebunden ist.
    Der Mensch ist Mitglied 'mensch', wenn eingetragen; der Systemabsender tafel hat keinen Schluessel."""
    mitglieder = daten.get("mitglieder", {})
    if wer["rolle"] == "mensch":
        return MENSCH if MENSCH in mitglieder else None
    pane, pane_pid = wer.get("pane"), wer.get("pane_pid")
    if not pane or wer["name"] == TAFEL:
        return wer["name"] if wer.get("name") in mitglieder and wer["name"] not in (MENSCH, TAFEL) else None
    for k in sorted(mitglieder):
        if k in (MENSCH, TAFEL):
            continue
        if mitglieder[k].get("pane") == pane and mitglieder[k].get("pane_pid") == pane_pid:
            return k
    lebende = {p["pane"]: p["pane_pid"] for p in panes()}

    def anderswo_gebunden(k):
        i = mitglieder[k]
        return bool(i.get("pane")) and i["pane"] != pane and lebende.get(i["pane"]) == i.get("pane_pid")

    # Ein ausdruecklich vergebener Name (@wb_worker, Register) gilt; der Sitzungsname nur als Ersatz
    # entscheidet erst Regel 3 (ein Worker im Fenster des Orchestrators heisst sonst genauso).
    if wer["name"] in mitglieder and wer["name"] not in (MENSCH, TAFEL) and not anderswo_gebunden(wer["name"]) \
            and wer.get("name_quelle") != "sitzung":
        return wer["name"]
    frei = [k for k in sorted(mitglieder) if k not in (MENSCH, TAFEL) and not anderswo_gebunden(k)]
    if frei:
        ziele = zielpanes(frei, daten)
        for k in frei:
            if ziele.get(k) == pane:
                return k
    return None


