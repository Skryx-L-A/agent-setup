def optionen(argv, mit_wert, schalter=(), mehrfach=()):
    """Einfache Zerlegung: Positionsargumente, {option: wert}, Schalter."""
    pos, werte, an = [], {}, set()
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in mit_wert or a in mehrfach:
            if i + 1 >= len(argv):
                raise Abbruch(EXIT_AUFRUF, "nach %s fehlt der Wert." % a)
            if a in mehrfach:
                werte.setdefault(a, []).append(argv[i + 1])
            else:
                werte[a] = argv[i + 1]
            i += 2
        elif a in schalter:
            an.add(a)
            i += 1
        elif a.startswith("--") and len(a) > 2:
            raise Abbruch(EXIT_AUFRUF, "Option %s unbekannt." % a)
        else:
            pos.append(a)
            i += 1
    return pos, werte, an


def text_holen(pos, werte, rest_ab):
    if "--datei" in werte:
        if len(pos) > rest_ab:
            raise Abbruch(EXIT_AUFRUF, "Text entweder als Argument oder mit --datei, nicht beides.")
        try:
            with open(werte["--datei"], encoding="utf-8") as s:
                text = s.read()
        except OSError as e:
            raise Abbruch(EXIT_FEHLER, "Datei nicht lesbar: %s" % e)
    else:
        text = " ".join(pos[rest_ab:])
    text = text.replace("\r\n", "\n").strip("\n")
    if not text.strip():
        raise Abbruch(EXIT_AUFRUF, "Nachrichtentext fehlt.")
    if "\x00" in text:
        raise Abbruch(EXIT_AUFRUF, "Nachrichtentext enthaelt ein Nullzeichen.")
    if len(text.encode("utf-8")) > TEXT_LIMIT:
        raise Abbruch(EXIT_AUFRUF, "Nachrichtentext ist groesser als %d Bytes." % TEXT_LIMIT)
    return text


def neue_gruppe(name, zweck, wer, mitglieder=(), system=()):
    if os.path.exists(os.path.join(gruppen_ordner(name), "gruppe.json")):
        raise Abbruch(EXIT_FEHLER, "Gruppe '%s' gibt es schon." % name)
    daten = {"schema": 1, "name": name, "zweck": zweck, "angelegt_von": wer["name"], "angelegt_um": iso(),
             "letzte_nr": 0, "mitglieder": {}, "systemabsender": list(system)}
    daten["mitglieder"][wer["name"]] = mitglied_eintrag(
        wer["name"], "still" if wer["name"] == MENSCH else "sofort", wer["name"], wer.get("pane"))
    for m, modus, pane in mitglieder:
        daten["mitglieder"][m] = mitglied_eintrag(m, modus or vorgabe_modus(m), wer["name"], pane)
    gruppe_schreiben(daten)
    for m in daten["mitglieder"]:
        zeiger_setzen(name, m, 0)
    return daten


def cmd_neu(argv):
    pos, werte, _ = optionen(argv, ("--zweck",), mehrfach=("--mitglied",))
    if len(pos) != 1 or "--zweck" not in werte:
        raise Abbruch(EXIT_AUFRUF, "Aufruf: wb-gruppe neu <name> --zweck \"<satz>\" [--mitglied <sitzung>[:modus]] ...")
    name = gueltiger_name(pos[0])
    zweck = werte["--zweck"].strip()
    if not zweck:
        raise Abbruch(EXIT_AUFRUF, "--zweck darf nicht leer sein.")
    pruefe_geheimnis(zweck, "Zweck")
    wer = ich()
    if not darf_verwalten(wer):
        raise Abbruch(EXIT_RECHT, "Gruppen legen nur Orchestratoren und der Mensch an (%s ist %s)." % (wer["name"], wer["rolle"]))
    mitglieder = []
    for angabe in werte.get("--mitglied", []):
        m, _, modus = angabe.partition(":")
        if modus and modus not in MODI:
            raise Abbruch(EXIT_AUFRUF, "Modus '%s' unbekannt (%s)." % (modus, "|".join(MODI)))
        mitglieder.append((gueltige_sitzung(m), modus or None, None))
    with Sperre():
        daten = neue_gruppe(name, zweck, wer, mitglieder)
    print("Gruppe %s angelegt von %s; Mitglieder: %s" % (name, wer["name"], ", ".join(
        "%s (%s)" % (m, i["modus"]) for m, i in sorted(daten["mitglieder"].items()))))
    return 0


def cmd_dazu(argv):
