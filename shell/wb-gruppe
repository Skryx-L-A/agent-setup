def nachrichten(name):
    ergebnis = []
    for pfad in verlauf_dateien(name):
        with open(pfad, encoding="utf-8") as s:
            zeilen = s.read().split("\n")
        for i, zeile in enumerate(zeilen):
            if not zeile.strip():
                continue
            try:
                ergebnis.append(json.loads(zeile))
            except ValueError:
                if i == len(zeilen) - 1:
                    continue  # unfertige letzte Zeile eines abgebrochenen Schreibers
                raise Abbruch(EXIT_FEHLER, "Verlauf unlesbar: %s Zeile %d" % (pfad, i + 1))
    ergebnis.sort(key=lambda m: m.get("nr", 0))
    return ergebnis


def rotieren(name, t):
    """Monate loeschen, deren letzter Tag mehr als AUFBEWAHRUNG_TAGE zurueckliegt."""
    grenze = (t - _dt.timedelta(days=AUFBEWAHRUNG_TAGE)).date()
    geloescht = []
    for pfad in verlauf_dateien(name):
        jahr, monat = (int(x) for x in os.path.basename(pfad)[:7].split("-"))
        naechster = _dt.date(jahr + (monat == 12), monat % 12 + 1, 1)
        if naechster - _dt.timedelta(days=1) < grenze:
            os.unlink(pfad)
            geloescht.append(os.path.basename(pfad))
    return geloescht


def ende_reparieren(pfad):
    """Ein unfertiges letztes Stueck (Absturz mitten im Schreiben) entfernen; ist es
    vollstaendiges JSON ohne Zeilenende, nur das Zeilenende ergaenzen. Unter der Sperre."""
    try:
        with open(pfad, "rb") as s:
            s.seek(0, os.SEEK_END)
            if s.tell() == 0:
                return None
            s.seek(-1, os.SEEK_END)
            if s.read(1) == b"\n":
                return None
            s.seek(0)
            roh = s.read()
    except FileNotFoundError:
        return None
    schnitt = roh.rfind(b"\n") + 1
    try:
        json.loads(roh[schnitt:].decode("utf-8"))
        with open(pfad, "ab") as s:
            s.write(b"\n")
            s.flush()
            os.fsync(s.fileno())
        return "Zeilenende ergaenzt"
    except (UnicodeDecodeError, ValueError):
        os.truncate(pfad, schnitt)
        return "unfertiges Ende (%d Bytes) entfernt" % (len(roh) - schnitt)


def anhaengen(name, nachricht, t):
    pfad = os.path.join(gruppen_ordner(name), "verlauf", t.strftime("%Y-%m") + ".jsonl")
    os.makedirs(os.path.dirname(pfad), mode=0o700, exist_ok=True)
    for vorher in verlauf_dateien(name):
        ende_reparieren(vorher)
    fd = os.open(pfad, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as s:
        s.write(json.dumps(nachricht, ensure_ascii=False, sort_keys=True) + "\n")
        s.flush()
        os.fsync(s.fileno())


