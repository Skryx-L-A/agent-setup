def main(argv):
    global TMUX_SOCKET
    while argv and argv[0] in ("-L", "--socket"):
        if len(argv) < 2:
            sys.stderr.write("wb-gruppe: nach %s fehlt der Wert.\n" % argv[0])
            return EXIT_AUFRUF
        TMUX_SOCKET = argv[1]
        argv = argv[2:]
    if argv and argv[0] in ("-h", "--help", "--hilfe", "hilfe"):
        sys.stdout.write(__doc__)
        return 0
    if not argv or argv[0] == "--json":
        argv = ["meine"] + argv
    befehl = BEFEHLE.get(argv[0])
    if befehl is None:
        sys.stderr.write("wb-gruppe: Befehl '%s' unbekannt (wb-gruppe --hilfe).\n" % argv[0])
        return EXIT_AUFRUF
    try:
        try:
            antraege_verfallen()
        except Abbruch as a:
            sys.stderr.write("wb-gruppe: Antragsverfall diesmal uebersprungen: %s\n" % a.text)
        code = befehl(argv[1:])
        if argv[0] != "wer" and not os.environ.get("WB_GRUPPE_NICHT_NACHLIEFERN"):
            try:
                for zeile in nachliefern():
                    sys.stderr.write("wb-gruppe: %s\n" % zeile)
            except (Abbruch, OSError, ValueError, KeyError) as e:
                sys.stderr.write("wb-gruppe: Nachlieferung diesmal uebersprungen: %s\n" % e)
        return code
    except Abbruch as a:
        sys.stderr.write("wb-gruppe: %s\n" % a.text)
        return a.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
