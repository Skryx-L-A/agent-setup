def fail(msg):
    print("FEHLER: %s" % msg, file=sys.stderr)
    sys.exit(1)


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError as e:
        class R:
            returncode = 127
            stdout = ""
            stderr = str(e)
        return R()


def zahl(x, n=2):
    return ("%.*f" % (n, x))


def label(tokens):
    if tokens % 1048576 == 0:
        return "%dM" % (tokens // 1048576)
    if tokens % 1024 == 0:
        return "%dk" % (tokens // 1024)
    return str(tokens)


def parse_stufe(s):
    s = s.strip()
    if s.isdigit():
        return int(s)
    m = re.match(r"^(\d+)([kKmM])$", s)
    if m:
        n, einheit = int(m.group(1)), m.group(2).lower()
        return n * (1048576 if einheit == "m" else 1024)
    fail("Stufe '%s' nicht verstanden — eine Tokenzahl (131072) oder ein Kurzform (128k, 1M)." % s)


def stufen_liste(native_max):
    werte = []
    v = STUFE_START
    while v <= native_max:
        werte.append(v)
        v *= 2
    if native_max not in werte:
        werte.append(native_max)
    return werte


