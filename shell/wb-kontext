def frei_mib():
    p = run([os.path.join(BIN, "check-resources")])
    if p.returncode != 0:
        fail("check-resources lieferte keinen Speicherstand (Exit %s) — kein Ergebnis moeglich." % p.returncode)
    try:
        d = json.loads(p.stdout)
    except json.JSONDecodeError:
        fail("check-resources lieferte kein lesbares JSON.")
    return int(d["ram"]["free_mib"])


