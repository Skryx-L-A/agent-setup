def resolve(modell):
    reg = registry_get(modell)
    if reg:
        return {
            "id": reg.get("id", modell),
            "alias": reg.get("alias") or reg.get("id", modell),
            "harness": reg.get("harness") or "pi",
            "provider": reg.get("provider") or "",
            "modelRef": reg.get("modelRef") or reg.get("id"),
            "registryContextWindow": reg.get("contextWindow"),
            # Ein serverseitig ERZWUNGENES Denken (Pruefer-Befund B2, 19.08.2026):
            # wb-mlx-server reicht chatTemplateArgs unveraendert an den Server
            # weiter, der Aufrufer kann es NICHT abschalten. Fuer die
            # Denken-Vorgabe unten (siehe denken_vorgabe()) wichtiger als
            # defaultEffort, das nur pis EIGENES --thinking steuert.
            "chatTemplateArgs": reg.get("chatTemplateArgs") or {},
            "supportsEffort": bool(reg.get("supportsEffort")),
            # Das Registry-Feld 'vorhersage' (Schema von Worker "ktxwerk",
            # extension/src/models.ts) -- EINE Quelle fuer diesen Nachschlag,
            # dieselbe, aus der wb-mlx-server denselben Wert liest (dort ueber
            # 'wb-state models get <id> --field vorhersage', hier ueber
            # denselben registry_get()-Aufruf, der ohnehin schon lief). Siehe
            # berechne() fuer die Auswertung bei bauart == "eingebaut".
            "vorhersage": reg.get("vorhersage") or None,
        }
    if modell.startswith("/") or os.path.isdir(modell):
        return {"id": modell, "alias": modell, "harness": "pi", "provider": "mlx-lokal",
                "modelRef": modell, "registryContextWindow": None,
                "chatTemplateArgs": {}, "supportsEffort": False, "vorhersage": None}
    namen = ollama_namen()
    if modell in namen:
        return {"id": modell, "alias": modell, "harness": "pi", "provider": "ollama",
                "modelRef": modell, "registryContextWindow": None,
                "chatTemplateArgs": {}, "supportsEffort": False, "vorhersage": None}
    fail("Modell '%s' ist weder in der Werkbank-Registry noch als installiertes Ollama-Modell "
         "bekannt, und kein Verzeichnis. Registriert pruefen: wb-state models list" % modell)


# --------------------------------------------------------------- natives Maximum

def natives_maximum_ollama(modelref):
    p = run(["ollama", "show", modelref])
    if p.returncode != 0:
        return None, "'ollama show %s' fehlgeschlagen: %s" % (modelref, p.stderr.strip())
    m = re.search(r"context length\s+(\d+)", p.stdout)
    if not m:
        return None, "'ollama show %s' nennt keine 'context length'" % modelref
    return int(m.group(1)), "ollama show"


def natives_maximum_mlx(modelref):
    cfgp = os.path.join(modelref, "config.json")
    if not os.path.isfile(cfgp):
        return None, "%s fehlt" % cfgp
    try:
        cfg = json.load(open(cfgp))
    except (json.JSONDecodeError, OSError) as e:
        return None, "%s nicht lesbar: %s" % (cfgp, e)
    tc = cfg.get("text_config") or {}
    v = tc.get("max_position_embeddings") or cfg.get("max_position_embeddings")
    if not v:
        return None, "%s nennt kein max_position_embeddings" % cfgp
    return int(v), "config.json (text_config.max_position_embeddings)"


def natives_maximum(res):
    if res["provider"] == "ollama":
        nmax, quelle_oder_grund = natives_maximum_ollama(res["modelRef"])
    elif res["provider"] == "mlx-lokal":
        nmax, quelle_oder_grund = natives_maximum_mlx(res["modelRef"])
    else:
        nmax, quelle_oder_grund = None, "unbekannter Provider '%s'" % res["provider"]
    if nmax is not None:
        return nmax, quelle_oder_grund
    if res.get("registryContextWindow"):
        return res["registryContextWindow"], \
            "Werkbank-Registry (Ersatz — direkte Quelle scheiterte: %s)" % quelle_oder_grund
    fail("natives Maximum fuer '%s' nicht zu ermitteln: %s" % (res["id"], quelle_oder_grund))


