def gewichte_gb(res):
    # GiB (/1024**3), nicht dezimales GB (/1e9) -- Pruefer-Befund B13a,
    # 19.08.2026: die fruehere Fassung holte die Groesse dezimal und addierte
    # sie unveraendert zum binaeren KV-Anteil (bedarf_gib in berechne() rechnet
    # ueberall mit MIB_JE_GIB=1024) -- 7,4 % zu viel, in die harmlose Richtung,
    # aber die angezeigte Zahl war nicht die gerechnete. Der Feldname
    # "gewichteGb" bleibt (Auftrag C baut die Oberflaeche gegen genau dieses
    # Feld), der WERT ist ab jetzt echtes GiB wie der Rest der Rechnung.
    if res["provider"] == "mlx-lokal" or os.path.isdir(res["modelRef"]):
        d = res["modelRef"]
        if not os.path.isdir(d):
            return 0.0, "Modellverzeichnis '%s' nicht gefunden" % d
        tot = sum(os.path.getsize(os.path.join(d, f)) for f in os.listdir(d)
                  if f.endswith(".safetensors"))
        return tot / MIB_JE_GIB ** 3, "safetensors auf der Platte"
    p = run(["ollama", "list"])
    for ln in p.stdout.splitlines()[1:]:
        teile = ln.split()
        if not teile or teile[0] != res["modelRef"]:
            continue
        for i, tok in enumerate(teile):
            if tok in ("GB", "MB", "KB") and i > 0:
                # ollama list gibt dezimale Einheiten aus (dieselbe Herkunft
                # wie oben, /1e9 fuer GB) -- erst in Byte, dann einheitlich in GiB.
                faktor = {"GB": 1e9, "MB": 1e6, "KB": 1e3}[tok]
                try:
                    return float(teile[i - 1]) * faktor / MIB_JE_GIB ** 3, "ollama list SIZE-Spalte"
                except ValueError:
                    break
    return 0.0, "Groesse nicht ermittelbar ('%s' steht nicht in 'ollama list')" % res["modelRef"]


