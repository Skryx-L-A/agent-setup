def pruefe_denken(denken):
    if denken not in DENK_AKTIV and denken != "off":
        fail("--denken '%s' nicht verstanden — off, minimal, low, medium, high, xhigh oder max."
             % denken)
    return DENK_FAKTOR if denken in DENK_AKTIV else 1.0


def parallel_vorgabe(res):
    # KORRIGIERT (der Nutzer, 19.08.2026, nach dem ersten -- falschen -- Versuch
    # dieses Befunds): decode-concurrency 4 ist eine KAPAZITAET des MLX-Servers,
    # keine automatische Belegung. Ein einzelner Worker bucht seine EIGENE
    # Sequenz (1x); vier Sequenzen entstehen nur, wenn wirklich vier Anfragen
    # gleichzeitig laufen. Ohne Angabe bleibt 'parallel' deshalb IMMER 1, fuer
    # jeden Provider -- 'parallel' ist die Antwort auf "wie viele Worker WILL
    # ich gleichzeitig", die ein sachkundiger Aufrufer (pi-worker, das die
    # laufenden Worker zaehlt) explizit mitgibt, kein Vorgabewert, der hier
    # geraten wird.
    return 1


def denken_vorgabe(res):
    # Ohne Angabe darf 'denken' nicht pauschal 'off' sein, aus demselben Grund
    # (Pruefer-Befund B2): die Oberflaeche fragt ohne --denken und bekam
    # dadurch eine Zahl, die im Betrieb nie eintrifft.
    #
    # Ein serverseitig ERZWUNGENES Denken (chatTemplateArgs.reasoning_effort,
    # von wb-mlx-server unveraendert an den Server weitergereicht) gewinnt
    # immer -- der Aufrufer kann es nicht abschalten, egal was er waehlt.
    erzwungen = (res.get("chatTemplateArgs") or {}).get("reasoning_effort")
    if erzwungen:
        return erzwungen
    # Sonst der reale Boden fuer jeden WORKER: derselbe Riegel wie in
    # pi-worker ("fuer Worker muss Denken immer an sein, mindestens auf low").
    # Ein lokales Modell, das hier ankommt, laeuft frueher oder spaeter als
    # Worker -- nie als 'off'. 'off' als Vorgabe waere eine Zahl, die in der
    # Praxis nie eintritt.
    return "low"


def plaetze_wirklich(res, tok, gewichte):
    # Pruefer-Befund N7 (19.08.2026 abends): die alte 'plaetze'-Rechnung zog
    # RESERVE_MIB (2 GiB, diese Datei -- ein kleiner Stoergroessen-Puffer, kein
    # Ersatz fuer wb-belegungs eigene Buchfuehrung, siehe der Kommentar dort
    # oben) von der Reserve ab, die der WIRKLICHE Waechter benutzt (6 GiB
    # System-Reserve + 4 GiB Zuschlag, dazu das Buch der schon offenen
    # Belegungen anderer Worker, das diese Datei gar nicht kennt) --
    # "wb-kontext meldet plaetze 1, wb-belegung darf antwortet NEIN fuer
    # dieselbe eine Sequenz". Fuer mlx-lokal (der einzige Provider, bei dem
    # pi-worker ueberhaupt bei wb-belegung bucht -- Ollama-Worker bucht
    # niemand dort) fragt diese Funktion deshalb den echten Waechter direkt,
    # statt seine Zahlen nachzubilden: EINE Quelle, nicht zwei. Zwei kurze,
    # ungebuchte `darf`-Anfragen (--abtastungen 1, keine Wartezeit -- schnell,
    # aber eine einzelne Messung statt wb-belegungs sonst uebliche
    # Mehrfachmessung; fuer eine reine Auskunftszahl wie 'plaetze' vertretbar)
    # liefern: "verfuegbar_gib" (dieselbe Zahl, unabhaengig von der
    # angefragten Groesse -- min(Grenze A, Grenze B), siehe entscheiden() in
    # wb-belegung) und die Differenz von parallel=2 zu parallel=1 (der reine
    # KV-Aufpreis EINER weiteren Sequenz bei dieser Stufe, nach wb-belegungs
    # EIGENEM KV-Wert, der von wb-kontexts eigenem abweichen kann). Gibt None
    # zurueck, wenn wb-belegung nicht antwortet -- der Aufrufer faellt dann auf
    # die lokale Naeherung zurueck, statt ganz ohne Zahl dazustehen.
    basis = os.path.basename(res["modelRef"].rstrip("/"))

    def frage(parallel):
        p = run([os.path.join(BIN, "wb-belegung"), "darf",
                 "--gewichte-gb", str(gewichte), "--modell", basis,
                 "--parallel", str(parallel), "--kontext", str(tok),
                 "--abtastungen", "1", "--abstand", "0", "--json"])
        try:
            return json.loads(p.stdout)
        except (json.JSONDecodeError, ValueError):
            return None

    a1, a2 = frage(1), frage(2)
    if not a1 or not a2 or a1.get("verfuegbar_gib") is None or a2.get("spitze_gib") is None:
        return None
    verfuegbar = a1["verfuegbar_gib"]
    delta = a2["spitze_gib"] - a1["spitze_gib"]
    if delta <= 0:
        return None
    return max(0, int((verfuegbar - a1["spitze_gib"]) // delta) + 1)


def bedarf_wirklich(res, tok, gewichte, parallel):
    # Zwei Formeln fuer dieselbe Zahl laufen auseinander (Nachtrag 21.08.2026,
    # gemessen: wb-kontext sagte fuer 131072 Token "bedarfGib 24.08, passt:
    # ja", wb-belegung verlangte beim echten Start 29,4 GiB und lehnte ab --
    # der Unterschied ist genau der Zuschlag (Prompt-Cache/Spitzen-Puffer,
    # zuschlag_herleiten() in wb-belegung), den diese Datei nie gefuehrt hat.
    # "Die Oberflaeche sagt passt, der Start sagt nein" ist schlimmer als eine
    # Zahl, die durchgehend zu gross waere -- eine freundlichere Auskunft als
    # die Wirklichkeit fuehrt jeden in die Irre, der sich darauf verlaesst.
    # Also NICHT die Formel nachbauen (dieselbe "eine Quelle, nicht zwei"-
    # Linie wie bei plaetze_wirklich() oben, KV weiter oben und dem modelRef-
    # Umbiegen in berechne()): wb-belegung ENTSCHEIDET ueber den Start, also
    # kennt es die Zahl, nach der der Start wirklich geht. Anders als
    # plaetze_wirklich() (zwei ungebuchte Anfragen bei festem parallel=1/2,
    # um eine reine DELTA-Zahl zu gewinnen) reicht hier EINE Anfrage beim
    # tatsaechlich angefragten 'parallel' -- "spitze_gib" und "ja" sind schon
    # die fertige Antwort, keine Ableitung noetig. Gibt None zurueck, wenn
    # wb-belegung nicht antwortet; der Aufrufer faellt dann auf die lokale
    # Naeherung zurueck (siehe Kommentar dort), mit ihrer Herkunft klar
    # benannt, statt so zu tun, als waere sie dieselbe Zahl.
    basis = os.path.basename(res["modelRef"].rstrip("/"))
    p = run([os.path.join(BIN, "wb-belegung"), "darf",
             "--gewichte-gb", str(gewichte), "--modell", basis,
             "--parallel", str(parallel), "--kontext", str(tok),
             "--abtastungen", "1", "--abstand", "0", "--json"])
    try:
        antwort = json.loads(p.stdout)
    except (json.JSONDecodeError, ValueError):
        return None
    if antwort.get("spitze_gib") is None or antwort.get("ja") is None:
        return None
    return antwort["spitze_gib"], bool(antwort["ja"]), antwort.get("grund")


def berechne(modell, parallel=None, denken=None, entwerfer_gewichte_gb=0.0,
             vorhersage_einstellung=None):
    res = resolve(modell)
    # BAUART "eingebaut" ERSETZT den Modellkoerper (Nachtrag 2026-08-21,
    # Pruefer-Befund zu qwen38-27b/MTPLX): der Kommentar bei
    # entwerfer_gewichte_gb weiter unten sagt das schon lange, aber bis heute
    # RECHNETE diese Funktion trotzdem mit res["modelRef"] des ersetzten
    # Ziel-Eintrags weiter -- Gewichte und KV-Schluessel eines Koerpers, der
    # gar nicht laeuft. Die Quelle ist dieselbe, aus der wb-mlx-server sein
    # MODEL_PATH-Umbiegen speist (siehe dort, cmd_ensure, "MODEL_PATH wird
    # dabei auf vorh_modell umgebogen"): das Registry-Feld
    # vorhersage.modell, hier schon in resolve() mitgelesen -- eine Quelle,
    # nicht zwei. modelRef wird deshalb HIER, VOR jeder weiteren Rechnung,
    # auf den wirklich laufenden Koerper umgebogen; natives_maximum(),
    # gewichte_gb() und kv_mib_pro_token() sehen danach nur noch ihn, genau
    # wie beim echten Start.
    #
    # ZWEI BEDINGUNGEN ENTSCHEIDEN ZUSAMMEN, NICHT EINE (Nachtrag 21.08.2026,
    # Befund vom echten Doppelstart, direkt im Anschluss an den Fix oben):
    # das Registry-Feld allein reicht nicht. Ob wb-code/pi-worker den
    # Ersatzkoerper WIRKLICH anfordern, haengt zusaetzlich an einer Sitzungs-
    # Einstellung (orchestratorVorhersage / workerVorhersage) -- gemessen
    # stand die auf 'false' (Absicht, kein Versehen), waehrend diese Funktion
    # trotzdem mit dem MTPLX-Koerper (19,83 GiB, q8-KV) rechnete, obwohl
    # wirklich der schlichte Koerper lief (14,95 GiB, bf16-KV) -- vor diesem
    # zweiten Fix war die Zahl zu niedrig, jetzt (nur Registry, ohne
    # Einstellung) zu hoch; richtig ist sie erst, wenn BEIDE Bedingungen
    # geprueft werden. `vorhersage_einstellung` ist der Name dieser Einstellung
    # (vom Aufrufer mitgegeben -- wb-code kennt "orchestratorVorhersage",
    # pi-worker "workerVorhersage"; wb-kontext selbst weiss nicht, in welcher
    # Rolle es gerufen wird, deshalb nennt der Aufrufer den Namen). Gelesen
    # wird sie ueber `einstellung_ist_an()`, DENSELBEN Weg, den wb-code/
    # pi-worker fuer denselben Wert benutzen ("wb-state settings get
    # <name>") -- keinen zweiten, eigenen Lesepfad fuer dieselbe Zahl.
    # OHNE angegebenen Namen bleibt es beim sicheren Ausgangswert (KEIN
    # Umbiegen): die Einstellung steht im Regelfall auf 'false', und ein
    # Aufrufer, der den Namen nicht mitgibt (z.B. ein Mensch am Terminal),
    # bekommt die Zahl fuer den Koerper, der ohne weitere Angabe wirklich
    # startet -- kein Raten in die teurere Richtung.
    #
    # OFFEN, ERNEUT GEPRUEFT UND BEWUSST OFFEN GELASSEN (Nachtrag 21.08.2026,
    # zweiter Pruefpass des Auftrags zu shell/wb-mlx-server -- derselbe
    # Wechsel-Riegel-Auftrag stellt ausdruecklich frei, das hier zu schliessen
    # ODER begruendet offen zu lassen; nur STILL offen lassen waere nicht
    # erlaubt): wb-mlx-server waehlt ab einer Stromzahl (Registry-Feld
    # buendelung.umschlagpunktStroeme -- 2 fuer qwen38-27b, Vorgabe sonst 3
    # ueber MTPLX_UMSCHLAGPUNKT_STROEME -- UND davon abhaengig, ob der
    # vllm-metal-Motor auf DIESER Maschine ueberhaupt ausfuehrbar ist: venv/
    # bin/vllm oder ein vllm im PATH) den Buendelungsmotor STATT der
    # Vorhersage und laesst MODEL_PATH dann beim urspruenglichen Ziel. Diese
    # Funktion biegt unabhaengig von 'parallel' immer um, sobald Registry-Feld
    # UND Einstellung beide an sind.
    #
    # WARUM NICHT GESCHLOSSEN: die Schwelle haengt nicht nur an einer
    # Registry-Zahl, sondern zusaetzlich daran, ob ein externes Werkzeug
    # (vllm) auf DIESER Maschine gerade ausfuehrbar ist -- eine Pruefung, die
    # diese Datei bisher fuer nichts sonst macht (sie kennt Registry, KV-Buch,
    # check-resources, wb-belegung, wb-state; keine Datei- oder PATH-Sonde
    # auf ein Drittwerkzeug). Eine zweite Kopie der Schwelle OHNE diese Sonde
    # waere selbst wieder eine Annahme und haette dasselbe Schicksal wie die
    # 1,5 bei SICHERHEITSFAKTOR oben (veraltet lautlos, sobald die andere
    # Datei sie verschiebt, siehe der Kommentar dort und Pruefer-Befund N6).
    #
    # AUSWIRKUNG, damit sie nicht verschwiegen bleibt: bei einem Aufruf mit
    # 'parallel' AB dem Umschlagpunkt (typisch 2, ein zweiter gleichzeitiger
    # qwen38-Worker) nimmt diese Funktion weiterhin den groesseren
    # MTPLX-Koerper an, waehrend der echte Start dort auf die Buendelung mit
    # dem KLEINEREN Ziel-Koerper umschaltet -- eine UEBERSCHAETZUNG (die
    # sichere Richtung: eine Stufe kann dadurch faelschlich als "passt nicht"
    # erscheinen, nie umgekehrt faelschlich als "passt"). Der Regelfall
    # (paralell 1, der CLI-Vorgabewert und der von pi-worker fuer den ersten
    # Worker berechnete Wert) ist davon nicht betroffen.
    #
    # WEG FUER EINE SPAETERE SPUR: wb-mlx-server bekaeme eine eigene, kleine
    # Abfrage seiner wirksamen Motorwahl (z.B. `wb-mlx-server motor-fuer
    # <modell> --parallel <n>`), die diese Funktion aufruft, statt die
    # Verzweigung ein zweites Mal nachzubauen -- EINE Quelle bleibt dann auch
    # hier die Linie, nicht zwei.
    vorhersage = res.get("vorhersage") or {}
    vorhersage_ersetzt_ziel = None
    vorhersage_aktiv = bool(vorhersage_einstellung) and einstellung_ist_an(vorhersage_einstellung)
    if (res["provider"] == "mlx-lokal" and vorhersage.get("bauart") == "eingebaut"
            and vorhersage.get("modell") and vorhersage_aktiv):
        vorhersage_ersetzt_ziel = res["modelRef"]
        res = dict(res)
        res["modelRef"] = vorhersage["modell"]
    if parallel is None:
        parallel = parallel_vorgabe(res)
    if denken is None:
        denken = denken_vorgabe(res)
    denk_faktor = pruefe_denken(denken)
    nmax, nmax_quelle = natives_maximum(res)
    gewichte, gw_quelle = gewichte_gb(res)
    # Multi-Token-Vorhersage (2026-08-20): laeuft ein EXTERNER Entwerfer neben
    # dem Zielmodell (Registry-Feld vorhersage.bauart == 'entwerfer'), laedt
    # der Server ihn ZUSAETZLICH -- diese Datei kennt davon nichts von sich
    # aus (gewichte_gb() liest nur das Zielmodell), der Aufrufer (wb-code/
    # pi-worker, die die Registry ohnehin schon lesen) gibt das Zusatzgewicht
    # deshalb explizit mit. Ohne das wuerde 'passt'/'plaetze' zu grosszuegig
    # rechnen, sobald Vorhersage an ist -- dieselbe "eine Quelle, nicht
    # zwei"-Linie wie beim KV-Boden weiter oben. Bei 'bauart: eingebaut'
    # bleibt dieser Wert 0: dort ERSETZT der groessere Modellkoerper das Ziel
    # (eigener modelRef, kein Zusatzgewicht), keine Addition hier -- siehe
    # das modelRef-Umbiegen ganz oben in dieser Funktion, das genau das jetzt
    # wirklich tut.
    if entwerfer_gewichte_gb:
        gewichte += entwerfer_gewichte_gb
        gw_quelle += " + %s GiB Entwerfer (Multi-Token-Vorhersage)" % zahl(entwerfer_gewichte_gb, 2)
    kv, kv_quelle = kv_mib_pro_token(res)
    frei = frei_mib()
    stufen = []
    for tok in stufen_liste(nmax):
        # KEIN denk_faktor hier (Korrektur 19.08.2026 abends): tok ist schon
        # die volle Fenstergroesse, kv schon der Byte-Bedarf JE Token-Feld --
        # beide zusammen ergeben bereits den vollen Speicher fuer diese Stufe.
        # denk_faktor auf diese Summe zu multiplizieren zaehlte "mehr Token
        # wegen Denken" ein zweites Mal, obwohl tok das Fenster schon in
        # voller Groesse einpreist -- siehe die Begruendung bei DENK_FAKTOR
        # oben. Der Wert bleibt im Rueckgabe-/JSON-Feld "denkFaktor" sichtbar,
        # zaehlt aber nicht mehr in die Bedarfsrechnung.
        bedarf_gib = gewichte + parallel * tok * kv / MIB_JE_GIB
        bedarf_quelle = "wb-kontext eigene Naeherung (ohne wb-belegungs Zuschlag/Prompt-Cache)"
        bedarf_mib = bedarf_gib * MIB_JE_GIB
        passt = bedarf_mib + RESERVE_MIB <= frei
        wb_belegung_grund = None
        # Die lokale Naeherung oben zaehlt keinen Zuschlag und keinen Prompt-
        # Cache-Puffer (siehe bedarf_wirklich() fuer die Herleitung des
        # Befunds) -- fuer mlx-lokal deshalb, wie schon bei 'plaetze', den
        # echten Waechter fragen und dessen Zahl nehmen, wenn er antwortet.
        if res["provider"] == "mlx-lokal":
            echter_bedarf = bedarf_wirklich(res, tok, gewichte, parallel)
            if echter_bedarf is not None:
                bedarf_gib, passt, wb_belegung_grund = echter_bedarf
                bedarf_quelle = "wb-belegung darf (spitze_gib, dieselbe Zahl wie beim echten Start)"
        hinweis = None
        if not passt:
            # wb-belegungs EIGENE Erklaerung, wenn sie da ist (dieselbe, die
            # der echte Start sehen wuerde) -- sonst die lokale Naeherung.
            hinweis = wb_belegung_grund or (
                "Braucht %s GiB (+ %s MiB Reserve), frei sind %s GiB — waehlbar, aber der "
                "Start kann am Speicher scheitern."
                % (zahl(bedarf_gib, 1), RESERVE_MIB, zahl(frei / MIB_JE_GIB, 1)))
        # "plaetze": die Umkehrfrage zu 'parallel' (der Nutzer, 19.08.2026): bei
        # DIESER Stufe, wie viele Worker passen insgesamt gleichzeitig in den
        # gerade freien Speicher -- unabhaengig vom angefragten 'parallel'
        # oben. Fuer mlx-lokal fragt plaetze_wirklich() den echten Waechter
        # (wb-belegung) direkt (N7-Fix, siehe dort) -- nur wenn der nicht
        # antwortet, oder fuer Ollama (wo pi-worker gar nicht bei wb-belegung
        # bucht, siehe dort), gilt die lokale Naeherung: Gewichte zaehlen
        # EINMAL (der Server laedt sie einmal), jeder Worker zusaetzlich nur
        # seine eigene Sequenz -- dieselbe Rechnung wie bedarf_gib, nur nach n
        # statt nach bedarf aufgeloest. Auch hier ohne denk_faktor, aus
        # demselben Grund wie oben.
        kv_je_worker_gib = tok * kv / MIB_JE_GIB
        frei_gib_nutzbar = (frei - RESERVE_MIB) / MIB_JE_GIB
        uebrig = frei_gib_nutzbar - gewichte
        plaetze_naeherung = max(0, int(uebrig // kv_je_worker_gib)) if kv_je_worker_gib > 0 else 0
        plaetze = plaetze_naeherung
        if res["provider"] == "mlx-lokal":
            echte_plaetze = plaetze_wirklich(res, tok, gewichte)
            if echte_plaetze is not None:
                plaetze = echte_plaetze
        stufen.append({"tokens": tok, "label": label(tok), "bedarfGib": round(bedarf_gib, 2),
                        "bedarfQuelle": bedarf_quelle,
                        "passt": passt, "hinweis": hinweis, "plaetze": plaetze})
    return {
        "res": res, "nmax": nmax, "nmax_quelle": nmax_quelle,
        "denken": denken, "denk_faktor": denk_faktor,
        "gewichte": gewichte, "gw_quelle": gw_quelle,
        "entwerfer_gewichte_gb": entwerfer_gewichte_gb,
        "kv": kv, "kv_quelle": kv_quelle,
        "frei": frei, "stufen": stufen, "parallel": parallel,
        # Fuer die Anzeige (drucke_stufen): res["modelRef"] ist ab hier
        # schon der ersetzte Koerper, falls vorhersage.bauart == "eingebaut"
        # zugeschlagen hat -- diese beiden Felder sagen dem Leser, OB und
        # WOFUER umgebogen wurde, ohne dass er das selbst nachschlagen muss.
        "vorhersage_bauart": vorhersage.get("bauart"),
        "vorhersage_ersetzt_ziel": vorhersage_ersetzt_ziel,
    }


def empfehlen(daten):
    stufen, frei = daten["stufen"], daten["frei"]
    passend = [s for s in stufen if s["passt"]]
    if passend:
        return max(passend, key=lambda s: s["tokens"]), None
    kleinste = min(stufen, key=lambda s: s["tokens"])
    grund = ("keine Stufe passt (Bedarf + %s MiB Reserve) in die %s MiB frei — kleinste Stufe %s "
             "trotzdem gewaehlt." % (RESERVE_MIB, frei, kleinste["label"]))
    return kleinste, grund


