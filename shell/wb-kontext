@contextlib.contextmanager
def pi_models_sperre():
    # ECHTE Sperre ums ganze Lesen-Aendern-Schreiben (Pruefer-Befund B3,
    # 19.08.2026): das erneute Einlesen unmittelbar vor dem Schreiben schuetzt
    # NICHT vor einem Wettlauf -- es verkuerzt nur das Fenster, in dem zwei
    # gleichzeitige Aufrufe sich gegenseitig ueberschreiben koennen (gemessen:
    # 25 von 25 Laeufen verloren einen Schreiber). Eine echte Sperre schliesst
    # das Fenster vollstaendig: ein zweiter Aufrufer wartet auf `flock`, statt
    # gleichzeitig zu lesen. Verzeichnis-Sperre (eine eigene .lock-Datei,
    # unabhaengig vom eigentlichen Inhalt) statt eine Sperre auf PI_MODELS
    # selbst, damit ein Absturz zwischen Lesen und Schreiben die Sperrdatei nie
    # mit halb geschriebenem JSON verwechselt.
    d = os.path.dirname(PI_MODELS_LOCK)
    os.makedirs(d, exist_ok=True)
    fd = open(PI_MODELS_LOCK, "a+")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        fd.close()


def pi_models_lesen():
    if not os.path.isfile(PI_MODELS):
        return {"providers": {}}
    with open(PI_MODELS) as f:
        return json.load(f)


def pi_models_schreiben(daten):
    d = os.path.dirname(PI_MODELS)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".models.json.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(daten, f, indent=4, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp, PI_MODELS)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    # Eine kaputte Datei nimmt pi kommentarlos uebel -- sofort neu einlesen und pruefen.
    with open(PI_MODELS) as f:
        json.load(f)


def eintrag_setzen(provs, pname, basis_vorlage, modelref, stufe, name):
    """Traegt <modelref> mit contextWindow=<stufe> im Provider <pname> ein (legt
    ihn aus basis_vorlage an, falls er fehlt). Gemeinsam fuer ensure_ollama und
    ensure_mlx, damit es nur EINE Stelle gibt, die in providers[...].models
    schreibt."""
    prov = provs.get(pname)
    if not prov:
        prov = {"baseUrl": basis_vorlage["baseUrl"], "api": basis_vorlage["api"],
                 "apiKey": basis_vorlage["apiKey"],
                 "compat": dict(basis_vorlage.get("compat", {})), "models": []}
        provs[pname] = prov
    prov.setdefault("models", [])
    eintrag = next((m for m in prov["models"] if m.get("id") == modelref), None)
    if eintrag:
        eintrag["contextWindow"] = stufe
    else:
        prov["models"].append({"id": modelref, "name": name, "contextWindow": stufe})


def ensure_ollama(modelref, stufe, lbl):
    varname = "%s-%s" % (modelref, lbl)
    if varname not in ollama_namen():
        inhalt = "FROM %s\nPARAMETER num_ctx %d\n" % (modelref, stufe)
        fd, pfad = tempfile.mkstemp(suffix=".Modelfile")
        try:
            with os.fdopen(fd, "w") as f:
                f.write(inhalt)
            cp = run(["ollama", "create", varname, "-f", pfad])
            if cp.returncode != 0:
                fail("'ollama create %s' fehlgeschlagen: %s"
                     % (varname, (cp.stderr or cp.stdout).strip()))
        finally:
            try:
                os.unlink(pfad)
            except OSError:
                pass
    # ~/.pi/agent/models.json ist ausschliesslich wb-kontexts Sache (Nachtrag
    # 2026-08-19, es der MLX-Spur abgenommen). Eine frisch gebrannte Variante
    # braucht hier ihren eigenen Eintrag, sonst rechnet pi mit der falschen
    # Fenstergroesse und die Kontextwache sieht eine falsche Auslastung -- das
    # ist der Grund, warum diese Zahl gepflegt wird. Das ganze
    # Lesen-Aendern-Schreiben steht unter EINER echten Sperre (pi_models_sperre,
    # Pruefer-Befund B3) -- ein erneutes Einlesen allein schuetzt nicht vor
    # zwei gleichzeitigen Aufrufen, siehe die Begruendung dort.
    with pi_models_sperre():
        daten = pi_models_lesen()
        provs = daten.setdefault("providers", {})
        ollama_basis = provs.get("ollama") or {
            "baseUrl": "http://localhost:11434/v1", "api": "openai-completions",
            "apiKey": "ollama", "compat": {"supportsDeveloperRole": False},
        }
        eintrag_setzen(provs, "ollama", ollama_basis, varname, stufe,
                       "%s (%s ctx, wb-kontext)" % (varname, lbl))
        pi_models_schreiben(daten)
    print(varname)


def ensure_mlx(modelref, stufe, lbl, bedient_als=""):
    """`bedient_als` ist der Name, unter dem der laufende Server WIRKLICH antwortet
    (Nachtrag 2026-08-21). Gebraucht wird er, seit der Betriebsmotor fuer
    qwen38-27b mtplx ist: der Server meldet unter /v1/models ausschliesslich
    "mtplx-qwen38-27b-optimized-speed" und weist jeden anderen Namen ab, waehrend
    hier bisher der Registry-Pfad in pis Modell-Eintrag geschrieben wurde. Ein
    fehlerfrei gestarteter Server, den sein einziger Aufrufer nicht ansprechen
    kann -- gemessen am 21.08.

    Der SCHLUESSEL bleibt der modelref: danach wird der Basis-Eintrag gesucht,
    und danach findet ein spaeterer Aufruf denselben Eintrag wieder. Nur die
    `id`, die pi als Modellnamen sendet, und die gedruckte erste Zeile tragen
    den bedienten Namen. Leer heisst wie bisher: der modelref ist der Name."""
    # Das ganze Lesen-Aendern-Schreiben steht unter EINER echten Sperre
    # (pi_models_sperre, Pruefer-Befund B3, 19.08.2026) -- ein erneutes
    # Einlesen unmittelbar vor dem Schreiben (die fruehere Fassung dieser
    # Funktion) schuetzt NICHT vor einem Wettlauf, es verkuerzt nur das
    # Fenster; gemessen verlor das 25 von 25 gleichzeitigen Laeufen einen
    # Schreiber. Wichtig: die SPERRE muss auch den fruehen Kurzschluss
    # ("passt schon", kein Schreiben) umschliessen, sonst liest dieser Zweig
    # einen Zwischenstand, waehrend ein anderer Aufruf gerade schreibt.
    with pi_models_sperre():
        daten = pi_models_lesen()
        provs = daten.setdefault("providers", {})
        basis = provs.get("mlx-lokal")
        # GESUCHT WIRD UNTER BEIDEN NAMEN (Nachtrag 2026-08-21), aus demselben
        # Grund wie unten beim Stufen-Provider: seit die `id` der Name ist, den
        # der Server wirklich bedient, kann derselbe Eintrag je nach Alter den
        # modelRef ODER den bedienten Namen tragen. Wer nur nach dem modelRef
        # sucht, findet einen umbenannten Eintrag nicht mehr wieder -- und legt
        # dann still einen zweiten daneben, statt den vorhandenen zu erkennen.
        gewuenschte_id = bedient_als or modelref
        basis_eintrag = None
        if basis:
            for m in basis.get("models", []):
                if m.get("id") in (modelref, gewuenschte_id):
                    basis_eintrag = m
                    break
        # DER KURZSCHLUSS PRUEFT BEIDES, UND ER NENNT SEINEN PROVIDER
        # (korrigiert 2026-08-21). Er sagt "es ist schon alles so, wie es sein
        # soll, hier ist nichts zu schreiben". Damit dieser Satz stimmt, muessen
        # ZWEI Dinge stimmen, nicht eines:
        #
        #   contextWindow == stufe   das Fenster, das die Sitzung gleich fahren will
        #   id == der Name, den der Server WIRKLICH bedient
        #
        # Bis heute stand hier nur das erste. In ~/.pi/agent/models.json trug der
        # Provider mlx-lokal einen Eintrag mit der id
        # $HOME/AI/mlx-models/qwen38-27b-mlx-4bit und contextWindow 262144,
        # waehrend der laufende Server ausschliesslich
        # mtplx-qwen38-27b-optimized-speed bedient. Der Kurzschluss feuerte, gab
        # den bedienten Namen als erste Zeile zurueck und liess den Eintrag mit
        # der Pfad-id stehen: pi fragte danach den Provider mlx-lokal nach einem
        # Modell, das dieser Provider gar nicht fuehrt.
        #
        # UND ER DRUCKT SEIN provider=. wb-code liest die Zeile
        # (sed -n 's/^provider=//p') und laesst PIPROVIDER sonst auf dem
        # Vorgabewert stehen -- auf diesem Pfad blieb der Provider also
        # ungesetzt, waehrend das Modell schon den neuen Namen trug. Fuer den
        # Basisprovider ist der gedruckte Wert derselbe wie die Vorgabe; gedruckt
        # wird er trotzdem, weil eine Auskunft, die manchmal fehlt, schlimmer ist
        # als eine, die manchmal ueberfluessig ist.
        #
        # WARUM NUR IM BASISPROVIDER GESUCHT WIRD und nicht auch in den
        # mlx-lokal-<label>-Providern, in die diese Funktion ihre Eintraege
        # schreibt: der Schreibweg unten gleicht bei JEDEM Aufruf ALLE Felder des
        # Basis-Eintrags neu ab (siehe der lange Kommentar dort). Das ist kein
        # Beiwerk -- die MLX-Spur traegt reasoning/thinkingLevelMap/
        # compat.thinkingFormat in den Basis-Eintrag ein, und eine Kopie, die
        # davon abgeschnitten ist, schaltet das Denken still ab. Ein Kurzschluss
        # auf die Kopie wuerde genau diesen Abgleich ueberspringen und die Kopie
        # lautlos veralten lassen. Der zweite Schreibvorgang ist billig, eine
        # veraltete Kopie ist es nicht.
        if (basis_eintrag
                and basis_eintrag.get("contextWindow") == stufe
                and basis_eintrag.get("id") == gewuenschte_id):
            print(gewuenschte_id)
            print("provider=mlx-lokal")
            return
        pname = "mlx-lokal-%s" % lbl
        name_basis = os.path.basename(modelref.rstrip("/"))
        if pname not in provs:
            quelle = basis or {"baseUrl": "http://127.0.0.1:8080/v1", "api": "openai-completions",
                                "apiKey": "mlx", "compat": {"supportsDeveloperRole": False}}
            # Alle Felder des Basis-Providers uebernehmen, nicht nur baseUrl/api/
            # apiKey/compat -- derselbe Grundsatz wie beim Modell-Eintrag unten,
            # "models" wird neu aufgebaut.
            provs[pname] = {k: copy.deepcopy(v) for k, v in quelle.items() if k != "models"}
            provs[pname].setdefault("models", [])
        prov = provs[pname]
        prov.setdefault("models", [])
        # Gesucht wird unter BEIDEN Namen: ein Eintrag aus der Zeit vor diesem
        # Nachtrag traegt den modelref als id, ein neuer den bedienten Namen.
        # Ohne das entstuende bei der Umstellung ein zweiter Eintrag daneben.
        _namen = {modelref, gewuenschte_id}
        idx = next((i for i, m in enumerate(prov["models"]) if m.get("id") in _namen), None)
    # ALLE Felder des Original-Eintrags uebernehmen, nicht nur id/name/
    # contextWindow (Nachtrag 2026-08-19, ausdrueckliche des Nutzers Vorgabe): die
    # MLX-Spur traegt reasoning/thinkingLevelMap/compat.thinkingFormat/
    # compat.chatTemplateKwargs in den Basis-Eintrag ein, damit --thinking bei
    # einem lokalen Modell ueberhaupt wirkt. Eine Kopie, die nur die drei
    # bekannten Felder mitnimmt, schaltet das Denken jedes Workers auf dieser
    # Kopie STILL ab, ohne Fehlermeldung. Generisch fuer JEDES Feld, nicht als
    # Aufzaehlung der heutigen Namen -- die naechste pi-Fassung bringt
    # womoeglich weitere. Bei JEDEM Aufruf neu abgeglichen (nicht nur bei der
    # ersten Anlage), sonst veraltet eine bestehende Kopie lautlos, sobald die
    # MLX-Spur der Basis neue Felder hinzufuegt.
        eintrag = copy.deepcopy(basis_eintrag) if basis_eintrag else {"id": modelref}
        # Die id ist das, was pi als Modellnamen an den Server schickt -- also der
        # Name, den der Server auch annimmt. Siehe der Docstring oben.
        eintrag["id"] = gewuenschte_id
        eintrag["name"] = "%s (%s ctx, wb-kontext)" % (name_basis, lbl)
        eintrag["contextWindow"] = stufe
        if idx is None:
            prov["models"].append(eintrag)
        else:
            prov["models"][idx] = eintrag
        pi_models_schreiben(daten)
    print(gewuenschte_id)
    print("provider=%s" % pname)


# --------------------------------------------------------------- Ausgabe

def drucke_stufen(daten, als_json):
    res, empf, empf_grund = daten["res"], *empfehlen(daten)
    if empf_grund:
        print("HINWEIS: %s" % empf_grund, file=sys.stderr)
    if als_json:
        out = {
            "modell": res["id"], "harness": res["harness"], "provider": res["provider"],
            "modelRef": res["modelRef"], "nativesMaximum": daten["nmax"],
            "freiMib": daten["frei"], "gewichteGb": round(daten["gewichte"], 2),
            "entwerferGewichteGb": daten["entwerfer_gewichte_gb"],
            "kvMibProToken": daten["kv"], "parallel": daten["parallel"],
            "denken": daten["denken"], "denkFaktor": round(daten["denk_faktor"], 3),
            "vorgabe": res.get("registryContextWindow"), "empfehlung": empf["tokens"],
            "stufen": daten["stufen"],
            # None/None ausser bei vorhersage.bauart == "eingebaut": dann steht
            # hier die Bauart und der urspruenglich angefragte modelRef, den
            # "modelRef" oben ersetzt hat (siehe berechne()).
            "vorhersageBauart": daten["vorhersage_bauart"],
            "vorhersageErsetztFuer": daten["vorhersage_ersetzt_ziel"],
        }
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    print("modell        : %s (harness %s, provider %s)" % (res["id"], res["harness"], res["provider"]))
    print("modelRef      : %s" % res["modelRef"])
    if daten["vorhersage_ersetzt_ziel"]:
        print("vorhersage    : eingebaut -- Koerper ersetzt '%s' (siehe modelRef oben, das ist der wirklich "
              "laufende Koerper)" % daten["vorhersage_ersetzt_ziel"])
    print("natives Max.  : %s (Quelle: %s)" % (daten["nmax"], daten["nmax_quelle"]))
    print("frei          : %s MiB" % daten["frei"])
    print("Gewichte      : %s GiB (Quelle: %s)" % (zahl(daten["gewichte"], 2), daten["gw_quelle"]))
    print("KV je Token   : %s MiB (Quelle: %s)" % (zahl(daten["kv"], 4), daten["kv_quelle"]))
    print("Denken        : %s (Faktor %s)" % (daten["denken"], zahl(daten["denk_faktor"], 2)))
    print("parallel      : %s   vorgabe: %s   empfehlung: %s"
          % (daten["parallel"], res.get("registryContextWindow"), empf["tokens"]))
    print("")
    print("%-10s %-6s %-10s %-5s %-8s %s" % ("tokens", "label", "bedarfGib", "passt", "plaetze", "hinweis"))
    for s in daten["stufen"]:
        print("%-10s %-6s %-10s %-5s %-8s %s" % (
            s["tokens"], s["label"], zahl(s["bedarfGib"], 2), "ja" if s["passt"] else "nein",
            s["plaetze"], s["hinweis"] or ""))


def main():
    p = argparse.ArgumentParser(prog="wb-kontext", add_help=True)
    sub = p.add_subparsers(dest="befehl")

    VORHERSAGE_HILFE = ("Name der Sitzungs-Einstellung, die entscheidet, ob "
                         "vorhersage.bauart=eingebaut wirklich zuschlaegt "
                         "(wb-code: orchestratorVorhersage, pi-worker: "
                         "workerVorhersage) -- gelesen ueber 'wb-state settings "
                         "get <name>', denselben Weg wie der Aufrufer. Ohne "
                         "Angabe bleibt es beim schlichten Ziel-Koerper.")

    p_s = sub.add_parser("stufen")
    p_s.add_argument("modell")
    p_s.add_argument("--parallel", type=int, default=None)
    p_s.add_argument("--denken", default=None)
    p_s.add_argument("--entwerfer-gewichte-gb", type=float, default=0.0)
    p_s.add_argument("--vorhersage-einstellung", default=None, help=VORHERSAGE_HILFE)
    p_s.add_argument("--json", action="store_true")

    p_e = sub.add_parser("empfehlung")
    p_e.add_argument("modell")
    p_e.add_argument("--parallel", type=int, default=None)
    p_e.add_argument("--denken", default=None)
    p_e.add_argument("--entwerfer-gewichte-gb", type=float, default=0.0)
    p_e.add_argument("--vorhersage-einstellung", default=None, help=VORHERSAGE_HILFE)

    p_n = sub.add_parser("ensure")
    p_n.add_argument("modell")
    p_n.add_argument("stufe")
    p_n.add_argument("--bedient-als", default="",
                     help="der Name, unter dem der laufende Server WIRKLICH antwortet "
                          "(wb-mlx-server ensure gibt ihn als 'modell=' auf stdout aus). "
                          "Er wird die id in pis Modell-Eintrag und die erste gedruckte "
                          "Zeile; gesucht wird weiterhin ueber den modelRef. Ohne Angabe "
                          "bleibt es wie bisher beim modelRef.")

    a = p.parse_args()
    if not a.befehl:
        p.print_help()
        return 2

    if a.befehl == "stufen":
        if a.parallel is not None and a.parallel < 1:
            fail("--parallel muss mindestens 1 sein.")
        daten = berechne(a.modell, a.parallel, a.denken, a.entwerfer_gewichte_gb,
                          a.vorhersage_einstellung)
        drucke_stufen(daten, a.json)
        return 0

    if a.befehl == "empfehlung":
        if a.parallel is not None and a.parallel < 1:
            fail("--parallel muss mindestens 1 sein.")
        daten = berechne(a.modell, a.parallel, a.denken, a.entwerfer_gewichte_gb,
                          a.vorhersage_einstellung)
        empf, grund = empfehlen(daten)
        if grund:
            print("HINWEIS: %s" % grund, file=sys.stderr)
        print(empf["tokens"])
        return 0

    if a.befehl == "ensure":
        res = resolve(a.modell)
        nmax, _ = natives_maximum(res)
        stufe = parse_stufe(a.stufe)
        gueltig = stufen_liste(nmax)
        if stufe not in gueltig:
            fail("Stufe %d ist fuer '%s' keine gueltige Stufe (natives Maximum %d). Gueltig: %s"
                 % (stufe, a.modell, nmax, ", ".join(label(t) for t in gueltig)))
        lbl = label(stufe)
        if res["provider"] == "ollama":
            ensure_ollama(res["modelRef"], stufe, lbl)
        elif res["provider"] == "mlx-lokal":
            ensure_mlx(res["modelRef"], stufe, lbl, a.bedient_als)
        else:
            fail("ensure kennt Provider '%s' nicht (nur ollama, mlx-lokal)." % res["provider"])
        return 0

    return 2


if __name__ == "__main__":
    sys.exit(main())
