        with open(KV_DATEI) as f:
            daten = json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}
    modelle = daten.get("modelle")
    return modelle if isinstance(modelle, dict) else {}


def kv_obergrenze_mib(lagen_gesamt, koepfe_gesamt, kopfdim):
    # Physikalische Obergrenze fuer EIN Modell mit dieser Architektur: ALLE
    # Lagen mit voller Attention (keine Hybrid-/SSM-Ersparnis angenommen),
    # ALLE Koepfe (keine GQA-Reduktion auf wenige KV-Koepfe angenommen), 2
    # Byte je Element (kein Quantisierungsgewinn angenommen). Hybrid-Bauart,
    # GQA und 8-Bit-Cache koennen den echten Bedarf nur SENKEN, nie darueber
    # steigen -- ein Wert je Token, der diese Zahl uebersteigt, ist fuer diese
    # Architektur unmoeglich, egal woher er kommt (gemessen, hergeleitet oder
    # angenommen).
    return 2 * lagen_gesamt * koepfe_gesamt * kopfdim * 2 / (1024.0 ** 2)


def kv_architektur_mlx(modelref):
    # Liest dieselbe config.json wie natives_maximum_mlx, nur die
    # Attention-Felder statt max_position_embeddings.
    cfgp = os.path.join(modelref, "config.json")
    if not os.path.isfile(cfgp):
        return None
    try:
        cfg = json.load(open(cfgp))
    except (json.JSONDecodeError, OSError):
        return None
    tc = cfg.get("text_config") or cfg
    lagen = tc.get("num_hidden_layers")
    alle_koepfe = tc.get("num_attention_heads")
    kv_koepfe = tc.get("num_key_value_heads") or alle_koepfe
    kopfdim = tc.get("head_dim")
    if not kopfdim and alle_koepfe:
        hidden = tc.get("hidden_size")
        if hidden:
            kopfdim = hidden / alle_koepfe
    if not (lagen and kv_koepfe and kopfdim and alle_koepfe):
        return None
    layer_types = tc.get("layer_types")
    if layer_types:
        # Die tatsaechliche Liste schlaegt jede Annahme ueber den Abstand --
        # so wurde grugs "16 von 64" (siehe kv-bedarf.json) ueberhaupt zuerst
        # gemessen.
        wachsende = sum(1 for t in layer_types if t == "full_attention")
    else:
        intervall = tc.get("full_attention_interval")
        wachsende = -(-lagen // int(intervall)) if intervall else lagen  # Aufrunden
    mib = 2 * wachsende * kv_koepfe * kopfdim * 1 / (1024.0 ** 2)  # 1 Byte: 8-Bit-Cache, Standing Rule
    quelle = ("config.json: %d/%d Lagen volle Attention, %d KV-Koepfe, Kopfdim %s, 8-Bit-Cache"
              % (wachsende, lagen, kv_koepfe, kopfdim))
    obergrenze = kv_obergrenze_mib(lagen, alle_koepfe, kopfdim)
    return mib, quelle, obergrenze


def kv_architektur_ollama(modelref):
    # 'ollama show -v' liefert dieselben GGUF-Metadatenfelder, die grug/
    # qwen3.8 schon per config.json hergeleitet wurden (general.architecture
    # als Praefix, dann <arch>.block_count, <arch>.attention.head_count_kv,
    # <arch>.attention.key_length, optional <arch>.full_attention_interval).
    p = run(["ollama", "show", modelref, "--verbose"])
    if p.returncode != 0:
        return None
    out = p.stdout
    m = re.search(r"general\.architecture\s+(\S+)", out)
    if not m:
        return None
    arch = re.escape(m.group(1))

    def feld(name):
        mm = re.search(r"%s\.%s\s+(\S+)" % (arch, re.escape(name)), out)
        return mm.group(1) if mm else None

    lagen_s = feld("block_count")
    kv_koepfe_s = feld("attention.head_count_kv") or feld("attention.head_count")
    alle_koepfe_s = feld("attention.head_count")
    kopfdim_s = feld("attention.key_length") or feld("attention.value_length")
    embed_s = feld("embedding_length")
    if not kopfdim_s and alle_koepfe_s and embed_s:
        try:
            kopfdim_s = str(float(embed_s) / float(alle_koepfe_s))
        except (ValueError, ZeroDivisionError):
            kopfdim_s = None
    if not (lagen_s and kv_koepfe_s and kopfdim_s):
        return None
    try:
        lagen = int(float(lagen_s))
        kv_koepfe = int(float(kv_koepfe_s))
        kopfdim = int(float(kopfdim_s))
        alle_koepfe = int(float(alle_koepfe_s)) if alle_koepfe_s else kv_koepfe
    except ValueError:
        return None
    intervall_s = feld("full_attention_interval")
    if intervall_s:
        try:
            wachsende = -(-lagen // int(float(intervall_s)))  # Aufrunden
        except (ValueError, ZeroDivisionError):
            wachsende = lagen
    else:
        wachsende = lagen
    mib = 2 * wachsende * kv_koepfe * kopfdim * 1 / (1024.0 ** 2)  # 1 Byte: 8-Bit-Cache, Standing Rule
    quelle = ("ollama show -v: %d/%d Lagen volle Attention, %d KV-Koepfe, Kopfdim %d, 8-Bit-Cache"
              % (wachsende, lagen, kv_koepfe, kopfdim))
    obergrenze = kv_obergrenze_mib(lagen, alle_koepfe, kopfdim)
    return mib, quelle, obergrenze


def kv_architektur(res):
    if res["provider"] == "mlx-lokal":
        return kv_architektur_mlx(res["modelRef"])
    if res["provider"] == "ollama":
        return kv_architektur_ollama(res["modelRef"])
    return None


def kv_ollama_kunstname(reg, modelref):
    # Pruefer-Befund N2 (19.08.2026 abends): die Messstrecke traegt Ollama-KV-
    # Werte unter von Hand gebildeten Namen ein, die Herkunft, Laufzeit und
    # Quantisierung in EINEM String zusammenfassen (Beispiel aus
    # kv-bedarf.json: "qwen3-1.7b-ollama-q4km" fuer den echten modelRef
    # 'qwen3:1.7b') -- kein Aufrufer nennt das Modell je unter diesem
    # Kunstnamen, nur unter seinem echten modelRef mit Doppelpunkt-Tag. Ohne
    # diese Funktion trifft der exakte Schluesselvergleich oben nie, und die
    # frisch gemessene Zahl bleibt fuer immer unerreichbar -- "die Arbeit ist
    # da, sie ist nur nicht angeschlossen" (Pruefer, woertlich). Der feste
    # Namensteil "-ollama-" ist die einzige stabile Klammer der Konvention
    # (Modellname roh davor, Quantisierungskuerzel dahinter, das je nach
    # Laufzeit variiert); ':' wird auf '-' normalisiert, weil der Ollama-Tag
    # ihn traegt, der Dateiname aber keinen Doppelpunkt kennt. Bei mehreren
    # Treffern (z.B. verschiedene Quantisierungen desselben Modells) wird
    # deterministisch der alphabetisch erste genommen -- besser ein plausibler
    # Treffer als der alte, weit teurere Ersatzwert, aber ohne Anspruch,
    # zwischen mehreren Quantisierungen richtig zu raten.
    basis = modelref.replace(":", "-").lower()
    marker = basis + "-ollama-"
    treffer = sorted(k for k in reg if k.lower().startswith(marker))
    return treffer[0] if treffer else None


def kv_mib_pro_token(res):
    reg = kv_registry()
    kandidaten = []
    if res["provider"] == "mlx-lokal":
        basis = os.path.basename(res["modelRef"].rstrip("/"))
        kandidaten.append(basis)
        # Kleingeschrieben ZUSAETZLICH (2026-08-21): die Messstrecke traegt
        # jeden Schluessel klein (siehe kv_ollama_kunstname() daneben,
        # "':' wird auf '-' normalisiert" -- dieselbe Konvention), waehrend
        # ein MLX-Ordnername selbst Grossbuchstaben tragen kann (Beispiel:
        # 'Qwen3.8-27B-MTPLX-Optimized-Speed'). Ein reiner Exakt-Vergleich
        # verfehlt den gemessenen Eintrag dann selbst bei identischem Namen --
        # gefunden bei der Vorhersage-Ersetzung unten, wo genau dieser
        # gemischtschreibige Koerperpfad jetzt ankommt.
        if basis.lower() != basis:
            kandidaten.append(basis.lower())
    if res["provider"] == "ollama":
        kunstname = kv_ollama_kunstname(reg, res["modelRef"])
        if kunstname:
            kandidaten.append(kunstname)
    kandidaten += [res.get("alias"), res.get("id"), res["modelRef"]]
    gesehen = set()
    wert = quelle = None
    for k in kandidaten:
        if not k or k in gesehen:
            continue
        gesehen.add(k)
        eintrag = reg.get(k)
        if eintrag:
            wert = float(eintrag["mib_je_token"])
            quelle = "%s (wb-belegung kv, Schluessel '%s')" % (eintrag.get("herkunft", "?"), k)
            break

    # Architektur wird IMMER berechnet, wenn lesbar -- einmal, fuer die
    # Vorgabe (falls kein Registry-Treffer) UND fuer die Plausibilitaetsschranke
    # weiter unten (falls doch ein Treffer da war, siehe dort).
    arch = kv_architektur(res)

    if wert is None:
        if arch:
            arch_mib, arch_quelle, _ = arch
            wert = arch_mib * SICHERHEITSFAKTOR
            quelle = ("aus der Architektur hergeleitet (%s) x Sicherheitsfaktor %s"
                      % (arch_quelle, zahl(SICHERHEITSFAKTOR, 1)))
        else:
            wert = KV_ANNAHME_BODEN * SICHERHEITSFAKTOR
            quelle = ("Architektur nicht lesbar — Familien-Annahme (%d Lagen, %d KV-Koepfe, Kopfdim %d, "
                      "8-Bit-Cache = %s MiB/Token) x Sicherheitsfaktor %s"
                      % (ANNAHME_LAGEN, ANNAHME_KV_KOEPFE, ANNAHME_KOPFDIM,
                         zahl(KV_ANNAHME_BODEN, 4), zahl(SICHERHEITSFAKTOR, 1)))

    # Plausibilitaetsschranke (Anweisung des Nutzers 19.08.2026 abends): ein
    # Wert -- gemessen, hergeleitet oder angenommen --, der fuer DIESE
    # Architektur unmoeglich ist, wird nicht stillschweigend weitergerechnet.
    # Braucht selbst lesbare Architekturdaten; sind die nicht lesbar, bleibt
    # auch die Familien-Annahme oben ungeprueft (es gibt nichts, wogegen).
    if arch:
        obergrenze = arch[2]
        if wert > obergrenze:
            fail("KV-Bedarf %s MiB/Token fuer '%s' ist architektonisch unmoeglich (Obergrenze %s "
                 "MiB/Token: alle Lagen, alle Koepfe, kein Quantisierungsgewinn angenommen) — "
                 "verworfen statt stillschweigend benutzt. Herkunft des verworfenen Werts: %s"
                 % (zahl(wert, 4), res["id"], zahl(obergrenze, 4), quelle))
    return wert, quelle


