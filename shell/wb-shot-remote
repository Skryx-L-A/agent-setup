#!/bin/bash
# wb-shot-remote — fenstergenaue Aufnahme auf peer (KDE Plasma 6 / Wayland), vom Mac aus
# ausgeloest. Ruft das Gegenstueck `peer-shot` per SSH auf peer auf, holt NUR die
# entstandene PNG-Datei per SCP herueber und loescht sie danach auf peer wieder.
#
# Rule (der Nutzer, 2026-07-25): agents never record or screenshot the whole screen,
# and never move his focus. Die eigentliche Regel-Durchsetzung (kein Vollbild-
# Fallback, mehrdeutiges Muster bricht ab, kein Treffer bricht ab) sitzt in
# peer-shot selbst; dieses Skript reicht dessen Exitcodes unveraendert durch.
#
# GEAENDERT 2026-08-22, aber NUR auf dem Mac: Freigabe des Nutzers hat das
# Vollbild-Verbot fuer direkte `screencapture`-Aufrufe auf DIESER Maschine
# aufgehoben (regeln/aufnahmen.md, hooks/lib/screencapture_classify.py). Sie
# war ausdruecklich an "die Maschine" (Mac) gebunden. Fuer peer gilt die Regel
# oben unveraendert weiter -- peer-shot bekommt keinen Vollbild-Fallback, und
# dieses Skript aendert daran nichts.
#
#   wb-shot-remote <titel-muster> <ziel.png>
set -uo pipefail

REMOTE=peer
# Kein fester Nutzerpfad (Befund 2026-09-05): $HOME war der Nutzer der
# ABGELOESTEN Linux-Maschine; auf peer heisst er <user>, und der alte Pfad existiert
# dort nicht -- jede entfernte Aufnahme scheiterte damit. Das Werkzeug liegt im
# Home des Nutzers, mit dem ssh sich anmeldet; die Tilde loest die entfernte Shell auf.
REMOTE_TOOL='.local/bin/peer-shot'   # relativ zum Home des ssh-Nutzers, siehe CMD unten

usage() { echo "usage: wb-shot-remote <titel-muster> <ziel.png>" >&2; exit 1; }

[ $# -eq 2 ] || usage
PATTERN=$1
DEST=$2
REMOTE_TMP="/tmp/wb-shot-remote-$$-$RANDOM.png"

# FRIST (2026-08-20, dieselbe Fehlerklasse wie beim Beenden der App am
# selben Tag): keiner der drei ssh-Aufrufe hier trug bis heute eine Grenze --
# eine unerreichbare peer, oder ein Wayland/DBus-Aufruf in peer-shot selbst,
# der nie zurueckkommt, liess dieses Skript unbegrenzt haengen, mit ihm jeden
# Aufrufer (die App wartet synchron auf sein Ergebnis). ConnectTimeout deckt
# die Verbindung, `timeout` die gesamte Ausfuehrung -- eine echte Aufnahme
# braucht Sekunden, nicht Minuten, die Fristen unten sind grosszuegig genug.
#
# `timeout` fehlt auf manchen Mac-PATHs (kein coreutils, siehe run-all.sh fuer
# dieselbe Vorsicht) -- fehlt es, laeuft `ssh_mit_frist` ungebremst statt mit
# einem "command not found" abzubrechen; ConnectTimeout/BatchMode wirken so
# oder so.
TIMEOUT_BIN=""
command -v timeout >/dev/null 2>&1 && TIMEOUT_BIN="timeout"
ssh_mit_frist() {   # ssh_mit_frist <sekunden> <ssh-argumente...>
  local frist="$1"; shift
  if [ -n "$TIMEOUT_BIN" ]; then
    "$TIMEOUT_BIN" "$frist" ssh -o ConnectTimeout=8 -o BatchMode=yes "$@"
  else
    ssh -o ConnectTimeout=8 -o BatchMode=yes "$@"
  fi
}

# Das Werkzeug steht relativ zum Home, weil `printf %q` eine Tilde als Zeichen
# schuetzen wuerde und die entfernte Shell sie dann nicht mehr aufloest. ssh startet
# die Shell ohnehin im Home des Nutzers, also reicht der relative Pfad.
CMD=$(printf '%q %q %q' "$REMOTE_TOOL" "$PATTERN" "$REMOTE_TMP")
ssh_mit_frist 30 "$REMOTE" "$CMD"
rc=$?

if [ $rc -eq 124 ]; then
  echo "wb-shot-remote: nach 30s abgebrochen -- peer oder peer-shot antwortet nicht." >&2
  exit $rc
fi
if [ $rc -ne 0 ]; then
  exit $rc
fi

if ! scp -o ConnectTimeout=8 -o BatchMode=yes -q "$REMOTE:$REMOTE_TMP" "$DEST"; then
  echo "wb-shot-remote: scp fehlgeschlagen (Datei nicht entstanden oder Verbindung weg)." >&2
  ssh_mit_frist 10 "$REMOTE" "rm -f '$REMOTE_TMP'" >/dev/null 2>&1
  exit 1
fi

ssh_mit_frist 10 "$REMOTE" "rm -f '$REMOTE_TMP'"

echo "wb-shot-remote: aufgenommen -> $DEST ($(wc -c < "$DEST" | tr -d ' ') Bytes)"
