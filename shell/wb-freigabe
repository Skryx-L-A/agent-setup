                'Nichts in den Pane geschrieben.' % (pane, wo))
    fehl = r.stderr.decode('utf-8', 'replace').strip()[:200]
    if r.returncode == 4:
        return 'kein Hinweis -- Agent-Verkehr ist pausiert (wb-inbox: %s).' % fehl
    if r.returncode == 5:
        return ('kein Hinweis -- kein Weg ausserhalb der Eingabezeile (wb-inbox: %s). '
