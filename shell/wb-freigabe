def kuerzen(text, max_len=700, rand=300):
    # Voller Text bis max_len; darueber Anfang UND Ende, Mitte weg -- und die
    # Kuerzung als solche erkennbar (Vorfall 2026-08-10: ein bei 300 Zeichen
    # hart abgeschnittener Befehl endete mitten in `ls ~`, unbemerkbar).
    text = text or ''
    if len(text) <= max_len:
        return text
    fehlt = len(text) - 2 * rand
    return '%s\n    ...[%d Zeichen gekuerzt]...\n    %s' % (text[:rand], fehlt, text[-rand:])


