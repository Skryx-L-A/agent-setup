        f = subprocess.run([inbox_bin, 'finde', pane], capture_output=True, timeout=15)
    except (subprocess.TimeoutExpired, OSError) as e:
        return 'kein Hinweis -- wb-inbox "finde" antwortete nicht (%s).' % e
