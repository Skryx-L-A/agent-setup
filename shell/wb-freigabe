#!/bin/bash
# wb-freigabe — die EINE Stelle, die eine Rueckfrage freigibt.
#
#   wb-freigabe liste                     Was gerade auf eine Entscheidung wartet.
#   wb-freigabe erteilen [--ttl <sek>] [--schluessel <sha256>] [--index <n>|--alle]
#                        [--grund <text>] <pane> [grund]  Die wartende Frage freigeben.
#   wb-freigabe beleg                     Wie dieser Aufruf gemessen wird (Diagnose).
#   wb-freigabe zurueckziehen [<pane>]    Die EIGENE wartende Frage zuruecknehmen.
#   wb-freigabe warten <pane> --befehl-datei <pfad> [--cwd <dir>] [--max <sek>]
#                                         Blockieren, bis ueber GENAU diesen Wortlaut
#                                         entschieden ist. Erteilt nichts.
#                                         Exit 0 erteilt, 3 abgelehnt, 4 abgelaufen,
#                                         5 keine Frage offen, 6 noch offen (erneut rufen).
#
# WARTEN (29.09.2026, Vorgabe des Nutzers, woertlich: "wenn ich in zukunft über die
# workbench freigebe will ich den orchestrator/worker nicht selbst darüber informieren
# müssen dass ich die freigabe gegeben habe"). Der Rueckfrage-Text des Hooks
# (hooks/lib/ask_muster.py, deny_text) nennt diesen Aufruf woertlich, mit dem Pane und
# einer Datei, in die der Hook den Wortlaut gelegt hat. Der Agent beendet seinen Zug
# nicht mehr, er wartet darin. `warten` LIEST nur: Merker, Freigabedatei, Verlauf. Es
# misst keine Herkunft, legt keine Freigabe an, loescht keine und verbraucht keine --
# eine Freigabe erteilt weiterhin nur `erteilen` fuer einen gemessenen Menschen.
# Geschrieben wird allein eine Anmeldung unter guard-warten/ ("in diesem Pane wartet
# jemand"), damit `erteilen` weiss, dass es keinen Hinweis mehr schicken muss.
#
# ZURUECKZIEHEN (der Nutzer, 25.09.2026, Anlass eine Kundensitzung): eine ueberfluessige
# Rueckfrage (dort eine `sudo -n true`-Probe) sperrte den Pane fuer jeden anderen
# Wortlaut, bis sie nach rund fuenf Minuten ablief -- die AELTERE Frage gewinnt
# (hooks/bash-guard.py), und das mit Grund. `zurueckziehen` loescht den wartenden
# Merker, ERTEILT aber nichts; ein Fehlgriff faellt also auf die sichere Seite.
# Ein Agent darf nur die Frage seines eigenen Panes ($TMUX_PANE) zuruecknehmen,
# ein gemessener Mensch jede. Das Programmfenster bindet jede Freigabe ueber
# --schluessel an den gelesenen Wortlaut; ein Klick auf eine inzwischen
# zurueckgezogene Frage erteilt deshalb nichts.
#
# `--schluessel` bindet die Freigabe an DEN Eintrag, den der Erteilende gelesen hat:
# stimmt der Schluessel des wartenden Markers nicht damit ueberein, wird nichts
# erteilt. Das Programmfenster benutzt das, weil zwischen Anzeigen und Klicken ein
# anderer Befehl angeschlagen haben koennte -- eine Zustimmung zu etwas Ungelesenem
# ist der eine Fehler, den ein Freigabeweg nicht haben darf.
#
# MEHRDEUTIGKEIT (2026-08-10): versucht dieselbe Pane waehrend einer offenen Frage
# einen ANDEREN Wortlaut, bleibt die AELTERE Frage die einzige STEHENDE (siehe
# hooks/bash-guard.py) -- der neue Versuch landet nur im Verlauf. `erteilen` liest
# beides zusammen: liegt mehr als EIN Wortlaut vor, zaehlt das Werkzeug sie
# nummeriert auf und erteilt NICHTS, bis `--index <n>` sagt, welcher gemeint ist,
# oder `--alle` ausdruecklich ALLE freigibt. Der einfache Fall (nur ein Wortlaut)
# laeuft unveraendert.
#
# RUECKKANAL (03.09.2026, Wort des Nutzers: "ich will ... dass die Nachricht mit der
# Freigabe direkt an den Agent zurueckgeht"): `erteilen` schickt nach dem Schreiben
# des Zettels einen kurzen Hinweis in den Pane des Antragstellers -- ausschliesslich
# ueber `wb-pane-write` (dieselbe Stelle, die auch `wb-post` dafuer benutzt), nie mit
# einer Absende-Taste. Das ist NUR eine Benachrichtigung: sie erteilt nichts und
# aendert nichts an der Pruefung oben, wer freigeben darf. Lehnt `wb-pane-write darf`
# ab (z.B. ein Orchestrator-Pane), bleibt die Freigabe trotzdem gueltig -- der Hinweis
# unterbleibt dann und die Ausgabezeile "Rueckkanal: ..." sagt, warum.
#
# ERSETZT AM 29.09.2026 (Vorgabe des Nutzers, woertlich: "ich will nicht das bei der
# freigabe automatisch in den pane getippt wird, das kann nachrichten von mir
# abschneiden oder ungewollt mitsenden, das muss anders passieren, zum beispiel über
# den kommunikationskanal (oder einem ähnlichen) den die sitzungen untereinander
# nutzen"). Der Absatz oben ist die Herkunft; er gilt nicht mehr. Seitdem schreibt
# `erteilen` NIE in einen Pane -- kein Einfuegen, keine Taste, kein `wb-pane-write`.
# Der Hauptweg ist `warten` (oben): der Agent erfaehrt die Freigabe selbst. Der
# Rueckkanal ist nur noch fuer einen Agenten da, der NICHT wartet, und nimmt allein
# einen Weg, der nicht durch die Eingabezeile geht: die Sitzungs-Inbox (`wb-inbox
# sende`; zugestellt an der Zuggrenze oder sofort, wenn die Sitzung untaetig ist).
# Seit dem 29.09.2026 (Auftrag inbox-alle) erreicht `wb-inbox` jeden Harness mit
# belegtem Weg: Claude ueber den Socket, pi und opencode ueber ihre Datei-Inbox-Adapter,
# codex ueber `codex queue`. Ein Harness ohne Weg (wb-inbox Exit 5) bekommt keine
# Nachricht; fuer ihn traegt `warten`. Kein Hinweis geht hinaus, wenn die Freigabe beim Senden
# schon verbraucht ist (der Pane hat den Wortlaut ausgefuehrt) oder der Agent per
# `warten` davon schon weiss. Die Ausgabezeile "Rueckkanal: ..." sagt jedes Mal,
# welcher Weg genommen wurde, oder dass keiner genommen wurde, und warum.
#
# WARUM ES DIESES WERKZEUG GIBT (Durchsicht 2026-08-07, gemessen)
# Die Rueckfrage-Stufe haelt an, was weder harmlos noch verboten ist — `sudo`,
# `chmod -R`, `git push --force`, `npm publish` — und wartet auf einen Menschen.
# Eingeloest wurde ueber eine JSON-Datei in ~/.pi-workers/guard-grants/. Nur schrieb
# die niemand ausser der Freigabe-Ansicht — UND jedem Agenten, der die Regel gelesen
# hat: gemessen wurde, dass ein selbst geschriebener Freigabe-Zettel denselben
# angehaltenen Befehl durchlaufen laesst. Der Satz "eine Freigabe erteilt ein Mensch"
# war eine Erwartung, keine Pruefung.
#
# DIE HERKUNFT WIRD GEMESSEN, NICHT GEGLAUBT — dasselbe Prinzip wie in `wb-mensch`
# und `wb-pane-write`: Es gibt hier KEINEN Schalter, mit dem sich jemand zum Menschen
# erklaert. Gefragt wird `wb-mensch`, und dessen Positivpruefung haengt an Merkmalen,
# die ein Agent sich nicht anschreiben kann (steuerndes Terminal M1, oder das
# Programmfenster als nachgewiesener Ahne M2). Fehlt `wb-mensch`, gilt: kein Mensch.
# Die erteilte Freigabe traegt den Beleg mit und eine Signatur (HMAC) ueber genau die
# Werte, an die sie gebunden ist; `hooks/lib/ask_muster.py` prueft beides, bevor eine
# Freigabe zaehlt.
#
# DER SCHLUESSEL liegt neben den Freigaben (Modus 0600) und entsteht beim ersten
# Erteilen durch einen gemessenen Menschen. Ein Agent kommt an ihn nicht heran, ohne
# einen Befehl auszufuehren, den die Hook-Kette ablehnt (Guard `freigabe-pfad`).
#
# GRENZE, offen benannt (wie in wb-mensch): Als derselbe Benutzer gibt es kein
# Versteck, das gegen einen Agenten haelt, der seine Spuren aktiv verwischt. Was hier
# faellt, ist der gemessene Fall — der Zettel, den sich ein Agent selbst hinlegt.
set -uo pipefail

ABGELEHNT=77
PY=/usr/bin/python3

GRANTS="${AWB_GUARD_GRANTS_DIR:-$HOME/.pi-workers/guard-grants}"
BLOCKS="${AWB_GUARD_BLOCKS_DIR:-$HOME/.pi-workers/guard-blocks}"
# Derselbe Verlauf, den Hook und Programm schreiben (AWB_GUARD_LOG). Die Zeile
# entsteht dort, wo die Freigabe entsteht -- damit gibt es genau eine Stelle, an
# der eine gueltige Freigabe erscheint, und genau eine, die es aufschreibt.
VERLAUF="${AWB_GUARD_LOG:-$HOME/.pi-workers/guard-blocks.log}"
# Der Verlauf rotiert monatlich (hooks/lib/guard_log.py) und wird nur unter einer Sperre
# geschrieben. Geschrieben wird deshalb ueber `guard_log.py anhaengen` (Zeile auf stdin);
# fehlt das Modul, schreiben die Bloecke unten die Zeile wie frueher selbst, ohne Sperre --
# eine Zeile geht nie verloren. Suchweg wie bei wb-rolle: neben dem Skript im Repo, dann die
# ausgerollte Kopie. Den Pfad setzt dieses Skript selbst (ein Wert des Aufrufers wird
# ueberschrieben), und die Bloecke starten das Modul in einem eigenen Prozess, nie in dem,
# der den Schluessel der Freigaben liest.
WB_GUARD_LOG_PY=""
for kandidat in "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/hooks/lib/guard_log.py" \
                "$HOME/.claude/hooks/lib/guard_log.py"; do
    [ -f "$kandidat" ] && { WB_GUARD_LOG_PY="$kandidat"; break; }
done
export WB_GUARD_LOG_PY

CMD="${1:-liste}"

MENSCH_ART=""
MENSCH_GRUND=""
# M2 (Oberflaeche als Ahne) braucht WB_MENSCH_QUELLE und WB_APP_PID, und `env -i`
# loescht beide. Ohne diese Allowlist scheiterte seit dem 21.09. jeder Menschen-Nachweis
# ueber die Werkbank-App, sichtbar als "'--mensch' abgelehnt" beim Sitzungsstart (Befund 26.09.2026). Beide sind nur
# Behauptungen, die wb-mensch gegen seine echte Ahnenkette prueft -- dieselbe
# Allowlist wie in wb-pane-write; alle uebrige Aufruferumgebung bleibt weg.
M2_UMGEBUNG=()
if [ "${WB_MENSCH_QUELLE:-}" = oberflaeche ]; then
  case "${WB_APP_PID:-}" in ''|*[!0-9]*) ;; *) M2_UMGEBUNG=(WB_MENSCH_QUELLE=oberflaeche "WB_APP_PID=$WB_APP_PID") ;; esac
fi
messen() {
    local beleg
    if [ -x "$HOME/.local/bin/wb-mensch" ]; then
        beleg=$(/usr/bin/env -i HOME="$HOME" TMPDIR=/tmp PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
            ${M2_UMGEBUNG[@]+"${M2_UMGEBUNG[@]}"} "$HOME/.local/bin/wb-mensch" beleg 2>/dev/null)
    else
        MENSCH_ART=agent
        MENSCH_GRUND="wb-mensch am festen Pfad nicht gefunden — ohne Messung gilt: kein Mensch."
        return 1
    fi
    MENSCH_GRUND="${beleg#*$'\t'}"
    MENSCH_ART="${beleg%%$'\t'*}"
    [ "$MENSCH_ART" = mensch ]
}

# Die Herkunftsart, die in der Freigabe steht: das Programmfenster nennt sich so,
# ein Mensch am Terminal 'mensch'. Beides sind Messungen aus wb-mensch (M2/M1) --
# unterschieden wird an dessen Begruendung, nicht an einer Behauptung des Aufrufers.
herkunft_art() {
    case "$MENSCH_GRUND" in
        *Oberflaeche*|*M2*) printf 'oberflaeche' ;;
        *) printf 'mensch' ;;
    esac
}

ablehnen() {
    {
        printf 'wb-freigabe: ABGELEHNT — %s\n' "$1"
        printf '  Gemessen: %s (%s)\n' "$MENSCH_ART" "$MENSCH_GRUND"
        printf '  Eine Freigabe erteilt ein Mensch: am Terminal oder im Programmfenster.\n'
        printf '  Ein angehaltener Befehl wird wiederholt, nicht umgangen.\n'
    } >&2
    exit "$ABGELEHNT"
}

case "$CMD" in
    liste)
        "$PY" - "$BLOCKS" "$VERLAUF" <<'PY'
import json, os, sys

def kuerzen(text, max_len=700, rand=300):
    # Voller Text bis max_len; darueber Anfang UND Ende, Mitte weg -- und die
    # Kuerzung als solche erkennbar (Vorfall 2026-08-10: ein bei 300 Zeichen
    # hart abgeschnittener Befehl endete mitten in `ls ~`, unbemerkbar).
    text = text or ''
    if len(text) <= max_len:
        return text
    fehlt = len(text) - 2 * rand
    return '%s\n      ...[%d Zeichen gekuerzt]...\n      %s' % (text[:rand], fehlt, text[-rand:])

def andere_wortlaute(verlauf_pfad, pane, primaer_ts, primaer_command):
    # Wortlaute, die dieselbe Pane waehrend dieser offenen Frage ebenfalls
    # versucht hat -- bash-guard.py protokolliert sie als
    # 'muster-anderer-wortlaut-wartend', OHNE einen eigenen Merker anzulegen.
    treffer, gesehen = [], {primaer_command}
    try:
        with open(verlauf_pfad, 'r', encoding='utf-8') as fh:
            for zeile in fh:
                zeile = zeile.strip()
                if not zeile:
                    continue
                try:
                    e = json.loads(zeile)
                except ValueError:
                    continue
                if not isinstance(e, dict) or e.get('guard') != 'muster-anderer-wortlaut-wartend':
                    continue
                if str(e.get('pane', '')) != pane or str(e.get('ts', '')) < primaer_ts:
                    continue
                cmd = e.get('command', '') or ''
                if cmd in gesehen:
                    continue
                gesehen.add(cmd)
                treffer.append(cmd)
    except OSError:
        pass
    return treffer

d, verlauf = sys.argv[1], sys.argv[2]
try:
    namen = sorted(os.listdir(d))
except OSError:
    print('Keine wartenden Rueckfragen (%s gibt es nicht).' % d)
    raise SystemExit(0)
gefunden = 0
for name in namen:
    if not name.endswith('.json') or name.startswith('.'):
        continue
    try:
        with open(os.path.join(d, name), 'r', encoding='utf-8') as fh:
            e = json.load(fh)
    except (OSError, ValueError):
        continue
    if not isinstance(e, dict) or e.get('wartet') is not True:
        continue
    gefunden += 1
    pane = str(e.get('pane', '') or '')
    command = e.get('command', '') or ''
    print('Pane %s  (%s)' % (pane or '?', e.get('muster', 'ohne Muster')))
    print('  Befehl: %s' % kuerzen(command))
    print('  Verzeichnis: %s' % (e.get('cwd', '') or ''))
    print('  Wartet seit: %s, laeuft ab: %s' % (e.get('ts', '?'), e.get('expires_ts', '?')))
    alt = andere_wortlaute(verlauf, pane, str(e.get('ts', '') or ''), command)
    if alt:
        print('  MEHRDEUTIG -- %d weitere(r) Wortlaut(e) derselben Pane wurden ebenfalls '
              'angehalten:' % len(alt))
        for i, cmd in enumerate(alt, start=2):
            print('    [%d] %s' % (i, kuerzen(cmd)))
        print('  Freigeben: wb-freigabe erteilen %s "<grund>" --index <1..%d>  (oder --alle '
              'fuer ALLE auf einmal)' % (pane, len(alt) + 1))
    else:
        print('  Freigeben: wb-freigabe erteilen %s "<grund>"' % pane)
if not gefunden:
    print('Keine wartende Rueckfrage.')
PY
        exit 0 ;;
    beleg)
        messen || true
        printf 'art\t%s\ngrund\t%s\nherkunft\t%s\nfreigaben\t%s\n' \
            "$MENSCH_ART" "$MENSCH_GRUND" "$(herkunft_art)" "$GRANTS"
        exit 0 ;;
    zurueckziehen)
        ZIEL="${2:-${TMUX_PANE:-}}"
        if [ -z "$ZIEL" ]; then
            echo "wb-freigabe: zurueckziehen braucht einen Pane (ohne TMUX_PANE: ausdruecklich nennen)." >&2
            exit 2
        fi
        # Fremder Pane nur fuer einen gemessenen Menschen. Ein Agent ohne TMUX_PANE
        # kann keinen eigenen Pane belegen und nimmt deshalb nichts zurueck.
        if [ "$ZIEL" != "${TMUX_PANE:-}" ]; then
            messen || ablehnen "ein Agent nimmt nur die Frage seines eigenen Panes zurueck (${TMUX_PANE:-kein TMUX_PANE}), nicht die von $ZIEL."
        fi
        "$PY" - "$BLOCKS" "$VERLAUF" "$ZIEL" <<'PY'
import json, os, re, subprocess, sys, time
def verlauf_anhaengen(pfad, zeile):
    """Eine Zeile an den Verlauf: ueber guard_log.py (Sperre, Monatsrotation), sonst direkt wie frueher."""
    helfer = os.environ.get('WB_GUARD_LOG_PY', '')
    if helfer:
        try:
            if subprocess.run([sys.executable, '-I', helfer, 'anhaengen', '--log', pfad], input=zeile.encode('utf-8'),
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10).returncode == 0:
                return
        except (OSError, subprocess.SubprocessError):
            pass
    os.makedirs(os.path.dirname(pfad) or '.', exist_ok=True)
    with open(pfad, 'a', encoding='utf-8') as fh:
        fh.write(zeile + '\n')

d, verlauf, pane = sys.argv[1], sys.argv[2], sys.argv[3]
pfad = os.path.join(d, re.sub(r'[^A-Za-z0-9_.-]', '_', pane) + '.json')
try:
    with open(pfad, 'r', encoding='utf-8') as fh:
        merker = json.load(fh)
except (OSError, ValueError):
    print('wb-freigabe: fuer %s wartet keine Rueckfrage -- nichts zurueckzunehmen.' % pane)
    raise SystemExit(0)
if not isinstance(merker, dict) or merker.get('wartet') is not True:
    print('wb-freigabe: der Eintrag fuer %s wartet nicht auf eine Freigabe -- nichts zurueckzunehmen.' % pane)
    raise SystemExit(0)
try:
    os.remove(pfad)
except OSError as e:
    sys.stderr.write('wb-freigabe: Merker %s liess sich nicht entfernen: %s\n' % (pfad, e))
    raise SystemExit(1)
try:
    verlauf_anhaengen(verlauf, json.dumps({
        'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
        'guard': 'muster-zurueckgezogen',
        'reason': 'Rueckfrage vom Antragsteller zurueckgezogen (%s), nichts erteilt.' % merker.get('muster', ''),
        'command': str(merker.get('command', ''))[:2000], 'cwd': str(merker.get('cwd', '')),
        'session_id': str(merker.get('session_id', '')), 'pane': pane,
    }, ensure_ascii=False))
except OSError:
    pass
print('wb-freigabe: Rueckfrage fuer %s zurueckgezogen, nichts erteilt: %s' % (pane, str(merker.get('command', ''))[:200]))
PY
        exit $? ;;
    warten)
        # Kein messen(), kein Schluesselanlegen, kein Schreiben in guard-grants: dieser
        # Zweig darf von JEDEM gerufen werden, auch vom angehaltenen Agenten selbst,
        # und verleiht deshalb nichts (Negativtest in test-freigabe-warten.sh).
        shift
        W_PANE=""; W_DATEI=""; W_CWD="$PWD"; W_MAX=100
        while [ $# -gt 0 ]; do
            case "$1" in
                --befehl-datei) W_DATEI="${2:?Pfad fehlt nach --befehl-datei}"; shift 2 ;;
                --cwd) [ $# -ge 2 ] || { echo "wb-freigabe: nach --cwd fehlt das Verzeichnis." >&2; exit 2; }
                       W_CWD="$2"; shift 2 ;;
                --max) W_MAX="${2:?Sekunden fehlen nach --max}"; shift 2 ;;
                -*) echo "wb-freigabe: warten kennt '$1' nicht." >&2; exit 2 ;;
                *) [ -z "$W_PANE" ] || { echo "wb-freigabe: warten nimmt genau einen Pane." >&2; exit 2; }
                   W_PANE="$1"; shift ;;
            esac
        done
        [ -n "$W_PANE" ] || { echo "wb-freigabe: warten braucht einen Pane." >&2; exit 2; }
        [ -n "$W_DATEI" ] || { echo "wb-freigabe: warten braucht --befehl-datei <pfad> (die Datei nennt der Rueckfrage-Text)." >&2; exit 2; }
        case "$W_MAX" in ''|*[!0-9]*) echo "wb-freigabe: --max braucht eine Zahl in Sekunden." >&2; exit 2 ;; esac
        exec "$PY" - "$BLOCKS" "$GRANTS" "$VERLAUF" "$W_PANE" "$W_DATEI" "$W_CWD" "$W_MAX" <<'PY'
import calendar, hashlib, hmac, json, os, re, sys, time

ERTEILT, ABGELEHNT, ABGELAUFEN, NICHTS_OFFEN, NOCH_OFFEN = 0, 3, 4, 5, 6
MAX_TTL = 900          # wie ask_muster.MAX_TTL_SEKUNDEN
OBERGRENZE = 300       # ein Aufruf wartet hoechstens die uebliche Frist einer Frage
TAKT = 0.5

blocks, grants, verlauf, pane, datei, cwd, max_roh = sys.argv[1:8]
try:
    with open(datei, 'r', encoding='utf-8') as fh:
        command = fh.read()
    datei_zeit = os.stat(datei).st_mtime
except OSError as e:
    sys.stderr.write('wb-freigabe warten: Befehlsdatei nicht lesbar (%s): %s\n' % (datei, e))
    raise SystemExit(2)
if not command:
    sys.stderr.write('wb-freigabe warten: Befehlsdatei %s ist leer.\n' % datei)
    raise SystemExit(2)

sicher = re.sub(r'[^A-Za-z0-9_.-]', '_', pane)
merker_pfad = os.path.join(blocks, sicher + '.json')
schluessel = hashlib.sha256('\x00'.join([pane, cwd, command]).encode('utf-8')).hexdigest()
freigabe_pfad = os.path.join(grants, schluessel + '.json')
key_datei = os.path.join(os.path.dirname(os.path.normpath(grants)), '.freigabe-schluessel')
warten_dir = os.path.join(os.path.dirname(os.path.normpath(blocks)), 'guard-warten')
anmeldung = os.path.join(warten_dir, sicher + '.warten.json')
start = time.time()
frist = start + max(1, min(int(max_roh), OBERGRENZE))


def als_zeit(wert):
    try:
        return calendar.timegm(time.strptime(str(wert), '%Y-%m-%dT%H:%M:%SZ'))
    except (ValueError, TypeError):
        return None


def stempel(t):
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(t))


def json_lesen(pfad):
    try:
        with open(pfad, 'r', encoding='utf-8') as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def anmelden(ergebnis):
    # Die EINZIGE Datei, die `warten` schreibt -- ausserhalb von guard-grants.
    try:
        os.makedirs(warten_dir, exist_ok=True)
        tmp = anmeldung + '.%d.tmp' % os.getpid()
        with open(tmp, 'w', encoding='utf-8') as fh:
            json.dump({'pid': os.getpid(), 'pane': pane, 'schluessel': schluessel,
                       'start_ts': stempel(start), 'ergebnis': ergebnis,
                       'ts': stempel(time.time())}, fh)
        os.replace(tmp, anmeldung)
    except OSError:
        pass


def freigabe_gilt():
    """Liegt fuer GENAU diesen Wortlaut eine gueltige Freigabe? Nur lesen --
    dieselben Pruefungen wie ask_muster.freigabe_einloesen, aber ohne zu
    loeschen: einloesen tut allein der Hook, beim Wiederholen des Befehls."""
    e = json_lesen(freigabe_pfad)
    if e is None:
        return False
    if (str(e.get('command', '')) != command or str(e.get('pane', '')) != pane
            or str(e.get('cwd', '')) != cwd):
        return False
    jetzt = time.time()
    erteilt, ablauf = als_zeit(e.get('granted_ts')), als_zeit(e.get('expires_ts'))
    if ablauf is None or jetzt > ablauf or erteilt is None or jetzt > erteilt + MAX_TTL:
        return False
    h = e.get('herkunft')
    if not isinstance(h, dict) or h.get('art') not in ('mensch', 'oberflaeche') \
            or not str(h.get('beleg', '')).strip():
        return False
    try:
        with open(key_datei, 'r', encoding='utf-8') as fh:
            geheim = fh.read().strip()
    except OSError:
        return False
    if not geheim:
        return False
    roh = '\x00'.join([str(e.get('schluessel', '')), pane, cwd, command,
                       str(e.get('granted_ts', '')), str(e.get('expires_ts', '')),
                       str(h.get('art', '')), str(h.get('beleg', ''))])
    erwartet = hmac.new(geheim.encode('utf-8'), roh.encode('utf-8'), hashlib.sha256).hexdigest()
    return hmac.compare_digest(erwartet, str(h.get('sig', '')))


def entscheidung_im_verlauf(seit):
    """'abgelehnt' / 'zurueckgezogen' fuer diesen Pane und Wortlaut, sonst None."""
    kurz = command[:2000]
    try:
        with open(verlauf, 'r', encoding='utf-8') as fh:
            zeilen = fh.readlines()
    except OSError:
        return None
    for zeile in reversed(zeilen[-2000:]):
        try:
            e = json.loads(zeile)
        except ValueError:
            continue
        if not isinstance(e, dict) or str(e.get('pane', '')) != pane:
            continue
        if str(e.get('ts', '')) < seit:
            break
        if str(e.get('command', '')) != kurz:
            continue
        if e.get('guard') == 'muster-abgelehnt':
            return 'abgelehnt'
        if e.get('guard') == 'muster-zurueckgezogen':
            return 'zurueckgezogen'
    return None


