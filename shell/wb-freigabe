    # oder erfaehrt es in weniger als einer Sekunde -- eine zweite Nachricht kaeme spaeter
    # an als die Freigabe und staende dann als veralteter Hinweis im Gespraech.
    anm_pfad = os.path.join(os.path.dirname(os.path.normpath(blocks)), 'guard-warten',
                            sicher + '.warten.json')
