    if e["weg"] == "claude-socket":
        d = e["sitzung"]
        sys.stdout.write("%s\t%s\n" % (d.get("status", ""), d.get("statusUpdatedAt", "")))
        return 0
    seit = (e.get("anmeldung") or {}).get("seit", "")
    sys.stdout.write("%s\t%s\n" % (e.get("status", "") or "unbekannt", seit))
    return 0


def cmd_einrichten(rest):
    """Den Adapter eines Harness an den Ort legen, von dem der Harness ihn laedt.
    Idempotent; eine fremde Datei am Ziel wird nie ueberschrieben."""
    if not rest:
        fehler("Aufruf: wb-inbox einrichten <harness> [--home <dir>]")
        return 2
    hid, rest = rest[0], rest[1:]
    home = None
    if rest[:1] == ["--home"] and len(rest) == 2:
        home = os.path.abspath(rest[1])
    elif rest:
        fehler("wb-inbox einrichten: unbekanntes Argument '%s'." % rest[0])
        return 2
    block = inbox_block(hid)
    weg = block.get("weg") or ""
    if weg != "datei":
        if weg:
            sys.stdout.write("%s: Weg '%s' braucht keinen Adapter — nichts einzurichten.\n" % (hid, weg))
            return 0
        fehler("%s: %s" % (hid, block.get("grund") or "kein Zustellweg eingetragen."))
        return EXIT_KEIN_WEG
    e = block.get("einrichten") or {}
    quelle = os.path.join(HIER, "inbox", str(e.get("quelle") or ""))
    ziel = str(e.get("ziel") or "")
    if not e.get("quelle") or not ziel or not os.path.isfile(quelle):
        fehler("%s: Adapterquelle '%s' oder Ziel fehlt (Registry inbox.einrichten)." % (hid, quelle))
        return 1
    if ziel.startswith("~/"):
        ziel = os.path.join(home or os.path.expanduser("~"), ziel[2:])
    with open(quelle, encoding="utf-8") as f:
        inhalt = f.read()
    if os.path.exists(ziel):
        try:
            with open(ziel, encoding="utf-8") as f:
                alt = f.read()
        except OSError as ex:
            fehler("%s nicht lesbar (%s) — nichts geschrieben." % (ziel, ex))
            return 1
        if alt == inhalt:
            sys.stdout.write("%s: Adapter ist aktuell (%s).\n" % (hid, ziel))
            return 0
        if "wb-inbox einrichten" not in alt[:600]:
            fehler("%s: am Ziel %s liegt eine fremde Datei — nichts ueberschrieben." % (hid, ziel))
            return 1
    os.makedirs(os.path.dirname(ziel), exist_ok=True)
    tmp = "%s.wb-inbox.%d.tmp" % (ziel, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(inhalt)
    os.chmod(tmp, 0o644)
    os.rename(tmp, ziel)
    sys.stdout.write("%s: Adapter geschrieben nach %s — wirkt ab dem naechsten Start.\n" % (hid, ziel))
    return 0


def cmd_wege(rest):
    harnesses = registry_harnesses()
    ids = list(harnesses) or list(EINGEBAUT)
    zeilen = []
    for hid in ids:
        b = inbox_block(hid, harnesses)
        quelle = "registry" if isinstance((harnesses.get(hid) or {}).get("inbox"), dict) else (
            "eingebaut" if hid in EINGEBAUT else "keiner")
        zeilen.append({"harness": hid, "weg": b.get("weg") or "", "grund": b.get("grund") or "",
                       "quelle": quelle})
    if "--json" in rest:
        sys.stdout.write(json.dumps(zeilen, ensure_ascii=False) + "\n")
        return 0
    for z in zeilen:
        sys.stdout.write("%-14s %-14s %s\n" % (z["harness"], z["weg"] or "-", z["grund"] or z["quelle"]))
    return 0


def jetzt_iso():
    roh = os.environ.get("WB_TRAEGER_JETZT", "").strip()
    if roh:
        d = datetime.datetime.fromisoformat(roh[:-1] + "+00:00" if roh.endswith("Z") else roh)
        if d.tzinfo is None:
            d = d.replace(tzinfo=datetime.timezone.utc)
        return d.astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def vorrat_bestimmen(base=None, vorrat_override=None):
    """--vorrat, sonst WB_VORRAT, sonst <base oder $HOME>/.claude/workbench/vorrat
    -- dieselbe Regel wie in wb-traeger (kontext_bauen), damit beide denselben
    Pausenschalter sehen."""
    if vorrat_override:
        return os.path.abspath(vorrat_override)
    env = os.environ.get("WB_VORRAT")
    if env:
        return os.path.abspath(env)
    wurzel = os.path.abspath(base) if base else os.path.expanduser("~")
    return os.path.join(wurzel, ".claude", "workbench", "vorrat")


def pause_datei(vorrat):
    return os.path.join(vorrat, ".agentverkehr-pause")


def pause_lesen(vorrat):
    pfad = pause_datei(vorrat)
    if not os.path.isfile(pfad):
        return None
    try:
        with open(pfad, encoding="utf-8") as f:
            daten = json.load(f)
        if isinstance(daten, dict):
            return {"seit": daten.get("seit"), "grund": daten.get("grund") or None}
    except (OSError, json.JSONDecodeError):
        pass
    return {"seit": None, "grund": None}


def cmd_pause_an(vorrat, grund):
    os.makedirs(vorrat, exist_ok=True)
    pfad = pause_datei(vorrat)
    inhalt = json.dumps({"seit": jetzt_iso(), "grund": grund or None}, ensure_ascii=False) + "\n"
    with open(pfad, "w", encoding="utf-8") as f:
        f.write(inhalt)
    os.chmod(pfad, 0o600)
    sys.stdout.write("Agent-Verkehr pausiert.\n")
    return 0


def cmd_pause_aus(vorrat):
    try:
        os.unlink(pause_datei(vorrat))
    except FileNotFoundError:
        pass
    sys.stdout.write("Agent-Verkehr offen.\n")
    return 0


def cmd_pause_status(vorrat, als_json):
    pause = pause_lesen(vorrat)
    if als_json:
        if pause is None:
            sys.stdout.write(json.dumps({"aktiv": False}, ensure_ascii=False) + "\n")
        else:
            sys.stdout.write(json.dumps(
                {"aktiv": True, "seit": pause.get("seit"), "grund": pause.get("grund")},
                ensure_ascii=False) + "\n")
        return 0
    if pause is None:
        sys.stdout.write("Agent-Verkehr: offen\n")
        return 0
    teile = ["pausiert"]
    if pause.get("seit"):
        teile.append("seit %s" % pause["seit"])
    if pause.get("grund"):
        teile.append("(%s)" % pause["grund"])
    sys.stdout.write("Agent-Verkehr: %s\n" % " ".join(teile))
    return 0


def cmd_pause(rest):
    if not rest:
        fehler("Aufruf: wb-inbox pause an|aus|status [--base <dir>] [--vorrat <dir>] "
               "[--grund <text>] [--json]")
        return 2
    aktion, rest = rest[0], rest[1:]
    base = vorrat_override = grund = None
    als_json = False
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--base" and i + 1 < len(rest):
            base = rest[i + 1]; i += 2; continue
        if a == "--vorrat" and i + 1 < len(rest):
            vorrat_override = rest[i + 1]; i += 2; continue
        if a == "--grund" and i + 1 < len(rest):
            grund = rest[i + 1]; i += 2; continue
        if a == "--json":
            als_json = True; i += 1; continue
        fehler("wb-inbox pause: unbekanntes Argument '%s'." % a)
        return 2
    vorrat = vorrat_bestimmen(base, vorrat_override)
    if aktion == "an":
        return cmd_pause_an(vorrat, grund)
    if aktion == "aus":
        return cmd_pause_aus(vorrat)
    if aktion == "status":
        return cmd_pause_status(vorrat, als_json)
    fehler("wb-inbox pause: '%s' unbekannt (an|aus|status)." % aktion)
    return 2


def cmd_sende(pane, datei):
    vorrat = vorrat_bestimmen()
    pause = pause_lesen(vorrat)
    # Die Herkunft wird seit 10.10.2026 bei jeder Sendung gemessen: sie steht sichtbar
    # ueber jedem Text (Abschnitt HERKUNFT), und der Pausenschalter liest dieselbe Klasse.
    h = herkunft(pane, vorrat)
    klasse = h["klasse"]
    if pause is not None:
        if klasse in ABSENDER_GEBLOCKT:
            teile = ["zurückgehalten — Agent-Verkehr ist pausiert (Absender-Klasse '%s')" % klasse]
            if pause.get("seit"):
                teile.append("seit %s" % pause["seit"])
            if pause.get("grund"):
                teile.append("(%s)" % pause["grund"])
            fehler(" ".join(teile) + ".")
            return 4
    # Eine SCHLAFENDE Sitzung (wb-schlaf, 25.09.2026) hat keinen Socket: erst wecken,
    # dann zustellen. Gilt fuer jeden Harness; hier ist es der Claude-Weg.
    if tmux_feld(pane, "#{@wb_schlaeft}").strip():
        schlaf = os.path.join(os.path.expanduser("~"), ".local", "bin", "wb-schlaf")
        umg = dict(os.environ)
        if TMUX_SOCKET:
            umg["WB_TMUX_SOCKET"] = TMUX_SOCKET
        try:
            subprocess.run([schlaf, "wecken", pane, "--warten", "120"], env=umg,
                           capture_output=True, text=True, timeout=150)
        except Exception as e:
            fehler("%s schlief, Wecken gescheitert: %s" % (pane, e))
            return 1
    # Welcher Weg? Allein nach dem, was unter dem Pane wirklich laeuft. Die Riegel
    # oben (Pausenschalter, Absender-Klasse) und in empfaenger() (-L/--socket, --pid,
    # Ahnenreihe) gelten fuer jeden Weg gleich.
    e = empfaenger(pane)
    if not e:
        _kein_empfaenger(pane)
        return 1
    if not e.get("weg"):
        _kein_weg(pane, e)
        return EXIT_KEIN_WEG
    if e["weg"] != "claude-socket":
        try:
            text = open(datei, encoding="utf-8").read()
        except Exception as ex:
            fehler("Auftragsdatei nicht lesbar (%s): %s" % (datei, ex))
            return 1
        if not text.strip():
            fehler("Auftragsdatei ist leer — nichts gesendet.")
            return 1
        text = herkunft_kopf(h, text)
        if e["weg"] == "datei":
            return datei_senden(e["anmeldung"], text, klasse, h)
        if e["weg"] == "codex-queue":
            return codex_senden(e["ziel"], text, registry_harnesses(), pane)
        fehler("Weg '%s' ist diesem Werkzeug unbekannt — nichts gesendet." % e["weg"])
        return EXIT_KEIN_WEG
    d = e["sitzung"]
    pid = d["pid"]
    sock = d["messagingSocketPath"]
    token = peer_token(pid)
    if not token:
        fehler("Sitzung %d hat keine lesbare Schluesseldatei — ohne sie wuerde die "
               "Nachricht als unbekannter Absender ankommen und angehalten." % pid)
        return 1
    try:
        text = open(datei, encoding="utf-8").read()
    except Exception as e:
        fehler("Auftragsdatei nicht lesbar (%s): %s" % (datei, e))
        return 1
    if not text.strip():
        fehler("Auftragsdatei ist leer — nichts gesendet.")
        return 1
    text = herkunft_kopf(h, text)

    # Tafel-Meldung (Abschnitt TAFEL-MELDUNGEN): nie in einen Held-Dialog. Bezeugt wird nur, was
    # zum gemessenen Modus des Empfaengers passt; sonst die Claude-Datei-Inbox, wenn ihr Hook in
    # dieser Sitzung belegt laeuft. Ohne belegten Hook bleibt es beim bisherigen Weg.
    klasse_modus = rechtemodus()
    if aus_tafel():
        art, wert = tafel_bezeugung(d, klasse_modus)
        if art == "modus" and UMSCHLAG not in text.lower():
            klasse_modus = wert
        else:
            grund = wert if art == "datei" else "Umschlagname im Text"
            if claude_hook_aktiv(d):
                return claude_datei_senden(d, text, h, grund)
            # Ohne dialogfreien Weg wird NICHT zugestellt (Nachtrag 1, der Nutzer 11.10.: "es soll
            # niemand den Pane versperren"); die Tafel vermerkt es im Verlauf und in der Gruppe.
            fehler("Tafel-Meldung an %s NICHT zugestellt: kein dialogfreier Weg (%s; Einspiel-Hook in "
                   "dieser Sitzung nicht belegt). Claude haelte sie an." % (pane, grund))
            return EXIT_KEIN_WEG

    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(sock)
    except OSError as e:
        fehler("Socket %s nicht erreichbar (%s) — die Sitzung ist vermutlich neu "
               "gestartet und die Adresse tot." % (sock, e))
        return 1

    # Wer haengt wirklich am anderen Ende? Ohne Messung keine Zustellung.
    gegen = peer_pid(s)
    if gegen != pid:
        s.close()
        fehler("am Socket %s haengt Prozess %s, erwartet war %d — nichts gesendet."
               % (sock, gegen if gegen is not None else "nicht pruefbar", pid))
        return 1
    pane_pid = tmux_feld(pane, "#{pane_pid}")
    if not pane_pid.isdigit() or not ahnenreihe(pid, int(pane_pid)):
        s.close()
        fehler("Sitzung %d ist kein belegter Nachfahre von Pane %s — nichts gesendet." % (pid, pane))
        return 1

    # Rechtemodus der sendenden Sitzung bezeugen, wenn er belegt ist (Abschnitt
    # RECHTEMODUS im Kopf); sonst geht der Text wie bisher ohne Umschlag.
    inhalt = mit_umschlag(text, klasse_modus)
    if inhalt is text:
        klasse_modus = None
    zeilen = [
        json.dumps({"type": "auth", "token": token}),
        json.dumps({"type": "user", "message": {"role": "user", "content": inhalt}}),
    ]
    try:
        s.sendall(("\n".join(zeilen) + "\n").encode("utf-8"))
    except OSError as e:
        s.close()
        fehler("Schreiben in %s fehlgeschlagen: %s" % (sock, e))
        return 1
    finally:
        try:
            s.close()
        except Exception:
            pass

    sys.stdout.write("weg=claude-socket: in die Inbox von '%s' (pid %d%s, Herkunft: %s) geschrieben: %s\n" % (
        d.get("name", "?"), pid,
        ", Rechtemodus bezeugt: %s" % klasse_modus if klasse_modus else "",
        "Auftrag" if h["auftrag"] else "Information", sock))
    return 0


def main(argv):
    global TMUX_SOCKET, NUR_PID, ABSENDER
    global TAFEL_HALTER
    while argv and argv[0] in ("-L", "--socket", "--pid", "--absender"):
        if len(argv) < 2:
            fehler("nach %s fehlt der Wert." % argv[0])
            return 2
        if argv[0] == "--pid":
            if not argv[1].isdigit():
                fehler("--pid erwartet eine Zahl, nicht '%s'." % argv[1])
                return 2
            NUR_PID = int(argv[1])
        elif argv[0] == "--absender":
            if argv[1] not in ABSENDER_KLASSEN:
                fehler("--absender kennt '%s' nicht (erlaubt: %s)." % (argv[1], ", ".join(ABSENDER_KLASSEN)))
                return 2
            ABSENDER = argv[1]
        else:
            TMUX_SOCKET = argv[1]
        argv = argv[2:]
    if not argv or argv[0] in ("-h", "--help", "--hilfe"):
        sys.stdout.write(__doc__)
        return 0
    befehl = argv[0]
    if befehl == "finde" and len(argv) == 2:
        return cmd_finde(argv[1])
    if befehl == "status" and len(argv) == 2:
        return cmd_status(argv[1])
    if befehl == "transcript" and len(argv) == 2:
        return cmd_transcript(argv[1])
    if befehl == "sende" and len(argv) == 5 and argv[3] == "--tafel-halter":
        # Hinten angehaengt, damit Aufrufer-Attrappen mit festen Positionen ($2 Server, $4 Pane,
        # $5 Datei) unveraendert lesen. Wirkt nur mit wb-tafel als gemessenem Ahnen.
        if not re.fullmatch(r"[0-9A-Fa-f-]{8,64}:(bypass|prompting)", argv[4]):
            fehler("--tafel-halter erwartet <sessionId>:bypass|prompting, nicht '%s'." % argv[4])
            return 2
        TAFEL_HALTER = argv[4]
        return cmd_sende(argv[1], argv[2])
    if befehl == "sende" and len(argv) == 3:
        return cmd_sende(argv[1], argv[2])
    if befehl == "codex-queue" and len(argv) in (2, 3) and argv[2:] in ([], ["--start"]):
        return cmd_codex_queue(argv[1], argv[2:] == ["--start"])
    if befehl == "dialog" and len(argv) == 2:
        name = codex_dialog(argv[1])
        if not name:
            return 1
        sys.stdout.write("%s\n" % name)
        return 0
    if befehl == "absender-pane" and len(argv) == 1:
        von = absender_pane()
        if not von:
            return 1
        sys.stdout.write("%s\n" % von)
        return 0
    if befehl == "herkunft" and len(argv) == 2:
        h = herkunft(argv[1], vorrat_bestimmen())
        sys.stdout.write("%s\t%s\t%s\t%s\n" % ("auftrag" if h["auftrag"] else "information",
                                                h["klasse"], h["pane"] or "-", h["spawner"] or "-"))
        return 0
    if befehl == "pause":
        return cmd_pause(argv[1:])
    if befehl == "einrichten":
        return cmd_einrichten(argv[1:])
    if befehl == "wege":
        return cmd_wege(argv[1:])
    fehler("Aufruf: wb-inbox finde|status|transcript|dialog <pane> "
           "| wb-inbox [--absender <klasse>] sende <pane> <textdatei> "
           "| wb-inbox [--absender <klasse>] herkunft <pane> | wb-inbox absender-pane "
           "| wb-inbox einrichten <harness> [--home <dir>] | wb-inbox wege [--json] "
           "| wb-inbox pause an|aus|status [--base <dir>] [--vorrat <dir>] [--grund <text>] [--json]")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
