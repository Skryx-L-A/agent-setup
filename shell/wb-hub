#!/bin/sh
"true" '''\'
# Interpreter-Suche wie wb-modell-proxy: erster Treffer ab Python 3.14 gewinnt, sonst Exit 2.
for p in python3.14 python3.15 python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  command -v "$p" >/dev/null 2>&1 || continue
  "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 14) else 1)' >/dev/null 2>&1 || continue
  exec "$p" "$0" "$@"
done
echo "wb-hub: braucht Python 3.14 oder neuer, keins gefunden (PATH, Homebrew, /usr/bin)." >&2
exit 2
'''
# wb-hub -- ein MCP-Endpunkt je Maschine fuer alle Harnesses (Streamable HTTP auf 127.0.0.1).
# Duenner Einstieg; Vertrag, Schutz und Umgebungsvariablen stehen in wb_hub_kern.py.
# Alles ausser `serve` (Bruecke, Kurzaufrufe, Token-Kopf) steht in wb_hub_cli.py.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import wb_hub_kern  # noqa: E402

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] != "serve":
        import wb_hub_cli  # noqa: E402
        sys.exit(wb_hub_cli.main(sys.argv))
    sys.exit(wb_hub_kern.main(sys.argv))
