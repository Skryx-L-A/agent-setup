def frei_pruefen(cfg, p, menge, me, z):
    """(ja|None, grund, halter, wartende_vor_mir, eigene_wartend)."""
    eigen = eigene_wartende(z, p["name"], me)
    kennungen = eigene_kennungen()
    schlange = z["schlangen"].get(p["name"], [])
    if eigen and eigen.get("dran_bis"):
        ja, grund, halter = passt(cfg, p, menge, me, z, ausser_id=eigen["id"], kennungen=kennungen)
        return ja, grund, halter, [], eigen
    andere = [q for q in schlange if not eigen or q.get("id") != eigen.get("id")]
    vor_mir = andere if not eigen else schlange[:position(z, p["name"], eigen["id"]) - 1]
    if vor_mir:
        _ja, grund, halter = passt(cfg, p, menge, me, z, belegung_fragen=False, kennungen=kennungen)
        return False, "%d in der Warteschlange vor Dir" % len(vor_mir) + \
            (" (%s)" % grund if grund else ""), halter, vor_mir, eigen
    ja, grund, halter = passt(cfg, p, menge, me, z, kennungen=kennungen)
    return ja, grund, halter, [], eigen


