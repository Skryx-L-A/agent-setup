    e = {"id": "t" + w.kennung(), "platz": p["name"], "platz_art": p["art"], "menge": menge,
         "zweck": "unangemeldet: " + kurz, "art": "", "verweis": "", "seit": t, "seit_iso": w.iso(t),
         "frist_s": None, "bis": None, "bis_iso": "", "halter": h, "gemahnt": False,
         "verlaengerungen": [], "belegung": "", "abbruch_kill_s": p["abbruch_kill_s"],
