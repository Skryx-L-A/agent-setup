NACHTRAG_S = 120             # Nachtragsfrist fuer einen unangemeldeten Start (der Nutzer, 2026-10-09)
BEFEHL_LAENGE = 160          # so viel der Befehlszeile steht im Zwangseintrag
ZWANG_BUCHUNG_FRIST_MIN = 1440   # Zwangsbuchung in wb-belegung: haengt am Prozess, die Frist macht sie
                                 # erst nach einem Tag 'ueberfaellig' (sichtbar), nie frei
HARNESS_KOMMANDOS = ("claude", "pi", "codex", "aider", "opencode", "agy")   # wie wb-mensch (A2)
