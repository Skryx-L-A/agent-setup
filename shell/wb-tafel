# ------------------------------------------------------------------ Waechter
#
# Ein befristeter Eintrag mit gebundenem Prozess bekommt einen eigenen kleinen Waechter
# (der Nutzer, 2026-10-09): der Abbruch nach der Gnadenfrist muss puenktlich kommen, hoechstens
# 30 s danach, und ein lazy Aufruf garantiert das nicht. Gestartet ueber wb-nohup mit dem
# eintragenden Pane als Eigentuemer; er endet, sobald der Eintrag weg ist (gib, Verfall,
# Prozessende). Kein globaler Dauerjob.

# ------------------------------------- Stoerungen waehrend eines exklusiven Platzes
#
# Auftrag tafel-waechter (2026-10-10): fuenf schwere Laeufe ohne Eintrag fielen in Messungen
# auf mac-ruhe/mac-suite/mac-gpu. Der Waechter eines exklusiven Eintrags tastet deshalb die
# Prozesse ab und MELDET (nie beenden, nie Signal, nie Prioritaet) einen Lauf, der weder dem
# Halter gehoert noch von einem anderen Eintrag gedeckt ist.

_LIBPROC, _TAKTBASIS = None, None


def _libproc():
    """libproc.proc_pid_rusage (macOS): CPU-Zeit EINSCHLIESSLICH beerbter Kinder. `ps -S` zaehlt
    sie auf macOS 26 nicht (gemessen 2026-10-10: Skript mit 3 s Kindlast, ps -S 0:00.00,
    ri_child_user_time 3,02 s) -- ein Testlauf aus vielen kurzen Prozessen waere sonst unsichtbar."""
    global _LIBPROC, _TAKTBASIS
    if _LIBPROC is None:
        _LIBPROC = False
        if sys.platform == "darwin":
            try:
                import ctypes
                lib = ctypes.CDLL("/usr/lib/libproc.dylib")

                class _TB(ctypes.Structure):
                    _fields_ = [("numer", ctypes.c_uint32), ("denom", ctypes.c_uint32)]
                tb = _TB()
                ctypes.CDLL(None).mach_timebase_info(ctypes.byref(tb))
                _TAKTBASIS = tb.numer / float(tb.denom or 1) / 1e9
                _LIBPROC = (ctypes, lib)
            except (OSError, AttributeError):
                _LIBPROC = False
    return _LIBPROC


def prozess_last(pid):
    """(cpu_s einschliesslich beerbter Kinder, Speicher in Bytes) oder None. macOS: proc_pid_rusage
    (RUSAGE_INFO_V1, phys_footprint); Linux: /proc/<pid>/stat (utime+stime+cutime+cstime) und RSS."""
    lp = _libproc()
    if lp:
        ctypes, lib = lp
        buf = ctypes.create_string_buffer(512)
        if lib.proc_pid_rusage(int(pid), 1, buf) != 0:
            return None
        import struct
        v = struct.unpack_from("<12Q", buf.raw, 16)
        return (v[0] + v[1] + v[10] + v[11]) * _TAKTBASIS, v[7]
    try:
        with open("/proc/%d/stat" % int(pid)) as f:
            t = f.read().rsplit(")", 1)[1].split()
        tick = float(os.sysconf("SC_CLK_TCK"))
        return (sum(int(x) for x in t[11:15]) / tick, int(t[21]) * os.sysconf("SC_PAGE_SIZE"))
    except (OSError, ValueError, IndexError):
        return None


def last_tabelle():
