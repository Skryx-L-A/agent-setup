def _linie(h):
    """Die Prozesse, die einen Halter ausmachen: gebundene PID, Pane-Prozess, Vorfahren-Pane, ohne
    Pane der Aufrufer von nimm. Vorfahren-Pane und Aufrufer zaehlen nur, solange PID und Startzeit
    passen: eine wiederverwendete PID deckt nichts."""
    v, a = h.get("vorfahr") or {}, h.get("aufrufer") or {}
    linie = set(int(x) for x in (h.get("pid"), h.get("pane_pid")) if str(x or "").isdigit())
    for q, ls in ((v.get("pane_pid"), v.get("pane_lstart")), (a.get("pid"), a.get("lstart"))):
        if str(q or "").isdigit() and bausteine().prozess_lebt(int(q), ls) is not False:
            linie.add(int(q))
    return linie


