                        neu["belegung"] = kennung
                    else:
                        ja, grund, neu = (None if kennung is False else False), bgrund, None
            if neu:
                if eigen:
                    z["schlangen"][p["name"]] = [q for q in z["schlangen"].get(p["name"], [])
                                                 if q.get("id") != eigen["id"]]
                    verlauf_schreiben("angenommen", platz=p["name"], eintrag=eigen["id"], neu=neu["id"])
                z["eintraege"].append(neu)
                dran_zuruecknehmen(cfg, maschine, z)
                verlauf_schreiben("eingetragen", platz=p["name"], eintrag=neu["id"], menge=menge,
                                  wer=halter_text(me), zweck=zweck, art=art, frist_s=neu["frist_s"],
                                  frist_herkunft=herkunft, belegung=neu["belegung"])
                an_gruppe_tafel("eingetragen", "eingetragen: %s %s (%s) bis %s -- %s"
                                % (p["name"], neu["id"], halter_text(me), uhrzeit(neu["bis"]), zweck),
                                platz=p["name"], eintrag=neu["id"])
            elif anstellen and ja is not None:
                eigen, _neu = anstellen_in(z, cfg, maschine, p, menge, me, zweck, art, frist_s,
                                           verweis, nachrichten)
            zustand_schreiben(z)
            ergebnis = {"ja": ja, "grund": grund, "halter": halter, "vor_mir": vor_mir,
                        "neu": neu, "eigen": eigen, "herkunft": herkunft,
                        "pos": position(z, p["name"], eigen["id"]) if eigen else 0}
        zustellen(nachrichten, me)
        if ergebnis["neu"] or ergebnis["ja"] is None or not a.warte or jetzt() >= ende:
            break
        time.sleep(max(0.1, min(WARTE_TAKT_S, ende - jetzt())))
    if ergebnis.get("nachgetragen"):
        zustellen(nachrichten, me)
    neu, t = ergebnis["neu"], jetzt()
    if neu:
        waechter_starten(neu, pruefen=bool(p.get("stoerung")))
    if not neu and a.warte and ergebnis["eigen"]:
        # Wartezeit um: aus der Schlange gehen, statt sie fuer andere zu blockieren.
        with sperre():
            z = zustand_lesen()
            vorher = len(z["schlangen"].get(p["name"], []))
            z["schlangen"][p["name"]] = [q for q in z["schlangen"].get(p["name"], [])
                                         if q.get("id") != ergebnis["eigen"]["id"]]
            if len(z["schlangen"][p["name"]]) != vorher:
                verlauf_schreiben("aus-schlange", platz=p["name"], eintrag=ergebnis["eigen"]["id"],
                                  wer=halter_text(me), grund="Wartezeit um")
                nachrichten = []
                dran_vergeben(cfg, maschine, z, nachrichten)
                zustand_schreiben(z)
                ergebnis["eigen"], ergebnis["pos"] = None, 0
            else:
                nachrichten = []
        zustellen(nachrichten, me)
    if a.json:
        print(json.dumps({"ok": bool(neu), "platz": p["name"], "grund": ergebnis["grund"],
                          "eintrag": eintrag_json(neu, t) if neu else None,
                          "frist_herkunft": ergebnis["herkunft"],
                          "halter": [eintrag_json(e, t) for e in ergebnis["halter"]],
                          "wartend": wartend_json(ergebnis["eigen"], t, ergebnis["pos"])
                          if ergebnis["eigen"] else None}, indent=2, ensure_ascii=False))
    elif neu and ergebnis.get("nachgetragen"):
        gib_aus("NACHGETRAGEN: %s auf %s ist jetzt Dein Eintrag, Frist %s (bis %s). Der unangemeldete "
                "Start bleibt im Verlauf sichtbar." % (neu["id"], p["name"], dauer_text(neu["frist_s"]),
                                                      uhrzeit(neu["bis"])))
        gib_aus("  Austragen am Ende: wb-tafel gib %s" % neu["id"])
    elif neu:
        gib_aus("EINGETRAGEN: %s auf %s%s, Frist %s (bis %s)%s."
                % (neu["id"], p["name"], "" if menge == 1 else " (%s %s)" % (menge_text(menge), p["einheit"]),
                   dauer_text(neu["frist_s"]), uhrzeit(neu["bis"]),
                   (", " + ergebnis["herkunft"]) if ergebnis["herkunft"] else ""))
        if neu["belegung"]:
            gib_aus("  Speicher gebucht in wb-belegung unter %s (geht mit diesem Eintrag)." % neu["belegung"])
        if not nachweisbar(me):
            gib_aus("  Hinweis: kein Pane und kein --pid -- es zaehlt allein die Frist, und jeder darf "
                    "diesen Eintrag austragen.")
        if p.get("sperrt_schwere"):
            gib_aus("  Solange dieser Eintrag steht, melden schwere Plaetze fuer andere 'belegt'.")
        gib_aus("  Austragen am Ende: wb-tafel gib %s" % neu["id"])
    else:
        if ergebnis["ja"] is None:
            print("wb-tafel: %s" % ergebnis["grund"], file=sys.stderr)
        else:
            belegt_zeigen(p, ergebnis["grund"], ergebnis["halter"], ergebnis["vor_mir"], t)
        if ergebnis["eigen"]:
            q = ergebnis["eigen"]
            if q.get("dran_bis"):
                gib_aus("  DRAN: Du bist dran (%s), annehmen bis %s: wb-tafel nimm %s"
                        % (q["id"], uhrzeit(float(q["dran_bis"])), p["name"]))
            else:
                gib_aus("  ANGESTELLT: %s, Position %d. Wenn Du dran bist, kommt eine Nachricht "
                        "ueber wb-inbox." % (q["id"], ergebnis["pos"]))
        elif a.warte:
            gib_aus("  Wartezeit um (%s), nicht eingetragen." % a.warte)
    if neu and a.lauf:
        # `nimm` laeuft in einem eigenen Prozess und kann die Umgebung der
        # aufrufenden Shell nicht setzen. Mit `-- <befehl>` wird der Lauf deshalb
        # als Kind mit genau dieser Kennung gestartet und der Eintrag danach
        # wieder freigegeben. Die Kennung ersetzt geerbte Werte: ein Lauf darf
        # nicht versehentlich durch einen anderen Eintrag gedeckt werden.
        umgebung = os.environ.copy()
        umgebung[KENNUNG_VAR] = neu["id"]
        lauf_rc = EXIT_OK
        try:
            try:
                lauf_rc = subprocess.run(a.lauf, env=umgebung, check=False).returncode
            except OSError as e:
                print("wb-tafel: Lauf liess sich nicht starten: %s" % e, file=sys.stderr)
                lauf_rc = EXIT_DIENST
        finally:
            try:
                gib_rc = cmd_gib(argparse.Namespace(ziel=neu["id"], pid=0), cfg, maschine)
            except SystemExit as e:
                gib_rc = int(e.code or EXIT_DIENST)
        if gib_rc != EXIT_OK and lauf_rc == EXIT_OK:
            lauf_rc = EXIT_DIENST
        return lauf_rc
    if neu:
        return EXIT_OK
    return EXIT_DIENST if ergebnis["ja"] is None else EXIT_BELEGT


def cmd_anstellen(a, cfg, maschine):
    p = platz(cfg, a.platz, maschine)
    menge = menge_pruefen(p, a.menge)
    if not a.zweck:
        fehler("--zweck fehlt. Ein Eintrag ohne Zweck kann niemand beurteilen.")
    me = ich(a.pid)
    modus = halter_modus(me)
    if modus:
        me["modus"] = modus
    frist_s, _herkunft = frist_bestimmen(a.frist, a.art, zustand_lesen())
    with sperre():
        z, nachrichten, _ = sitzung(cfg, maschine)
        q, neu = anstellen_in(z, cfg, maschine, p, menge, me, a.zweck, a.art, frist_s, a.verweis,
                              nachrichten)
        pos = position(z, p["name"], q["id"])
        zustand_schreiben(z)
    zustellen(nachrichten, me)
    if a.json:
        print(json.dumps({"wartend": wartend_json(q, jetzt(), pos), "neu": neu}, indent=2,
                         ensure_ascii=False))
    elif q.get("dran_bis"):
        gib_aus("DRAN: %s fuer %s -- der Platz ist frei. Annehmen bis %s: wb-tafel nimm %s"
                % (q["id"], p["name"], uhrzeit(float(q["dran_bis"])), p["name"]))
    else:
        gib_aus("%s: %s fuer %s, Position %d. Wenn Du dran bist, kommt eine Nachricht ueber wb-inbox."
                % ("ANGESTELLT" if neu else "SCHON ANGESTELLT", q["id"], p["name"], pos))
    return EXIT_OK


def finden(z, ziel, me):
    """Eintraege und Wartende zu einer Kennung, sonst die eigenen auf einem Platz."""
    eintraege = [e for e in z["eintraege"] if e.get("id") == ziel]
    wartende = [(n, q) for n, s in z["schlangen"].items() for q in s if q.get("id") == ziel]
    if eintraege or wartende:
        return eintraege, wartende
    k = schluessel(me)
    eintraege = [e for e in z["eintraege"] if e.get("platz") == ziel
                 and schluessel(e.get("halter") or {}) == k]
    wartende = [(ziel, q) for q in z["schlangen"].get(ziel, []) if schluessel(q.get("halter") or {}) == k]
    return eintraege, wartende


def cmd_gib(a, cfg, maschine):
    me = ich(a.pid)
    abbruch = None
    erledigt = []
    with sperre():
        z, nachrichten, verfallen = sitzung(cfg, maschine)
        eintraege, wartende = finden(z, a.ziel, me)
        rechte = {}
        for obj in eintraege + [q for _n, q in wartende]:
            r = recht_auf(me, obj.get("halter") or {})
            if not r:
                abbruch = (EXIT_RECHT, "%s gehoert %s. Austragen duerfen nur der Halter, sein Orchestrator "
                           "oder der Mensch." % (obj.get("id"), halter_text(obj.get("halter") or {})))
                break
            rechte[obj["id"]] = r
        if not abbruch:
            for e in eintraege:
                z["eintraege"] = [x for x in z["eintraege"] if x.get("id") != e["id"]]
                dauer_merken(z, e)
                benachrichtigen = []
                if rechte[e["id"]] in ("orchestrator", "mensch"):
                    benachrichtigen.append((e.get("halter") or {}, (
                        "wb-tafel: Dein Eintrag %s auf %s (%s) wurde ausgetragen von %s (%s)."
                        % (e["id"], e.get("platz"), e.get("zweck", ""), halter_text(me), rechte[e["id"]]))))
                austragen(e, "ausgetragen", "%s (%s)" % (halter_text(me), rechte[e["id"]]), nachrichten,
                          benachrichtigen=benachrichtigen)
                erledigt.append("Ausgetragen: %s (%s, nach %s)"
                                % (e["id"], e.get("platz"), dauer_text(jetzt() - float(e["seit"]))))
            for n, q in wartende:
                z["schlangen"][n] = [x for x in z["schlangen"].get(n, []) if x.get("id") != q["id"]]
                verlauf_schreiben("aus-schlange", platz=n, eintrag=q["id"], wer=halter_text(q.get("halter") or {}),
                                  durch="%s (%s)" % (halter_text(me), rechte[q["id"]]))
                erledigt.append("Aus der Schlange: %s (%s)" % (q["id"], n))
            dran_vergeben(cfg, maschine, z, nachrichten)
        zustand_schreiben(z)
    zustellen(nachrichten, me)
    if abbruch:
        fehler(abbruch[1], abbruch[0])
    if not erledigt:
        if a.ziel in verfallen:
            gib_aus("Bereits verfallen: %s -- nichts mehr auszutragen." % a.ziel)
            return EXIT_OK
        print("wb-tafel: nichts auszutragen fuer '%s'." % a.ziel, file=sys.stderr)
        return EXIT_BELEGT
    for zeile in erledigt:
        gib_aus(zeile)
    return EXIT_OK


def cmd_verlaengern(a, cfg, maschine):
    um = dauer_lesen(a.um, "--um")
    if not (a.grund or "").strip():
        fehler("--grund fehlt. Jede Verlaengerung steht mit Grund im Verlauf.")
    me = ich(a.pid)
    abbruch, e = None, None
    with sperre():
        z, nachrichten, verfallen = sitzung(cfg, maschine)
        e = next((x for x in z["eintraege"] if x.get("id") == a.eintrag), None)
        if e is None:
            abbruch = (EXIT_BELEGT, ("der Eintrag %s ist bereits verfallen -- neu eintragen." % a.eintrag)
                       if a.eintrag in verfallen else "keinen Eintrag %s gefunden." % a.eintrag)
        else:
            r = recht_auf(me, e.get("halter") or {})
            if not r:
                abbruch = (EXIT_RECHT, "%s gehoert %s. Verlaengern duerfen nur der Halter, sein "
                           "Orchestrator oder der Mensch." % (e["id"], halter_text(e.get("halter") or {})))
            elif e.get("bis") is None:
                abbruch = (EXIT_AUFRUF, "%s ist ein unangemeldeter Start ohne Frist. Nachtragen statt "
                           "verlaengern: wb-tafel nimm %s --frist <dauer> --zweck \"<satz>\""
                           % (e["id"], e.get("platz")))
            else:
                t = jetzt()
                e["bis"] = float(e["bis"]) + um
                e["bis_iso"] = bausteine().iso(e["bis"])
                e["frist_s"] = int(round(float(e["bis"]) - float(e["seit"])))
                e["gemahnt"] = False
                for k in ("gemahnt_iso", "frist_gemeldet", "gnade_gemeldet"):
                    e.pop(k, None)
                e.setdefault("verlaengerungen", []).append(
                    {"um_s": int(round(um)), "grund": a.grund.strip(), "zeit_iso": bausteine().iso(t),
                     "durch": halter_text(me), "recht": r})
                if e.get("belegung"):
                    rc, text = belegung_verlaengern(e["belegung"], float(e["bis"]) - t)
                    if rc != 0:
                        verlauf_schreiben("belegung-nicht-verlaengert", eintrag=e["id"],
                                          belegung=e["belegung"], rc=rc, grund=text[-200:])
                verlauf_schreiben("verlaengert", platz=e.get("platz"), eintrag=e["id"], um_s=int(round(um)),
                                  grund=a.grund.strip(), durch="%s (%s)" % (halter_text(me), r))
                an_gruppe_tafel("verlaengert", "verlaengert: %s %s um %s bis %s -- %s"
                                % (e.get("platz"), e["id"], dauer_text(um), uhrzeit(e["bis"]), a.grund.strip()),
                                platz=e.get("platz"), eintrag=e["id"])
        zustand_schreiben(z)
    zustellen(nachrichten, me)
    if abbruch:
        fehler(abbruch[1], abbruch[0])
    gib_aus("Verlaengert: %s um %s, neue Frist bis %s (Rest %s)."
            % (e["id"], dauer_text(um), uhrzeit(float(e["bis"])), dauer_text(float(e["bis"]) - jetzt())))
    return EXIT_OK


def darf_binden(me, h):
    """'' | 'halter' | 'vorfahr' | 'ohne-halter': nur der bisherige Halter oder dessen Vorfahren-Pane.
    Ein Orchestrator derselben Sitzungsgruppe, ein Geschwister-Pane oder der Mensch zaehlen hier
    nicht: umbinden heisst, einen eigenen Lauf unter einen eigenen Eintrag zu stellen."""
    if not nachweisbar(h):
        return "ohne-halter"
    if schluessel(me) == schluessel(h):
        return "halter"
    if h.get("pid") and ist_vorfahr_pane_von(me, h):
        return "vorfahr"
    adr = melde_adresse(h)
    if adr.get("pane") and me.get("pane") and adr["pane"] == me["pane"] \
            and adr.get("socket") == me.get("socket"):
        return "vorfahr"
    if not me.get("pane"):
        # Ohne eigenen Pane (Lauf unter `env -i`, kein TMUX_PANE): zaehlt der Prozessbaum.
        return ahne_pane(h)[0]
    return ""


def cmd_binden(a, cfg, maschine):
    """Einen bestehenden Eintrag an eine PID umbinden (Auftrag tafel-uebernahme): der Orchestrator
    nimmt den Platz vorab (der freie Platz geht sonst sofort an den ersten Wartenden), der Lauf
    uebernimmt den Eintrag. Halter wird die Prozessidentitaet (PID samt Startzeit); der bisherige
    Pane bleibt als halter.vorfahr fuer Zustellung und Rechte (melde_adresse, ist_vorfahr_pane_von).
    Platz, Menge, Art und Frist bleiben. Rechte: der bisherige Halter oder dessen Vorfahren-Pane,
    und die Ziel-PID ist ein Nachfahre des Aufrufer-Panes (ohne Pane: ein eigener Vorfahr des
    Aufrufs). Sonst Exit 4."""
    me = ich(0)
    w, ziel = bausteine(), a.pid
    tab = prozesstabelle()
    if ziel not in tab:
        fehler("--pid %d laeuft nicht." % ziel)
    if ist_sitzungsprozess(ziel, me.get("pane_pid")):
        fehler("--pid %d ist die Sitzung selbst (Pane-Prozess oder Harness), nicht ein Lauf. Gebunden "
               "wird der Prozess, der den Lauf faehrt, etwa das Skript: --pid $$." % ziel)
    if me.get("pane_pid"):
        nachfahre = int(me["pane_pid"]) in ahnenkette(tab, ziel)
    else:
        nachfahre = ziel in ahnen()
    if not nachfahre:
        fehler("--pid %d ist kein Nachfahr des Aufrufers (%s). Binden laesst sich nur ein Prozess, der "
               "unter dem eigenen Pane laeuft." % (ziel, ("Pane %s" % me["pane"]) if me.get("pane")
                                                   else "ohne Pane: nur ein eigener Vorfahr"), EXIT_RECHT)
    lstart = w.prozess_lstart(ziel)
    if not lstart:
        fehler("--pid %d: der Startzeitpunkt ist nicht messbar." % ziel, EXIT_RECHT)
    abbruch, e, alt_text, recht, umgebunden, hatte_pid = None, None, "", "", False, False
    with sperre():
        z, nachrichten, verfallen = sitzung(cfg, maschine)
        e = next((x for x in z["eintraege"] if x.get("id") == a.eintrag), None)
        if e is None:
            abbruch = (EXIT_BELEGT, ("der Eintrag %s ist bereits verfallen -- neu eintragen." % a.eintrag)
                       if a.eintrag in verfallen else "keinen Eintrag %s gefunden." % a.eintrag)
        elif a.platz and e.get("platz") != a.platz:
            abbruch = (EXIT_AUFRUF, "%s gehoert zum Platz %s, nicht zu %s." % (e["id"], e.get("platz"), a.platz))
        elif e.get("unangemeldet"):
            abbruch = (EXIT_AUFRUF, "%s ist ein unangemeldeter Start ohne Frist. Nachtragen statt binden: "
                       "wb-tafel nimm %s --frist <dauer> --zweck \"<satz>\"" % (e["id"], e.get("platz")))
        else:
            h = e.get("halter") or {}
            recht = darf_binden(me, h)
            if not recht:
                abbruch = (EXIT_RECHT, "%s gehoert %s. Umbinden duerfen nur der Halter oder dessen "
                           "Vorfahren-Pane." % (e["id"], halter_text(h)))
            elif not me.get("pane") and ziel == ahne_pane(h)[1]:
                abbruch = (EXIT_AUFRUF, "--pid %d ist die Sitzung selbst (Pane-Prozess), nicht ein Lauf. "
                           "Gebunden wird der Prozess, der den Lauf faehrt, etwa das Skript: --pid $$." % ziel)
            elif h.get("pid") == ziel and h.get("lstart") == lstart:
                alt_text = halter_text(h)       # schon gebunden: nichts zu tun
            else:
                alt_text, umgebunden, hatte_pid = halter_text(h), True, bool(h.get("pid"))
                # Der bisherige Pane (bzw. dessen Vorfahren-Pane) wird zum Vorfahren des Laufs.
                quelle = h if h.get("pane") else (h.get("vorfahr") or {})
                neu = {k: v for k, v in h.items()
                       if k not in ("pane", "pane_pid", "pane_lstart", "pid", "lstart", "vorfahr")}
                neu["pane"], neu["rolle"] = "", ""      # der Lauf ist keine Sitzung; sitzung/socket/worker bleiben
                neu["pid"], neu["lstart"] = ziel, lstart
                if quelle.get("pane"):
                    neu["vorfahr"] = {k: quelle.get(k, "") for k in ("pane", "socket", "sitzung", "worker", "rolle",
                                                                  "pane_pid", "pane_lstart")}
                e["halter"] = neu
                # Lauf des Menschen wird nie beendet: wie bei nimm --pid gemessen, nicht behauptet.
                e["mensch"] = bool(e.get("mensch")) or ist_mensch()
                e.setdefault("gebunden", []).append({"von": alt_text, "zu": halter_text(neu), "pid": ziel,
                                                     "zeit_iso": w.iso(jetzt()), "recht": recht})
                verlauf_schreiben("gebunden", platz=e.get("platz"), eintrag=e["id"], von=alt_text,
                                  zu=halter_text(neu), durch=halter_text(me), recht=recht, pid=ziel)
                an_gruppe_tafel("gebunden", "gebunden: %s %s von %s an %s" % (e.get("platz"), e["id"], alt_text,
                                                                           halter_text(neu)),
                                platz=e.get("platz"), eintrag=e["id"])
        zustand_schreiben(z)
    zustellen(nachrichten, me)
    if abbruch:
        fehler(abbruch[1], abbruch[0])
    if umgebunden and not hatte_pid:
        waechter_starten(e)
    rest = float(e["bis"]) - jetzt() if e.get("bis") is not None else None
    if a.json:
        print(json.dumps({"ok": True, "eintrag": eintrag_json(e, jetzt()), "gebunden": umgebunden,
                          "von": alt_text}, indent=2, ensure_ascii=False))
    else:
        gib_aus("%s: %s auf %s ist an PID %d gebunden (vorher %s)%s. Austragen am Ende: wb-tafel gib %s"
                % ("GEBUNDEN" if umgebunden else "SCHON GEBUNDEN", e["id"], e.get("platz"), ziel, alt_text,
                   (", Frist bis %s (Rest %s)" % (uhrzeit(float(e["bis"])), dauer_text(max(0.0, rest))))
                   if rest is not None else "", e["id"]))
    return EXIT_OK


def cmd_vorrang(a, cfg, maschine):
    """Einen Wartenden nach vorn holen: Orchestratoren und der Mensch jeden, ein Wartender sich
    selbst, wenn seine --art auf dem Platz unter 'selbst_vorrang_arten' steht (frage-an-person-1:
    sicherheit). Ein gehaltener Platz wird nie unterbrochen: vorn heisst vorn in der Schlange."""
    if not (a.grund or "").strip():
        fehler("--grund fehlt.")
    me = ich(0)
    abbruch, treffer = None, []
    with sperre():
        z, nachrichten, _ = sitzung(cfg, maschine)
        treffer = [(n, q) for n, s in z["schlangen"].items() for q in s if q.get("id") == a.eintrag]
        if not treffer:
            abbruch = (EXIT_BELEGT, "keinen Wartenden %s gefunden." % a.eintrag)
        else:
            n, q = treffer[0]
            p = platz_suchen(cfg, n, maschine) or {}
            selbst = (schluessel(q.get("halter") or {}) == schluessel(me) and nachweisbar(me)
                      and q.get("art") and q.get("art") in (p.get("selbst_vorrang_arten") or []))
            if not selbst and rolle_von(me) not in ("orchestrator", "mensch"):
                abbruch = (EXIT_RECHT, "vorrang duerfen nur Orchestratoren (Rolle laut hooks/lib/rollen.py) und "
