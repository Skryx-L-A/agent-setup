def verlauf_datei(ts):
    return os.path.join(STATE_DIR, "verlauf-%s.jsonl" % time.strftime("%Y-%m", time.localtime(ts)))


def verlauf_rotieren(ts):
    """Monatliche Rotation: eine Datei je Monat, die aktuelle und die elf davor bleiben."""
    lt = time.localtime(ts)
    jetzt_idx = lt.tm_year * 12 + lt.tm_mon - 1
    try:
        namen = os.listdir(STATE_DIR)
    except OSError:
        return
    for n in namen:
        m = re.match(r"^verlauf-(\d{4})-(\d{2})\.jsonl$", n)
        if m and int(m.group(1)) * 12 + int(m.group(2)) - 1 <= jetzt_idx - VERLAUF_MONATE:
            try:
                os.unlink(os.path.join(STATE_DIR, n))
            except OSError:
                pass


def verlauf_schreiben(ereignis, **felder):
    ts = jetzt()
    zeile = {"zeit": round(ts, 3), "zeit_iso": bausteine().iso(ts), "ereignis": ereignis}
    zeile.update({k: v for k, v in felder.items() if v not in (None, "")})
    os.makedirs(STATE_DIR, exist_ok=True)
    # Eine Zeile je write() mit O_APPEND: auch ausserhalb der Sperre nie verschraenkt.
    with open(verlauf_datei(ts), "a", encoding="utf-8") as f:
        f.write(json.dumps(zeile, ensure_ascii=False) + "\n")
    verlauf_rotieren(ts)


GRUPPEN_MELDUNGEN = []      # gesammelt unter der Sperre, gesendet danach (gruppe_senden)


def gruppe_pfad():
    p = os.environ.get("WB_TAFEL_GRUPPE", "")
    kandidaten = [p] if p else [os.path.join(HIER, "wb-gruppe"), shutil.which("wb-gruppe") or "",
                                os.path.join(HOME, ".local", "bin", "wb-gruppe")]
    for k in kandidaten:
        if k and os.path.isfile(k) and os.access(k, os.X_OK):
            return k
    return ""


def an_gruppe_tafel(anlass, text, **felder):
    """Tafel-Meldungen an die Gruppe `tafel` (wb-gruppe, Systemabsender tafel).

    Anlaesse: eingetragen, angestellt, dran, angenommen, gemahnt, frist-ende, gnade-halb,
    abbruch, verlaengert, verfallen, ausgetragen, verpasst, vorrang, unangemeldet,
    zwangseintrag, nachgetragen, erlaubnis, commit-trotzdem. Optional `an=<sitzung>` (oder
    eine Liste): adressiert Mitglieder im Modus erwaehnt. Die Meldung wird hier nur gesammelt
    und erst nach der Sperre gesendet (gruppe_senden): wb-gruppe stellt ueber wb-inbox zu,
    und das darf die Tafel nicht aufhalten. Fehlt wb-gruppe oder die Gruppe tafel, bleibt
    es beim Verlauf (Ereignis 'gruppe-tafel'), wie vor der Anbindung."""
    an = felder.pop("an", None)
    an = [x for x in ([an] if isinstance(an, str) else (an or [])) if x]
    GRUPPEN_MELDUNGEN.append((anlass, text, an, felder))


def gruppe_senden():
    """`wb-gruppe meldung tafel [--an <sitzung>] --datei <tmp>` je gesammelter Meldung; das
    Ergebnis steht im Verlauf. wb-gruppe erkennt den Absender tafel daran, dass wb-tafel
    Ahne des Aufrufs ist -- kein Argument kann das behaupten."""
    while GRUPPEN_MELDUNGEN:
        anlass, text, an, felder = GRUPPEN_MELDUNGEN.pop(0)
        pfad, rc, grund = gruppe_pfad(), None, ""
        if not pfad:
            grund = "wb-gruppe nicht gefunden"
        else:
            os.makedirs(STATE_DIR, exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".gruppe-")
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write(text + "\n")
                befehl = [pfad, "meldung", "tafel"]
                for x in an:
                    befehl += ["--an", x]
                befehl += ["--datei", tmp]
                try:
                    p = subprocess.run(befehl, capture_output=True, text=True, timeout=GRUPPE_FRIST_S,
                                       stdin=subprocess.DEVNULL)
                    rc = p.returncode
                    rest = (p.stderr or p.stdout or "").strip().splitlines()[-1:]
                    grund = rest[0] if rest and rc not in (0,) else ""
                except (OSError, subprocess.SubprocessError) as x:
                    rc, grund = -1, str(x)
            finally:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
        # 0 gespeichert und zugestellt, 7 gespeichert (nicht jede Zustellung gelang): beides ist
        # in der Gruppe angekommen. Sonst (keine Gruppe tafel, kein wb-gruppe) nur der Verlauf.
        verlauf_schreiben("gruppe-tafel", gruppe="tafel", anlass=anlass, text=text,
                          an=",".join(an), gruppe_rc=rc,
                          gruppe_status=("gesendet" if rc in (0, 7) else "nur-verlauf"),
                          gruppe_grund=grund[-200:] if grund else "", **felder)


# ------------------------------------------------------------- Identitaet

def ahnen():
    """Die Elternkette dieses Prozesses (ohne ihn selbst), einmal je Aufruf gemessen."""
    global _AHNEN
    if _AHNEN is not None:
        return _AHNEN
    kette, q = [], os.getpid()
    for _ in range(64):
        try:
            r = subprocess.run(["ps", "-o", "ppid=", "-p", str(q)], capture_output=True,
                               text=True, timeout=5)
            q = int(r.stdout.strip())
        except (OSError, subprocess.SubprocessError, ValueError):
            break
        if q in (0, 1):
            break
        kette.append(q)
    _AHNEN = kette
    return kette


def ist_sitzungsprozess(pid, pane_pid=None):
    """Ist das der Pane-Prozess oder ein Harness (claude, pi, codex, ...)? Solche Prozesse
    sind die Sitzung selbst, nie ein Lauf, und werden nie gebunden."""
    try:
        befehl = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True,
                                text=True, timeout=5).stdout.strip().split()
    except (OSError, subprocess.SubprocessError):
        befehl = []
    return pid == pane_pid or any(os.path.basename(x) in harness_namen() for x in befehl[:2])


def ich(pid_bindung=0):
    """Der Halter dieses Aufrufs, gemessen statt behauptet.

    Grundlage ist wb-belegungs eigener_halter() (Pane, Socket, Sitzungsgruppe, Worker,
    Host, auf Linux die systemd-Unit). Dazu kommt hier der Nachweis, den wb-belegung
    nicht fuehrt: $TMUX_PANE ist eine Variable und liesse sich auf einen fremden Pane
    setzen. Sie zaehlt nur, wenn der Prozess dieses Panes in der eigenen Elternkette
    steht -- dieselbe Ahnenreihen-Pruefung wie in wb-inbox."""
    w = bausteine()
    h = w.eigener_halter()
    h.pop("etikett", None)
    h["rolle"] = ""
    if h.get("pane"):
        rc, aus = w.tmux_ruf(["display", "-p", "-t", h["pane"],
                              "#{pane_id}\t#{pane_pid}\t#{@wb_role}"], h.get("socket", ""))
        teile = aus.strip("\n").split("\t") if rc == 0 else []
        if len(teile) < 2 or teile[0] != h["pane"] or not teile[1].isdigit():
            fehler("Absender nicht nachweisbar: den Pane %s gibt es auf dem tmux-Server %s nicht."
                   % (h["pane"], h.get("socket") or "(Vorgabe)"), EXIT_RECHT)
        pane_pid = int(teile[1])
        if pane_pid not in ahnen():
            fehler("Absender nicht nachweisbar: TMUX_PANE=%s gehoert nicht zu diesem Aufruf (der "
                   "Prozess des Panes, PID %d, steht nicht in seiner Elternkette). Die Identitaet "
                   "kommt aus Pane und Prozess, nicht aus einer Variablen." % (h["pane"], pane_pid),
                   EXIT_RECHT)
        h["pane_pid"] = pane_pid
        h["pane_lstart"] = w.prozess_lstart(pane_pid)
        h["rolle"] = teile[2] if len(teile) > 2 else ""
    if pid_bindung:
        if pid_bindung not in ahnen():
            fehler("--pid %d ist kein Vorfahr dieses Aufrufs. Binden laesst sich nur ein eigener "
                   "Elternprozess (etwa das Skript, das den Lauf faehrt: --pid $$)." % pid_bindung,
                   EXIT_RECHT)
        lstart = w.prozess_lstart(pid_bindung)
        if not lstart:
            fehler("--pid %d: der Startzeitpunkt ist nicht messbar." % pid_bindung, EXIT_RECHT)
        # Ein gebundener Prozess kann nach Frist und Gnadenfrist beendet werden. Gebunden wird
        # deshalb der Lauf, nie die Sitzung: nicht der Pane-Prozess, kein Harness.
        if ist_sitzungsprozess(pid_bindung, h.get("pane_pid")):
            fehler("--pid %d ist die Sitzung selbst (Pane-Prozess oder Harness), nicht ein Lauf. Gebunden "
                   "wird der Prozess, der den Lauf faehrt, etwa das Skript: --pid $$." % pid_bindung)
        h["pid"] = pid_bindung
        h["lstart"] = lstart
        if not h.get("pane"):
            # Ohne eigenen Pane: der Pane des naechsten Vorfahren (etwa der Orchestrator, der den
            # Lauf aus `zsh -c` startete) ist die Zustelladresse. Hier festgehalten fuer Meldungen
            # nach dem Prozessende; solange der Prozess lebt, wird sie neu gemessen (melde_adresse).
            kette = ahnen()
            v, _agent = starter_von(pid_bindung, kette[kette.index(pid_bindung) + 1:])
            if v.get("pane"):
                h["vorfahr"] = {k: v.get(k, "") for k in ("pane", "socket", "sitzung", "worker", "rolle",
                                                          "pane_pid", "pane_lstart")}
    elif not h.get("pane"):
        linie_ohne_pane(h)
    return h


def linie_ohne_pane(h):
    """Ohne $TMUX_PANE und ohne --pid (eine Codex-Shell traegt kein $TMUX/$TMUX_PANE, gemessen am
    10.10.: Eintrag t8e5210 hiess 'ohne Pane' und deckte den eigenen Bau nicht): der Pane aus der
    Elternkette des Aufrufs wird halter.vorfahr, gemessen wie beim Verursacher eines Stoerfalls
    (starter_von). Ohne Pane in der Kette haelt der Halter den Aufrufer fest (Elternprozess von
    wb-tafel, also die Shell von `nimm … && <lauf>`), samt Startzeit, als halter.aufrufer. Beides
    dient nur der Deckung (_linie); nachweisbar() zaehlt keins davon, Rechte und Zustellung bleiben."""
    kette = ahnen()
    if not kette:
        return
    v, _agent = starter_von(os.getpid(), kette)
    if v.get("pane"):
        h["vorfahr"] = {k: v.get(k, "") for k in ("pane", "socket", "sitzung", "worker", "rolle",
                                                  "pane_pid", "pane_lstart")}
        return
    q = kette[0]
    try:
        befehl = subprocess.run(["ps", "-o", "command=", "-p", str(q)], capture_output=True,
                                text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        befehl = ""
    # Ein tmux-Server oder Systemstarter als Aufrufer deckte alles, was er je startet: nie.
    if not befehl or os.path.basename(befehl.split()[0]) in ("tmux", "launchd", "systemd", "init"):
        return
    lstart = bausteine().prozess_lstart(q)
    if lstart:
        h["aufrufer"] = {"pid": q, "lstart": lstart, "befehl": befehl_kurz(befehl)}


def schluessel(h):
    if h.get("pane"):
        return "pane:%s@%s" % (h["pane"], h.get("socket", ""))
    if h.get("pid"):
        return "pid:%s:%s" % (h["pid"], h.get("lstart", ""))
    if h.get("halter_art") == "unit":
        return "unit:%s:%s" % (h.get("unit", ""), h.get("unit_mainpid", ""))
    return "ohne:%s" % h.get("host", "")


def nachweisbar(h):
    return bool(h.get("pane") or h.get("pid") or h.get("halter_art") == "unit")


def halter_text(h):
    teile = [t for t in (h.get("sitzung", ""), h.get("pane", "")) if t]
    if h.get("worker"):
        teile.append("Worker '%s'" % h["worker"])
    elif h.get("rolle"):
        teile.append(h["rolle"])
    if h.get("pid"):
        teile.append("PID %s" % h["pid"])
    if h.get("halter_art") == "unit":
        teile.append("Unit %s" % h.get("unit", "?"))
    if not teile:
        teile.append("ohne Pane, Host %s" % h.get("host", "?"))
    return " ".join(teile)


def halter_lebt(h, cache):
    """True / False / None. None heisst 'nicht pruefbar' und ist nie 'tot'."""
    w = bausteine()
    if h.get("pid"):
        return w.prozess_lebt(h["pid"], h.get("lstart", ""))
    if h.get("halter_art") == "unit":
        return w.unit_lebt(h)
    if h.get("pane"):
        sock = h.get("socket", "")
        if sock not in cache:
            cache[sock] = w.panes_des_servers(sock)
        lage, karte = cache[sock]
        if lage == "kein-server":
            return False
        if lage != "ok":
            return None
        if h["pane"] not in karte or karte[h["pane"]]:
            return False
        # Pane-Kennungen beginnen nach einem Serverneustart wieder bei %0: erst der
        # Startzeitpunkt seines Prozesses bestaetigt, dass es noch derselbe Pane ist.
        if h.get("pane_pid") and h.get("pane_lstart"):
            if w.prozess_lebt(h["pane_pid"], h["pane_lstart"]) is False:
                return False
        return True
    return None


def ist_mensch():
    """`wb-mensch pruefen` mit sauberer Umgebung, wie in wb-belegung und wb-inbox.
    Fehlt es oder scheitert es: kein Mensch."""
    global _MENSCH
    if _MENSCH is not None:
        return _MENSCH
    w = bausteine()
    pfad = w.wb_mensch_pfad()
    _MENSCH = False
    if pfad:
        try:
            _MENSCH = subprocess.run([pfad, "pruefen"], stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     timeout=15, env=w.wb_mensch_env()).returncode == 0
        except (OSError, subprocess.SubprocessError):
            _MENSCH = False
    return _MENSCH


def ist_orchestrator_von(me, h):
    return (bool(me.get("sitzung")) and me.get("sitzung") == h.get("sitzung")
            and me.get("socket") == h.get("socket") and rolle_von(me) == "orchestrator")


def ist_vorfahr_pane_von(me, h):
    """Ist der (nachgewiesene) Pane des Aufrufers Vorfahr des an h gebundenen Prozesses? Dann
    hat dieser Pane den Lauf gestartet und gilt als dessen Orchestrator (GL#10: run-all.sh aus
    `zsh -c` eines Orchestrators, ohne eigenen Pane). Gemessen an der lebenden Elternkette der
    gebundenen PID samt Startzeit; Geschwister und fremde Panes erfasst das nicht."""
    if not me.get("pane") or not me.get("pane_pid") or not h.get("pid") or not h.get("lstart"):
        return False
    if bausteine().prozess_lebt(h["pid"], h["lstart"]) is not True:
        return False
    return int(me["pane_pid"]) in ahnenkette(prozesstabelle(), int(h["pid"]))


def pane_in_ahnen(q):
    """Steht der Pane-Prozess von q ({pane, socket, pane_pid, pane_lstart}) in der EIGENEN
    Elternkette? Gemessen ueber den Prozessbaum, nicht ueber $TMUX_PANE: so erkennt sich auch ein
    Aufruf als Kind des Panes, dem die Umgebung fehlt (Gesamtlauf unter `env -i`). Mit
    festgehaltenem pane_pid braucht es den Startzeit-Abgleich gegen PID-Wiederverwendung; ohne ihn
    wird der Pane auf dem Socket des Halters neu gemessen. Gibt die Pane-PID zurueck, sonst 0."""
    w = bausteine()
    pp, ls = q.get("pane_pid"), q.get("pane_lstart")
    if str(pp or "").isdigit() and ls:
        return int(pp) if w.prozess_lebt(int(pp), ls) is True and int(pp) in ahnen() else 0
    if not (q.get("pane") and q.get("socket")):
        return 0
    rc, aus = w.tmux_ruf(["display", "-p", "-t", q["pane"], "#{pane_id}\t#{pane_pid}"], q["socket"])
    teile = aus.strip("\n").split("\t") if rc == 0 else []
    if len(teile) < 2 or teile[0] != q["pane"] or not teile[1].isdigit():
        return 0
    return int(teile[1]) if int(teile[1]) in ahnen() else 0


def ahne_pane(h):
    """('halter' | 'vorfahr' | '', pane_pid): ist der Pane des Halters h (sein eigener, sonst der
    festgehaltene oder lebend gemessene Vorfahren-Pane des gebundenen Laufs) ein Vorfahr dieses
    Aufrufs? Fuer Aufrufer ohne eigenen Pane (`env -i`), die der Pane-Check ueber TMUX_PANE nicht
    erfasst. Fremde Panes, Geschwister und Orchestratoren ohne Abstammung bleiben draussen."""
    if h.get("pane"):
        pp = pane_in_ahnen(h)
        if pp:
            return "halter", pp
    for q in (h.get("vorfahr") or {}, melde_adresse(h) if h.get("pid") else {}):
        if q.get("pane"):
            pp = pane_in_ahnen(q)
            if pp:
                return "vorfahr", pp
    return "", 0


def recht_auf(me, h):
    """'' (kein Recht) | 'halter' | 'ohne-halter' | 'orchestrator' | 'mensch'."""
    if schluessel(me) == schluessel(h):
        return "halter"
    if not nachweisbar(h):
        return "ohne-halter"
    if me.get("pid") and h.get("pid") == me["pid"] and h.get("lstart") == me.get("lstart"):
        return "halter"     # `--pid` ist hier ein nachgewiesener Vorfahr des Aufrufs: der Lauf selbst
    if str(h.get("pid") or "").isdigit() and h.get("lstart") and int(h["pid"]) in ahnen() \
            and bausteine().prozess_lebt(int(h["pid"]), h["lstart"]) is True:
        # Ohne --pid, aber aus dem gebundenen Lauf selbst (PID und Startzeit in der eigenen
        # Elternkette), etwa `gib` im EXIT-Trap: auf peer am 11.10. als "gehoert PID" abgewiesen,
        # der Platz wurde erst nach dem Prozessende frei. Nur der eigene Lauf, nie ein Geschwister.
        return "halter"
    if ist_orchestrator_von(me, h) or ist_vorfahr_pane_von(me, h):
        return "orchestrator"
    if not me.get("pane"):
        art, _pp = ahne_pane(h)     # Aufruf ohne Umgebung (env -i), aber Kind des Halter-Panes
        if art:
            return "halter" if art == "halter" else "orchestrator"
    if ist_mensch():
        return "mensch"
    return ""


def melde_adresse(h):
    """Wohin eine Nachricht an h geht: an seinen Pane; ohne Pane, an eine PID gebunden, an den
    Pane des naechsten Vorfahren mit Pane (lebend gemessen, sonst der bei `nimm` festgehaltene,
    solange dessen Pane-Prozess samt Startzeit lebt). {} = keine Adresse."""
    if h.get("pane") and h.get("socket"):
        return h
    if not h.get("pid"):
        return {}
    k = (str(h["pid"]), h.get("lstart", ""))
    if k in _MELDE:
        return _MELDE[k]
    w, adr = bausteine(), {}
    if w.prozess_lebt(h["pid"], h.get("lstart", "")) is True:
        v, _agent = starter_von(int(h["pid"]), ahnenkette(prozesstabelle(), int(h["pid"])))
        if v.get("pane") and v.get("socket"):
            adr = v
    v = h.get("vorfahr") or {}
    if not adr and v.get("pane") and v.get("socket") and \
            w.prozess_lebt(v.get("pane_pid"), v.get("pane_lstart", "")) is True:
        adr = v
    _MELDE[k] = adr
    return adr


def orchestratoren_von(h):
    """Orchestrator-Panes derselben Sitzungsgruppe auf demselben Server. Ohne eigenen Pane zaehlt
    die Gruppe des Vorfahren-Panes (melde_adresse); dieser selbst bekommt die Halter-Nachricht."""
    if not h.get("pane"):
        h = melde_adresse(h) or h
    if not h.get("sitzung") or not h.get("socket"):
        return []
    rc, aus = bausteine().tmux_ruf(
        ["list-panes", "-a", "-F", "#{pane_id}\t#{session_group}\t#{session_name}\t#{@wb_role}"],
        h["socket"])
    if rc != 0:
        return []
    gesehen, liste = set(), []
    for zeile in aus.splitlines():
        t = (zeile.split("\t") + ["", "", "", ""])[:4]
        gruppe = t[1] or t[2]
        if t[3] != "orchestrator" or gruppe != h["sitzung"] or t[0] == h.get("pane") or t[0] in gesehen:
            continue
        gesehen.add(t[0])
        liste.append({"pane": t[0], "socket": h["socket"], "sitzung": gruppe, "rolle": "orchestrator"})
    return liste


