def nachtragen(e, zweck, art, verweis, frist_s, herkunft):
    """Ein unangemeldeter Start wird zum normalen Eintrag; das Kennzeichen bleibt im Verlauf
    und im Feld 'war_unangemeldet'."""
    w, t = bausteine(), jetzt()
    u = e.pop("unangemeldet")
    u["nachgetragen_iso"] = w.iso(t)
    e.update({"war_unangemeldet": u, "zweck": zweck, "art": art, "verweis": verweis,
              "frist_s": int(round(frist_s)), "bis": t + frist_s, "bis_iso": w.iso(t + frist_s),
              "gemahnt": False, "anfangsfrist_s": int(round(frist_s)), "mensch": not u.get("agent")})
    kennz = "unangemeldet" if u.get("zwang") and u.get("agent") else ""
    verlauf_schreiben("nachgetragen", platz=e.get("platz"), eintrag=e["id"], wer=halter_text(e.get("halter") or {}),
                      zweck=zweck, frist_s=e["frist_s"], frist_herkunft=herkunft, war_zwang=bool(u.get("zwang")),
                      kennzeichen=kennz)
