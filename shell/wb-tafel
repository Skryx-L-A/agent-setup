def befehl_kurz(befehl):
    """Befehlszeile fuer Eintrag und Verlauf: gekuerzt, Geheimnisse ausgeblendet."""
    b = re.sub(r"(?i)((?:token|key|secret|passw(?:or)?d?|pwd|auth|bearer)[\w-]*[=: ]\s*)\S+", r"\1***", befehl or "")
    b = re.sub(r"[A-Za-z0-9+/_=-]{32,}", "…", b)
    return b if len(b) <= BEFEHL_LAENGE else b[:BEFEHL_LAENGE - 1] + "…"


