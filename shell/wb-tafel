def _unit_aus_cgroup(text):
    """Die systemd-Unit eines Prozesses aus dem Inhalt von /proc/<pid>/cgroup, sonst ''. Die letzte
    Pfadstufe, die auf .service oder .scope endet; Anmeldesitzungen (session-N.scope), der
    Benutzerdienst user@<uid>.service und init.scope sind keine Herkunft eines abgeloesten Laufs."""
    for zeile in text.splitlines():
        pfad = zeile.split(":", 2)[-1]
        for stufe in reversed([x for x in pfad.split("/") if x]):
            if not stufe.endswith((".service", ".scope")):
                continue
            if re.match(r"(session-[^/]*\.scope|user@\d+\.service|init\.scope)$", stufe):
                return ""
            return stufe
    return ""


def launchd_herkunft(pids):
    """(Text, Kennung) des Dienstes, dem einer dieser Prozesse gehoert, sonst ('', ''). macOS: der Job
    aus `launchctl list` des Benutzers, dessen PID passt (`procinfo` braucht root). Linux: die
    systemd-Unit aus /proc/<pid>/cgroup. Nur lesen; ein Dienst des Benutzers bleibt eine Fremdlast."""
    pids = [int(x) for x in pids if int(x) > 1]
    if platform.system() == "Darwin":
        try:
            aus = subprocess.run(["launchctl", "list"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return "", ""
        jobs = {}
        for zeile in aus.splitlines():
            teile = zeile.split(None, 2)
            if len(teile) == 3 and teile[0].isdigit():
                jobs[int(teile[0])] = teile[2].strip()
        for q in pids:
            if q in jobs:
                return "launchd-Dienst %s" % jobs[q], "launchd:%s" % jobs[q]
        return "", ""
    for q in pids:
        try:
            with open("/proc/%d/cgroup" % q, encoding="utf-8", errors="replace") as f:
                unit = _unit_aus_cgroup(f.read())
        except OSError:
            continue
        if unit:
            return "systemd-Unit %s" % unit, "systemd:%s" % unit
    return "", ""


