def tmux_server_liste():
    """Server, auf denen der Starter eines Prozesses gesucht wird: der eigene aus $TMUX und
    die Vorgabe (oder WB_TAFEL_TMUX_SOCKETS, durch ':' getrennt)."""
    liste = []
