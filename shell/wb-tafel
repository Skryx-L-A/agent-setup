def starter_von(pid, kette):
    """(halter, agent_rolle): der Pane, unter dem der Prozess laeuft, gemessen ueber die
    Elternkette gegen pane_pid. agent_rolle: ein Pane mit @wb_role worker/orchestrator."""
    w = bausteine()
    linie = [pid] + kette
    fmt = "#{pane_pid}\t#{pane_id}\t#{session_group}\t#{session_name}\t#{@wb_role}\t#{@wb_worker}\t#{socket_path}"
    for sock in tmux_server_liste():
        rc, aus = w.tmux_ruf(["list-panes", "-a", "-F", fmt], sock)
        if rc != 0:
            continue
        karte = {}
        for zeile in aus.splitlines():
            t = (zeile.split("\t") + [""] * 7)[:7]
            if t[0].isdigit():
                karte.setdefault(int(t[0]), t)
        for q in linie:
            if q in karte:
                t = karte[q]
                h = {"pane": t[1], "socket": t[6] or sock, "sitzung": t[2] or t[3], "worker": t[5],
                     "rolle": t[4], "host": os.uname().nodename.split(".")[0], "pane_pid": q,
                     "pane_lstart": w.prozess_lstart(q)}
                return h, t[4] in ("worker", "orchestrator")
    return {"pane": "", "socket": "", "sitzung": "", "worker": "", "rolle": "",
            "host": os.uname().nodename.split(".")[0]}, False


def gedeckt(z, platzname, pid, kette, nachfahren=()):
    """Steht fuer diesen Prozess schon ein Eintrag auf dem Platz? Ja, wenn ein Eintrag an ihn,
    einen Vorfahren oder (mit `nachfahren`) einen Nachfahren gebunden ist (PID, Pane-Prozess)
    oder keinen nachweisbaren Halter hat."""
    linie = set([pid] + kette) | set(nachfahren)
    for e in z["eintraege"]:
        if e.get("platz") != platzname:
            continue
        h = e.get("halter") or {}
        if not nachweisbar(h):
            return e
        if h.get("pid") in linie or h.get("pane_pid") in linie:
            return e
        if (e.get("unangemeldet") or {}).get("pid") in linie:
            return e
    return None


