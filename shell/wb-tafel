def vorschlag_rechnen(dauern):
    """max(p80 x 1,25, p80 + 5 min): 80. Perzentil (naechster Rang) der letzten zehn Dauern
    mit dem Faktor, aber nie weniger als fuenf Minuten Aufschlag (Plan-Regel 1). Ohne den
    Mindestaufschlag bekaeme ein 30-s-Lauf nur 38 s Frist."""
    s = sorted(float(x) for x in dauern[-HISTORIE_LAENGE:])
    k = max(0, int(math.ceil(VORSCHLAG_PERZENTIL / 100.0 * len(s))) - 1)
    return math.ceil(max(s[k] * VORSCHLAG_FAKTOR, s[k] + VORSCHLAG_MIN_AUFSCHLAG_S))


def frist_bestimmen(text, art, z):
    if text is None:
        fehler("--frist ist Pflicht: 90s, 20m, 2h oder 'vorschlag' mit --art. Regel: erwartete "
               "Dauer x 1,5, mindestens erwartete Dauer + 5 min.")
    if text.strip().lower() == "vorschlag":
        if not art:
            fehler("--frist vorschlag braucht --art <schluessel> (etwa gesamtlauf, lokal-modell, "
                   "perf-messung): der Vorschlag kommt aus den Dauern derselben Art.")
        hist = [d for d in (z["dauern"].get(art) or []) if isinstance(d, (int, float)) and d > 0]
        if not hist:
            fehler("keine Historie fuer --art %s: noch kein Eintrag dieser Art wurde regulaer "
                   "ausgetragen. Gib die Frist als Zahl an, etwa --frist 30m (erwartete Dauer x 1,5, "
                   "mindestens + 5 min)." % art)
        return float(vorschlag_rechnen(hist)), "vorschlag aus %d Dauern" % len(hist[-HISTORIE_LAENGE:])
    return dauer_lesen(text, "--frist"), ""


