def dauer_lesen(text, name):
    """'90s', '20m', '2h', '1h30m' -> Sekunden. Eine nackte Zahl wird abgewiesen."""
    t = (text or "").strip().lower()
    muster = r"(\d+(?:[.,]\d+)?)\s*([smhd])"
    teile = re.findall(muster, t)
    if not t or not teile or re.sub(muster, "", t).strip():
        fehler("%s: '%s' ist keine Dauer. Geschrieben wird 90s, 20m, 2h oder 1h30m "
               "(eine nackte Zahl ist mehrdeutig)." % (name, text))
    faktor = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    s = sum(float(z.replace(",", ".")) * faktor[e] for z, e in teile)
    if math.isnan(s) or math.isinf(s) or s <= 0:
        fehler("%s: '%s' ergibt keine positive Dauer." % (name, text))
    return s


def dauer_text(s):
    s = int(round(max(0.0, float(s))))
    if s >= 3600:
        return "%dh%02dm" % (s // 3600, (s % 3600) // 60)
    if s >= 60:
        return "%dm%02ds" % (s // 60, s % 60) if s % 60 else "%dm" % (s // 60)
    return "%ds" % s


def menge_text(m):
    m = float(m)
    return ("%d" % m) if m == int(m) else ("%.1f" % m).replace(".", ",")


