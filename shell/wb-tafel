def waechter_starten(e, pruefen=False):
    """Mit Pane: wb-nohup, Eigentuemer der Pane. Ohne Pane (launchd, --maschine, Skript ohne
    tmux): wb-nohup kennt nur drei Eigentuemer -- Pane, eigener launchd-Job (--launchd, Praefix
    agent-workbench., muss Vorfahr sein), Werkbank-Programm --, einen Prozess als Eigentuemer
    nicht. Nennt der Aufruf einen eigenen launchd-Job (WB_EIGENTUEMER_LAUNCHD, wie ihn der
    Modell-Proxy weiterreicht), geht der Waechter mit --launchd ueber wb-nohup. Sonst startet die
    Tafel ihn selbst abgeloest, mit dem gebundenen PROZESS als Eigentuemer: der Waechter endet,
    sobald der Eintrag weg ist, und der Eintrag verfaellt spaetestens mit diesem Prozess
    (oder nach dem Abbruch). Das ist dieselbe Bindung, die wb-nohup festhielte, nur von der
    Tafel selbst eingehalten; Ergebnis und Art stehen im Verlauf.

    `pruefen` (exklusiver Platz mit Stoerungspruefung): auch ein Eintrag NUR mit Pane bekommt einen
    Waechter (ueber wb-nohup, Eigentuemer der Pane); er tastet die Prozesse ab (STOERUNGEN) und
    endet mit dem Eintrag oder dem Pane. Ohne Pane und ohne PID gibt es keinen."""
    h = e.get("halter") or {}
    if not (h.get("pid") and e.get("bis") is not None) and not (pruefen and h.get("pane")):
        return
    if waechter_laeuft(e["id"]):
        return
    log = os.path.join(STATE_DIR, "waechter-%s.log" % e["id"])
    kern = [sys.executable, os.path.realpath(__file__), "waechter", e["id"]]
    zusatz, eigentuemer = [], "pane"
    if not h.get("pane"):
        # Nur die Variable, die wb-nohup selbst kennt. XPC_SERVICE_NAME taugt nicht: der
        # python3-Stub von macOS setzt sie auf "0" (gemessen 2026-10-09).
        label = os.environ.get("WB_EIGENTUEMER_LAUNCHD", "")
        if label.startswith("agent-workbench."):
            zusatz, eigentuemer = ["--launchd", label], "launchd:" + label
    nohup = nohup_pfad()
    rc, aus = None, "wb-nohup nicht gefunden"
    if nohup and (h.get("pane") or zusatz):
        befehl = [nohup, "tafel-waechter-%s" % e["id"], "--log", log] + zusatz + ["--"] + kern
        try:
            p = subprocess.run(befehl, capture_output=True, text=True, timeout=20, stdin=subprocess.DEVNULL)
            rc, aus = p.returncode, (p.stdout.strip() or p.stderr.strip())
        except (OSError, subprocess.SubprocessError) as x:
            rc, aus = -1, str(x)
        if rc == 0:
            verlauf_schreiben("waechter", eintrag=e["id"], pid=aus.splitlines()[-1] if aus else "",
                              eigentuemer=eigentuemer)
            return
    if h.get("pane"):
        verlauf_schreiben("kein-waechter", eintrag=e["id"], rc=rc,
                          grund="wb-nohup: %s; Fristen nur lazy" % (aus.splitlines()[-1] if aus else "?"))
        return
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(log, "ab") as f:
            kind = subprocess.Popen(kern, stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT,
                                    start_new_session=True, close_fds=True)
        verlauf_schreiben("waechter", eintrag=e["id"], pid=kind.pid,
                          eigentuemer="prozess:%s" % h["pid"],
                          grund=("" if rc is None else "wb-nohup --launchd scheiterte: %s"
                                 % (aus.splitlines()[-1] if aus else "?")))
    except OSError as x:
        verlauf_schreiben("kein-waechter", eintrag=e["id"], grund="Start ohne Pane: %s; Fristen nur lazy" % x)


def naechster_termin(e, t):
    if e.get("bis") is None:
        return t + WAECHTER_TAKT_S
    bis, g = float(e["bis"]), gnade_s(e)
    termine = []
    if not e.get("gemahnt") and t < bis:
        termine.append(mahnzeit(e))
    if not e.get("frist_gemeldet"):
        termine.append(bis)
    if not e.get("gnade_gemeldet"):
        termine.append(bis + g / 2)
    ab = e.get("abbruch")
    if not ab:
        termine.append(bis + g)
    elif not ab.get("kill_zeit"):
        termine.append(float(ab["term_zeit"]) + float(e.get("abbruch_kill_s", KILL_NACH_S)))
    else:
        termine.append(float(ab["kill_zeit"]) + ABBRUCH_AUFGABE_S)
    return min(termine)


def cmd_waechter(a, cfg, maschine):
    w = bausteine()
    abtaster = None
    while True:
        z = zustand_lesen()
        e = next((x for x in z["eintraege"] if x.get("id") == a.eintrag), None)
        if e is None:
            return EXIT_OK
        t = jetzt()
        h = e.get("halter") or {}
        tot = bool(h.get("pid")) and w.prozess_lebt(h["pid"], h.get("lstart", "")) is False \
            and not abbruch_offen(e)
        p = stoerung_platz(cfg, maschine, e)
        if p and not tot and not h.get("pid") and h.get("pane"):
            tot = halter_lebt(h, {}) is False       # Pane weg: Eintrag verfaellt, der Waechter endet
        termin = naechster_termin(e, t)
        if tot or t >= termin:
            with sperre():
                z, nachrichten, _ = sitzung(cfg, maschine)
                zustand_schreiben(z)
            zustellen(nachrichten, None)
            continue
        if p:
            # Stoerungen: nur melden (STOERUNGEN im Kopf). Je Lauf einmal ausgewertet.
            if abtaster is None:
                abtaster = Abtaster(p, t)
            if t >= abtaster.naechste:
                funde = [f for f in abtaster.abtasten(e, z, t) if f["wurzel"] not in abtaster.gemeldet]
                if funde:
                    stoerung_melden(e["id"], funde)
                    abtaster.gemeldet |= set(f["wurzel"] for f in funde)
                t = jetzt()
            termin = min(termin, abtaster.naechste)
        time.sleep(max(0.05, min(WAECHTER_TAKT_S, termin - t)))


