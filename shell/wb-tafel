ABBRUCH_AUFGABE_S = 10       # lebt der Prozess so lange nach SIGKILL noch, wird nur noch gemeldet
WAECHTER_TAKT_S = 2.0        # der Waechter sieht so oft nach, ob Eintrag und Prozess noch da sind
ERLAUBNIS_S = 120            # Einmal-Erlaubnis 'trotzdem' (Commit in einen gehaltenen Hauptbaum)
EXIT_WARNEN = 6              # pruefe-commit: Commit darf, Warnung zeigen
# Stoerungen waehrend eines exklusiven Platzes (Auftrag tafel-waechter, 2026-10-10), je Platz
