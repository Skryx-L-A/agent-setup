def belegung_pfad():
    p = os.environ.get("WB_TAFEL_BELEGUNG", "")
    kandidaten = [p] if p else [os.path.join(HIER, "wb-belegung"), shutil.which("wb-belegung") or "",
                                os.path.join(HOME, ".local", "bin", "wb-belegung")]
    for k in kandidaten:
        if k and os.path.isfile(k) and os.access(k, os.X_OK):
            return k
    return ""


def bausteine():
    """wb-belegung als Modul: Sperre, atomares Schreiben, Halter aus Pane/Unit,
    Pane-/Prozess-/Unit-Lebendigkeit, Menschen-Nachweis. Wiederverwendet statt kopiert,
    damit beide Werkzeuge dieselbe Lebendigkeit sehen."""
    global WBB
    if WBB is not None:
        return WBB
    pfad = belegung_pfad()
    if not pfad:
        fehler("wb-belegung nicht gefunden (neben wb-tafel, im PATH oder in ~/.local/bin) -- "
               "die Tafel nutzt dessen Sperre und Lebendigkeitspruefung.", EXIT_DIENST)
    sys.dont_write_bytecode = True      # kein __pycache__ neben ~/.local/bin/wb-belegung
    loader = SourceFileLoader("wb_belegung_baustein", pfad)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    mod.fehler = fehler                 # Meldungen der Bausteine tragen diesen Namen
    WBB = mod
    return mod


def sperre():
    w = bausteine()
    try:
        return w.Sperre(SPERRFRIST_S, pfad=SPERRDATEI)
    except TypeError:
        # Aeltere wb-belegung (vor 2026-10-09) kennt 'pfad' nicht: ihre Sperre liest dann die
        # Modulwerte, und die zeigen in diesem Prozess auf die Tafel (das Belegungsbuch selbst
        # fasst wb-tafel nie ueber das Modul an, nur ueber den Befehl wb-belegung).
        w.STATE_DIR, w.SPERRDATEI = STATE_DIR, SPERRDATEI
        return w.Sperre(SPERRFRIST_S)


