    und haengt dort am gestarteten Prozess (`geladen --pid --prozess-haelt`), verfaellt also mit
    ihm. Menge: die angegebene (melde-start --menge, der Starter kennt sein Modell), sonst
    max(gemessener RSS des Prozessbaums, 'zwang_menge' der Platzdefinition) -- RSS allein
    unterschaetzt Metal-Speicher, die Platzzahl ist die bekannte Untergrenze des Musters.
    Gefragt wird mit --ohne-messung: der laufende Prozess steckt schon in der Messung, Grenze A
    zaehlte ihn doppelt. Sagt das Buch trotzdem nein, wird nichts erzwungen (das darf nur der
    Mensch), sondern laut gemeldet."""
    u = e["unangemeldet"]
    gemessen = baum_rss_gib(u["pid"])
    if angegeben and angegeben > 0:
        gib, herkunft = float(angegeben), "angegeben"
    else:
        gib = max(gemessen, float(p.get("zwang_menge") or 0))
        herkunft = "gemessen (RSS des Prozessbaums)" if gemessen >= float(p.get("zwang_menge") or 0) \
            else "Platzdefinition (zwang_menge)"
    gib = math.ceil(gib * 10.0) / 10.0
    u["zwang_menge"] = {"gib": gib, "herkunft": herkunft, "gemessen_gib": round(gemessen, 2)}
    if gib <= 0:
        verlauf_schreiben("zwangsbuchung-ohne-menge", platz=p["name"], eintrag=e["id"], pid=u["pid"],
                          grund="weder angegeben noch messbar noch in der Platzdefinition")
        return
    e["menge"] = gib
    zweck = "wb-tafel %s: unangemeldet %s" % (e["id"], u.get("befehl", ""))
    rc, aus, err = belegung_ruf(["nimm", "--gb", "%.3f" % gib, "--zweck", zweck[:200], "--ohne-messung",
                                 "--frist", str(ZWANG_BUCHUNG_FRIST_MIN), "--json"])
    try:
        d = json.loads(aus)
    except ValueError:
        d = {}
    kennung = d.get("kennung") if rc == 0 else None
    if not kennung:
        grund = d.get("grund") or (err or aus).strip()[-200:] or ("Exit %s" % rc)
        u["zwang_menge"]["abgelehnt"] = grund
        verlauf_schreiben("zwangsbuchung-abgelehnt", platz=p["name"], eintrag=e["id"], pid=u["pid"],
                          menge=gib, rc=rc, grund=grund)
        an_gruppe_tafel("zwangsbuchung", "zwangsbuchung ABGELEHNT: %s %s -- %s GiB fuer PID %s passen "
                        "nicht ins Belegungsbuch (%s). Der Prozess laeuft trotzdem." % (
                            p["name"], e["id"], menge_text(gib), u["pid"], grund),
                        platz=p["name"], eintrag=e["id"])
        for o in orchestratoren_von(e.get("halter") or {}):
            nachrichten.append(nachricht(o, "wb-tafel: unangemeldeter Start %s auf %s braucht %s GiB, das "
                                         "Belegungsbuch sagt nein (%s). Der Prozess (PID %s) laeuft." % (
                                             e["id"], p["name"], menge_text(gib), grund, u["pid"]),
                                         "zwangsbuchung", e["id"]))
        return
    e["belegung"] = kennung
    rc2, aus2, err2 = belegung_ruf(["geladen", kennung, "--pid", str(u["pid"]), "--prozess-haelt"])
    verlauf_schreiben("zwangsbuchung", platz=p["name"], eintrag=e["id"], pid=u["pid"], menge=gib,
                      belegung=kennung, herkunft=herkunft, prozess_haelt=(rc2 == 0),
                      grund=("" if rc2 == 0 else (err2 or aus2).strip()[-200:]))
    an_gruppe_tafel("zwangsbuchung", "zwangsbuchung: %s %s -- %s GiB (%s) in wb-belegung %s, haengt an PID %s"
                    % (p["name"], e["id"], menge_text(gib), herkunft, kennung, u["pid"]),
                    platz=p["name"], eintrag=e["id"])


