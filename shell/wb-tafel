    s = " ".join(bausteine().prozess_lstart(pid).split())
    try:
        return time.mktime(time.strptime(s, "%a %b %d %H:%M:%S %Y"))
    except (ValueError, OverflowError):
        return None


def _sitzung(pid):
    try:
        return os.getsid(int(pid))
    except (OSError, ValueError):
        return 0


def _eigene_sitzungen(tab, halt, linie):
    """Die Session-IDs, die eine Linie selbst angelegt hat: die Sitzung eines Linienprozesses zaehlt
    nur, wenn ihr Fuehrer dieser Prozess ist (der Pane-Prozess) oder ein Vorfahr unterhalb der
    naechsten Sitzungsgrenze (Pane-Prozess, Harness, tmux-Server). Claude Code legt jeden Befehl in
    eine eigene Sitzung (gemessen 10.10.: sid = PID des `zsh -c`); die Sitzung eines Aufrufers, der
    selbst nur Gast einer fremden Anmeldesitzung ist, zaehlt nicht."""
    sids = set()
    for a in linie:
        s = _sitzung(a) if a in tab else 0
        q = a
        for _ in range(64):
            if s <= 1:
                break
            if q == s:
                sids.add(s)
                break
            if q in halt or q <= 1:
                break
            q = tab.get(q, (0,))[0]
    return sids


def _panes_von(h):
    v = h.get("vorfahr") or {}
    return set((x.get("pane"), x.get("socket")) for x in (h, v) if x.get("pane"))


# Kennung der Tafel in der Umgebung eines Laufs (Auftrag tafel-abgeloest, 2026-10-11): run-all.sh
# exportiert die Kennungen seiner Eintraege (WB_TAFEL_EINTRAG=<id[,id]>) in jede Suite. Suiten, die
# die App ueber shell/tests/start-detached.py starten (setsid + Doppel-Fork, PPID 1, eigene
# Session-ID), haengen weder an der Elternkette noch an der Sitzung des Halters; die Umgebung erbt
# der Prozess trotzdem (gemessen 11.10.: node-Wrapper UND Electron-Hauptprozess).
KENNUNG_VAR = "WB_TAFEL_EINTRAG"
KENNUNG_MUSTER = re.compile(r"(?:^|[\s\0])" + KENNUNG_VAR + r"=([A-Za-z0-9,]+)(?=[\s\0]|$)")
TEST_TMUX_SOCKEL = re.compile(r"\s-L\s*wbtest-[A-Za-z0-9._-]+(?=\s|$)")   # Socket eines Test-tmux-Servers
KENNUNG_PROZESSE = 8       # je Lauf hoechstens so viele Mitglieder nach der Umgebung fragen


def umgebung_kennungen(pid):
    """Die Kennungen aus WB_TAFEL_EINTRAG in der Umgebung von <pid> (nur lesen), sonst []. Linux:
    /proc/<pid>/environ (NUL-getrennt, genau). macOS: `ps -E -ww -o command=` haengt die Umgebung
    an die Befehlszeile (gemessen 11.10.: sichtbar fuer node und Electron, nicht fuer Programme der
    Plattform wie /bin/sh -- dort bleibt der Lauf ohne Kennung und wird wie bisher gemeldet)."""
    try:
        if sys.platform == "darwin":
            env = dict(os.environ)
            env["LC_ALL"] = "C"
            text = subprocess.run(["ps", "-E", "-ww", "-o", "command=", "-p", str(int(pid))],
                                  capture_output=True, text=True, timeout=5, env=env).stdout
        else:
            with open("/proc/%d/environ" % int(pid), "rb") as f:
                text = f.read().decode("utf-8", "replace")
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    kennungen = []
    for m in KENNUNG_MUSTER.finditer(text):
        kennungen += [k for k in m.group(1).split(",") if k]
    return kennungen


class Abtaster:
    """Merkt sich je Lauf (Wurzel eines Prozessbaums) CPU-Zeit und Speicher ueber die Zeit.

    Ein LAUF ist der oberste Prozess unterhalb eines Pane-Prozesses, eines Harness (claude, pi,
    codex, ...) oder des tmux-Servers -- also ein Befehl einer Sitzung samt allem, was er startet --
    oder, abgeloest (PPID 1, nohup, wb-nohup), der abgeloeste Prozess samt Baum. Seine Last ist die
    Summe ueber die lebenden Mitglieder, jedes mit seinen beerbten Kindern (prozess_last); so zaehlt
    auch ein Testlauf aus vielen kurzen Prozessen."""

    def __init__(self, p, beginn):
        self.p = p
        self.beginn = beginn
        self.verlauf = {}       # wurzel -> [(t, cpu_s, bytes)]
        self.basis = {}         # wurzel -> Speicher beim ersten Messwert (0, wenn nach Beginn gestartet)
        self.erstmals = {}      # wurzel -> erste Sichtung
        self.naechste = 0.0
        self.erster_lauf = True
        self.gemeldet = set()   # Wurzeln, schon ausgewertet (dauerhaft je Verursacher: e['stoerungen'])
        self.startzeiten = {}   # abgeloeste Wurzel -> Startzeit (Epoche), einmal gemessen
        self.kennung_ok = set()  # Wurzeln, die eine gueltige Kennung tragen (Umgebung aendert sich nicht)

    def abtasten(self, e, z, t):
        p = self.p
        self.naechste = t + p["stoerung_takt_s"]
        tab = last_tabelle()
        if not tab:
            return []
        uid = os.getuid()
        halt = (pane_prozesse() | {0, 1})
        namen = harness_namen() | {"tmux"}
        for q, (_pp, _u, b) in tab.items():
            if any(os.path.basename(x) in namen for x in b.split()[:2]):
                halt.add(q)
        # Nur der Waechter und seine eigenen Kinder (ps, lsof). NICHT seine Vorfahren: solange wb-nohup
        # noch laeuft, stuenden darin der Pane des Halters und der tmux-Server (gemessen 2026-10-10:
        # mit ahnen() fiel jeder Pane-Lauf heraus).
        schutz = {os.getpid()}
        h = e.get("halter") or {}
        eigen_linie, eigen_panes = _linie(h), _panes_von(h)
        deck_linie, deck_panes = set(), set()
        # Sitzungen (Session-ID, Beginn des Eintrags) fuer abgeloeste Prozesse, siehe sitzung_deckt.
        sitzungen = [(_eigene_sitzungen(tab, halt, eigen_linie), float(e.get("seit") or t))]
        for x in z["eintraege"]:
            if x.get("id") == e.get("id") or x.get("platz_art") == "zustaendigkeit":
                continue
            xh = x.get("halter") or {}
            xl = _linie(xh)
            deck_linie |= xl | set(int(u["pid"]) for u in [x.get("unangemeldet") or {}] if u.get("pid"))
            deck_panes |= _panes_von(xh)
            sitzungen.append((_eigene_sitzungen(tab, halt, xl), float(x.get("seit") or t)))
        laeufe = {}
        for q, (pp, u, b) in tab.items():
            if u != uid or q in halt or q in schutz \
                    or os.path.basename((ausgefuehrtes_programm(b) or b).split(" ")[0]) == "wb-tafel":
                continue            # fremde Nutzer, Sitzungen, die Tafel selbst
            kette = ahnenkette(tab, q)
            if schutz & set(kette):
                continue            # Kinder des Waechters (ps, lsof)
            wurzel = q
            for v in kette:
                if v in halt:
                    break
                wurzel = v
            laeufe.setdefault(wurzel, []).append(q)
        aktiv = set()
        funde = []
        for wurzel, mitglieder in laeufe.items():
            kette = ahnenkette(tab, wurzel)
            abgeloest = tab.get(wurzel, (0,))[0] in (0, 1)
            befehl = tab.get(wurzel, (0, 0, ""))[2]
            if abgeloest and ist_systemprozess(befehl):
                continue
            programm = ausgefuehrtes_programm(befehl) or befehl
            if any(re.search(m, programm) for m in p["stoerung_ausnahmen"]):
                continue
            linie = set(kette) | set(mitglieder) | {wurzel}
            if linie & eigen_linie:
                continue            # der Halter selbst, sein Lauf oder dessen Nachfahre
            if linie & deck_linie:
                continue            # ein anderer Eintrag deckt ihn
            if abgeloest and self.sitzung_deckt(wurzel, sitzungen):
                continue            # abgeloest, aber aus der Sitzung eines Halters und nach dessen Beginn
            last = [prozess_last(q) for q in mitglieder]
            cpu = sum(x[0] for x in last if x)
            speicher = sum(x[1] for x in last if x)
            # Genannt wird der groesste Verbraucher: die Wurzel ist oft nur eine Huelle (zsh -c, Subshell).
            groesster = max(range(len(mitglieder)), key=lambda i: (last[i] or (0, 0))[0])
            aktiv.add(wurzel)
            if wurzel not in self.verlauf:
                self.verlauf[wurzel] = []
                self.erstmals[wurzel] = t
                self.basis[wurzel] = speicher if self.erster_lauf else 0
            reihe = self.verlauf[wurzel]
            reihe.append((t, cpu, speicher))
            while len(reihe) > 2 and reihe[1][0] <= t - p["stoerung_dauer_s"]:
                reihe.pop(0)
            urteil = self.urteil(wurzel, reihe, t)
            # Erst fuer einen Lauf, der sonst gemeldet wuerde: die Umgebung zu lesen kostet je Mitglied ein ps.
            if urteil and (wurzel in self.kennung_ok or self.kennung_deckt(
                    list(dict.fromkeys([wurzel, mitglieder[groesster]] + mitglieder)), z, tab, kette)):
                self.kennung_ok.add(wurzel)
                urteil = None       # traegt die Kennung eines lebenden Eintrags und startete danach
            if urteil:
                funde.append(dict(urteil, wurzel=wurzel, befehl=befehl, kette=kette, abgeloest=abgeloest,
                                  programm=tab.get(mitglieder[groesster], (0, 0, befehl))[2],
                                  eigen_panes=eigen_panes, deck_panes=deck_panes))
        for weg in set(self.startzeiten) - set(laeufe):
            self.startzeiten.pop(weg, None)
        self.kennung_ok &= set(laeufe)
        for weg in set(self.verlauf) - aktiv:
            self.verlauf.pop(weg, None)
            self.basis.pop(weg, None)
            self.erstmals.pop(weg, None)
        self.erster_lauf = False
        return funde

    def sitzung_deckt(self, wurzel, sitzungen):
        """Ein abgeloester Prozess (PPID 1) gehoert belegbar zu einem Halter, wenn er in einer Sitzung
        laeuft, die die Linie des Halters selbst angelegt hat (_eigene_sitzungen), und nach Beginn des
        Eintrags startete. Die Session-ID erbt nur, wer von einem Mitglied der Sitzung abstammt; ein
        Prozess, der sich mit setsid loest, faellt heraus und bleibt Fremdlast. Gleicher
        Arbeitsordner allein zaehlt nie."""
        s = _sitzung(wurzel)
        passend = [seit for sids, seit in sitzungen if s > 1 and s in sids]
        if not passend:
            return False
        if wurzel not in self.startzeiten:
            self.startzeiten[wurzel] = _startzeit(wurzel)
        start = self.startzeiten[wurzel]
        return start is not None and any(start >= seit - 1 for seit in passend)

    @staticmethod
    def _kennung_eintrag(q, lebend):
        """Der LEBENDE Eintrag, dessen Kennung in der Umgebung von <q> steht, dessen Halter lebt und der
        vor dem Start von <q> begann; sonst None."""
        for k in umgebung_kennungen(q):
            x = lebend.get(k)
            if not x:
                continue
            if halter_lebt(x.get("halter") or {}, {}) is False:
                continue
            start = _startzeit(q)
            if start is not None and start >= float(x.get("seit") or 0) - 1:
                return x
        return None

    def kennung_deckt(self, pids, z, tab=None, kette=()):
        """Ein Prozess des Laufs traegt in seiner Umgebung die Kennung eines LEBENDEN Eintrags dieser
        Tafel (WB_TAFEL_EINTRAG, von run-all.sh exportiert), dessen Halter lebt, und startete nach
        Beginn dieses Eintrags. Entscheidung (11.10.2026): Arbeitsordner und Sitzung werden NICHT
        zusaetzlich verlangt. Die Sitzung kann es nicht sein: start-detached.py loest sich mit
        setsid absichtlich von ihr, das ist der Fall, den die Kennung abdeckt. Der Arbeitsordner
        ist kein Beleg: Suiten wechseln in ihr Testverzeichnis. Was die Kennung haelt, sind drei
        Bedingungen, die Zufall und Altlasten ausschliessen: die Kennung gibt es in DIESEM Zustand
        (fremde Maschine, anderer Zustandsordner, beendeter Eintrag: nein), der Halter lebt, und der
        Prozess ist juenger als der Eintrag (ein Prozess, der vor dem Eintrag lief, erbte sie nicht
        von dessen Lauf). Grenze: eine Umgebungsvariable kann jeder setzen; wer sie faelscht, wird
        hoechstens nicht gemeldet. Der Waechter meldet nur, er beendet nichts.

        Nachtrag 2 (kennung-electron, 11.10.2026): /bin/zsh und /bin/sh sind Programme der Plattform,
        `ps -E` zeigt ihre Umgebung nie -- eine Shell in einem Test-tmux-Server (Homebrew-tmux, sichtbar)
        wuerde trotz Kennung gemeldet. Der tmux-Server erbt die Umgebung vom startenden Client
        (gemessen 11.10.): fuer den Lauf zaehlt dann die Umgebung des naechsten Vorfahren in <kette>,
        der ein TEST-tmux-Server ist (Programm tmux, Socket -L wbtest-*), mit denselben drei
        Bedingungen fuer Server UND Lauf. Nie ein anderer tmux-Server: Panes in Werkbank des Nutzers und
        die Server der Worker bleiben Fremdlast, ihre Last wird weiter gemeldet."""
        lebend = {x.get("id"): x for x in z["eintraege"] if x.get("id")}
        for q in pids[:KENNUNG_PROZESSE]:
            if self._kennung_eintrag(q, lebend):
                return True
        if tab and pids:
            for v in kette:
                befehl = tab.get(v, (0, 0, ""))[2]
                if os.path.basename(befehl.split(" ")[0]) != "tmux":
                    continue
                if not TEST_TMUX_SOCKEL.search(befehl):
                    return False        # der nächste tmux-Server ist keiner der Tests: kein Weitergehen
                x = self._kennung_eintrag(v, lebend)
                start = _startzeit(pids[0])
                return bool(x) and start is not None and start >= float(x.get("seit") or 0) - 1
        return False

    def urteil(self, wurzel, reihe, t):
        """Schwer: ueber mindestens stoerung_dauer_s im Mittel ueber der CPU-Schwelle und in
        mindestens STOERUNG_ANTEIL der Abtastabstaende selbst darueber -- oder der Speicher liegt
        die ganze Dauer ueber um stoerung_ram_mib ueber dem ersten Messwert. Eine kurze Spitze
        reicht nie."""
        p = self.p
        if len(reihe) < 2 or t - reihe[0][0] < p["stoerung_dauer_s"]:
            return None
        t0, c0, _s0 = reihe[0]
        mittel = max(0.0, reihe[-1][1] - c0) / max(1e-6, t - t0)
        stufen = [max(0.0, b[1] - a[1]) / max(1e-6, b[0] - a[0]) for a, b in zip(reihe, reihe[1:])]
        ueber = sum(1 for x in stufen if x >= p["stoerung_cpu"])
        cpu_schwer = mittel >= p["stoerung_cpu"] and ueber >= STOERUNG_ANTEIL * len(stufen)
        zuwachs = [s - self.basis.get(wurzel, 0) for _t, _c, s in reihe]
        ram_schwer = min(zuwachs) >= p["stoerung_ram_mib"] * 1048576
        if not (cpu_schwer or ram_schwer):
            return None
        return {"cpu": round(mittel, 2), "zuwachs_mib": int(max(zuwachs) / 1048576),
                "grund": "CPU" if cpu_schwer else "Speicher", "seit": self.erstmals.get(wurzel, t0),
                "dauer_s": p["stoerung_dauer_s"]}


def verursacher(f):
    """(adresse, schluessel, herkunft): an wen die Meldung an den Verursacher geht ({} = keiner
    belegt) und wie die Herkunft belegt ist. Unter einem Pane: der Pane aus der Elternkette.
    Abgeloest: die wb-nohup-Registrierung (Starter-Pane); dann ein launchd-Dienst bzw. eine
    systemd-Unit (benannt, kein Pane); sonst nur Startzeit, Arbeitsordner und
    Befehlszeile -- ein Pane mit demselben Arbeitsordner wird als Vermutung genannt, nie angeschrieben."""
    w = bausteine()
    wurzel = f["wurzel"]
    if not f["abgeloest"]:
        h, _agent = starter_von(wurzel, f["kette"])
        if h.get("pane"):
            return h, schluessel(h), "belegt: Prozessbaum unter Pane %s (%s)" % (h["pane"], halter_text(h))
        return {}, "pid:%d" % wurzel, "unbekannt (kein Pane in der Elternkette)"
    reg = nohup_eintrag(wurzel)
    panes = nohup_panes(reg) if reg else []
    if panes:
        pane, sock = panes[0]
        h = {"pane": pane, "socket": sock, "worker": reg.get("worker", "")}
        return h, schluessel(h), "belegt: wb-nohup '%s', gestartet von Pane %s" % (reg.get("name", "?"), pane)
    cwd = arbeitsordner(wurzel)
    start = w.prozess_lstart(wurzel)
    dienst, dienst_key = launchd_herkunft([wurzel] + list(f["kette"]))
    if dienst:
        return {}, dienst_key, ("belegt: %s (abgeloest, PPID 1, gestartet %s, Arbeitsordner %s), "
                                "Fremdlast des Benutzers, kein Pane" % (dienst, start or "?", cwd or "?"))
    vermutet = []
    if cwd:
        for sock in tmux_server_liste():
            rc, aus = w.tmux_ruf(["list-panes", "-a", "-F", "#{pane_id}\t#{pane_current_path}"], sock)
            if rc == 0:
                vermutet += [z.split("\t")[0] for z in aus.splitlines() if z.split("\t")[1:2] == [cwd]]
    return {}, "pid:%d" % wurzel, ("unbekannt (abgeloest, PPID 1, gestartet %s, Arbeitsordner %s%s)"
                                   % (start or "?", cwd or "?",
                                      ("; vermutlich Pane %s, gleicher Arbeitsordner" % vermutet[0])
                                      if len(vermutet) == 1 else ""))


def stoerung_melden(eintrag_id, funde):
    """Je Verursacher und Platz einmal je Eintrag: Meldung an den Halter, an den Verursacher
    (wenn belegt) und die Gruppe tafel, Ereignis 'stoerung' im Verlauf. Beendet nichts."""
    vorbereitet = []
    for f in funde:
        adr, key, herkunft = verursacher(f)
        if adr and ((adr.get("pane"), adr.get("socket")) in f["eigen_panes"]):
            continue            # abgeloester Lauf des Halters selbst (wb-nohup)
        if adr and ((adr.get("pane"), adr.get("socket")) in f["deck_panes"]):
            continue
        vorbereitet.append((f, adr, key, herkunft))
    if not vorbereitet:
        return []
    nachrichten, gemeldet = [], []
    with sperre():
        z = zustand_lesen()
        e = next((x for x in z["eintraege"] if x.get("id") == eintrag_id), None)
        if e is None:
            return []
        schon = set(s.get("schluessel") for s in e.get("stoerungen") or [])
        t = jetzt()
        h = e.get("halter") or {}
        for f, adr, key, herkunft in vorbereitet:
            if key in schon:
                continue
            schon.add(key)
            von = max(float(e["seit"]), float(f["seit"]))
            kurz = befehl_kurz(f["programm"])
            last = ("%.2f Kerne CPU" % f["cpu"]) if f["grund"] == "CPU" else ("+%d MiB Speicher" % f["zuwachs_mib"])
            e.setdefault("stoerungen", []).append({"schluessel": key, "pid": f["wurzel"], "zeit_iso": bausteine().iso(t)})
            verlauf_schreiben("stoerung", platz=e.get("platz"), eintrag=e["id"], von_iso=bausteine().iso(von),
                              bis_iso=bausteine().iso(t), programm=kurz, pid=f["wurzel"],
                              wurzel=befehl_kurz(f["befehl"]), grund=f["grund"],
                              cpu=f["cpu"], zuwachs_mib=f["zuwachs_mib"], pane=(adr or {}).get("pane", ""),
                              verursacher=herkunft, halter=halter_text(h))
            an_gruppe_tafel("stoerung", "stoerung: %s %s -- '%s' (PID %s, %s) ohne Eintrag, %s"
                            % (e.get("platz"), e["id"], kurz, f["wurzel"], last, herkunft),
                            platz=e.get("platz"), eintrag=e["id"])
            nachrichten.append(nachricht(h, (
                "wb-tafel: STOERUNG -- Deine Messung auf %s (%s, %s) im Fenster %s-%s moeglicherweise gestoert "
                "durch '%s' (PID %s, %s ueber mindestens %s), ohne Tafel-Eintrag. Verursacher: %s. Die Tafel "
                "beendet nichts; Messwerte aus diesem Fenster pruefen." % (
                    e.get("platz"), e["id"], e.get("zweck", ""), uhrzeit(von), uhrzeit(t), kurz, f["wurzel"],
                    last, dauer_text(f["dauer_s"]), herkunft)), "stoerung", e["id"]))
            if adr:
                nachrichten.append(nachricht(adr, (
                    "wb-tafel: Du laeufst ohne Eintrag ('%s', PID %s, %s), waehrend %s den exklusiven Platz %s "
                    "haelt (%s, bis %s). Schwere Laeufe erst nach einem Eintrag starten und das Ergebnis "
                    "pruefen: wb-tafel nimm <platz> --frist <dauer> --zweck \"<satz>\" --anstellen --warte <dauer> "
                    "&& <lauf>. Nichts wurde beendet." % (
                        kurz, f["wurzel"], last, halter_text(h), e.get("platz"), e.get("zweck", ""),
                        uhrzeit(float(e["bis"])) if e.get("bis") is not None else "?")), "stoerung", e["id"]))
            gemeldet.append(key)
        zustand_schreiben(z)
    zustellen(nachrichten, None)
    return gemeldet



