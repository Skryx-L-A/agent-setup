# Muster laufen nur auf das AUSGEFUEHRTE Programm samt seinen Argumenten, nie auf die ganze
# Befehlszeile: `zsh -c '... run-all.sh ...'` ist kein Lauf von run-all.sh, nur ein Wort im -c-Text.
# Huellen, die ein Programm davorsetzen (Wert-Optionen je Huelle), und Interpreter, deren erstes
# Nicht-Options-Argument das Skript ist. Alles Unklare (-c/-e Text, unbekannte Option vor dem
# Skript) ist KEIN Programm: lieber ein Start zu wenig erkannt als eine fremde Huelle erfasst.
HUELLEN_WERTOPTIONEN = {
    "env": {"-u", "-C", "-P", "-S"}, "nice": {"-n"}, "nohup": set(), "timeout": {"-s", "-k"},
    "time": {"-o", "-f"}, "exec": set(), "command": set(), "caffeinate": {"-t", "-w"},
    "setsid": set(), "ionice": {"-c", "-n", "-p"}, "arch": set(),
}
# Gross/klein egal: `/usr/bin/python3` startet unter macOS die Python.app, deren Prozess "Python" heisst.
INTERPRETER = re.compile(r"^(python[0-9.]*|bash|sh|zsh|dash|ksh|fish|node|nodejs|deno|bun|perl|ruby)$", re.I)
_SCHALTER_OHNE_WERT = re.compile(r"-[xeuvBEsSIlfn]+")
_LANGE_SCHALTER = {"--login", "--noprofile", "--norc", "--posix", "--restricted"}


def ausgefuehrtes_programm(befehl):
    """Das Programm samt Argumenten, das diese Befehlszeile AUSFUEHRT, sonst None. Huellen
    (env, nice, nohup, timeout, ...) werden uebersprungen; bei einem Interpreter zaehlt das
    Skript (erstes Nicht-Options-Argument), bei `python -m` das Modul. Ein Text nach -c/-e ist
    kein Programm. Gedacht fuer `ps -o command=`; Pfade mit Leerzeichen werden nicht gelesen."""
    t = (befehl or "").split()
    i = 0
    for _ in range(32):
        if i >= len(t):
            return None
        name = os.path.basename(t[i])
        if name in HUELLEN_WERTOPTIONEN:
            mit_wert = HUELLEN_WERTOPTIONEN[name]
            i += 1
            while i < len(t):
                if t[i] == "--":
                    i += 1
                    break
                if name == "env" and "=" in t[i] and not t[i].startswith("-"):
                    i += 1
                elif t[i].startswith("-"):
                    i += 2 if t[i] in mit_wert else 1
                else:
                    break
            if name == "timeout":
                i += 1          # die Dauer
            continue
        if INTERPRETER.match(name):
            name = name.lower()
            i += 1
            while i < len(t):
                tok = t[i]
                if tok == "--":
                    i += 1
                    break
                if name.startswith("python") and tok == "-m":
                    return " ".join(t[i + 1:]) if i + 1 < len(t) else None
                if tok in ("-o", "+o", "-O", "+O") and name in ("bash", "sh", "zsh", "dash", "ksh"):
                    i += 2
                elif _SCHALTER_OHNE_WERT.fullmatch(tok) or tok in _LANGE_SCHALTER:
                    i += 1
                elif tok.startswith("-") or tok.startswith("+"):
                    return None
                else:
                    break
            return " ".join(t[i:]) if i < len(t) else None
        return " ".join(t[i:])
    return None


def muster_programm(befehl):
    """Was ein 'muster' sieht: nur das ausgefuehrte Programm bzw. die Skriptdatei (bei python -m das
    Modul), nie die Argumente danach. Leer, wenn die Befehlszeile kein Programm ausfuehrt."""
    return (ausgefuehrtes_programm(befehl) or "").split(" ", 1)[0]


