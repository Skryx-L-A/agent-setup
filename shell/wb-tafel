                    % (e.get("platz"), e["id"], halter_text(e.get("halter") or {}), uhrzeit(e["bis"]), zweck),
                    platz=e.get("platz"), eintrag=e["id"])
    return e


# Selbsttest-Kennzeichen (Auftrag wz-d6, 14.10.): der Selbsttest von run-all.sh (test-wb-tafel-deckung,
# Block D6) startet run-all.sh selbst mit RUN_ALL_TAFEL_SELFTEST=1 bzw. mit WB_RUN_ALL_TAFEL auf eine
# andere wb-tafel. Ein solcher Prozess ist kein Gesamtlauf der Live-Tafel und zaehlt im Musterabgleich
# nicht. GRENZE: die Variablen setzt jeder Prozess selbst; das ist eine Buchung fuer Testlaeufe, keine
# Zugriffssperre. Jede Ausnahme steht im Verlauf (Ereignis 'selbsttest'), damit ein Missbrauch sichtbar ist.
# macOS zeigt `ps -E` die Umgebung nur fuer Nicht-Plattformprogramme (gemessen 14.10.: timeout ja, /bin/bash
# nein), daher gilt die Kennung fuer den Prozess selbst oder seinen direkten Elternprozess.
LAUFENDE_TAFEL = os.path.realpath(__file__)
SELBSTTEST_VAR = re.compile(r"(?:^|\s)(RUN_ALL_TAFEL_SELFTEST|WB_RUN_ALL_TAFEL)=(\S*)")


def _ps_zeile(pid, extra):
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    try:
        p = subprocess.run(["ps"] + extra + ["-ww", "-o", "command=", "-p", str(int(pid))],
                           capture_output=True, text=True, timeout=5, env=env)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    return p.stdout.rstrip("\n") if p.returncode == 0 else None


def selbsttest_kennzeichen_eins(pid):
    """Kennzeichen aus der Umgebung von <pid> (nur lesen), sonst ''. Ausgewertet werden allein die
    Variablen RUN_ALL_TAFEL_SELFTEST (= 1) und WB_RUN_ALL_TAFEL (andere Tafel als die laufende); der
    Argumentteil der Befehlszeile zaehlt nicht (ps -o command= wird abgezogen), Werte anderer
    Variablen werden nicht gelesen oder ausgegeben."""
    plain = _ps_zeile(pid, [])
    voll = _ps_zeile(pid, ["-E"])
    if not plain or not voll or not voll.startswith(plain):
        return ""
    for m in SELBSTTEST_VAR.finditer(voll[len(plain):]):
        name, wert = m.group(1), m.group(2)
        if name == "RUN_ALL_TAFEL_SELFTEST" and wert == "1":
            return name
        if name == "WB_RUN_ALL_TAFEL" and wert and os.path.realpath(wert) != LAUFENDE_TAFEL:
            return name
    return ""


def selbsttest_kennzeichen(pid, kette):
    """Selbsttest-Kennzeichen am Prozess oder seinem direkten Elternprozess (kette[0])."""
    for q in ([pid] + list(kette[:1])):
        k = selbsttest_kennzeichen_eins(q)
        if k:
            return k
    return ""


def muster_abgleich(cfg, maschine, z, nachrichten):
    """Ein ps-Aufruf je Tafel-Aufruf: laufende Prozesse, deren Befehlszeile auf ein 'muster'
    eines Platzes passt und fuer die kein Eintrag steht, werden als unangemeldet erfasst.
    Liefert die Dauer in ms (None, wenn kein Platz Muster hat)."""
    plaetze = []
    for n, d in (cfg.get("plaetze") or {}).items():
        if isinstance(d, dict) and d.get("muster"):
            p = platz_suchen(cfg, n, maschine)
            if p:
                regs = []
                for m in p["muster"]:
                    try:
                        regs.append(re.compile(m))
                    except re.error:
                        verlauf_schreiben("muster-fehler", platz=n, grund="ungueltiges Muster: %s" % m)
                if regs:
                    plaetze.append((p, regs))
    if not plaetze:
        return None
    t0 = time.monotonic()
    tab = prozesstabelle()
    eigene = set(ahnenkette(tab, os.getpid())) | {os.getpid()}
    kinder = {}
    for pid, (pp, _cmd) in tab.items():
        kinder.setdefault(pp, []).append(pid)

    def nachfahren_von(pid):
        aus, stapel = set(), list(kinder.get(pid, ()))
        while stapel and len(aus) < 4096:
            q = stapel.pop()
            if q not in aus:
                aus.add(q)
                stapel.extend(kinder.get(q, ()))
        return aus

    for p, regs in plaetze:
        treffer = []
        for pid, (_pp, cmd) in tab.items():
            if pid in eigene:
                continue
            # Nur das Programm bzw. die Skriptdatei, nie die Argumente danach: `bash claude-worker
            # "[Protokoll] ... run-all.sh --shell-only ..."` trug den Auftragstext in argv und traf das
            # Muster (Fehlalarm 11.10. 06:26:55, PID 81771). Bei `python -m` ist es das Modul.
            ausgefuehrt = muster_programm(cmd)
            if ausgefuehrt and any(r.search(ausgefuehrt) for r in regs):
                treffer.append((len(ahnenkette(tab, pid)), pid))
        # Obere zuerst: ein neuer Zwangseintrag am oberen Treffer deckt seine Treffer darunter
        # (Vorfahr in der Kette), ein ungedeckter Teilbaum bleibt so genau ein Eintrag.
        for _tiefe, pid in sorted(treffer):
            kette = ahnenkette(tab, pid)
            if gedeckt(z, p["name"], pid, kette, nachfahren_von(pid)):
                continue
            kz = selbsttest_kennzeichen(pid, kette)
            if kz:
                verlauf_schreiben("selbsttest", platz=p["name"], pid=pid, kennzeichen=kz,
                                  befehl=befehl_kurz(tab[pid][1]))
                continue
            h, rolle_agent = starter_von(pid, kette)
            agent = rolle_agent or harness_in_kette(tab, kette)
            unangemeldet_anlegen(z, p, pid, tab[pid][1], h, agent, "muster", nachrichten,
                                 menge=0 if p["art"] == "menge" else 1)
    return round((time.monotonic() - t0) * 1000.0, 1)


def cmd_melde_start(a, cfg, maschine):
    """Fuer die Einbindungsstellen (run-all.sh, Modellstart, Spawner): ein Start auf <platz>.
    Exit 0 = ein Eintrag deckt ihn, 1 = unangemeldet erfasst (Warnung mit fertigem Befehl)."""
    p = platz(cfg, a.platz, maschine)
    menge = menge_pruefen(p, a.menge)
    me = ich(0)
    tab = prozesstabelle()
    if a.pid not in tab:
        fehler("--pid %d laeuft nicht." % a.pid)
    kette = ahnenkette(tab, a.pid)
    if a.pid not in ahnen() and os.getppid() not in kette:
        fehler("--pid %d ist weder ein Vorfahr dieses Aufrufs noch ein Kind seines Aufrufers -- "
               "melden laesst sich nur ein eigener Start." % a.pid, EXIT_RECHT)
    with sperre():
        z, nachrichten, _ = sitzung(cfg, maschine)
        deckend = gedeckt(z, p["name"], a.pid, kette)
        if not deckend:
            deckend = next((e for e in z["eintraege"] if e.get("platz") == p["name"] and not e.get("unangemeldet")
                            and schluessel(e.get("halter") or {}) == schluessel(me)), None)
        neu = None
        if not deckend:
            neu = unangemeldet_anlegen(z, p, a.pid, tab[a.pid][1], me, not ist_mensch(), "melde-start",
                                       nachrichten, menge=menge)
        zustand_schreiben(z)
    zustellen(nachrichten, me)
    if deckend and not deckend.get("unangemeldet"):
        gib_aus("EINGETRAGEN: der Start auf %s ist durch %s gedeckt." % (p["name"], deckend["id"]))
        return EXIT_OK
    e = neu or deckend
    if not e:
        fehler("--pid %d ist nicht mehr zu messen." % a.pid, EXIT_AUFRUF)
    print(warntext(p, e, z), file=sys.stderr)
    return EXIT_BELEGT

