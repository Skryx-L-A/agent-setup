def inbox_pfad():
    p = os.environ.get("WB_TAFEL_INBOX", "")
    kandidaten = [p] if p else [os.path.join(HIER, "wb-inbox"), shutil.which("wb-inbox") or "",
                                os.path.join(HOME, ".local", "bin", "wb-inbox")]
    for k in kandidaten:
        if k and os.path.isfile(k) and os.access(k, os.X_OK):
            return k
    return ""


def halter_modus(me):
    """Der GEMESSENE Rechtemodus der Claude-Sitzung, die diesen Aufruf macht (Auftrag
    tafel-meldung-ohne-dialog, 11.10.2026): {klasse, sitzung, pid} oder {}. Gemessen mit
    wb-inbox (naechste Claude-Ahnin mit Registereintrag, pid und procStart passend, Transcript);
    hat der Halter einen Pane, muss die Sitzung unter diesem Pane laufen. Keine Variable, kein
    Argument. Gespeichert im Eintrag; Meldungen an diesen Halter nennen ihn wb-inbox, das ihn nur
    bezeugt, wenn der Empfaenger genau diese Sitzung mit derselben gemessenen Klasse ist."""
    pfad = next((k for k in (os.path.join(HIER, "wb-inbox"), inbox_pfad()) if k and os.path.isfile(k)), "")
    if not pfad:
        return {}
    try:
        sys.dont_write_bytecode = True
        loader = SourceFileLoader("wb_inbox_baustein", pfad)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        d = mod.absender_sitzung()
        klasse = mod.sitzung_modus(d)
    except Exception:
        return {}
    if klasse not in ("bypass", "prompting") or not isinstance(d, dict):
        return {}
    sid, pid = d.get("sessionId"), d.get("pid")
    if not isinstance(sid, str) or not re.fullmatch(r"[0-9A-Fa-f-]{8,64}", sid) or not isinstance(pid, int):
        return {}
    if me.get("pane_pid") and int(me["pane_pid"]) not in ahnenkette(prozesstabelle(), pid) \
            and int(me["pane_pid"]) != pid:
        return {}
    return {"klasse": klasse, "sitzung": sid, "pid": pid}


def modus_je_pane():
    """{(pane, socket): halter.modus} aus allen Eintraegen und Warteeintraegen, deren Halter einen
    gemessenen Modus traegt (eigener Pane, sonst der Vorfahren-Pane eines gebundenen Laufs). Fuer
    Meldungen an Panes, die nicht der Halter des Anlasses sind (Verursacher, Orchestrator): ihr
    eigener Eintrag nennt den gemessenen Modus. wb-inbox prueft ihn ohnehin gegen den Empfaenger."""
    z = zustand_lesen()
    karte = {}
    for e in list(z.get("eintraege") or []) + [q for l in (z.get("schlangen") or {}).values() for q in l]:
        h = e.get("halter") or {}
        m = h.get("modus") or {}
        if not m.get("sitzung"):
            continue
        q = h if h.get("pane") else (h.get("vorfahr") or {})
        if q.get("pane") and q.get("socket"):
            karte[(q["pane"], q["socket"])] = m
    return karte


def nachricht(an, text, anlass, eintrag):
    return {"an": an, "text": text, "anlass": anlass, "eintrag": eintrag}


def zustellen(nachrichten, me):
    """Jede Nachricht ueber `wb-inbox sende` an den Pane, nie getippt. Ausserhalb der Sperre,
    damit eine langsame Zustellung niemanden aufhaelt. Was nicht zugestellt werden kann,
    steht im Verlauf."""
    gruppe_senden()
    # Nur ein NACHGEWIESENER Aufrufer liest seine Nachricht direkt; "ohne Pane" teilen sich alle.
    eigener = schluessel(me) if me and nachweisbar(me) else ""
    karte = None
    aus = os.path.exists(ZUSTELLUNG_AUS)
    for n in nachrichten:
        h = n["an"]
        if schluessel(h) == eigener:
            continue            # der Aufrufer liest die Antwort direkt
        an_text = halter_text(h)
        if aus:
            verlauf_schreiben("nicht-zugestellt", anlass=n["anlass"], eintrag=n["eintrag"], an=an_text,
                              grund="Zustellung an Panes abgeschaltet (%s)" % ZUSTELLUNG_AUS)
            continue
        if not h.get("pane"):
            h = melde_adresse(h)
            if h:
                an_text += " ueber Vorfahr %s" % h["pane"]
        if not h or not h.get("pane") or not h.get("socket"):
            verlauf_schreiben("nicht-zugestellt", anlass=n["anlass"], eintrag=n["eintrag"],
                              an=an_text, grund="keine Zustelladresse (kein Pane, kein Vorfahr mit Pane)")
            continue
        inbox = inbox_pfad()
        if not inbox:
            verlauf_schreiben("nicht-zugestellt", anlass=n["anlass"], eintrag=n["eintrag"],
                              an=an_text, grund="wb-inbox nicht gefunden")
            continue
        os.makedirs(STATE_DIR, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".nachricht-")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(n["text"] + "\n")
            # wb-inbox loest den Pane auf dem Server mit diesem Namen auf (-L): ohne den
            # Server ist eine Pane-Kennung keine Adresse (Vorfall 2026-08-20 dort).
            befehl = [inbox, "-L", os.path.basename(h["socket"]), "sende", h["pane"], tmp]
            # Beim nimm gemessener Modus des Adressaten (halter_modus): wb-inbox bezeugt ihn nur fuer
            # genau diese Sitzung mit derselben gemessenen Klasse, sonst nimmt es den Weg ohne Dialog.
            modus = (n["an"] or {}).get("modus") or {}
            if not modus.get("sitzung"):
                if karte is None:
                    karte = modus_je_pane()
                modus = karte.get((h["pane"], h["socket"])) or {}
            if modus.get("sitzung") and modus.get("klasse") in ("bypass", "prompting"):
                befehl += ["--tafel-halter", "%s:%s" % (modus["sitzung"], modus["klasse"])]
            weg = ""
            try:
                p = subprocess.run(befehl, capture_output=True, text=True, timeout=ZUSTELL_FRIST_S,
                                   stdin=subprocess.DEVNULL)
                rc, rest = p.returncode, (p.stderr or p.stdout or "").strip().splitlines()[-1:]
                m = re.match(r"weg=([a-z-]+)", (p.stdout or "").strip())
                weg = m.group(1) if m else ""
            except (OSError, subprocess.SubprocessError) as e:
                rc, rest = -1, [str(e)]
            verlauf_schreiben("zugestellt" if rc == 0 else "nicht-zugestellt", anlass=n["anlass"],
                              eintrag=n["eintrag"], an=an_text, rc=rc, weg=weg,
                              grund=(rest[0] if rest and rc != 0 else ""))
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass


# ------------------------------------------------------- wb-belegung (menge)

def belegung_ruf(argumente):
    pfad = belegung_pfad()
    if not pfad:
        return 127, "", "wb-belegung nicht gefunden"
    try:
        p = subprocess.run([pfad] + argumente, capture_output=True, text=True,
                           timeout=DIENST_FRIST_S, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.SubprocessError) as e:
        return 126, "", str(e)


def belegung_darf(gib):
    rc, aus, err = belegung_ruf(["darf", "--gb", "%.3f" % gib, "--json"])
    try:
        d = json.loads(aus)
    except ValueError:
        d = {}
    if rc in (0, 1):
        return rc == 0, d.get("grund") or ("wb-belegung: %s GiB passen nicht" % menge_text(gib))
    return None, "wb-belegung darf scheiterte (Exit %s): %s" % (rc, (err or aus).strip()[-300:])


def belegung_nimm(gib, zweck, frist_s):
    rc, aus, err = belegung_ruf(["nimm", "--gb", "%.3f" % gib, "--zweck", zweck,
                                 "--frist", str(max(1, int(math.ceil(frist_s / 60.0)))), "--json"])
    try:
        d = json.loads(aus)
    except ValueError:
        d = {}
    if rc == 0 and d.get("kennung"):
        return d["kennung"], ""
    if rc == 1:
        return None, d.get("grund") or "wb-belegung sagt nein"
    return False, "wb-belegung nimm scheiterte (Exit %s): %s" % (rc, (err or aus).strip()[-300:])


def belegung_freigeben(kennung):
    """Erst als Halter, dann --fremd: wer aufraeumt, ist oft nicht der Halter. Eine schon
    verfallene Buchung ('nichts freizugeben') ist kein Fehler."""
    rc, aus, err = belegung_ruf(["gib", kennung])
    if rc != 0:
        rc, aus, err = belegung_ruf(["gib", kennung, "--fremd"])
    return rc, (err or aus).strip()


def belegung_verlaengern(kennung, rest_s):
    rc, aus, err = belegung_ruf(["verlaengern", kennung, "--frist",
                                 str(max(1, int(math.ceil(rest_s / 60.0))))])
    return rc, (err or aus).strip()


# ------------------------------------------------- Kapazitaet und Schlangen

def def_von(cfg, name):
    d = (cfg.get("plaetze") or {}).get(name)
    return d if isinstance(d, dict) else {}


def ist_schwer(p, menge):
    if p["art"] == "menge":
        ab = p.get("schwer_ab")
        return ab is not None and float(menge) >= float(ab)
    return p["schwer"]


def ruhe_halter(cfg, z, me):
    """Eintraege fremder Sitzungen auf Plaetzen mit sperrt_schwere (mac-ruhe)."""
    return [e for e in z["eintraege"]
            if def_von(cfg, e.get("platz", "")).get("sperrt_schwere")
            and schluessel(e.get("halter") or {}) != schluessel(me)]


def schwere_halter(cfg, z, me):
    """Eintraege fremder Sitzungen auf schweren Plaetzen ('schwer', oder 'menge' ab 'schwer_ab'
    GiB nach der gebuchten Menge): die Gegenrichtung zu ruhe_halter. Ein Ruheplatz wird erst
    vergeben, wenn keiner davon steht (Auftrag tafel-peer, 11.10.2026: peer-ruhe lief neben
    peer-suite, weil nur schwer gegen ruhe, nie ruhe gegen schwer geprueft wurde)."""
    def schwer(e):
        d = def_von(cfg, e.get("platz", ""))
        if d.get("art") == "menge":
            ab = d.get("schwer_ab")
            return ab is not None and float(e.get("menge", 1)) >= float(ab)
        return bool(d.get("schwer"))
    return [e for e in z["eintraege"]
            if schwer(e) and schluessel(e.get("halter") or {}) != schluessel(me)]


def neben_halter(p, menge, me, z, kennungen=()):
    """Eintraege fremder Sitzungen auf den Plaetzen, die p unter 'nicht_neben' nennt (mac-suite fuer
    mac-worker-schwer): solange einer steht, startet auf p nichts (Auftrag wz-tafel, 14.10.2026: ein
    wartender schwerer Lauf startete neben einem inzwischen begonnenen Gesamtlauf, weil
    `wb-tafel frei mac-suite && wb-tafel nimm …` nur beim Einreihen prueft). Nur in diese Richtung:
    der Gesamtlauf selbst wartet nie auf p. Ein Mengenplatz gilt erst ab 'schwer_ab'. Nicht
    gezaehlt: die eigene Sitzung (nur mit Pane oder --pid; ohne beides teilen sich alle Aufrufe einer
    Maschine denselben Schluessel) und ein Eintrag, dessen Kennung der Aufruf in WB_TAFEL_EINTRAG
    erbt (ein Teil des Gesamtlaufs selbst)."""
    ziele = p.get("nicht_neben") or []
    if not ziele or (p["art"] == "menge" and not ist_schwer(p, menge)):
        return []
    return [e for e in z["eintraege"]
            if e.get("platz") in ziele and e.get("id") not in kennungen
            and not (nachweisbar(me) and schluessel(e.get("halter") or {}) == schluessel(me))]


def eigene_kennungen():
    """Kennungen, die dieser Aufruf in WB_TAFEL_EINTRAG erbt (nimm -- <lauf>, run-all.sh)."""
    return [k for k in os.environ.get(KENNUNG_VAR, "").split(",") if k]


def dran_zuruecknehmen(cfg, maschine, z):
    """Wer 'dran' ist, aber noch nicht angenommen hat, verliert das 'dran' (nicht seinen Platz vorn
    in der Schlange), sobald ein Platz aus 'nicht_neben' gehalten wird: sonst liefe seine
    Annahmefrist neben dem Gesamtlauf ab und er fiele aus der Schlange. dran_vergeben gibt es ihm
    wieder, wenn der Gesamtlauf vorbei ist."""
    for name, schlange in z["schlangen"].items():
        p = platz_suchen(cfg, name, maschine)
        if p is None or not p.get("nicht_neben"):
            continue
        for q in schlange:
            if not q.get("dran_bis"):
                continue
            neben = neben_halter(p, q.get("menge", 1), q.get("halter") or {}, z)
            if neben:
                q["dran_seit"] = q["dran_bis"] = None
                verlauf_schreiben("dran-zurueck", platz=name, eintrag=q.get("id"),
                                  wer=halter_text(q.get("halter") or {}),
                                  grund="%s gehalten (%s)" % (neben[0].get("platz"), neben[0].get("id")))


def relevante(p, z):
    if p["art"] == "zustaendigkeit":
        return [e for e in z["eintraege"] if ueberlappt(e.get("platz", ""), p["name"])]
    return [e for e in z["eintraege"] if e.get("platz") == p["name"]]


def reserviert(p, z, ausser_id=""):
    return [q for q in z["schlangen"].get(p["name"], [])
            if q.get("dran_bis") and q.get("id") != ausser_id]


def passt(cfg, p, menge, me, z, ausser_id="", belegung_fragen=True, kennungen=()):
    """(ja|None, grund, halter). None nur, wenn wb-belegung nicht antwortet. Laeuft immer unter der
    Sperre und vor dem Eintragen im selben Durchgang: Pruefung und Eintrag sind atomar."""
    if ist_schwer(p, menge):
        ruhe = ruhe_halter(cfg, z, me)
        if ruhe:
            e = ruhe[0]
            return False, ("%s wird gehalten (%s, %s): schwere Plaetze gelten bis dahin als belegt"
                           % (e["platz"], halter_text(e.get("halter") or {}), e.get("zweck", ""))), ruhe
    if p.get("sperrt_schwere"):
        schwere = schwere_halter(cfg, z, me)
        if schwere:
            e = schwere[0]
            return False, ("%s wird gehalten (%s, %s): ein Ruheplatz wartet, bis schwere Plaetze frei sind"
                           % (e["platz"], halter_text(e.get("halter") or {}), e.get("zweck", ""))), schwere
    neben = neben_halter(p, menge, me, z, kennungen)
    if neben:
        e = neben[0]
        return False, ("%s wird gehalten (%s, %s): %s startet nicht daneben, wartet bis er frei ist"
                       % (e["platz"], halter_text(e.get("halter") or {}), e.get("zweck", ""), p["name"])), neben
    halter = relevante(p, z)
    res = reserviert(p, z, ausser_id)
    if p["art"] == "menge":
        if not belegung_fragen:
            return True, "", halter
        zusatz = sum(float(q.get("menge", 0)) for q in res)
        ja, grund = belegung_darf(float(menge) + zusatz)
        if ja is None:
            return None, grund, halter
        if not ja and zusatz:
            grund = "%s (dazu %s GiB fuer Wartende, die dran sind)" % (grund, menge_text(zusatz))
        return ja, ("" if ja else grund), halter
    belegt = sum(float(e.get("menge", 1)) for e in halter)
    reserv = sum(float(q.get("menge", 1)) for q in res)
    frei = p["kapazitaet"] - belegt - reserv
    if frei >= menge:
        return True, "", halter
    if halter:
        grund = "belegt (%s von %s)" % (menge_text(belegt), p["kapazitaet"])
    else:
        grund = "fuer Wartende reserviert, die dran sind"
    if reserv and halter:
        grund += ", dazu %s fuer Wartende, die dran sind" % menge_text(reserv)
    return False, grund, halter


def mahnzeit(e):
    return float(e["seit"]) + MAHNUNG_ANTEIL * (float(e["bis"]) - float(e["seit"]))


def austragen(e, ereignis, wer_text, nachrichten, grund="", benachrichtigen=None):
    """Entfernt nichts aus Listen (das tut der Aufrufer), sondern erledigt alles Uebrige:
    Speicherbuchung freigeben, Verlauf, Gruppe, Nachrichten."""
    if e.get("belegung"):
        rc, text = belegung_freigeben(e["belegung"])
        verlauf_schreiben("belegung-freigegeben" if rc in (0, 1) else "belegung-nicht-freigegeben",
                          eintrag=e["id"], belegung=e["belegung"], rc=rc, grund=text[-200:])
    verlauf_schreiben(ereignis, platz=e.get("platz"), eintrag=e["id"], menge=e.get("menge"),
                      wer=halter_text(e.get("halter") or {}), durch=wer_text, grund=grund,
                      zweck=e.get("zweck"))
    an_gruppe_tafel("verfallen" if ereignis in ("abgelaufen", "halter-tot") else "ausgetragen",
                    "%s: %s %s (%s)%s" % (ereignis, e.get("platz"), e["id"],
                                          halter_text(e.get("halter") or {}),
                                          (" -- " + grund) if grund else ""),
                    platz=e.get("platz"), eintrag=e["id"])
    for ziel, text in (benachrichtigen or []):
        nachrichten.append(nachricht(ziel, text, ereignis, e["id"]))


def gnade_s(e):
    return GNADE_ANTEIL * float(e.get("anfangsfrist_s") or e.get("frist_s") or 0)


def abbruch_hindernis(e):
    """'' wenn die Tafel den gebundenen Lauf beenden darf, sonst der Grund dagegen."""
    h = e.get("halter") or {}
    if e.get("unangemeldet"):
        return "Zwangseintrag (unangemeldet) wird nie beendet"
    if e.get("ohne_abbruch"):
        return "an diesem Platz wird nie ein Prozess beendet"
    if e.get("mensch"):
        return "Lauf des Menschen wird nie beendet"
    if not h.get("pid") or not h.get("lstart"):
        return "kein gebundener Prozess (nur Pane), nichts zu beenden"
    if bausteine().prozess_lebt(h["pid"], h["lstart"]) is not True:
        return "Prozessidentitaet (PID %s samt Startzeit) nicht eindeutig wiedererkannt" % h["pid"]
    return ""


def pane_prozesse():
    """Die Pane-Prozesse aller tmux-Server, auf denen die Tafel Starter sucht."""
    pids = set()
    for sock in tmux_server_liste():
        rc, aus = bausteine().tmux_ruf(["list-panes", "-a", "-F", "#{pane_pid}"], sock)
        if rc == 0:
            pids.update(int(x) for x in aus.split() if x.isdigit())
    return pids


def nachfahren_erfassen(wurzeln):
    """(baum, geschont): alle Nachfahren der Wurzeln (ohne diese) aus EINER Prozesstabelle, je
    mit PID, Startzeit und Befehl. Geschont -- nur gemeldet, samt ihrem eigenen Teilbaum --
    werden Pane-Prozesse eines tmux-Panes, tmux-Server und Harnesses (claude, codex, pi, ...)
    sowie dieser Aufruf und seine Vorfahren."""
    w = bausteine()
    tab = prozesstabelle()
    kinder = {}
    for q, (pp, _b) in tab.items():
        kinder.setdefault(pp, []).append(q)
    panes, namen = pane_prozesse(), harness_namen() | {"tmux"}
    schutz = set(ahnen()) | {os.getpid()}
    baum, geschont, gesehen = [], [], set(int(x) for x in wurzeln)
    offen = [k for x in wurzeln for k in sorted(kinder.get(int(x), []))]
    while offen:
        q = offen.pop(0)
        if q in gesehen or q not in tab:
            continue
        gesehen.add(q)
        befehl = tab[q][1]
        if q in panes or q in schutz or any(os.path.basename(t) in namen for t in befehl.split()[:2]):
            geschont.append({"pid": q, "befehl": befehl_kurz(befehl)})
            continue
        lstart = w.prozess_lstart(q)
        if not lstart:
            continue
        baum.append({"pid": q, "lstart": lstart, "befehl": befehl_kurz(befehl)})
        offen.extend(sorted(kinder.get(q, [])))
    return baum, geschont


def lebende_aus(liste):
    """Die Eintraege der Liste, deren Prozess noch derselbe ist (PID und Startzeit) und kein
    Zombie. Ein ps-Aufruf."""
    if not liste:
        return []
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    try:
        p = subprocess.run(["ps", "-o", "pid=,stat=,lstart=", "-p", ",".join(str(d["pid"]) for d in liste)],
                           capture_output=True, text=True, timeout=10, env=env)
    except (OSError, subprocess.SubprocessError):
        return []
    da = {}
    for zeile in p.stdout.splitlines():
        t = zeile.split(None, 2)
        if len(t) == 3 and t[0].isdigit() and "Z" not in t[1]:
            da[int(t[0])] = " ".join(t[2].split())
    return [d for d in liste if da.get(int(d["pid"])) == " ".join(str(d.get("lstart", "")).split())]


def abbruch_offen(e):
    """Laeuft ein Abbruch ohne Prozessgruppe, dessen SIGKILL noch aussteht, und lebt noch ein
    erfasster Nachfahre? Dann bleibt der Eintrag, auch wenn der gebundene Prozess schon tot ist:
    die Waisen bekommen ihr SIGKILL."""
    ab = e.get("abbruch") or {}
    return bool(ab) and not ab.get("kill_zeit") and bool(lebende_aus(ab.get("baum") or []))


def signal_senden(e, sig):
    """Nur an die gebundene Prozessidentitaet und ihren Lauf: PID und Startzeitpunkt muessen
    stimmen. Ist der Prozess Fuehrer seiner Prozessgruppe, geht das Signal an die Gruppe. Sonst
    (GL#10: run-all.sh aus `zsh -c` eines Agenten, dessen Gruppe den Agenten enthalten kann) nie
    an die Gruppe: VOR dem SIGTERM wird der Nachfahrenbaum erfasst (PID, Startzeit, Befehl), das
    Signal geht an die PID und jeden Nachfahren; SIGKILL spaeter an die Ueberlebenden genau
    dieser Liste (Identitaet erneut geprueft) und an inzwischen neue Nachfahren. Nie an
    Vorfahren; Panes und Harnesses nur gemeldet (nachfahren_erfassen). (art, fehler, zusatz)."""
    h = e["halter"]
    pid = int(h["pid"])
    ab = e.get("abbruch") or {}
    lebt = bausteine().prozess_lebt(pid, h.get("lstart", "")) is True
    try:
        if sig == signal.SIGTERM:
            if not lebt:
                return "", "Prozessidentitaet nicht mehr eindeutig", {}
            pgid = os.getpgid(pid)
            if pgid == pid:
                os.killpg(pgid, sig)
                return "Prozessgruppe %d" % pgid, "", {"gruppe": True}
            baum, geschont = nachfahren_erfassen([pid])
            os.kill(pid, sig)
            getroffen = [d["pid"] for d in lebende_aus(baum)]
            for q in getroffen:
                try:
                    os.kill(q, sig)
                except OSError:
                    pass
            return ("Prozess %d und %d Nachfahren" % (pid, len(getroffen)), "",
                    {"gruppe": False, "baum": baum, "geschont": geschont})
        if "baum" not in ab:          # Gruppenfuehrer (oder Abbruch aus der Zeit vor dem Baum): wie bisher
            if not lebt:
                return "", "Prozessidentitaet nicht mehr eindeutig", {}
            if os.getpgid(pid) == pid:
                os.killpg(pid, sig)
                return "Prozessgruppe %d" % pid, "", {}
            os.kill(pid, sig)
            return "Prozess %d" % pid, "", {}
        alt = lebende_aus(ab.get("baum") or [])
        neu, geschont = nachfahren_erfassen(([pid] if lebt else []) + [d["pid"] for d in alt])
        bekannt = set(d["pid"] for d in alt)
        ziele = alt + [d for d in neu if d["pid"] not in bekannt]
        if lebt:
            os.kill(pid, sig)
        for d in lebende_aus(ziele):
            try:
                os.kill(int(d["pid"]), sig)
            except OSError:
                pass
        if not lebt and not ziele:
            return "", "Prozessidentitaet nicht mehr eindeutig, keine Nachfahren mehr", {}
        return ("%s%d Nachfahren" % ("Prozess %d und " % pid if lebt else "", len(ziele)), "",
                {"geschont_kill": geschont} if geschont else {})
    except OSError as x:
        return "", str(x), {}


def geschont_text(ab):
    g = (ab or {}).get("geschont") or []
    if not g:
        return ""
    return (" Nicht beendet (Pane-Prozess, tmux oder Harness, nur gemeldet): %s."
            % ", ".join("PID %s %s" % (d["pid"], d["befehl"]) for d in g[:8]))


def an_halter_und_orchestrator(e, text_halter, text_orch, anlass, nachrichten, halter_auch=True):
    h = e.get("halter") or {}
    if halter_auch:
        nachrichten.append(nachricht(h, text_halter, anlass, e["id"]))
    for o in orchestratoren_von(h):
        nachrichten.append(nachricht(o, text_orch, anlass, e["id"]))


def verfall_melden(e, ereignis, grund, nachrichten, halter_tot=False):
    h = e.get("halter") or {}
    text = ("wb-tafel: Dein Eintrag %s auf %s (%s) ist VERFALLEN: %s. Neu eintragen: wb-tafel nimm %s …"
            % (e["id"], e.get("platz"), e.get("zweck", ""), grund, e.get("platz")))
    ziele = [] if halter_tot else [(h, text)]
    for o in orchestratoren_von(h):
        ziele.append((o, "wb-tafel: Eintrag %s auf %s von %s ist verfallen: %s. Zweck: %s"
                      % (e["id"], e.get("platz"), halter_text(h), grund, e.get("zweck", ""))))
    austragen(e, ereignis, "wb-tafel", nachrichten, grund=grund, benachrichtigen=ziele)


def fristende(e, t, nachrichten):
    """Fristende mit Gnadenfrist (der Nutzer, 2026-10-09). True = Eintrag ist jetzt weg.

    Bei Fristende eine Meldung an Halter und Orchestrator, bei halber Gnadenfrist eine zweite.
    Nach der Gnadenfrist: darf die Tafel den gebundenen Lauf beenden, SIGTERM, nach
    abbruch_kill_s SIGKILL; das Ende stellt der naechste Durchgang fest. Sonst verfaellt der
    Eintrag, und es wird nur gemeldet."""
    w = bausteine()
    bis, g = float(e["bis"]), gnade_s(e)
    ende = bis + g
    hindernis = abbruch_hindernis(e)
    folge = ("beendet die Tafel den Lauf (%s)" % halter_text(e.get("halter") or {})) if not hindernis \
        else "verfaellt der Eintrag; beendet wird nichts (%s)" % hindernis
    befehl = "wb-tafel verlaengern %s --um <dauer> --grund '<satz>'" % e["id"]
    if not e.get("frist_gemeldet"):
        e["frist_gemeldet"] = True
        text = ("wb-tafel: Eintrag %s auf %s (%s) laeuft ueber die Frist. Nachsehen und passend verlaengern: "
                "%s . Ohne Verlaengerung %s um %s." % (e["id"], e.get("platz"), e.get("zweck", ""), befehl,
                                                       folge, uhrzeit(ende)))
        an_halter_und_orchestrator(e, text, text, "frist-ende", nachrichten)
        verlauf_schreiben("frist-ende", platz=e.get("platz"), eintrag=e["id"], gnade_s=round(g, 1),
                          folge=folge)
        an_gruppe_tafel("frist-ende", "frist-ende: %s %s, Gnadenfrist bis %s" % (e.get("platz"), e["id"], uhrzeit(ende)),
                        platz=e.get("platz"), eintrag=e["id"])
    if t >= bis + g / 2 and not e.get("gnade_gemeldet"):
        e["gnade_gemeldet"] = True
        text = ("wb-tafel: ZWEITE Meldung -- Eintrag %s auf %s: Gnadenfrist halb um. Verlaengern: %s . "
                "Um %s %s." % (e["id"], e.get("platz"), befehl, uhrzeit(ende), folge))
        an_halter_und_orchestrator(e, text, text, "gnade-halb", nachrichten)
        verlauf_schreiben("gnade-halb", platz=e.get("platz"), eintrag=e["id"])
        an_gruppe_tafel("gnade-halb", "gnade-halb: %s %s" % (e.get("platz"), e["id"]),
                        platz=e.get("platz"), eintrag=e["id"])
    if t < ende:
        return False
    ab = e.get("abbruch")
    if hindernis and not ab:
        verfall_melden(e, "abgelaufen", "Frist und Gnadenfrist sind um; %s" % hindernis, nachrichten)
        return True
    if not ab:
        art, fehl, zusatz = signal_senden(e, signal.SIGTERM)
        e["abbruch"] = dict(zusatz, term_zeit=t, term_iso=w.iso(t), ziel=art, fehler=fehl)
        verlauf_schreiben("abbruch-term", platz=e.get("platz"), eintrag=e["id"], ziel=art, grund=fehl,
                          nachfahren=[d["pid"] for d in zusatz.get("baum") or []],
                          geschont=[d["pid"] for d in zusatz.get("geschont") or []])
        an_gruppe_tafel("abbruch", "abbruch: %s %s -- SIGTERM an %s" % (e.get("platz"), e["id"], art or "?"),
                        platz=e.get("platz"), eintrag=e["id"])
        text = ("wb-tafel: Eintrag %s auf %s: Frist und Gnadenfrist um, nicht verlaengert -- SIGTERM an %s, "
                "SIGKILL in %d s.%s" % (e["id"], e.get("platz"), art or "?", int(e.get("abbruch_kill_s", KILL_NACH_S)),
                                      geschont_text(e["abbruch"])))
        an_halter_und_orchestrator(e, text, text, "abbruch", nachrichten)
        return False
    if not ab.get("kill_zeit"):
        if t >= float(ab["term_zeit"]) + float(e.get("abbruch_kill_s", KILL_NACH_S)):
            art, fehl, zusatz = signal_senden(e, signal.SIGKILL)
            ab.update({"kill_zeit": t, "kill_iso": w.iso(t), "kill_fehler": fehl})
            verlauf_schreiben("abbruch-kill", platz=e.get("platz"), eintrag=e["id"], ziel=art, grund=fehl,
                              geschont=[d["pid"] for d in zusatz.get("geschont_kill") or []])
        return False
    if t >= float(ab["kill_zeit"]) + ABBRUCH_AUFGABE_S:
        verfall_melden(e, "abbruch-gescheitert", "der Prozess lebt auch %d s nach SIGKILL noch -- nur gemeldet"
                       % ABBRUCH_AUFGABE_S, nachrichten)
        return True
    return False


def verfall_pruefen(z, nachrichten):
    """Fristen und Halter aller Eintraege und Wartenden. Liefert die Kennungen der eben
    verfallenen Eintraege."""
    t, cache, bleiben, verfallen = jetzt(), {}, [], []
    for e in z["eintraege"]:
        h = e.get("halter") or {}
        lebt = halter_lebt(h, cache)
        bis = e.get("bis")
        ab = e.get("abbruch")
        if lebt is False and not abbruch_offen(e):
            if ab:
                ereignis = "abgebrochen"
                grund = "nach Frist und Gnadenfrist beendet (%s)" % ("SIGKILL" if ab.get("kill_zeit") else "SIGTERM")
            elif h.get("pid"):
                ereignis, grund = "halter-tot", "der gebundene Prozess (PID %s) laeuft nicht mehr" % h["pid"]
            else:
                ereignis, grund = "halter-tot", "der Halter lebt nicht mehr"
            verfall_melden(e, ereignis, grund, nachrichten, halter_tot=not ab)
            verfallen.append(e["id"])
            continue
        if bis is not None and t >= float(bis):
            if fristende(e, t, nachrichten):
                verfallen.append(e["id"])
                continue
            bleiben.append(e)
            continue
        u = e.get("unangemeldet")
        if u and not u.get("zwang") and t >= float(u.get("nachtrag_bis", 0)):
            zwang_setzen(e, nachrichten)
        if bis is not None and not e.get("gemahnt") and t >= mahnzeit(e):
            e["gemahnt"] = True
            e["gemahnt_iso"] = bausteine().iso(t)
            rest = float(e["bis"]) - t
            nachrichten.append(nachricht(h, (
                "wb-tafel: Mahnung -- Dein Eintrag %s auf %s (%s) laeuft in %s ab (um %s). "
                "Verlaengern: wb-tafel verlaengern %s --um <dauer> --grund \"<satz>\" ; "
                "austragen: wb-tafel gib %s" % (e["id"], e.get("platz"), e.get("zweck", ""),
                                                dauer_text(rest), uhrzeit(float(e["bis"])),
                                                e["id"], e["id"])), "gemahnt", e["id"]))
            verlauf_schreiben("gemahnt", platz=e.get("platz"), eintrag=e["id"], rest_s=int(rest),
                              wer=halter_text(h))
            an_gruppe_tafel("gemahnt", "gemahnt: %s %s (%s), Rest %s"
                            % (e.get("platz"), e["id"], halter_text(h), dauer_text(rest)),
                            platz=e.get("platz"), eintrag=e["id"])
        bleiben.append(e)
    z["eintraege"] = bleiben
    for name in list(z["schlangen"]):
        neu = []
        for q in z["schlangen"][name]:
            qh = q.get("halter") or {}
            if halter_lebt(qh, cache) is False:
                verlauf_schreiben("aus-schlange", platz=name, eintrag=q.get("id"),
                                  wer=halter_text(qh), grund="der Wartende lebt nicht mehr")
                continue
            if q.get("dran_bis") and t >= float(q["dran_bis"]):
                verlauf_schreiben("verpasst", platz=name, eintrag=q.get("id"), wer=halter_text(qh))
                an_gruppe_tafel("verpasst", "verpasst: %s %s (%s) hat die Annahmefrist verstreichen "
                                "lassen" % (name, q.get("id"), halter_text(qh)),
                                platz=name, eintrag=q.get("id"))
                nachrichten.append(nachricht(qh, (
