def plaetze_laden():
    for pfad in (PLAETZE_LIVE, VORLAGE):
        if not os.path.isfile(pfad):
            continue
        try:
            with open(pfad, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError) as e:
            # Eine kaputte Live-Datei faellt NICHT still auf die Vorlage zurueck: wer sie
            # angepasst hat, soll den Fehler sehen, nicht andere Plaetze bekommen.
            fehler("Platzdefinitionen in %s sind unlesbar: %s" % (pfad, e))
        if not isinstance(d, dict) or not isinstance(d.get("plaetze"), dict):
            fehler("Platzdefinitionen in %s haben keinen Block 'plaetze'." % pfad)
        d["_quelle"] = pfad
        if pfad != VORLAGE:
            vorlage_nachziehen(d)
        return d
    fehler("keine Platzdefinitionen: weder %s noch die Vorlage %s." % (PLAETZE_LIVE, VORLAGE),
           EXIT_DIENST)


# Schluessel, die eine Live-Platzdatei von der Vorlage erbt, wenn sie sie fuer einen gleichnamigen Platz
# nicht selbst setzt: wb-ausrollen fasst die Live-Datei nie an (test-ausrollen-tafel-vorlage.sh), ein
# Schutz wie 'nicht_neben' (Auftrag wz-tafel, 14.10.2026) muss trotzdem mit dem Ausrollen wirken.
# Abschalten je Platz in der Live-Datei: "nicht_neben": [].
VORLAGE_ERBT = ("nicht_neben",)


def vorlage_nachziehen(d):
    try:
        with open(VORLAGE, encoding="utf-8") as f:
            v = (json.load(f).get("plaetze") or {})
    except (OSError, ValueError, AttributeError):
        return
    for name, p in d["plaetze"].items():
        q = v.get(name)
        if not isinstance(p, dict) or not isinstance(q, dict):
            continue
        for k in VORLAGE_ERBT:
            if k not in p and k in q:
                p[k] = q[k]


