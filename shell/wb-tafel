def platz_aus_def(cfg, name, d):
    art = d.get("art")
    if art not in ARTEN:
        fehler("Platz %s: unbekannte Art '%s' in %s (erlaubt: %s)."
               % (name, art, cfg.get("_quelle"), ", ".join(ARTEN)))
    kap = 1
    if art == "zaehlend":
        kap = d.get("kapazitaet")
        if not isinstance(kap, int) or isinstance(kap, bool) or kap < 1:
            fehler("Platz %s: 'kapazitaet' muss eine ganze Zahl ab 1 sein (%s)." % (name, cfg.get("_quelle")))
    if art == "menge":
        kap = None
    return {"name": name, "art": art, "kapazitaet": kap,
            "maschine": d.get("maschine", ""),
            "schwer": bool(d.get("schwer")), "sperrt_schwere": bool(d.get("sperrt_schwere")),
            "nicht_neben": [x for x in (d.get("nicht_neben") or []) if isinstance(x, str) and x],
            "schwer_ab": d.get("schwer_ab"), "einheit": d.get("einheit", "GiB" if art == "menge" else ""),
            "annahme_s": float(d.get("annahme_s", cfg.get("annahme_s", ANNAHME_S))),
            "nachtrag_s": float(d.get("nachtrag_s", cfg.get("nachtrag_s", NACHTRAG_S))),
            "muster": [m for m in (d.get("muster") or []) if isinstance(m, str) and m],
            "vorschlag_art": d.get("vorschlag_art", ""),
            "abbruch_kill_s": float(d.get("abbruch_kill_s", cfg.get("abbruch_kill_s", KILL_NACH_S))),
            "ohne_abbruch": bool(d.get("ohne_abbruch")),
            "selbst_vorrang_arten": [x for x in (d.get("selbst_vorrang_arten") or []) if isinstance(x, str)],
            "zwang_menge": float(d.get("zwang_menge") or 0) if art == "menge" else 0.0,
            "zweck": d.get("zweck", ""),
            "stoerung": bool(d.get("stoerung", cfg.get("stoerung", art == "exklusiv"))) and art == "exklusiv",
            "stoerung_cpu": float(d.get("stoerung_cpu", cfg.get("stoerung_cpu", STOERUNG_CPU))),
            "stoerung_ram_mib": float(d.get("stoerung_ram_mib", cfg.get("stoerung_ram_mib", STOERUNG_RAM_MIB))),
            "stoerung_dauer_s": float(d.get("stoerung_dauer_s", cfg.get("stoerung_dauer_s", STOERUNG_DAUER_S))),
            "stoerung_takt_s": float(d.get("stoerung_takt_s", cfg.get("stoerung_takt_s", STOERUNG_TAKT_S))),
            "stoerung_ausnahmen": [m for m in (d.get("stoerung_ausnahmen") or cfg.get("stoerung_ausnahmen") or [])
                                   if isinstance(m, str) and m]}


def zustaendigkeit_def(cfg, name):
    z = cfg.get("zustaendigkeiten") or {}
    if name in (z.get("feste") or []):
        return True
    return any(name.startswith(pr) and len(name) > len(pr) for pr in (z.get("praefixe") or []))


def platz_suchen(cfg, name, maschine):
    """Der Platz oder None (unbekannt bzw. andere Maschine) -- ohne Abbruch."""
    d = (cfg.get("plaetze") or {}).get(name)
    if isinstance(d, dict):
        if d.get("maschine", maschine) != maschine or d.get("art") not in ARTEN:
            return None
        return platz_aus_def(cfg, name, d)
    if zustaendigkeit_def(cfg, name):
        return {"name": name, "art": "zustaendigkeit", "kapazitaet": 1, "maschine": maschine,
                "schwer": False, "sperrt_schwere": False, "nicht_neben": [], "schwer_ab": None, "einheit": "",
                "annahme_s": float(cfg.get("annahme_s", ANNAHME_S)),
                "nachtrag_s": float(cfg.get("nachtrag_s", NACHTRAG_S)), "muster": [],
                "vorschlag_art": "", "zweck": "",
                "abbruch_kill_s": float(cfg.get("abbruch_kill_s", KILL_NACH_S)),
                "ohne_abbruch": False, "selbst_vorrang_arten": [], "zwang_menge": 0.0, "stoerung": False}
    return None


def platz(cfg, name, maschine):
    d = (cfg.get("plaetze") or {}).get(name)
    if isinstance(d, dict) and d.get("maschine", maschine) != maschine:
        fehler("der Platz %s gehoert zur Maschine %s, diese Tafel ist die von %s. "
               "Fragen: wb-tafel --maschine %s …" % (name, d.get("maschine"), maschine, d.get("maschine")))
    p = platz_suchen(cfg, name, maschine)
    if p is None:
        if isinstance(d, dict):
            platz_aus_def(cfg, name, d)     # meldet die kaputte Definition
        fehler("unbekannter Platz '%s'. Plaetze dieser Maschine: wb-tafel plaetze. "
               "Zustaendigkeiten: %s" % (name, ", ".join(
                   ((cfg.get("zustaendigkeiten") or {}).get("praefixe") or [])
                   + ((cfg.get("zustaendigkeiten") or {}).get("feste") or []))))
    return p


def ueberlappt(a, b):
    """Gleicher Platz, oder zwei Ansprueche, von denen einer der Elternpfad des anderen ist
    (pfad:repo/shell und pfad:repo/shell/wb-inbox)."""
    if a == b:
        return True
    if ":" not in a or ":" not in b or a.split(":", 1)[0] != b.split(":", 1)[0]:
        return False
    return a.startswith(b.rstrip("/") + "/") or b.startswith(a.rstrip("/") + "/")


def menge_pruefen(p, menge):
    if p["art"] in ("exklusiv", "zustaendigkeit"):
        if menge not in (None, 1, 1.0):
            fehler("der Platz %s ist %s: --menge gibt es dort nicht." % (p["name"], p["art"]))
        return 1
    if p["art"] == "zaehlend":
        m = 1 if menge is None else menge
        if m != int(m) or m < 1 or m > p["kapazitaet"]:
            fehler("--menge fuer %s muss eine ganze Zahl von 1 bis %d sein." % (p["name"], p["kapazitaet"]))
        return int(m)
    if menge is None:
        fehler("der Platz %s ist eine Menge (%s): --menge ist Pflicht." % (p["name"], p["einheit"]))
    if math.isnan(menge) or math.isinf(menge) or menge <= 0:
        fehler("--menge muss eine positive Zahl sein.")
    return float(menge)


