    bleiben = []
    for x in z.get("erlaubnisse", []):
        if t >= float(x.get("bis", 0)):
            verlauf_schreiben("erlaubnis-verfallen", platz=x.get("ziel"), eintrag=x.get("id"), durch=x.get("durch"))
            continue
        bleiben.append(x)
    z["erlaubnisse"] = bleiben


def cmd_pruefe_commit(a, cfg, maschine):
    """Fuer den Commit-Hook: Exit 0 frei, 1 abbrechen, 6 nur warnen (Commit darf)."""
    wurzel = repo_wurzel(a.repo)
    ziel = "hauptbaum:%s" % os.path.basename(wurzel)
    me = ich(0)
    rolle = rolle_von(me)
    ergebnis, text, nutzer = EXIT_OK, "", None
    with sperre():
        z, nachrichten, _ = sitzung(cfg, maschine)
        erlaubnisse_pruefen(z)
        # Traegt der Eintrag einen Pfad, gilt er nur fuer genau dieses Repo (Worktrees haben eine
        # andere Wurzel und zaehlen damit nicht); ohne Pfad wie bisher fuer jeden Ordner dieses Namens.
        halter = [e for e in z["eintraege"] if e.get("platz") == ziel
                  and (not e.get("pfad") or e["pfad"] == wurzel)
                  and schluessel(e.get("halter") or {}) != schluessel(me)]
        if halter:
            e = halter[0]
            wer = "%s haelt %s (%s, %s)" % (halter_text(e.get("halter") or {}), ziel, e["id"], e.get("zweck", ""))
            if rolle == "mensch":
                ergebnis, text = EXIT_WARNEN, "WARNUNG: %s. Ein Commit veraendert den geprueften Baum." % wer
                nutzer = "dem Menschen (nur gewarnt)"
            elif rolle == "orchestrator":
                erl = next((x for x in z["erlaubnisse"] if x.get("ziel") == ziel
                            and x.get("schluessel") == schluessel(me)
                            and x.get("pane_lstart") == me.get("pane_lstart")), None)
                if erl:
                    z["erlaubnisse"] = [x for x in z["erlaubnisse"] if x is not erl]
                    verlauf_schreiben("erlaubnis-verbraucht", platz=ziel, eintrag=erl["id"], durch=halter_text(me),
                                      grund=erl.get("grund"))
                    an_gruppe_tafel("commit-trotzdem", "commit-trotzdem: %s von %s in den Lauf %s -- %s"
                                    % (ziel, halter_text(me), e["id"], erl.get("grund")), platz=ziel, eintrag=e["id"])
                    ergebnis, text = EXIT_OK, "Einmal-Erlaubnis %s verbraucht: Commit trotz %s." % (erl["id"], wer)
                    nutzer = "einem Orchestrator mit Einmal-Erlaubnis (%s)" % erl.get("grund")
                else:
                    ergebnis, text = EXIT_BELEGT, ("ABGEBROCHEN: %s. Ist der Commit noetig, erst: wb-tafel trotzdem %s "
                                                   "--grund \"<satz>\" (einmalig, %d s gueltig)."
                                                   % (wer, ziel, int(cfg.get("erlaubnis_s", ERLAUBNIS_S))))
            else:
                ergebnis, text = EXIT_BELEGT, ("ABGEBROCHEN: %s. Kein Commit in den Hauptbaum waehrend eines "
                                               "Gesamtlaufs (Rolle: %s)." % (wer, rolle))
            if nutzer:
                nachrichten.append(nachricht(e.get("halter") or {}, (
                    "wb-tafel: In Deinen Lauf %s (%s) wurde committet, von %s: %s."
                    % (e["id"], ziel, halter_text(me), nutzer)), "commit", e["id"]))
            verlauf_schreiben("pruefe-commit", platz=ziel, eintrag=e["id"], durch=halter_text(me), rolle=rolle,
                              rc=ergebnis)
        zustand_schreiben(z)
    zustellen(nachrichten, me)
    if text:
        print("wb-tafel: " + text, file=sys.stderr)
    return ergebnis


def cmd_trotzdem(a, cfg, maschine):
    if not a.ziel.startswith("hauptbaum:"):
        fehler("trotzdem gibt es nur fuer hauptbaum:<repo>.")
    if not (a.grund or "").strip():
        fehler("--grund fehlt.")
    me = ich(0)
    rolle = rolle_von(me)
    if rolle not in ("orchestrator", "mensch"):
        fehler("trotzdem duerfen nur Orchestratoren und der Mensch (gemessene Rolle: %s)." % rolle, EXIT_RECHT)
    if not me.get("pane") and rolle != "mensch":
        fehler("trotzdem braucht einen nachgewiesenen Pane.", EXIT_RECHT)
    dauer = float(cfg.get("erlaubnis_s", ERLAUBNIS_S))
    with sperre():
        z, nachrichten, _ = sitzung(cfg, maschine)
        erlaubnisse_pruefen(z)
        t = jetzt()
        x = {"id": "e" + bausteine().kennung(), "ziel": a.ziel, "schluessel": schluessel(me),
             "pane_lstart": me.get("pane_lstart", ""), "bis": t + dauer, "bis_iso": bausteine().iso(t + dauer),
             "grund": a.grund.strip(), "durch": halter_text(me), "rolle": rolle}
        z["erlaubnisse"].append(x)
        verlauf_schreiben("erlaubnis", platz=a.ziel, eintrag=x["id"], durch=x["durch"], grund=x["grund"], rolle=rolle)
        an_gruppe_tafel("erlaubnis", "erlaubnis: %s fuer %s, einmal bis %s -- %s"
                        % (x["durch"], a.ziel, uhrzeit(x["bis"]), x["grund"]), platz=a.ziel, eintrag=x["id"])
        zustand_schreiben(z)
    zustellen(nachrichten, me)
    gib_aus("ERLAUBNIS %s: ein Commit in %s aus diesem Pane, bis %s." % (x["id"], a.ziel, uhrzeit(x["bis"])))
    return EXIT_OK

# ------------------------------------------------------------ andere Maschine

def fernaufruf(cfg, maschine, argv):
    """`--maschine <name>` fuer eine andere Maschine: derselbe Aufruf ueber ssh an deren Tafel.
    Ein maschinenuebergreifender Platz entsteht nie. Dort gibt es keinen Pane dieses Aufrufers:
    ein so angelegter Eintrag haengt allein an seiner Frist."""
    ziel = (cfg.get("ssh_ziel") or {}).get(maschine, maschine)
    rest, i = [], 0
    while i < len(argv):
        if argv[i] == "--maschine":
            i += 2
            continue
        if argv[i].startswith("--maschine="):
            i += 1
            continue
        rest.append(argv[i])
        i += 1
    frist = 120.0
    if "--warte" in rest:
        try:
            frist += dauer_lesen(rest[rest.index("--warte") + 1], "--warte")
        except IndexError:
            pass
    befehl = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", ziel,
              "~/.local/bin/wb-tafel " + " ".join(shlex.quote(x) for x in rest)]
    try:
        return subprocess.run(befehl, timeout=frist, stdin=subprocess.DEVNULL).returncode
    except subprocess.TimeoutExpired:
        fehler("ssh %s antwortet nicht binnen %d s." % (ziel, int(frist)), EXIT_DIENST)
    except OSError as e:
        fehler("ssh %s: %s" % (ziel, e), EXIT_DIENST)


# --------------------------------------------------------------------- main

def main(argv):
    p = argparse.ArgumentParser(
        prog="wb-tafel", description="Belegungstafel: Plaetze nehmen, warten, austragen.",
        epilog="Exit: 0 frei/erledigt, 1 belegt/nichts gefunden, 2 Aufruf, 3 gesperrt, "
               "4 nicht berechtigt, 5 Hilfsdienst gescheitert.")
    p.add_argument("--json", action="store_true", help="Ueberblick als JSON")
    p.add_argument("--maschine", default="", help="die Tafel einer anderen Maschine fragen (ssh)")
    sub = p.add_subparsers(dest="befehl")

    def frist_argumente(sp):
        sp.add_argument("--frist", default=None, help="90s, 20m, 2h oder 'vorschlag' (mit --art)")
        sp.add_argument("--zweck", default="", help="wofuer, in einem Satz (Pflicht)")
        sp.add_argument("--art", default="", help="Schluessel fuer die Dauerhistorie, etwa gesamtlauf")
        sp.add_argument("--menge", type=float, default=None, help="Einheiten bzw. GiB")
        sp.add_argument("--verweis", default="", help="Auftrag oder Ergebnisdatei")
        sp.add_argument("--pid", type=int, default=0, help="Lebendigkeit an diesen eigenen Vorfahren binden")
        sp.add_argument("--json", action="store_true")

    s = sub.add_parser("frei", help="ist der Platz jetzt frei? Exit 0/1")
    s.add_argument("platz")
    s.add_argument("--menge", type=float, default=None)
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("nimm", help="pruefen/eintragen; optional mit -- <befehl> samt Kennung ausfuehren")
    s.add_argument("platz")
    frist_argumente(s)
    s.add_argument("--anstellen", action="store_true", help="belegt: in die Warteschlange")
    s.add_argument("--warte", default="", help="belegt: anstellen und so lange auf 'dran' warten")
    s.add_argument("--repo-pfad", default="", help="hauptbaum:<name>: Arbeitsbaum, den der Anspruch haelt "
                                                   "(Vorgabe: das Arbeitsverzeichnis, wenn es so heisst)")

    s = sub.add_parser("anstellen", help="in die Warteschlange eines Platzes")
    s.add_argument("platz")
    frist_argumente(s)

    s = sub.add_parser("gib", help="austragen (Eintrag, Wartender oder eigene auf einem Platz)")
    s.add_argument("ziel")
    s.add_argument("--pid", type=int, default=0)

    s = sub.add_parser("verlaengern", help="Frist verlaengern, mit Grund")
    s.add_argument("eintrag")
    s.add_argument("--um", required=True)
    s.add_argument("--grund", default="")
    s.add_argument("--pid", type=int, default=0)

    s = sub.add_parser("binden", help="einen Eintrag an eine eigene PID umbinden (Lauf uebernimmt "
                                      "einen Vorab-Eintrag)")
    s.add_argument("eintrag")
    s.add_argument("--pid", type=int, required=True, help="der Lauf: ein Nachfahr des eigenen Panes")
    s.add_argument("--platz", default="", help="zusichern, dass der Eintrag zu diesem Platz gehoert")
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("vorrang", help="Wartenden nach vorn holen (Orchestratoren, Mensch)")
    s.add_argument("eintrag")
    s.add_argument("--grund", default="")

    s = sub.add_parser("plaetze", help="Platzdefinitionen")
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("verlauf", help="Protokoll der Ein- und Austragungen")
    s.add_argument("--seit", default="", help="ISO-Zeit (2026-10-09T08:00) oder Dauer zurueck (2h); "
                                              "Vorgabe 24h")
    s.add_argument("--platz", default="")
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("aufraeumen", help="Fristen pruefen, Verfallenes austragen, mahnen")
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("waechter", help=argparse.SUPPRESS)
    s.add_argument("eintrag")

    s = sub.add_parser("pruefe-commit", help="fuer den Commit-Hook: Exit 0 frei, 1 abbrechen, 6 nur warnen")
    s.add_argument("repo")

    s = sub.add_parser("trotzdem", help="Einmal-Erlaubnis fuer einen Commit in einen gehaltenen Hauptbaum "
                                        "(Orchestratoren, Mensch)")
    s.add_argument("ziel")
    s.add_argument("--grund", default="")

    s = sub.add_parser("melde-start", help="Einbindungsstellen: ein Start auf <platz> (Exit 0 gedeckt, "
                                           "1 unangemeldet erfasst)")
    s.add_argument("platz")
    s.add_argument("--pid", type=int, required=True, help="der gestartete Prozess")
    s.add_argument("--menge", type=float, default=None)

    # argparse's REMAINDER positional would consume valid nimm options such as
    # --frist. Split only at the explicit separator, then parse the options
    # normally and attach the remaining argv to the nimm namespace.
    lauf = []
    trenner = None
    if argv is None:
        argv = sys.argv[1:]
    else:
        argv = list(argv)
    try:
        nimm_index = argv.index("nimm")
    except ValueError:
        nimm_index = -1
    if nimm_index >= 0:
        try:
            trenner = argv.index("--", nimm_index + 1)
        except ValueError:
            pass
        if trenner is not None:
            lauf = argv[trenner + 1:]
            argv = argv[:trenner]
    a = p.parse_args(argv)
    if a.befehl == "nimm":
        a.lauf = lauf
        if trenner is not None and not a.lauf:
            p.error("nach nimm -- fehlt der auszufuehrende Befehl")
    cfg = plaetze_laden()
    maschine = lokale_maschine(cfg)
    if a.maschine and a.maschine != maschine:
        return fernaufruf(cfg, a.maschine, argv)
    bausteine()
    befehl = a.befehl or "ueberblick"
    rc = {"ueberblick": cmd_ueberblick, "frei": cmd_frei, "nimm": cmd_nimm, "anstellen": cmd_anstellen,
          "gib": cmd_gib, "verlaengern": cmd_verlaengern, "binden": cmd_binden, "vorrang": cmd_vorrang,
          "plaetze": cmd_plaetze, "verlauf": cmd_verlauf, "aufraeumen": cmd_aufraeumen,
          "melde-start": cmd_melde_start, "waechter": cmd_waechter, "pruefe-commit": cmd_pruefe_commit,
          "trotzdem": cmd_trotzdem}[befehl](a, cfg, maschine)
    # Was ein Befehl ohne eigenes zustellen() gesammelt hat. Bei fehler() (sys.exit) wird
    # nichts gesendet: der Zustand dieses Aufrufs wurde dann auch nicht geschrieben.
    gruppe_senden()
    return rc


def an_live_uebergeben(argv):
    """Eine Kopie dieses Werkzeugs, die nicht ~/.local/bin/wb-tafel ist (realpath) und KEINEN eigenen
    Zustandsordner hat (WB_TAFEL_STATE fehlt oder zeigt auf den Live-Zustand), uebergibt per exec an die
    Live-Tafel; gibt es die nicht, lehnt sie ab (Exit 2). Anlass, gemessen 11.10. 06:26:56: die Kopie
    eines Worktrees mit Basis vor dem Abschalter der Zustellung schrieb in den Live-Zustand und stellte
    trotz `zustellung-aus` in einen Pane zu. Tests setzen WB_TAFEL_STATE und bleiben bei ihrer Kopie.
    Kopien, die vor dieser Regel verteilt wurden (andere Worktrees), bekommen sie erst mit ihrer
    naechsten Basis."""
    live = os.path.join(HOME, ".local", "bin", "wb-tafel")
    live_zustand = os.path.realpath(os.path.join(HOME, ".local", "state", "wb-tafel"))
    eigen = os.environ.get("WB_TAFEL_STATE", "")
    if eigen and os.path.realpath(eigen) != live_zustand:
        return
    if os.path.isfile(live) and os.access(live, os.X_OK):
        if os.path.realpath(live) == os.path.realpath(__file__):
            return
        os.execv(live, [live] + argv)
    print("wb-tafel: diese Kopie (%s) ist nicht die Live-Tafel und hat keinen eigenen Zustandsordner "
          "(WB_TAFEL_STATE); %s fehlt, deshalb tut sie nichts. Tests setzen WB_TAFEL_STATE auf einen "
          "eigenen Ordner." % (os.path.realpath(__file__), live), file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    an_live_uebergeben(sys.argv[1:])
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
