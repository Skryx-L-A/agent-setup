def baum_rss_gib(pid):
    """Resident Set Size des Prozesses und aller Nachfahren in GiB (ein ps-Aufruf), 0.0 wenn
    nicht messbar. Untergrenze: Metal-Zuteilungen eines Modellservers stehen nicht ganz darin."""
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    try:
        aus = subprocess.run(["ps", "-axo", "pid=,ppid=,rss="], capture_output=True, text=True,
                             timeout=10, env=env).stdout
    except (OSError, subprocess.SubprocessError):
        return 0.0
    kinder, rss = {}, {}
    for zeile in aus.splitlines():
        t = zeile.split()
        if len(t) == 3 and all(x.isdigit() for x in t):
            kinder.setdefault(int(t[1]), []).append(int(t[0]))
            rss[int(t[0])] = int(t[2])
    if pid not in rss:
        return 0.0
    summe, offen, gesehen = 0, [pid], set()
    while offen:
        q = offen.pop()
        if q in gesehen:
            continue
        gesehen.add(q)
        summe += rss.get(q, 0)
        offen.extend(kinder.get(q, []))
    return summe / (1024.0 * 1024.0)


