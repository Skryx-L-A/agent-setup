#     stehen auf dieser Maschine ueber 14 Milliarden Cache-Lesetoken -- eine Zeile je Nachricht
#     waeren Hunderttausende Objekte im Speicher fuer eine Ausgabe, die niemand einzeln liest.
#   * Die Filter (--harness/--modell/--sitzung) greifen VOR der Summierung. Wer zwei Zeitraeume
#     vergleichen will, ruft zweimal mit --von/--bis auf; ein eigener Vergleichsmodus waere eine
#     zweite Wahrheit ueber dieselbe Frage.
#   * Jede Quelle traegt ihren Zustand ("gelesen"/"leer"/"fehlt"/"unlesbar") und ihre Nachrichten-
#     zahl mit. Eine Quelle, die nichts liefert, ist damit von einer Quelle unterscheidbar, die
#     es nicht gibt.
if [ "${1:-}" = "--json" ]; then
  shift
  TAGE=7
  VON=""
  BIS=""
  F_HARNESS=""
  F_MODELL=""
  F_SITZUNG=""
  OHNE_KONTINGENT=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --tage)     TAGE="${2:?wb-budget --json --tage <N>: Zahl fehlt}"; shift 2 ;;
      --von)      VON="${2:?wb-budget --json --von <ISO>: Zeitpunkt fehlt}"; shift 2 ;;
      --bis)      BIS="${2:?wb-budget --json --bis <ISO>: Zeitpunkt fehlt}"; shift 2 ;;
