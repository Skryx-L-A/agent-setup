# da. Das Modell steht nicht im Ereignis selbst, sondern im zuletzt vorausgegangenen
# `turn_context`; ein Modellwechsel mitten in der Sitzung wird so richtig zugeordnet.
def lies_codex():
    wurzel = os.path.join(HOME, ".codex", "sessions")
    if not os.path.isdir(wurzel):
        quelle("codex", wurzel, "fehlt")
        return
    n = 0
    for pfad in sorted(glob.glob(os.path.join(wurzel, "*", "*", "*", "rollout-*.jsonl"))):
        try:
            if os.path.getmtime(pfad) < VON:
                continue
        except OSError:
            continue
        sitzung = os.path.basename(pfad)[:-6]
        worker = ""
        ordner = ""
        modell = "?"
        vorher = None
        try:
            f = open(pfad, errors="ignore")
        except OSError:
            continue
        with f:
            for zeile in f:
