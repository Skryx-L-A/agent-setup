        # Workbench lief; sonst bleibt das Feld leer und die Anzeige zeigt den Ordner. Geraten
        # wird nichts: "das letzte Stueck hinter dem letzten Bindestrich" ergaebe bei
        # `-Users-<user>` den Namen "<user>".
        MARKE = "-pi-workers-worktrees-"
        worker = ordner.split(MARKE, 1)[1] if MARKE in ordner else ""
        try:
            f = open(pfad, errors="ignore")
        except OSError:
            continue
        with f:
            for zeile in f:
                if '"usage"' not in zeile:
                    continue
                try:
                    d = json.loads(zeile)
                except Exception:
                    continue
                if d.get("type") != "assistant":
                    continue
                msg = d.get("message") or {}
                u = msg.get("usage")
                ts = parse_iso(d.get("timestamp") or "")
                if not u or ts is None:
                    continue
                modell = msg.get("model") or "?"
                tok = {"input": u.get("input_tokens") or 0,
                       "output": u.get("output_tokens") or 0,
                       "cache_write": u.get("cache_creation_input_tokens") or 0,
                       "cache_read": u.get("cache_read_input_tokens") or 0,
                       "reasoning": 0}
                if buche("claude", modell, sitzung, worker, ts, tok, ordner):
                    n += 1
                    vor = letzte.get(sitzung)
                    if vor is not None:
                        tempo_naeherung("claude", modell, tok["output"], ts - vor)
                    letzte[sitzung] = ts
    quelle("claude", wurzel, "gelesen" if n else "leer", n,
           "Rate nur als Wanduhr-Naeherung: die Transkripte tragen keinen Zwischenstand waehrend "
           "der Generierung, nur den Abstand zwischen fertigen Nachrichten.")


