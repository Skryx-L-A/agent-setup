import glob, json, os, sys
from datetime import datetime, timezone, timedelta
from zoneinfo import ZoneInfo

LIMITS_PATH, TAGE, PROJECTS_DIR = sys.argv[1], int(sys.argv[2]), sys.argv[3]

# Preistabelle s. Kopfkommentar oben im Skript — hier nur die ausfuehrbare Form derselben Zahlen.
PRICES = {
    "claude-opus-5":             (5, 25),
    "claude-opus-4-8":           (5, 25),
    "claude-sonnet-5":           (3, 15),
    "claude-haiku-4-5-20251001": (1, 5),
    "claude-fable-5":            (10, 50),
}
CACHE_WRITE_FAKTOR = 1.25
CACHE_READ_FAKTOR = 0.1
PLAN_HISTORIE_PATH = os.path.expanduser("~/.claude/workbench/plan-historie.json")
ANKER_PATH = os.path.expanduser("~/.claude/workbench/limit-anker.json")
BERLIN = ZoneInfo("Europe/Berlin")
BELASTBAR_SEKUNDEN = 300  # Begruendung im Kopfkommentar dieses Unterbefehls oben im Skript.

FIELDS = [("five_hour_pct", "5-Stunden-Fenster"), ("seven_day_pct", "7-Tage-Fenster")]


def parse_ts(s):
    s = s.rstrip("Z")
    if "." in s:
        s = s.split(".")[0]
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).timestamp()


def parse_ts_offset(s):
    # Fuer die Planhistorie: dort steht der Zeitstempel mit EXPLIZITEM Offset ("+02:00"), nicht
    # nur als "Z" wie in limits.jsonl/den Transkripten -- Python 3.9 (dieses System) kennt
    # fromisoformat("...Z") noch nicht, "...+00:00" aber schon, daher die Ersetzung.
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    return datetime.fromisoformat(s).astimezone(timezone.utc).timestamp()


def load_plan_historie():
    # Format: ~/.claude/workbench/plan-historie.json ist Datei des Nutzers, von Hand gepflegt
    # ({"plaene": [{"plan": "...", "von": "...", "bis": "...|null"}, ...]}, weitere Schluessel
    # je Eintrag erlaubt und ignoriert) -- s. shell/plan-historie.default.json.
    if not os.path.exists(PLAN_HISTORIE_PATH):
        return None
    try:
        raw = json.load(open(PLAN_HISTORIE_PATH))
        if isinstance(raw, dict):
            raw = raw.get("plaene", [])
    except Exception:
        return None
    out = []
    for e in raw:
        try:
            out.append({
                "von": parse_ts_offset(e["von"]),
                "bis": parse_ts_offset(e["bis"]) if e.get("bis") else None,
                "plan": e.get("plan") or "?",
            })
        except Exception:
            continue
    out.sort(key=lambda e: e["von"])
    return out


def plan_at(epoch, historie):
    if not historie:
        return "unbekannt (keine Planhistorie-Datei)"
    for e in historie:
        if epoch >= e["von"] and (e["bis"] is None or epoch < e["bis"]):
            return e["plan"]
    return "unbekannt (ausserhalb der Planhistorie)"


def plan_konsistent(von, bis, historie):
    # Prueft, ob EIN Plan den ganzen Zeitraum [von, bis) traegt -- an den Raendern und an jeder
    # Plan-Historie-Kante, die dazwischen liegt. Fuer externe Anker (limit-anker.json): ein
    # Wochenwert von vor limits.jsonl darf nur mitrechnen, wenn das hier bestaetigt ist.
    if not historie:
        return False, "keine Planhistorie -- nicht pruefbar"
    punkte = {von, bis - 1}
    for e in historie:
        if von < e["von"] < bis:
            punkte.add(e["von"])
        if e["bis"] is not None and von < e["bis"] < bis:
            punkte.add(e["bis"])
    plaene = {plan_at(p, historie) for p in punkte}
    if len(plaene) == 1:
        return True, next(iter(plaene))
    return False, "mischt Plaene: " + ", ".join(sorted(plaene))


def montags_1400_berlin(start_epoch, end_epoch):
    d = datetime.fromtimestamp(start_epoch, BERLIN)
    d = (d - timedelta(days=d.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
    out = []
    while True:
        kante = d.replace(hour=14, minute=0, second=0, microsecond=0).timestamp()
        if kante > end_epoch + 86400:
            break
        if kante >= start_epoch - 7 * 86400:
            out.append(kante)
        d += timedelta(days=7)
    return sorted(set(out))


def load_anker():
    # ~/.claude/workbench/limit-anker.json: von Hand nachgerechnete Verbrauchsabschnitte, die
    # NICHT aus limits.jsonl automatisch erkennbar sind (typisch: ein Wochenfenster, das vor
    # dem Beginn von limits.jsonl lag). Format: {"anker": [{"feld": "seven_day_pct", "von":
    # "...", "bis": "...", "punkte": 94, "usd": {"claude-opus-5": 7015, ...}, "quelle": "..."}]}.
    # Ohne Token-Aufschluesselung -- ein Anker liefert deshalb nur einen Beitrag zur
    # USD-Basis, nie zu den beiden Token-Basen.
    if not os.path.exists(ANKER_PATH):
        return []
    try:
        raw = json.load(open(ANKER_PATH))
        if isinstance(raw, dict):
            raw = raw.get("anker", [])
    except Exception:
        return []
    out = []
    for e in raw:
        try:
            out.append({
                "feld": e["feld"],
                "von": parse_ts_offset(e["von"]),
                "bis": parse_ts_offset(e["bis"]),
                "von_iso": e["von"],
                "bis_iso": e["bis"],
                "punkte": float(e["punkte"]),
                "usd": {k: float(v) for k, v in (e.get("usd") or {}).items()},
                "quelle": e.get("quelle") or "?",
            })
        except Exception:
            continue
    return out


PLAN_HISTORIE = load_plan_historie()
ANKER = load_anker()

rows = []
with open(LIMITS_PATH) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
            d["_epoch"] = parse_ts(d["ts"])
        except Exception:
            continue
        rows.append(d)

cutoff = datetime.now(timezone.utc).timestamp() - TAGE * 86400
rows = [r for r in rows if r["_epoch"] >= cutoff]
rows.sort(key=lambda r: r["_epoch"])

if PLAN_HISTORIE is None:
    print(f"WARNUNG: keine Planhistorie unter {PLAN_HISTORIE_PATH}. Die Gewichte unten gelten")
    print("nur, solange im jeweiligen Zeitraum kein Tarifwechsel (Pro/Max 100/Max 200/...)")
    print("stattfand -- ungeprueft, weil die Datei fehlt.")
    print()

if not rows:
    print(f"keine verwertbaren Zeilen in den letzten {TAGE} Tagen in {LIMITS_PATH}.")
    sys.exit(0)

WEEKLY_KANTEN = montags_1400_berlin(rows[0]["_epoch"], datetime.now(timezone.utc).timestamp())


def segments(field):
    # Identisch zu --limit-kalibrierung: Spitzenwert-Vergleich (Rauschtoleranz bis zur Haelfte
    # des Spitzenwerts), zusaetzlich getrennt an Plan- und (nur 7-Tage-Fenster) Montags-Kanten.
    segs, start, peak = [], None, None
    for r in rows:
        v = r.get(field)
        if v is None:
            continue
        if start is None:
            start = peak = r
            continue
        plan_wechsel = plan_at(r["_epoch"], PLAN_HISTORIE) != plan_at(peak["_epoch"], PLAN_HISTORIE)
        montag_ueberschritten = field == "seven_day_pct" and any(
            peak["_epoch"] < k <= r["_epoch"] for k in WEEKLY_KANTEN
        )
        if plan_wechsel or montag_ueberschritten:
            segs.append((start, peak))
            start = peak = r
            continue
        if v >= peak[field]:
            peak = r
        elif v < peak[field] / 2:
            segs.append((start, peak))
            start = peak = r
    if start is not None:
        segs.append((start, peak))
    return [(s, l) for (s, l) in segs if (l[field] - s[field]) >= 3]


def load_usage(start_epoch, end_epoch):
    usage = {}
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        try:
            if os.path.getmtime(path) < start_epoch:
                continue
        except OSError:
            continue
        try:
            with open(path, errors="ignore") as f:
                for line in f:
                    if '"usage"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if d.get("type") != "assistant":
                        continue
                    msg = d.get("message") or {}
                    u = msg.get("usage")
                    ts = d.get("timestamp")
                    if not u or not ts:
                        continue
                    try:
                        te = parse_ts(ts)
                    except Exception:
                        continue
                    if te < start_epoch or te > end_epoch:
                        continue
                    model = msg.get("model") or "?"
                    m = usage.setdefault(model, {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0})
                    m["input"] += u.get("input_tokens") or 0
                    m["output"] += u.get("output_tokens") or 0
                    m["cache_write"] += u.get("cache_creation_input_tokens") or 0
                    m["cache_read"] += u.get("cache_read_input_tokens") or 0
        except OSError:
            continue
    return usage


def usd(model, t):
    if model not in PRICES:
        return None
    pin, pout = PRICES[model]
    return (t["input"] / 1e6 * pin + t["output"] / 1e6 * pout
            + t["cache_write"] / 1e6 * pin * CACHE_WRITE_FAKTOR
            + t["cache_read"] / 1e6 * pin * CACHE_READ_FAKTOR)


def solve_linear(A, b):
    # Gauss-Jordan mit Teilpivotisierung, reine Python-Implementierung (kein numpy installiert).
    # None = singulaer (Abschnitte nicht unabhaengig genug -- z.B. zu aehnlicher Modellmix).
    n = len(A)
    M = [row[:] + [b[i]] for i, row in enumerate(A)]
    for col in range(n):
        piv = max(range(col, n), key=lambda r: abs(M[r][col]))
        if abs(M[piv][col]) < 1e-9:
            return None
        M[col], M[piv] = M[piv], M[col]
        p = M[col][col]
        M[col] = [v / p for v in M[col]]
        for r in range(n):
            if r != col:
                f = M[r][col]
                M[r] = [M[r][k] - f * M[col][k] for k in range(n + 1)]
    return [M[i][n] for i in range(n)]


def least_squares(A, b, models):
    # Normalgleichung A^T A x = A^T b. Bei quadratischem, invertierbarem A liefert das exakt
    # dieselbe Loesung wie A x = b direkt -- ein Codepfad fuer exakt UND ueberbestimmt.
    n = len(models)
    m = len(A)
    if m < n:
        return None, f"unterbestimmt: {m} Gleichung(en) fuer {n} Modell(e)/Unbekannte"
    AtA = [[sum(A[k][i] * A[k][j] for k in range(m)) for j in range(n)] for i in range(n)]
    Atb = [sum(A[k][i] * b[k] for k in range(m)) for i in range(n)]
    x = solve_linear(AtA, Atb)
    if x is None:
        return None, "Gleichungssystem singulaer -- Abschnitte sind nicht unabhaengig genug (zu aehnlicher Modellmix)"
    return dict(zip(models, x)), None


def zeige_basis(titel, basis_key, einheit, skala, kehrwert_einheit, segdata):
    # Externe Anker (limit-anker.json) tragen keine Token-Daten -- fuer die beiden Token-Basen
    # faellt ihr Eintrag hier einfach raus (leeres dict), statt als Nullzeile ("0*w=94") das
    # Gleichungssystem zu verfaelschen.
    verwendbar = [sd for sd in segdata if sd[basis_key]]
    models = sorted({m for sd in verwendbar for m in sd[basis_key]})
    print(f"  -- {titel} ({len(verwendbar)} Gleichung(en), {len(models)} Modell(e)) --")
    if not models:
        print("    keine Daten fuer diese Basis in den belastbaren Abschnitten.")
        return
    A = [[sd[basis_key].get(m, 0.0) for m in models] for sd in verwendbar]
    b_ = [sd["delta"] for sd in verwendbar]
    w, err = least_squares(A, b_, models)
    if err:
        print(f"    nicht loesbar: {err}")
        return
    neg = [m for m in models if w[m] < -1e-9]
    for m in models:
        je_einheit = w[m] * skala
        kehrwert = (1.0 / w[m]) if abs(w[m]) > 1e-12 else float("inf")
        print(f"    {m}: {je_einheit:.4f} Punkte je {einheit}  ({kehrwert:.2f} {kehrwert_einheit} bei reinem Verbrauch dieses Modells)")
    if neg:
        print(f"    WARNUNG negatives Gewicht bei {', '.join(neg)} -- kein brauchbares Ergebnis,")
        print("    die Datenlage reicht nicht (Abschnitte zu wenige oder zu widerspruechlich).")
    if len(verwendbar) - 1 < len(models):
        print(f"    Kreuzprobe: nicht moeglich -- nach Entfernen eines Abschnitts blieben nur "
              f"{len(verwendbar) - 1} Gleichung(en) fuer {len(models)} Modell(e) (unterbestimmt). "
              f"Erst ab {len(models) + 1} Gleichungen in dieser Basis pruefbar.")
    else:
        for j, sd_out in enumerate(verwendbar):
            rest = [sd for k, sd in enumerate(verwendbar) if k != j]
            A2 = [[sd[basis_key].get(m, 0.0) for m in models] for sd in rest]
            b2 = [sd["delta"] for sd in rest]
            w2, err2 = least_squares(A2, b2, models)
            if err2:
                print(f"    Kreuzprobe ohne Abschnitt {sd_out['id']}: nicht loesbar ({err2})")
            else:
                werte = ", ".join(f"{m}={w2[m] * skala:.4f}" for m in models)
                print(f"    Kreuzprobe ohne Abschnitt {sd_out['id']}: {werte} Punkte je {einheit}")


alle_segdata = {}
for field, label in FIELDS:
    alle = segments(field)
    belastbar = []
    for (s, l) in alle:
        dauer = l["_epoch"] - s["_epoch"]
        if dauer >= BELASTBAR_SEKUNDEN:
            belastbar.append((s, l, dauer))
    anker_treffer = [a for a in ANKER if a["feld"] == field]

    print(f"== {label} ==")
    print(f"  {len(alle)} Abschnitt(e) mit mindestens 3 Punkten Anstieg gefunden, davon "
          f"{len(belastbar)} belastbar (Dauer >= {BELASTBAR_SEKUNDEN}s = {BELASTBAR_SEKUNDEN // 60}min), "
          f"dazu {len(anker_treffer)} externe(r) Anker aus {ANKER_PATH}.")
    if not belastbar and not anker_treffer:
        print("  keine Gewichte berechenbar.")
        print()
        continue

    segdata = []
    for i, (s, l, dauer) in enumerate(belastbar, 1):
        delta = l[field] - s[field]
        usage = load_usage(s["_epoch"], l["_epoch"])
        usd_u, tok_incl, tok_ohne, unpriced = {}, {}, {}, []
        for m, t in usage.items():
            tok_incl[m] = float(sum(t.values()))
            tok_ohne[m] = float(t["input"] + t["output"] + t["cache_write"])
            c = usd(m, t)
            if c is None:
                if tok_incl[m] > 0:
                    unpriced.append(m)
            else:
                usd_u[m] = c
        plan = plan_at(s["_epoch"], PLAN_HISTORIE)
        print(f"    {i}. {s['ts']} -> {l['ts']}, +{delta} Punkte, Dauer {dauer/3600:.1f}h, Plan: {plan}")
        if unpriced:
            print(f"       ohne Preis (nur in Token-Basis beruecksichtigt): {', '.join(sorted(set(unpriced)))}")
        segdata.append({"id": str(i), "delta": delta, "usd": usd_u, "tok_incl": tok_incl, "tok_ohne": tok_ohne})

    for j, a in enumerate(anker_treffer, 1):
        eid = f"E{j}"
        ok, info = plan_konsistent(a["von"], a["bis"], PLAN_HISTORIE)
        if not ok:
            print(f"    {eid}. extern {a['von_iso']} -> {a['bis_iso']}, +{a['punkte']:.0f} Punkte -- "
                  f"NICHT verwendet ({info}).")
            continue
        print(f"    {eid}. extern {a['von_iso']} -> {a['bis_iso']}, +{a['punkte']:.0f} Punkte, "
              f"Plan: {info} (durchgehend bestaetigt). Quelle: {a['quelle']}")
        segdata.append({"id": eid, "delta": a["punkte"], "usd": dict(a["usd"]), "tok_incl": {}, "tok_ohne": {}})
    alle_segdata[field] = segdata
    print()

    zeige_basis("Punkte je USD-Aequivalent", "usd", "USD", 1.0, "USD/Punkt", segdata)
    zeige_basis("Punkte je Million Tokens, inkl. cache_read", "tok_incl", "Mio. Tokens", 1e6, "Tokens/Punkt", segdata)
    zeige_basis("Punkte je Million Tokens, ohne cache_read", "tok_ohne", "Mio. Tokens", 1e6, "Tokens/Punkt", segdata)
    n_models = len(sorted({m for sd in segdata for m in sd["tok_incl"]}))
    n_tok_segs = len([sd for sd in segdata if sd["tok_incl"]])
    print(f"  Aufteilung je Modell UND Tokenart (Eingabe/Ausgabe/Cache-Schreiben/Cache-Lesen)")
    print(f"  nicht ausgewiesen: das braeuchte {n_models} Modell(e) x 4 Arten = {n_models*4} Unbekannte,")
    print(f"  bei {n_tok_segs} Abschnitt(en) mit Token-Daten -- Datenlage reicht nicht annaehernd.")
    print()

# --- Kombiniert: die beiden belastbaren 5-Stunden-Abschnitte + der Wochenfenster-Anker in EIN
# gemeinsames Gleichungssystem (Anweisung des Nutzers 2026-08-10, nachdem plan-historie.json den
# Wochen-Anker als plan-rein bestaetigte). Setzt voraus, dass ein Limit-Punkt im 5-Stunden- und
# im 7-Tage-Fenster dieselbe Tokenmenge bedeutet -- das ist NICHT geprueft, nur die einzige
# Annahme, die einen direkten Vergleich ueberhaupt erlaubt. Nur die USD-Basis: der Anker hat
# keine Token-Aufschluesselung.
kombiniert = []
for sd in alle_segdata.get("five_hour_pct", []):
