      # Nur fuer Tests und fuer den Fall, dass wb-kontingent auf dieser Maschine fehlt: der
      # Kontingentblock bleibt dann leer, statt den ganzen Bericht scheitern zu lassen.
      --ohne-kontingent) OHNE_KONTINGENT=1; shift ;;
      *) echo "wb-budget --json: unbekannte Option '$1'" >&2; exit 1 ;;
    esac
  done
  case "$TAGE" in
    ''|*[!0-9]*)
      echo "wb-budget --json: --tage braucht eine positive Ganzzahl, nicht '$TAGE'" >&2
      exit 1
      ;;
  esac

  HIER="$(cd "$(dirname "$0")" && pwd)"
  /usr/bin/python3 - "$TAGE" "$VON" "$BIS" "$F_HARNESS" "$F_MODELL" "$F_SITZUNG" \
    "$OHNE_KONTINGENT" "$HIER/models.default.json" "$HIER/wb-kontingent" "$WORKBENCH_LIMITS" <<'PY'
import glob, json, os, sqlite3, subprocess, sys
from datetime import datetime, timezone

(TAGE, VON_S, BIS_S, F_HARNESS, F_MODELL, F_SITZUNG,
 OHNE_KONTINGENT, MODELS_JSON, KONTINGENT_BIN, LIMITS_PATH) = sys.argv[1:11]

HOME = os.path.expanduser("~")

# Die groesste Luecke zwischen zwei Nachrichten, die noch als Generierungszeit zaehlt. Ohne diese
# Schranke wuerde jede Mittagspause zwischen zwei Antworten als Rechenzeit desselben Modells
# gebucht und die Rate beliebig klein rechnen. 120 Sekunden ist eine SETZUNG, keine Messung: die
# gemessenen echten Abstaende lagen bei 0,66 s und 9,26 s, eine Denkpause mit Werkzeugaufrufen
# liegt darunter, eine menschliche Pause deutlich darueber. Laengere Luecken zaehlen weder im
# Zaehler noch im Nenner mit -- die Rate beschreibt dann eben nur den gemessenen Teil.
NAEHERUNG_LUECKE_MAX = 120.0


def parse_iso(s):
    """ISO-8601 zu Epoche. Python 3.9 (dieses System) kennt fromisoformat('...Z') noch nicht."""
    s = (s or "").strip()
    if not s:
        return None
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    if "." in s:
        kopf, rest = s.split(".", 1)
        vorz = ""
        for z in ("+", "-"):
            if z in rest:
                i = rest.index(z)
                vorz, rest = rest[i:], rest[:i]
                break
        s = kopf + vorz
    try:
        d = datetime.fromisoformat(s)
    except ValueError:
        try:
            d = datetime.strptime(s, "%Y-%m-%d")
        except ValueError:
            return None
    if d.tzinfo is None:
        d = d.replace(tzinfo=timezone.utc)
    return d.timestamp()


def iso(e):
    return datetime.fromtimestamp(e, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def tag(e):
    return datetime.fromtimestamp(e, timezone.utc).strftime("%Y-%m-%d")


JETZT = datetime.now(timezone.utc).timestamp()
BIS = parse_iso(BIS_S) or JETZT
VON = parse_iso(VON_S)
if VON is None:
    VON = BIS - int(TAGE) * 86400


def liste(s):
    return set(x.strip() for x in (s or "").split(",") if x.strip())


NUR_HARNESS, NUR_MODELL, NUR_SITZUNG = liste(F_HARNESS), liste(F_MODELL), liste(F_SITZUNG)

# --- Die Registry, nur gelesen ---------------------------------------------------------------
# Gebraucht wird sie fuer zweierlei: die Liste ALLER Harnesses (damit die Luecken vollstaendig
# sind, nicht nur die zufaellig bekannten) und die Art des Anbieters je Harness (Abo, Cloud,
# lokal) -- daran haengt, ob ein Dollarbetrag ueberhaupt ein Preis sein kann.
HARNESS_ART = {}
MODELL_HARNESS = {}
ALLE_HARNESS = []
try:
    _reg = json.load(open(MODELS_JSON))
    _kind = dict((p["id"], p.get("kind") or "?") for p in _reg.get("providers", []))
    for h in _reg.get("harnesses", []):
        ALLE_HARNESS.append(h["id"])
    for m in _reg.get("models", []):
        MODELL_HARNESS[m.get("id")] = m.get("harness")
        if m.get("harness") and m.get("provider"):
            HARNESS_ART.setdefault(m["harness"], _kind.get(m["provider"], "?"))
except Exception:
    pass
if not ALLE_HARNESS:
    ALLE_HARNESS = ["claude", "codex", "pi", "opencode", "copilot", "copilot-cloud", "openhands"]
# Die eingebauten Claude-Kennungen stehen in keiner Registry-Datei (siehe einstellungsfenster.ts).
HARNESS_ART.setdefault("claude", "subscription")

# --- Die Sammelbecken ------------------------------------------------------------------------
ARTEN = ("input", "output", "cache_write", "cache_read", "reasoning")


def neu():
    d = dict((a, 0) for a in ARTEN)
    d["nachrichten"] = 0
    return d


gesamt = neu()
je_harness = {}
je_modell = {}
je_sitzung = {}
je_tag = {}
# (harness, modell) -> Zaehler und Nenner beider Tempo-Arten, streng getrennt gehalten.
tempo = {}
# Was ein Harness selbst an Geld/Verbrauchseinheiten mitschreibt -- nie mit einem Katalogpreis
# vermischt, deshalb ein eigenes Becken.
eigen_usd = {}
eigen_aiu = {}
quellen = []


def _add(ziel, tok):
    for a in ARTEN:
        ziel[a] += tok.get(a, 0)
    ziel["nachrichten"] += 1


def passt(harness, modell, sitzung):
    if NUR_HARNESS and harness not in NUR_HARNESS:
        return False
    if NUR_MODELL and modell not in NUR_MODELL:
        return False
    if NUR_SITZUNG and sitzung not in NUR_SITZUNG:
        return False
    return True


def buche(harness, modell, sitzung, worker, ts, tok, ordner=""):
    """Eine Nachricht in alle Sichten einsortieren. Der Fensterschnitt sitzt hier, EINMAL."""
    if ts is None or ts < VON or ts > BIS:
        return False
    modell = modell or "?"
    sitzung = sitzung or "?"
    if not passt(harness, modell, sitzung):
        return False
    _add(gesamt, tok)
    _add(je_harness.setdefault(harness, neu()), tok)
    _add(je_modell.setdefault((harness, modell), neu()), tok)
    s = je_sitzung.setdefault((harness, sitzung), {"werte": neu(), "worker": worker or "",
                                                   "ordner": ordner or "", "modelle": set(),
                                                   "von": ts, "bis": ts})
    _add(s["werte"], tok)
    s["modelle"].add(modell)
    s["von"] = min(s["von"], ts)
    s["bis"] = max(s["bis"], ts)
    if worker and not s["worker"]:
        s["worker"] = worker
    if ordner and not s["ordner"]:
        s["ordner"] = ordner
    _add(je_tag.setdefault((tag(ts), harness, modell), neu()), tok)
    return True


def _tempo(harness, modell):
    return tempo.setdefault((harness, modell), {"gem_tokens": 0.0, "gem_sekunden": 0.0,
                                                "nae_tokens": 0.0, "nae_sekunden": 0.0})


def tempo_gemessen(harness, modell, ausgabe_tokens, sekunden):
    if sekunden <= 0 or ausgabe_tokens <= 0:
        return
    t = _tempo(harness, modell)
    t["gem_tokens"] += ausgabe_tokens
    t["gem_sekunden"] += sekunden


def tempo_naeherung(harness, modell, ausgabe_tokens, sekunden):
    if sekunden <= 0 or sekunden > NAEHERUNG_LUECKE_MAX or ausgabe_tokens <= 0:
        return
    t = _tempo(harness, modell)
    t["nae_tokens"] += ausgabe_tokens
    t["nae_sekunden"] += sekunden


def quelle(harness, pfad, zustand, nachrichten=0, hinweis=""):
    quellen.append({"harness": harness, "pfad": pfad.replace(HOME, "~"), "zustand": zustand,
                    "nachrichten": nachrichten, "hinweis": hinweis})


# --- Quelle 1: claude ------------------------------------------------------------------------
# Dieselben Felder und dieselbe Auswahl wie im Standardbericht oben (message.usage einer
# assistant-Zeile). Der Dateiname IST die Sitzungskennung, der Projektordner traegt den Namen des
