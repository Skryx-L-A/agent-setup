import json, os, sys, time

CACHE = sys.argv[1]
HOME = os.path.expanduser("~")
WURZEL = os.path.join(HOME, ".claude", "projects")
JETZT = time.time()
FENSTER_TAGE = 8
# Etwas mehr als das Fenster: der Bericht schaut hoechstens 7 Tage zurueck, der
# Zwischenspeicher haelt 10 -- so kostet ein Lauf kurz nach Mitternacht keinen kalten Start.
BEHALTEN_S = 10 * 86400


def lade_cache():
    try:
        with open(CACHE) as fh:
            d = json.load(fh)
        if not isinstance(d, dict) or d.get("version") != 1:
            return {}
        dateien = d.get("dateien")
        return dateien if isinstance(dateien, dict) else {}
    except Exception:
        # Kaputt, alt oder nicht da: ein kalter Start ist langsam, nie falsch.
        return {}


def sichere_cache(dateien):
    schnitt = JETZT - BEHALTEN_S
    schlank = {}
    for pfad, e in dateien.items():
        if e.get("mtime", 0) < schnitt:
            continue
        e = dict(e)
        e["s"] = [r for r in e.get("s", []) if r[0] >= schnitt]
        schlank[pfad] = e
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = "%s.%d.tmp" % (CACHE, os.getpid())
        with open(tmp, "w") as fh:
            json.dump({"version": 1, "dateien": schlank}, fh)
        os.replace(tmp, CACHE)
    except Exception:
        # Ein nicht schreibbarer Zwischenspeicher macht den naechsten Lauf langsam, nicht falsch.
        pass


def parse_ts(s):
    """ISO-8601 zu Epoche, ohne datetime -- dieselbe Auswahl wie die jq-Fassung vorher."""
    if not s or len(s) < 19 or s[4] != "-" or s[7] != "-" or s[10] != "T":
        return None
    try:
        jahr, monat, tag = int(s[0:4]), int(s[5:7]), int(s[8:10])
        std, minute, sek = int(s[11:13]), int(s[14:16]), int(s[17:19])
    except ValueError:
        return None
    rest = s[19:]
    versatz = 0
    if rest.startswith("."):
        i = 1
        while i < len(rest) and rest[i].isdigit():
            i += 1
        rest = rest[i:]
    if rest and rest[0] in "+-" and len(rest) >= 6:
        try:
            versatz = (int(rest[1:3]) * 3600 + int(rest[4:6]) * 60) * (-1 if rest[0] == "+" else 1)
        except ValueError:
            return None
    elif rest not in ("", "Z"):
        return None
    # calendar.timegm ohne den Import: die Formel steht in jeder Zeitrechnung so.
    tage = (jahr - 1970) * 365 + (jahr - 1969) // 4 - (jahr - 1901) // 100 + (jahr - 1601) // 400
    monatstage = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
    if not 1 <= monat <= 12:
        return None
    tage += monatstage[monat - 1] + tag - 1
    if monat > 2 and (jahr % 4 == 0 and (jahr % 100 != 0 or jahr % 400 == 0)):
        tage += 1
    return tage * 86400 + std * 3600 + minute * 60 + sek + versatz


def lies_neu(pfad, ab):
    """Ab dem Byte-Versatz weiterlesen. Gibt (Datensaetze, ohne_ts, usage_zeilen, neuer_versatz)."""
    saetze, ohne_ts, usage, versatz = [], 0, 0, ab
    with open(pfad, "rb") as fh:
        fh.seek(ab)
        for roh in fh:
            if not roh.endswith(b"\n"):
                # Angefangene Zeile: der Versatz bleibt davor stehen, beim naechsten Lauf
                # wird sie vollstaendig gelesen.
                break
            versatz += len(roh)
            if b'"usage"' not in roh:
                continue
            try:
                d = json.loads(roh.decode("utf-8", "replace"))
            except Exception:
                continue
            if d.get("type") != "assistant":
                continue
            msg = d.get("message") or {}
            u = msg.get("usage")
            if not u:
                continue
            usage += 1
            ts = parse_ts(d.get("timestamp") or "")
            if ts is None:
                ohne_ts += 1
                continue
            saetze.append([ts,
                           u.get("input_tokens") or 0,
                           u.get("output_tokens") or 0,
                           u.get("cache_creation_input_tokens") or 0,
                           u.get("cache_read_input_tokens") or 0])
    return saetze, ohne_ts, usage, versatz


