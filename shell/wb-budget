    # gemessen 3,4 % der Tokens des laufenden Tages. Der Textbericht oben zaehlt sie seit jeher
    # mit (er sucht per find in jeder Tiefe); dass beide Wege dieselbe Frage verschieden
    # beantworten, war der Fehler. Ein Subagent verbraucht eigene Tokens -- sie stehen in seiner
    # eigenen Datei, nicht in der des Elternteils, und fallen sonst unter den Tisch.
    pfade = sorted(glob.glob(os.path.join(wurzel, "*", "*.jsonl"))
                   + glob.glob(os.path.join(wurzel, "*", "*", "subagents", "*.jsonl")))
