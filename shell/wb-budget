    if isinstance(e, dict) and st.st_size < e.get("offset", 0):
        e = None
    if not isinstance(e, dict):
        e = {"offset": 0, "size": 0, "mtime": 0, "usage": 0, "ohne_ts": 0, "s": []}
    if e["size"] != st.st_size or e["mtime"] != st.st_mtime:
        try:
            neu, ohne, anz, versatz = lies_neu(pfad, e["offset"])
        except OSError:
            continue
        e["s"] = e.get("s", []) + neu
        e["ohne_ts"] = e.get("ohne_ts", 0) + ohne
        e["usage"] = e.get("usage", 0) + anz
        e["offset"] = versatz
        e["size"] = st.st_size
        e["mtime"] = st.st_mtime
    cache[pfad] = e
    saetze.extend(e["s"])
    ohne_ts_gesamt += e.get("ohne_ts", 0)
    usage_gesamt += e.get("usage", 0)

sichere_cache(cache)

if ohne_ts_gesamt > 0:
    sys.stderr.write("Hinweis: %d von %d Nachrichten ohne verwertbaren Zeitstempel uebersprungen "
                     "(nicht in den Zahlen unten).\n" % (ohne_ts_gesamt, usage_gesamt))

# --- Die vier Sichten, aus denselben Datensaetzen wie vorher ---------------------------------
T5 = JETZT - 5 * 3600
T7 = JETZT - 7 * 86400
TAGESBEGINN = JETZT - (JETZT % 86400)


def fenster(ab):
    z = [0, 0, 0, 0, 0]  # Nachrichten, input, output, cache_write, cache_read
    for r in saetze:
        if r[0] < ab:
            continue
        z[0] += 1
        for i in range(1, 5):
            z[i] += r[i]
    return z


def zeile(z):
    return ("  Nachrichten: %d   input: %d   output: %d   cache_write: %d   cache_read: %d  "
            "(cache_read separat, nicht in Trend/Hochrechnung)" % (z[0], z[1], z[2], z[3], z[4]))


print("== letzte 5 Stunden ==")
print(zeile(fenster(T5)))
print()
print("== letzte 7 Tage ==")
print(zeile(fenster(T7)))
print()
print("== Trend, Tokens/Tag (input+output+cache_write, OHNE cache_read, UTC-Tagesgrenzen) ==")
tage = {}
for r in saetze:
    if r[0] < T7:
        continue
    t = time.strftime("%Y-%m-%d", time.gmtime(r[0]))
    w = tage.setdefault(t, [0, 0])
    w[0] += r[1] + r[2] + r[3]
    w[1] += r[4]
for t in sorted(tage):
    print("  %s: %d   (cache_read: %d)" % (t, tage[t][0], tage[t][1]))

print()
heute_total, heute_cache_read = 0, 0
for r in saetze:
    if r[0] < TAGESBEGINN:
        continue
    heute_total += r[1] + r[2] + r[3]
    heute_cache_read += r[4]
stunden = (JETZT % 86400) / 3600
print("== Hochrechnung (heute, UTC) ==")
if stunden < 0.25:
    print("  zu frueh am UTC-Tag (%sh) fuer eine sinnvolle Hochrechnung." % stunden)
else:
    print("  bisher heute: %d Tokens (input+output+cache_write) in %sh ->" % (heute_total, stunden))
    print("  Hochrechnung auf 24h: ~%.0f Tokens" % (heute_total / stunden * 24))
    print("  (lineare Fortschreibung, cache_read AUSGESCHLOSSEN, keine Kenntnis eines Limits;")
    print("   zum Vergleich, nicht mitgezaehlt: %d cache_read heute)" % heute_cache_read)
