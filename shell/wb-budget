#!/bin/bash
# wb-budget — fortlaufendes Bild des Token-/Limit-Verbrauchs: 5h/Woche, Trend, Hochrechnung,
#   Plan-Limit-Stand, und (--limit-kalibrierung) der empirische Umrechnungsfaktor zwischen
#   Limit-Prozentpunkt, Tokens und USD-Aequivalent.
#
# WARUM: "spaet in einer schweren Woche" (Team-Groesse ans Restbudget anpassen) ist bisher
#   Bauchgefuehl, keine Zahl. Dieses Tool macht daraus eine Zahl — aber NUR aus Quellen, die
#   tatsaechlich vorliegen.
#
# DATENLAGE (Stand 2026-08-10, korrigiert):
#   Seit dem 28.07. schreibt ~/.claude/statusline-command.sh die Plan-Limit-Prozente
#   (rate_limits.five_hour/seven_day.used_percentage) bei JEDEM Render selbst persistent mit,
#   nach ~/.claude/workbench/limits.jsonl (eine Zeile je Aenderung; Felder ts, session,
#   five_hour_pct, seven_day_pct, five_hour_resets_at) und ~/.claude/workbench/limits-latest.json
#   (nur der letzte Stand). Das ist die PRIMAERE Quelle fuer den Plan-Limit-Abschnitt unten und
#   fuer --limit-kalibrierung. Frueher stand hier, diese Werte seien nur transient und ohne
#   Aenderung an statusline-command.sh nicht zu bekommen — das stimmte bis zum 28.07., seither
#   nicht mehr; dieses Skript suchte bis zum 10.08. am falschen Ort (s.u.) und meldete deshalb
#   faelschlich "nicht verfuegbar".
#
#   Der alte --ingest-Pfad (~/.local/state/wb-budget/limits.jsonl) bleibt als ZWEITE, manuelle
#   Quelle bestehen (Felder ts, five_hour_pct, seven_day_pct, resets_at) — er wird nur befuellt,
#   wenn 'wb-budget --ingest' explizit mit einer Statusline-JSON auf stdin aufgerufen wird. Liegen
#   beide Logs vor, gewinnt die juengere Zeile (Vergleich ueber ts).
#
#   Was daneben lokal und persistent vorliegt: die Session-Transkripte unter
#   ~/.claude/projects/**/*.jsonl. Jede assistant-Nachricht traegt echte Token-Zahlen
#   (message.usage: input_tokens/output_tokens/cache_creation_input_tokens/
#   cache_read_input_tokens) mit Zeitstempel und Modellnamen. Darauf baut der Haupt-Report
#   (5h/Woche/Trend/Hochrechnung, Rohzahlen ohne Dollarbetrag) ebenso auf wie
#   --limit-kalibrierung und --limit-gewichte (die den Dollarbetrag ueber die Preistabelle
#   unten dazurechnen).
#
# PLANHISTORIE (Stand 2026-08-10, Anweisung des Nutzers):
#   Ein Limit-Prozentpunkt bedeutet unter einem Pro-Abo etwas anderes als unter Max 100 oder
#   Max 200 -- die Toepfe sind verschieden gross. --limit-kalibrierung und --limit-gewichte
#   lesen deshalb ~/.claude/workbench/plan-historie.json -- vom Nutzer gepflegt, NICHT von
#   diesem Skript angelegt oder ueberschrieben -- und bilden NIE einen Abschnitt ueber eine
#   Plangrenze hinweg; jede Ausgabe nennt den Plan. Format: {"plaene": [{"plan": "...",
#   "von": "...", "bis": "...|null"}, ...]}, weitere Schluessel je Eintrag (label/quelle/
#   genauigkeit) sind erlaubt und werden ignoriert. Fehlt die Datei, rechnen beide trotzdem,
#   aber mit einer expliziten Warnung, dass die Zahlen nur gelten, solange im Zeitraum kein
#   Wechsel stattfand. Vorlage (nur fuer eine neue Maschine, ersetzt NICHT die gepflegte
#   Datei): shell/plan-historie.default.json.
#
#   Aktueller Stand laut dieser Datei: Plan "max-200", belegt (nicht nur angenommen) durchgehend
#   seit Montag der Vorwoche vor dem 2026-08-03 und weiterhin laufend -- das Wochenfenster vom
#   03.08. 14:00 bis 10.08. 14:00 liegt damit VOLLSTAENDIG in einem Plan.
#
#   Das Wochenlimit resettet nachweislich jeden Montag 14:00 Ortszeit (Europe/Berlin, DST-
#   bewusst je nach Jahreszeit) -- eine bekannte, feste Kante, keine geratene. --limit-
#   kalibrierung und --limit-gewichte trennen 7-Tage-Abschnitte deshalb zusaetzlich an dieser
#   Kante statt sich allein auf den (durch gleichzeitige Sessions verrauschten) Ruecksprung im
#   Prozentwert zu verlassen; seit Kurzem loggt statusline-command.sh zur Gegenprobe auch
#   seven_day_resets_at mit.
#
# EXTERNE ANKER (Stand 2026-08-10): ~/.claude/workbench/limit-anker.json traegt von Hand
#   nachgerechnete Abschnitte, die limits.jsonl nicht selbst hergibt -- z.B. ein Wochenfenster
#   von VOR dessen Beginn. --limit-gewichte nimmt jeden Anker als zusaetzliche Gleichung auf,
#   sofern plan-historie.json seinen ganzen Zeitraum als EINEN Plan bestaetigt; sonst wird er
#   mit Begruendung uebersprungen. Ein Anker traegt nur ein USD-Aequivalent je Modell, keine
#   Tokenaufschluesselung -- er zaehlt deshalb nur fuer die USD-Basis, nie fuer die Token-Basen.
#   Vorlage: shell/limit-anker.default.json.
#
# BENUTZUNG:
#   wb-budget                            Token-Report (5h/7d/Trend/Hochrechnung) + Plan-Limit-Stand
#   wb-budget --ingest                   liest EINE Statusline-JSON von stdin, loggt rate_limits
#                                          falls vorhanden (Aufruf z.B.:
#                                          <statusline-json erzeugen> | wb-budget --ingest)
#   wb-budget --limit-kalibrierung [--tage N]
#                                         wie viele Tokens/USD stecken in einem Limit-Prozentpunkt —
#                                          empirisch aus limits.jsonl + Transkripten der letzten
#                                          N Tage (Default 14), nie aus einer festen Zahl im Code.
#   wb-budget --limit-gewichte [--tage N]
#                                         wie viele Limit-Punkte kostet ein Modell fuer sich
#                                          genommen -- ein Gewicht je Modell statt eines
#                                          Faktors fuer alle, gegen dieselben Abschnitte gelost.
#   wb-budget --json [--tage N | --von ISO --bis ISO] [--harness a,b] [--modell x,y] [--sitzung id]
#                                         der maschinenlesbare Bericht ueber ALLE belegten Quellen,
#                                          nicht nur Claude -- Grundlage der Verbrauchsseite.
#                                          Siehe MEHR ALS CLAUDE weiter unten.
#
# MEHR ALS CLAUDE (Stand 2026-08-11, Messung ~/.pi-workers/results/verbrauchdaten/):
#   Der Standardbericht oben liest ausschliesslich ~/.claude/projects/**/*.jsonl und ist damit
#   strukturell nur Claude. `--json` liest daneben die sechs weiteren Quellen, die auf dieser
#   Maschine nachweislich echte Token je Nachricht mit Sitzungs- und Modellzuordnung fuehren:
#     codex          ~/.codex/sessions/**/rollout-*.jsonl, Ereignis `token_count`
#     pi             ~/.pi-workers/sessions/**/*.jsonl, message.usage
#     opencode       ~/.local/share/opencode/opencode.db, Tabelle message, Spalte data (JSON)
#     copilot        ~/.copilot/session-store.db, Tabelle assistant_usage_events
#     copilot-cloud  dieselbe Datenbank -- die beiden sind NUR am Modellfeld zu unterscheiden
#     openhands      ~/.openhands/conversations/<id>/base_state.json, stats.usage_to_metrics.agent
#   Elf weitere Harnesses aus shell/models.default.json haben auf dieser Maschine keine oder keine
#   lesbare Spur. Sie fallen NICHT still weg: `--json` fuehrt jeden von ihnen unter "luecken" mit
#   dem gemessenen Grund, damit eine Anzeige die Luecke zeigen kann statt zu schweigen.
#
#   ZWEI GROESSEN, NIE EINE ZAHL. Ein API-Dollarpreis gilt nur, wo ein Anbieter pro Token
#   abrechnet; die vier Abo-Harnesses zahlen stattdessen einen Kontingentanteil (Anthropic in
#   Prozent des Zeitfensters, Copilot in AIC). `--json` weist deshalb je Modell ein `preis`-Objekt
#   mit einem `art`-Feld aus -- "abo-aequivalent" (hypothetisch, NIE abgebucht), "katalogpreis"
#   (Listenpreis eines Cloud-Anbieters), "harness-angabe" (der Harness hat selbst gerechnet) oder
#   "kein-preis" -- und traegt den Kontingentstand getrennt daneben (aus `wb-kontingent`).
#
#   TOKEN JE SEKUNDE IST NICHT UEBERALL DASSELBE. Nur copilot/copilot-cloud tragen mit
#   `inter_token_latency_ms` eine echte Generierungsrate. Ueberall sonst bleibt nur eine
#   Wanduhr-Naeherung aus Zeitstempeln, die Denkzeit und Werkzeugpausen mitmisst (gemessen: zwei
#   Nachrichten 0,662 s auseinander, zwei andere 9,256 s). Jede Rate traegt deshalb ein `art`-Feld
#   ("gemessen" / "naeherung") und ihren Grund -- eine Zahl ohne diese Angabe waere eine Luege.

set -u

JQ=$(command -v jq || echo /opt/homebrew/bin/jq)
STATE_DIR="$HOME/.local/state/wb-budget"
LIMITS_LOG="$STATE_DIR/limits.jsonl"                       # alter --ingest-Pfad, manuell befuellt
WORKBENCH_DIR="$HOME/.claude/workbench"
WORKBENCH_LIMITS="$WORKBENCH_DIR/limits.jsonl"              # Betriebslog, seit 28.07. von statusline-command.sh
mkdir -p "$STATE_DIR"

if [ ! -x "$JQ" ] && ! command -v jq >/dev/null 2>&1; then
  # Exit 0 waere hier eine Erfolgsmeldung an jeden Aufrufer, der den Rueckgabewert
  # prueft -- ein Fehlschlag, der aus dieser Zeile herauskommt, ist keiner (bugjagd
  # shell/hoch, 2026-08-15/17: mit '--ingest' verschluckt genau das den kompletten
  # Datenpunkt, ohne dass ein automatischer Aufrufer es je erfaehrt).
  echo "wb-budget: jq nicht gefunden — Report nicht moeglich." >&2
  exit 1
fi

# --- --ingest: eine Statusline-JSON von stdin entgegennehmen, rate_limits loggen. ---
if [ "${1:-}" = "--ingest" ]; then
  input=$(cat)
  has_limits=$(echo "$input" | "$JQ" -r 'if .rate_limits then "yes" else "no" end' 2>/dev/null)
  if [ "$has_limits" != "yes" ]; then
    echo "wb-budget: kein .rate_limits im Input gefunden — nichts geloggt."
    exit 1
  fi
  echo "$input" | "$JQ" -c '{
    ts: (now | todate),
    five_hour_pct: .rate_limits.five_hour.used_percentage,
    seven_day_pct: .rate_limits.seven_day.used_percentage,
    resets_at: .rate_limits.five_hour.resets_at
  }' >> "$LIMITS_LOG"
  # $has_limits=="yes" nur heisst ".rate_limits ist wahr", nicht "ist ein Objekt" -- ein
  # .rate_limits, das (durch einen kaputten Statusline-Aufrufer) ein STRING oder eine ZAHL ist,
  # kommt trotzdem hier an. Die Extraktion oben bricht dann mit einem jq-Laufzeitfehler ("Cannot
  # index string with...") ab, schreibt NICHTS in den Log, und ohne diese Pruefung lief das
  # Skript unbeirrt weiter zur Erfolgsmeldung (2026-08-16, bugjagd shell/mittel, wb-budget:
  # reproduziert mit '{"rate_limits":"oops"}' auf stdin: 0 Byte geloggt, Meldung trotzdem
  # "Datenpunkt geloggt", Exit 0). PIPESTATUS[1] ist jq's eigener Exit-Code aus der Pipe direkt
  # darueber -- `set -o pipefail` global zu setzen waere in einer 2000-Zeilen-Datei mit vielen
  # anderen Pipes ein zu breiter Eingriff fuer diesen einen Fall.
  JQ_RC=${PIPESTATUS[1]}
  if [ "$JQ_RC" -ne 0 ]; then
    echo "wb-budget: --ingest: jq-Fehler beim Erzeugen der Logzeile (rc=$JQ_RC) — NICHT geloggt." >&2
    exit 1
  fi
  echo "wb-budget: Datenpunkt geloggt nach $LIMITS_LOG"
  exit 0
fi

# --- --limit-kalibrierung [--tage N]: Tokens/USD je Limit-Prozentpunkt, empirisch. -----------
#
# Preistabelle fuer das API-Aequivalent, USD je Million Tokens (Ein-/Ausgabe). Stand 2026-08-10,
# EINZIGER Ort im Skript, an dem Preise stehen — nie verstreut. cache_write zaehlt mit 1,25x dem
# Eingabepreis, cache_read mit 0,1x dem Eingabepreis (unten in der Kalibrierung selbst gerechnet,
# nicht hier). Ein Modellname, der hier fehlt, wird trotzdem gezaehlt und im Bericht als
# "ohne Preis" ausgewiesen — nie stillschweigend mit 0 USD bewertet.
#   claude-opus-5              5 / 25
#   claude-opus-4-8            5 / 25
#   claude-sonnet-5            3 / 15
#   claude-haiku-4-5-20251001  1 / 5
#   claude-fable-5             10 / 50
#
# Verfahren: aus limits.jsonl je Fenster (five_hour_pct, seven_day_pct) monotone Abschnitte
# bilden — ein Ruecksprung des Prozentwerts beendet einen Abschnitt (Reset), ueber einen Reset
# hinweg wird nie gerechnet. Ein Abschnitt unter 3 Prozentpunkten Anstieg wird verworfen (die
# Ganzzahl-Aufloesung der geloggten Prozente waere sonst groesser als das Signal). Fuer jeden
# ueberlebenden Abschnitt wird der Verbrauch aus den Transkripten im selben Zeitfenster summiert,
# je Modell getrennt, daraus Tokens/Punkt (mit und ohne cache_read), USD/Punkt und der Modellmix.
# Die Unsicherheit aus der Ganzzahl-Aufloesung (jede geloggte Prozentzahl ist per statusline-
# command.sh abgeschnitten, nicht gerundet — der wahre Wert liegt im Intervall [x, x+1)) wird als
# ±(100/Punkte)% mitgegeben, nicht als Zahl mit vier Nachkommastellen vorgetaeuscht.
if [ "${1:-}" = "--limit-kalibrierung" ]; then
  shift
  TAGE=14
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --tage)
        TAGE="${2:?wb-budget --limit-kalibrierung --tage <N>: Zahl fehlt}"
        shift 2
        ;;
      *)
        echo "wb-budget --limit-kalibrierung: unbekannte Option '$1'" >&2
        exit 1
        ;;
    esac
  done
  case "$TAGE" in
    ''|*[!0-9]*)
      echo "wb-budget --limit-kalibrierung: --tage braucht eine positive Ganzzahl, nicht '$TAGE'" >&2
      exit 1
      ;;
  esac

  echo "wb-budget --limit-kalibrierung — Tokens/USD je Limit-Prozentpunkt (letzte ${TAGE}d, Quelle: $WORKBENCH_LIMITS)"
  echo

  if [ ! -s "$WORKBENCH_LIMITS" ]; then
    echo "nicht verfuegbar — kein Log unter $WORKBENCH_LIMITS. Ohne diesen Betriebslog (seit"
    echo "28.07. von statusline-command.sh geschrieben) gibt es keine Grundlage fuer eine"
    echo "Kalibrierung."
    exit 0
  fi

  /usr/bin/python3 - "$WORKBENCH_LIMITS" "$TAGE" "$HOME/.claude/projects" <<'PY'
import glob, json, os, sys
from datetime import datetime, timezone, timedelta
from zoneinfo import ZoneInfo

LIMITS_PATH, TAGE, PROJECTS_DIR = sys.argv[1], int(sys.argv[2]), sys.argv[3]

# Preistabelle s. Kopfkommentar oben im Skript — hier nur die ausfuehrbare Form derselben Zahlen.
PRICES = {
    "claude-opus-5":             (5, 25),
    "claude-opus-4-8":           (5, 25),
    "claude-sonnet-5":           (3, 15),
    "claude-haiku-4-5-20251001": (1, 5),
    "claude-fable-5":            (10, 50),
}
CACHE_WRITE_FAKTOR = 1.25
CACHE_READ_FAKTOR = 0.1
PLAN_HISTORIE_PATH = os.path.expanduser("~/.claude/workbench/plan-historie.json")
BERLIN = ZoneInfo("Europe/Berlin")

FIELDS = [("five_hour_pct", "5-Stunden-Fenster"), ("seven_day_pct", "7-Tage-Fenster")]


def parse_ts(s):
    s = s.rstrip("Z")
    if "." in s:
        s = s.split(".")[0]
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).timestamp()


def parse_ts_offset(s):
    # Fuer die Planhistorie: dort steht der Zeitstempel mit EXPLIZITEM Offset ("+02:00"), nicht
    # nur als "Z" wie in limits.jsonl/den Transkripten -- Python 3.9 (dieses System) kennt
    # fromisoformat("...Z") noch nicht, "...+00:00" aber schon, daher die Ersetzung.
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    return datetime.fromisoformat(s).astimezone(timezone.utc).timestamp()


def load_plan_historie():
    # None = Datei fehlt/kaputt (loest die Warnung unten aus) -- ausdruecklich unterschieden
    # von einer leeren, aber vorhandenen Historie. Format: ~/.claude/workbench/plan-historie.json
    # ist Datei des Nutzers, von Hand gepflegt (shell/plan-historie.default.json dokumentiert
    # dasselbe Format) -- {"plaene": [{"plan": "...", "von": "...", "bis": "...|null"}, ...]},
    # weitere Schluessel je Eintrag (label/quelle/genauigkeit) sind erlaubt und werden ignoriert.
    if not os.path.exists(PLAN_HISTORIE_PATH):
        return None
    try:
        raw = json.load(open(PLAN_HISTORIE_PATH))
        if isinstance(raw, dict):
            raw = raw.get("plaene", [])
    except Exception:
        return None
    out = []
    for e in raw:
        try:
            out.append({
                "von": parse_ts_offset(e["von"]),
                "bis": parse_ts_offset(e["bis"]) if e.get("bis") else None,
                "plan": e.get("plan") or "?",
            })
        except Exception:
            continue
    out.sort(key=lambda e: e["von"])
    return out


def plan_at(epoch, historie):
    if not historie:
        return "unbekannt (keine Planhistorie-Datei)"
    for e in historie:
        if epoch >= e["von"] and (e["bis"] is None or epoch < e["bis"]):
            return e["plan"]
    return "unbekannt (ausserhalb der Planhistorie)"


def montags_1400_berlin(start_epoch, end_epoch):
    # Das Wochenlimit resettet nachweislich jeden Montag 14:00 Ortszeit (Europe/Berlin,
    # DST-bewusst) -- eine bekannte, feste Kante (Angabe des Nutzers, 2026-08-10), keine aus
    # dem verrauschten Log geratene.
    d = datetime.fromtimestamp(start_epoch, BERLIN)
    d = (d - timedelta(days=d.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
    out = []
    while True:
        kante = d.replace(hour=14, minute=0, second=0, microsecond=0).timestamp()
        if kante > end_epoch + 86400:
            break
        if kante >= start_epoch - 7 * 86400:
            out.append(kante)
        d += timedelta(days=7)
    return sorted(set(out))


PLAN_HISTORIE = load_plan_historie()

rows = []
with open(LIMITS_PATH) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
            d["_epoch"] = parse_ts(d["ts"])
        except Exception:
            continue
        rows.append(d)

cutoff = datetime.now(timezone.utc).timestamp() - TAGE * 86400
rows = [r for r in rows if r["_epoch"] >= cutoff]
rows.sort(key=lambda r: r["_epoch"])

if PLAN_HISTORIE is None:
    print(f"WARNUNG: keine Planhistorie unter {PLAN_HISTORIE_PATH}. Die Zahlen unten gelten")
    print("nur, solange im jeweiligen Zeitraum kein Tarifwechsel (Pro/Max 100/Max 200/...)")
    print("stattfand -- ungeprueft, weil die Datei fehlt.")
    print()

if not rows:
    print(f"keine verwertbaren Zeilen in den letzten {TAGE} Tagen in {LIMITS_PATH}.")
    sys.exit(0)

WEEKLY_KANTEN = montags_1400_berlin(rows[0]["_epoch"], datetime.now(timezone.utc).timestamp())


def segments(field):
    # Monotone Abschnitte je Fenster: ein Ruecksprung beendet den Abschnitt und eroeffnet den
    # naechsten, ueber ihn hinweg wird nie gerechnet. Verglichen wird gegen den bisherigen
    # SPITZENWERT des Abschnitts, nicht gegen die letzte einzelne Zeile: limits.jsonl wird von
    # allen gleichzeitig laufenden Sessions gemeinsam beschrieben, und einzelne Zeilen zeigen
    # dadurch haeufig ein Rauschen von ein paar Punkten nach unten und sofort wieder zurueck
    # (gemessen am 09./10.08.2026: solche Ausreisser fallen nie unter ~80% des bisherigen
    # Spitzenwerts). Erst ein Rueckfall auf UNTER DIE HAELFTE des Spitzenwerts zaehlt als
    # echter Reset (ein echter Reset faellt auf nahe 0) -- alles dazwischen ist Rauschen und
    # wird ignoriert, ohne den Abschnitt zu beenden oder den Spitzenwert zu veraendern.
    #
    # Zwei WEITERE Kanten beenden einen Abschnitt genauso wie ein Ruecksprung: ein Wechsel des
    # Abo-Plans (verschiedene Toepfe, ein Prozentpunkt bedeutet je Plan etwas anderes) und, nur
    # fuer das 7-Tage-Fenster, jede ueberschrittene Montag-14:00-Berlin-Kante (die bekannte
    # Reset-Kante, robuster als der verrauschte Ruecksprung im 7-Tage-Prozentwert selbst).
    segs, start, peak = [], None, None
    for r in rows:
        v = r.get(field)
        if v is None:
            continue
        if start is None:
            start = peak = r
            continue
        plan_wechsel = plan_at(r["_epoch"], PLAN_HISTORIE) != plan_at(peak["_epoch"], PLAN_HISTORIE)
        montag_ueberschritten = field == "seven_day_pct" and any(
            peak["_epoch"] < k <= r["_epoch"] for k in WEEKLY_KANTEN
        )
        if plan_wechsel or montag_ueberschritten:
            segs.append((start, peak))
            start = peak = r
            continue
        if v >= peak[field]:
            peak = r
        elif v < peak[field] / 2:
            segs.append((start, peak))
            start = peak = r
    if start is not None:
        segs.append((start, peak))
    return [(s, l) for (s, l) in segs if (l[field] - s[field]) >= 3]


def load_usage(start_epoch, end_epoch):
    usage = {}
    for path in glob.glob(os.path.join(PROJECTS_DIR, "*", "*.jsonl")):
        try:
            if os.path.getmtime(path) < start_epoch:
                continue  # Datei zuletzt vor dem Fenster geschrieben -- kann nichts beitragen
        except OSError:
            continue
        try:
            with open(path, errors="ignore") as f:
                for line in f:
                    if '"usage"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if d.get("type") != "assistant":
                        continue
                    msg = d.get("message") or {}
                    u = msg.get("usage")
                    ts = d.get("timestamp")
                    if not u or not ts:
                        continue
                    try:
                        te = parse_ts(ts)
                    except Exception:
                        continue
                    if te < start_epoch or te > end_epoch:
                        continue
                    model = msg.get("model") or "?"
                    m = usage.setdefault(model, {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0})
                    m["input"] += u.get("input_tokens") or 0
                    m["output"] += u.get("output_tokens") or 0
                    m["cache_write"] += u.get("cache_creation_input_tokens") or 0
                    m["cache_read"] += u.get("cache_read_input_tokens") or 0
        except OSError:
            continue
    return usage


def usd(model, t):
    if model not in PRICES:
        return None
    pin, pout = PRICES[model]
    return (t["input"] / 1e6 * pin + t["output"] / 1e6 * pout
            + t["cache_write"] / 1e6 * pin * CACHE_WRITE_FAKTOR
            + t["cache_read"] / 1e6 * pin * CACHE_READ_FAKTOR)


any_segment = False
for field, label in FIELDS:
    for (s, l) in segments(field):
        any_segment = True
        delta = l[field] - s[field]
        start_e, end_e = s["_epoch"], l["_epoch"]
        usage = load_usage(start_e, end_e)
        total_mit_cache = sum(sum(t.values()) for t in usage.values())
