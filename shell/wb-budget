# --- Plan-Limit-Prozente: Betriebslog (primaer) vs. --ingest-Log (manuell) -- juengere gewinnt. --
echo
echo "== Plan-Limit (% vom Anthropic-Limit) =="
WB_LAST=""
ING_LAST=""
[ -s "$WORKBENCH_LIMITS" ] && WB_LAST=$("$JQ" -c -s '.[-1]' < "$WORKBENCH_LIMITS" 2>/dev/null)
[ -s "$LIMITS_LOG" ] && ING_LAST=$("$JQ" -c -s '.[-1]' < "$LIMITS_LOG" 2>/dev/null)

if [ -n "$WB_LAST" ] || [ -n "$ING_LAST" ]; then
  WB_TS=""; ING_TS=""
  [ -n "$WB_LAST" ] && WB_TS=$(echo "$WB_LAST" | "$JQ" -r '.ts // empty')
  [ -n "$ING_LAST" ] && ING_TS=$(echo "$ING_LAST" | "$JQ" -r '.ts // empty')

  # ts steht in beiden Logs als ISO-8601-UTC ("...Z") -- dafuer ist lexikografischer Vergleich
  # gleichbedeutend mit chronologischem Vergleich, kein Datumsparsing noetig.
  if [ -n "$WB_TS" ] && { [ -z "$ING_TS" ] || [[ "$WB_TS" > "$ING_TS" ]]; }; then
    CHOSEN="$WB_LAST"; QUELLE="Betriebslog ($WORKBENCH_LIMITS)"
    COUNT=$("$JQ" -s 'length' < "$WORKBENCH_LIMITS")
    RESET_FIELD="five_hour_resets_at"
  else
    CHOSEN="$ING_LAST"; QUELLE="manueller Ingest ($LIMITS_LOG)"
    COUNT=$("$JQ" -s 'length' < "$LIMITS_LOG")
    RESET_FIELD="resets_at"
  fi

  RESET_EPOCH=$(echo "$CHOSEN" | "$JQ" -r --arg f "$RESET_FIELD" '.[$f] // empty')
  RESET_HUMAN="unbekannt"
  [ -n "$RESET_EPOCH" ] && RESET_HUMAN=$(date -r "$RESET_EPOCH" '+%Y-%m-%d %H:%M %Z' 2>/dev/null || echo "$RESET_EPOCH")

  echo "  $COUNT geloggte Datenpunkt(e), Quelle: $QUELLE. Letzter:"
  echo "$CHOSEN" | "$JQ" -r --arg reset "$RESET_HUMAN" \
    '"    Stand \(.ts): 5h=\(.five_hour_pct)%  7d=\(.seven_day_pct)%  Reset=\($reset)"'
  echo "  Umrechnung Prozentpunkt -> Tokens/USD: 'wb-budget --limit-kalibrierung'"
else
  echo "  nicht verfuegbar — kein Log vorhanden. Weder $WORKBENCH_LIMITS (Betriebslog, seit 28.07."
