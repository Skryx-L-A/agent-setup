    print("  Lebenszeichen: %s" % (("%s %s" % (lz.get("zeit"), lz.get("ergebnis"))) if lz else "noch keins"))
    if daten["pausenschalter"]:
        teile = ["pausiert"]
        if daten.get("pausenschalter_seit"):
            teile.append("seit %s" % daten["pausenschalter_seit"])
        if daten.get("pausenschalter_grund"):
            teile.append("(%s)" % daten["pausenschalter_grund"])
        print("  Agent-Verkehr: %s" % " ".join(teile))
    else:
        print("  Agent-Verkehr: offen")
    for name, st in (daten.get("maschinen_status") or {}).items():
        print("  %s: %s" % (name, st.get("fehler") or ("läuft" if st.get("laeuft") else "läuft nicht")))
    return 0


# ------------------------------------------------ start / stop / nachsehen --
_STOP = {"jetzt": False}


def _beim_signal(_nr, _rahmen):
    _STOP["jetzt"] = True


def pid_sperre(ctx):
    f = open(os.path.join(ctx["vorrat"], ".traeger.lock"), "a")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def sperre_nehmen(ctx):
    """PID-Datei anlegen oder eine verwaiste übernehmen, beides unter flock
    auf .traeger.lock: zwei Starter, die gleichzeitig eine tote PID sehen,
    können sich so nicht gegenseitig die frische Datei löschen."""
    with pid_sperre(ctx):
        alt = pid_holen(ctx)
        if alt and alt != os.getpid() and pid_lebt(alt):
            return False
        atomar_schreiben.schreiben(ctx["pid_datei"], "%d\n" % os.getpid(), modus=0o644)
        return True


def sperre_abgeben(ctx):
    with pid_sperre(ctx):
        if pid_holen(ctx) == os.getpid():
            os.unlink(ctx["pid_datei"])


def schleife(ctx):
    """Der laufende Träger. Endet, wenn nichts mehr ohne den Nutzer
    weiterkommt, auf stop und auf SIGTERM; räumt PID-Datei und caffeinate.
    Nach dem Abgeben der PID-Datei prüft er einmal neu: ein Anstoß, der in
    dieser Lücke „läuft schon" hörte, geht so nicht verloren."""
    if not sperre_nehmen(ctx):
        print("wb-traeger: ein Träger läuft schon (PID %s), nichts getan." % pid_holen(ctx))
        return 0
    signal.signal(signal.SIGTERM, _beim_signal)
    signal.signal(signal.SIGINT, _beim_signal)
    ctx["start_zeit"] = jetzt_iso()
    wach = None
    if sys.platform == "darwin" and shutil.which("caffeinate"):
        wach = subprocess.Popen(["caffeinate", "-i", "-w", str(os.getpid())], stdin=subprocess.DEVNULL)
    try:
        while True:
            while not _STOP["jetzt"]:
                takt_ausfuehren(ctx)
                if not vorrat_lebendig(ctx, alle_aufgaben(ctx)):
                    protokoll(ctx, "Vorrat ohne Arbeit, die ohne den Nutzer weiterkommt: Ende")
                    break
                ende = time.time() + ctx["takt_s"]
                while not _STOP["jetzt"] and time.time() < ende:
                    time.sleep(0.2)
            sperre_abgeben(ctx)
            if _STOP["jetzt"] or not vorrat_lebendig(ctx, alle_aufgaben(ctx)) or not sperre_nehmen(ctx):
                break
    finally:
        if wach is not None:
            wach.terminate()
            try:
                wach.wait(5)
            except subprocess.TimeoutExpired:
                wach.kill()
                wach.wait(5)
        sperre_abgeben(ctx)
    return 0


def abloesen(ctx):
    """start ohne --vordergrund: der Träger löst sich über wb-nohup ab, damit
    er einen nachweisbaren Eigentümer hat; lehnt wb-nohup ab (kein Pane, kein
    launchd-Job, keine Werkbank), ein eigener abgelöster Prozess."""
    befehl = [sys.executable, SKRIPT, "start", "--vordergrund", "--base", ctx["base"], "--vorrat", ctx["vorrat"]]
    log = os.path.join(os.path.expanduser("~"), ".local", "state", "wb-traeger.log")
    os.makedirs(os.path.dirname(log), exist_ok=True)
    if shutil.which("wb-nohup"):
        rc, aus, fehl = laufe(["wb-nohup", "traeger", "--worker", "traeger", "--log", log, "--"] + befehl, 30)
        if rc == 0:
            print("wb-traeger: gestartet über wb-nohup (PID %s)." % (aus.strip().splitlines() or ["?"])[-1])
            return 0
        sys.stderr.write("wb-traeger: wb-nohup lehnte ab (rc=%s): %s — starte ohne Eintrag.\n"
                         % (rc, fehl.strip()[:200]))
    with open(log, "ab") as logdatei:
        p = subprocess.Popen(befehl, stdout=logdatei, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, start_new_session=True)
    print("wb-traeger: abgelöst gestartet (PID %s)." % p.pid)
    return 0


def cmd_start(args, ctx=None):
    ctx = ctx or kontext_bauen(args)
    laufend = pid_holen(ctx)
    if laufend and laufend != os.getpid() and pid_lebt(laufend):
        print("wb-traeger: ein Träger läuft schon (PID %s), nichts getan." % laufend)
        return 0
    return schleife(ctx) if args.vordergrund else abloesen(ctx)


def cmd_stop(args):
    ctx = kontext_bauen(args)
    pid = pid_holen(ctx)
    if pid is None:
        print("wb-traeger: es läuft kein Träger (keine PID-Datei).")
        return 0
    if not pid_lebt(pid):
        with pid_sperre(ctx):
            if pid_holen(ctx) == pid:
                os.unlink(ctx["pid_datei"])
        print("wb-traeger: PID %s lebte nicht mehr, verwaiste PID-Datei geräumt." % pid)
        return 0
    os.kill(pid, signal.SIGTERM)
    ende = time.time() + 15
    while time.time() < ende and pid_lebt(pid):
        time.sleep(0.2)
    if pid_lebt(pid):
        sys.stderr.write("wb-traeger: PID %s lebt 15 s nach SIGTERM noch; nichts weiter getan.\n" % pid)
        return 1
    with pid_sperre(ctx):
        if pid_holen(ctx) == pid:
            os.unlink(ctx["pid_datei"])
    print("wb-traeger: Träger (PID %s) beendet, PID-Datei geräumt." % pid)
    return 0


def cmd_takt(args):
    takt_ausfuehren(kontext_bauen(args))
    return 0


def cmd_nachsehen(args):
    ctx = kontext_bauen(args)
    ctx["anmeldestart"] = True
    laufend = pid_holen(ctx)
    if laufend and pid_lebt(laufend):
        print("wb-traeger: ein Träger läuft schon (PID %s), nichts getan." % laufend)
        return 0
    takt_ausfuehren(ctx)
    if not vorrat_lebendig(ctx, alle_aufgaben(ctx)):
        print("wb-traeger: der Vorrat enthält nichts, das ohne den Nutzer weiterkommt. Ende.")
        return 0
    return cmd_start(args, ctx)


def main():
    gemeinsam = argparse.ArgumentParser(add_help=False)
    gemeinsam.add_argument("--base", default=os.path.expanduser("~"))
    gemeinsam.add_argument("--vorrat", default=None)
    ap = argparse.ArgumentParser(prog="wb-traeger")
    sub = ap.add_subparsers(dest="befehl", required=True)
    for name, func in (("start", cmd_start), ("nachsehen", cmd_nachsehen)):
        p = sub.add_parser(name, parents=[gemeinsam])
        p.add_argument("--vordergrund", action="store_true")
        p.set_defaults(func=func)
    p = sub.add_parser("status", parents=[gemeinsam])
    p.add_argument("--json", action="store_true")
    p.add_argument("--alle-maschinen", action="store_true")
    p.set_defaults(func=cmd_status)
    for name, func in (("stop", cmd_stop), ("takt", cmd_takt)):
        sub.add_parser(name, parents=[gemeinsam]).set_defaults(func=func)
    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
