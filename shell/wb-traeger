# ------------------------------------------------------------ Hilfsmittel --
def laufe(befehl, frist_s=60, env=None):
    """(rc, stdout, stderr); Timeout zählt als rc 124, fehlendes Programm als 127."""
    try:
        r = subprocess.run(befehl, capture_output=True, text=True, timeout=frist_s, env=env)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "Frist %ss überschritten" % frist_s
    except OSError as e:
        return 127, "", str(e)


def tmux(*argumente):
    sock = os.environ.get("WB_TMUX_SOCKET")
    return ["tmux"] + (["-L", sock] if sock else []) + list(argumente)


def pid_lebt(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def pane_info(pane):
    """{'pid', 'dead', 'tty'} des Panes oder None, wenn tmux ihn nicht kennt."""
    if not pane:
        return None
    rc, aus, _ = laufe(tmux("list-panes", "-a", "-F", "#{pane_id}|#{pane_pid}|#{pane_dead}|#{pane_tty}"), 10)
    if rc != 0:
        return None
    for zeile in aus.splitlines():
        teile = zeile.strip().split("|")
        if len(teile) == 4 and teile[0] == pane:
            return {"pid": int(teile[1]) if teile[1].isdigit() else None,
                    "dead": teile[2] != "0", "tty": teile[3]}
    return None


def pane_lebt(pane):
    info = pane_info(pane)
    return bool(info and not info["dead"] and info["pid"] and pid_lebt(info["pid"]))


def wb_aufgabe_programm():
    """Die Fassung neben diesem Skript zuerst, dann der PATH: beide werden
    zusammen ausgerollt, und bis dahin liegt wb-aufgabe nirgends im PATH."""
    nachbar = os.path.join(SKRIPT_DIR, "wb-aufgabe")
    if os.access(nachbar, os.X_OK):
        return nachbar
    return shutil.which("wb-aufgabe") or "wb-aufgabe"


_WA = {}


def wa():
    """wb-aufgabe als Modul: die gemeinsamen Prüfungen stehen nur dort."""
    if "modul" not in _WA:
        pfad = wb_aufgabe_programm()
        if not os.path.isabs(pfad):
            raise RuntimeError("wb-aufgabe nicht gefunden (weder neben wb-traeger noch im PATH)")
        lader = importlib.machinery.SourceFileLoader("wb_aufgabe_modul", pfad)
        spec = importlib.util.spec_from_loader(lader.name, lader)
        modul = importlib.util.module_from_spec(spec)
        lader.exec_module(modul)
        _WA["modul"] = modul
    return _WA["modul"]


# Stand (deutsch, wie in wb-aufgabe.STAENDE) -> task_state (snake_case), das
# neue additive Feld aus dem Companion-Auftrag (Anhang „Companion-Socket").
COMPANION_TASK_STATE = {
    "offen": "offen",
    "läuft": "laeuft",
    "steckt": "steckt",
    "pausiert (Kontingent)": "pausiert_kontingent",
    "pausiert (Nacht)": "pausiert_nacht",
    "pausiert (Weckzeit)": "pausiert_weckzeit",
    "wartet auf den Nutzer": "wartet_auf_nutzer",
    "zur Abnahme": "zur_abnahme",
    "aufgegeben": "aufgegeben",
    "aufgegeben (Modell)": "aufgegeben_modell",
    "abgenommen": "abgenommen",
    "verworfen": "verworfen",
}

_MELDEN_CTX = None


def melden_kontext_setzen(ctx):
    """Wird einmal je Aufruf von kontext_bauen() gesetzt: melden() bekommt
    von seinen Aufrufern nur (aufgabe_id, ereignis) und muss --base/--vorrat
    also selbst kennen, um den frischen Stand über wb-aufgabe zu lesen."""
    global _MELDEN_CTX
    _MELDEN_CTX = ctx


def _companion_frage_text(frage):
    text = (frage or {}).get("text")
    if not text:
        return None
    text = text.strip()
    optionen = (frage or {}).get("optionen") or []
    empfehlung = (frage or {}).get("empfehlung")
    if optionen:
        geordnet = ([empfehlung] if empfehlung in optionen else []) + \
                   [o for o in optionen if o != empfehlung]
        text += " Optionen: %s." % ", ".join(
            ("%s (Empfehlung)" % o) if o == empfehlung else o for o in geordnet)
    return text


def _erster_satz(text, laenge=200):
    text = (text or "").strip()
    for zeichen in (".", "!", "?"):
        i = text.find(zeichen)
        if i != -1:
            return text[:i + 1][:laenge].strip()
    return text[:laenge]


def melden(aufgabe_id, ereignis):
    """Meldung an den Companion (Bau-Schritt 3, Anhang „Companion-Socket"):
    liest den frischen Stand über `wb-aufgabe zeigen --json` selbst (melden()
    bekommt nur die Kennung und einen freien Ereignistext) und schickt darüber
    `wb-companion status` — bei „wartet auf den Nutzer" zusätzlich `frage`, bei
    „zur Abnahme" zusätzlich `bericht`. Zustellung oder Nichtzustellung wird
    im Verlauf mit einer Vorgangs-Kennung verbucht (idempotent wie die
    übrigen Zustellungen in diesem Skript); jeder Fehlschlag bleibt lokal,
    der Takt läuft immer weiter."""
    ctx = _MELDEN_CTX
    if not ctx:
        return None
    try:
        rc, aus, _ = wb_aufgabe(ctx, ["zeigen", aufgabe_id, "--json"])
        if rc != 0 or not aus.strip():
            return None
        z = json.loads(aus)
    except (json.JSONDecodeError, ValueError):
        return None
    verlauf = z.get("verlauf") or {}
    auftrag = z.get("auftrag") or {}
    stand = verlauf.get("stand")
    task_state = COMPANION_TASK_STATE.get(stand)
    if task_state is None:
        return None

    eintraege_bisher = verlauf.get("verlauf") or []
    grund = verlauf.get("grund") or None
    weckzeit = verlauf.get("weckzeit") or None
    # Der Ereignistext gehört nicht zur Kennung: melden() an der Aufrufstelle
    # und die Standwechsel-Phase am Ende desselben Takts sehen denselben Stand
    # mit verschiedenen Ereignistexten. Nur Stand, Grund und Weckzeit
    # entscheiden, und verglichen wird mit der LETZTEN Companion-Meldung, nicht
    # mit allen: kehrt die Aufgabe zu einem früheren Stand zurück (läuft,
    # steckt, läuft), ist das wieder eine Änderung.
    kennung = "companion-%s-%s" % (
        aufgabe_id, hashlib.sha1(("%s|%s|%s" % (task_state, grund or "", weckzeit or "")).encode("utf-8")).hexdigest()[:16])
    letzte = next((e for e in reversed(eintraege_bisher)
                   if e.get("art") in ("companion", "companion-fehlgeschlagen")), None)
    if letzte and letzte.get("art") == "companion" and letzte.get("kennung") == kennung:
        return None
    # Höchstens ein Versuch je Lage und Takt: sonst versuchte die
    # Standwechsel-Phase einen eben gescheiterten Versuch der Aufrufstelle
    # sofort noch einmal, bei hängendem Daemon mit voller Frist.
    versucht = ctx.setdefault("companion_versucht", set())
    if kennung in versucht:
        return None
    versucht.add(kennung)
    # Ein Fehlschlag quittiert nichts, der nächste Takt versucht es wieder;
    # steht derselbe Fehlschlag schon zuletzt im Verlauf, wird er nicht bei
    # jedem Takt erneut angehängt.
    schon_fehlgeschlagen = bool(letzte and letzte.get("art") == "companion-fehlgeschlagen"
                                and letzte.get("kennung") == kennung)

    titel = _erster_satz(auftrag.get("goal"))
    maschine = verlauf.get("maschine")

    status_argumente = ["status", aufgabe_id, "--stand", task_state]
    if grund:
        status_argumente += ["--grund", grund]
    if titel:
        status_argumente += ["--titel", titel]
    if weckzeit:
        status_argumente += ["--weckzeit", weckzeit]
    if maschine:
        status_argumente += ["--maschine", maschine]
    status_optionen = status_argumente[4:]
    befehl = ["wb-companion"] + status_argumente
    if stand == "wartet auf den Nutzer":
        text = _companion_frage_text(verlauf.get("frage"))
        if text:
            befehl = ["wb-companion", "frage", aufgabe_id, "--text", text] + status_optionen
    elif stand == "zur Abnahme":
        pfad = (verlauf.get("ergebnis") or {}).get("pfad")
        if pfad:
            text = "%s — %s" % (titel or auftrag.get("goal") or aufgabe_id, grund or "zur Abnahme")
            befehl = ["wb-companion", "bericht", aufgabe_id, "--pfad", pfad, "--text", text] + status_optionen
    gesamt_rc, _, fehl = laufe(befehl, 30)

    if gesamt_rc == 0:
        verlauf_schreiben(ctx, aufgabe_id, "companion",
                          "Companion gemeldet: %s (%s)" % (ereignis, task_state), kennung=kennung)
    elif not schon_fehlgeschlagen:
        verlauf_schreiben(ctx, aufgabe_id, "companion-fehlgeschlagen",
                          "Companion %s: %s (%s) — %s" % (
                              "abgelehnt" if gesamt_rc == 2 else "nicht erreichbar",
                              ereignis, task_state, fehl.strip()[:200]),
                          grund="nicht zugestellt", kennung=kennung)
    return None


# ------------------------------------------------------------- Kontext --
def kontext_bauen(args):
    base = os.path.abspath(args.base)
    if getattr(args, "vorrat", None):
        vorrat = os.path.abspath(args.vorrat)
    elif os.environ.get("WB_VORRAT"):
        vorrat = os.path.abspath(os.environ["WB_VORRAT"])
    else:
        vorrat = os.path.join(base, ".claude", "workbench", "vorrat")
    eigene = eigene_maschine_name()
    os.makedirs(os.path.join(vorrat, ".wecker"), exist_ok=True)
    ctx = {
        "base": base, "vorrat": vorrat, "eigene": eigene,
        "maschinen": maschinen_liste(base, eigene),
        "takt_s": max(1.0, zahl_einstellung(base, "agents.taktSekunden", TAKT_VORGABE_S)),
        "pid_datei": os.path.join(vorrat, ".traeger.pid"),
        "anmeldestart": False,
        "erste_probe_wiederholt": False,
        "protokoll": [],
        "budget": None,
        "zugende": [],
        "start_zeit": None,
        "takt_zaehler": 0,
    }
    melden_kontext_setzen(ctx)
    return ctx


def protokoll(ctx, text):
    ctx["protokoll"].append("%s %s" % (jetzt_iso(), text))


def wb_aufgabe(ctx, argumente):
    """wb-aufgabe mit --base/--vorrat des Trägers. WB_TRAEGER_NACHSEHEN=0,
    damit die Stände des Trägers kein weiteres Nachsehen anstoßen."""
    umgebung = dict(os.environ, WB_TRAEGER_NACHSEHEN="0")
    befehl = [wb_aufgabe_programm()] + list(argumente) + ["--base", ctx["base"], "--vorrat", ctx["vorrat"]]
    rc, aus, fehl = laufe(befehl, 90, env=umgebung)
    if rc not in (0, 1):
        protokoll(ctx, "wb-aufgabe %s scheiterte (rc=%s): %s" % (argumente[0], rc, fehl.strip()[:200]))
    return rc, aus, fehl


def verlauf_schreiben(ctx, id_, art, text, grund=None, kennung=None):
    argumente = ["verlauf", id_, art, text, "--von", "traeger"]
    if grund:
        argumente += ["--grund", grund]
    if kennung:
        argumente += ["--kennung", kennung]
    return wb_aufgabe(ctx, argumente)[0] == 0


def stand_setzen(ctx, id_, stand, grund=None, weckzeit=None):
    argumente = ["stand", id_, stand, "--von", "traeger"]
    if grund:
        argumente += ["--grund", grund]
    if weckzeit:
        argumente += ["--weckzeit", weckzeit]
    return wb_aufgabe(ctx, argumente)[0] == 0


def aufgabe_fehler(ctx, a, fehler):
    """Eine Ausnahme bei einer Aufgabe: in .traeger.log, nur diese Aufgabe auf
    „steckt" mit dem Fehlertext als Grund; der Takt läuft für die übrigen weiter."""
    text = "%s: %s" % (type(fehler).__name__, fehler)
    try:
        with open(os.path.join(ctx["vorrat"], ".traeger.log"), "a", encoding="utf-8") as f:
            f.write("%s Aufgabe %s: %s\n%s\n" % (jetzt_iso(), a.get("id"), text, traceback.format_exc()))
    except OSError:
        pass
    protokoll(ctx, "Aufgabe %s: %s" % (a.get("id"), text))
    try:
        stand_setzen(ctx, a["id"], "steckt", grund=("Umgebung: " + text)[:200])
    except Exception:
        pass


def je_aufgabe(ctx, aufgaben, fn, *rest):
    for a in aufgaben:
        try:
            fn(ctx, a, *rest)
        except Exception as e:
            aufgabe_fehler(ctx, a, e)


# ------------------------------------------------------------ Vorrat --
def alle_aufgaben(ctx):
    """Je Vorratseintrag: Kennung, Einträge aus Auftrag und Verlauf, Klasse
    des Hauptagenten; nach Rang sortiert. Ein Eintrag ohne Maschine gilt als
    einer der eigenen."""
    funde = []
    for name in sorted(os.listdir(ctx["vorrat"])):
        if not name.endswith(".json") or name.startswith("."):
            continue
        id_ = name[:-5]
        try:
            with open(os.path.join(ctx["vorrat"], name), encoding="utf-8") as f:
                eintrag = json.load(f)
            with open(eintrag["auftrag"], encoding="utf-8") as f:
                auftrag = json.load(f)
            verlauf_pfad = os.path.join(os.path.dirname(eintrag["auftrag"]), "%s.verlauf.json" % id_)
            with open(verlauf_pfad, encoding="utf-8") as f:
                verlauf = json.load(f)
        except (OSError, KeyError, TypeError, json.JSONDecodeError) as e:
            protokoll(ctx, "Aufgabe %s unlesbar (%s)" % (id_, e))
            continue
        hauptagent = auftrag.get("hauptagent") or {}
        funde.append({
            "id": id_, "eintrag": eintrag, "auftrag": auftrag, "verlauf": verlauf,
            "verlauf_pfad": verlauf_pfad,
            "stand": verlauf.get("stand"), "projekt": eintrag.get("projekt"),
            "maschine": eintrag.get("maschine") or ctx["eigene"],
            "klasse": modell_klasse(hauptagent.get("model", ""), ctx["base"]),
        })
    funde.sort(key=lambda a: (a["eintrag"].get("rang", 0), a["id"]))
    return funde


def aufgabe_frisch(ctx, id_):
    for a in alle_aufgaben(ctx):
        if a["id"] == id_:
            return a
    return None


def eintraege(a):
    return (a["verlauf"].get("verlauf") or []) if a else []


def nachtmodus(a):
    return (a["auftrag"].get("grenzen") or {}).get("nachtmodus") or "pausieren"


def kein_worker_arbeitet(a):
    return not any(w.get("zustand") == "arbeitet" for w in (a["verlauf"].get("worker") or []))


def letzte_aktivierung(a):
    zeit = None
    for e in eintraege(a):
        if e.get("art") in ("gestartet", "geweckt") and e.get("von") == "traeger":
            zeit = e.get("zeit") or zeit
    return zeit


def umgebung_steckt(a):
    return a["stand"] == "steckt" and a["verlauf"].get("grund") == "Umgebung"


def hat_entschieden(a):
    """Einer der drei Wege aus Abschnitt 3 steht, seit der Träger den
    Hauptagenten zuletzt gestartet oder geweckt hat. Weg 1 schreibt der
    Hauptagent als `wach --bis <iso>`; bis dahin gilt er als entschieden."""
    verlauf = a["verlauf"]
    stand = verlauf.get("stand")
    if stand in ENTSCHIEDENE_STAENDE:
        return True
    if stand in AKTIVE_PAUSEN and verlauf.get("weckzeit"):
        return True
    jetzt_s = jetzt().timestamp()
    if any(e.get("art") == "wach" and epoch_von(e.get("bis")) > jetzt_s for e in eintraege(a)):
        return True
    seit = epoch_von(letzte_aktivierung(a))
    if verlauf.get("weckzeit"):
        for e in eintraege(a):
            if e.get("art") == "wiederaufnahme" and epoch_von(e.get("zeit")) >= seit:
                return True
    return False


def arbeitet_gerade(ctx, a, seit_iso):
    """Ein arbeitender Hauptagent wird nie geweckt: neuer Verlaufseintrag seit
    dem Wecker (nicht vom Träger), oder die Gesprächsdatei der Sitzung hat sich
    seitdem geändert. Ist die Gesprächsdatei nicht messbar, zählt nur der Verlauf."""
    seit = epoch_von(seit_iso)
    for e in eintraege(a):
        if e.get("von") != "traeger" and e.get("art") != "zustellung" and epoch_von(e.get("zeit")) > seit:
            return True
    pane = (a["verlauf"].get("hauptagent_sitzung") or {}).get("pane")
    if pane:
        rc, aus, _ = laufe(["wb-inbox", "transcript", pane], 15)
        pfad = aus.strip().splitlines()[-1].strip() if rc == 0 and aus.strip() else ""
        if pfad and os.path.isfile(pfad) and seit and os.path.getmtime(pfad) > seit:
            return True
    return False


# --------------------------------------------------------- Zustand --
def zustand_lesen(ctx):
    try:
        with open(os.path.join(ctx["vorrat"], ".traeger.zustand.json"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def zustand_schreiben(ctx, zustand):
