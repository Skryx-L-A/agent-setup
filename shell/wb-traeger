    kopf = ("läuft seit %s (PID %s)" % (daten["gestartet"], pid)) if laeuft else "läuft nicht"
    print("wb-traeger %s: %s, Takt %gs, letzter Takt %s" % (ctx["eigene"], kopf, ctx["takt_s"],
