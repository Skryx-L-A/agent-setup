def status_schreiben(ctx, zustand):
    je_stand = {}
    for a in alle_aufgaben(ctx):
        je_stand.setdefault(a["stand"] or "unbekannt", []).append(a["id"])
    daten = {"gestartet": ctx["start_zeit"], "takt_sekunden": ctx["takt_s"],
             "takt_zaehler": ctx["takt_zaehler"], "letzter_takt": jetzt_iso(),
             "aufgaben": je_stand, "lebenszeichen": zustand.get("lebenszeichen") or {},
             "protokoll": ctx["protokoll"][-20:]}
    atomar_schreiben.schreiben(os.path.join(ctx["vorrat"], ".traeger.status.json"),
                               json.dumps(daten, ensure_ascii=False, indent=2) + "\n")


def pid_holen(ctx):
    try:
        with open(ctx["pid_datei"], encoding="utf-8") as f:
            roh = f.read().strip()
    except OSError:
        return None
    return int(roh) if roh.isdigit() else None


def agentverkehr_pause_lesen(ctx):
    """None, wenn der Schalter offen ist; sonst {"seit": …, "grund": …}
    (beide können None sein, wenn die Merkerdatei älter oder leer ist)."""
    pfad = os.path.join(ctx["vorrat"], ".agentverkehr-pause")
    if not os.path.isfile(pfad):
        return None
    try:
        with open(pfad, encoding="utf-8") as f:
            daten = json.load(f)
        if isinstance(daten, dict):
            return {"seit": daten.get("seit"), "grund": daten.get("grund") or None}
    except (OSError, json.JSONDecodeError):
        pass
    return {"seit": None, "grund": None}


def cmd_status(args):
    ctx = kontext_bauen(args)
    try:
        with open(os.path.join(ctx["vorrat"], ".traeger.status.json"), encoding="utf-8") as f:
            letzter = json.load(f)
    except (OSError, json.JSONDecodeError):
        letzter = {}
    pid = pid_holen(ctx)
    laeuft = bool(pid and pid_lebt(pid))
