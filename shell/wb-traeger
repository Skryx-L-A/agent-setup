# ------------------------------------------------------------------ Uhr --
def iso_zu_punkt(text):
    t = str(text).strip()
    if t.endswith("Z"):
        t = t[:-1] + "+00:00"
    d = datetime.datetime.fromisoformat(t)
    if d.tzinfo is None:
        d = d.replace(tzinfo=datetime.timezone.utc)
    return d


def jetzt():
    roh = os.environ.get("WB_TRAEGER_JETZT")
    if roh:
        return iso_zu_punkt(roh)
    return datetime.datetime.now(datetime.timezone.utc)


def punkt_zu_iso(punkt):
    return punkt.astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def jetzt_iso():
    return punkt_zu_iso(jetzt())


def epoch_von(text):
    """Unlesbarer Zeitstempel zählt als 0: er löst nichts aus."""
    try:
        return iso_zu_punkt(text).timestamp()
    except (ValueError, TypeError):
        return 0.0


def sekunden_seit(text):
    """Vergangene Sekunden; ein Zeitstempel in der Zukunft zählt als 0."""
    e = epoch_von(text)
    return None if e == 0 else max(0.0, jetzt().timestamp() - e)


# -------------------------------------------------------- Einstellungen --
def einstellung(base, schluessel, vorgabe):
    """`wb-state settings get`, sonst <base>/.claude/workbench/settings.json
    punktweise gelesen (wb-state kennt die agents.*-Schlüssel nicht; derselbe
    Weg wie in wb-aufgabe)."""
    try:
        r = subprocess.run(["wb-state", "settings", "get", schluessel],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        with open(os.path.join(base, ".claude", "workbench", "settings.json"), encoding="utf-8") as f:
            node = json.load(f)
    except (OSError, json.JSONDecodeError):
        return vorgabe
    for teil in schluessel.split("."):
        if not isinstance(node, dict) or teil not in node:
            return vorgabe
        node = node[teil]
    return vorgabe if node is None else node


def zahl_einstellung(base, schluessel, vorgabe):
    try:
        return float(einstellung(base, schluessel, vorgabe))
    except (TypeError, ValueError):
        return float(vorgabe)


def eigene_maschine_name():
    if os.environ.get("WB_TRAEGER_MASCHINE"):
        return os.environ["WB_TRAEGER_MASCHINE"]
    return "peer" if "peer" in socket.gethostname().lower() else "mac"


def maschinen_liste(base, eigene):
    roh = einstellung(base, "agents.maschinen", None)
    if isinstance(roh, str):
        try:
            roh = json.loads(roh)
        except json.JSONDecodeError:
            roh = None
    if not isinstance(roh, list) or not roh:
        roh = [{"name": "mac", "standard": False},
               {"name": "peer", "ssh": "peer", "standard": True}]
    liste = []
    for m in roh:
        if isinstance(m, dict) and m.get("name"):
            liste.append({"name": m["name"], "ssh": m.get("ssh") or m["name"],
                          "traegerPfad": m.get("traegerPfad") or "",
                          "modelle": m.get("modelle") or [],
                          "standard": bool(m.get("standard"))})
    if not any(m["name"] == eigene for m in liste):
        liste.append({"name": eigene, "ssh": eigene, "traegerPfad": "",
                      "modelle": [], "standard": False})
    return liste


